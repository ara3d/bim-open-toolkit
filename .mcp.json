{
  "mcpServers": {
    "bimopenflow-duckdb": {
      "command": "dotnet",
      "args": [
        "artifacts/bim-flow-duckdb/mcp/bimopenmcp-flow.dll",
        "--profile",
        "tables",
        "--store",
        "artifacts/bim-flow-duckdb/store",
        "--cache",
        "artifacts/bim-flow-duckdb/cache",
        "--models",
        "artifacts/building-model-workflows"
      ]
    },
    "bimopen-ifc": {
      "command": "dotnet",
      "args": [
        "artifacts/bim-flow-ifc/mcp/bimopenmcp-ifc.dll"
      ]
    }
  }
}

{
  "formatVersion": "0.1.0",
  "layout": {
    "about": {
      "x": 40,
      "y": 40,
      "w": 560,
      "h": 160
    },
    "model": {
      "x": 40,
      "y": 224
    },
    "scene": {
      "x": 370,
      "y": 224
    },
    "categories": {
      "x": 700,
      "y": 224
    },
    "cutaway": {
      "x": 1030,
      "y": 224
    },
    "plan": {
      "x": 1360,
      "y": 224
    },
    "interior": {
      "x": 1030,
      "y": 408
    },
    "exploded": {
      "x": 1030,
      "y": 592
    },
    "orthographic": {
      "x": 1030,
      "y": 776
    },
    "band": {
      "x": 1030,
      "y": 960
    },
    "ghost": {
      "x": 700,
      "y": 1144
    },
    "night": {
      "x": 1030,
      "y": 1144
    },
    "tint": {
      "x": 700,
      "y": 1328
    }
  },
  "structure": {
    "inputs": [
      {
        "default": "{SNOWDON}",
        "description": "The building's BIM Open Schema (.bos) file; the Snowdon Towers model when the host found it, or any public sample such as duplex-enriched.bos.",
        "kind": "FilePath",
        "name": "model"
      }
    ],
    "edges": [
      {
        "from": "model.path",
        "to": "scene.path"
      },
      {
        "from": "scene.view",
        "to": "categories.view"
      },
      {
        "from": "categories.view",
        "to": "cutaway.view"
      },
      {
        "from": "categories.view",
        "to": "interior.view"
      },
      {
        "from": "categories.view",
        "to": "exploded.view"
      },
      {
        "from": "cutaway.view",
        "to": "plan.view"
      },
      {
        "from": "categories.view",
        "to": "orthographic.view"
      },
      {
        "from": "scene.view",
        "to": "ghost.view"
      },
      {
        "from": "ghost.view",
        "to": "night.view"
      },
      {
        "from": "scene.view",
        "to": "tint.view"
      },
      {
        "from": "categories.view",
        "to": "band.view"
      }
    ],
    "nodes": [
      {
        "id": "about",
        "kind": "view.note",
        "version": 1
      },
      {
        "id": "model",
        "kind": "value.path",
        "version": 1
      },
      {
        "id": "scene",
        "kind": "view3d.scene",
        "version": 1
      },
      {
        "id": "categories",
        "kind": "view3d.categoryStyle",
        "version": 1
      },
      {
        "id": "cutaway",
        "kind": "view3d.section",
        "version": 1
      },
      {
        "id": "interior",
        "kind": "view3d.sectionBox",
        "version": 1
      },
      {
        "id": "exploded",
        "kind": "view3d.explode",
        "version": 1
      },
      {
        "id": "plan",
        "kind": "view3d.projection",
        "version": 1
      },
      {
        "id": "orthographic",
        "kind": "view3d.projection",
        "version": 1
      },
      {
        "id": "ghost",
        "kind": "view3d.categoryStyle",
        "version": 1
      },
      {
        "id": "night",
        "kind": "view3d.environment",
        "version": 1
      },
      {
        "id": "tint",
        "kind": "view3d.tint",
        "version": 1
      },
      {
        "id": "band",
        "kind": "view3d.sectionRange",
        "version": 1
      }
    ]
  },
  "values": {
    "about": {
      "text": "Every view3d recipe kind on one model. The model input feeds scene, which has three roots: categories (classic palette; parent of the section, box, explode, band and orthographic views, and plan through the section), ghost (22% opacity, shown at night) and tint. Open any leaf in the 3D pane to see its view. Change the model input to run every recipe on another .bos file, such as duplex-enriched.bos."
    },
    "model": {
      "path": "$model"
    },
    "categories": {
      "opacity": "1"
    },
    "cutaway": {
      "axis": "z",
      "fraction": "0.5"
    },
    "interior": {
      "fraction": "0.5"
    },
    "exploded": {
      "strength": "0.5"
    },
    "plan": {
      "mode": "plan"
    },
    "orthographic": {
      "mode": "orthographic"
    },
    "ghost": {
      "opacity": "0.22"
    },
    "night": {
      "theme": "dark",
      "grid": "true"
    },
    "tint": {
      "color": "#2b8bd6",
      "opacityPercent": "100"
    },
    "band": {
      "axis": "z",
      "range": "[0.3,0.7]"
    }
  }
}

[
  {
    "id": "public-door-schedule",
    "title": "Door schedule (Schependomlaan)",
    "tag": "JOIN + PROJECT",
    "database": "public",
    "description": "Join every door to the storey that contains it, keep the schedule fields, and sort by storey then mark. Width_mm is the IFC OverallWidth attribute; it stays NULL where the Archicad export carries no width, and WidthStatus says so.",
    "result": "answer",
    "graph": {
      "formatVersion": "0.1.0",
      "structure": {
        "inputs": [
          {
            "name": "model",
            "kind": "FilePath",
            "default": "{PUBLIC_DUCKDB}",
            "description": "The building's BIM Open Schema DuckDB file; any public sample building works here."
          }
        ],
        "nodes": [
          {
            "id": "answer",
            "kind": "table.sort",
            "version": 1
          },
          {
            "id": "doors",
            "kind": "duck.query",
            "version": 1
          },
          {
            "id": "storeys",
            "kind": "duck.query",
            "version": 1
          },
          {
            "id": "attach-storey",
            "kind": "table.join",
            "version": 1
          },
          {
            "id": "schedule-fields",
            "kind": "table.project",
            "version": 1
          },
          {
            "id": "database",
            "kind": "duck.source",
            "version": 1
          },
          {
            "id": "width-status",
            "kind": "table.derive",
            "version": 1
          }
        ],
        "edges": [
          {
            "from": "doors.table",
            "to": "attach-storey.a"
          },
          {
            "from": "storeys.table",
            "to": "attach-storey.b"
          },
          {
            "from": "width-status.table",
            "to": "schedule-fields.table"
          },
          {
            "from": "schedule-fields.table",
            "to": "answer.table"
          },
          {
            "from": "database.source",
            "to": "doors.path"
          },
          {
            "from": "database.source",
            "to": "storeys.path"
          },
          {
            "from": "attach-storey.table",
            "to": "width-status.table"
          }
        ]
      },
      "values": {
        "doors": {
          "sql": "SELECT e.EntityIndex AS Door, e.Name AS Mark, e.Type AS DoorType, TRY_CAST(w.Value AS DOUBLE) AS Width_mm FROM EntityText e LEFT JOIN ParameterText w ON w.EntityIndex = e.EntityIndex AND w.Name = 'Ifc:OverallWidth' WHERE e.Category = 'IFCDOOR'"
        },
        "storeys": {
          "sql": "SELECT EntityIndex AS Door, StoreyName AS Storey FROM StoreyOfElement WHERE Depth = 1"
        },
        "attach-storey": {
          "aKey": "Door",
          "bKey": "Door",
          "mode": "left"
        },
        "schedule-fields": {
          "columns": "Mark, DoorType, Storey, Width_mm, WidthStatus"
        },
        "answer": {
          "A": "Storey",
          "descendingA": "false",
          "B": "Mark",
          "descendingB": "false"
        },
        "database": {
          "path": "$model"
        },
        "width-status": {
          "name": "WidthStatus",
          "expr": "isnull(Width_mm) ? 'No OverallWidth in the file' : 'Known'"
        }
      },
      "layout": {
        "answer": {
          "x": 1570,
          "y": 30
        },
        "doors": {
          "x": 330,
          "y": 30
        },
        "storeys": {
          "x": 330,
          "y": 265
        },
        "attach-storey": {
          "x": 640,
          "y": 30
        },
        "schedule-fields": {
          "x": 1260,
          "y": 30
        },
        "database": {
          "x": 20,
          "y": 30
        },
        "width-status": {
          "x": 950,
          "y": 30
        }
      }
    }
  },
  {
    "id": "public-door-types",
    "title": "Most-used door types (Schependomlaan)",

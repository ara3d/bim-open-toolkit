          }
        ],
        "edges": [
          {
            "from": "rooms.table",
            "to": "count-rooms.table"
          },
          {
            "from": "count-rooms.table",
            "to": "answer.table"
          },
          {
            "from": "answer.table",
            "to": "chart.table"
          },
          {
            "from": "database.source",
            "to": "rooms.source"
          }
        ]
      },
      "values": {
        "rooms": {
          "sql": "SELECT s.StoreyName AS Storey FROM EntityText e JOIN StoreyOfElement s ON s.EntityIndex = e.EntityIndex AND s.Depth = 1 WHERE e.Category = 'IFCSPACE'"

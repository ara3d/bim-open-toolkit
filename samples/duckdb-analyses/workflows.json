            "from": "attach-level.table",
            "to": "answer.t1"
          },
          {
            "from": "database.source",
            "to": "rooms.path"
          },
          {
            "from": "database.source",
            "to": "levels.path"
          },
          {
            "from": "answer.table",
            "to": "chart.table"
          }
        ]
      },
      "values": {
        "rooms": {
          "sql": "SELECT storey AS StoreyKey FROM space"
        },
        "levels": {
          "sql": "SELECT id AS StoreyKey, element_name AS Storey FROM storey"
        },
        "count-rooms": {
          "groupBy": "StoreyKey",
          "aggregates": "count(*) as Rooms"
        },
        "attach-level": {
          "aKey": "StoreyKey",
          "bKey": "StoreyKey",
          "mode": "left"
        },
        "answer": {
          "sql": "SELECT CASE WHEN StoreyKey IS NULL THEN '(no storey reference)' WHEN Storey IS NULL THEN CAST(StoreyKey AS VARCHAR) WHEN count(*) OVER (PARTITION BY Storey) > 1 THEN Storey || ' · ' || row_number() OVER (PARTITION BY Storey ORDER BY StoreyKey) ELSE Storey END AS Level, Rooms FROM t ORDER BY StoreyKey IS NULL, Level"
        },
        "database": {
          "path": "$model"
        },
        "chart": {
          "labelColumn": "Level",
          "valueColumns": "Rooms",
          "title": "Rooms per storey",
          "sort": "none"
        },
        "storey-names": {
          "text": "Several Snowdon storeys share a name: each source document defines its own levels, so one level name can appear once per document. The answer numbers them in storey-id order (Level 1 · 1, Level 1 · 2) so each storey keeps its own row and bar. Rooms with no storey reference are counted on the last row, (no storey reference), so the counts sum to every room."
        }

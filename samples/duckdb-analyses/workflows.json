          }
        ],
        "edges": [
          {
            "from": "roof-facts.table",
            "to": "coverage.table"
          },
          {
            "from": "coverage.table",
            "to": "answer.table"
          },
          {
            "from": "database.source",
            "to": "roof-facts.source"
          }
        ]
      },
      "values": {
        "roof-facts": {
          "sql": "SELECT COALESCE(net_surface_area_reason, 'Known') AS AreaStatus, net_surface_area AS Area_m2 FROM roof"
        },
        "coverage": {
          "groupBy": "AreaStatus",
          "aggregates": "count(*) as Roofs, count(Area_m2) as KnownAreas, sum(Area_m2) as KnownArea_m2"
        },
        "answer": {
          "A": "Roofs",
          "descendingA": "true"
        },

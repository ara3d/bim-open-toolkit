  {
    "id": "public-floor-area-by-use",
    "title": "Floor area by room use (Schependomlaan)",
    "tag": "JOIN + AGGREGATE + CHART",
    "database": "public",
    "description": "Join each space to its NetFloorArea base quantity, total the area per space use, and plot it. Habitable rooms (Verblijfsruimte) hold 705.8 m2 of the 965.8 m2 net floor area; a note on the canvas translates the six Dutch use names.",
    "result": "answer",
    "graph": {
      "formatVersion": "0.1.0",
      "structure": {
        "inputs": [
          {
            "name": "model",
            "kind": "FilePath",
            "default": "{PUBLIC_DUCKDB}",
            "description": "The building's BIM Open Schema DuckDB file; any public sample building works here."
          }
        ],
        "nodes": [
          {
            "id": "spaces",
            "kind": "duck.query",
            "version": 1
          },
          {
            "id": "areas",
            "kind": "duck.query",
            "version": 1
          },
          {
            "id": "attach-area",
            "kind": "table.join",
            "version": 1
          },
          {
            "id": "total-by-use",
            "kind": "table.aggregate",
            "version": 1
          },
          {
            "id": "chart",
            "kind": "chart.bar",
            "version": 1
          },
          {
            "id": "database",
            "kind": "duck.source",
            "version": 1
          },
          {
            "id": "round-area",
            "kind": "table.derive",
            "version": 1
          },
          {
            "id": "use-fields",
            "kind": "table.project",
            "version": 1
          },
          {
            "id": "answer",
            "kind": "table.sort",
            "version": 1
          },
          {
            "id": "glossary",
            "kind": "view.note",
            "version": 1
          }
        ],
        "edges": [
          {
            "from": "spaces.table",
            "to": "attach-area.a"
          },
          {
            "from": "areas.table",
            "to": "attach-area.b"
          },
          {
            "from": "attach-area.table",
            "to": "total-by-use.table"
          },
          {
            "from": "answer.table",
            "to": "chart.table"
          },
          {
            "from": "database.source",
            "to": "spaces.path"
          },
          {
            "from": "database.source",
            "to": "areas.path"
          },
          {
            "from": "total-by-use.table",
            "to": "round-area.table"
          },
          {
            "from": "round-area.table",
            "to": "use-fields.table"
          },
          {
            "from": "use-fields.table",
            "to": "answer.table"
          }
        ]
      },
      "values": {
        "spaces": {
          "sql": "SELECT EntityIndex AS Space, Type AS Use FROM EntityText WHERE Category = 'IFCSPACE'"
        },
        "areas": {
          "sql": "SELECT EntityIndex AS Space, TRY_CAST(Value AS DOUBLE) AS NetFloorArea_m2 FROM ParameterText WHERE Name = 'NetFloorArea' AND ParameterGroup = 'BaseQuantities'"
        },
        "attach-area": {
          "aKey": "Space",
          "bKey": "Space",
          "mode": "left"
        },
        "total-by-use": {
          "groupBy": "Use",
          "aggregates": "count(*) as Spaces, sum(NetFloorArea_m2) as TotalArea_m2"
        },
        "chart": {
          "labelColumn": "Use",
          "valueColumns": "NetFloorArea_m2",
          "title": "Net floor area by room use (m2)",
          "sort": "none"
        },
        "database": {
          "path": "$model"
        },
        "round-area": {
          "name": "NetFloorArea_m2",
          "expr": "round(TotalArea_m2, 1)"
        },
        "use-fields": {
          "columns": "Use, Spaces, NetFloorArea_m2"
        },
        "answer": {
          "A": "NetFloorArea_m2",
          "descendingA": "true",
          "B": "Use",
          "descendingB": "false"
        },
        "glossary": {
          "text": "Use is the space type the Archicad export names in Dutch, after the room classes of the Dutch building code: Verblijfsruimte, habitable room (living room, bedroom, kitchen); Verkeersruimte, circulation (hall, landing, stair); Badruimte, bathroom; Technische ruimte, plant or meter room; Toiletruimte, toilet; Onbenoemde ruimte, unclassified space (storage, attic)."
        }
      },
      "layout": {

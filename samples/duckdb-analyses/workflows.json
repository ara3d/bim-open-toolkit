            "version": 1
          },
          {
            "id": "attach-area",
            "kind": "table.join",
            "version": 1
          },
          {
            "id": "total-by-use",
            "kind": "table.aggregate",
            "version": 1
          },
          {
            "id": "chart",
            "kind": "chart.bar",
            "version": 1
          },
          {
            "id": "database",
            "kind": "duck.source",
            "version": 1
          }
        ],
        "edges": [
          {
            "from": "spaces.table",
            "to": "attach-area.a"
          },
          {
            "from": "areas.table",
            "to": "attach-area.b"
          },
          {
            "from": "attach-area.table",
            "to": "total-by-use.table"
          },
          {
            "from": "total-by-use.table",
            "to": "answer.t1"
          },
          {
            "from": "answer.table",
            "to": "chart.table"
          },
          {
            "from": "database.source",
            "to": "spaces.source"
          },
          {
            "from": "database.source",
            "to": "areas.source"
          }
        ]
      },
      "values": {
        "spaces": {
          "sql": "SELECT EntityIndex AS Space, Type AS Use FROM EntityText WHERE Category = 'IFCSPACE'"
        },
        "areas": {
          "sql": "SELECT EntityIndex AS Space, TRY_CAST(Value AS DOUBLE) AS NetFloorArea_m2 FROM ParameterText WHERE Name = 'NetFloorArea' AND ParameterGroup = 'BaseQuantities'"
        },
        "attach-area": {
          "aKey": "Space",
          "bKey": "Space",
          "mode": "left"
        },
        "total-by-use": {
          "groupBy": "Use",
          "aggregates": "count(*) as Spaces, sum(NetFloorArea_m2) as NetFloorArea_m2"
        },
        "answer": {
          "sql": "SELECT Use, Spaces, round(NetFloorArea_m2, 1) AS NetFloorArea_m2 FROM t ORDER BY NetFloorArea_m2 DESC, Use"
        },
        "chart": {
          "labelColumn": "Use",
          "valueColumns": "NetFloorArea_m2",
          "title": "Net floor area by room use (m2)",
          "sort": "none"
        },
        "database": {
          "path": "{PUBLIC_DUCKDB}"
        }
      },
      "layout": {

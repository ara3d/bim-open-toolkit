  {
    "id": "public-missing-widths",
    "title": "Doors without a width (Schependomlaan)",
    "tag": "FILTER + EXPLAIN",
    "database": "public",
    "description": "Keep only the doors whose IFC OverallWidth is absent. The export writes a width for 104 of the 205 doors; the other 101 have none anywhere in the file, and the graph leaves them NULL rather than guessing from the type name.",
    "result": "answer",
    "graph": {
      "formatVersion": "0.1.0",
      "structure": {
        "nodes": [
          {
            "id": "answer",
            "kind": "table.project",
            "version": 1
          },
          {
            "id": "door-facts",
            "kind": "duck.query",
            "version": 1
          },
          {
            "id": "missing-only",
            "kind": "table.filter",
            "version": 1
          },
          {
            "id": "database",
            "kind": "duck.source",
            "version": 1
          }
        ],
        "edges": [
          {
            "from": "door-facts.table",
            "to": "missing-only.table"
          },
          {
            "from": "missing-only.table",
            "to": "answer.table"
          },
          {
            "from": "database.source",
            "to": "door-facts.source"
          }
        ]
      },
      "values": {
        "door-facts": {
          "sql": "SELECT e.Name AS Mark, e.Type AS DoorType, TRY_CAST(w.Value AS DOUBLE) AS Width_mm, CASE WHEN w.Value IS NULL THEN 1 ELSE 0 END AS MissingWidth FROM EntityText e LEFT JOIN ParameterText w ON w.EntityIndex = e.EntityIndex AND w.Name = 'Ifc:OverallWidth' WHERE e.Category = 'IFCDOOR'"
        },
        "missing-only": {
          "expr": "MissingWidth > 0"
        },
        "answer": {
          "columns": "Mark, DoorType, Width_mm"
        },
        "database": {
          "path": "{PUBLIC_DUCKDB}"
        }
      },
      "layout": {
        "database": {
          "x": 20,
          "y": 30
        },
        "door-facts": {
          "x": 330,
          "y": 30
        },
        "missing-only": {
          "x": 640,
          "y": 30
        },
        "answer": {
          "x": 640,
          "y": 265
        }
      }
    }
  },
  {
    "id": "public-floor-area-by-use",
    "title": "Floor area by room use (Schependomlaan)",
    "tag": "JOIN + AGGREGATE + CHART",
    "database": "public",
    "description": "Join each space to its NetFloorArea base quantity, total the area per space use, and plot it. Living rooms (Verblijfsruimte) hold 705.8 m2 of the 965.8 m2 net floor area.",
    "result": "answer",
    "graph": {
      "formatVersion": "0.1.0",
      "structure": {
        "nodes": [
          {
            "id": "answer",
            "kind": "sql.query",
            "version": 1

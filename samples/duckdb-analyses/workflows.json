  {
    "id": "duckdb-roof-coverage",
    "title": "Roof quantity coverage",
    "tag": "AGGREGATE + NULLS",
    "description": "Group roof areas by availability. KnownArea_m2 stays NULL when a group has no known quantities; missing quantities are never priced or treated as zero.",
    "result": "answer",
    "graph": {
      "formatVersion": "0.1.0",
      "structure": {
        "nodes": [
          {
            "id": "answer",
            "kind": "table.sort",

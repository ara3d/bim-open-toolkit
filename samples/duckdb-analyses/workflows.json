          {
            "id": "database",
            "kind": "duck.source",
            "version": 1
          }
        ],
        "edges": [
          {
            "from": "door-facts.table",
            "to": "missing-only.table"
          },
          {
            "from": "missing-only.table",
            "to": "answer.table"
          },
          {
            "from": "database.source",
            "to": "door-facts.path"
          }
        ]
      },
      "values": {
        "door-facts": {
          "sql": "SELECT e.Name AS Mark, e.Type AS DoorType, TRY_CAST(w.Value AS DOUBLE) AS Width_mm FROM EntityText e LEFT JOIN ParameterText w ON w.EntityIndex = e.EntityIndex AND w.Name = 'Ifc:OverallWidth' WHERE e.Category = 'IFCDOOR'"
        },
        "missing-only": {
          "expr": "isnull(Width_mm)"
        },
        "answer": {
          "columns": "Mark, DoorType, Width_mm"
        },
        "database": {
          "path": "$model"
        }
      },
      "layout": {

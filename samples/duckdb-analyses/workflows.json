  {
    "id": "duckdb-source-lineage",
    "title": "Source provenance",
    "tag": "JOIN + AGGREGATE",
    "description": "Join mapped source objects to their delivery and authoring document, then count occurrence and type records. Source documents are not assumed to be physical buildings.",
    "result": "answer",
    "graph": {
      "formatVersion": "0.1.0",
      "structure": {
        "nodes": [
          {
            "id": "answer",
            "kind": "table.sort",
            "version": 1
          },
          {
            "id": "source-objects",

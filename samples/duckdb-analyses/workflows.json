    "id": "duckdb-room-distribution",
    "title": "Rooms by storey",
    "tag": "AGGREGATE + CHART",
    "description": "Count rooms by their typed storey reference, join the counts to readable level names, and plot them: one row and one bar per storey, numbering storeys that share a name, plus a row for rooms with no storey reference. This counts mapped records; it does not certify spatial completeness.",
    "result": "answer",
    "graph": {
      "formatVersion": "0.1.0",
      "structure": {
        "inputs": [
          {
            "name": "model",
            "kind": "FilePath",

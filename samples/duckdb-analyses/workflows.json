  {
    "id": "duckdb-typed-schema",
    "title": "Explore typed columns",
    "tag": "CATALOG + FILTER",
    "description": "Inspect the actual database schema. Filter to numeric columns and group them by table and SQL type. This describes the schema, including currently empty core tables.",
    "result": "answer",
    "graph": {
      "formatVersion": "0.1.0",
      "structure": {
        "nodes": [
          {
            "id": "answer",
            "kind": "table.sort",
            "version": 1
          },
          {
            "id": "column-catalog",
            "kind": "duck.query",
            "version": 1
          },
          {
            "id": "numeric-only",
            "kind": "table.filter",
            "version": 1
          },
          {
            "id": "count-columns",
            "kind": "table.aggregate",
            "version": 1
          },
          {
            "id": "database",
            "kind": "duck.source",
            "version": 1
          }
        ],
        "edges": [
          {
            "from": "column-catalog.table",
            "to": "numeric-only.table"
          },
          {
            "from": "numeric-only.table",
            "to": "count-columns.table"
          },
          {
            "from": "count-columns.table",
            "to": "answer.table"
          },
          {
            "from": "database.source",
            "to": "column-catalog.source"
          }
        ]
      },
      "values": {
        "column-catalog": {
          "sql": "SELECT table_name AS TableName, column_name AS ColumnName, data_type AS SqlType, CASE WHEN data_type IN ('DOUBLE', 'INTEGER', 'BIGINT', 'DECIMAL(38,10)') THEN 1 ELSE 0 END AS IsNumeric FROM information_schema.columns WHERE table_schema = 'main'"
        },
        "numeric-only": {
          "expr": "IsNumeric > 0"
        },
        "count-columns": {
          "groupBy": "TableName, SqlType",
          "aggregates": "count(*) as NumericColumns"
        },
        "answer": {
          "A": "NumericColumns",
          "descendingA": "true",
          "B": "TableName",
          "descendingB": "false"
        },
        "database": {
          "path": "{DUCKDB}"
        }
      },
      "layout": {
        "column-catalog": {
          "x": 20,
          "y": 30
        },
        "numeric-only": {
          "x": 330,
          "y": 30
        },
        "count-columns": {
          "x": 330,
          "y": 265
        },
        "answer": {
          "x": 20,

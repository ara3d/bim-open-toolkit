            "version": 1
          },
          {
            "id": "deliveries",
            "kind": "duck.query",
            "version": 1
          },
          {
            "id": "attach-delivery",
            "kind": "table.join",
            "version": 1
          },
          {
            "id": "count-sources",
            "kind": "table.aggregate",
            "version": 1
          },
          {
            "id": "database",
            "kind": "duck.source",
            "version": 1
          }
        ],
        "edges": [
          {
            "from": "source-objects.table",

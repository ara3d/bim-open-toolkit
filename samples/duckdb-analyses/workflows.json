  {
    "id": "public-rooms-per-storey",
    "title": "Rooms per storey (Schependomlaan)",
    "tag": "AGGREGATE + CHART",
    "database": "public",
    "description": "Count the spaces each storey contains and plot them. The storey comes from the StoreyOfElement view, so a space is counted once, under the storey that contains it.",
    "result": "answer",
    "graph": {
      "formatVersion": "0.1.0",
      "structure": {
        "inputs": [
          {
            "name": "model",
            "kind": "FilePath",
            "default": "{PUBLIC_DUCKDB}",
            "description": "The building's BIM Open Schema DuckDB file; any public sample building works here."
          }
        ],
        "nodes": [
          {
            "id": "answer",
            "kind": "table.sort",
            "version": 1
          },
          {
            "id": "rooms",
            "kind": "duck.query",
            "version": 1
          },
          {
            "id": "count-rooms",
            "kind": "table.aggregate",
            "version": 1
          },
          {
            "id": "chart",
            "kind": "chart.bar",
            "version": 1
          },
          {
            "id": "database",
            "kind": "duck.source",
            "version": 1
          }
        ],
        "edges": [
          {
            "from": "rooms.table",
            "to": "count-rooms.table"
          },
          {
            "from": "count-rooms.table",
            "to": "answer.table"
          },
          {
            "from": "answer.table",
            "to": "chart.table"
          },
          {
            "from": "database.source",
            "to": "rooms.path"
          }
        ]
      },
      "values": {
        "rooms": {
          "sql": "SELECT s.StoreyName AS Storey FROM EntityText e JOIN StoreyOfElement s ON s.EntityIndex = e.EntityIndex AND s.Depth = 1 WHERE e.Category = 'IFCSPACE'"
        },
        "count-rooms": {
          "groupBy": "Storey",
          "aggregates": "count(*) as Rooms"
        },
        "answer": {
          "A": "Storey",
          "descendingA": "false"
        },
        "chart": {
          "labelColumn": "Storey",
          "valueColumns": "Rooms",
          "title": "Rooms per storey",
          "sort": "none"
        },
        "database": {
          "path": "$model"
        }
      },
      "layout": {
        "answer": {
          "x": 950,
          "y": 30
        },
        "rooms": {
          "x": 330,

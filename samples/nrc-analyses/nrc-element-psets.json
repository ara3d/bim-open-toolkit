  "values": {
    "about": {
      "text": "The element property-set rows nrc-enrich-run writes (README: How the enrichment rows are derived). metricRows places each value of nrc_analytics_long.csv in its set by nrc-metrics.csv; runFactRows fills a set's property that has no value from nrc-run.csv; runIdRows adds AnalysisRunId and ScenarioName to every set. 2,394 rows in (entityId, psetName, paramName) order."
    },
    "values": {
      "path": "nrc_analytics_long.csv",
      "source": "nrc"
    },
    "entities": {
      "source": "duplex-base",
      "table": "EntityText"
    },
    "metrics": {
      "path": "nrc-metrics.csv",
      "source": "nrc"
    },
    "run": {
      "path": "nrc-run.csv",
      "source": "nrc"
    },
    "withStepId": {
      "kind": "inner",
      "leftKey": "GlobalId",
      "rightKey": "GlobalId"
    },
    "metricRows": {
      "sql": "SELECT p.StepId AS entityId, m.PropertySet AS psetName, m.PropertyName AS paramName,\n       m.ValueType AS valueType, CAST(p.Value AS VARCHAR) AS paramValue\nFROM t1 p JOIN t2 m ON m.Level = 'element' AND m.MetricId = p.MetricId"
    },
    "runFactRows": {
      "sql": "SELECT DISTINCT v.entityId, s.PropertySet AS psetName, s.PropertyName AS paramName,\n       s.ValueType AS valueType, r.Value AS paramValue\nFROM t1 v\nJOIN t2 s ON s.Level = 'element' AND s.PropertySet = v.psetName\nJOIN t3 r ON r.Field = s.PropertyName"
    },
    "runIdRows": {
      "sql": "SELECT DISTINCT v.entityId, v.psetName, r.Field AS paramName, r.ValueType AS valueType, r.Value AS paramValue\nFROM t1 v JOIN t2 r ON r.Field IN ('AnalysisRunId', 'ScenarioName')"
    },
    "answer": {
      "sql": "SELECT * FROM t1 UNION SELECT * FROM t2 UNION SELECT * FROM t3 ORDER BY entityId, psetName, paramName"
    }
  }

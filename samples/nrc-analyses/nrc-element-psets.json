  "values": {
    "answer": {
      "sql": "SELECT p.StepId AS entityId, m.PropertySet AS psetName, m.PropertyName AS paramName,\n       m.ValueType AS valueType, CAST(p.Value AS VARCHAR) AS paramValue\nFROM t1 p JOIN t2 m ON m.Level = 'element' AND m.MetricId = p.MetricId\nUNION\nSELECT p.StepId, s.PropertySet, s.PropertyName, s.ValueType, r.Value\nFROM t1 p JOIN t2 m ON m.Level = 'element' AND m.MetricId = p.MetricId\nJOIN t2 s ON s.Level = 'element' AND s.PropertySet = m.PropertySet\nJOIN t3 r ON r.Field = s.PropertyName\nUNION\nSELECT p.StepId, m.PropertySet, r.Field, r.ValueType, r.Value\nFROM t1 p JOIN t2 m ON m.Level = 'element' AND m.MetricId = p.MetricId\nJOIN t3 r ON r.Field IN ('AnalysisRunId', 'ScenarioName')\nORDER BY entityId, psetName, paramName"
    },

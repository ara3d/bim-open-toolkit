  "values": {
    "about": {
      "text": "Q2: which of Level 1 and Level 2 has the higher mean energy use intensity. levels keeps the two storeys before the average, so no other storey is computed; the sort puts the higher first: Level 2 at 40.56 kWh/m2/yr, then Level 1 at 40.5."
    },
    "elements": {
      "path": "nrc_analytics_elements.csv",
      "source": "nrc"
    },
    "levels": {
      "expr": "[Storey] == 'Level 1' or [Storey] == 'Level 2'"
    },
    "perStorey": {
      "aggregates": "count(*) as Elements, avg(EnergyUseIntensity_kWh_per_m2_year) as MeanEui_kWh_per_m2_year",
      "groupBy": "Storey"
    },
    "answer": {
      "by": "MeanEui_kWh_per_m2_year desc"
    }
  }

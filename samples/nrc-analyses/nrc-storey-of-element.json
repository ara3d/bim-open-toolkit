  "values": {
    "about": {
      "text": "Figure 10: the storey of every analysed element, read from the model instead of the CSV's Storey column. StoreyOfElement walks ContainedIn, PartOf and MemberOf; placed keeps each element's row with the smallest Depth, the pick nrc-rollup applies, so no element counts twice. Expected: 103, 93, 14 and 8 elements (nrc_analytics_storeys.csv)."
    },
    "storeys": {
      "source": "duplex-enriched",
      "table": "StoreyOfElement"
    },
    "entities": {
      "source": "duplex-enriched",
      "table": "EntityText"
    },
    "elements": {
      "source": "nrc",
      "path": "nrc_analytics_elements.csv"
    },
    "placed": {
      "sql": "SELECT EntityIndex, StoreyName\nFROM t1\nQUALIFY row_number() OVER (PARTITION BY EntityIndex ORDER BY Depth, StoreyIndex) = 1"
    },
    "withGlobalId": {
      "leftKey": "EntityIndex",
      "rightKey": "EntityIndex",
      "kind": "inner"
    },
    "analysed": {
      "leftKey": "GlobalId",
      "rightKey": "GlobalId",
      "kind": "inner"
    },
    "perStorey": {
      "groupBy": "StoreyName",
      "aggregates": "count(*) as Elements, sum(EmbodiedCarbon_A1A3_kgCO2e) as EmbodiedCarbon_A1A3_kgCO2e"
    },
    "answer": {
      "by": "EmbodiedCarbon_A1A3_kgCO2e desc"
    }
  }
}

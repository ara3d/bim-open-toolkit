  "values": {
    "csv": { "source": "nrc", "path": "test-kit/analytics_dataset_with_levels.csv" },
    "entities": { "source": "duplex-base", "table": "EntityText" },
    "storeyOf": { "source": "duplex-base", "table": "StoreyOfElement" },
    "storeyOfMin": { "sql": "SELECT * FROM t1 QUALIFY row_number() OVER (PARTITION BY EntityIndex ORDER BY Depth) = 1" },
    "model": { "path": "{SAMPLES}/duplex-base.ifc" },
    "values": { "path": "{SAMPLES}/test-kit/analytics_dataset_with_levels.csv" },
    "instances": { "name": "instances" },
    "coloredCarbon": { "joinColumn": "globalId", "valueColumn": "operational_carbon", "colorMap": "viridis" },
    "coloredCategory": { "joinColumn": "globalId", "valueColumn": "category", "colorMap": "category10" },
    "physical": { "groupBy": "globalId", "aggregates": "count(*) as meshCount" },
    "entityStorey": { "leftKey": "EntityIndex", "rightKey": "EntityIndex", "kind": "inner" },
    "csvNoEntity": { "leftKey": "GlobalId", "rightKey": "GlobalId", "kind": "anti" },
    "physicalEntities": { "leftKey": "GlobalId", "rightKey": "globalId", "kind": "semi" },
    "nonPhysicalEntities": { "leftKey": "GlobalId", "rightKey": "globalId", "kind": "anti" },
    "physicalNoCsv": { "leftKey": "GlobalId", "rightKey": "GlobalId", "kind": "anti" },
    "csvMatchedNonPhysical": { "leftKey": "GlobalId", "rightKey": "GlobalId", "kind": "semi" },
    "csvWithStorey": { "leftKey": "GlobalId", "rightKey": "GlobalId", "kind": "inner" },
    "storeyComparison": { "columns": "GlobalId, Level, StoreyName" },
    "perStorey": { "groupBy": "StoreyName", "aggregates": "count(*) as Elements, sum(operational_carbon) as TotalOperationalCarbon, avg(operational_carbon) as MeanOperationalCarbon, avg(energy_intensity) as MeanEnergyIntensity" },
    "answer": { "sql": "SELECT (SELECT count(*) FROM t1) AS CsvRowsWithNoEntity, (SELECT count(*) FROM t2) AS PhysicalElementsWithNoCsvRow, (SELECT count(*) FROM t3) AS CsvRowsMatchingNonPhysicalEntity" },
    "about": { "text": "Template: point the CSV and the model at your own files. An element that reaches more than one storey through ContainedIn/PartOf/MemberOf (StoreyOfElement can hold several rows per element, one per ancestor storey) is assigned to the storey with the smallest Depth, the same rule nrc-enrich-run uses, so perStorey and storeyComparison count each element once." }
  }
}

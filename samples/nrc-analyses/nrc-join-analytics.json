  "values": {
    "about": { "text": "Template: joins an analytics CSV to a model by GlobalId (here the IFC viewer test kit's analytics_dataset_with_levels.csv, 268 rows, over duplex-base.ifc). Set the csv input to another CSV under the nrc sample folder and model to another IFC; the entity and storey tables come from the duplex-base database source, so another model also needs its database registered under that name. answer counts CSV rows with no entity (0), physical elements with no CSV row (21), and CSV rows on entities with no mesh (52: openings and stairs). An element that reaches several storeys gets the one with the smallest Depth, the rule nrc-enrich-run uses, so perStorey and storeyComparison count each element once; levelAgreement counts the 61 rows whose Level (often a door or window mark such as A102) is not the model's storey." },
    "csv": { "path": "$csv" },
    "model": { "path": "$model" },
    "entities": { "source": "duplex-base", "table": "EntityText" },
    "storeyOf": { "source": "duplex-base", "table": "StoreyOfElement" },
    "analytics": { "source": "nrc" },
    "analyticsRows": { "limit": "0" },
    "instances": { "name": "instances" },
    "coloredCarbon": { "joinColumn": "globalId", "valueColumn": "operational_carbon", "colorMap": "viridis" },
    "coloredCategory": { "joinColumn": "globalId", "valueColumn": "category", "colorMap": "category10" },
    "physical": { "groupBy": "globalId", "aggregates": "count(*) as meshCount" },
    "storeyOfMin": { "sql": "SELECT * FROM t1 QUALIFY row_number() OVER (PARTITION BY EntityIndex ORDER BY Depth) = 1" },
    "entityStorey": { "leftKey": "EntityIndex", "rightKey": "EntityIndex", "kind": "inner" },
    "csvNoEntity": { "leftKey": "GlobalId", "rightKey": "GlobalId", "kind": "anti" },
    "physicalEntities": { "leftKey": "GlobalId", "rightKey": "globalId", "kind": "semi" },
    "nonPhysicalEntities": { "leftKey": "GlobalId", "rightKey": "globalId", "kind": "anti" },
    "physicalNoCsv": { "leftKey": "GlobalId", "rightKey": "GlobalId", "kind": "anti" },
    "csvMatchedNonPhysical": { "leftKey": "GlobalId", "rightKey": "GlobalId", "kind": "semi" },
    "matchCounts": { "sql": "SELECT (SELECT count(*) FROM t1) AS CsvRowsWithNoEntity, (SELECT count(*) FROM t2) AS PhysicalElementsWithNoCsvRow, (SELECT count(*) FROM t3) AS CsvRowsMatchingNonPhysicalEntity" },
    "matchRows": { "limit": "0" },
    "answer": { "title": "How the CSV and the model match" },
    "csvWithStorey": { "leftKey": "GlobalId", "rightKey": "GlobalId", "kind": "inner" },
    "withStorey": { "limit": "0" },
    "agrees": { "name": "Agrees", "expr": "lower(Level) == lower(StoreyName)" },
    "storeyComparison": { "title": "CSV Level against the model's storey", "columns": "Name, Level, StoreyName, Agrees, GlobalId" },
    "levelCounts": { "groupBy": "Agrees", "aggregates": "count(*) as Rows" },
    "levelAgreement": { "title": "CSV rows whose Level agrees with the model's storey" },
    "storeyTotals": { "groupBy": "StoreyName", "aggregates": "count(*) as Elements, sum(operational_carbon) as TotalOperationalCarbon, avg(operational_carbon) as MeanOperationalCarbon, avg(energy_intensity) as MeanEnergyIntensity" },
    "perStorey": { "title": "Operational carbon per storey (CSV values, model storeys)" }
  }
}

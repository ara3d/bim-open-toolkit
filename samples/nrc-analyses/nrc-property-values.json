      "source": "duplex-enriched",
      "table": "ParameterText"
    },
    "entities": {
      "source": "duplex-enriched",
      "table": "EntityText"
    },
    "nrcOnly": {
      "expr": "startswith([ParameterGroup], 'Pset_NRC')"
    },
    "withStepId": {
      "leftKey": "EntityIndex",
      "rightKey": "EntityIndex",
      "kind": "inner"
    },
    "columns": {
      "columns": "StepId as entityId, ParameterGroup as psetName, Name as paramName, ValueType as valueType, Value as paramValue"
    },
    "answer": {
      "by": "entityId, psetName, paramName"

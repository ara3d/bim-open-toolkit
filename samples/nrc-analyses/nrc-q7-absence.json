  "values": {
    "about": {
      "text": "Q7: which analysed elements carry no embodied-carbon property set. One reader of nrc_analytics_long.csv feeds the anti join twice: every metric row on the left, the NRC.EC.A1A3.TOTAL rows on the right. The join keeps the rows whose GlobalId has no embodied-carbon row, and the aggregate counts them per element. The answer is exactly one element, the IfcRoof 0jf0rYHfX3RAB3bSIRjmxl, as a row and not a zero; OtherMetrics counts the metric rows it does have."
    },
    "metrics": {
      "path": "nrc_analytics_long.csv",
      "source": "nrc"
    },
    "embodied": {
      "expr": "[MetricId] == 'NRC.EC.A1A3.TOTAL'"
    },
    "missing": {
      "kind": "anti",
      "leftKey": "GlobalId",
      "rightKey": "GlobalId"
    },
    "answer": {
      "aggregates": "count(*) as OtherMetrics",
      "groupBy": "IfcClass, GlobalId"
    }
  }
}

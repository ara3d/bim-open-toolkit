  "values": {
    "about": {
      "text": "Q7: which element has no embodied-carbon value. One reader of nrc_analytics_long.csv feeds both filters; the anti join keeps the roof rows whose GlobalId has no NRC.EC.A1A3.TOTAL row. The answer is the roof itself, as a row, not a zero; OtherMetrics counts the metric rows it does have."
    },
    "metrics": {
      "path": "nrc_analytics_long.csv",
      "source": "nrc"
    },
    "roofs": {
      "expr": "[IfcClass] == 'IFCROOF'"
    },
    "embodied": {
      "expr": "[MetricId] == 'NRC.EC.A1A3.TOTAL'"
    },
    "missing": {
      "kind": "anti",
      "leftKey": "GlobalId",
      "rightKey": "GlobalId"
    },
    "answer": {
      "aggregates": "count(*) as OtherMetrics",
      "groupBy": "IfcClass, GlobalId"
    }
  }
}

    "about": {
      "text": "Q5: operational carbon summed per IFC class, highest first: IFCWALLSTANDARDCASE leads at 17,547.4 kgCO2e/yr and IFCRAILING is last at 164.8, 14 classes in all. The file carries no Category property, so the question asks per IFC class. rows runs the plan so chart can draw the 14 totals as bars."
    },
    "elements": {
      "path": "nrc_analytics_elements.csv",
      "source": "nrc"
    },
    "perClass": {
      "aggregates": "sum(OperationalCarbon_kgCO2e_per_year) as OperationalCarbon_kgCO2e_per_year",
      "groupBy": "IfcType"
    },
    "answer": {
      "by": "OperationalCarbon_kgCO2e_per_year desc"
    },
    "rows": {
      "limit": "0"
    },

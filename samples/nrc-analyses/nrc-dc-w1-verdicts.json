  "values": {
    "about": {
      "text": "Rule DC-W1 over the 14 doors of duplex-enriched: a door's Ifc:OverallWidth, in millimetres, must be at least 850 (NBC 2020 3.8.3.12, illustrative, not legal text); 8 pass and 6 fail. This is the check.rule twin of checking-analyses/check-ids-door-width, which states the same rule as an IDS file and gets the same verdicts. coloured paints the verdicts on the model, chart counts them, and report writes its HTML file only when you press Run."
    },
    "entities": {
      "source": "duplex-enriched",
      "table": "EntityText"
    },
    "parameters": {
      "source": "duplex-enriched",
      "table": "ParameterText"
    },
    "doors": {
      "expr": "[Category] == 'IFCDOOR'"
    },
    "overallWidth": {
      "expr": "[Name] == 'Ifc:OverallWidth'"
    },
    "doorWidths": {
      "leftKey": "EntityIndex",
      "rightKey": "EntityIndex",
      "kind": "inner"
    },
    "widthMm": {
      "name": "Width_mm",
      "expr": "toNumber([Value]) * 1000"
    },
    "columns": {
      "columns": "Name, Width_mm, GlobalId"
    },
    "byDoor": {
      "by": "GlobalId"
    },
    "rows": {
      "limit": "0"
    },
    "answer": {
      "checkId": "DC-W1",
      "title": "Door leaf width at least 850 mm",
      "citation": "NBC 2020 3.8.3.12 (illustrative, not legal text)",
      "expr": "[Width_mm] >= 850",
      "reviewExpr": ""
    },
    "model": {
      "path": "{SAMPLES}/duplex-enriched.ifc"
    },
    "coloured": {
      "joinColumn": "GlobalId",
      "valueColumn": "Verdict",
      "colorMap": "category10"
    },
    "perVerdict": {
      "groupBy": "Verdict",
      "aggregates": "count(*) as Doors"
    },
    "chart": {
      "labelColumn": "Verdict",
      "valueColumns": "Doors",
      "title": "DC-W1 door width verdicts",
      "sort": "desc"
    },
    "report": {
      "path": "{ARTIFACTS}/nrc/dc-w1-verdicts.html",
      "title": "DC-W1 door width verdicts"
    }
  }
}

  "values": {
    "about": { "text": "Q6: which analysis run produced the numbers, and when. All 218 elements cite one run (AnalysisRunId, ScenarioName). The elements do not say when it ran, so runFacts reads ComputedAt and SourceTool from nrc-run.csv, the run-level fact file, and answer adds them to the one row." },
    "elements": { "path": "nrc_analytics_elements.csv", "source": "nrc" },
    "counts": { "aggregates": "count(*) as Elements", "groupBy": "AnalysisRunId, ScenarioName" },
    "run": { "path": "nrc-run.csv", "source": "nrc" },
    "runFacts": { "sql": "SELECT (SELECT Value FROM t1 WHERE Field = 'ComputedAt') AS ComputedAt, (SELECT Value FROM t1 WHERE Field = 'SourceTool') AS SourceTool" },
    "answer": { "sql": "SELECT t1.*, t2.ComputedAt, t2.SourceTool FROM t1 CROSS JOIN t2" }
  }
}

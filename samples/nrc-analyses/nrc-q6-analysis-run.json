{
  "formatVersion": "0.1.0",
  "layout": {
    "counts": { "x": 370, "y": 40 },
    "elements": { "x": 40, "y": 40 },
    "run": { "x": 40, "y": 280 },
    "when": { "x": 370, "y": 280 },
    "answer": { "x": 700, "y": 40 }
  },
  "structure": {
    "edges": [
      { "from": "elements.relation", "to": "counts.input" },
      { "from": "run.relation", "to": "when.t1" },
      { "from": "counts.relation", "to": "answer.t1" },
      { "from": "when.relation", "to": "answer.t2" }
    ],
    "nodes": [
      { "id": "counts", "kind": "rel.aggregate", "version": 1 },
      { "id": "elements", "kind": "rel.csv", "version": 1 },
      { "id": "run", "kind": "rel.csv", "version": 1 },
      { "id": "when", "kind": "rel.sql", "version": 1 },
      { "id": "answer", "kind": "rel.sql", "version": 1 }
    ]
  },
  "values": {
    "counts": { "aggregates": "count(*) as Elements", "groupBy": "AnalysisRunId, ScenarioName" },
    "elements": { "path": "nrc_analytics_elements.csv", "source": "nrc" },
    "run": { "path": "nrc-run.csv", "source": "nrc" },
    "when": { "sql": "SELECT (SELECT Value FROM t1 WHERE Field = 'ComputedAt') AS ComputedAt, (SELECT Value FROM t1 WHERE Field = 'SourceTool') AS SourceTool" },
    "answer": { "sql": "SELECT t1.*, t2.ComputedAt, t2.SourceTool FROM t1 CROSS JOIN t2" }
  }
}

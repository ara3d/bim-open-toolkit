{
  "formatVersion": "0.1.0",
  "layout": {
    "about": { "x": 40, "y": 40, "w": 560, "h": 131 },
    "model": { "x": 40, "y": 247 },
    "inst": { "x": 385, "y": 211 },
    "largest": { "x": 734, "y": 211 }
  },
  "structure": {
    "inputs": [
      { "default": "{SAMPLES}/duplex-base.ifc", "description": "The building's IFC file; any IFC model works here.", "kind": "FilePath", "name": "model" }
    ],
    "edges": [
      { "from": "model.path", "to": "inst.path" },
      { "from": "inst.instances", "to": "largest.instances" }
    ],
    "nodes": [
      { "id": "about", "kind": "view.note", "version": 1 },
      { "id": "model", "kind": "value.path", "version": 1 },
      { "id": "inst", "kind": "view3d.instances", "version": 1 },
      { "id": "largest", "kind": "view3d.decimate", "version": 1 }
    ]
  },
  "values": {
    "about": { "text": "A light overview of a large model: drops instances whose bounding-box diagonal is under 0.5 m, then keeps the largest quarter of the rest by box volume. On the Duplex it keeps 172 of 714 instances. Instance thinning only; each kept mesh is drawn in full." },
    "model": { "path": "$model" },
    "largest": { "keepFraction": "0.25", "minDiagonal": "0.5" }
  }
}

{
  "formatVersion": "0.1.0",
  "layout": {
    "about": { "x": 40, "y": 40, "w": 560, "h": 131 },
    "model": { "x": 40, "y": 247 },
    "inst": { "x": 385, "y": 211 },
    "arranged": { "x": 734, "y": 211 }
  },
  "structure": {
    "inputs": [
      { "default": "{SAMPLES}/duplex-base.ifc", "description": "The building's IFC file; any IFC model works here.", "kind": "FilePath", "name": "model" }
    ],
    "edges": [
      { "from": "model.path", "to": "inst.path" },
      { "from": "inst.instances", "to": "arranged.instances" }
    ],
    "nodes": [
      { "id": "about", "kind": "view.note", "version": 1 },
      { "id": "model", "kind": "value.path", "version": 1 },
      { "id": "inst", "kind": "view3d.instances", "version": 1 },
      { "id": "arranged", "kind": "view3d.arrange", "version": 1 }
    ]
  },
  "values": {
    "about": { "text": "Lays the model's IFC categories out side by side on a grid (view3d.arrange, 5 m gap), so each category can be seen on its own and the first frame shows them all. On the Duplex the 14 categories fill about 52 m by 113 m." },
    "model": { "path": "$model" },
    "arranged": { "groupColumn": "category", "gap": "5" }
  }

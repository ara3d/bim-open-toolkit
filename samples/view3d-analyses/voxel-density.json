{
  "formatVersion": "0.1.0",
  "layout": {
    "about": { "x": 40, "y": 40, "w": 560, "h": 104 },
    "model": { "x": 40, "y": 232 },
    "inst": { "x": 385, "y": 196 },
    "voxels": { "x": 734, "y": 196 },
    "colored": { "x": 1083, "y": 184 }
  },
  "structure": {
    "inputs": [
      { "default": "{SAMPLES}/duplex-base.ifc", "description": "The building's IFC file; any IFC model works here.", "kind": "FilePath", "name": "model" }
    ],
    "edges": [
      { "from": "model.path", "to": "inst.path" },
      { "from": "inst.instances", "to": "voxels.instances" },
      { "from": "voxels.boxes", "to": "colored.instances" },
      { "from": "voxels.boxes", "to": "colored.values" }
    ],
    "nodes": [
      { "id": "about", "kind": "view.note", "version": 1 },
      { "id": "model", "kind": "value.path", "version": 1 },
      { "id": "inst", "kind": "view3d.instances", "version": 1 },
      { "id": "voxels", "kind": "view3d.voxelize", "version": 1 },
      { "id": "colored", "kind": "view3d.color", "version": 1 }
    ]
  },
  "values": {
    "about": { "text": "Cuts the model into 0.5 m voxels and colours each by how many instances' boxes reach into it, a quick view of where the model is dense. On the Duplex that is 14,503 voxels with counts from 1 to 17." },
    "model": { "path": "$model" },
    "voxels": { "size": "0.5" },
    "colored": { "colorMap": "viridis", "joinColumn": "voxelId", "valueColumn": "count" }
  }
}

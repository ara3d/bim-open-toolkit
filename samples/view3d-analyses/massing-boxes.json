{
  "formatVersion": "0.1.0",
  "layout": {
    "about": { "x": 40, "y": 40, "w": 560, "h": 131 },
    "model": { "x": 40, "y": 259 },
    "inst": { "x": 385, "y": 223 },
    "boxes": { "x": 734, "y": 223 },
    "colored": { "x": 1083, "y": 211 }
  },
  "structure": {
    "inputs": [
      { "default": "{SAMPLES}/duplex-base.ifc", "description": "The building's IFC file; any IFC model works here.", "kind": "FilePath", "name": "model" }
    ],
    "edges": [
      { "from": "model.path", "to": "inst.path" },
      { "from": "inst.instances", "to": "boxes.instances" },
      { "from": "boxes.boxes", "to": "colored.instances" },
      { "from": "boxes.boxes", "to": "colored.values" }
    ],
    "nodes": [
      { "id": "about", "kind": "view.note", "version": 1 },
      { "id": "model", "kind": "value.path", "version": 1 },
      { "id": "inst", "kind": "view3d.instances", "version": 1 },
      { "id": "boxes", "kind": "view3d.boundingBoxes", "version": 1 },
      { "id": "colored", "kind": "view3d.color", "version": 1 }
    ]
  },
  "values": {
    "about": { "text": "One bounding box per IFC category, the union of its instances' boxes, coloured by category (the box label). category10 has 10 colours, so with more categories some share one: on the Duplex 14 boxes use 10 colours. The boxes are opaque and overlap." },
    "model": { "path": "$model" },
    "boxes": { "groupColumn": "category" },
    "colored": { "colorMap": "category10", "joinColumn": "label", "valueColumn": "label" }
  }
}

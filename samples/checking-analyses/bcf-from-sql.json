  "structure": {
    "inputs": [
      {
        "name": "model",
        "kind": "FilePath",
        "default": "{SAMPLES}/duplex-enriched.bos",
        "description": "The building's BIM Open Schema (.bos) file; the NRC Duplex by default, any .bos file works here."
      }
    ],
    "edges": [
      {
        "from": "modelPath.path",
        "to": "model.path"
      },
      {
        "from": "model.entities",
        "to": "doors.table"
      },
      {
        "from": "model.parameters",
        "to": "isExternal.table"
      },
      {
        "from": "isExternal.table",
        "to": "external.a"
      },
      {
        "from": "doors.table",
        "to": "external.b"
      },
      {
        "from": "external.table",
        "to": "titled.table"
      },
      {
        "from": "titled.table",
        "to": "described.table"
      },
      {
        "from": "described.table",
        "to": "columns.table"
      },
      {
        "from": "columns.table",
        "to": "sorted.table"
      },
      {
        "from": "sorted.table",
        "to": "topics.issues"
      },
      {
        "from": "topics.topics",
        "to": "answer.table"
      },
      {
        "from": "sorted.table",
        "to": "bcf.issues"
      },
      {
        "from": "modelPath.path",
        "to": "bcf.model"
      }
    ],
    "nodes": [
      {
        "id": "about",
        "kind": "view.note",
        "version": 1
      },
      {
        "id": "modelPath",
        "kind": "value.path",
        "version": 1
      },
      {
        "id": "model",
        "kind": "bos.load",
        "version": 1
      },
      {
        "id": "doors",
        "kind": "table.filter",
        "version": 1
      },
      {
        "id": "external",
        "kind": "table.join",
        "version": 1
      },
      {
        "id": "titled",
        "kind": "table.derive",
        "version": 1
      },
      {
        "id": "described",
        "kind": "table.derive",
        "version": 1
      },
      {
        "id": "columns",
        "kind": "table.project",
        "version": 1
      },
      {
        "id": "sorted",
        "kind": "table.sort",
        "version": 1
      },
      {
        "id": "topics",

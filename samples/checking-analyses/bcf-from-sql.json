  "values": {
    "about": {
      "text": "The Duplex's external doors as one BCF issue, with table steps and no SQL: the parameter rows where Pset_DoorCommon.IsExternal is true, joined to the doors among the entities (the door's name arrives as Name_b), then a title and a description derived for each. topics, shown in answer, previews the topic; bcf writes artifacts/checking/external-doors.bcf with a viewpoint only when you press Run."
    },
    "modelPath": {
      "path": "$model"
    },
    "model": {
      "harmonize": "false"
    },
    "doors": {
      "expr": "[Category] == 'IFCDOOR'"
    },
    "isExternal": {
      "expr": "[ParameterGroup] == 'Pset_DoorCommon' and [Name] == 'IsExternal' and [Value] == '.T.'"
    },
    "external": {
      "aKey": "EntityIndex",
      "bKey": "EntityIndex",
      "mode": "inner"
    },
    "titled": {
      "name": "Title",
      "expr": "'External doors'"
    },
    "described": {
      "name": "Description",
      "expr": "'Pset_DoorCommon.IsExternal is true: confirm the weather seal on ' & [Name_b]"
    },
    "columns": {
      "columns": "Title, Description, Name_b as Name, GlobalId"
    },
    "sorted": {
      "A": "GlobalId"
    },
    "topics": {
      "preset": "issue",
      "verdicts": ""
    },
    "answer": {
      "title": "BCF topic Run will write",
      "columns": "Title, Elements, Description, GlobalIds"
    },
    "bcf": {
      "path": "{ARTIFACTS}/checking/external-doors.bcf",
      "preset": "issue",
      "verdicts": "",
      "author": "",
      "guidSeed": "external-doors"
    }
  }
}

{
  "formatVersion": "0.1.0",
  "layout": {
    "model": {
      "x": 40,
      "y": 40
    },
    "doors": {
      "x": 370,
      "y": 40
    },
    "topics": {
      "x": 700,
      "y": 40
    },
    "bcf": {
      "x": 700,
      "y": 300
    }
  },
  "structure": {
    "edges": [
      {
        "from": "model.entities",
        "to": "doors.t1"
      },
      {
        "from": "model.parameters",
        "to": "doors.t2"
      },
      {
        "from": "doors.table",
        "to": "topics.issues"
      },
      {
        "from": "doors.table",
        "to": "bcf.issues"
      }
    ],
    "nodes": [
      {
        "id": "model",
        "kind": "bos.load",
        "version": 1
      },
      {
        "id": "doors",
        "kind": "sql.query",
        "version": 1
      },
      {
        "id": "topics",
        "kind": "bcf.topics",
        "version": 1
      },
      {
        "id": "bcf",
        "kind": "bcf.write",
        "version": 1
      }
    ]
  },
  "values": {
    "model": {
      "path": "{SAMPLES}/duplex-enriched.bos",
      "harmonize": "false"
    },
    "doors": {
      "sql": "SELECT e.GlobalId, 'External doors' AS Title, 'Pset_DoorCommon.IsExternal is true: confirm the weather seal on ' || e.Name AS Description, 'Normal' AS Priority FROM t1 e JOIN t2 p ON p.EntityIndex = e.EntityIndex WHERE e.Category = 'IFCDOOR' AND p.ParameterGroup = 'Pset_DoorCommon' AND p.Name = 'IsExternal' AND p.Value = '.T.' ORDER BY e.GlobalId"
    },
    "topics": {
      "preset": "issue",
      "verdicts": ""
    },
    "bcf": {
      "path": "{SAMPLES}/../../artifacts/checking/external-doors.bcf",
      "model": "{SAMPLES}/duplex-enriched.bos",
      "preset": "issue",
      "verdicts": "",
      "author": "",
      "guidSeed": "external-doors"
    }
  }
}

  "structure": {
    "inputs": [
      {
        "name": "geometry",
        "kind": "FilePath",
        "default": "{SAMPLES}/duplex-enriched.ifc",
        "description": "The same building as an IFC file, for the 3D scene: view3d.instances meshes IFC and cannot read a .bos file yet."
      },
      {
        "name": "model",
        "kind": "FilePath",
        "default": "{SAMPLES}/duplex-enriched.bos",
        "description": "The building's BIM Open Schema (.bos) file; the NRC Duplex by default, any .bos file works here."
      }
    ],
    "edges": [
      {
        "from": "modelPath.path",
        "to": "model.path"
      },
      {
        "from": "model.entities",
        "to": "verdicts.entities"
      },
      {
        "from": "model.parameters",
        "to": "verdicts.parameters"
      },
      {
        "from": "verdicts.verdicts",
        "to": "named.a"
      },
      {
        "from": "model.entities",
        "to": "named.b"
      },
      {
        "from": "named.table",
        "to": "sorted.table"
      },
      {
        "from": "sorted.table",
        "to": "answer.table"
      },
      {
        "from": "verdicts.verdicts",
        "to": "perVerdict.table"
      },
      {
        "from": "perVerdict.table",
        "to": "chart.table"
      },
      {
        "from": "scenePath.path",
        "to": "scene.path"
      },
      {
        "from": "scene.instances",
        "to": "coloured.instances"
      },
      {
        "from": "verdicts.verdicts",
        "to": "coloured.values"
      }
    ],
    "nodes": [
      {
        "id": "about",
        "kind": "view.note",
        "version": 1
      },
      {
        "id": "modelPath",
        "kind": "value.path",
        "version": 1
      },
      {

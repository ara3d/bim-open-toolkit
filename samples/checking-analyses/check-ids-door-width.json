        "kind": "chart.bar",
        "version": 1
      },
      {
        "id": "scenePath",
        "kind": "value.path",
        "version": 1
      },
      {
        "id": "scene",
        "kind": "view3d.instances",
        "version": 1
      },
      {
        "id": "coloured",
        "kind": "view3d.color",
        "version": 1
      }

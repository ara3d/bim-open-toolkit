  "values": {
    "about": {
      "text": "Rule DC-W1, a door leaf at least 850 mm wide (NBC 2020 3.8.3.12, illustrative), stated as an IDS file (samples/nrc/ids/dc-w1.ids) and checked by ids.check over the 14 doors of the Duplex: 8 pass and 6 fail, the same verdicts as nrc-dc-w1-verdicts gets with check.rule. answer names each door; chart counts the verdicts and coloured paints them on the model. The scene reads the IFC through the second input, geometry, because view3d.instances cannot read a .bos file yet; point both inputs at the same building."
    },
    "modelPath": {
      "path": "$model"
    },
    "model": {
      "harmonize": "false"
    },
    "verdicts": {
      "ids": "{SAMPLES}/ids/dc-w1.ids"
    },
    "named": {
      "aKey": "EntityIndex",
      "bKey": "EntityIndex",
      "mode": "left"
    },
    "sorted": {
      "A": "Verdict",
      "B": "Name"
    },
    "answer": {
      "title": "DC-W1 door width verdicts",
      "columns": "Name, Verdict, Reason, GlobalId"
    },
    "perVerdict": {
      "groupBy": "Verdict",
      "aggregates": "count(*) as Doors"
    },
    "chart": {
      "labelColumn": "Verdict",
      "valueColumns": "Doors",
      "title": "DC-W1 as an IDS: door width verdicts",
      "sort": "desc"
    },
    "scenePath": {
      "path": "$geometry"
    },
    "coloured": {
      "joinColumn": "GlobalId",
      "valueColumn": "Verdict",
      "colorMap": "category10"
    }
  }
}

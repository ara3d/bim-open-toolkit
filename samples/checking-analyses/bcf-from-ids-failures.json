  "values": {
    "about": {
      "text": "The DC-W1 door width IDS checked over the Duplex, and its 6 failing doors turned into one BCF topic. topics, shown in answer, is the preview of the file Run writes: nothing is written until then. bcf then writes artifacts/checking/dc-w1-failures.bcf with one viewpoint framing the doors, read from the same model input."
    },
    "modelPath": {
      "path": "$model"
    },
    "model": {
      "harmonize": "false"
    },
    "verdicts": {
      "ids": "{SAMPLES}/ids/dc-w1.ids"
    },
    "topics": {
      "preset": "auto",
      "verdicts": "Fail"
    },
    "answer": {
      "title": "BCF topics Run will write",
      "columns": "Title, Elements, Description, Status, GlobalIds"
    },
    "bcf": {
      "path": "{ARTIFACTS}/checking/dc-w1-failures.bcf",
      "preset": "auto",
      "verdicts": "Fail",
      "author": "",
      "guidSeed": "dc-w1"
    }
  }

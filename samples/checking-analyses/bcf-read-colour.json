  "structure": {
    "inputs": [
      {
        "name": "model",
        "kind": "FilePath",
        "default": "{SAMPLES}/duplex-enriched.ifc",
        "description": "The building's IFC file, the one the BCF's GlobalIds come from; view3d.instances meshes IFC."
      }
    ],
    "edges": [
      {
        "from": "issues.topics",
        "to": "answer.table"
      },
      {
        "from": "modelPath.path",
        "to": "scene.path"
      },
      {
        "from": "scene.instances",
        "to": "coloured.instances"
      },
      {
        "from": "issues.issues",
        "to": "coloured.values"
      }
    ],
    "nodes": [
      {
        "id": "about",
        "kind": "view.note",
        "version": 1
      },
      {
        "id": "issues",
        "kind": "bcf.read",
        "version": 1
      },
      {
        "id": "answer",
        "kind": "view.table",
        "version": 1
      },
      {
        "id": "modelPath",
        "kind": "value.path",
        "version": 1
      },
      {
        "id": "scene",
        "kind": "view3d.instances",
        "version": 1
      },
      {
        "id": "coloured",
        "kind": "view3d.color",
        "version": 1
      }
    ]
  },
  "values": {
    "about": {
      "text": "bcf.read over the committed samples/nrc/bcf/dc-w1-failures.bcf, not the file bcf-from-ids-failures writes on Run: one topic flagging 6 doors. answer is the file's topics table; coloured paints the flagged doors on the model input, an IFC file because view3d.instances meshes IFC, matched on GlobalId."
    },
    "issues": {
      "path": "{SAMPLES}/bcf/dc-w1-failures.bcf"
    },
    "answer": {
      "title": "Topics in the committed BCF",
      "columns": "Title, Elements, Status, Type, Description"
    },
    "modelPath": {
      "path": "$model"
    },
    "coloured": {
      "joinColumn": "GlobalId",
      "valueColumn": "Title",
      "colorMap": "category10"
    }
  }
}

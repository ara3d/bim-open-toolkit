  "values": {
    "about": { "text": "Role: a sustainability lead. Question: which few materials carry 80% of the Duplex's embodied carbon (A1-A3), and where are they in the building?\nHow it splits: each element's carbon (nrc_analytics_elements.csv, synthetic) is shared over its IFC material layers in proportion to layer thickness, which within one element is its share of volume. Air-space layers carry no embodied carbon and are dropped first ('solidLayers'). Beams name one material and keep all their carbon ('direct' gives them a weight of 1). A layer with no thickness keeps a missing weight, so its slice stays missing. Elements with no material in the IFC are grouped by IFC class as '<class> (no material)', so no carbon is lost: 'totalsTable' sums the element carbon and the bars side by side, and the two totals should match.\nHow to read it: 'chart' ranks the total per material or class ('ranked'); the Vega-Lite spec adds the cumulative share as a line and a rule at 80%. ParetoClass A is the groups needed to reach 80%, B the next 15%, C the rest. A material only the IFCROOF uses stays missing, never zero, because that element has no carbon value. The 3D view ('colored') gives every element the colour of its main material's bar (the layer holding most of its carbon, or its class) on the same viridis scale; grey is an element outside the carbon table, or the IFCROOF.\nThe numbers for the Duplex are in samples/viz-analyses/README.md." },
    "database": { "path": "{SAMPLES}/duplex-enriched.duckdb" },
    "layers": { "sql": "SELECT e.GlobalId, m.Material, TRY_CAST(t.Value AS DOUBLE) AS Weight FROM EntityText e JOIN RelationText l ON l.EntityIndexA = e.EntityIndex AND l.RelationType = 'HasLayer' JOIN (SELECT DISTINCT EntityIndexA, NameB AS Material FROM RelationText WHERE RelationType = 'HasMaterial') m ON m.EntityIndexA = l.EntityIndexB LEFT JOIN ParameterText t ON t.EntityIndex = l.EntityIndexB AND t.Name = 'Ifc:LayerThickness' WHERE e.GlobalId IS NOT NULL ORDER BY e.GlobalId, m.Material" },
    "solidLayers": { "expr": "not startswith(Material, 'Misc. Air Layers')" },
    "direct": { "sql": "SELECT DISTINCT e.GlobalId, r.NameB AS Material, 1.0 AS Weight FROM EntityText e JOIN RelationText r ON r.EntityIndexA = e.EntityIndex AND r.RelationType = 'HasMaterial' WHERE e.GlobalId IS NOT NULL ORDER BY e.GlobalId" },
    "materials": { "columns": "byName" },
    "layerShare": { "function": "percentOfTotal", "column": "Weight", "partitionBy": "GlobalId", "name": "LayerShare" },
    "slices": { "aKey": "GlobalId", "bKey": "GlobalId", "mode": "full" },
    "labelled": { "name": "MaterialOrClass", "expr": "isnull(Material) ? IfcType & ' (no material)' : Material" },
    "allocated": { "name": "EmbodiedCarbon_kgCO2e", "expr": "isnull(Material) ? EmbodiedCarbon_A1A3_kgCO2e : EmbodiedCarbon_A1A3_kgCO2e * LayerShare" },
    "byMaterial": { "groupBy": "MaterialOrClass", "aggregates": "sum(EmbodiedCarbon_kgCO2e) as MaterialTotal_kgCO2e" },
    "ranked": { "A": "MaterialTotal_kgCO2e", "descendingA": "true", "B": "MaterialOrClass" },
    "share": { "function": "percentOfTotal", "column": "MaterialTotal_kgCO2e", "name": "Share" },
    "cumulative": { "function": "cumSum", "column": "Share", "name": "CumulativeShare" },
    "pareto": { "name": "ParetoClass", "expr": "isnull(Share) ? 'no carbon value' : (CumulativeShare - Share < 0.8 ? 'A' : (CumulativeShare - Share < 0.95 ? 'B' : 'C'))" },
    "synthetic": { "name": "Synthetic", "expr": "true" },
    "scale": { "valueColumn": "MaterialTotal_kgCO2e", "colorMap": "viridis" },
    "chart": { "labelColumn": "MaterialOrClass", "valueColumns": "MaterialTotal_kgCO2e", "title": "Embodied carbon A1-A3 by material (kgCO2e, synthetic), ranked; ten groups make 80%" },
    "paretoTable": { "title": "Pareto of embodied carbon by material", "columns": "MaterialOrClass,MaterialTotal_kgCO2e,Share,CumulativeShare,ParetoClass,Synthetic" },
    "barTotal": { "groupBy": "", "aggregates": "sum(MaterialTotal_kgCO2e) as Total_kgCO2e,count(*) as Rows,count(MaterialTotal_kgCO2e) as RowsWithCarbon" },
    "barScope": { "name": "Scope", "expr": "'bars: materials and no-material classes'" },
    "elementTotal": { "groupBy": "", "aggregates": "sum(EmbodiedCarbon_A1A3_kgCO2e) as Total_kgCO2e,count(*) as Rows,count(EmbodiedCarbon_A1A3_kgCO2e) as RowsWithCarbon" },
    "elementScope": { "name": "Scope", "expr": "'elements in nrc_analytics_elements.csv'" },
    "totals": { "columns": "byName" },
    "totalsTable": { "title": "Carbon before and after the split by material (the two totals should match)", "columns": "Scope,Total_kgCO2e,Rows,RowsWithCarbon" },
    "sliceRank": { "function": "rowNumber", "partitionBy": "GlobalId", "orderBy": "EmbodiedCarbon_kgCO2e desc,MaterialOrClass", "name": "SliceRank" },
    "dominant": { "expr": "SliceRank == 1 and not isnull(EmbodiedCarbon_kgCO2e)" },
    "withTotal": { "aKey": "MaterialOrClass", "bKey": "MaterialOrClass", "mode": "left" },
    "elements": { "columns": "GlobalId,EntityId,Storey,IfcType,MaterialOrClass,EmbodiedCarbon_A1A3_kgCO2e,MaterialTotal_kgCO2e,ParetoClass" },
    "colored": { "joinColumn": "globalId", "valueColumn": "MaterialTotal_kgCO2e" },
    "model": { "path": "{SAMPLES}/duplex-enriched.ifc" },
    "carbonFile": { "path": "{SAMPLES}/nrc_analytics_elements.csv" }
  }
}

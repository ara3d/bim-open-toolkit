  "values": {
    "about": { "text": "Project manager: how many elements should be installed by each week, and how far behind is the site? BOTH SERIES ARE SYNTHETIC. Planned is the cumulative count of elements whose bim.buildSequence task has finished by the end of each week (10-day tasks from 2027-01-04, storeys bottom-up, trades overlapping by one floor); Actual is the same curve held three weeks late (table.window lag 3), a made-up slip, not site data. On the S-curve, the vertical gap between the lines at a week is the shortfall in elements, and the horizontal gap at a height is the delay in weeks; week 0 is the start. Storeys come from StoreyOfElement in the DuckDB export, because bim.elements has no Level for an IFC-derived model." },
    "elements": { "sql": "SELECT e.StepId, e.GlobalId, e.Name, e.Category, s.StoreyName AS Level, CAST(p.Value AS DOUBLE) AS Elevation FROM (SELECT EntityIndex, arg_min(StoreyIndex, Depth) AS StoreyIndex, arg_min(StoreyName, Depth) AS StoreyName FROM StoreyOfElement GROUP BY EntityIndex) s JOIN EntityText e USING (EntityIndex) LEFT JOIN ParameterText p ON p.EntityIndex = s.StoreyIndex AND p.Name = 'Ifc:Elevation' ORDER BY e.StepId" },
    "sequence": { "levelColumn": "Level", "elevationColumn": "Elevation", "column": "Category", "start": "2027-01-04", "daysPerTask": "10", "trades": "Structure,Envelope,MEP,Finishes" },
    "weekly": { "groupBy": "FinishWeek", "aggregates": "count(Task) as Installed" },
    "spine": { "name": "Week", "start": "0", "stop": "11", "step": "1" },
    "joined": { "aKey": "Week", "bKey": "FinishWeek", "mode": "left" },
    "zeroWeeks": { "name": "Finished", "expr": "coalesce(Installed, 0)" },
    "planned": { "function": "cumSum", "column": "Finished", "orderBy": "Week", "name": "Planned" },
    "actual": { "function": "lag", "column": "Planned", "orderBy": "Week", "offset": "3", "name": "LaggedPlanned" },
    "zeroActual": { "name": "Actual", "expr": "coalesce(LaggedPlanned, 0)" },
    "synthetic": { "name": "Synthetic", "expr": "true" },
    "curve": { "xColumn": "Week", "yColumns": "Planned,Actual", "title": "Elements installed by week (synthetic)" },
    "database": { "path": "{SAMPLES}/duplex-enriched.duckdb" },
    "answer": { "title": "Synthetic progress by week (elements)", "columns": "Week,Finished,Planned,Actual,Synthetic" }
  }
}

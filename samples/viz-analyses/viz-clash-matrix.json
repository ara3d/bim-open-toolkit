  "values": {
    "about": {
      "text": "Clash candidate matrix, for a coordinator. Question: which pairs of IFC classes have the most elements whose bounding boxes overlap, and which elements are involved most often? These are box candidates, not clashes: each element's axis-aligned bounding box (the union of its meshes' boxes from view3d.instances) is tested against every other with spatial.intersects, so an L-shaped wall or a stair's box overlaps things its geometry never touches. Spaces and openings are left out. A pair counts only when the boxes share more than 0.001 m3 (one litre), so walls that merely meet a slab are not counted. spatial.intersects lists each pair twice, once per direction, with self-pairs already dropped; the filter A < B keeps each element pair once, and the row and column classes are put in alphabetical order so the matrix is an upper triangle. Read the figure: the heatmap (specs/viz-clash-matrix.vl.json) puts the row class down the side and the column class across the top, darker for more candidate pairs; the matrix table shows the same numbers, and the 3D view colours each element by how many candidates it is in, grey for none. On the Duplex, 331 element pairs across 25 class pairs overlap: finish floors against furniture (57), ceilings against walls (47), and slabs against walls (40) lead, and the IFCROOF and the roof slab overlap by 61.8 m3 with near-equal mesh volumes (60.7 and 60.4 m3), which suggests the roof geometry is carried twice. The busiest elements are two ground-floor wood finish floors, with 35 candidates each."
    },
    "inst": {
      "path": "{SAMPLES}/duplex-base.ifc"
    },
    "storeys": {
      "path": "{SAMPLES}/duplex-base.duckdb",
      "sql": "SELECT e.GlobalId, e.StepId, e.Name, s.StoreyName AS Storey FROM EntityText e JOIN StoreyOfElement s ON s.EntityIndex = e.EntityIndex WHERE e.GlobalId IS NOT NULL"
    },
    "built": {
      "expr": "category not in ('IFCSPACE', 'IFCOPENINGELEMENT')"
    },
    "elementBoxes": {
      "groupBy": "globalId,category",
      "aggregates": "min(minX) as MinX,min(minY) as MinY,min(minZ) as MinZ,max(maxX) as MaxX,max(maxY) as MaxY,max(maxZ) as MaxZ"
    },
    "boxes": {
      "renames": "globalId=GlobalId,category=Class"
    },
    "touching": {
      "aKey": "GlobalId",
      "bKey": "GlobalId",
      "excludeSelf": "true"
    },
    "overlapping": {
      "expr": "OverlapVolume > 0.001"
    },
    "onePerPair": {
      "expr": "A < B"
    },
    "classOfA": {
      "columns": "GlobalId,Class"
    },
    "withA": {
      "aKey": "A",
      "bKey": "GlobalId",
      "mode": "inner"
    },
    "namedA": {
      "renames": "Class=ClassA"
    },
    "withB": {
      "aKey": "B",
      "bKey": "GlobalId",
      "mode": "inner"
    },
    "namedB": {
      "renames": "Class=ClassB"
    },
    "rowClass": {
      "name": "RowClass",
      "expr": "ClassA <= ClassB ? ClassA : ClassB"
    },
    "colClass": {
      "name": "ColumnClass",
      "expr": "ClassA <= ClassB ? ClassB : ClassA"
    },
    "classPairs": {
      "groupBy": "RowClass,ColumnClass",
      "aggregates": "count(*) as Pairs,sum(OverlapVolume) as OverlapVolume"
    },
    "pairLabel": {
      "name": "ClassPair",
      "expr": "RowClass & ' / ' & ColumnClass"
    },
    "chart": {
      "labelColumn": "ClassPair",
      "valueColumns": "Pairs",
      "sort": "desc",
      "title": "Box-overlap candidate pairs per pair of IFC classes"
    },
    "matrix": {
      "groupBy": "RowClass",
      "nameColumn": "ColumnClass",
      "valueColumn": "Pairs",
      "aggregate": "sum"
    },
    "matrixView": {
      "title": "Candidate pairs, class by class (upper triangle; each element pair counted once)"
    },
    "perElement": {
      "groupBy": "A",
      "aggregates": "count(*) as Candidates"
    },
    "keyed": {
      "renames": "A=GlobalId"
    },
    "withClass": {
      "aKey": "GlobalId",
      "mode": "left"
    },
    "withStorey": {
      "aKey": "GlobalId",
      "mode": "left"
    },
    "busiest": {
      "by": "Candidates desc"
    },
    "elementView": {
      "title": "Elements by number of box-overlap candidates",
      "columns": "GlobalId,StepId,Name,Class,Storey,Candidates"
    },
    "scale": {
      "valueColumn": "Candidates",
      "colorMap": "viridis"
    },
    "colored": {
      "joinColumn": "GlobalId",
      "valueColumn": "Candidates"
    }
  }
}

  "values": {
    "about": {
      "text": "Role: a coordinator. Question: which pairs of IFC classes have the most elements whose bounding boxes overlap, and which elements are involved most often?\nThese are box candidates, not clashes: each element's axis-aligned bounding box (the union of its meshes' boxes from view3d.instances) is tested against every other with spatial.intersects, so an L-shaped wall or a stair's box overlaps things its geometry never touches. Spaces and openings are left out ('built'). A pair counts only when the boxes share more than 0.001 m3, one litre ('overlapping'), so walls that merely meet a slab are not counted. spatial.intersects lists each pair once per direction; 'onePerPair' keeps A < B, and the row and column classes are put in alphabetical order so the matrix is an upper triangle.\nHow to read it: 'chart' ranks the class pairs by candidate count; 'matrixView' shows the same numbers class by class, and the heatmap in specs/viz-clash-matrix.vl.json draws them. 'elementView' lists the elements by how many candidates each is in, with its storey (the nearest one that contains it), and the 3D view ('colored') colours each element by that count, grey for none.\nThe numbers for the Duplex, and what they suggest about its roof, are in samples/viz-analyses/README.md."
    },
    "storeys": {
      "sql": "SELECT e.GlobalId, e.StepId, e.Name, s.StoreyName AS Storey FROM EntityText e JOIN StoreyOfElement s ON s.EntityIndex = e.EntityIndex WHERE e.GlobalId IS NOT NULL ORDER BY e.StepId"
    },
    "built": {
      "expr": "category not in ('IFCSPACE', 'IFCOPENINGELEMENT')"
    },
    "elementBoxes": {
      "groupBy": "globalId,category",
      "aggregates": "min(minX) as MinX,min(minY) as MinY,min(minZ) as MinZ,max(maxX) as MaxX,max(maxY) as MaxY,max(maxZ) as MaxZ"
    },
    "boxes": {
      "renames": "globalId=GlobalId,category=Class"
    },
    "touching": {
      "aKey": "GlobalId",
      "bKey": "GlobalId",
      "excludeSelf": "true"
    },
    "overlapping": {
      "expr": "OverlapVolume > 0.001"
    },
    "onePerPair": {
      "expr": "A < B"
    },
    "classOfA": {
      "columns": "GlobalId,Class"
    },
    "withA": {
      "aKey": "A",
      "bKey": "GlobalId",
      "mode": "inner"
    },
    "namedA": {
      "renames": "Class=ClassA"
    },
    "withB": {
      "aKey": "B",
      "bKey": "GlobalId",
      "mode": "inner"
    },
    "namedB": {
      "renames": "Class=ClassB"
    },
    "rowClass": {
      "name": "RowClass",
      "expr": "ClassA <= ClassB ? ClassA : ClassB"
    },
    "colClass": {
      "name": "ColumnClass",
      "expr": "ClassA <= ClassB ? ClassB : ClassA"
    },
    "classPairs": {
      "groupBy": "RowClass,ColumnClass",
      "aggregates": "count(*) as Pairs,sum(OverlapVolume) as OverlapVolume"
    },
    "pairLabel": {
      "name": "ClassPair",
      "expr": "RowClass & ' / ' & ColumnClass"
    },
    "chart": {
      "labelColumn": "ClassPair",
      "valueColumns": "Pairs",
      "sort": "desc",
      "title": "Box-overlap candidate pairs per pair of IFC classes"
    },
    "matrix": {
      "groupBy": "RowClass",
      "nameColumn": "ColumnClass",
      "valueColumn": "Pairs",
      "aggregate": "sum"
    },
    "matrixView": {
      "title": "Candidate pairs, class by class (upper triangle; each element pair counted once)"
    },
    "perElement": {
      "groupBy": "A",
      "aggregates": "count(*) as Candidates"
    },
    "keyed": {
      "renames": "A=GlobalId"
    },
    "withClass": {
      "aKey": "GlobalId",
      "mode": "left"
    },
    "withStorey": {
      "aKey": "GlobalId",
      "mode": "left"
    },
    "busiest": {
      "A": "Candidates",
      "descendingA": "true",
      "B": "GlobalId"
    },
    "elementView": {
      "title": "Elements by number of box-overlap candidates",
      "columns": "GlobalId,StepId,Name,Class,Storey,Candidates"
    },
    "scale": {
      "valueColumn": "Candidates",
      "colorMap": "viridis"
    },
    "colored": {
      "joinColumn": "GlobalId",
      "valueColumn": "Candidates"
    },
    "database": {
      "path": "{SAMPLES}/duplex-base.duckdb"
    },
    "model": {
      "path": "{SAMPLES}/duplex-base.ifc"
    }
  }
}

  "values": {
    "about": { "text": "Role: a BIM manager walking a client through how the Duplex is built up. Question: how many elements of each class sit on each storey, from the foundation to the roof? How to read it: 'chart' has one bar per storey, ordered by elevation from T/FDN (-1.25 m) to Roof (6.0 m), split into one series per element class (stacked in specs/viz-storey-stacking.vl.json). The 3D view ('colored') paints every element by its storey's elevation on one viridis scale ('scale'), the same scale that colours the storey totals in 'totalsChart': purple is the foundation, yellow the roof. An element's storey is the nearest IfcBuildingStorey that contains it, so furniture counts on the storey of its room and stair parts on the storey of their stair. Spaces are left out ('physical'). The warning on 'withStorey' counts the 102 entities no storey contains (types, openings, the project and site); they are not elements of any floor. Classes merge IFC names: Wall is IfcWall plus IfcWallStandardCase, Stair is IfcStair plus IfcStairFlight ('classes')." },
    "chart": { "labelColumn": "Storey", "title": "Elements per storey, by class", "valueColumns": "Beam, Covering, Door, Footing, Furniture, Member, Railing, Roof, Slab, Stair, Wall, Window" },
    "classed": { "aKey": "IfcClass", "mode": "inner" },
    "classes": { "rows": "[{\"IfcClass\":\"IFCWALL\",\"Class\":\"Wall\"},{\"IfcClass\":\"IFCWALLSTANDARDCASE\",\"Class\":\"Wall\"},{\"IfcClass\":\"IFCSLAB\",\"Class\":\"Slab\"},{\"IfcClass\":\"IFCROOF\",\"Class\":\"Roof\"},{\"IfcClass\":\"IFCFOOTING\",\"Class\":\"Footing\"},{\"IfcClass\":\"IFCBEAM\",\"Class\":\"Beam\"},{\"IfcClass\":\"IFCMEMBER\",\"Class\":\"Member\"},{\"IfcClass\":\"IFCDOOR\",\"Class\":\"Door\"},{\"IfcClass\":\"IFCWINDOW\",\"Class\":\"Window\"},{\"IfcClass\":\"IFCCOVERING\",\"Class\":\"Covering\"},{\"IfcClass\":\"IFCSTAIR\",\"Class\":\"Stair\"},{\"IfcClass\":\"IFCSTAIRFLIGHT\",\"Class\":\"Stair\"},{\"IfcClass\":\"IFCRAILING\",\"Class\":\"Railing\"},{\"IfcClass\":\"IFCFURNISHINGELEMENT\",\"Class\":\"Furniture\"},{\"IfcClass\":\"IFCSPACE\",\"Class\":\"Space\"}]" },
    "colored": { "joinColumn": "instanceIndex" },
    "database": { "path": "{SAMPLES}/duplex-enriched.duckdb" },
    "elements": { "sql": "SELECT StepId, GlobalId, EntityIndex, Category AS IfcClass, Name FROM EntityText WHERE GlobalId IS NOT NULL AND Category <> 'IFCBUILDINGSTOREY'" },
    "inst": { "path": "{SAMPLES}/duplex-enriched.ifc" },
    "instStorey": { "aKey": "globalId", "bKey": "GlobalId", "mode": "inner" },
    "located": { "sql": "SELECT EntityIndex, arg_min(StoreyIndex, Depth) AS StoreyIndex FROM StoreyOfEntity GROUP BY EntityIndex" },
    "named": { "aKey": "StoreyIndex", "mode": "left" },
    "physical": { "expr": "Class != 'Space'" },
    "scale": { "colorMap": "viridis", "valueColumn": "Elevation" },
    "stacking": { "aggregate": "count", "groupBy": "Storey, Elevation", "nameColumn": "Class", "valueColumn": "GlobalId" },
    "stackingSorted": { "A": "Elevation" },
    "storeys": { "sql": "SELECT e.EntityIndex AS StoreyIndex, e.Name AS Storey, TRY_CAST(p.Value AS DOUBLE) AS Elevation FROM EntityText e LEFT JOIN ParameterText p ON p.EntityIndex = e.EntityIndex AND p.Name = 'Ifc:Elevation' WHERE e.Category = 'IFCBUILDINGSTOREY'" },
    "totals": { "aggregates": "count(*) as Elements", "groupBy": "Storey, Elevation" },
    "totalsChart": { "labelColumn": "Storey", "title": "Elements per storey, coloured as in the 3D view", "valueColumns": "Elements" },
    "totalsSorted": { "A": "Elevation" },
    "withStorey": { "aKey": "EntityIndex", "mode": "inner" }
  }
}

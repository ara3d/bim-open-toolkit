  "values": {
    "about": { "text": "Role: a BIM manager walking a client through how the Duplex is built up. Question: how many elements sit on each storey, and of which classes, from the foundation to the roof?\nHow to read it: 'chart' has one bar per storey, ordered by elevation, coloured on the viridis scale ('scale') the 3D view ('colored') uses to paint every element by its storey's elevation: purple is the foundation, yellow the roof. 'byClass' splits each storey into one series per element class (stacked in specs/viz-storey-stacking.vl.json).\nHow it counts: an element's storey is the nearest IfcBuildingStorey that contains it ('located'), so furniture counts on the storey of its room and stair parts on the storey of their stair. Spaces are left out ('physical'). The warning on 'withStorey' counts the entities no storey contains (types, openings, the project and site); they belong to no floor. Classes merge IFC names: Wall is IfcWall plus IfcWallStandardCase, Stair is IfcStair plus IfcStairFlight ('classes').\nThe numbers for the Duplex are in samples/viz-analyses/README.md." },
    "byClass": { "labelColumn": "Storey", "title": "Elements per storey, by class", "valueColumns": "Beam, Covering, Door, Footing, Furniture, Member, Railing, Roof, Slab, Stair, Wall, Window", "layout": "stacked", "colorBy": "series" },
    "classed": { "aKey": "IfcClass", "mode": "inner" },
    "classes": { "rows": "[{\"IfcClass\":\"IFCWALL\",\"Class\":\"Wall\"},{\"IfcClass\":\"IFCWALLSTANDARDCASE\",\"Class\":\"Wall\"},{\"IfcClass\":\"IFCSLAB\",\"Class\":\"Slab\"},{\"IfcClass\":\"IFCROOF\",\"Class\":\"Roof\"},{\"IfcClass\":\"IFCFOOTING\",\"Class\":\"Footing\"},{\"IfcClass\":\"IFCBEAM\",\"Class\":\"Beam\"},{\"IfcClass\":\"IFCMEMBER\",\"Class\":\"Member\"},{\"IfcClass\":\"IFCDOOR\",\"Class\":\"Door\"},{\"IfcClass\":\"IFCWINDOW\",\"Class\":\"Window\"},{\"IfcClass\":\"IFCCOVERING\",\"Class\":\"Covering\"},{\"IfcClass\":\"IFCSTAIR\",\"Class\":\"Stair\"},{\"IfcClass\":\"IFCSTAIRFLIGHT\",\"Class\":\"Stair\"},{\"IfcClass\":\"IFCRAILING\",\"Class\":\"Railing\"},{\"IfcClass\":\"IFCFURNISHINGELEMENT\",\"Class\":\"Furniture\"},{\"IfcClass\":\"IFCSPACE\",\"Class\":\"Space\"}]" },
    "colored": { "joinColumn": "instanceIndex" },
    "database": { "path": "{SAMPLES}/duplex-enriched.duckdb" },
    "elements": { "sql": "SELECT StepId, GlobalId, EntityIndex, Category AS IfcClass, Name FROM EntityText WHERE GlobalId IS NOT NULL AND Category <> 'IFCBUILDINGSTOREY' ORDER BY EntityIndex" },
    "instStorey": { "aKey": "globalId", "bKey": "GlobalId", "mode": "inner" },
    "located": { "sql": "SELECT EntityIndex, arg_min(StoreyIndex, Depth) AS StoreyIndex FROM StoreyOfEntity GROUP BY EntityIndex ORDER BY EntityIndex" },
    "named": { "aKey": "StoreyIndex", "mode": "left" },
    "physical": { "expr": "Class != 'Space'" },
    "scale": { "colorMap": "viridis", "valueColumn": "Elevation" },
    "stacking": { "aggregate": "count", "groupBy": "Storey, Elevation", "nameColumn": "Class", "valueColumn": "GlobalId" },
    "stackingSorted": { "A": "Elevation", "B": "Storey" },
    "storeys": { "sql": "SELECT e.EntityIndex AS StoreyIndex, e.Name AS Storey, TRY_CAST(p.Value AS DOUBLE) AS Elevation FROM EntityText e LEFT JOIN ParameterText p ON p.EntityIndex = e.EntityIndex AND p.Name = 'Ifc:Elevation' WHERE e.Category = 'IFCBUILDINGSTOREY' ORDER BY Elevation, StoreyIndex" },
    "totals": { "aggregates": "count(*) as Elements", "groupBy": "Storey, Elevation" },
    "chart": { "labelColumn": "Storey", "title": "Elements per storey, coloured by elevation as in the 3D view", "valueColumns": "Elements" },
    "totalsSorted": { "A": "Elevation", "B": "Storey" },
    "withStorey": { "aKey": "EntityIndex", "mode": "inner" },
    "model": { "path": "{SAMPLES}/duplex-enriched.ifc" }
  }
}

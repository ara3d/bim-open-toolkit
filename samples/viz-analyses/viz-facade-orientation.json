  "values": {
    "orient": {
      "path": "{SAMPLES}/duplex-enriched.bos",
      "categories": "IFCWALL,IFCWALLSTANDARDCASE,IFCWINDOW"
    },
    "attrs": {
      "sql": "SELECT e.GlobalId, s.StoreyName AS Storey, p.Value = '.T.' AS IsExternal FROM EntityText e LEFT JOIN StoreyOfElement s ON s.EntityIndex = e.EntityIndex AND s.Depth = 1 LEFT JOIN ParameterText p ON p.EntityIndex = e.EntityIndex AND p.Name = 'IsExternal' WHERE e.Category IN ('IFCWALL', 'IFCWALLSTANDARDCASE', 'IFCWINDOW')"
    },
    "joined": {
      "aKey": "GlobalId",
      "mode": "inner"
    },
    "facade": {
      "expr": "IsExternal and Storey != 'T/FDN' and not contains(Name, 'Party Wall')"
    },
    "kind": {
      "name": "Element",
      "expr": "Category == 'IFCWINDOW' ? 'Window' : 'Wall'"
    },
    "byDir": {
      "groupBy": "Direction",
      "nameColumn": "Element",
      "valueColumn": "FacingArea",
      "aggregate": "sum"
    },
    "compass": {
      "rows": "[{\"Sector\":0,\"Direction\":\"N\"},{\"Sector\":1,\"Direction\":\"NE\"},{\"Sector\":2,\"Direction\":\"E\"},{\"Sector\":3,\"Direction\":\"SE\"},{\"Sector\":4,\"Direction\":\"S\"},{\"Sector\":5,\"Direction\":\"SW\"},{\"Sector\":6,\"Direction\":\"W\"},{\"Sector\":7,\"Direction\":\"NW\"}]"
    },
    "framed": {
      "aKey": "Direction",
      "mode": "left"
    },
    "total": {
      "name": "Total",
      "expr": "coalesce(Wall, 0) + coalesce(Window, 0)"
    },
    "sorted": {
      "A": "Sector"
    },
    "scale": {
      "valueColumn": "Direction",
      "colorMap": "category10"
    },
    "chart": {
      "labelColumn": "Direction",
      "valueColumns": "Wall,Window",
      "title": "Duplex facade area by compass direction (m2, project north)"
    },
    "keyed": {
      "renames": "GlobalId=globalId"
    },
    "inst": {
      "path": "{SAMPLES}/duplex-base.ifc"
    },
    "colored": {
      "joinColumn": "globalId",
      "valueColumn": "Direction",
      "colorMap": "category10"
    },
    "about": {
      "text": "Facade engineer: how much wall and glazing sits on each side of the building? bim.orientation puts every wall and window in one of eight compass sectors by the bearing from the plan centre to its box centre, from project north (+Y; the model carries no true north), and gives its face area as the larger vertical face of its box (length x height). The facade is the elements flagged IsExternal, less the party wall and the T/FDN foundation walls, which the source also flags. The bars are m2 of wall and window per sector; the 3D view colours each facade element by its sector on the same scale and leaves the rest grey. A sector is a position around the plan, not the way a face looks: windows near the ends of a long east wall land in NE or SE (viz-window-to-wall-ratio groups by facing). The polar spec draws each sector as a wedge whose radius is the total area."
    },
    "database": {
      "path": "{SAMPLES}/duplex-enriched.duckdb"
    },
    "answer": {
      "title": "Facade area by compass direction (m2)",
      "columns": "Direction,Wall,Window,Total"
    }
  }

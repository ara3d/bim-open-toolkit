  "values": {
    "about": {
      "text": "Facility manager at handover: how many pieces of furniture and fixtures of each family must be tagged, and on which floor are they? One row per IfcFurnishingElement, its Revit family read from the first part of the name (M_Base Cabinet-Double Door & 2 Drawer:1000mm:1000mm, with the metric prefix M_ dropped) and its size from the second; the storey is the nearest IfcBuildingStorey that contains it. The chart ranks the families by count as horizontal bars in the single accent colour: colour would say nothing a rank does not, so colorBy is none. The table pivots the same items by storey, one column per storey, with the total. The counts for the Duplex are in samples/viz-analyses/README.md."
    },
    "database": {
      "path": "{SAMPLES}/duplex-enriched.duckdb"
    },
    "items": {
      "sql": "SELECT e.GlobalId, e.Name, regexp_replace(split_part(e.Name, ':', 1), '^M_', '') AS Family, split_part(e.Name, ':', 2) AS Size, s.Storey, t.Value AS Tag FROM EntityText e LEFT JOIN (SELECT EntityIndex, arg_min(StoreyName, Depth) AS Storey FROM StoreyOfElement GROUP BY EntityIndex) s ON s.EntityIndex = e.EntityIndex LEFT JOIN ParameterText t ON t.EntityIndex = e.EntityIndex AND t.Name = 'Ifc:Tag' WHERE e.Category = 'IFCFURNISHINGELEMENT' ORDER BY e.GlobalId"
    },
    "byFamily": {
      "groupBy": "Family",
      "aggregates": "count(*) as Items"
    },
    "ranked": {
      "A": "Items",
      "B": "Family",
      "descendingA": "true"
    },
    "chart": {
      "labelColumn": "Family",
      "valueColumns": "Items",
      "title": "Furniture and fixtures to tag, per family",
      "layout": "horizontal",
      "colorBy": "none"
    },
    "byStorey": {
      "groupBy": "Family",
      "nameColumn": "Storey",
      "valueColumn": "GlobalId",
      "aggregate": "count"
    },
    "withTotal": {
      "aKey": "Family",
      "mode": "left"
    },
    "sorted": {
      "A": "Items",
      "B": "Family",
      "descendingA": "true"
    },
    "answer": {
      "title": "FF&E schedule per family and storey",
      "columns": "Family,Level 1,Level 2,Items"
    }
  }
}

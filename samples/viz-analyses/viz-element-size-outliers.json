  "values": {
    "about": {
      "text": "Element size outliers, for a model auditor. Question: which elements are an order of magnitude larger or smaller than the other elements of their IFC class, and where are they? Volume is the enclosed mesh volume from view3d.measures, summed over each element's meshes; Height is the element's vertical extent from its instance bounds. Each class's median volume comes from table.window (row number by volume within the class) and the middle row of each class; Fold is how many times larger or smaller than that median an element is (always at least 1). An element is an outlier when Fold is 10 or more in a class of at least 5 elements; spaces and openings are left out because they are not built elements. Read the figure: the scatter (specs/viz-element-size-outliers.vl.json) plots Volume on a log scale against Height, one colour per class, outliers drawn large and outlined; the bar chart ranks every element by Fold on the same colour scale as the 3D view, which ghosts everything except the outliers. On the Duplex, 28 of 216 elements are outliers: the live roof modelled as an IFCSLAB is 144 times the slab median, eight 38 mm furring walls are 70 times smaller than the wall median, and the large fixed windows are 11 to 20 times the window median. A large Fold is a question to ask of the model, not an error: a class that mixes finish floors with structural slabs has a wide spread by design. Mesh volume is exact only for closed meshes."
    },
    "inst": {
      "path": "{SAMPLES}/duplex-base.ifc"
    },
    "meas": {
      "path": "{SAMPLES}/duplex-base.ifc"
    },
    "storeys": {
      "path": "{SAMPLES}/duplex-base.duckdb",
      "sql": "SELECT e.GlobalId, e.StepId, e.Name, s.StoreyName AS Storey FROM EntityText e JOIN StoreyOfElement s ON s.EntityIndex = e.EntityIndex WHERE e.GlobalId IS NOT NULL"
    },
    "zrange": {
      "columns": "instanceIndex,minZ,maxZ"
    },
    "meshes": {
      "aKey": "instanceIndex",
      "mode": "left"
    },
    "perElement": {
      "groupBy": "globalId,category",
      "aggregates": "sum(meshVolume) as Volume,min(minZ) as Bottom,max(maxZ) as Top,count(*) as Meshes"
    },
    "named": {
      "renames": "globalId=GlobalId,category=Class"
    },
    "solid": {
      "expr": "Volume > 0 and Class != \"IFCSPACE\" and Class != \"IFCOPENINGELEMENT\""
    },
    "height": {
      "name": "Height",
      "expr": "Top - Bottom"
    },
    "withStorey": {
      "aKey": "GlobalId",
      "mode": "left"
    },
    "rankInClass": {
      "function": "rowNumber",
      "partitionBy": "Class",
      "orderBy": "Volume",
      "name": "RankInClass"
    },
    "classSize": {
      "groupBy": "Class",
      "aggregates": "count(*) as ClassCount"
    },
    "withSize": {
      "aKey": "Class",
      "mode": "left"
    },
    "middle": {
      "expr": "RankInClass == floor((ClassCount + 1) / 2)"
    },
    "medians": {
      "groupBy": "Class",
      "aggregates": "min(Volume) as ClassMedian"
    },
    "withMedian": {
      "aKey": "Class",
      "mode": "left"
    },
    "ratio": {
      "name": "Ratio",
      "expr": "Volume / ClassMedian"
    },
    "fold": {
      "name": "Fold",
      "expr": "max(Ratio, 1 / Ratio)"
    },
    "flagged": {
      "name": "Outlier",
      "expr": "Fold >= 10 and ClassCount >= 5"
    },
    "scored": {
      "columns": "GlobalId,StepId,Name,Class,Storey,Volume,Height,ClassMedian,Ratio,Fold,Outlier"
    },
    "ranked": {
      "by": "Fold desc"
    },
    "scale": {
      "valueColumn": "Fold",
      "colorMap": "viridis"
    },
    "chart": {
      "labelColumn": "Name",
      "valueColumns": "Fold",
      "title": "How far each element sits from its class median (Fold)"
    },
    "outliers": {
      "expr": "Outlier"
    },
    "list": {
      "title": "Elements ten or more times off their class median",
      "columns": "GlobalId,StepId,Name,Class,Storey,Volume,Height,ClassMedian,Fold"
    },
    "colored": {
      "joinColumn": "GlobalId",
      "valueColumn": "Fold"
    },
    "ghosted": {
      "joinColumn": "GlobalId",
      "scope": "others",
      "alpha": "0.12"
    }
  }
}

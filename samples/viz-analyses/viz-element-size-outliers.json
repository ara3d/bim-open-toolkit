  "values": {
    "about": {
      "text": "Model auditor: which elements are ten times larger or smaller than the median of their IFC class, and where are they? Volume is the enclosed mesh volume from view3d.measures, summed per element; Height is the element's vertical extent from its instance bounds. Storey is the nearest storey above an element in StoreyOfElement (smallest Depth), so each element sits on one storey. A class's median is the volume of its middle row by volume (table.window); Fold is how many times larger or smaller than that median an element is, never below 1. An element is an outlier when Fold is 10 or more in a class of at least 5 elements; spaces and openings are left out. The chart ranks the outliers by Fold on the scale the 3D view colours them with, and the 3D view ghosts everything else; the scatter in specs/viz-element-size-outliers.vl.json plots Volume on a log scale against Height. A large Fold is a question to ask of the model, not an error, and mesh volume is exact only for closed meshes."
    },
    "inst": {},
    "storeys": {
      "sql": "SELECT e.GlobalId, e.StepId, e.Name, s.Storey FROM EntityText e JOIN (SELECT EntityIndex, arg_min(StoreyName, Depth) AS Storey FROM StoreyOfElement GROUP BY EntityIndex) s ON s.EntityIndex = e.EntityIndex WHERE e.GlobalId IS NOT NULL"
    },
    "zrange": {
      "columns": "instanceIndex,minZ,maxZ"
    },
    "meshes": {
      "aKey": "instanceIndex",
      "mode": "left"
    },
    "perElement": {
      "groupBy": "globalId,category",
      "aggregates": "sum(meshVolume) as Volume,min(minZ) as Bottom,max(maxZ) as Top,count(*) as Meshes"
    },
    "named": {
      "renames": "globalId=GlobalId,category=Class"
    },
    "solid": {
      "expr": "Volume > 0 and Class != \"IFCSPACE\" and Class != \"IFCOPENINGELEMENT\""
    },
    "height": {
      "name": "Height",
      "expr": "Top - Bottom"
    },
    "withStorey": {
      "aKey": "GlobalId",
      "mode": "left"
    },
    "rankInClass": {
      "function": "rowNumber",
      "partitionBy": "Class",
      "orderBy": "Volume",
      "name": "RankInClass"
    },
    "classSize": {
      "groupBy": "Class",
      "aggregates": "count(*) as ClassCount"
    },
    "withSize": {
      "aKey": "Class",
      "mode": "left"
    },
    "middle": {
      "expr": "RankInClass == floor((ClassCount + 1) / 2)"
    },
    "medians": {
      "groupBy": "Class",
      "aggregates": "min(Volume) as ClassMedian"
    },
    "withMedian": {
      "aKey": "Class",
      "mode": "left"
    },
    "ratio": {
      "name": "Ratio",
      "expr": "Volume / ClassMedian"
    },
    "fold": {
      "name": "Fold",
      "expr": "max(Ratio, 1 / Ratio)"
    },
    "flagged": {
      "name": "Outlier",
      "expr": "Fold >= 10 and ClassCount >= 5"
    },
    "scored": {
      "columns": "GlobalId,StepId,Name,Class,Storey,Volume,Height,ClassMedian,Ratio,Fold,Outlier"
    },
    "ranked": {
      "A": "Fold",
      "descendingA": "true",
      "B": "GlobalId"
    },
    "scale": {
      "valueColumn": "Fold",
      "colorMap": "viridis"
    },
    "chart": {
      "labelColumn": "Name",
      "valueColumns": "Fold",
      "title": "Outliers: how many times off their class median each element is (Fold)"
    },
    "outliers": {
      "expr": "Outlier"
    },
    "colored": {
      "joinColumn": "GlobalId",
      "valueColumn": "Fold"
    },
    "ghosted": {
      "joinColumn": "GlobalId",
      "scope": "others",
      "alpha": "0.12"
    },
    "measures": {},
    "answer": {
      "title": "Elements ten or more times off their class median (Volume m3, Height m)",
      "columns": "Name,Class,Storey,Volume,Height,ClassMedian,Fold,StepId,GlobalId"
    },
    "model": {
      "path": "{SAMPLES}/duplex-base.ifc"
    },
    "database": {
      "path": "{SAMPLES}/duplex-base.duckdb"
    }
  }
}

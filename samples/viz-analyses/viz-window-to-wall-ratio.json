  "values": {
    "orient": {
      "path": "{SAMPLES}/duplex-enriched.bos",
      "categories": "IFCWALL,IFCWALLSTANDARDCASE,IFCWINDOW"
    },
    "attrs": {
      "sql": "SELECT e.GlobalId, s.StoreyName AS Storey, p.Value = '.T.' AS IsExternal FROM EntityText e LEFT JOIN StoreyOfElement s ON s.EntityIndex = e.EntityIndex AND s.Depth = 1 LEFT JOIN ParameterText p ON p.EntityIndex = e.EntityIndex AND p.Name = 'IsExternal' WHERE e.Category IN ('IFCWALL', 'IFCWALLSTANDARDCASE', 'IFCWINDOW')"
    },
    "joined": {
      "aKey": "GlobalId",
      "mode": "inner"
    },
    "facade": {
      "expr": "IsExternal and Storey != 'T/FDN' and not contains(Name, 'Party Wall')"
    },
    "kind": {
      "name": "Element",
      "expr": "Category == 'IFCWINDOW' ? 'Window' : 'Wall'"
    },
    "byFacing": {
      "groupBy": "Facing",
      "nameColumn": "Element",
      "valueColumn": "FacingArea",
      "aggregate": "sum"
    },
    "facings": {
      "rows": "[{\"Order\":0,\"Facing\":\"N\"},{\"Order\":1,\"Facing\":\"E\"},{\"Order\":2,\"Facing\":\"S\"},{\"Order\":3,\"Facing\":\"W\"}]"
    },
    "framed": {
      "aKey": "Facing",
      "mode": "left"
    },
    "ratio": {
      "name": "WWR",
      "expr": "coalesce(Window, 0) / Wall"
    },
    "limit": {
      "name": "Limit",
      "expr": "0.4"
    },
    "sorted": {
      "A": "Order"
    },
    "chart": {
      "labelColumn": "Facing",
      "valueColumns": "WWR",
      "title": "Window-to-wall ratio by facing (limit 0.40)"
    },
    "about": {
      "text": "Energy modeller: what share of each facade is glazing, and does any side pass 0.40? The window-to-wall ratio (WWR) is window area over gross wall area on one facing, both from bim.orientation's face area (the larger vertical face of each box, length x height, so a wall's area includes its openings). Facing is the side a wall's or window's long face looks out to: N, E, S or W from project north, since the model carries no true north. The facade is the elements flagged IsExternal, less the party wall and the T/FDN foundation walls; skylights are flagged not external and are left out. A facing with no wall has no ratio: the cell stays empty, never 0. 0.40 is the common prescriptive ceiling (ASHRAE 90.1); the Limit column carries it for the rule in the spec. The 3D view colours each facade element by its facing on the chart's scale."
    },
    "database": {
      "path": "{SAMPLES}/duplex-enriched.duckdb"
    },
    "answer": {
      "title": "Facade areas (m2) and window-to-wall ratio by facing",
      "columns": "Facing,Wall,Window,WWR"
    },
    "scale": {
      "valueColumn": "Facing",
      "colorMap": "category10"
    },
    "keyed": {
      "renames": "GlobalId=globalId"
    },
    "inst": {
      "path": "{SAMPLES}/duplex-base.ifc"
    },
    "colored": {
      "joinColumn": "globalId",
      "valueColumn": "Facing",
      "colorMap": "category10"
    }
  }

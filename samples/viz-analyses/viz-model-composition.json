  "values": {
    "about": { "text": "Role: a BIM manager showing a client what the Duplex model is made of before any quantity or cost work. Question: which element classes make up the model, and where are they?\nHow to read it: 'chart' ranks the seven largest classes by element count, largest first, with the rest folded into Other and shown last; 'sorted' also carries each bar's Share of all elements. The 3D view ('colored') paints every element with its bar's colour: one category10 scale ('scale') feeds both, so a red bar and red furniture are the same group.\nHow it counts: elements are the physical ones a storey contains, spaces excluded. Classes merge IFC names: Wall is IfcWall plus IfcWallStandardCase, Stair is IfcStair plus IfcStairFlight ('classes'). Change the 7 in 'grouped' to keep more classes apart from Other; category10 has ten colours.\nThe numbers for the Duplex are in samples/viz-analyses/README.md." },
    "chart": { "labelColumn": "Group", "title": "What the Duplex is made of: elements by class", "valueColumns": "Elements" },
    "classed": { "aKey": "IfcClass", "mode": "inner" },
    "classes": { "rows": "[{\"IfcClass\":\"IFCWALL\",\"Class\":\"Wall\"},{\"IfcClass\":\"IFCWALLSTANDARDCASE\",\"Class\":\"Wall\"},{\"IfcClass\":\"IFCSLAB\",\"Class\":\"Slab\"},{\"IfcClass\":\"IFCROOF\",\"Class\":\"Roof\"},{\"IfcClass\":\"IFCFOOTING\",\"Class\":\"Footing\"},{\"IfcClass\":\"IFCBEAM\",\"Class\":\"Beam\"},{\"IfcClass\":\"IFCMEMBER\",\"Class\":\"Member\"},{\"IfcClass\":\"IFCDOOR\",\"Class\":\"Door\"},{\"IfcClass\":\"IFCWINDOW\",\"Class\":\"Window\"},{\"IfcClass\":\"IFCCOVERING\",\"Class\":\"Covering\"},{\"IfcClass\":\"IFCSTAIR\",\"Class\":\"Stair\"},{\"IfcClass\":\"IFCSTAIRFLIGHT\",\"Class\":\"Stair\"},{\"IfcClass\":\"IFCRAILING\",\"Class\":\"Railing\"},{\"IfcClass\":\"IFCFURNISHINGELEMENT\",\"Class\":\"Furniture\"},{\"IfcClass\":\"IFCSPACE\",\"Class\":\"Space\"}]" },
    "colored": { "joinColumn": "instanceIndex" },
    "composition": { "aggregates": "count(*) as Elements", "groupBy": "Class" },
    "database": { "path": "{SAMPLES}/duplex-enriched.duckdb" },
    "elementGroups": { "aKey": "Class", "mode": "left" },
    "elements": { "sql": "SELECT StepId, GlobalId, EntityIndex, Category AS IfcClass, Name FROM EntityText WHERE GlobalId IS NOT NULL AND Category <> 'IFCBUILDINGSTOREY' ORDER BY EntityIndex" },
    "folded": { "aggregates": "sum(Elements) as Elements", "groupBy": "Group" },
    "grouped": { "expr": "Rank <= 7 ? Class : 'Other'", "name": "Group" },
    "instGroup": { "aKey": "globalId", "bKey": "GlobalId", "mode": "inner" },
    "located": { "sql": "SELECT EntityIndex, arg_min(StoreyIndex, Depth) AS StoreyIndex FROM StoreyOfEntity GROUP BY EntityIndex ORDER BY EntityIndex" },
    "named": { "aKey": "StoreyIndex", "mode": "left" },
    "otherLast": { "expr": "Group == 'Other' ? 1 : 0", "name": "IsOther" },
    "physical": { "expr": "Class != 'Space'" },
    "ranked": { "function": "rowNumber", "name": "Rank", "orderBy": "Elements desc, Class" },
    "scale": { "colorMap": "category10", "valueColumn": "Group" },
    "shared": { "column": "Elements", "function": "percentOfTotal", "name": "Share" },
    "sorted": { "A": "IsOther", "B": "Elements", "descendingB": "true", "C": "Group" },
    "storeys": { "sql": "SELECT e.EntityIndex AS StoreyIndex, e.Name AS Storey, TRY_CAST(p.Value AS DOUBLE) AS Elevation FROM EntityText e LEFT JOIN ParameterText p ON p.EntityIndex = e.EntityIndex AND p.Name = 'Ifc:Elevation' WHERE e.Category = 'IFCBUILDINGSTOREY' ORDER BY Elevation, StoreyIndex" },
    "withStorey": { "aKey": "EntityIndex", "mode": "inner" },
    "model": { "path": "{SAMPLES}/duplex-enriched.ifc" }
  }
}

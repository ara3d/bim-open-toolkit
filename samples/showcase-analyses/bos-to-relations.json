{
  "formatVersion": "0.1.0",
  "layout": {
    "about": { "x": 40, "y": 40, "w": 560, "h": 160 },
    "model": { "x": 40, "y": 330 },
    "bos": { "x": 385, "y": 246 },
    "entities": { "x": 1083, "y": 240 },
    "relations": { "x": 734, "y": 470 },
    "contained": { "x": 1083, "y": 470 },
    "elements": { "x": 1432, "y": 343 },
    "byCategory": { "x": 1781, "y": 343 },
    "ranked": { "x": 2130, "y": 343 },
    "rows": { "x": 2479, "y": 343 },
    "answer": { "x": 2828, "y": 343 }
  },
  "structure": {
    "inputs": [
      { "default": "{SAMPLES}/duplex-enriched.bos", "description": "The building's BIM Open Schema (.bos) file; the host prepares duplex-enriched.bos from the Duplex IFC.", "kind": "FilePath", "name": "model" }
    ],
    "edges": [
      { "from": "model.path", "to": "bos.path" },
      { "from": "bos.entities", "to": "entities.table" },
      { "from": "bos.relations", "to": "relations.table" },
      { "from": "relations.relation", "to": "contained.input" },
      { "from": "entities.relation", "to": "elements.left" },
      { "from": "contained.relation", "to": "elements.right" },
      { "from": "elements.relation", "to": "byCategory.input" },
      { "from": "byCategory.relation", "to": "ranked.input" },
      { "from": "ranked.relation", "to": "rows.input" },
      { "from": "rows.table", "to": "answer.table" }
    ],
    "nodes": [
      { "id": "about", "kind": "view.note", "version": 1 },
      { "id": "model", "kind": "value.path", "version": 1 },
      { "id": "bos", "kind": "bos.load", "version": 1 },
      { "id": "entities", "kind": "rel.fromTable", "version": 1 },
      { "id": "relations", "kind": "rel.fromTable", "version": 1 },
      { "id": "contained", "kind": "rel.filter", "version": 1 },
      { "id": "elements", "kind": "rel.join", "version": 1 },
      { "id": "byCategory", "kind": "rel.aggregate", "version": 1 },
      { "id": "ranked", "kind": "rel.sort", "version": 1 },
      { "id": "rows", "kind": "rel.materialize", "version": 1 },
      { "id": "answer", "kind": "chart.bar", "version": 1 }
    ]
  },
  "values": {
    "about": { "text": "Building elements per IFC category. bos.load lists every STEP entity (polylines, placements, styles), so the chart keeps only the entities a ContainedIn relation places on a storey: a semi join of entities to those relations. On the Duplex that is 207 elements in 11 categories, 14 of them doors. To run it on another building, change the model input." },
    "model": { "path": "$model" },
    "bos": { "harmonize": "false" },
    "entities": { "name": "entities" },
    "relations": { "name": "relations" },
    "contained": { "expr": "RelationType == 'ContainedIn'" },
    "elements": { "leftKey": "EntityIndex", "rightKey": "EntityIndexA", "kind": "semi" },
    "byCategory": { "groupBy": "Category", "aggregates": "count(*) as Elements" },
    "ranked": { "by": "Elements desc, Category" },
    "rows": { "limit": "0" },
    "answer": {
      "labelColumn": "Category",
      "valueColumns": "Elements",
      "title": "Duplex building elements per IFC category",
      "sort": "none"
    }
  }
}

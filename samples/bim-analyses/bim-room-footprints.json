{
  "formatVersion": "0.1.0",
  "layout": {
    "about": { "x": 40, "y": 40, "w": 560, "h": 122 },
    "model": { "x": 40, "y": 238 },
    "rooms": { "x": 385, "y": 202 },
    "footprint": { "x": 734, "y": 202 },
    "measures": { "x": 1083, "y": 202 },
    "ranked": { "x": 1432, "y": 202 },
    "answer": { "x": 1781, "y": 202 }
  },
  "structure": {
    "inputs": [
      { "default": "{SAMPLES}/sample.bos", "description": "The building's BIM Open Schema (.bos) file; any public sample building works here.", "kind": "FilePath", "name": "model" }
    ],
    "edges": [
      { "from": "model.path", "to": "rooms.path" },
      { "from": "rooms.table", "to": "footprint.boxes" },
      { "from": "footprint.table", "to": "measures.table" },
      { "from": "measures.table", "to": "ranked.table" },
      { "from": "ranked.table", "to": "answer.table" }
    ],
    "nodes": [
      { "id": "about", "kind": "view.note", "version": 1 },
      { "id": "model", "kind": "value.path", "version": 1 },
      { "id": "rooms", "kind": "bim.rooms", "version": 1 },
      { "id": "footprint", "kind": "spatial.footprint", "version": 1 },
      { "id": "measures", "kind": "spatial.polygon", "version": 1 },
      { "id": "ranked", "kind": "table.sort", "version": 1 },
      { "id": "answer", "kind": "view.table", "version": 1 }
    ]
  },
  "values": {
    "about": { "text": "Each room's box seen from above as a WKT polygon (spatial.footprint), with its area and perimeter (spatial.polygon), longest perimeter first. A box overstates an L-shaped or angled room. The Footprint text opens unchanged in DuckDB spatial, PostGIS, or QGIS." },
    "model": { "path": "$model" },
    "ranked": { "A": "Perimeter", "descendingA": "true" },
    "answer": { "columns": "Name, Number, Level, Area, Perimeter, Footprint", "title": "Room footprints by perimeter" }
  }
}

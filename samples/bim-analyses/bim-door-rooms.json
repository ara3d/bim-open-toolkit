{
  "formatVersion": "0.1.0",
  "layout": {
    "about": { "x": 40, "y": 40, "w": 560, "h": 158 },
    "model": { "x": 40, "y": 224 },
    "bounds": { "x": 370, "y": 224 },
    "doorsOnly": { "x": 700, "y": 224 },
    "overlap": { "x": 1030, "y": 224 },
    "touching": { "x": 1360, "y": 224 },
    "named": { "x": 1690, "y": 224 },
    "answer": { "x": 2020, "y": 224 },
    "rooms": { "x": 370, "y": 408 }
  },
  "structure": {
    "inputs": [
      { "default": "{SAMPLES}/sample.bos", "description": "The building's BIM Open Schema (.bos) file; any public sample building works here.", "kind": "FilePath", "name": "model" }
    ],
    "edges": [
      { "from": "model.path", "to": "bounds.path" },
      { "from": "model.path", "to": "rooms.path" },
      { "from": "bounds.table", "to": "doorsOnly.table" },
      { "from": "doorsOnly.table", "to": "overlap.a" },
      { "from": "rooms.table", "to": "overlap.b" },
      { "from": "overlap.table", "to": "touching.table" },
      { "from": "touching.table", "to": "named.table" },
      { "from": "named.table", "to": "answer.table" }
    ],
    "nodes": [
      { "id": "about", "kind": "view.note", "version": 1 },
      { "id": "model", "kind": "value.path", "version": 1 },
      { "id": "bounds", "kind": "bim.bounds", "version": 1 },
      { "id": "doorsOnly", "kind": "table.filter", "version": 1 },
      { "id": "overlap", "kind": "spatial.intersects", "version": 1 },
      { "id": "touching", "kind": "table.filter", "version": 1 },
      { "id": "named", "kind": "table.project", "version": 1 },
      { "id": "answer", "kind": "view.table", "version": 1 },
      { "id": "rooms", "kind": "bim.rooms", "version": 1 }
    ]
  },
  "values": {
    "about": { "text": "The rooms each door's box actually overlaps (spatial.intersects, filtered to OverlapVolume > 0); Room is the room's Number. An exterior door such as D4 lists one room; a door in an interior wall lists both. The sample doors also carry from/to-room parameters (see bim-nav-hops); use this only when those are missing. bim-room-containment is the full version: it counts these pairs per room and names each room." },
    "model": { "path": "$model" },
    "doorsOnly": { "expr": "Category == 'Doors'" },
    "overlap": { "bKey": "Number" },
    "touching": { "expr": "OverlapVolume > 0" },
    "named": { "columns": "A as Door, B as Room, OverlapVolume" },
    "answer": { "title": "Rooms each door opens into" }
  }
}

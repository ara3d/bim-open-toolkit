{
  "formatVersion": "0.1.0",
  "layout": {
    "about": { "x": 40, "y": 310 },
    "coverage": { "x": 700, "y": 40 },
    "joinCategory": { "x": 390, "y": 40 },
    "load": { "x": 40, "y": 40 },
    "top": { "x": 1030, "y": 40 }
  },
  "structure": {
    "edges": [
      { "from": "load.parameters", "to": "joinCategory.a" },
      { "from": "load.entities", "to": "joinCategory.b" },
      { "from": "joinCategory.table", "to": "coverage.parameters" },
      { "from": "coverage.table", "to": "top.table" }
    ],
    "nodes": [
      { "id": "about", "kind": "view.note", "version": 1 },
      { "id": "coverage", "kind": "bim.paramCoverage", "version": 1 },
      { "id": "joinCategory", "kind": "table.join", "version": 1 },
      { "id": "load", "kind": "bos.load", "version": 1 },
      { "id": "top", "kind": "table.sort", "version": 1 }
    ]
  },
  "values": {
    "about": { "text": "FillRate is measured within each parameter's Category (joined in from bos.load's entities table), not against every entity in the file. A parameter that only applies to one category, such as a room's Number, now reads as fully filled instead of a small fraction of all 28 entities; a parameter that spans several categories, such as Bounds.Max, gets one row per category." },
    "coverage": { "groupBy": "Category" },
    "joinCategory": { "aKey": "EntityIndex", "bKey": "EntityIndex", "mode": "left" },
    "load": { "path": "{SAMPLES}/sample.bos" },
    "top": { "A": "Count", "descendingA": "true" }
  }
}

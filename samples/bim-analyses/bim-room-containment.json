    "touching": { "x": 1030, "y": 224 }
  },
  "structure": {
    "edges": [
      { "from": "bounds.table", "to": "doorsOnly.table" },
      { "from": "rooms.table", "to": "overlap.b" },
      { "from": "doorsOnly.table", "to": "overlap.a" },
      { "from": "overlap.table", "to": "touching.table" },
      { "from": "touching.table", "to": "byRoom.table" },
      { "from": "rooms.table", "to": "roomLabels.table" },
      { "from": "byRoom.table", "to": "labeled.a" },
      { "from": "roomLabels.table", "to": "labeled.b" },
      { "from": "labeled.table", "to": "final.table" },
      { "from": "final.table", "to": "sorted.table" }
    ],
    "nodes": [
      { "id": "about", "kind": "view.note", "version": 1 },
      { "id": "bounds", "kind": "bim.bounds", "version": 1 },
      { "id": "byRoom", "kind": "table.aggregate", "version": 1 },
      { "id": "doorsOnly", "kind": "table.filter", "version": 1 },
      { "id": "final", "kind": "table.project", "version": 1 },
      { "id": "labeled", "kind": "table.join", "version": 1 },
      { "id": "overlap", "kind": "spatial.intersects", "version": 1 },
      { "id": "roomLabels", "kind": "table.project", "version": 1 },
      { "id": "rooms", "kind": "bim.rooms", "version": 1 },
      { "id": "sorted", "kind": "table.sort", "version": 1 },
      { "id": "touching", "kind": "table.filter", "version": 1 }
    ]
  },
  "values": {
    "about": { "text": "Doors touching each room (spatial.intersects between doors and room boxes, filtered to OverlapVolume > 0, one row per door per room it touches). Rooms are keyed and grouped by EntityIndex, not Name, so the two rooms named Corridor stay separate; Name and Number are joined back in for display." },
    "bounds": { "path": "{SAMPLES}/sample.bos" },
    "byRoom": { "aggregates": "count(*) as Doors", "groupBy": "B" },
    "doorsOnly": { "expr": "Category == 'Doors'" },
    "final": { "columns": "Name, Number, Doors" },
    "labeled": { "aKey": "B", "bKey": "EntityIndex", "mode": "left" },
    "overlap": { "bKey": "EntityIndex" },
    "roomLabels": { "columns": "EntityIndex, Name, Number" },
    "rooms": { "path": "{SAMPLES}/sample.bos" },
    "sorted": { "A": "Name", "B": "Number" },
    "touching": { "expr": "OverlapVolume > 0" }
  }
}

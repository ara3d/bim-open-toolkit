{
  "formatVersion": "0.1.0",
  "layout": {
    "about": { "x": 40, "y": 40, "w": 560, "h": 140 },
    "model": { "x": 40, "y": 714 },
    "bounds": { "x": 385, "y": 220 },
    "doorsOnly": { "x": 734, "y": 220 },
    "overlap": { "x": 1083, "y": 220 },
    "touching": { "x": 1432, "y": 404 },
    "byRoom": { "x": 1781, "y": 404 },
    "labeled": { "x": 2130, "y": 541 },
    "sorted": { "x": 2479, "y": 541 },
    "answer": { "x": 2828, "y": 541 },
    "rooms": { "x": 729, "y": 693 },
    "roomLabels": { "x": 1781, "y": 702 }
  },
  "structure": {
    "inputs": [
      { "default": "{SAMPLES}/sample.bos", "description": "The building's BIM Open Schema (.bos) file; any public sample building works here.", "kind": "FilePath", "name": "model" }
    ],
    "edges": [
      { "from": "model.path", "to": "bounds.path" },
      { "from": "model.path", "to": "rooms.path" },
      { "from": "bounds.table", "to": "doorsOnly.table" },
      { "from": "doorsOnly.table", "to": "overlap.a" },
      { "from": "rooms.table", "to": "overlap.b" },
      { "from": "overlap.table", "to": "touching.table" },
      { "from": "touching.table", "to": "byRoom.table" },
      { "from": "rooms.table", "to": "roomLabels.table" },
      { "from": "byRoom.table", "to": "labeled.a" },
      { "from": "roomLabels.table", "to": "labeled.b" },
      { "from": "labeled.table", "to": "sorted.table" },
      { "from": "sorted.table", "to": "answer.table" }
    ],
    "nodes": [
      { "id": "about", "kind": "view.note", "version": 1 },
      { "id": "model", "kind": "value.path", "version": 1 },
      { "id": "bounds", "kind": "bim.bounds", "version": 1 },
      { "id": "doorsOnly", "kind": "table.filter", "version": 1 },
      { "id": "overlap", "kind": "spatial.intersects", "version": 1 },
      { "id": "touching", "kind": "table.filter", "version": 1 },
      { "id": "byRoom", "kind": "table.aggregate", "version": 1 },
      { "id": "labeled", "kind": "table.join", "version": 1 },
      { "id": "sorted", "kind": "table.sort", "version": 1 },
      { "id": "answer", "kind": "view.table", "version": 1 },
      { "id": "rooms", "kind": "bim.rooms", "version": 1 },
      { "id": "roomLabels", "kind": "table.project", "version": 1 }
    ]
  },
  "values": {
    "about": { "text": "Doors touching each room (spatial.intersects between door and room boxes, filtered to OverlapVolume > 0, one row per door per room it touches), most doors first. Rooms are keyed and grouped by EntityIndex, not Name, so the two rooms named Corridor stay separate; Name and Number are joined back in for display. bim-door-rooms and bim-duct-rooms show the pairs themselves." },
    "model": { "path": "$model" },
    "doorsOnly": { "expr": "Category == 'Doors'" },
    "overlap": { "bKey": "EntityIndex" },
    "touching": { "expr": "OverlapVolume > 0" },
    "byRoom": { "aggregates": "count(*) as Doors", "groupBy": "B" },
    "labeled": { "aKey": "B", "bKey": "EntityIndex", "mode": "left" },
    "sorted": { "A": "Doors", "B": "Number", "descendingA": "true" },
    "answer": { "columns": "Name, Number, Doors", "title": "Doors touching each room" },
    "roomLabels": { "columns": "EntityIndex, Name, Number" }
  }
}

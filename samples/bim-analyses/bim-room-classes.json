{
  "formatVersion": "0.1.0",
  "layout": {
    "about": { "x": 40, "y": 40, "w": 560, "h": 104 },
    "model": { "x": 40, "y": 369 },
    "rooms": { "x": 385, "y": 333 },
    "classes": { "x": 734, "y": 333 },
    "byClass": { "x": 1083, "y": 333 },
    "ranked": { "x": 1555, "y": 333 },
    "answer": { "x": 1904, "y": 184 },
    "chart": { "x": 1904, "y": 482 }
  },
  "structure": {
    "inputs": [
      { "default": "{SAMPLES}/sample.bos", "description": "The building's BIM Open Schema (.bos) file; any public sample building works here.", "kind": "FilePath", "name": "model" }
    ],
    "edges": [
      { "from": "model.path", "to": "rooms.path" },
      { "from": "rooms.table", "to": "classes.table" },
      { "from": "classes.table", "to": "byClass.table" },
      { "from": "byClass.table", "to": "ranked.table" },
      { "from": "ranked.table", "to": "answer.table" },
      { "from": "ranked.table", "to": "chart.table" }
    ],
    "nodes": [
      { "id": "about", "kind": "view.note", "version": 1 },
      { "id": "model", "kind": "value.path", "version": 1 },
      { "id": "rooms", "kind": "bim.rooms", "version": 1 },
      { "id": "classes", "kind": "bim.classifyRooms", "version": 1 },
      { "id": "byClass", "kind": "table.aggregate", "version": 1 },
      { "id": "ranked", "kind": "table.sort", "version": 1 },
      { "id": "answer", "kind": "view.table", "version": 1 },
      { "id": "chart", "kind": "chart.bar", "version": 1 }
    ]
  },
  "values": {
    "about": { "text": "Rooms put in classes by name with bim.classifyRooms' built-in rules (Office, Circulation, Kitchen, Sanitary and more; a name no rule matches is Other), counted, with the total room volume of each class. The chart shows the volume per class." },
    "model": { "path": "$model" },
    "byClass": { "aggregates": "count(*) as Rooms, sum(Volume) as TotalVolume", "groupBy": "RoomClass" },
    "ranked": { "A": "Rooms", "descendingA": "true" },
    "answer": { "title": "Rooms and volume per class" },
    "chart": { "labelColumn": "RoomClass", "sort": "desc", "title": "Room volume per class", "valueColumns": "TotalVolume" }
  }
}

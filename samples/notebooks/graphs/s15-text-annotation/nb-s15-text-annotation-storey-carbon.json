  "values": {
    "about": { "text": "Each storey's total operational carbon (kgCO2e/yr, from nrc_analytics_storeys.csv) written over that storey's floor slabs. slabs keeps the IfcSlab entities of the enriched Duplex, slabStorey puts each on the one storey the model places it on (the smallest Depth, the rule nrc-rollup uses) and gives it that storey's total, isolated keeps only the slab instances in 3D, coloured paints them by the total on the viridis scale, and answer writes one label per storey (groupColumn StoreyName) over the union of that storey's slabs." },
    "entities": { "source": "duplex-enriched", "table": "EntityText" },
    "slabs": { "expr": "[Category] == 'IFCSLAB'" },
    "storeyOf": { "source": "duplex-enriched", "table": "StoreyOfEntity" },
    "totals": { "path": "nrc_analytics_storeys.csv", "source": "nrc" },
    "slabStorey": { "sql": "SELECT s.GlobalId, s.Name, so.StoreyName, t.OperationalCarbon_kgCO2e_per_year AS StoreyOperationalCarbon\nFROM t1 s\nJOIN t2 so ON so.EntityIndex = s.EntityIndex\nJOIN t3 t ON t.Container = so.StoreyName\nQUALIFY row_number() OVER (PARTITION BY s.EntityIndex ORDER BY so.Depth, so.StoreyIndex) = 1" },
    "rows": { "limit": "0" },
    "model": { "path": "samples/nrc/duplex-enriched.ifc" },
    "isolated": { "joinColumn": "globalId" },
    "coloured": { "joinColumn": "globalId", "valueColumn": "StoreyOperationalCarbon", "colorMap": "viridis" },
    "answer": { "joinColumn": "globalId", "groupColumn": "StoreyName", "format": "{StoreyName}: {StoreyOperationalCarbon:#,##0.0} kgCO2e/yr", "limit": "200" }
  }
}

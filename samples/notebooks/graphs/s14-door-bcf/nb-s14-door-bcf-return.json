  "structure": {
    "inputs": [
      {
        "name": "model",
        "kind": "FilePath",
        "default": "{SAMPLES}/duplex-enriched.bos",
        "description": "The building's BIM Open Schema (.bos) file; the NRC Duplex by default, any .bos file works here."
      }
    ],
    "edges": [
      {
        "from": "modelPath.path",
        "to": "model.path"
      },
      {
        "from": "model.entities",
        "to": "verdicts.entities"
      },
      {
        "from": "model.parameters",
        "to": "verdicts.parameters"
      },
      {
        "from": "model.entities",
        "to": "doors.table"
      },
      {
        "from": "doors.table",
        "to": "doorCols.table"
      },
      {
        "from": "model.parameters",
        "to": "overall.table"
      },
      {
        "from": "overall.table",
        "to": "overallCols.table"
      },
      {
        "from": "doorCols.table",
        "to": "doorWidth.a"
      },
      {
        "from": "overallCols.table",
        "to": "doorWidth.b"
      },
      {
        "from": "model.parameters",
        "to": "levelRows.table"
      },
      {
        "from": "levelRows.table",
        "to": "levelCols.table"
      },
      {
        "from": "doorWidth.table",
        "to": "withLevel.a"
      },
      {
        "from": "levelCols.table",
        "to": "withLevel.b"
      },
      {
        "from": "withLevel.table",
        "to": "widthMm.table"
      },
      {
        "from": "verdicts.verdicts",
        "to": "verdictCols.table"
      },
      {
        "from": "widthMm.table",
        "to": "checked.a"
      },
      {
        "from": "verdictCols.table",
        "to": "checked.b"
      },
      {
        "from": "checked.table",
        "to": "margin.table"
      },
      {
        "from": "margin.table",
        "to": "columns.table"
      },
      {
        "from": "columns.table",
        "to": "sorted.table"
      },
      {
        "from": "returned.topics",
        "to": "topicsView.table"
      },
      {
        "from": "returned.comments",
        "to": "commentsView.table"
      },
      {
        "from": "returned.issues",
        "to": "flagCols.table"
      },
      {
        "from": "sorted.table",
        "to": "flagged.a"
      },
      {
        "from": "flagCols.table",
        "to": "flagged.b"
      },
      {
        "from": "flagged.table",
        "to": "flaggedView.table"
      },
      {
        "from": "scene.instances",
        "to": "coloured.instances"
      },
      {
        "from": "flagged.table",
        "to": "coloured.values"
      }
    ],
    "nodes": [
      {
        "id": "modelPath",
        "kind": "value.path",
        "version": 1
      },
      {
        "id": "model",
        "kind": "bos.load",
        "version": 1
      },
      {
        "id": "verdicts",
        "kind": "ids.check",
        "version": 1
      },
      {
        "id": "doors",
        "kind": "table.filter",
        "version": 1
      },
      {
        "id": "doorCols",
        "kind": "table.project",
        "version": 1
      },
      {
        "id": "overall",
        "kind": "table.filter",
        "version": 1
      },
      {
        "id": "overallCols",
        "kind": "table.project",
        "version": 1
      },
      {
        "id": "doorWidth",
        "kind": "table.join",
        "version": 1
      },
      {
        "id": "levelRows",
        "kind": "table.filter",
        "version": 1
      },
      {
        "id": "levelCols",
        "kind": "table.project",
        "version": 1
      },
      {
        "id": "withLevel",
        "kind": "table.join",
        "version": 1
      },
      {
        "id": "widthMm",
        "kind": "table.derive",
        "version": 1
      },
      {
        "id": "verdictCols",
        "kind": "table.project",
        "version": 1
      },
      {
        "id": "checked",
        "kind": "table.join",
        "version": 1
      },
      {
        "id": "margin",
        "kind": "table.derive",
        "version": 1
      },
      {
        "id": "columns",
        "kind": "table.project",
        "version": 1
      },
      {
        "id": "sorted",
        "kind": "table.sort",
        "version": 1
      },
      {
        "id": "about",
        "kind": "view.note",
        "version": 1
      },
      {
        "id": "returned",
        "kind": "bcf.read",
        "version": 1
      },
      {
        "id": "topicsView",
        "kind": "view.table",
        "version": 1
      },
      {
        "id": "commentsView",
        "kind": "view.table",
        "version": 1
      },
      {
        "id": "flagCols",
        "kind": "table.project",
        "version": 1
      },
      {
        "id": "flagged",
        "kind": "table.join",
        "version": 1
      },
      {
        "id": "flaggedView",
        "kind": "view.table",
        "version": 1
      },
      {
        "id": "scene",
        "kind": "view3d.instances",
        "version": 1
      },
      {
        "id": "coloured",
        "kind": "view3d.color",
        "version": 1
      }
    ]
  },
  "values": {
    "modelPath": {
      "path": "$model"
    },
    "model": {
      "harmonize": "false"
    },
    "verdicts": {
      "ids": "{SAMPLES}/ids/dc-w1.ids"
    },
    "doors": {
      "expr": "[Category] == 'IFCDOOR'"
    },
    "doorCols": {
      "columns": "EntityIndex, GlobalId, Name"
    },
    "overall": {
      "expr": "[Name] == 'Ifc:OverallWidth'"
    },
    "levelRows": {
      "expr": "[Name] == 'Level' and [ParameterGroup] == 'PSet_Revit_Constraints'"
    },
    "levelCols": {
      "columns": "EntityIndex, Value as Level"
    },
    "withLevel": {
      "aKey": "EntityIndex",
      "bKey": "EntityIndex",
      "mode": "inner"
    },
    "overallCols": {
      "columns": "EntityIndex, Value"
    },
    "doorWidth": {
      "aKey": "EntityIndex",
      "bKey": "EntityIndex",
      "mode": "inner"
    },
    "widthMm": {
      "name": "Width_mm",
      "expr": "round(toNumber([Value]) * 1000)"
    },
    "verdictCols": {
      "columns": "EntityIndex, Verdict"
    },
    "checked": {
      "aKey": "EntityIndex",
      "bKey": "EntityIndex",
      "mode": "inner"
    },
    "margin": {
      "name": "Margin_mm",
      "expr": "[Width_mm] - 850"
    },
    "columns": {
      "columns": "Name, Level, Width_mm, Margin_mm, Verdict, GlobalId"
    },
    "sorted": {
      "A": "Verdict",
      "B": "Width_mm",
      "C": "Name"
    },
    "about": {
      "text": "DC-W1 is the clear-width rule (a door leaf at least 850 mm wide, NBC 2020 3.8.3.12, illustrative, not legal text) with OverallWidth as the proxy, stated as an IDS (samples/nrc/ids/dc-w1.ids) and checked by ids.check over the Duplex. returned reads the committed samples/nrc/bcf/s14-door-bcf-reply.bcf, the file nb-s14-door-bcf-reply writes: topicsView is its topic, commentsView its comments (two authors). flagCols keeps the GlobalId, title, status and comment count of each flagged element, flagged joins them to the model's door table on GlobalId, and coloured paints those doors on the model."
    },
    "returned": {
      "path": "{SAMPLES}/bcf/s14-door-bcf-reply.bcf"
    },
    "topicsView": {
      "title": "Topics in the returned BCF",
      "columns": "Title, Elements, Status, Description, GlobalIds"
    },
    "commentsView": {
      "title": "Comments in the returned BCF",
      "columns": "CommentAuthor, CommentDate, Comment"
    },
    "flagCols": {
      "columns": "GlobalId, Title as Topic, Status, Comments"
    },
    "flagged": {
      "aKey": "GlobalId",
      "bKey": "GlobalId",
      "mode": "inner"
    },
    "flaggedView": {
      "title": "Flagged elements joined to the model on GlobalId",
      "columns": "Name, Level, Width_mm, Verdict, Topic, Status, Comments, GlobalId"
    },
    "scene": {
      "path": "{SAMPLES}/duplex-enriched.ifc"
    },
    "coloured": {
      "joinColumn": "GlobalId",
      "valueColumn": "Topic",
      "colorMap": "category10"
    }
  }
}

  "values": {
    "modelPath": {
      "path": "$model"
    },
    "model": {
      "harmonize": "false"
    },
    "verdicts": {
      "ids": "{SAMPLES}/ids/dc-w1.ids"
    },
    "doors": {
      "expr": "[Category] == 'IFCDOOR'"
    },
    "doorCols": {
      "columns": "EntityIndex, GlobalId, Name"
    },
    "overall": {
      "expr": "[Name] == 'Ifc:OverallWidth'"
    },
    "levelRows": {
      "expr": "[Name] == 'Level' and [ParameterGroup] == 'PSet_Revit_Constraints'"
    },
    "levelCols": {
      "columns": "EntityIndex, Value as Level"
    },
    "withLevel": {
      "aKey": "EntityIndex",
      "bKey": "EntityIndex",
      "mode": "inner"
    },
    "overallCols": {
      "columns": "EntityIndex, Value"
    },
    "doorWidth": {
      "aKey": "EntityIndex",
      "bKey": "EntityIndex",
      "mode": "inner"
    },
    "widthMm": {
      "name": "Width_mm",
      "expr": "round(toNumber([Value]) * 1000)"
    },
    "verdictCols": {
      "columns": "EntityIndex, Verdict"
    },
    "checked": {
      "aKey": "EntityIndex",
      "bKey": "EntityIndex",
      "mode": "inner"
    },
    "margin": {
      "name": "Margin_mm",
      "expr": "[Width_mm] - 850"
    },
    "columns": {
      "columns": "Name, Level, Width_mm, Margin_mm, Verdict, GlobalId"
    },
    "sorted": {
      "A": "Verdict",
      "B": "Width_mm",
      "C": "Name"
    },
    "about": {
      "text": "DC-W1 is the clear-width rule (a door leaf at least 850 mm wide, NBC 2020 3.8.3.12, illustrative, not legal text) with OverallWidth as the proxy, stated as an IDS (samples/nrc/ids/dc-w1.ids) and checked by ids.check over the Duplex. The failing doors become one BCF topic each, so the architect can open, assign and close them one at a time: titled and described derive the topic's title and text from the door's level, name, width and shortfall. topics, shown in answer, is the preview of the file Run writes. bcf writes artifacts/checking/s14-door-bcf-failures.bcf only when you press Run, with one viewpoint per topic framing its door; its model parameter is the Duplex .bos as a path from the repository root, so the BCF header does not carry a machine's folder name."
    },
    "failing": {
      "expr": "[Verdict] == 'Fail'"
    },
    "titled": {
      "name": "Title",
      "expr": "'DC-W1 fail, ' & [Level] & ': ' & [Name]"
    },
    "described": {
      "name": "Description",
      "expr": "'Rule DC-W1: clear width at least 850 mm (OverallWidth is the proxy). This door is ' & [Width_mm] & ' mm wide, ' & abs([Margin_mm]) & ' mm short. Widen the leaf or record an exemption.'"
    },
    "issues": {
      "columns": "Title, Description, GlobalId"
    },
    "topics": {
      "preset": "issue",
      "verdicts": ""
    },
    "answer": {
      "title": "BCF topics Run will write",
      "columns": "Title, Elements, Description, Status, GlobalIds"
    },
    "bcf": {
      "path": "{ARTIFACTS}/checking/s14-door-bcf-failures.bcf",
      "model": "samples/nrc/duplex-enriched.bos",
      "preset": "issue",
      "verdicts": "",
      "author": "BIM Open Toolkit, rule DC-W1",
      "guidSeed": "s14-door-bcf",
      "created": "2026-10-18T22:00:00Z"
    }
  }

//==
// # StepRawWitnessesLaws
//
// Layer 3 of the STEP B-rep to mesh design. What PrepareModel must make of
// the two raw witnesses of step-raw-witnesses.library.plato. With
// SameRawModel of the C# decoder's output against those witnesses, these
// two laws are TKT-312's acceptance: the C# decoder, then PrepareModel
// compiled from Plato, give the expected decoded models for
// ../adapter/fixtures/unit-cube.stp and two-cubes-assembly.stp.
//
// Sections, in order:
//  - The fixtures, prepared

library StepRawWitnessesLaws
{
    //==
    // # The fixtures, prepared

    // The raw unit cube prepares to the 1 mm unit box: PrepareModel of
    // Witness_RawUnitCube is SameDecodedModel (layer 7's SameModel on the
    // model) as ExpectedUnitCube, Witness_UnitBoxMillimetres with the
    // tolerances of a stated 1e-6 mm at size sqrt 3 mm and extent 1 mm, no
    // fold, no repair, no closure mark.
    Law_RawUnitCubePreparesToUnitBox(_: RawDecodedModel): Boolean
        => RawDecodedModel.Witness_RawUnitCube.PrepareModel.SameDecodedModel(DecodedModel.ExpectedUnitCube);

    // The raw two-cube assembly prepares to two bodies: SameDecodedModel as
    // ExpectedTwoCubes, and the numbers the witness implies stated outright:
    // 2 bodies, 2 shells, 16 vertices, 24 edges, 12 loops, 12 faces, 24
    // curves, 12 surfaces, each shell's raw counts 8, 12, 6, 6; magnitudes
    // sqrt 11 mm and 3 mm. Each shell encloses 1 mm^3, which needs a mesh to
    // measure (layer 8's witness laws).
    Law_RawTwoCubesPreparesToTwoBodies(_: RawDecodedModel): Boolean
    {
        var d = RawDecodedModel.Witness_RawTwoCubes.PrepareModel;
        var m = d.Model;
        return d.SameDecodedModel(DecodedModel.ExpectedTwoCubes)
            && m.Bodies.Count == 2
            && m.Shells.Count == 2
            && m.Vertices.Count == 16
            && m.Edges.Count == 24
            && m.Loops.Count == 12
            && m.Faces.Count == 12
            && m.Geometry.Curves.Count == 24
            && m.Geometry.Surfaces.Count == 12
            && m.RawCounts(ShellIndex(0)) == CountsOf(8, 12, 6, 6)
            && m.RawCounts(ShellIndex(1)) == CountsOf(8, 12, 6, 6)
            && d.ModelSize == 11.0.Sqrt
            && d.CoordinateExtent == 3.0;
    }
}

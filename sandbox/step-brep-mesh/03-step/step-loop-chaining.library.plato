//==
// # Edge loops re-chained (TKT-413 and TKT-419)
//
// Layer 3, a preparation repair. STEP requires an edge loop to chain head to tail (edge_loop WR1,
// layer 2's Law_LoopsChainEndToStart): each oriented edge ends at the vertex the next one starts
// from. Some exporters write a wrong sense on some oriented edges. SHO/MAYA-W261_W271_REVC.step's
// #38083 lists two circle coedges against the sense the loop needs, so the decoder's loop runs
// A -> B, then A -> C. Layer 5 then builds a folded parameter-space loop, and the triangulation puts
// three triangles of one face on one mesh edge: the non-manifold and misoriented edges of TKT-413.
//
// A loop that already chains is left as it is. For one that does not, the senses that chain it
// with the fewest changes are found: the first coedge is tried both ways, each later coedge takes
// the sense that leaves the vertex the one before it reached, a candidate counts when it closes
// back to its first coedge's start, and of those the one changing fewer senses wins (the first
// sense on a tie). Fewest changes trusts most of what the file says. A loop that no candidate
// closes is left as written, for the checks downstream to report.
//
// Each change is then made in one of two ways. Flipping the coedge's sense keeps the edge's
// points: right for a line, and for an arc whose sense the file got wrong. Reversing the edge
// (its two vertices swapped, its curve and SameSense kept) turns an arc on a circle or an
// ellipse into the complementary arc. That is right when the exporter wrote the edge's vertices
// in the wrong order, the defect of TKT-419: in SHO/MAYA-W260_REVC.step's loop #39396 the arc
// #39442 then runs 350.4 degrees where the loop's lines imply a 9.6 degree corner. In
// MAYA-W261_W271_REVC.step's cylinder loop #38083 (TKT-413) both circles become 7.7 degree arcs,
// where a coedge flip would keep 352 degree arcs. An edge is reversed when its curve wraps and every
// loop that cites it wants that citation changed, so the reversal mends each of them and breaks
// none; otherwise each change is a coedge flip.
//
// PrepareModelWith runs LoopsChained after Reduced, which merges loop-joint vertices within the tolerance, so a loop whose gaps
// are within the tolerance chains there first and is not re-sensed here.
//
// Sections, in order:
//  - One loop
//  - The model
//  - Reporting

library StepLoopChaining
{
    //==
    // # One loop

    // The coedge with its sense flipped.
    FlippedCoedge(c: Coedge): Coedge
        => Coedge(c.Edge, c.IsForward ? EdgeOrientation.Reversed : EdgeOrientation.Forward);

    // Coedge c in the sense that leaves vertex v: as written when it already starts at v (a closed
    // edge, starting and ending at v, stays as written), flipped when it ends at v, as written when
    // its edge touches v at neither end (no chain through it). Precondition: m.IsEdgeInRange(c.Edge).
    LeavingVertex(m: BrepModel, c: Coedge, v: BrepVertexIndex): Coedge
        => m.StartVertex(c) == v ? c : (m.EndVertex(c) == v ? c.FlippedCoedge : c);

    // The coedges with first in place of coedges[0], each later coedge in the sense that leaves the
    // vertex the one before it reached. Precondition: coedges is not empty, first cites coedges[0]'s
    // edge, and every edge is in range.
    ChainedFrom(m: BrepModel, coedges: Array<Coedge>, first: Coedge): Array<Coedge>
    {
        var chained = new List<Coedge>();
        chained = chained.Add(first);
        var at = m.EndVertex(first);
        var i = 1;
        while (i < coedges.Count)
        {
            var c = m.LeavingVertex(coedges[i], at);
            chained = chained.Add(c);
            at = m.EndVertex(c);
            i = i + 1;
        }
        return chained.Freeze();
    }

    // The number of positions at which a and b cite their edge in different senses. Precondition:
    // a and b have one count.
    SenseChanges(a: Array<Coedge>, b: Array<Coedge>): Integer
        => a.Count.Range.Reduce(0, (n, i) => a[i].IsForward == b[i].IsForward ? n : n + 1);

    // The coedges of an edge loop in the senses that chain them head to tail with the fewest
    // changes to the senses written, as the header states; the coedges as written when they
    // already chain, are empty, or chain in no sense. Precondition: every edge is in range.
    ChainedCoedges(m: BrepModel, coedges: Array<Coedge>): Array<Coedge>
        => coedges.Count == 0 ? coedges
            : (m.ChainsEndToStart(BrepLoop.EdgeLoop(coedges)) ? coedges : m.RechainedCoedges(coedges));

    // ChainedCoedges for a loop that does not chain as written. Precondition: coedges is not
    // empty and every edge is in range.
    RechainedCoedges(m: BrepModel, coedges: Array<Coedge>): Array<Coedge>
    {
        var kept = m.ChainedFrom(coedges, coedges[0]);
        var flipped = m.ChainedFrom(coedges, coedges[0].FlippedCoedge);
        var keptChains = m.ChainsEndToStart(BrepLoop.EdgeLoop(kept));
        var flippedChains = m.ChainsEndToStart(BrepLoop.EdgeLoop(flipped));
        var keptWins = keptChains
            ? (flippedChains ? SenseChanges(coedges, kept) <= SenseChanges(coedges, flipped) : true)
            : false;
        return keptWins ? kept : (flippedChains ? flipped : coedges);
    }

    // The loop with its coedges chained (ChainedCoedges); vertex and poly loops as they are.
    ChainedLoop(m: BrepModel, loop: BrepLoop): BrepLoop
        => match (loop) {
            EdgeLoop(coedges) => BrepLoop.EdgeLoop(m.ChainedCoedges(coedges));
            VertexLoop(vertex) => loop;
            PolyLoop(points) => loop;
        };

    //==
    // # The model

    // The model with every edge loop chained by coedge flips alone; everything else as it is.
    // Precondition: m.IsEveryIndexInRange.
    WithLoopsChained(m: BrepModel): BrepModel
        => BrepModel(m.Geometry, m.Vertices, m.Edges, m.Loops.Map(l => m.ChainedLoop(l)),
            m.Faces, m.Shells, m.Bodies, m.Tolerances, m.Unit);

    // The positions of the coedges whose sense differs between loop a and loop b, the same loop
    // before and after chaining; none for a loop that is not an edge loop.
    ChangedSensePositions(a: BrepLoop, b: BrepLoop): Array<Integer>
    {
        var before = a.CoedgesOf;
        var after = b.CoedgesOf;
        return before.Count == after.Count
            ? before.Count.Range.FlatMap(i => before[i].IsForward == after[i].IsForward ? Integer.NoIndices : [i])
            : Integer.NoIndices;
    }

    // Whether edge e's curve runs back to its start (a circle, an ellipse), so that reversing the
    // edge turns its arc into the complementary one.
    HasWrappingCurve(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.Geometry.CurveAt(m.Edges[e].Curve).Domain(m.Geometry).Periodicity.HasSeam;

    // Per edge, whether chaining reverses it: its curve wraps, and every citation of it by an
    // edge loop is one the chaining changes (at least one). Precondition: m.IsEveryIndexInRange.
    EdgesToReverse(m: BrepModel): Array<Boolean>
    {
        var n = m.Edges.Count;
        var wanted = new Buffer<Boolean>(n);
        var kept = new Buffer<Boolean>(n);
        var e = 0;
        while (e < n)
        {
            wanted = wanted.Set(e, false);
            kept = kept.Set(e, false);
            e = e + 1;
        }
        var l = 0;
        while (l < m.Loops.Count)
        {
            var written = m.Loops[l].CoedgesOf;
            var chained = m.ChainedCoedges(written);
            var i = 0;
            while (i < written.Count)
            {
                var edge = written[i].Edge.Value;
                if (written[i].IsForward == chained[i].IsForward)
                {
                    kept = kept.Set(edge, true);
                }
                else
                {
                    wanted = wanted.Set(edge, true);
                }
                i = i + 1;
            }
            l = l + 1;
        }
        return n.MapRange(k => wanted.At(k) && kept.At(k).Not && m.HasWrappingCurve(BrepEdgeIndex(k)));
    }

    // The model with every edge marked in reversed given its two vertices swapped (curve and
    // SameSense kept); everything else as it is.
    WithEdgesReversed(m: BrepModel, reversed: Array<Boolean>): BrepModel
        => BrepModel(m.Geometry, m.Vertices,
            m.Edges.Count.MapRange(k => reversed[k]
                ? BrepEdge(m.Edges[k].End, m.Edges[k].Start, m.Edges[k].Curve, m.Edges[k].SameSense)
                : m.Edges[k]),
            m.Loops, m.Faces, m.Shells, m.Bodies, m.Tolerances, m.Unit);

    // The model with every edge loop chained: the edges EdgesToReverse marks reversed, then the
    // loops that still break chained by coedge flips. Precondition: m.IsEveryIndexInRange.
    WithLoopsRepaired(m: BrepModel): BrepModel
        => m.WithEdgesReversed(m.EdgesToReverse).WithLoopsChained;

    //==
    // # Reporting

    // The number of coedges of m that cite edge e.
    CitationCount(m: BrepModel, e: Integer): Integer
        => m.Loops.Reduce(0, (n, l) => n + l.CoedgesOf.Reduce(0, (k, c) => c.Edge.Value == e ? k + 1 : k));

    // The raw model with every edge loop chained (WithLoopsRepaired), and appended to the
    // diagnostics one EdgeReversedDiagnostic per reversed edge in edge order, then one
    // CoedgeSenseFlippedDiagnostic per flipped coedge in loop order then position order.
    // Precondition: raw.Model.IsEveryIndexInRange.
    LoopsChained(raw: RawDecodedModel): RawDecodedModel
    {
        var m = raw.Model;
        var reversed = m.EdgesToReverse;
        var turned = m.WithEdgesReversed(reversed);
        var chained = turned.WithLoopsChained;
        var reversals = m.Edges.Count.Range.FlatMap(e => reversed[e]
            ? [Diagnose(StepDiagnosticCode.EdgeReversedToChain, Provenance.AtInstance(raw.Sources.Edges[e].Instance), m.CitationCount(e).ToNumber)]
            : raw.Diagnostics.Take(0));
        var flips = m.Loops.Count.Range.FlatMap(l =>
            ChangedSensePositions(turned.Loops[l], chained.Loops[l]).Map(i =>
                Diagnose(StepDiagnosticCode.CoedgeSenseFlipped, Provenance.AtInstance(raw.Sources.Loops[l].Instance), i.ToNumber)));
        return RawDecodedModel(chained, raw.Occurrences, raw.Sources, raw.Folds, raw.Repairs, raw.Units,
            raw.LengthFactor, raw.AngleFactor, raw.Diagnostics.Concatenate(reversals).Concatenate(flips));
    }
}

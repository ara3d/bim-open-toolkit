//==
// # Decoding as a sum (functions)
//
// The conversion from DecodedModel to DecodeResult, its case numbers, and
// DecodeBrepResult, the decode that returns the sum.
//
// Sections, in order:
//  - Decoding

library StepDecided
{
    //==
    // # Decoding

    // DecodedModel as a sum: Decoded when the model has a face; with no face,
    // Unreadable when a diagnostic is an error, NoShape otherwise.
    ToDecodeResult(x: DecodedModel): DecodeResult
        => x.Model.Faces.Count > 0
            ? DecodeResult.Decoded(x)
            : (x.Diagnostics.Any(d => d.Severity.IsError)
                ? DecodeResult.Unreadable(x.Diagnostics)
                : DecodeResult.NoShape(UndecidedReason.NotApplicable("no shape representation")));

    // The decode of file as a sum: DecodeBrep, then ToDecodeResult, so a
    // faceless decode is NoShape or Unreadable, never a shape. The decided
    // form of DecodeBrep beside it (the contract change was not applied at
    // the catalog merge: FINDINGS F-58).
    DecodeBrepResult(file: Part21File): DecodeResult
        => file.DecodeBrep.ToDecodeResult;

    // The position of r's case in DecodeResult, from 0.
    CaseNumber(r: DecodeResult): Integer
        => match (r) {
            Decoded(model) => 0;
            NoShape(reason) => 1;
            Unreadable(diagnostics) => 2;
        };
}

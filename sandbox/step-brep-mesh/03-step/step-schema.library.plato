//==
// # StepSchemaModel
//
// Status since 2026-10-17 (README, "Boundary moved to RawDecodedModel,
// 2026-10-17"): STEP decoding is C#, from the generated AP242 types
// (TKT-304, TKT-312), so the schema model's functions here are the specification the
// C# typed layer's checks are written against, not Plato code that runs
// in the pipeline. Finding F-1 (attributes read by string name) is
// resolved by the generated types. Kept, unchanged, as that specification.
//
// Layer 3 of the STEP B-rep to mesh design. Functions over the schema model
// (step-schema.types.plato) and over a Part21File seen through it: which
// entity a keyword names, whether an instance is of a kind, where an
// attribute sits in a record, whether a value conforms to its declaration,
// and which instances are reachable from a representation. The table itself
// is SupportedSchema (step-schema-table.library.plato). Every instance query
// takes a position in Instances, every reference an instance name.
//
// Sections, in order:
//  - Builders for the table
//  - Entity lookup
//  - Records and slots
//  - Instances through the schema
//  - Field readers
//  - Conformance
//  - Reachability

library StepSchemaModel
{
    //==
    // # Builders for the table

    // An explicit single-valued attribute with no defined-type rule.
    Attr(name: String, kind: AttributeKind): AttributeDefinition
        => AttributeDefinition(name, kind, [], false, ValueRule.AnyValue);

    // An OPTIONAL single-valued attribute.
    AttrOptional(name: String, kind: AttributeKind): AttributeDefinition
        => AttributeDefinition(name, kind, [], true, ValueRule.AnyValue);

    // A single-valued attribute whose defined type has a rule.
    AttrRuled(name: String, kind: AttributeKind, rule: ValueRule): AttributeDefinition
        => AttributeDefinition(name, kind, [], false, rule);

    // A LIST [lower:upper] OF kind; upper -1 for '?'.
    AttrList(name: String, kind: AttributeKind, lower: Integer, upper: Integer): AttributeDefinition
        => AttributeDefinition(name, kind, [AggregateBound(AggregateForm.ListOf, lower, upper, false)], false, ValueRule.AnyValue);

    // A LIST [lower:upper] OF UNIQUE kind.
    AttrUniqueList(name: String, kind: AttributeKind, lower: Integer, upper: Integer): AttributeDefinition
        => AttributeDefinition(name, kind, [AggregateBound(AggregateForm.ListOf, lower, upper, true)], false, ValueRule.AnyValue);

    // A SET [lower:upper] OF kind (SET elements are unique by definition).
    AttrSet(name: String, kind: AttributeKind, lower: Integer, upper: Integer): AttributeDefinition
        => AttributeDefinition(name, kind, [AggregateBound(AggregateForm.SetOf, lower, upper, true)], false, ValueRule.AnyValue);

    // A LIST [lower:upper] OF LIST [lower:upper] OF kind: a B-spline surface's
    // control points and weights.
    AttrListOfList(name: String, kind: AttributeKind, lower: Integer, upper: Integer): AttributeDefinition
        => AttributeDefinition(name, kind, [AggregateBound(AggregateForm.ListOf, lower, upper, false), AggregateBound(AggregateForm.ListOf, lower, upper, false)], false, ValueRule.AnyValue);

    // A reference to one of the named entity types.
    RefTo(names: Array<String>): AttributeKind
        => AttributeKind.EntityKind(names);

    // An entity the decoder reads, with no derived redeclarations.
    DecodedEntity(name: String, short: String, clause: String, supertypes: Array<String>, attributes: Array<AttributeDefinition>): EntityDefinition
        => EntityDefinition(name, short, clause, supertypes, attributes, [], EntityTreatment.Decoded);

    // An entity the decoder skips with one Info per type.
    IgnoredEntity(name: String, short: String, clause: String): EntityDefinition
        => EntityDefinition(name, short, clause, [], [], [], EntityTreatment.Ignored);

    // An entity the decoder skips with one Warning per type.
    UnsupportedEntity(name: String, short: String, clause: String): EntityDefinition
        => EntityDefinition(name, short, clause, [], [], [], EntityTreatment.Unsupported);

    //==
    // # Entity lookup

    // The position in schema of the entity whose long or short name is name
    // (upper case, as the parser stores keywords); -1 when none.
    EntityPosition(schema: Array<EntityDefinition>, name: String): Integer
        => schema.Count.Range.Reduce(-1, (found, k) => found >= 0 ? found : (schema[k].Name == name || schema[k].ShortName == name ? k : -1));

    // True when name is a long or short name of the schema.
    IsKnownEntity(schema: Array<EntityDefinition>, name: String): Boolean
        => schema.EntityPosition(name) >= 0;

    // The long name of the entity a keyword names; "" when unknown.
    LongNameOf(schema: Array<EntityDefinition>, name: String): String
    {
        var k = schema.EntityPosition(name);
        return k < 0 ? "" : schema[k].Name;
    }

    // How the decoder treats records with this keyword; Unsupported for every
    // name the table does not list.
    TreatmentOf(schema: Array<EntityDefinition>, name: String): EntityTreatment
    {
        var k = schema.EntityPosition(name);
        return k < 0 ? EntityTreatment.Unsupported : schema[k].Treatment;
    }

    // True when the entity named name is ancestor (a long name) or a subtype
    // of it, through any chain of supertypes. Terminates because the
    // supertype graph is acyclic (Law_SchemaSupertypesPrecede).
    IsKindOf(schema: Array<EntityDefinition>, name: String, ancestor: String): Boolean
    {
        var k = schema.EntityPosition(name);
        return k < 0 ? false
            : (schema[k].Name == ancestor ? true : schema[k].Supertypes.Any(s => schema.IsKindOf(s, ancestor)));
    }

    //==
    // # Records and slots

    // The slots of a complex-instance part named name: the entity's own
    // explicit attributes, in declaration order (P21 12.2.5.3).
    OwnRecord(schema: Array<EntityDefinition>, name: String): Array<RecordSlot>
    {
        var k = schema.EntityPosition(name);
        return k < 0 ? [] : schema[k].Explicit.Map(a => RecordSlot(schema[k].Name, a, false));
    }

    // deferred: depth-first walk of the supertype graph. The slots of a simple
    // instance of the entity named name (P21 12.2.5.2): the explicit
    // attributes of every supertype before those of its subtypes, supertypes
    // in SUBTYPE OF order, each supertype once, then the entity's own; a slot
    // is Derived when name or one of its supertypes lists it in Derives.
    FlatRecord(schema: Array<EntityDefinition>, name: String): Array<RecordSlot>;

    // The slots record r of the instance at position i should have: the flat
    // record when the instance is simple, the part's own record when complex.
    ExpectedSlots(f: Part21File, i: Integer, r: Integer): Array<RecordSlot>
    {
        var records = f.RecordsAt(i);
        if (r < 0 || r >= records.Count)
        {
            return [];
        }
        return f.IsComplexAt(i)
            ? f.SupportedSchema.OwnRecord(records[r].TypeName)
            : f.SupportedSchema.FlatRecord(records[r].TypeName);
    }

    // deferred: a search of the records of instance i. The value of the
    // attribute named attribute declared by entity owner (long names) in the
    // instance at position i: for a simple instance, the FlatRecord slot whose
    // Owner and Attribute.Name match; for a complex one, the slot of the part
    // whose keyword names owner. None when the instance has no such slot or
    // the record is too short.
    SlotOf(f: Part21File, i: Integer, owner: String, attribute: String): StepAttributeIndex;

    //==
    // # Instances through the schema

    // True when the instance at position i is of entity ancestor or a
    // subtype: some record of it names ancestor or a subtype (a complex
    // instance is of every type it lists).
    InstanceIsA(f: Part21File, i: Integer, ancestor: String): Boolean
        => f.RecordsAt(i).Any(r => f.SupportedSchema.IsKindOf(r.TypeName, ancestor));

    // True when the instance named id is of entity ancestor or a subtype;
    // false when id names no instance.
    IsA(f: Part21File, id: StepInstanceId, ancestor: String): Boolean
        => f.InstanceIsA(f.InstancePosition(id), ancestor);

    // True when the instance at position i is of one of the kinds.
    InstanceIsAnyOf(f: Part21File, i: Integer, kinds: Array<String>): Boolean
        => kinds.Any(k => f.InstanceIsA(i, k));

    // True when the instance named id is of one of the kinds.
    IsAnyOf(f: Part21File, id: StepInstanceId, kinds: Array<String>): Boolean
        => kinds.Any(k => f.IsA(id, k));

    // True when the instance named id is of exactly one of the kinds: the
    // EXPRESS idiom SIZEOF(kinds * TYPEOF(x)) = 1.
    IsExactlyOneOf(f: Part21File, id: StepInstanceId, kinds: Array<String>): Boolean
        => kinds.Map(k => f.IsA(id, k) ? 1 : 0).Reduce(0, (a, b) => a + b) == 1;

    // How the decoder treats the instance at position i: Unsupported when a
    // record has an unknown or unsupported keyword (or i is no position);
    // otherwise Ignored when a record is ignored; otherwise Decoded.
    InstanceTreatment(f: Part21File, i: Integer): EntityTreatment
    {
        var treatments = f.RecordsAt(i).Map(r => f.SupportedSchema.TreatmentOf(r.TypeName));
        return treatments.Count == 0 || treatments.Any(t => t == EntityTreatment.Unsupported) ? EntityTreatment.Unsupported
            : (treatments.Any(t => t == EntityTreatment.Ignored) ? EntityTreatment.Ignored : EntityTreatment.Decoded);
    }

    // True when the instance at position i is decoded.
    IsDecodedAt(f: Part21File, i: Integer): Boolean
        => f.InstanceTreatment(i) == EntityTreatment.Decoded;

    //==
    // # Field readers
    //
    // SlotOf composed with the Part21Reading readers, so a WHERE rule reads
    // one named attribute in one call.

    // The number in owner.attribute of instance i, fallback when absent.
    FieldReal(f: Part21File, i: Integer, owner: String, attribute: String, fallback: Number): Number
        => f.RealOr(f.SlotOf(i, owner, attribute), fallback);

    // The integer in owner.attribute of instance i, fallback when absent.
    FieldInteger(f: Part21File, i: Integer, owner: String, attribute: String, fallback: Integer): Integer
        => f.IntegerOr(f.SlotOf(i, owner, attribute), fallback);

    // The instance owner.attribute of instance i refers to; none when absent.
    FieldReference(f: Part21File, i: Integer, owner: String, attribute: String): StepInstanceId
        => f.ReferenceOf(f.SlotOf(i, owner, attribute));

    // The items of the aggregate owner.attribute of instance i.
    FieldItems(f: Part21File, i: Integer, owner: String, attribute: String): Array<StepAttributeIndex>
        => f.ItemsOf(f.SlotOf(i, owner, attribute));

    // The instances the aggregate owner.attribute of instance i refers to.
    FieldReferences(f: Part21File, i: Integer, owner: String, attribute: String): Array<StepInstanceId>
        => f.ReferencesOf(f.SlotOf(i, owner, attribute));

    // The numbers of the aggregate owner.attribute of instance i.
    FieldReals(f: Part21File, i: Integer, owner: String, attribute: String, fallback: Number): Array<Number>
        => f.RealsOf(f.SlotOf(i, owner, attribute), fallback);

    // The integers of the aggregate owner.attribute of instance i.
    FieldIntegers(f: Part21File, i: Integer, owner: String, attribute: String, fallback: Integer): Array<Integer>
        => f.IntegersOf(f.SlotOf(i, owner, attribute), fallback);

    // The enumeration name in owner.attribute of instance i; "" when absent.
    FieldEnum(f: Part21File, i: Integer, owner: String, attribute: String): String
        => f.EnumAt(f.SlotOf(i, owner, attribute));

    // True when owner.attribute of instance i is .T..
    FieldIsTrue(f: Part21File, i: Integer, owner: String, attribute: String): Boolean
        => f.IsTrue(f.SlotOf(i, owner, attribute));

    // True when owner.attribute of instance i is $ or absent.
    FieldIsUnset(f: Part21File, i: Integer, owner: String, attribute: String): Boolean
        => f.IsUnset(f.SlotOf(i, owner, attribute));

    // True when owner.attribute of instance i refers to an instance of kind.
    FieldIsA(f: Part21File, i: Integer, owner: String, attribute: String, kind: String): Boolean
        => f.IsA(f.FieldReference(i, owner, attribute), kind);

    //==
    // # Conformance

    // deferred: a match of the value against the kind, level by level. True
    // when the value at a conforms to slot: $ only when the attribute is
    // OPTIONAL; * only when the slot is Derived; with Aggregates, a list whose
    // items conform to the remaining levels; otherwise a value of Kind (an
    // integer accepted for RealKind; for EntityKind or SelectKind entities, a
    // reference to an instance of an allowed kind or a subtype; for
    // SelectKind typed names, a typed parameter with one of those keywords).
    ConformsTo(f: Part21File, a: StepAttributeIndex, slot: RecordSlot): Boolean;

    // True when every aggregation level of the value at a has an item count
    // within its bounds and, where the level is UNIQUE, no two items refer to
    // the same instance. A $ or a * satisfies any bounds (whether either may
    // appear is ConformsTo's concern).
    SatisfiesBounds(f: Part21File, a: StepAttributeIndex, bounds: Array<AggregateBound>): Boolean
    {
        if (bounds.Count == 0 || f.IsUnset(a) || f.IsDerived(a))
        {
            return true;
        }
        var items = f.ItemsOf(a);
        var level = bounds[0];
        var countOk = items.Count >= level.Lower && (level.Upper < 0 ? true : items.Count <= level.Upper);
        return countOk && (level.Unique ? f.HasDistinctReferences(items) : true) && items.All(x => f.SatisfiesBounds(x, bounds.Skip(1)));
    }

    // True when no two items that are references name the same instance.
    HasDistinctReferences(f: Part21File, items: Array<StepAttributeIndex>): Boolean
        => items.Count.Range.All(p => items.Count.Range.All(q => p >= q ? true
            : (f.ReferenceOf(items[p]).IsNone ? true : !(f.ReferenceOf(items[p]) == f.ReferenceOf(items[q])))));

    // True when the number at a satisfies the defined-type rule; $ and *
    // satisfy every rule. The comparisons are with zero, on a number copied
    // from the file, as the EXPRESS rules state them: exact by construction.
    SatisfiesRule(f: Part21File, a: StepAttributeIndex, rule: ValueRule): Boolean
    {
        if (f.IsUnset(a) || f.IsDerived(a))
        {
            return true;
        }
        var x = f.RealOr(a, Number.Unmeasured);
        return match (rule) {
            AnyValue => true;
            PositiveValue => x > 0.0;
            NonNegativeValue => x >= 0.0;
            NonZeroValue => x.IsNaN ? false : !(x == 0.0);
        };
    }

    // deferred: octet-by-octet comparison of two upper-case names. True when
    // a sorts strictly before b as P21 12.2.5.3 orders complex-instance parts
    // ('_' after the letters, so BOUNDED_CURVE precedes B_SPLINE_CURVE).
    NameOctetsPrecede(a: String, b: String): Boolean;

    //==
    // # Reachability

    // deferred: a graph search over references from the instance at position
    // i. The positions of the instances of kind (or a subtype) reachable from
    // i by following references, i itself included, without entering a
    // representation_map: a mapped_item's source is a separate occurrence. A
    // definitional_representation is entered, since it defines a pcurve; no
    // other representation is referenced from an item. Each position appears
    // once, ascending.
    ReachableOfKind(f: Part21File, i: Integer, kind: String): Array<Integer>;

    // True when the instance named id is reachable from position i.
    Reaches(f: Part21File, i: Integer, id: StepInstanceId): Boolean
        => f.ReachableOfKind(i, "REPRESENTATION_ITEM").Any(p => f.IsInstancePosition(p) ? f.Instances[p].Id == id : false);
}

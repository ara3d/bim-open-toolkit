//==
// # STEP decoding: names, units, placements, references, decode steps
//
// TYPE-CATALOG.md section 14. Names typed so that a decoder arm
// cannot misspell an entity, unit factors with their recognition recorded,
// the assembly path of a placement, the result of following one reference,
// and where decoding was when it issued a diagnostic. TypedInstance (one case
// per supported entity) is not declared: TKT-300 holds it open, and
// StepInstanceBody stays.
//
// Sections, in order:
//  - Names
//  - Units
//  - Placements
//  - References
//  - Decode steps

//==
// # Names

// The long name of an entity of the supported schema, upper case. Built only
// from the schema table (EntityNamesOf, LookupEntity). Removes:
// "ADVANCED_FACE" spelled "ADVANCEDFACE" in one decoder arm.
type EntityName
    implements IValue
{
    Value: String;
}

// The name of an explicit attribute of a schema entity, lower case. Built
// only from the schema table (AttributeNamesOf, LookupAttribute). Removes: an
// attribute read by a name the entity does not declare.
type AttributeName
    implements IValue
{
    Value: String;
}

// What looking a keyword up in the schema table gives: the entity's long
// name, or the keyword as spelled when the table has no such entity.
// Removes: an unknown keyword passed on as a name.
type EntityLookup
    = KnownEntity(Name: EntityName)
    | UnknownEntity(Spelled: String);

// What looking an attribute up on an entity gives: the attribute's name, or
// the entity and the name as spelled when the entity's record has no such
// attribute. Removes: a field read with a fallback because its name was
// wrong.
type AttributeLookup
    = KnownAttribute(Name: AttributeName)
    | UnknownAttribute(Entity: EntityName, Spelled: String);

//==
// # Units

// A length conversion: metres per model unit, the unit it was recognized as,
// and whether it was recognized as a named unit (Snapped) rather than kept
// as Scaled. Removes: a conversion factor whose recognition nobody recorded.
type UnitFactor
    implements IValue
{
    MetresPerUnit: Number;
    Named: LengthUnit;
    Snapped: Boolean;
}

// A plane-angle conversion: radians per file unit, and whether it was
// snapped to exactly pi / 180 (degrees). Removes: a degree factor of
// 0.0174533 kept unsnapped and compounding over a placement chain.
type AngleFactor
    implements IValue
{
    RadiansPerUnit: Number;
    Snapped: Boolean;
}

//==
// # Placements

// The assembly path an occurrence's placement came from: the placing
// instances from the occurrence up to its root, the composed rigid motion,
// and the sign of the composed linear part's determinant (Negative for a
// mirror). Removes: a mirror attributed to the wrong assembly level.
type PlacementChain
{
    Steps: Array<StepInstanceId>;
    Composed: Pose3D;
    Handedness: Sign;
}

//==
// # References

// The result of following one reference: the instance it names, a name the
// file does not define, or an instance of the wrong kind. Removes: a
// dangling reference decoded as instance 0.
type ReferenceResolution
    = Resolved(Id: StepInstanceId)
    | Dangling(Id: StepInstanceId)
    | WrongKind(Id: StepInstanceId, Expected: EntityName);

//==
// # Decode steps

// What the decoder was reading. Removes: a diagnostic that names an instance
// but not what the decoder was doing with it.
type DecodeStep
    = ReadVertex
    | ReadEdge
    | ReadLoop
    | ReadFace
    | ReadShell
    | ReadBody
    | ReadCurve
    | ReadSurface
    | ReadPlacement
    | ReadUnits;

// Where decoding was when it issued a diagnostic: the step, the instance in
// its occurrence, and the finding. Removes: a decode failure reproduced by
// rerunning with print statements.
type DecodeTrace
{
    Step: DecodeStep;
    Source: StepSource;
    Finding: Diagnostic;
}

//==
// # Check and report generators
//
// Generators for the law runner (Plato TKT-446; see
// 00-foundation/tolerance-generators.library.plato). A Check is built only
// by CheckWithin, CheckExact, and WorseOf, and a Report only by Empty, Merge,
// ReportOf, and Located (foundation-diagnostics.types.plato), so these draw
// every Check and Report through those functions and nothing else. Before,
// the runner built a Check field by field, with a negative bound or a Holds
// flag that disagrees with Worst, and a Report whose failed checks had no
// diagnostic (TKT-423).

library V1GeneratorsChecks
{
    // A check of one of three laws: exact (seeds 0, 4, 8, 12; holding below
    // 8), the worse of two measured samples of one law (seeds 3, 7, 11, 15),
    // or one measured sample. Worsts include 0, values each side of the
    // bounds, and Number.Unmeasured; bounds are finite and non-negative, the
    // precondition of CheckWithin.
    Generate_Check(seed: Integer): Check
    {
        var law = seed.V1GeneratorsLawName;
        return seed % 4 == 0
            ? CheckExact(law, seed < 8, seed.V1GeneratorsWhere)
            : (seed % 4 == 3
                ? WorseOf(law.V1GeneratorsMeasuredCheck(seed), law.V1GeneratorsMeasuredCheck(seed + 5))
                : law.V1GeneratorsMeasuredCheck(seed));
    }

    // A report: empty; of one check; two checks merged; a decoder's findings
    // that no check produced merged with a check; or a merge located at a
    // STEP instance. Every report is built through Empty, Merge, ReportOf, and
    // Located only, the four constructors Law_FailedCheckHasDiagnostic names.
    Generate_Report(seed: Integer): Report
    {
        var one = ReportOf(seed.Generate_Check, seed.V1GeneratorsGroup, "A generated check.");
        var two = Merge(one, ReportOf(((seed + 7) % 16).Generate_Check, (seed + 1).V1GeneratorsGroup, "A second generated check."));
        var k = seed % 5;
        return k == 0
            ? Report.Empty
            : (k == 1
                ? one
                : (k == 2
                    ? two
                    : (k == 3
                        ? Merge(ReportOf([Diagnose(StepDiagnosticCode.DanglingReference, Provenance.AtInstance(StepInstanceId(seed + 1)), Number.Unmeasured)]), one)
                        : two.Located(Provenance.AtInstance(StepInstanceId(seed + 1))))));
    }

    // One measured sample of law: a worst and a bound drawn apart from each
    // other, so some samples hold and some fail.
    V1GeneratorsMeasuredCheck(law: String, k: Integer): Check
        => CheckWithin(law, k.V1GeneratorsWorst, (k + k % 3).V1GeneratorsBound, k.V1GeneratorsWhere);

    // Six worsts: 0, below, at and above the small bounds, a large one, and
    // the unmeasured NaN.
    V1GeneratorsWorst(k: Integer): Number
    {
        var worsts = [0.0, 5e-7, 1e-6, 1e-3, 0.75, Number.Unmeasured];
        return worsts[k % 6];
    }

    // Four finite non-negative bounds, 0 being an exact law's.
    V1GeneratorsBound(k: Integer): Number
    {
        var bounds = [0.0, 1e-6, 1e-3, 0.5];
        return bounds[k % 4];
    }

    // Three law names, so merged reports hold checks of different laws.
    V1GeneratorsLawName(k: Integer): String
        => k % 3 == 0 ? "Law_LengthToleranceResolvable" : (k % 3 == 1 ? "Law_EdgeEndsOnCurve" : "Law_LoopIsClosed");

    // Nowhere, the whole input, or a STEP instance.
    V1GeneratorsWhere(k: Integer): Provenance
        => k % 3 == 0 ? Provenance.Nowhere : (k % 3 == 1 ? Provenance.WholeInput : Provenance.AtInstance(StepInstanceId(k + 1)));

    // The three constraint groups in turn.
    V1GeneratorsGroup(k: Integer): ConstraintGroup
        => k % 3 == 0 ? ConstraintGroup.Topological : (k % 3 == 1 ? ConstraintGroup.Geometric : ConstraintGroup.Quality);
}

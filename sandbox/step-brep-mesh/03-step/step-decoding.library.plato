//==
// # StepDecoding
//
// TYPE-CATALOG.md section 14: the constructors of the typed STEP names, the
// unit factors, placement chains, and reference resolution.
//
// Sections, in order:
//  - Names from the schema table
//  - Units
//  - Placements
//  - References

library StepDecoding
{
    //==
    // # Names from the schema table

    // Every entity name of the schema table, in table order.
    EntityNamesOf(schema: Array<EntityDefinition>): Array<EntityName>
        => schema.Map(d => EntityName(d.Name));

    // The entity a keyword (long or short name, upper case) names, by its
    // long name, or UnknownEntity.
    LookupEntity(schema: Array<EntityDefinition>, keyword: String): EntityLookup
        => schema.IsKnownEntity(keyword)
            ? EntityLookup.KnownEntity(EntityName(schema.LongNameOf(keyword)))
            : EntityLookup.UnknownEntity(keyword);

    // The names of the attributes an entity declares itself, in declaration
    // order.
    AttributeNamesOf(d: EntityDefinition): Array<AttributeName>
        => d.Explicit.Map(a => AttributeName(a.Name));

    // The attribute of entity e's flattened record (inherited attributes
    // included) named spelled, or UnknownAttribute.
    LookupAttribute(schema: Array<EntityDefinition>, e: EntityName, spelled: String): AttributeLookup
        => schema.FlatRecord(e.Value).Any(s => s.Attribute.Name == spelled)
            ? AttributeLookup.KnownAttribute(AttributeName(spelled))
            : AttributeLookup.UnknownAttribute(e, spelled);

    // The attribute entity definition d declares itself named spelled, or
    // UnknownAttribute: LookupAttribute without the inherited attributes.
    LookupOwnAttribute(d: EntityDefinition, spelled: String): AttributeLookup
        => d.Explicit.Any(a => a.Name == spelled)
            ? AttributeLookup.KnownAttribute(AttributeName(spelled))
            : AttributeLookup.UnknownAttribute(EntityName(d.Name), spelled);

    // Whether a lookup found exactly the entity name n.
    IsKnownAs(l: EntityLookup, n: String): Boolean
        => match (l) {
            KnownEntity(name) => name.Value == n;
            UnknownEntity(spelled) => false;
        };

    // Whether an attribute lookup found exactly the name n.
    IsKnownAttributeAs(l: AttributeLookup, n: String): Boolean
        => match (l) {
            KnownAttribute(name) => name.Value == n;
            UnknownAttribute(e, spelled) => false;
        };

    //==
    // # Units

    // The length conversion of a unit: layer 2's ScaleToMetres, recognized
    // (Snapped) for every case but Scaled.
    UnitFactorOf(u: LengthUnit): UnitFactor
        => UnitFactor(u.ScaleToMetres, u, IsNamedUnit(u));

    // The length conversion a context's units record.
    UnitFactorOf(c: ContextUnits): UnitFactor
        => UnitFactorOf(c.Length);

    // Whether a unit is a named one rather than Scaled.
    IsNamedUnit(u: LengthUnit): Boolean
        => match (u) {
            Metre => true;
            Millimetre => true;
            Centimetre => true;
            Inch => true;
            Foot => true;
            Scaled(metresPerUnit) => false;
        };

    // The unit a length conversion was recognized as.
    ToLengthUnit(f: UnitFactor): LengthUnit
        => f.Named;

    // A plane-angle conversion of radiansPerUnit radians per unit, snapped
    // exactly when it is pi / 180, the value DecodePolicy.DegreeSnap writes.
    AngleFactorOf(radiansPerUnit: Number): AngleFactor
        => AngleFactor(radiansPerUnit, radiansPerUnit == Number.Pi / 180.0);   // exact by construction

    // The plane-angle conversion a context's units record.
    AngleFactorOf(c: ContextUnits): AngleFactor
        => AngleFactorOf(c.RadiansPerAngleUnit);

    //==
    // # Placements

    // The placing instances (each occurrence's Via) from occurrence o up to
    // its root, following Parent; stops at a parent out of range and after
    // as many steps as there are occurrences, so a cycle cannot loop.
    PlacementStepsOf(occurrences: Array<StepOccurrence>, o: StepOccurrenceIndex): Array<StepInstanceId>
    {
        var steps = new List<StepInstanceId>();
        var at = o.Value;
        var n = 0;
        while (n < occurrences.Count)
        {
            if (at >= 0)
            {
                if (at < occurrences.Count)
                {
                    steps = steps.Add(occurrences[at].Via);
                    at = occurrences[at].Parent.Value;
                }
                else
                {
                    at = -1;
                }
            }
            n = n + 1;
        }
        return steps.Freeze();
    }

    // deferred: compose the placements of PlacementStepsOf, split the
    // composed affine map's linear part into a rotation and its determinant's
    // sign (polar decomposition), and keep the rotation and translation as a
    // Pose3D.
    PlacementChainOf(map: ProvenanceMap, o: StepOccurrenceIndex): PlacementChain;

    //==
    // # References

    // The result of following reference id in file f to an instance that
    // must be an expected (or a subtype of it).
    ResolveReference(f: Part21File, id: StepInstanceId, expected: EntityName): ReferenceResolution
        => f.InstancePosition(id) < 0
            ? ReferenceResolution.Dangling(id)
            : (f.IsA(id, expected.Value) ? ReferenceResolution.Resolved(id) : ReferenceResolution.WrongKind(id, expected));

    // The trace of a diagnostic issued at step s while reading source.
    TraceOf(s: DecodeStep, source: StepSource, finding: Diagnostic): DecodeTrace
        => DecodeTrace(s, source, finding);
}

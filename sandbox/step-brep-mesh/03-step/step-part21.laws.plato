//==
// # Part21ReadingLaws
//
// Layer 3 of the STEP B-rep to mesh design. Laws of the file as data: the
// round trip through text, instance names, the attribute arena, and lookup.
// The arena laws are invariants ParseStep ensures (step.spec.plato, spec
// ParsedFile); Law_ReferencesResolve and Law_HeaderNamesASchema are validity
// laws a file may break, which the parser reports and layer 7 checks. Every
// law is total: positions and indices are guarded with ? : before use.
//
// Sections, in order:
//  - Text
//  - Instance names
//  - The attribute arena
//  - Validity of the file

library Part21ReadingLaws
{
    //==
    // # Text

    // Parsing a text, printing the file, and parsing the print gives the same
    // data model. Holds for every text: a text that does not parse gives the
    // part that did, which prints and reads back unchanged.
    Law_ParsePrintParseIsIdentity(text: String): Boolean
    {
        var first = text.ParseStep.File;
        return first.IsSameFile(first.PrintStep.ParseStep.File);
    }

    // Every finding of the parse points at its code's subject (SubjectOf): a
    // text that is not Part 21, an incomplete header, or a census of lenient
    // tokens at WholeInput; a duplicate name, a syntax error, or a dangling
    // reference at its instance.
    Law_ParseFindingsPointAtTheirSubject(text: String, c: StepDiagnosticCode): Boolean
        => text.ParseStep.Diagnostics.PointsAtSubject(c);

    // A parse is Ok exactly when it reported no Error.
    Law_ParseOkIffNoError(text: String): Boolean
    {
        var parsed = text.ParseStep;
        return parsed.Ok == !parsed.Diagnostics.Any(d => d.Severity.IsError);
    }

    //==
    // # Instance names

    // Every instance name is positive (P21 6.4.4.3: at least one non-zero
    // digit).
    Law_InstanceIdsPositive(f: Part21File, i: Integer): Boolean
        => f.IsInstancePosition(i) ? f.Instances[i].Id.Value >= 1 : true;

    // Instances are stored in ascending order of name.
    Law_InstanceIdsAscending(f: Part21File, i: Integer): Boolean
        => f.IsInstancePosition(i) && f.IsInstancePosition(i + 1) ? f.Instances[i].Id.Value < f.Instances[i + 1].Id.Value : true;

    // No instance name is used twice (P21 11.2).
    Law_InstanceIdsUnique(f: Part21File, i: Integer, j: Integer): Boolean
        => f.IsInstancePosition(i) && f.IsInstancePosition(j) && i != j ? !(f.Instances[i].Id == f.Instances[j].Id) : true;

    // InstancePosition returns the position of the instance named id, and -1
    // exactly when no instance has that name.
    Law_InstancePositionIsExact(f: Part21File, id: StepInstanceId): Boolean
    {
        var p = f.InstancePosition(id);
        return p < 0 ? !f.Instances.Any(x => x.Id == id) : (f.IsInstancePosition(p) ? f.Instances[p].Id == id : false);
    }

    //==
    // # The attribute arena

    // Every attribute index a record holds is an index of the arena.
    Law_RecordIndicesInRange(f: Part21File, i: Integer, r: Integer, k: Integer): Boolean
    {
        var records = f.RecordsAt(i);
        if (r < 0 || r >= records.Count)
        {
            return true;
        }
        var attributes = records[r].Attributes;
        return k >= 0 && k < attributes.Count ? f.Attributes.IsValidIndex(attributes[k]) : true;
    }

    // Every value nested in another (a list item, the inner value of a typed
    // parameter) has a smaller index than its holder: the arena is a forest
    // stored children first, so every recursive reader terminates.
    Law_ChildrenPrecedeParent(f: Part21File, a: Integer, k: Integer): Boolean
    {
        var children = f.ChildrenOf(StepAttributeIndex(a));
        return k >= 0 && k < children.Count ? children[k].Value >= 0 && children[k].Value < a : true;
    }

    //==
    // # Validity of the file

    // Every reference names an instance of the file. A file may break this;
    // ParseStep keeps the reference as written and warns (DanglingReference).
    Law_ReferencesResolve(f: Part21File, a: Integer): Boolean
    {
        var id = f.ReferenceOf(StepAttributeIndex(a));
        return id.IsNone ? true : f.InstancePosition(id) >= 0;
    }

    // The header names at least one schema (FILE_SCHEMA is a LIST [1:?],
    // P21 8.2.4).
    Law_HeaderNamesASchema(f: Part21File): Boolean
        => f.Header.Schema.Count >= 1;
}

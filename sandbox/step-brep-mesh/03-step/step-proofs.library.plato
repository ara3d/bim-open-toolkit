//==
// # Proofs about a prepared model (constructors)
//
// CheckPreparedModel, the only function that builds a PreparedModel
// (step-proofs.spec.plato), its verdict, and its IToleranced obligation.
//
// Sections, in order:
//  - Prepared models

library StepReadingProofs
{
    //==
    // # Prepared models

    // PrepareModel's result as a PreparedModel when its tolerances are well
    // formed (positive and finite); Fails otherwise.
    CheckPreparedModel(raw: RawDecodedModel): DecidedPreparedModel
    {
        var d = raw.PrepareModel;
        return d.Model.Tolerances.IsWellFormed
            ? DecidedPreparedModel.Decided(PreparedModel(d.Model, d))
            : DecidedPreparedModel.Undecided(UndecidedReason.Fails("Tolerances.IsWellFormed"));
    }

    // True when the check built its proof.
    IsDecided(d: DecidedPreparedModel): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // The tolerances PrepareModel floored.
    Tolerance(x: PreparedModel): Tolerances
        => x.Model.Tolerances;
}

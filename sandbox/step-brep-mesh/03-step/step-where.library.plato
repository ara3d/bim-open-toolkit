//==
// # StepWhereRules
//
// Layer 3 of the STEP B-rep to mesh design. The EXPRESS functions that the
// WHERE rules of ISO 10303-42 and -43 call (research/STEP-BREP-MODEL.md 2.3),
// restated over a Part21File so each Law_Where_ in step-where.laws.plato is a
// line or two. A rule is violated only when it evaluates to FALSE; an absent
// optional makes it UNKNOWN, which these helpers report as satisfied.
//
// Sections, in order:
//  - Directions and dimensions
//  - Units
//  - B-spline knots
//  - Trims and surface curves
//  - Topology
//  - Representations

library StepWhereRules
{
    //==
    // # Directions and dimensions

    // The direction ratios of the direction named id as a vector, not
    // normalized; the zero vector when id is no direction or has fewer than
    // two ratios. Two ratios give z = 0.
    DirectionVectorOf(f: Part21File, id: StepInstanceId): Vector3D
    {
        var r = f.FieldReals(f.InstancePosition(id), "DIRECTION", "direction_ratios", 0.0);
        return r.Count >= 3 ? Vector3D(r[0], r[1], r[2])
            : (r.Count == 2 ? Vector3D(r[0], r[1], 0.0) : Vector3D.Zero);
    }

    // The EXPRESS dimension of a geometric item (dimension_of, P42 4.6): the
    // coordinate count of a cartesian_point, the ratio count of a direction,
    // the dimension of a vector's orientation, and otherwise the
    // coordinate_space_dimension of the context it is founded in.
    DimensionOf(f: Part21File, id: StepInstanceId): Integer
    {
        var p = f.InstancePosition(id);
        return f.InstanceIsA(p, "CARTESIAN_POINT") ? f.FieldItems(p, "CARTESIAN_POINT", "coordinates").Count
            : (f.InstanceIsA(p, "DIRECTION") ? f.FieldItems(p, "DIRECTION", "direction_ratios").Count
            : (f.InstanceIsA(p, "VECTOR") ? f.FieldItems(f.InstancePosition(f.FieldReference(p, "VECTOR", "orientation")), "DIRECTION", "direction_ratios").Count
            : f.ContextDimensionOf(id)));
    }

    // deferred: a search of the representations whose items reach id. The
    // coordinate_space_dimension of the geometric context of a representation
    // whose items reach the item named id (EXPRESS dimension_of through
    // using_representations); 0 when none does.
    ContextDimensionOf(f: Part21File, id: StepInstanceId): Integer;

    // The context_of_items of the representation named id; none when absent.
    ContextOf(f: Part21File, id: StepInstanceId): StepInstanceId
        => f.FieldReference(f.InstancePosition(id), "REPRESENTATION", "context_of_items");

    // deferred: a search like ContextDimensionOf. True when the item named
    // item is founded in the context named context: some representation in
    // that context reaches it (EXPRESS item_in_context, P43).
    IsItemInContext(f: Part21File, item: StepInstanceId, context: StepInstanceId): Boolean;

    //==
    // # Units

    // deferred: a lookup of si_unit names (P41 dimensions_for_si_unit) and
    // of dimensional_exponents records, through conversion factors. The seven
    // dimensional exponents of the unit named id (length, mass, time,
    // current, temperature, amount, luminous intensity); empty when unknown.
    DimensionalExponentsOf(f: Part21File, id: StepInstanceId): Array<Number>;

    // True when the unit named id has exactly the given exponents. The
    // exponents are small integers copied from the file or the SI table:
    // exact by construction.
    HasDimensions(f: Part21File, id: StepInstanceId, expected: Array<Number>): Boolean
        => f.DimensionalExponentsOf(id).Corresponds(expected, (a, b) => a == b);

    //==
    // # B-spline knots

    // The constraints_param_b_spline arguments of the B-spline curve at
    // position i.
    CurveKnotSpec(f: Part21File, i: Integer): StepKnotSpec
        => StepKnotSpec(
            f.FieldInteger(i, "B_SPLINE_CURVE", "degree", 0),
            f.FieldItems(i, "B_SPLINE_CURVE", "control_points_list").Count - 1,
            f.FieldIntegers(i, "B_SPLINE_CURVE_WITH_KNOTS", "knot_multiplicities", 0),
            f.FieldReals(i, "B_SPLINE_CURVE_WITH_KNOTS", "knots", Number.Unmeasured));

    // The constraints_param_b_spline arguments of the B-spline surface at
    // position i in u: the outer list of control points runs over u.
    SurfaceKnotSpecU(f: Part21File, i: Integer): StepKnotSpec
        => StepKnotSpec(
            f.FieldInteger(i, "B_SPLINE_SURFACE", "u_degree", 0),
            f.FieldItems(i, "B_SPLINE_SURFACE", "control_points_list").Count - 1,
            f.FieldIntegers(i, "B_SPLINE_SURFACE_WITH_KNOTS", "u_multiplicities", 0),
            f.FieldReals(i, "B_SPLINE_SURFACE_WITH_KNOTS", "u_knots", Number.Unmeasured));

    // The constraints_param_b_spline arguments of the B-spline surface at
    // position i in v: the inner lists run over v; the first row gives the
    // count.
    SurfaceKnotSpecV(f: Part21File, i: Integer): StepKnotSpec
    {
        var rows = f.FieldItems(i, "B_SPLINE_SURFACE", "control_points_list");
        return StepKnotSpec(
            f.FieldInteger(i, "B_SPLINE_SURFACE", "v_degree", 0),
            rows.Count == 0 ? -1 : f.ItemsOf(rows[0]).Count - 1,
            f.FieldIntegers(i, "B_SPLINE_SURFACE_WITH_KNOTS", "v_multiplicities", 0),
            f.FieldReals(i, "B_SPLINE_SURFACE_WITH_KNOTS", "v_knots", Number.Unmeasured));
    }

    // True when lo <= x <= hi.
    IsBetween(x: Integer, lo: Integer, hi: Integer): Boolean
        => x >= lo && x <= hi;

    // constraints_param_b_spline, first condition: degree at least 1.
    HasPositiveDegree(k: StepKnotSpec): Boolean
        => k.Degree >= 1;

    // Second condition: at least degree + 1 control points (upper index on
    // control points at least the degree).
    HasEnoughControlPoints(k: StepKnotSpec): Boolean
        => k.UpperIndexOnControlPoints >= k.Degree;

    // Third condition: at least two knot values (upper index on knots >= 2).
    HasTwoKnots(k: StepKnotSpec): Boolean
        => k.Knots.Count >= 2;

    // Fourth condition: knot values strictly increase. The values are copied
    // from the file and compared as the EXPRESS function compares them: exact
    // by construction.
    HasStrictlyIncreasingKnots(k: StepKnotSpec): Boolean
        => k.Knots.Count < 2 ? true : (k.Knots.Count - 1).Range.All(j => k.Knots[j] < k.Knots[j + 1]);

    // Fifth condition: the multiplicities sum to degree + upper index on
    // control points + 2, the length of the expanded knot array.
    HasExactMultiplicitySum(k: StepKnotSpec): Boolean
        => k.Multiplicities.IntegerTotal == k.Degree + k.UpperIndexOnControlPoints + 2;

    // Sixth condition: the first and last multiplicities lie in [1, degree + 1].
    HasBoundedEndMultiplicities(k: StepKnotSpec): Boolean
        => k.Multiplicities.Count == 0 ? false
            : k.Multiplicities[0].IsBetween(1, k.Degree + 1) && k.Multiplicities[k.Multiplicities.Count - 1].IsBetween(1, k.Degree + 1);

    // Seventh condition: every interior multiplicity lies in [1, degree].
    HasBoundedInteriorMultiplicities(k: StepKnotSpec): Boolean
        => k.Multiplicities.Count < 3 ? true : (k.Multiplicities.Count - 2).Range.All(j => k.Multiplicities[j + 1].IsBetween(1, k.Degree));

    // constraints_param_b_spline (P42 4.6.11): all seven conditions. Each is
    // total, so the non-short-circuit && is safe here.
    ConstraintsParamBSpline(k: StepKnotSpec): Boolean
        => k.HasPositiveDegree
            && k.HasEnoughControlPoints
            && k.HasTwoKnots
            && k.HasStrictlyIncreasingKnots
            && k.HasExactMultiplicitySum
            && k.HasBoundedEndMultiplicities
            && k.HasBoundedInteriorMultiplicities;

    // True when the multiplicity list and the knot list have one entry each
    // per distinct knot.
    HasMatchingKnotLists(k: StepKnotSpec): Boolean
        => k.Multiplicities.Count == k.Knots.Count;

    //==
    // # Trims and surface curves

    // True when a trimming select of two values holds one point and one
    // parameter (trimmed_curve WR1, WR2); one value always qualifies.
    HasDistinctTrimKinds(f: Part21File, items: Array<StepAttributeIndex>): Boolean
        => items.Count < 2 ? true : !(f.ReferenceOf(items[0]).IsNone == f.ReferenceOf(items[1]).IsNone);

    // The surface an associated_geometry entry of a surface_curve lies on:
    // the basis_surface of a pcurve, or the surface itself; none otherwise.
    AssociatedSurface(f: Part21File, a: StepAttributeIndex): StepInstanceId
    {
        var id = f.ReferenceOf(a);
        return f.IsA(id, "PCURVE") ? f.FieldReference(f.InstancePosition(id), "PCURVE", "basis_surface")
            : (f.IsA(id, "SURFACE") ? id : StepInstanceId(-1));
    }

    //==
    // # Topology

    // The vertex an edge, or an oriented edge as used, starts at: edge_start
    // of an edge, and for an oriented edge the element's start or end by its
    // orientation (boolean_choose, P42 5.5.6), composed through nested
    // oriented edges up to depth levels.
    UseStartWithin(f: Part21File, id: StepInstanceId, depth: Integer): StepInstanceId
    {
        var p = f.InstancePosition(id);
        if (depth <= 0 || !f.InstanceIsA(p, "ORIENTED_EDGE"))
        {
            return f.FieldReference(p, "EDGE", "edge_start");
        }
        var element = f.FieldReference(p, "ORIENTED_EDGE", "edge_element");
        return f.FieldIsTrue(p, "ORIENTED_EDGE", "orientation") ? f.UseStartWithin(element, depth - 1) : f.UseEndWithin(element, depth - 1);
    }

    // The vertex an edge, or an oriented edge as used, ends at; the mirror of
    // UseStartWithin.
    UseEndWithin(f: Part21File, id: StepInstanceId, depth: Integer): StepInstanceId
    {
        var p = f.InstancePosition(id);
        if (depth <= 0 || !f.InstanceIsA(p, "ORIENTED_EDGE"))
        {
            return f.FieldReference(p, "EDGE", "edge_end");
        }
        var element = f.FieldReference(p, "ORIENTED_EDGE", "edge_element");
        return f.FieldIsTrue(p, "ORIENTED_EDGE", "orientation") ? f.UseEndWithin(element, depth - 1) : f.UseStartWithin(element, depth - 1);
    }

    // The start vertex of an edge use; nesting deeper than four oriented
    // edges is not followed (it is already a WR1 violation four times over).
    UseStart(f: Part21File, id: StepInstanceId): StepInstanceId
        => f.UseStartWithin(id, 4);

    // The end vertex of an edge use.
    UseEnd(f: Part21File, id: StepInstanceId): StepInstanceId
        => f.UseEndWithin(id, 4);

    // The oriented edges of the path or edge loop at position i, in order.
    PathEdges(f: Part21File, i: Integer): Array<StepInstanceId>
        => f.FieldReferences(i, "PATH", "edge_list");

    // The face_bounds of the face at position i.
    FaceBounds(f: Part21File, i: Integer): Array<StepInstanceId>
        => f.FieldReferences(i, "FACE", "bounds");

    // The loops bounding the face at position i, one per face_bound.
    FaceLoops(f: Part21File, i: Integer): Array<StepInstanceId>
        => f.FaceBounds(i).Map(b => f.FieldReference(f.InstancePosition(b), "FACE_BOUND", "bound"));

    // How many bounds of the face at position i are face_outer_bounds.
    OuterBoundCount(f: Part21File, i: Integer): Integer
        => f.FaceBounds(i).Map(b => f.IsA(b, "FACE_OUTER_BOUND") ? 1 : 0).IntegerTotal;

    // True when the vertex named id is a vertex_point on a cartesian_point.
    IsVertexOnCartesianPoint(f: Part21File, id: StepInstanceId): Boolean
        => f.IsA(id, "VERTEX_POINT") && f.FieldIsA(f.InstancePosition(id), "VERTEX_POINT", "vertex_geometry", "CARTESIAN_POINT");

    //==
    // # Representations

    // The items of the representation at position i.
    RepresentationItems(f: Part21File, i: Integer): Array<StepInstanceId>
        => f.FieldReferences(i, "REPRESENTATION", "items");

    // The items of the representation at position i that are of kind.
    ItemsOfKind(f: Part21File, i: Integer, kind: String): Array<StepInstanceId>
    {
        var items = f.RepresentationItems(i);
        return items.FlatMap(x => f.IsA(x, kind) ? [x] : items.Take(0));
    }

    // The faces of every shell of every item of kind (a manifold solid kind)
    // of the representation at position i.
    SolidFacesOf(f: Part21File, i: Integer, kind: String): Array<StepInstanceId>
        => f.ItemsOfKind(i, kind).FlatMap(s => f.SolidShells(s)).FlatMap(shell => f.ShellFaces(shell));

    // The shells of every shell_based_surface_model of the representation at
    // position i.
    SurfaceModelShells(f: Part21File, i: Integer): Array<StepInstanceId>
        => f.ItemsOfKind(i, "SHELL_BASED_SURFACE_MODEL").FlatMap(m => f.FieldReferences(f.InstancePosition(m), "SHELL_BASED_SURFACE_MODEL", "sbsm_boundary"));

    // The faces of every shell of every shell_based_surface_model of the
    // representation at position i.
    SurfaceModelFaces(f: Part21File, i: Integer): Array<StepInstanceId>
        => f.SurfaceModelShells(i).FlatMap(shell => f.ShellFaces(shell));

    // The positions of the edge_curves the face named id reaches through its
    // loops.
    FaceEdgeCurves(f: Part21File, id: StepInstanceId): Array<Integer>
        => f.ReachableOfKind(f.InstancePosition(id), "EDGE_CURVE");

    // The shells of the manifold solid named id (msb_shells, P42 6.5.6): the
    // outer shell, then the voids of a brep_with_voids.
    SolidShells(f: Part21File, id: StepInstanceId): Array<StepInstanceId>
    {
        var p = f.InstancePosition(id);
        var outer = [f.FieldReference(p, "MANIFOLD_SOLID_BREP", "outer")];
        return f.InstanceIsA(p, "BREP_WITH_VOIDS") ? outer.Concatenate(f.FieldReferences(p, "BREP_WITH_VOIDS", "voids")) : outer;
    }

    // The faces of the shell named id; for an oriented shell, the faces of its
    // element (its own cfs_faces are derived).
    ShellFaces(f: Part21File, id: StepInstanceId): Array<StepInstanceId>
    {
        var p = f.InstancePosition(id);
        return f.InstanceIsA(p, "ORIENTED_CLOSED_SHELL") ? f.FieldReferences(f.InstancePosition(f.FieldReference(p, "ORIENTED_CLOSED_SHELL", "closed_shell_element")), "CONNECTED_FACE_SET", "cfs_faces")
            : (f.InstanceIsA(p, "ORIENTED_OPEN_SHELL") ? f.FieldReferences(f.InstancePosition(f.FieldReference(p, "ORIENTED_OPEN_SHELL", "open_shell_element")), "CONNECTED_FACE_SET", "cfs_faces")
            : f.FieldReferences(p, "CONNECTED_FACE_SET", "cfs_faces"));
    }

    // deferred: a depth-first search with a visited set. True when the
    // mapped_item at position i reaches itself through mapping_source,
    // mapped_representation, and that representation's items (mapped_item
    // WR1 asks for the opposite).
    ReachesItself(f: Part21File, i: Integer): Boolean;

    // deferred: the EXPRESS function msf_surface_check of the AIM, whose text
    // the research did not distil. True when the surface named id is
    // acceptable as face geometry in a manifold_surface_shape_representation.
    PassesMsfSurfaceCheck(f: Part21File, id: StepInstanceId): Boolean;

    // deferred: the EXPRESS function msf_curve_check of the AIM. True when the
    // curve named id is acceptable as edge geometry in a
    // manifold_surface_shape_representation.
    PassesMsfCurveCheck(f: Part21File, id: StepInstanceId): Boolean;
}

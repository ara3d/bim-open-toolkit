//==
// # StepReadingLaws
//
// Layer 3 of the STEP B-rep to mesh design. Laws of DecodeBrep, stated for
// every Part21File: totality, the provenance map as a bijection, counts per
// kind, units and tolerance, the faithful copying of flags, and orientation
// folding. Each law decodes the file it is given with the standard policy; the
// law runner runs them over witness files and the corpus (README, "Test
// files"), since a random Part21File holds arrays and cannot be generated
// (PLATO-PRIMER.md B.2). Every law is total.
//
// Since 2026-10-17 DecodeBrep is PrepareModel of the C# decoder's raw model
// (README, "Boundary moved to RawDecodedModel, 2026-10-17"). The laws of the
// geometric decisions, closure and the fold, are stated over a
// RawDecodedModel and PrepareModel's output; each keeps its Part21File form,
// which applies it to DecodeRaw of the file, so the checks that cite it are
// unchanged. The first section holds the laws of the boundary itself.
//
// Sections, in order:
//  - The raw boundary
//  - Totality
//  - The provenance map
//  - Counts
//  - Units and tolerance
//  - Closure
//  - Copied flags and repairs
//  - Orientation folding

library StepReadingLaws
{
    //==
    // # The raw boundary
    //
    // What the C# decoder must deliver (the preconditions, as laws over a
    // RawDecodedModel) and what PrepareModel promises of every raw model.

    // The raw model holds no closure mark: closure is PrepareModel's decision.
    Law_RawHasNoClosures(raw: RawDecodedModel): Boolean
        => raw.Model.Geometry.Closures.Count == 0;

    // No raw curve or surface direction is Closed in layer 1's Domain: every
    // Periodicity is the one its family gives (Periodic or Aperiodic). Follows
    // from Law_RawHasNoClosures, since only a mark makes a direction Closed;
    // stated so a decoder that grew a Closed case some other way fails here.
    Law_RawHasNoClosedPeriodicity(raw: RawDecodedModel, k: Integer): Boolean
    {
        var g = raw.Model.Geometry;
        var curve = k >= 0 && k < g.Curves.Count ? g.Domain(CurveIndex(k)).Periodicity : Periodicity.Aperiodic;
        var u = k >= 0 && k < g.Surfaces.Count ? g.Domain(SurfaceIndex(k)).DomainAlong(SurfaceParameter.ParameterU).Periodicity : Periodicity.Aperiodic;
        var v = k >= 0 && k < g.Surfaces.Count ? g.Domain(SurfaceIndex(k)).DomainAlong(SurfaceParameter.ParameterV).Periodicity : Periodicity.Aperiodic;
        return !(curve.HasSeam && !curve.IsPeriodic) && !(u.HasSeam && !u.IsPeriodic) && !(v.HasSeam && !v.IsPeriodic);
    }

    // The raw model's tolerances are unset: the decoder decides none.
    Law_RawTolerancesUnset(raw: RawDecodedModel): Boolean
        => raw.Model.Tolerances == Tolerances.UnsetTolerances;

    // The raw model is in millimetres, and the factors it records are the
    // stated units of occurrence 0's context (the policy's defaults where the
    // context is silent): LengthFactor is millimetres per its length unit,
    // within the policy's unit-match tolerance, and AngleFactor its radians
    // per plane-angle unit; both are 1 when there is no occurrence.
    Law_UnitsFactorsAgree(raw: RawDecodedModel): Boolean
    {
        var policy = DecodePolicy.StandardPolicy;
        if (raw.Occurrences.Count == 0)
        {
            return raw.Model.Unit == LengthUnit.Millimetre && raw.LengthFactor == 1.0 && raw.AngleFactor == 1.0;
        }
        var root = raw.Units.ContextUnitsOf(raw.Occurrences[0].Context, policy.DefaultContextUnits);
        return raw.Model.Unit == LengthUnit.Millimetre
            && raw.LengthFactor.AlmostEqual(root.Length.MillimetresPerUnit, policy.UnitMatch)
            && raw.AngleFactor == root.RadiansPerAngleUnit;
    }

    // Preparing a prepared model's raw view (RawOf) changes nothing: the same
    // model (layer 7's SameModel), occurrences, sources, folds, repairs and
    // magnitudes (SameDecodedModel, step-raw-witnesses.library.plato). Guarded by the
    // magnitudes: a vertex merge can remove a point on the bounding box,
    // within the length tolerance, and then the second pass derives its
    // tolerances from a slightly different size; with the magnitudes equal
    // every decision is taken again at the same tolerance.
    Law_PrepareIsIdempotent(raw: RawDecodedModel): Boolean
    {
        var d = raw.PrepareModel;
        var again = d.RawOf(raw).PrepareModel;
        return d.ModelSize == again.ModelSize && d.CoordinateExtent == again.CoordinateExtent
            ? again.SameDecodedModel(d)
            : true;
    }

    // Preparing moves no point: the arena's curves and surfaces are the raw
    // model's, and prepared vertex k has the point of the raw vertex with the
    // same source. The fold changes flags, not points, and keeps each face's
    // region (Law_FoldPreservesInteriorSide); a merge removes a vertex within
    // the length tolerance of the one kept (Law_MergedVerticesCoincide). So
    // the prepared model's point set is the raw model's.
    Law_PrepareKeepsPointSet(raw: RawDecodedModel, k: Integer): Boolean
    {
        var d = raw.PrepareModel;
        var arena = d.Model.Geometry.Curves.Corresponds(raw.Model.Geometry.Curves, (a, b) => a == b)
            && d.Model.Geometry.Surfaces.Corresponds(raw.Model.Geometry.Surfaces, (a, b) => a == b);
        if (k < 0 || k >= d.Model.Vertices.Count || k >= d.Map.Sources.Vertices.Count)
        {
            return arena;
        }
        var source = d.Map.Sources.Vertices[k];
        var point = d.Model.Vertices[k].Point;
        return arena && raw.Model.Vertices.Count.Range.Any(p => p < raw.Sources.Vertices.Count ? raw.Sources.Vertices[p] == source && raw.Model.Vertices[p].Point == point : false);
    }

    // The C# decoder's half of the fold laws: a raw face's same_sense, and
    // the orientation of its bound j, are the file's (no fold applied). With
    // it, the raw forms of the fold laws give their old statements against
    // the file.
    Law_RawFaceFlagsAreTheFiles(f: Part21File, k: Integer, j: Integer): Boolean
    {
        var raw = f.DecodeRaw(DecodePolicy.StandardPolicy);
        if (k < 0 || k >= raw.Model.Faces.Count || k >= raw.Sources.Faces.Count)
        {
            return true;
        }
        var face = raw.Model.Faces[k];
        var source = raw.Sources.Faces[k];
        return face.SameSense == f.FileFaceSameSense(source)
            && (j >= 0 && j < face.Bounds.Count ? face.Bounds[j].Orientation == f.FileBoundOrientation(source, j) : true);
    }

    //==
    // # Totality

    // Whatever the file, every index of the decoded model is in range (layer
    // 2's Law_IndicesInRange): no instance makes decoding fail; whatever
    // cannot be decoded is left out and diagnosed.
    Law_DecodeIsTotal(f: Part21File): Boolean
        => f.DecodeBrep.Model.Law_IndicesInRange;

    // Whatever the file, the decoded tolerances are positive and finite.
    Law_DecodedTolerancesWellFormed(f: Part21File): Boolean
        => f.DecodeBrep.Model.Tolerances.IsWellFormed;

    // Every repair has a diagnostic about its instance.
    Law_RepairsAreDiagnosed(f: Part21File, r: Integer): Boolean
    {
        var d = f.DecodeBrep;
        return r >= 0 && r < d.Map.Repairs.Count ? d.Diagnostics.Any(x => x.Where == Provenance.AtInstance(d.Map.Repairs[r].Source.Instance)) : true;
    }

    // Every finding of the decode points at its code's subject (SubjectOf):
    // a finding about the file as a whole at WholeInput, a defect of a
    // decoded curve or surface at that record, every other finding at its
    // instance. No finding points at Nowhere.
    Law_DecodeFindingsPointAtTheirSubject(f: Part21File, c: StepDiagnosticCode): Boolean
        => f.DecodeBrep.Diagnostics.PointsAtSubject(c);

    //==
    // # The provenance map

    // Every kernel element has exactly one source: each table of the map is
    // as long as the model's.
    Law_ProvenanceCoversModel(f: Part21File): Boolean
    {
        var d = f.DecodeBrep;
        return d.Map.CoversModel(d.Model);
    }

    // No two kernel elements share a source: the map is injective.
    Law_ProvenanceSourcesDistinct(f: Part21File, a: Integer, b: Integer): Boolean
    {
        var all = f.DecodeBrep.Map.Sources.AllSources;
        return a >= 0 && a < all.Count && b >= 0 && b < all.Count && a != b ? !(all[a] == all[b]) : true;
    }

    // Looking a source up gives back the kernel element it is the source of:
    // KernelOf inverts the map's forward tables.
    Law_ProvenanceLookupInvertsSources(f: Part21File, a: Integer): Boolean
    {
        var d = f.DecodeBrep;
        var all = d.Map.Sources.AllSources;
        return a >= 0 && a < all.Count ? d.Map.KernelOf(all[a]) == d.Map.Sources.ElementAt(a) : true;
    }

    // The source of every kernel element is an instance of that table's
    // kind: a vertex comes from a vertex_point, a face from a face_surface,
    // a pcurve from a pcurve, and so on (TableKinds).
    Law_SourceKindMatchesTable(f: Part21File, a: Integer): Boolean
    {
        var sources = f.DecodeBrep.Map.Sources;
        var all = sources.AllSources;
        return a >= 0 && a < all.Count ? f.IsAnyOf(all[a].Instance, sources.ElementAt(a).TableKinds) : true;
    }

    // A repaired source has no kernel element of its own.
    Law_RepairedSourcesAreUnmapped(f: Part21File, r: Integer): Boolean
    {
        var map = f.DecodeBrep.Map;
        return r >= 0 && r < map.Repairs.Count ? !map.IsMapped(map.Repairs[r].Source) : true;
    }

    // Every instance an occurrence reaches that decodes to a kernel element of
    // its own (ProducesKernelElement) is mapped or repaired: the map covers
    // every decoded instance, so it is a bijection between them and the
    // kernel elements.
    Law_ReachedInstancesAreAccountedFor(f: Part21File, o: Integer, k: Integer): Boolean
    {
        var d = f.DecodeBrep;
        if (o < 0 || o >= d.Map.Occurrences.Count)
        {
            return true;
        }
        var reached = f.ReachableOfKind(f.RepresentationPosition(d.Map.Occurrences[o]), "REPRESENTATION_ITEM");
        if (k < 0 || k >= reached.Count || !f.ProducesKernelElement(reached[k]))
        {
            return true;
        }
        var source = StepSource(StepOccurrenceIndex(o), f.IdAt(reached[k]));
        return d.Map.IsMapped(source) || d.Map.IsRepaired(source);
    }

    //==
    // # Counts
    //
    // One kernel element per reached (occurrence, instance) pair of the kind,
    // less the pairs repaired away. A face reached through an oriented_face is
    // one face; an oriented shell is folded into the shell it wraps.

    // One BrepVertex per reached vertex_point not merged into another.
    Law_VertexCountMatchesInstances(f: Part21File): Boolean
    {
        var d = f.DecodeBrep;
        return d.Model.Vertices.Count + d.Map.RemovedCount(f, "VERTEX_POINT") == f.ReachedCount(d.Map, "VERTEX_POINT");
    }

    // One BrepEdge per reached edge_curve not dropped.
    Law_EdgeCountMatchesInstances(f: Part21File): Boolean
    {
        var d = f.DecodeBrep;
        return d.Model.Edges.Count + d.Map.RemovedCount(f, "EDGE_CURVE") == f.ReachedCount(d.Map, "EDGE_CURVE");
    }

    // One BrepLoop per reached edge_loop, vertex_loop or poly_loop.
    Law_LoopCountMatchesInstances(f: Part21File): Boolean
    {
        var d = f.DecodeBrep;
        return d.Model.Loops.Count + d.Map.RemovedCount(f, "LOOP") == f.ReachedCount(d.Map, "LOOP");
    }

    // One BrepFace per reached face_surface (advanced_face included).
    Law_FaceCountMatchesInstances(f: Part21File): Boolean
    {
        var d = f.DecodeBrep;
        return d.Model.Faces.Count + d.Map.RemovedCount(f, "FACE_SURFACE") == f.ReachedCount(d.Map, "FACE_SURFACE");
    }

    // One BrepShell per reached closed_shell or open_shell that is not an
    // oriented shell.
    Law_ShellCountMatchesInstances(f: Part21File): Boolean
    {
        var d = f.DecodeBrep;
        var removed = d.Map.RemovedCount(f, "CONNECTED_FACE_SET") - d.Map.RemovedCount(f, "ORIENTED_CLOSED_SHELL") - d.Map.RemovedCount(f, "ORIENTED_OPEN_SHELL");
        var reached = f.ReachedCount(d.Map, "CONNECTED_FACE_SET") - f.ReachedCount(d.Map, "ORIENTED_CLOSED_SHELL") - f.ReachedCount(d.Map, "ORIENTED_OPEN_SHELL");
        return d.Model.Shells.Count + removed == reached;
    }

    // One BrepBody per reached manifold solid B-rep (brep_with_voids and
    // faceted_brep included) or shell-based surface model.
    Law_BodyCountMatchesInstances(f: Part21File): Boolean
    {
        var d = f.DecodeBrep;
        var removed = d.Map.RemovedCount(f, "MANIFOLD_SOLID_BREP") + d.Map.RemovedCount(f, "SHELL_BASED_SURFACE_MODEL");
        var reached = f.ReachedCount(d.Map, "MANIFOLD_SOLID_BREP") + f.ReachedCount(d.Map, "SHELL_BASED_SURFACE_MODEL");
        return d.Model.Bodies.Count + removed == reached;
    }

    // One BrepCurve or BrepCurve2D per reached curve that is not a pcurve:
    // basis curves, composite segments' curves, and the 2D curves inside
    // pcurve definitions each get their own entry, never nested.
    Law_CurveCountMatchesInstances(f: Part21File): Boolean
    {
        var d = f.DecodeBrep;
        var removed = d.Map.RemovedCount(f, "CURVE") - d.Map.RemovedCount(f, "PCURVE");
        var reached = f.ReachedCount(d.Map, "CURVE") - f.ReachedCount(d.Map, "PCURVE");
        return d.Model.Geometry.Curves.Count + d.Model.Geometry.Curves2D.Count + removed == reached;
    }

    // One Pcurve per reached pcurve: the file's pcurves are kept, and none is
    // invented (Law_PcurvesComeFromPcurveInstances).
    Law_PcurveCountMatchesInstances(f: Part21File): Boolean
    {
        var d = f.DecodeBrep;
        return d.Model.Geometry.Pcurves.Count + d.Map.RemovedCount(f, "PCURVE") == f.ReachedCount(d.Map, "PCURVE");
    }

    // One BrepSurface per reached surface.
    Law_SurfaceCountMatchesInstances(f: Part21File): Boolean
    {
        var d = f.DecodeBrep;
        return d.Model.Geometry.Surfaces.Count + d.Map.RemovedCount(f, "SURFACE") == f.ReachedCount(d.Map, "SURFACE");
    }

    //==
    // # Units and tolerance

    // Angles are radians after decoding, whatever the file's plane-angle
    // unit: a kernel curve decoded from a circle has period 2 pi within tol,
    // in a file whose angle unit is the degree as in any other.
    Law_CirclePeriodIsTwoPi(f: Part21File, k: Integer, tol: ParameterTolerance): Boolean
    {
        var d = f.DecodeBrep;
        var sources = d.Map.Sources.Curves;
        if (k < 0 || k >= sources.Count || k >= d.Model.Geometry.Curves.Count || !f.IsA(sources[k].Instance, "CIRCLE"))
        {
            return true;
        }
        var periodicity = d.Model.Geometry.Domain(CurveIndex(k)).Periodicity;
        return periodicity.IsPeriodic ? (periodicity.PeriodOr(Number.Unmeasured) - Number.Tau).Abs <= tol.Value : false;
    }

    // Every used context's plane-angle unit is reported at Info: found, or
    // defaulted by the policy.
    Law_AngleUnitIsReported(f: Part21File, c: Integer): Boolean
    {
        var d = f.DecodeBrep;
        var used = f.ResolveContexts(DecodePolicy.StandardPolicy).UsedContexts(d.Map);
        return c >= 0 && c < used.Count
            ? d.Diagnostics.HasCodeAt(used[c].AngleStated ? StepDiagnosticCode.AngleUnitFound : StepDiagnosticCode.AngleUnitDefaulted, used[c].Context)
            : true;
    }

    // The uncertainty default is applied exactly when no used context states
    // a length uncertainty.
    Law_UncertaintyDefaultExactlyWhenAbsent(f: Part21File): Boolean
    {
        var d = f.DecodeBrep;
        var used = f.ResolveContexts(DecodePolicy.StandardPolicy).UsedContexts(d.Map);
        return used.Any(c => c.HasStatedUncertainty) == !d.Diagnostics.HasCode(StepDiagnosticCode.UncertaintyDefaulted);
    }

    // The model's length tolerance is at least every stated uncertainty of a
    // used context, converted to the model unit (within the policy's
    // unit-match tolerance, the rounding of the conversion).
    Law_ToleranceCoversStatedUncertainties(f: Part21File, c: Integer): Boolean
    {
        var d = f.DecodeBrep;
        var used = f.ResolveContexts(DecodePolicy.StandardPolicy).UsedContexts(d.Map);
        var tolerance = d.Model.Tolerances.Length.Value;
        return c >= 0 && c < used.Count
            ? used[c].StatedUncertaintyIn(d.Model.Unit).All(u => u <= tolerance || u.AlmostEqual(tolerance, DecodePolicy.StandardPolicy.UnitMatch))
            : true;
    }

    // The model's length unit is the millimetre: since the boundary moved to
    // RawDecodedModel the decoder converts every occurrence to it, and the
    // root context's own unit survives as the raw model's LengthFactor
    // (Law_UnitsFactorsAgree). The name is kept for the check that cites it.
    Law_ModelUnitIsRootUnit(f: Part21File): Boolean
        => f.DecodeBrep.Model.Unit == LengthUnit.Millimetre;

    // The magnitudes the decode exports are the raw model's: ModelSize and
    // CoordinateExtent equal layer 2's functions of the model PrepareModel
    // was given, so a later layer reading them reads what the tolerances were
    // built from. They equal the finished model's unless a merge removed a
    // point on the bounding box, within the length tolerance.
    Law_DecodedMagnitudesAreTheModels(f: Part21File): Boolean
    {
        var raw = f.DecodeRaw(DecodePolicy.StandardPolicy);
        var d = raw.PrepareModel;
        return d.ModelSize == raw.Model.ModelSize && d.CoordinateExtent == raw.Model.CoordinateExtent;
    }

    // The length tolerance can be honoured at the model's coordinates: it is
    // at least the arithmetic resolution at the coordinate extent (layer 0's
    // Law_LengthToleranceResolvable), whatever the file stated.
    Law_DecodedToleranceResolvable(f: Part21File): Boolean
    {
        var d = f.DecodeBrep;
        return Law_LengthToleranceResolvable(d.Model.Tolerances.Length, d.CoordinateExtent);
    }

    // The two parameter floors are layer 0's functions of the length
    // tolerance and the exported magnitudes: LengthParameterFloor over the
    // extent, AngleParameterFloor over the model size and the extent.
    Law_ParameterFloorsFollowLength(f: Part21File): Boolean
    {
        var d = f.DecodeBrep;
        var t = d.Model.Tolerances;
        return t.LengthParameter == t.Length.LengthParameterFloor(d.CoordinateExtent)
            && t.AngleParameter == t.Length.AngleParameterFloor(d.ModelSize, d.CoordinateExtent);
    }

    //==
    // # Closure
    //
    // README, "Closure at decode": a direction whose formula does not wrap
    // gets Closed(range length) exactly when its two ends are one point set
    // within the model's length tolerance, and Aperiodic otherwise. The file's
    // closed_curve, u_closed and v_closed flags are information only (P42
    // 4.5.34 NOTE 10) and never decide; a disagreement is a diagnostic.

    // PrepareModel writes its closure decisions into the arena, and nothing
    // else: the arena's marks are ClosureMarks of the prepared arena at the
    // model's tolerances, one per curve or surface direction whose natural
    // domain is bounded, does not wrap, and whose ends (or opposite sides)
    // coincide within the length tolerance; none when nothing closes.
    Law_ClosureMarksAreTheDecisions(raw: RawDecodedModel): Boolean
    {
        var m = raw.PrepareModel.Model;
        return m.Geometry.Closures.Corresponds(m.Geometry.ClosureMarks(m.Tolerances), (a, b) => a == b);
    }

    // The same, for the decode of a file.
    Law_ClosureMarksAreTheDecisions(f: Part21File): Boolean
        => Law_ClosureMarksAreTheDecisions(f.DecodeRaw(DecodePolicy.StandardPolicy));

    // A decoded curve is Closed in layer 1's Domain exactly when the decode
    // decided it closed: its natural domain is bounded and does not wrap, and
    // its two ends coincide within the model's length tolerance (a clamped
    // B-spline whose first and last control points coincide, a polyline back
    // at its start, a trim spanning a whole circle). A periodic curve stays
    // Periodic and an open one Aperiodic.
    Law_CurveClosureDecidedByEnds(raw: RawDecodedModel, k: Integer): Boolean
    {
        var m = raw.PrepareModel.Model;
        if (k < 0 || k >= m.Geometry.Curves.Count)
        {
            return true;
        }
        var p = m.Geometry.Domain(CurveIndex(k)).Periodicity;
        return (p.HasSeam && !p.IsPeriodic) == m.Geometry.DecidesClosed(CurveIndex(k), m.Tolerances.Length);
    }

    // The same, for the decode of a file.
    Law_CurveClosureDecidedByEnds(f: Part21File, k: Integer): Boolean
        => Law_CurveClosureDecidedByEnds(f.DecodeRaw(DecodePolicy.StandardPolicy), k);

    // A decoded surface is Closed in a parameter in layer 1's Domain exactly
    // when the decode decided it closed there: the natural domain in that
    // parameter is bounded and does not wrap, and the two opposite sides are
    // the same curve within the model's tolerances (a clamped B-spline
    // surface closed in u, a revolution of a closed profile, an extrusion of
    // a closed curve).
    Law_SurfaceClosureDecidedBySides(raw: RawDecodedModel, k: Integer, which: SurfaceParameter): Boolean
    {
        var m = raw.PrepareModel.Model;
        if (k < 0 || k >= m.Geometry.Surfaces.Count)
        {
            return true;
        }
        var p = m.Geometry.Domain(SurfaceIndex(k)).DomainAlong(which).Periodicity;
        return (p.HasSeam && !p.IsPeriodic) == m.Geometry.DecidesClosed(SurfaceIndex(k), which, m.Tolerances);
    }

    // The same, for the decode of a file.
    Law_SurfaceClosureDecidedBySides(f: Part21File, k: Integer, which: SurfaceParameter): Boolean
        => Law_SurfaceClosureDecidedBySides(f.DecodeRaw(DecodePolicy.StandardPolicy), k, which);

    // Closure decided without evaluation (TKT-348, chunk D1): every closure
    // decision Reduced calls returns for every BrepCurve kind, a B-spline
    // whose evaluation is unavailable included; a clamped B-spline's closure
    // is its end control points' (laws in layer 8's
    // pipeline-proofs-bsplines.laws.plato, over its curve fixtures); where
    // the decision is made it is the one evaluation would give; and the
    // reduction of a model with a B-spline edge returns, keeping an
    // undecided edge and locating a diagnostic on it. The fixtures are
    // step-raw-witnesses.library.plato's ClosureArena and the two raw cubes
    // with a B-spline edge.

    // For every curve of ClosureArena (every BrepCurve kind, with B-splines
    // whose evaluation is unavailable), DecidesClosedByEnds and
    // RunsBackToStartDecided return, and the decision is Undecided exactly
    // for the curves listed in ArenaIsUndecided: a curve that reaches a
    // B-spline other than through clamped ends. One case checks all 21.
    Law_ClosureDecisionReturnsForEveryKind(_: Boolean): Boolean
        => GeometrySet.ArenaCurves.All(c => c.ClosureDecisionReturns);

    // Law_ClosureDecisionReturnsForEveryKind for one arena curve.
    ClosureDecisionReturns(c: CurveIndex): Boolean
    {
        var g = GeometrySet.ClosureArena;
        var tol = LengthTolerance.ArenaTolerance;
        var decided = g.DecidesClosedByEnds(c, tol);
        var runs = g.RunsBackToStartDecided(c, tol);
        return decided.IsDecided == !c.Value.ArenaIsUndecided
            && runs.IsDecided == !c.Value.ArenaIsUndecided
            && (c.Value.ArenaIsUndecided ? true : runs.IsClosed == (decided.IsClosed || g.CurveAt(c).Domain(g).Periodicity.HasSeam));
    }

    // The decision is Closed exactly for the arena's curves listed in
    // ArenaIsClosed, the unevaluable closed spline (11) among them.
    Law_ClosureDecisionIsTheEnds(_: Boolean): Boolean
        => GeometrySet.ArenaCurves.All(c => GeometrySet.ClosureArena.DecidesClosed(c, LengthTolerance.ArenaTolerance) == c.Value.ArenaIsClosed);

    // Where the arena's curve can be evaluated and the decision is made, it
    // is the evaluated one: the ends of the natural domain coincide within
    // the tolerance (the decision before TKT-348), and RunsBackToStart is
    // that or a seam. Reading the record changes no answer evaluation gave.
    Law_DecisionAgreesWithEvaluation(_: Boolean): Boolean
        => GeometrySet.ArenaCurves.All(c => c.DecisionAgreesWithEvaluation);

    // Law_DecisionAgreesWithEvaluation for one arena curve; the evaluation
    // runs only for a curve that can be evaluated.
    DecisionAgreesWithEvaluation(c: CurveIndex): Boolean
        => c.Value.ArenaIsUnevaluable || c.Value.ArenaIsUndecided ? true : c.DecidedClosureIsTheEvaluated;

    // DecidesClosed and RunsBackToStart of arena curve c against evaluating
    // both ends of its natural domain. Precondition: c can be evaluated.
    DecidedClosureIsTheEvaluated(c: CurveIndex): Boolean
    {
        var g = GeometrySet.ClosureArena;
        var tol = LengthTolerance.ArenaTolerance;
        var d = g.CurveAt(c).Domain(g);
        var evaluated = d.IsClosable ? g.EvaluatedEndsClosure(c, tol).IsClosed : false;
        return g.DecidesClosed(c, tol) == evaluated
            && g.RunsBackToStart(c, tol) == (d.Periodicity.HasSeam || evaluated);
    }

    // A curve is Undecided only when evaluating it reaches a B-spline, and
    // ReachesSpline names the arena's curves that do.
    Law_UndecidedOnlyWhenReachingSpline(_: Boolean): Boolean
        => GeometrySet.ArenaCurves.All(c => c.UndecidedOnlyWhenReachingSpline);

    // Law_UndecidedOnlyWhenReachingSpline for one arena curve.
    UndecidedOnlyWhenReachingSpline(c: CurveIndex): Boolean
    {
        var g = GeometrySet.ClosureArena;
        return g.ReachesSpline(c) == c.Value.ArenaReachesSpline
            && (g.DecidesClosedByEnds(c, LengthTolerance.ArenaTolerance).IsDecided || g.ReachesSpline(c));
    }

    // PrepareModel returns for every raw model, the cubes with a B-spline
    // edge included, with every index in range (layer 2's
    // Law_IndicesInRange).
    Law_PreparationReturns(raw: RawDecodedModel): Boolean
        => raw.PrepareModel.Model.Law_IndicesInRange;

    // Every edge whose closure is undecided at the prepared tolerances is
    // kept (the edge count is the raw count less the dropped edges, which
    // are never undecided), and has one EdgeClosureUndecided diagnostic at
    // its instance measuring its curve's instance id; no other edge has one.
    Law_UndecidedEdgesAreKeptAndDiagnosed(raw: RawDecodedModel, k: Integer): Boolean
    {
        var m = raw.Model;
        if (k < 0 || k >= m.Edges.Count)
        {
            return true;
        }
        var prepared = raw.PrepareModel;
        var tol = prepared.Model.Tolerances.Length;
        var e = m.Edges[k];
        var code = StepDiagnosticCode.EdgeClosureUndecided.CodeOf;
        var undecided = !m.Geometry.RunsBackToStartDecided(e.Curve, tol).IsDecided;
        var findings = prepared.Diagnostics.FlatMap(d => d.Code == code && d.Where == Provenance.AtInstance(raw.Sources.Edges[k].Instance) ? [d] : prepared.Diagnostics.Take(0));
        return undecided
            ? findings.Count == 1 && findings[0].Measure == raw.Sources.Curves[e.Curve.Value].Instance.Value.ToNumber
                && prepared.Map.Repairs.All(r => r.Source.Instance != raw.Sources.Edges[k].Instance)
            : findings.Count == 0;
    }

    // The two cube witnesses prepare as stated: the clamped one with no
    // undecided diagnostic and the cube's edge count, the unclamped one with
    // exactly one, at edge #53 measuring curve #33, and the same edge count.
    Law_CubeWitnessesPrepareAsStated(_: Boolean): Boolean
    {
        var clamped = RawDecodedModel.Witness_RawCubeWithClampedSplineEdge.PrepareModel;
        var unclamped = RawDecodedModel.Witness_RawCubeWithUnclampedSplineEdge.PrepareModel;
        var code = StepDiagnosticCode.EdgeClosureUndecided.CodeOf;
        var findings = unclamped.Diagnostics.FlatMap(d => d.Code == code ? [d] : unclamped.Diagnostics.Take(0));
        return clamped.Model.Edges.Count == 12
            && !clamped.Diagnostics.HasCode(StepDiagnosticCode.EdgeClosureUndecided)
            && unclamped.Model.Edges.Count == 12
            && findings.Count == 1
            && findings[0].Where == Provenance.AtInstance(StepInstanceId(53))
            && findings[0].Measure == 33.0;
    }

    //==
    // # Copied flags and repairs

    // An edge keeps the same_sense of its edge_curve; its parameter range is
    // not in the file and layer 2 derives it (EdgeDomain).
    Law_EdgeSenseCopied(f: Part21File, e: Integer): Boolean
    {
        var d = f.DecodeBrep;
        return e >= 0 && e < d.Model.Edges.Count && e < d.Map.Sources.Edges.Count
            ? d.Model.Edges[e].SameSense == f.FileEdgeSameSense(d.Map.Sources.Edges[e])
            : true;
    }

    // Every kernel pcurve comes from a pcurve instance of the file: the
    // decoder invents none (seams and poles are face meshing's).
    Law_PcurvesComeFromPcurveInstances(f: Part21File, k: Integer): Boolean
    {
        var sources = f.DecodeBrep.Map.Sources.Pcurves;
        return k >= 0 && k < sources.Count ? f.IsA(sources[k].Instance, "PCURVE") : true;
    }

    // A shell is declared closed exactly when the file wrote a closed_shell;
    // whether it is closed is layer 2's Law_DeclaredClosedIsClosed.
    Law_DeclaredClosedCopied(f: Part21File, s: Integer): Boolean
    {
        var d = f.DecodeBrep;
        return s >= 0 && s < d.Model.Shells.Count && s < d.Map.Sources.Shells.Count
            ? d.Model.Shells[s].DeclaredClosed == f.IsA(d.Map.Sources.Shells[s].Instance, "CLOSED_SHELL")
            : true;
    }

    // A face with two or more face_outer_bounds (face WR2 broken) has no bound
    // marked outer: the flag is a hint, and a contradictory hint is dropped.
    Law_OuterFlagClearedWhenDoubled(f: Part21File, k: Integer): Boolean
    {
        var d = f.DecodeBrep;
        if (k < 0 || k >= d.Model.Faces.Count || k >= d.Map.Sources.Faces.Count)
        {
            return true;
        }
        return f.OuterBoundCount(f.InstancePosition(d.Map.Sources.Faces[k].Instance)) > 1
            ? d.Model.Faces[k].Bounds.All(b => !b.IsOuter)
            : true;
    }

    // On a face with at most one face_outer_bound, bound j is marked outer
    // exactly when the file wrote it as a face_outer_bound.
    Law_OuterFlagCopiedWhenSingle(f: Part21File, k: Integer, j: Integer): Boolean
    {
        var d = f.DecodeBrep;
        if (k < 0 || k >= d.Model.Faces.Count || k >= d.Map.Sources.Faces.Count)
        {
            return true;
        }
        var p = f.InstancePosition(d.Map.Sources.Faces[k].Instance);
        var bounds = f.FaceBounds(p);
        var kernel = d.Model.Faces[k].Bounds;
        return f.OuterBoundCount(p) <= 1 && j >= 0 && j < bounds.Count && j < kernel.Count
            ? kernel[j].IsOuter == f.IsA(bounds[j], "FACE_OUTER_BOUND")
            : true;
    }

    // A merged vertex lies within the length tolerance of the vertex it was
    // merged into.
    Law_MergedVerticesCoincide(f: Part21File, r: Integer): Boolean
    {
        var d = f.DecodeBrep;
        if (r < 0 || r >= d.Map.Repairs.Count)
        {
            return true;
        }
        var repair = d.Map.Repairs[r];
        var v = repair.Repair.MergedVertexOf;
        return v.IsNone ? true
            : (d.Model.Vertices.IsValidIndex(v) ? f.PlacedVertexPoint(d.Map, repair.Source).Coincident(d.Model.Vertices[v.Value].Point, d.Model.Tolerances.Length) : false);
    }

    //==
    // # Orientation folding
    //
    // README, "Orientation folding": the decoder multiplies a face's
    // same_sense and every bound's orientation by the signs of the
    // oriented_face, oriented shell, and mirroring placement above it, so the
    // kernel needs no oriented types. The mirror's sign is the determinant's
    // of the occurrence's placement; layer 1 turns a left-handed surface's
    // normal over with it (PlacementHandedness), so the same fold serves
    // placement-based, swept and spline surfaces alike.

    // Folding preserves the point set of every face: for every bound, the
    // product of the face's and the bound's signs is the raw model's, which is
    // the file's (Law_RawFaceFlagsAreTheFiles). That product decides on which
    // side of each loop the face lies (research/STEP-BREP-MODEL.md 4.2), so
    // the region cut out of the surface is unchanged. PrepareModel keeps face
    // indices, so prepared face k is raw face k.
    Law_FoldPreservesInteriorSide(raw: RawDecodedModel, k: Integer, j: Integer): Boolean
    {
        var d = raw.PrepareModel;
        if (k < 0 || k >= d.Model.Faces.Count || k >= raw.Model.Faces.Count)
        {
            return true;
        }
        var face = d.Model.Faces[k];
        var written = raw.Model.Faces[k];
        return j >= 0 && j < face.Bounds.Count && j < written.Bounds.Count
            ? (face.SameSense == face.Bounds[j].Orientation) == (written.SameSense == written.Bounds[j].Orientation)
            : true;
    }

    // The same, for the decode of a file.
    Law_FoldPreservesInteriorSide(f: Part21File, k: Integer, j: Integer): Boolean
        => Law_FoldPreservesInteriorSide(f.DecodeRaw(DecodePolicy.StandardPolicy), k, j);

    // Folding flips exactly the recorded faces: a face's same_sense differs
    // from the raw model's (the file's) exactly when the map records an odd
    // number of folds for it.
    Law_FoldFlipsExactlyRecorded(raw: RawDecodedModel, k: Integer): Boolean
    {
        var d = raw.PrepareModel;
        return k >= 0 && k < d.Model.Faces.Count && k < raw.Model.Faces.Count
            ? (d.Model.Faces[k].SameSense == raw.Model.Faces[k].SameSense) == !d.Map.IsFolded(BrepFaceIndex(k))
            : true;
    }

    // The same, for the decode of a file.
    Law_FoldFlipsExactlyRecorded(f: Part21File, k: Integer): Boolean
        => Law_FoldFlipsExactlyRecorded(f.DecodeRaw(DecodePolicy.StandardPolicy), k);

    // A face of a mirrored occurrence has exactly one MirroredPlacement fold
    // record, and a face of an unmirrored one none: the occurrence's
    // placement is composed down the assembly before its determinant's sign
    // is taken, so two mirrorings cancel there and are never recorded twice.
    Law_MirrorFoldRecordedOnce(raw: RawDecodedModel, k: Integer): Boolean
    {
        var d = raw.PrepareModel;
        if (k < 0 || k >= d.Model.Faces.Count || k >= d.Map.Sources.Faces.Count)
        {
            return true;
        }
        var mirrors = d.Map.Folds.Reduce(0, (n, r) => r.Face == BrepFaceIndex(k) && r.Cause == FoldCause.MirroredPlacement ? n + 1 : n);
        return mirrors == (d.Map.IsMirroredSource(d.Map.Sources.Faces[k]) ? 1 : 0);
    }

    // The same, for the decode of a file.
    Law_MirrorFoldRecordedOnce(f: Part21File, k: Integer): Boolean
        => Law_MirrorFoldRecordedOnce(f.DecodeRaw(DecodePolicy.StandardPolicy), k);

    // The fold and layer 1's normal agree on the mirror: a face whose
    // surface's placement is left-handed (layer 1's PlacementHandedness is
    // -1) lies in a mirrored occurrence, whose fold turned its sense over. On
    // a left-handed frame layer 1's closed-form normal is multiplied by the
    // handedness, so every surface's kernel normal turns over under a mirror
    // as the cross product of its partials does, and the one fold, sense and
    // bounds times the determinant's sign, is right for every surface family
    // (review F2).
    Law_LeftHandedSurfacesAreFolded(raw: RawDecodedModel, k: Integer): Boolean
    {
        var d = raw.PrepareModel;
        if (k < 0 || k >= d.Model.Faces.Count || k >= d.Map.Sources.Faces.Count)
        {
            return true;
        }
        return d.Model.Geometry.PlacementHandedness(d.Model.Faces[k].Surface) < 0.0
            ? d.Map.IsMirroredSource(d.Map.Sources.Faces[k])
            : true;
    }

    // The same, for the decode of a file.
    Law_LeftHandedSurfacesAreFolded(f: Part21File, k: Integer): Boolean
        => Law_LeftHandedSurfacesAreFolded(f.DecodeRaw(DecodePolicy.StandardPolicy), k);

    // Every fold record names an instance that carries the flip: an
    // oriented_face or oriented shell whose orientation is .F., or an
    // occurrence whose placement is mirrored.
    Law_FoldRecordsNameFalseFlags(f: Part21File, r: Integer): Boolean
    {
        var d = f.DecodeBrep;
        if (r < 0 || r >= d.Map.Folds.Count)
        {
            return true;
        }
        return f.IsJustifiedFold(d.Map, d.Map.Folds[r]);
    }
}

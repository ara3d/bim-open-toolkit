//==
// # The fold as one parity per face (complexity sweep, chunk V8)
//
// Layer 03. FoldParity replaces FoldedFaces in PrepareModelWith: one pass over the fold records
// instead of a count over every record per face, O(F + R) for F faces and R records where
// FoldedFaces is O(F R), and O(F^2) on a mirrored assembly (MirrorFolds gives one record per
// face). The model it reverses is the same (ShellOrientationLaws).
//
// Sections, in order:
//  - Parity

library StepFoldParity
{
    //==
    // # Parity

    // One mark per face of a model with faceCount faces: true when an odd number of the fold
    // records name it, exactly the faces FoldedFaces(folds, faceCount) lists. A record naming a
    // face outside [0, faceCount) marks nothing.
    FoldParity(folds: Array<FoldRecord>, faceCount: Integer): Array<Boolean>
    {
        var odd = new Buffer<Boolean>(faceCount);
        var i = 0;
        while (i < faceCount)
        {
            odd = odd.Set(i, false);
            i = i + 1;
        }
        var k = 0;
        while (k < folds.Count)
        {
            var f = folds[k].Face.Value;
            if (f >= 0 && f < faceCount)
            {
                odd = odd.Set(f, odd.At(f).Not);
            }
            k = k + 1;
        }
        return odd.Freeze();
    }
}

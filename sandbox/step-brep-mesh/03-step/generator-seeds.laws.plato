//==
// # The model-validity laws on every generator seed
//
// The law runner samples 25 cases, so a law over a generated type may never
// see some of the sixteen seeds. These laws run each of TKT-423's laws over
// every seed of the generators (tolerance-generators in layer 0, domain-generators
// in layer 2, check-report-generators and spline-generators here), so a seed that breaks one is
// found whatever the sample.

library V1GeneratorsSeedLaws
{
    // The two curve domain laws on every generated domain, the wrap at five
    // parameters inside, at the ends of, and outside the range.
    Law_DomainLawsOnEverySeed(): Boolean
        => 16.MapRange(s => s.Generate_CurveDomain.Law_ClosedPeriodIsRangeLength
            && [-7.25, 0.0, 0.5, 3.0, 1001.0].All(t => s.Generate_CurveDomain.Law_WrapOnClosedDomainStaysInRange(t))).All(b => b);

    // The two check laws on every generated check.
    Law_CheckLawsOnEverySeed(): Boolean
        => 16.MapRange(s => s.Generate_Check.Law_HoldsExactlyWhenWithinBound && s.Generate_Check.Law_CheckBoundIsNonNegative).All(b => b);

    // Every failed check of every generated report has its diagnostic, at
    // every index a report of at most two checks has.
    Law_ReportLawOnEverySeed(): Boolean
        => 16.MapRange(s => [0, 1, 2].All(k => s.Generate_Report.Law_FailedCheckHasDiagnostic(k))).All(b => b);

    // The six shape laws on every generated space curve.
    Law_BSplineCurveLawsOnEverySeed(): Boolean
        => 16.MapRange(s => s.Generate_BSplineCurveData.Law_BSplineCurveDegreePositive
            && s.Generate_BSplineCurveData.Law_BSplineCurveKnotCount
            && s.Generate_BSplineCurveData.Law_BSplineCurveKnotsNonDecreasing
            && s.Generate_BSplineCurveData.Law_BSplineCurveDomainNonEmpty
            && s.Generate_BSplineCurveData.Law_BSplineCurveWeightCount
            && s.Generate_BSplineCurveData.Law_BSplineCurveWeightsPositive).All(b => b);

    // The six shape laws on every generated parameter-plane curve.
    Law_BSplineCurve2DLawsOnEverySeed(): Boolean
        => 16.MapRange(s => s.Generate_BSplineCurve2DData.Law_BSplineCurve2DDegreePositive
            && s.Generate_BSplineCurve2DData.Law_BSplineCurve2DKnotCount
            && s.Generate_BSplineCurve2DData.Law_BSplineCurve2DKnotsNonDecreasing
            && s.Generate_BSplineCurve2DData.Law_BSplineCurve2DDomainNonEmpty
            && s.Generate_BSplineCurve2DData.Law_BSplineCurve2DWeightCount
            && s.Generate_BSplineCurve2DData.Law_BSplineCurve2DWeightsPositive).All(b => b);
}

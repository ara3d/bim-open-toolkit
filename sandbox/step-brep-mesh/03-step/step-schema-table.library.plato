//==
// # StepSchemaTable
//
// Layer 3 of the STEP B-rep to mesh design. The supported subset of the AP203
// edition 2, AP214 edition 3, and AP242 long-form schemas as one table, from
// the entity catalogue of research/STEP-BREP-MODEL.md section 3, which found
// the Part 21 record of every entity here identical in all three schemas
// except conversion_based_unit.dimensions (derived in AP214, stored in the
// others; the reader accepts both). Every supertype precedes its subtypes
// (Law_SchemaSupertypesPrecede), so the supertype graph is acyclic.
//
// The treatment column is the decode's domain. Decoded entities are read;
// Ignored ones (product data not needed for geometry, presentation, PMI,
// configuration management) are skipped with an Info per type; Unsupported
// ones (tessellated geometry, catalogue entities with no kernel counterpart)
// with a Warning per type, as is every name the table does not list.
// Ignored and Unsupported entries carry no attributes, except where a decoded
// subtype inherits them, and supertypes only where a WHERE rule tests the
// kind. Clause keys: P41, P42, P43 are ISO 10303-41, -42, -43; AIM is the
// AP242 integrated schema; AIC 511 and 514 the interpreted constructs.
//
// Sections, in order:
//  - The table
//  - Bases and contexts
//  - Units
//  - Points, directions, placements, transformations
//  - Curves
//  - Surfaces
//  - Curves on surfaces
//  - Topology
//  - Solids and surface models
//  - Representations
//  - Product structure that places shapes
//  - Ignored
//  - Unsupported

library StepSchemaTable
{
    //==
    // # The table

    // Every entity of the supported subset, supertypes first. The receiver is
    // a type token: write Part21File.SupportedSchema or f.SupportedSchema.
    SupportedSchema(_: Part21File): Array<EntityDefinition>
        => Part21File.BaseEntities
            .Concatenate(Part21File.UnitEntities)
            .Concatenate(Part21File.PlacementEntities)
            .Concatenate(Part21File.CurveEntities)
            .Concatenate(Part21File.SurfaceEntities)
            .Concatenate(Part21File.CurveOnSurfaceEntities)
            .Concatenate(Part21File.TopologyEntities)
            .Concatenate(Part21File.SolidEntities)
            .Concatenate(Part21File.RepresentationEntities)
            .Concatenate(Part21File.ProductEntities)
            .Concatenate(Part21File.IgnoredEntities)
            .Concatenate(Part21File.UnsupportedEntities);

    //==
    // # Bases and contexts

    // The abstract roots every item descends from, and the representation
    // contexts that carry units and uncertainty.
    BaseEntities(_: Part21File): Array<EntityDefinition>
    {
        var text = AttributeKind.StringKind;
        var whole = AttributeKind.IntegerKind;
        return [
            DecodedEntity("REPRESENTATION_ITEM", "RPRITM", "P43 4.4.15", [], [Attr("name", text)]),
            DecodedEntity("GEOMETRIC_REPRESENTATION_ITEM", "GMRPIT", "P42 4.5.2", ["REPRESENTATION_ITEM"], []),
            DecodedEntity("TOPOLOGICAL_REPRESENTATION_ITEM", "TPRPIT", "P42 5.5.1", ["REPRESENTATION_ITEM"], []),
            DecodedEntity("FOUNDED_ITEM", "", "P43", [], []),
            DecodedEntity("REPRESENTATION_CONTEXT", "RPRCNT", "P43 4.4.14", [], [Attr("context_identifier", text), Attr("context_type", text)]),
            DecodedEntity("GEOMETRIC_REPRESENTATION_CONTEXT", "GMRPCN", "P42 4.5.1", ["REPRESENTATION_CONTEXT"], [AttrRuled("coordinate_space_dimension", whole, ValueRule.PositiveValue)]),
            DecodedEntity("PARAMETRIC_REPRESENTATION_CONTEXT", "PRRPCN", "P43 4.4.12", ["REPRESENTATION_CONTEXT"], []),
            DecodedEntity("GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT", "GC", "P43 4.4.9", ["REPRESENTATION_CONTEXT"], [AttrSet("uncertainty", RefTo(["UNCERTAINTY_MEASURE_WITH_UNIT"]), 1, -1)]),
            DecodedEntity("GLOBAL_UNIT_ASSIGNED_CONTEXT", "GUAC", "P41", ["REPRESENTATION_CONTEXT"], [AttrSet("units", AttributeKind.SelectKind(["DERIVED_UNIT", "NAMED_UNIT"], []), 1, -1)])
        ];
    }

    //==
    // # Units

    // Named units (a kind such as length_unit combined with a definition such
    // as si_unit, always a complex instance) and measures with units.
    UnitEntities(_: Part21File): Array<EntityDefinition>
    {
        var text = AttributeKind.StringKind;
        var real = AttributeKind.RealKind;
        var prefixes = AttributeKind.EnumerationKind(["EXA", "PETA", "TERA", "GIGA", "MEGA", "KILO", "HECTO", "DECA", "DECI", "CENTI", "MILLI", "MICRO", "NANO", "PICO", "FEMTO", "ATTO"]);
        var names = AttributeKind.EnumerationKind(["METRE", "GRAM", "SECOND", "AMPERE", "KELVIN", "MOLE", "CANDELA", "RADIAN", "STERADIAN", "HERTZ", "NEWTON", "PASCAL", "JOULE", "WATT", "COULOMB", "VOLT", "FARAD", "OHM", "SIEMENS", "WEBER", "TESLA", "HENRY", "DEGREE_CELSIUS", "LUMEN", "LUX", "BECQUEREL", "GRAY", "SIEVERT"]);
        var measures = AttributeKind.SelectKind([], ["LENGTH_MEASURE", "POSITIVE_LENGTH_MEASURE", "PLANE_ANGLE_MEASURE", "POSITIVE_PLANE_ANGLE_MEASURE", "SOLID_ANGLE_MEASURE", "RATIO_MEASURE", "POSITIVE_RATIO_MEASURE", "PARAMETER_VALUE", "COUNT_MEASURE", "AREA_MEASURE", "VOLUME_MEASURE", "MASS_MEASURE", "DESCRIPTIVE_MEASURE"]);
        var units = AttributeKind.SelectKind(["DERIVED_UNIT", "NAMED_UNIT"], []);
        return [
            DecodedEntity("DIMENSIONAL_EXPONENTS", "DMNEXP", "P41", [], [Attr("length_exponent", real), Attr("mass_exponent", real), Attr("time_exponent", real), Attr("electric_current_exponent", real), Attr("thermodynamic_temperature_exponent", real), Attr("amount_of_substance_exponent", real), Attr("luminous_intensity_exponent", real)]),
            DecodedEntity("NAMED_UNIT", "NMDUNT", "P41", [], [Attr("dimensions", RefTo(["DIMENSIONAL_EXPONENTS"]))]),
            EntityDefinition("SI_UNIT", "SUNT", "P41", ["NAMED_UNIT"], [AttrOptional("prefix", prefixes), Attr("name", names)], ["dimensions"], EntityTreatment.Decoded),
            DecodedEntity("CONVERSION_BASED_UNIT", "CNBSUN", "P41", ["NAMED_UNIT"], [Attr("name", text), Attr("conversion_factor", RefTo(["MEASURE_WITH_UNIT"]))]),
            DecodedEntity("LENGTH_UNIT", "LNGUNT", "P41", ["NAMED_UNIT"], []),
            DecodedEntity("PLANE_ANGLE_UNIT", "PLANUN", "P41", ["NAMED_UNIT"], []),
            DecodedEntity("SOLID_ANGLE_UNIT", "SLANUN", "P41", ["NAMED_UNIT"], []),
            DecodedEntity("MEASURE_WITH_UNIT", "MSWTUN", "P41", [], [Attr("value_component", measures), Attr("unit_component", units)]),
            DecodedEntity("LENGTH_MEASURE_WITH_UNIT", "LMWU", "P41", ["MEASURE_WITH_UNIT"], []),
            DecodedEntity("PLANE_ANGLE_MEASURE_WITH_UNIT", "PAMWU", "P41", ["MEASURE_WITH_UNIT"], []),
            DecodedEntity("UNCERTAINTY_MEASURE_WITH_UNIT", "UMWU", "P43 4.4.23", ["MEASURE_WITH_UNIT"], [Attr("name", text), AttrOptional("description", text)])
        ];
    }

    //==
    // # Points, directions, placements, transformations

    // The point and frame vocabulary; decoded into Point3D, Direction3D,
    // Vector3D, Frame3D and AffineTransform3D values, not into tables.
    PlacementEntities(_: Part21File): Array<EntityDefinition>
    {
        var text = AttributeKind.StringKind;
        var real = AttributeKind.RealKind;
        var direction = RefTo(["DIRECTION"]);
        var point = RefTo(["CARTESIAN_POINT"]);
        return [
            DecodedEntity("POINT", "", "P42 4.5", ["GEOMETRIC_REPRESENTATION_ITEM"], []),
            DecodedEntity("CARTESIAN_POINT", "CRTPNT", "P42 4.5.4", ["POINT"], [AttrList("coordinates", real, 1, 3)]),
            DecodedEntity("DIRECTION", "DRCTN", "P42 4.5.14", ["GEOMETRIC_REPRESENTATION_ITEM"], [AttrList("direction_ratios", real, 2, 3)]),
            DecodedEntity("VECTOR", "VECTOR", "P42 4.5.15", ["GEOMETRIC_REPRESENTATION_ITEM"], [Attr("orientation", direction), Attr("magnitude", real)]),
            DecodedEntity("PLACEMENT", "PLCMNT", "P42 4.5.16", ["GEOMETRIC_REPRESENTATION_ITEM"], [Attr("location", point)]),
            DecodedEntity("AXIS1_PLACEMENT", "AX1PLC", "P42 4.5.17", ["PLACEMENT"], [AttrOptional("axis", direction)]),
            DecodedEntity("AXIS2_PLACEMENT_2D", "A2PL2D", "P42 4.5.18", ["PLACEMENT"], [AttrOptional("ref_direction", direction)]),
            DecodedEntity("AXIS2_PLACEMENT_3D", "A2PL3D", "P42 4.5.19", ["PLACEMENT"], [AttrOptional("axis", direction), AttrOptional("ref_direction", direction)]),
            DecodedEntity("FUNCTIONALLY_DEFINED_TRANSFORMATION", "", "P43", [], [Attr("name", text), AttrOptional("description", text)]),
            DecodedEntity("CARTESIAN_TRANSFORMATION_OPERATOR", "", "P42 4.5.20", ["GEOMETRIC_REPRESENTATION_ITEM", "FUNCTIONALLY_DEFINED_TRANSFORMATION"], [AttrOptional("axis1", direction), AttrOptional("axis2", direction), Attr("local_origin", point), AttrOptional("scale", real)]),
            DecodedEntity("CARTESIAN_TRANSFORMATION_OPERATOR_3D", "CTO3", "P42 4.5.21", ["CARTESIAN_TRANSFORMATION_OPERATOR"], [AttrOptional("axis3", direction)])
        ];
    }

    //==
    // # Curves

    // Model-space and parameter-space curves; each instance reached becomes
    // one BrepCurve or BrepCurve2D (layer 1).
    CurveEntities(_: Part21File): Array<EntityDefinition>
    {
        var real = AttributeKind.RealKind;
        var whole = AttributeKind.IntegerKind;
        var flag = AttributeKind.BooleanKind;
        var logical = AttributeKind.LogicalKind;
        var point = RefTo(["CARTESIAN_POINT"]);
        var positive = ValueRule.PositiveValue;
        var curveForm = AttributeKind.EnumerationKind(["POLYLINE_FORM", "CIRCULAR_ARC", "ELLIPTIC_ARC", "PARABOLIC_ARC", "HYPERBOLIC_ARC", "UNSPECIFIED"]);
        var knotType = AttributeKind.EnumerationKind(["UNIFORM_KNOTS", "QUASI_UNIFORM_KNOTS", "PIECEWISE_BEZIER_KNOTS", "UNSPECIFIED"]);
        var trim = AttributeKind.SelectKind(["CARTESIAN_POINT"], ["PARAMETER_VALUE"]);
        var transition = AttributeKind.EnumerationKind(["DISCONTINUOUS", "CONTINUOUS", "CONT_SAME_GRADIENT", "CONT_SAME_GRADIENT_SAME_CURVATURE"]);
        return [
            DecodedEntity("CURVE", "CURVE", "P42 4.5.23", ["GEOMETRIC_REPRESENTATION_ITEM"], []),
            DecodedEntity("BOUNDED_CURVE", "BNDCRV", "P42 4.5.32", ["CURVE"], []),
            DecodedEntity("LINE", "LINE", "P42 4.5.24", ["CURVE"], [Attr("pnt", point), Attr("dir", RefTo(["VECTOR"]))]),
            DecodedEntity("CONIC", "CONIC", "P42 4.5.25", ["CURVE"], [Attr("position", AttributeKind.SelectKind(["AXIS2_PLACEMENT_2D", "AXIS2_PLACEMENT_3D"], []))]),
            DecodedEntity("CIRCLE", "CIRCLE", "P42 4.5.26", ["CONIC"], [AttrRuled("radius", real, positive)]),
            DecodedEntity("ELLIPSE", "ELLPS", "P42 4.5.27", ["CONIC"], [AttrRuled("semi_axis_1", real, positive), AttrRuled("semi_axis_2", real, positive)]),
            DecodedEntity("HYPERBOLA", "HYPRBL", "P42 4.5.28", ["CONIC"], [AttrRuled("semi_axis", real, positive), AttrRuled("semi_imag_axis", real, positive)]),
            DecodedEntity("PARABOLA", "PRBL", "P42 4.5.29", ["CONIC"], [Attr("focal_dist", real)]),
            DecodedEntity("POLYLINE", "PLYLN", "P42 4.5.33", ["BOUNDED_CURVE"], [AttrList("points", point, 2, -1)]),
            DecodedEntity("B_SPLINE_CURVE", "BSPCR", "P42 4.5.34", ["BOUNDED_CURVE"], [Attr("degree", whole), AttrList("control_points_list", point, 2, -1), Attr("curve_form", curveForm), Attr("closed_curve", logical), Attr("self_intersect", logical)]),
            DecodedEntity("B_SPLINE_CURVE_WITH_KNOTS", "BSCWK", "P42 4.5.35", ["B_SPLINE_CURVE"], [AttrList("knot_multiplicities", whole, 2, -1), AttrList("knots", real, 2, -1), Attr("knot_spec", knotType)]),
            DecodedEntity("UNIFORM_CURVE", "UNFCRV", "P42 4.5.36", ["B_SPLINE_CURVE"], []),
            DecodedEntity("QUASI_UNIFORM_CURVE", "QSUNCR", "P42 4.5.37", ["B_SPLINE_CURVE"], []),
            DecodedEntity("BEZIER_CURVE", "BZRCRV", "P42 4.5.38", ["B_SPLINE_CURVE"], []),
            DecodedEntity("RATIONAL_B_SPLINE_CURVE", "RBSC", "P42 4.5.39", ["B_SPLINE_CURVE"], [AttrList("weights_data", real, 2, -1)]),
            DecodedEntity("TRIMMED_CURVE", "TRMCRV", "P42 4.5.43", ["BOUNDED_CURVE"], [Attr("basis_curve", RefTo(["CURVE"])), AttrSet("trim_1", trim, 1, 2), AttrSet("trim_2", trim, 1, 2), Attr("sense_agreement", flag), Attr("master_representation", AttributeKind.EnumerationKind(["CARTESIAN", "PARAMETER", "UNSPECIFIED"]))]),
            DecodedEntity("COMPOSITE_CURVE_SEGMENT", "CMCRSG", "P42 4.5.45", ["FOUNDED_ITEM"], [Attr("transition", transition), Attr("same_sense", flag), Attr("parent_curve", RefTo(["CURVE"]))]),
            DecodedEntity("REPARAMETRISED_COMPOSITE_CURVE_SEGMENT", "", "P42 4.5.46", ["COMPOSITE_CURVE_SEGMENT"], [Attr("param_length", real)]),
            DecodedEntity("COMPOSITE_CURVE", "CMPCRV", "P42 4.5.44", ["BOUNDED_CURVE"], [AttrList("segments", RefTo(["COMPOSITE_CURVE_SEGMENT"]), 1, -1), Attr("self_intersect", logical)]),
            DecodedEntity("OFFSET_CURVE_3D", "OFCR3D", "P42 4.5.55", ["CURVE"], [Attr("basis_curve", RefTo(["CURVE"])), Attr("distance", real), Attr("self_intersect", logical), Attr("ref_direction", RefTo(["DIRECTION"]))])
        ];
    }

    //==
    // # Surfaces

    // Surfaces; each instance reached becomes one BrepSurface (layer 1).
    SurfaceEntities(_: Part21File): Array<EntityDefinition>
    {
        var real = AttributeKind.RealKind;
        var whole = AttributeKind.IntegerKind;
        var flag = AttributeKind.BooleanKind;
        var logical = AttributeKind.LogicalKind;
        var positive = ValueRule.PositiveValue;
        var surface = RefTo(["SURFACE"]);
        var surfaceForm = AttributeKind.EnumerationKind(["PLANE_SURF", "CYLINDRICAL_SURF", "CONICAL_SURF", "SPHERICAL_SURF", "TOROIDAL_SURF", "SURF_OF_REVOLUTION", "RULED_SURF", "GENERALISED_CONE", "QUADRIC_SURF", "SURF_OF_LINEAR_EXTRUSION", "UNSPECIFIED"]);
        var knotType = AttributeKind.EnumerationKind(["UNIFORM_KNOTS", "QUASI_UNIFORM_KNOTS", "PIECEWISE_BEZIER_KNOTS", "UNSPECIFIED"]);
        return [
            DecodedEntity("SURFACE", "SRFC", "P42 4.5.57", ["GEOMETRIC_REPRESENTATION_ITEM"], []),
            DecodedEntity("ELEMENTARY_SURFACE", "ELMSRF", "P42 4.5.58", ["SURFACE"], [Attr("position", RefTo(["AXIS2_PLACEMENT_3D"]))]),
            DecodedEntity("PLANE", "PLANE", "P42 4.5.59", ["ELEMENTARY_SURFACE"], []),
            DecodedEntity("CYLINDRICAL_SURFACE", "CYLSRF", "P42 4.5.60", ["ELEMENTARY_SURFACE"], [AttrRuled("radius", real, positive)]),
            DecodedEntity("CONICAL_SURFACE", "CNCSRF", "P42 4.5.61", ["ELEMENTARY_SURFACE"], [Attr("radius", real), Attr("semi_angle", real)]),
            DecodedEntity("SPHERICAL_SURFACE", "SPHSRF", "P42 4.5.62", ["ELEMENTARY_SURFACE"], [AttrRuled("radius", real, positive)]),
            DecodedEntity("TOROIDAL_SURFACE", "TRDSRF", "P42 4.5.63", ["ELEMENTARY_SURFACE"], [AttrRuled("major_radius", real, positive), AttrRuled("minor_radius", real, positive)]),
            DecodedEntity("DEGENERATE_TOROIDAL_SURFACE", "DGTRSR", "P42 4.5.64", ["TOROIDAL_SURFACE"], [Attr("select_outer", flag)]),
            DecodedEntity("SWEPT_SURFACE", "SWPSRF", "P42 4.5.66", ["SURFACE"], [Attr("swept_curve", RefTo(["CURVE"]))]),
            DecodedEntity("SURFACE_OF_LINEAR_EXTRUSION", "SL", "P42 4.5.67", ["SWEPT_SURFACE"], [Attr("extrusion_axis", RefTo(["VECTOR"]))]),
            DecodedEntity("SURFACE_OF_REVOLUTION", "SROFRV", "P42 4.5.68", ["SWEPT_SURFACE"], [Attr("axis_position", RefTo(["AXIS1_PLACEMENT"]))]),
            DecodedEntity("BOUNDED_SURFACE", "BNDSRF", "P42 4.5.71", ["SURFACE"], []),
            DecodedEntity("B_SPLINE_SURFACE", "BSPSR", "P42 4.5.72", ["BOUNDED_SURFACE"], [Attr("u_degree", whole), Attr("v_degree", whole), AttrListOfList("control_points_list", RefTo(["CARTESIAN_POINT"]), 2, -1), Attr("surface_form", surfaceForm), Attr("u_closed", logical), Attr("v_closed", logical), Attr("self_intersect", logical)]),
            DecodedEntity("B_SPLINE_SURFACE_WITH_KNOTS", "BSSWK", "P42 4.5.73", ["B_SPLINE_SURFACE"], [AttrList("u_multiplicities", whole, 2, -1), AttrList("v_multiplicities", whole, 2, -1), AttrList("u_knots", real, 2, -1), AttrList("v_knots", real, 2, -1), Attr("knot_spec", knotType)]),
            DecodedEntity("UNIFORM_SURFACE", "UNFSRF", "P42 4.5.74", ["B_SPLINE_SURFACE"], []),
            DecodedEntity("QUASI_UNIFORM_SURFACE", "QSUNSR", "P42 4.5.75", ["B_SPLINE_SURFACE"], []),
            DecodedEntity("BEZIER_SURFACE", "BZRSRF", "P42 4.5.76", ["B_SPLINE_SURFACE"], []),
            DecodedEntity("RATIONAL_B_SPLINE_SURFACE", "RBSS", "P42 4.5.77", ["B_SPLINE_SURFACE"], [AttrListOfList("weights_data", real, 2, -1)]),
            DecodedEntity("RECTANGULAR_TRIMMED_SURFACE", "RCTRSR", "P42 4.5.80", ["BOUNDED_SURFACE"], [Attr("basis_surface", surface), Attr("u1", real), Attr("u2", real), Attr("v1", real), Attr("v2", real), Attr("usense", flag), Attr("vsense", flag)]),
            DecodedEntity("OFFSET_SURFACE", "OFFSRF", "P42 4.5.86", ["SURFACE"], [Attr("basis_surface", surface), Attr("distance", real), Attr("self_intersect", logical)])
        ];
    }

    //==
    // # Curves on surfaces

    // Pcurves (each reached instance one Pcurve, its 2D curve one BrepCurve2D)
    // and surface curves (each one BrepCurve.OnSurface).
    CurveOnSurfaceEntities(_: Part21File): Array<EntityDefinition>
    {
        var surface = RefTo(["SURFACE"]);
        var master = AttributeKind.EnumerationKind(["CURVE_3D", "PCURVE_S1", "PCURVE_S2"]);
        return [
            DecodedEntity("PCURVE", "PCURVE", "P42 4.5.47", ["CURVE"], [Attr("basis_surface", surface), Attr("reference_to_curve", RefTo(["DEFINITIONAL_REPRESENTATION"]))]),
            DecodedEntity("BOUNDED_PCURVE", "BNDPCR", "P42 4.5.48", ["PCURVE", "BOUNDED_CURVE"], []),
            DecodedEntity("SURFACE_CURVE", "SRFCRV", "P42 4.5.49", ["CURVE"], [Attr("curve_3d", RefTo(["CURVE"])), AttrList("associated_geometry", AttributeKind.SelectKind(["PCURVE", "SURFACE"], []), 1, 2), Attr("master_representation", master)]),
            DecodedEntity("SEAM_CURVE", "SMCRV", "P42 4.5.51", ["SURFACE_CURVE"], []),
            DecodedEntity("INTERSECTION_CURVE", "INTCRV", "P42 4.5.50", ["SURFACE_CURVE"], []),
            DecodedEntity("BOUNDED_SURFACE_CURVE", "BNSRCR", "P42 4.5.52", ["SURFACE_CURVE", "BOUNDED_CURVE"], [])
        ];
    }

    //==
    // # Topology

    // Vertices, edges, loops, faces, shells; the oriented forms are folded
    // into the flags of the kernel types they wrap (README, "Orientation
    // folding").
    TopologyEntities(_: Part21File): Array<EntityDefinition>
    {
        var flag = AttributeKind.BooleanKind;
        var vertex = RefTo(["VERTEX"]);
        return [
            DecodedEntity("VERTEX", "VERTEX", "P42 5.5.2", ["TOPOLOGICAL_REPRESENTATION_ITEM"], []),
            DecodedEntity("VERTEX_POINT", "VRTPNT", "P42 5.5.3", ["VERTEX", "GEOMETRIC_REPRESENTATION_ITEM"], [Attr("vertex_geometry", RefTo(["POINT"]))]),
            DecodedEntity("EDGE", "EDGE", "P42 5.5.4", ["TOPOLOGICAL_REPRESENTATION_ITEM"], [Attr("edge_start", vertex), Attr("edge_end", vertex)]),
            DecodedEntity("EDGE_CURVE", "EDGCRV", "P42 5.5.5", ["EDGE", "GEOMETRIC_REPRESENTATION_ITEM"], [Attr("edge_geometry", RefTo(["CURVE"])), Attr("same_sense", flag)]),
            EntityDefinition("ORIENTED_EDGE", "ORNEDG", "P42 5.5.6", ["EDGE"], [Attr("edge_element", RefTo(["EDGE"])), Attr("orientation", flag)], ["edge_start", "edge_end"], EntityTreatment.Decoded),
            DecodedEntity("SEAM_EDGE", "", "P42 5.5.7", ["ORIENTED_EDGE"], [Attr("pcurve_reference", RefTo(["PCURVE"]))]),
            DecodedEntity("PATH", "PATH", "P42 5.5.9", ["TOPOLOGICAL_REPRESENTATION_ITEM"], [AttrUniqueList("edge_list", RefTo(["ORIENTED_EDGE"]), 1, -1)]),
            DecodedEntity("LOOP", "LOOP", "P42 5.5.13", ["TOPOLOGICAL_REPRESENTATION_ITEM"], []),
            DecodedEntity("EDGE_LOOP", "EDGLP", "P42 5.5.15", ["LOOP", "PATH"], []),
            DecodedEntity("VERTEX_LOOP", "VRTLP", "P42 5.5.14", ["LOOP"], [Attr("loop_vertex", vertex)]),
            DecodedEntity("POLY_LOOP", "PLYLP", "P42 5.5.16", ["LOOP", "GEOMETRIC_REPRESENTATION_ITEM"], [AttrUniqueList("polygon", RefTo(["CARTESIAN_POINT"]), 3, -1)]),
            DecodedEntity("FACE_BOUND", "FCBND", "P42 5.5.17", ["TOPOLOGICAL_REPRESENTATION_ITEM"], [Attr("bound", RefTo(["LOOP"])), Attr("orientation", flag)]),
            DecodedEntity("FACE_OUTER_BOUND", "FCOTBN", "P42 5.5.18", ["FACE_BOUND"], []),
            DecodedEntity("FACE", "FACE", "P42 5.5.19", ["TOPOLOGICAL_REPRESENTATION_ITEM"], [AttrSet("bounds", RefTo(["FACE_BOUND"]), 1, -1)]),
            DecodedEntity("FACE_SURFACE", "FCSRF", "P42 5.5.20", ["FACE", "GEOMETRIC_REPRESENTATION_ITEM"], [Attr("face_geometry", RefTo(["SURFACE"])), Attr("same_sense", flag)]),
            DecodedEntity("ADVANCED_FACE", "ADVFC", "AIC 511", ["FACE_SURFACE"], []),
            EntityDefinition("ORIENTED_FACE", "ORNFC", "P42 5.5.21", ["FACE"], [Attr("face_element", RefTo(["FACE"])), Attr("orientation", flag)], ["bounds"], EntityTreatment.Decoded),
            DecodedEntity("CONNECTED_FACE_SET", "CNFCST", "P42 5.5.23", ["TOPOLOGICAL_REPRESENTATION_ITEM"], [AttrSet("cfs_faces", RefTo(["FACE"]), 1, -1)]),
            DecodedEntity("OPEN_SHELL", "OPNSHL", "P42 5.5.26", ["CONNECTED_FACE_SET"], []),
            DecodedEntity("CLOSED_SHELL", "CLSSHL", "P42 5.5.28", ["CONNECTED_FACE_SET"], []),
            EntityDefinition("ORIENTED_OPEN_SHELL", "OROPSH", "P42 5.5.27", ["OPEN_SHELL"], [Attr("open_shell_element", RefTo(["OPEN_SHELL"])), Attr("orientation", flag)], ["cfs_faces"], EntityTreatment.Decoded),
            EntityDefinition("ORIENTED_CLOSED_SHELL", "ORCLSH", "P42 5.5.29", ["CLOSED_SHELL"], [Attr("closed_shell_element", RefTo(["CLOSED_SHELL"])), Attr("orientation", flag)], ["cfs_faces"], EntityTreatment.Decoded)
        ];
    }

    //==
    // # Solids and surface models

    // The items a B-rep-bearing representation holds; each reached instance
    // becomes one BrepBody.
    SolidEntities(_: Part21File): Array<EntityDefinition>
        => [
            DecodedEntity("SOLID_MODEL", "SLDMDL", "P42 6.4.1", ["GEOMETRIC_REPRESENTATION_ITEM"], []),
            DecodedEntity("MANIFOLD_SOLID_BREP", "MNSLBR", "P42 6.4.2", ["SOLID_MODEL"], [Attr("outer", RefTo(["CLOSED_SHELL"]))]),
            DecodedEntity("BREP_WITH_VOIDS", "BRWTVD", "P42 6.4.3", ["MANIFOLD_SOLID_BREP"], [AttrSet("voids", RefTo(["ORIENTED_CLOSED_SHELL"]), 1, -1)]),
            DecodedEntity("FACETED_BREP", "FCTBR", "P42 6.4.4", ["MANIFOLD_SOLID_BREP"], []),
            DecodedEntity("SHELL_BASED_SURFACE_MODEL", "SBSM", "P42 6.4.44", ["GEOMETRIC_REPRESENTATION_ITEM"], [AttrSet("sbsm_boundary", AttributeKind.SelectKind(["VERTEX_SHELL", "WIRE_SHELL", "OPEN_SHELL", "CLOSED_SHELL"], []), 1, -1)])
        ];

    //==
    // # Representations

    // Representations that hold shapes or define pcurves, the relationships
    // between them, and mapped items.
    RepresentationEntities(_: Part21File): Array<EntityDefinition>
    {
        var text = AttributeKind.StringKind;
        var item = RefTo(["REPRESENTATION_ITEM"]);
        var representation = RefTo(["REPRESENTATION"]);
        return [
            DecodedEntity("REPRESENTATION", "RPRSNT", "P43 4.4.13", [], [Attr("name", text), AttrSet("items", item, 1, -1), Attr("context_of_items", RefTo(["REPRESENTATION_CONTEXT"]))]),
            DecodedEntity("SHAPE_REPRESENTATION", "SHPRPR", "AIM", ["REPRESENTATION"], []),
            DecodedEntity("DEFINITIONAL_REPRESENTATION", "DFNRPR", "P43 4.4.4", ["REPRESENTATION"], []),
            DecodedEntity("ADVANCED_BREP_SHAPE_REPRESENTATION", "ABSR", "AIC 514", ["SHAPE_REPRESENTATION"], []),
            DecodedEntity("MANIFOLD_SURFACE_SHAPE_REPRESENTATION", "MSSR", "AIM", ["SHAPE_REPRESENTATION"], []),
            DecodedEntity("FACETED_BREP_SHAPE_REPRESENTATION", "FBSR", "AIM", ["SHAPE_REPRESENTATION"], []),
            DecodedEntity("REPRESENTATION_RELATIONSHIP", "RPRRLT", "P43", [], [Attr("name", text), AttrOptional("description", text), Attr("rep_1", representation), Attr("rep_2", representation)]),
            DecodedEntity("SHAPE_REPRESENTATION_RELATIONSHIP", "SHRPRL", "AIM", ["REPRESENTATION_RELATIONSHIP"], []),
            DecodedEntity("REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION", "RRWT", "P43 4.4.21", ["REPRESENTATION_RELATIONSHIP"], [Attr("transformation_operator", AttributeKind.SelectKind(["ITEM_DEFINED_TRANSFORMATION", "FUNCTIONALLY_DEFINED_TRANSFORMATION"], []))]),
            DecodedEntity("ITEM_DEFINED_TRANSFORMATION", "ITDFTR", "P43 4.4.10", [], [Attr("name", text), AttrOptional("description", text), Attr("transform_item_1", item), Attr("transform_item_2", item)]),
            DecodedEntity("REPRESENTATION_MAP", "RPRMP", "P43 4.4.18", [], [Attr("mapping_origin", item), Attr("mapped_representation", representation)]),
            DecodedEntity("MAPPED_ITEM", "MPPITM", "P43 4.4.11", ["REPRESENTATION_ITEM"], [Attr("mapping_source", RefTo(["REPRESENTATION_MAP"])), Attr("mapping_target", item)])
        ];
    }

    //==
    // # Product structure that places shapes

    // The entities that lead from an assembly occurrence to the placement of a
    // component's shape (PDMUG 4.4). Their supertypes are Ignored on their
    // own (a bare property_definition is a property, not a shape) but keep
    // their attributes, which the decoded subtypes inherit.
    ProductEntities(_: Part21File): Array<EntityDefinition>
    {
        var text = AttributeKind.StringKind;
        var definition = AttributeKind.SelectKind(["PRODUCT_DEFINITION"], []);
        return [
            DecodedEntity("PRODUCT_DEFINITION", "PRDDFN", "AIM", [], [Attr("id", text), AttrOptional("description", text), Attr("formation", RefTo(["PRODUCT_DEFINITION_FORMATION"])), Attr("frame_of_reference", RefTo(["PRODUCT_DEFINITION_CONTEXT"]))]),
            EntityDefinition("PROPERTY_DEFINITION", "PRPDFN", "AIM", [], [Attr("name", text), AttrOptional("description", text), Attr("definition", AttributeKind.SelectKind(["PRODUCT_DEFINITION", "PRODUCT_DEFINITION_RELATIONSHIP", "SHAPE_ASPECT"], []))], [], EntityTreatment.Ignored),
            DecodedEntity("PRODUCT_DEFINITION_SHAPE", "PRDFSH", "AIM", ["PROPERTY_DEFINITION"], []),
            EntityDefinition("PROPERTY_DEFINITION_REPRESENTATION", "", "AIM", [], [Attr("definition", AttributeKind.SelectKind(["PROPERTY_DEFINITION"], [])), Attr("used_representation", RefTo(["REPRESENTATION"]))], [], EntityTreatment.Ignored),
            DecodedEntity("SHAPE_DEFINITION_REPRESENTATION", "SHDFRP", "AIM", ["PROPERTY_DEFINITION_REPRESENTATION"], []),
            EntityDefinition("PRODUCT_DEFINITION_RELATIONSHIP", "", "AIM", [], [Attr("id", text), Attr("name", text), AttrOptional("description", text), Attr("relating_product_definition", definition), Attr("related_product_definition", definition)], [], EntityTreatment.Ignored),
            EntityDefinition("PRODUCT_DEFINITION_USAGE", "", "AIM", ["PRODUCT_DEFINITION_RELATIONSHIP"], [], [], EntityTreatment.Ignored),
            EntityDefinition("ASSEMBLY_COMPONENT_USAGE", "", "AIM", ["PRODUCT_DEFINITION_USAGE"], [AttrOptional("reference_designator", text)], [], EntityTreatment.Ignored),
            DecodedEntity("NEXT_ASSEMBLY_USAGE_OCCURRENCE", "NAUO", "AIM", ["ASSEMBLY_COMPONENT_USAGE"], []),
            DecodedEntity("CONTEXT_DEPENDENT_SHAPE_REPRESENTATION", "CDSR", "AIM", [], [Attr("representation_relation", RefTo(["SHAPE_REPRESENTATION_RELATIONSHIP"])), Attr("represented_product_relation", RefTo(["PRODUCT_DEFINITION_SHAPE"]))])
        ];
    }

    //==
    // # Ignored

    // Product data the geometry does not need, presentation (styles, colours,
    // layers), PMI and properties, and AP203 configuration management: one
    // Info diagnostic per type. Supertypes are kept only where a decoded
    // reference names the supertype.
    IgnoredEntities(_: Part21File): Array<EntityDefinition>
        => [
            IgnoredEntity("PRODUCT", "PRDCT", "AIM"),
            IgnoredEntity("PRODUCT_DEFINITION_FORMATION", "PRDFFR", "AIM"),
            EntityDefinition("PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE", "", "AIM", ["PRODUCT_DEFINITION_FORMATION"], [], [], EntityTreatment.Ignored),
            IgnoredEntity("PRODUCT_DEFINITION_CONTEXT", "", "AIM"),
            EntityDefinition("DESIGN_CONTEXT", "", "AIM", ["PRODUCT_DEFINITION_CONTEXT"], [], [], EntityTreatment.Ignored),
            IgnoredEntity("PRODUCT_CONTEXT", "", "AIM"),
            EntityDefinition("MECHANICAL_CONTEXT", "", "AIM", ["PRODUCT_CONTEXT"], [], [], EntityTreatment.Ignored),
            IgnoredEntity("APPLICATION_CONTEXT", "", "AIM"),
            IgnoredEntity("APPLICATION_PROTOCOL_DEFINITION", "", "AIM"),
            IgnoredEntity("PRODUCT_CATEGORY", "", "AIM"),
            IgnoredEntity("PRODUCT_RELATED_PRODUCT_CATEGORY", "", "AIM"),
            IgnoredEntity("PRODUCT_CATEGORY_RELATIONSHIP", "", "AIM"),
            IgnoredEntity("STYLED_ITEM", "", "AIM"),
            IgnoredEntity("OVER_RIDING_STYLED_ITEM", "", "AIM"),
            IgnoredEntity("PRESENTATION_STYLE_ASSIGNMENT", "", "AIM"),
            IgnoredEntity("SURFACE_STYLE_USAGE", "", "AIM"),
            IgnoredEntity("SURFACE_SIDE_STYLE", "", "AIM"),
            IgnoredEntity("SURFACE_STYLE_FILL_AREA", "", "AIM"),
            IgnoredEntity("FILL_AREA_STYLE", "", "AIM"),
            IgnoredEntity("FILL_AREA_STYLE_COLOUR", "", "AIM"),
            IgnoredEntity("COLOUR_RGB", "", "AIM"),
            IgnoredEntity("DRAUGHTING_PRE_DEFINED_COLOUR", "", "AIM"),
            IgnoredEntity("CURVE_STYLE", "", "AIM"),
            IgnoredEntity("DRAUGHTING_PRE_DEFINED_CURVE_FONT", "", "AIM"),
            IgnoredEntity("MECHANICAL_DESIGN_GEOMETRIC_PRESENTATION_REPRESENTATION", "", "AIM"),
            IgnoredEntity("PRESENTATION_LAYER_ASSIGNMENT", "", "AIM"),
            IgnoredEntity("INVISIBILITY", "", "AIM"),
            IgnoredEntity("SHAPE_ASPECT", "", "AIM"),
            IgnoredEntity("MEASURE_REPRESENTATION_ITEM", "", "AIM"),
            IgnoredEntity("DESCRIPTIVE_REPRESENTATION_ITEM", "", "AIM"),
            IgnoredEntity("VALUE_REPRESENTATION_ITEM", "", "AIM"),
            IgnoredEntity("DATUM", "", "AIM"),
            IgnoredEntity("GEOMETRIC_TOLERANCE", "", "AIM"),
            IgnoredEntity("DIMENSIONAL_SIZE", "", "AIM"),
            IgnoredEntity("DIMENSIONAL_LOCATION", "", "AIM"),
            IgnoredEntity("APPROVAL", "", "AIM"),
            IgnoredEntity("APPROVAL_STATUS", "", "AIM"),
            IgnoredEntity("APPROVAL_DATE_TIME", "", "AIM"),
            IgnoredEntity("APPROVAL_PERSON_ORGANIZATION", "", "AIM"),
            IgnoredEntity("APPROVAL_ROLE", "", "AIM"),
            IgnoredEntity("CC_DESIGN_APPROVAL", "", "AIM"),
            IgnoredEntity("CC_DESIGN_DATE_AND_TIME_ASSIGNMENT", "", "AIM"),
            IgnoredEntity("CC_DESIGN_PERSON_AND_ORGANIZATION_ASSIGNMENT", "", "AIM"),
            IgnoredEntity("CC_DESIGN_SECURITY_CLASSIFICATION", "", "AIM"),
            IgnoredEntity("SECURITY_CLASSIFICATION", "", "AIM"),
            IgnoredEntity("SECURITY_CLASSIFICATION_LEVEL", "", "AIM"),
            IgnoredEntity("PERSON", "", "AIM"),
            IgnoredEntity("ORGANIZATION", "", "AIM"),
            IgnoredEntity("PERSON_AND_ORGANIZATION", "", "AIM"),
            IgnoredEntity("PERSON_AND_ORGANIZATION_ROLE", "", "AIM"),
            IgnoredEntity("DATE_AND_TIME", "", "AIM"),
            IgnoredEntity("CALENDAR_DATE", "", "AIM"),
            IgnoredEntity("LOCAL_TIME", "", "AIM"),
            IgnoredEntity("COORDINATED_UNIVERSAL_TIME_OFFSET", "", "AIM"),
            IgnoredEntity("DATE_TIME_ROLE", "", "AIM")
        ];

    //==
    // # Unsupported

    // Catalogue entities with no kernel counterpart, and AP242 tessellated
    // geometry (P42 6.4.52 to 6.4.75), which carries meshes rather than exact
    // geometry: one Warning per type. Supertypes are kept where a WHERE rule
    // tests membership in a kind (manifold_surface_shape_representation WR12
    // admits degenerate pcurves and points on curves as vertex geometry).
    UnsupportedEntities(_: Part21File): Array<EntityDefinition>
        => [
            EntityDefinition("CURVE_BOUNDED_SURFACE", "CRBNSR", "P42 4.5.81", ["BOUNDED_SURFACE"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("ORIENTED_SURFACE", "ORNSRF", "P42 4.5.87", ["SURFACE"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("SURFACE_REPLICA", "SRFRPL", "P42 4.5.88", ["SURFACE"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("CURVE_REPLICA", "CRVRPL", "P42 4.5.56", ["CURVE"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("OFFSET_CURVE_2D", "", "P42", ["CURVE"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("CLOTHOID", "", "P42", ["CURVE"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("CIRCULAR_INVOLUTE", "", "P42", ["CURVE"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("DEGENERATE_PCURVE", "DGNPCR", "P42 4.5.12", ["POINT"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("EVALUATED_DEGENERATE_PCURVE", "EVDGPC", "P42 4.5.13", ["DEGENERATE_PCURVE"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("POINT_ON_CURVE", "", "P42", ["POINT"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("POINT_ON_SURFACE", "", "P42", ["POINT"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("CYLINDRICAL_POINT", "", "P42 4.5.5", ["CARTESIAN_POINT"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("SPHERICAL_POINT", "", "P42 4.5.6", ["CARTESIAN_POINT"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("POLAR_POINT", "", "P42 4.5.7", ["CARTESIAN_POINT"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("OPEN_PATH", "", "P42 5.5.12", ["PATH"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("ORIENTED_PATH", "", "P42", ["PATH"], [], [], EntityTreatment.Unsupported),
            UnsupportedEntity("VERTEX_SHELL", "", "P42"),
            UnsupportedEntity("WIRE_SHELL", "", "P42"),
            UnsupportedEntity("GEOMETRIC_SET", "", "P42"),
            UnsupportedEntity("GEOMETRIC_CURVE_SET", "", "P42"),
            EntityDefinition("GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION", "GBSSR", "AIM", ["SHAPE_REPRESENTATION"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("TESSELLATED_SHAPE_REPRESENTATION", "", "P42 6.4.52", ["SHAPE_REPRESENTATION"], [], [], EntityTreatment.Unsupported),
            EntityDefinition("TESSELLATED_SHAPE_REPRESENTATION_WITH_ACCURACY_PARAMETERS", "", "P42", ["TESSELLATED_SHAPE_REPRESENTATION"], [], [], EntityTreatment.Unsupported),
            UnsupportedEntity("TESSELLATED_ITEM", "", "P42 6.4.53"),
            UnsupportedEntity("COORDINATES_LIST", "", "P42"),
            UnsupportedEntity("TESSELLATED_VERTEX", "", "P42"),
            UnsupportedEntity("TESSELLATED_EDGE", "", "P42"),
            UnsupportedEntity("TESSELLATED_CONNECTING_EDGE", "", "P42"),
            UnsupportedEntity("CUBIC_BEZIER_TESSELLATED_EDGE", "", "P42"),
            UnsupportedEntity("TESSELLATED_FACE", "", "P42"),
            UnsupportedEntity("TRIANGULATED_FACE", "", "P42"),
            UnsupportedEntity("COMPLEX_TRIANGULATED_FACE", "", "P42"),
            UnsupportedEntity("CUBIC_BEZIER_TRIANGULATED_FACE", "", "P42"),
            UnsupportedEntity("TESSELLATED_SOLID", "", "P42"),
            UnsupportedEntity("TESSELLATED_SHELL", "", "P42"),
            UnsupportedEntity("TESSELLATED_WIRE", "", "P42"),

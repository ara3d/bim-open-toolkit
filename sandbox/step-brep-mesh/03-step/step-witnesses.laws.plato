                P21Simple(150, "PRODUCT_DEFINITION", [623, 624, 625, 626]),
                P21Simple(151, "PRODUCT_DEFINITION_SHAPE", [627, 628, 629]),
                P21Simple(152, "SHAPE_DEFINITION_REPRESENTATION", [630, 631]),
                P21Simple(153, "NEXT_ASSEMBLY_USAGE_OCCURRENCE", [632, 633, 634, 635, 636, 637]),
                P21Simple(154, "NEXT_ASSEMBLY_USAGE_OCCURRENCE", [638, 639, 640, 641, 642, 643]),
                P21Simple(155, "PRODUCT_DEFINITION_SHAPE", [644, 645, 646]),
                P21Simple(156, "PRODUCT_DEFINITION_SHAPE", [647, 648, 649]),
                P21Simple(157, "ITEM_DEFINED_TRANSFORMATION", [650, 651, 652, 653]),
                P21Simple(158, "ITEM_DEFINED_TRANSFORMATION", [654, 655, 656, 657]),
                P21Complex(159, [P21Part("REPRESENTATION_RELATIONSHIP", [658, 659, 660, 661]), P21Part("REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION", [662]), P21Part("SHAPE_REPRESENTATION_RELATIONSHIP", [])]),
                P21Complex(160, [P21Part("REPRESENTATION_RELATIONSHIP", [663, 664, 665, 666]), P21Part("REPRESENTATION_RELATIONSHIP_WITH_TRANSFORMATION", [667]), P21Part("SHAPE_REPRESENTATION_RELATIONSHIP", [])]),
                P21Simple(161, "CONTEXT_DEPENDENT_SHAPE_REPRESENTATION", [668, 669]),
                P21Simple(162, "CONTEXT_DEPENDENT_SHAPE_REPRESENTATION", [670, 671])]),
            box.Attributes.Concatenate([
                // #143 complex GEOMETRIC_REPRESENTATION_CONTEXT: 588 to 596
                P21Int(3), P21Ref(131), P21List([589]), P21Ref(128), P21Ref(129), P21Ref(130), P21List([591, 592, 593]), P21Str("assembly context"), P21Str("3D"),
                // #144 CARTESIAN_POINT: 597 to 601

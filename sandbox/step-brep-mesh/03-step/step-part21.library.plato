//==
// # Part21Reading
//
// Layer 3 of the STEP B-rep to mesh design. Reading and writing the Part 21
// text (deferred: Plato's String has literals and == only, so a lexer is host
// code), finding an instance by name, reading attribute values out of the
// arena, and the structural equality the round-trip law needs. Every reader is
// total: an index out of range or a value of another kind gives the fallback.
//
// Sections, in order:
//  - Text
//  - Instances and records
//  - Attribute values
//  - Equality of files

library Part21Reading
{
    //==
    // # Text

    // deferred, host obligation (PLAN.md, owner decision 2026-10-17: STEP
    // parsing stays in C#; Part21File is the boundary): a lexer for P21 5 and
    // 6 (lenient as research/STEP-BREP-MODEL.md 1.2 lists: lower-case
    // keywords, reals such as .5) and a recursive-descent parser for the
    // header and one data section, then a sort of instances by name and a pass
    // that checks references. Its contract and laws are stated here and run
    // by the host's tests.
    ParseStep(text: String): ParsedFile;

    // deferred, host obligation (as ParseStep): writes ISO-10303-21;, the header, one data section with every
    // instance in Instances order, and END-ISO-10303-21;. Reals are written in
    // the shortest form that reads back to the same Number; strings are
    // re-encoded with the P21 6.4.3 directives where they need them.
    PrintStep(file: Part21File): String;

    //==
    // # Instances and records

    // deferred: binary search on Instances, which ParseStep keeps in ascending
    // Id order. The position of the instance named id, or -1 when the file has
    // none.
    InstancePosition(f: Part21File, id: StepInstanceId): Integer;

    // True when i is a position in Instances.
    IsInstancePosition(f: Part21File, i: Integer): Boolean
        => i >= 0 && i < f.Instances.Count;

    // The name of the instance at position i; none when i is no position.
    IdAt(f: Part21File, i: Integer): StepInstanceId
        => f.IsInstancePosition(i) ? f.Instances[i].Id : StepInstanceId(-1);

    // The records of a body: the one record of a simple instance, the parts of
    // a complex one.
    RecordsOf(b: StepInstanceBody): Array<StepSimpleRecord>
        => match (b) {
            Simple(name, attributes) => [StepSimpleRecord(name, attributes)];
            Complex(parts) => parts;
        };

    // True when b is written as a complex instance.
    IsComplex(b: StepInstanceBody): Boolean
        => match (b) {
            Simple(name, attributes) => false;
            Complex(parts) => true;
        };

    // The records of the instance at position i; none when i is no position.
    RecordsAt(f: Part21File, i: Integer): Array<StepSimpleRecord>
        => f.IsInstancePosition(i) ? f.Instances[i].Body.RecordsOf : [];

    // True when the instance at position i is a complex instance.
    IsComplexAt(f: Part21File, i: Integer): Boolean
        => f.IsInstancePosition(i) ? f.Instances[i].Body.IsComplex : false;

    //==
    // # Attribute values

    // The attribute at index a; Unset when a is not an index of the arena.
    AttributeAt(f: Part21File, a: StepAttributeIndex): StepAttribute
        => f.Attributes.IsValidIndex(a) ? f.Attributes[a] : StepAttribute.Unset;

    // The number at a: a real, an integer (accepted where a real is expected,
    // as OpenCascade does), or the number inside a typed parameter such as
    // LENGTH_MEASURE(2.5); fallback for anything else.
    RealOr(f: Part21File, a: StepAttributeIndex, fallback: Number): Number
        => match (f.AttributeAt(a)) {
            IntegerValue(v) => v.ToNumber;
            RealValue(v) => v;
            StringValue(s) => fallback;
            EnumValue(n) => fallback;
            BinaryValue(b) => fallback;
            Reference(id) => fallback;
            Typed(n, inner) => f.RealOr(inner, fallback);
            ListValue(items) => fallback;
            Unset => fallback;
            Derived => fallback;
        };

    // The integer at a, or inside a typed parameter; fallback for anything
    // else, a real included.
    IntegerOr(f: Part21File, a: StepAttributeIndex, fallback: Integer): Integer
        => match (f.AttributeAt(a)) {
            IntegerValue(v) => v;
            RealValue(v) => fallback;
            StringValue(s) => fallback;
            EnumValue(n) => fallback;
            BinaryValue(b) => fallback;
            Reference(id) => fallback;
            Typed(n, inner) => f.IntegerOr(inner, fallback);
            ListValue(items) => fallback;
            Unset => fallback;
            Derived => fallback;
        };

    // The string at a, or inside a typed parameter; fallback otherwise.
    StringOr(f: Part21File, a: StepAttributeIndex, fallback: String): String
        => match (f.AttributeAt(a)) {
            IntegerValue(v) => fallback;
            RealValue(v) => fallback;
            StringValue(s) => s;
            EnumValue(n) => fallback;
            BinaryValue(b) => fallback;
            Reference(id) => fallback;
            Typed(n, inner) => f.StringOr(inner, fallback);
            ListValue(items) => fallback;
            Unset => fallback;
            Derived => fallback;
        };

    // The enumeration name at a ("T" for .T.), or inside a typed parameter;
    // "" otherwise.
    EnumAt(f: Part21File, a: StepAttributeIndex): String
        => match (f.AttributeAt(a)) {
            IntegerValue(v) => "";
            RealValue(v) => "";
            StringValue(s) => "";
            EnumValue(n) => n;
            BinaryValue(b) => "";
            Reference(id) => "";
            Typed(n, inner) => f.EnumAt(inner);
            ListValue(items) => "";
            Unset => "";
            Derived => "";
        };

    // The instance a refers to; none (-1) when a is not a reference. A SELECT
    // member that is an entity is written #n, never as a typed parameter.
    ReferenceOf(f: Part21File, a: StepAttributeIndex): StepInstanceId
        => match (f.AttributeAt(a)) {
            IntegerValue(v) => StepInstanceId(-1);
            RealValue(v) => StepInstanceId(-1);
            StringValue(s) => StepInstanceId(-1);
            EnumValue(n) => StepInstanceId(-1);
            BinaryValue(b) => StepInstanceId(-1);
            Reference(id) => id;
            Typed(n, inner) => StepInstanceId(-1);
            ListValue(items) => StepInstanceId(-1);
            Unset => StepInstanceId(-1);
            Derived => StepInstanceId(-1);
        };

    // The items of the aggregate at a, in file order; none when a is not one.
    ItemsOf(f: Part21File, a: StepAttributeIndex): Array<StepAttributeIndex>
        => match (f.AttributeAt(a)) {
            IntegerValue(v) => [];
            RealValue(v) => [];
            StringValue(s) => [];
            EnumValue(n) => [];
            BinaryValue(b) => [];
            Reference(id) => [];
            Typed(n, inner) => [];
            ListValue(items) => items;
            Unset => [];
            Derived => [];
        };

    // The keyword of the typed parameter at a; "" when a is not one.
    TypedNameOf(f: Part21File, a: StepAttributeIndex): String
        => match (f.AttributeAt(a)) {
            IntegerValue(v) => "";
            RealValue(v) => "";
            StringValue(s) => "";
            EnumValue(n) => "";
            BinaryValue(b) => "";
            Reference(id) => "";
            Typed(n, inner) => n;
            ListValue(items) => "";
            Unset => "";
            Derived => "";
        };

    // The values nested directly in the value at a: the inner value of a typed
    // parameter, the items of an aggregate, none otherwise.
    ChildrenOf(f: Part21File, a: StepAttributeIndex): Array<StepAttributeIndex>
        => match (f.AttributeAt(a)) {
            IntegerValue(v) => [];
            RealValue(v) => [];
            StringValue(s) => [];
            EnumValue(n) => [];
            BinaryValue(b) => [];
            Reference(id) => [];
            Typed(n, inner) => [inner];
            ListValue(items) => items;
            Unset => [];
            Derived => [];
        };

    // True when the value at a is $ (P21 12.2.2), or a is no index.
    IsUnset(f: Part21File, a: StepAttributeIndex): Boolean
        => match (f.AttributeAt(a)) {
            IntegerValue(v) => false;
            RealValue(v) => false;
            StringValue(s) => false;
            EnumValue(n) => false;
            BinaryValue(b) => false;
            Reference(id) => false;
            Typed(n, inner) => false;
            ListValue(items) => false;
            Unset => true;
            Derived => false;
        };

    // True when the value at a is * (P21 12.2.6).
    IsDerived(f: Part21File, a: StepAttributeIndex): Boolean
        => match (f.AttributeAt(a)) {
            IntegerValue(v) => false;
            RealValue(v) => false;
            StringValue(s) => false;
            EnumValue(n) => false;
            BinaryValue(b) => false;
            Reference(id) => false;
            Typed(n, inner) => false;
            ListValue(items) => false;
            Unset => false;
            Derived => true;
        };

    // True when the value at a is the BOOLEAN or LOGICAL .T..
    IsTrue(f: Part21File, a: StepAttributeIndex): Boolean
        => f.EnumAt(a) == "T";

    // The numbers of the aggregate at a, fallback for items that are not.
    RealsOf(f: Part21File, a: StepAttributeIndex, fallback: Number): Array<Number>
        => f.ItemsOf(a).Map(x => f.RealOr(x, fallback));

    // The integers of the aggregate at a, fallback for items that are not.
    IntegersOf(f: Part21File, a: StepAttributeIndex, fallback: Integer): Array<Integer>
        => f.ItemsOf(a).Map(x => f.IntegerOr(x, fallback));

    // The instances the aggregate at a refers to, none (-1) for items that are
    // not references.
    ReferencesOf(f: Part21File, a: StepAttributeIndex): Array<StepInstanceId>
        => f.ItemsOf(a).Map(x => f.ReferenceOf(x));

    //==
    // # Equality of files
    //
    // Structural equality of the data model: what Law_ParsePrintParseIsIdentity
    // compares. Arrays are compared element by element (== on arrays does not
    // type-check, PLATO-PRIMER.md D.6); a Number is compared with Identical,
    // because the printer writes a real that reads back to the same Number:
    // exact by construction.

    // True when two string lists are equal element by element.
    IsSameStrings(a: Array<String>, b: Array<String>): Boolean
        => a.Corresponds(b, (x, y) => x == y);

    // True when two index lists are equal element by element.
    IsSameIndices(a: Array<StepAttributeIndex>, b: Array<StepAttributeIndex>): Boolean
        => a.Corresponds(b, (x, y) => x == y);

    // True when two headers agree field by field.
    IsSameHeader(a: StepHeader, b: StepHeader): Boolean
        => a.Description.IsSameStrings(b.Description)
            && a.ImplementationLevel == b.ImplementationLevel
            && a.Name == b.Name
            && a.TimeStamp == b.TimeStamp
            && a.Author.IsSameStrings(b.Author)
            && a.Organization.IsSameStrings(b.Organization)
            && a.PreprocessorVersion == b.PreprocessorVersion
            && a.OriginatingSystem == b.OriginatingSystem
            && a.Authorization == b.Authorization
            && a.Schema.IsSameStrings(b.Schema);

    // True when two records have the same keyword and attribute indices.
    IsSameRecord(a: StepSimpleRecord, b: StepSimpleRecord): Boolean
        => a.TypeName == b.TypeName && a.Attributes.IsSameIndices(b.Attributes);

    // True when two instances have the same name, the same mapping (simple or
    // complex), and the same records.
    IsSameInstance(a: StepInstance, b: StepInstance): Boolean
        => a.Id == b.Id
            && a.Body.IsComplex == b.Body.IsComplex
            && a.Body.RecordsOf.Corresponds(b.Body.RecordsOf, (x, y) => x.IsSameRecord(y));

    // The case of an attribute value as a number, 0 to 9 in declaration order.
    AttributeTag(a: StepAttribute): Integer
        => match (a) {
            IntegerValue(v) => 0;
            RealValue(v) => 1;
            StringValue(s) => 2;
            EnumValue(n) => 3;
            BinaryValue(b) => 4;
            Reference(id) => 5;
            Typed(n, inner) => 6;
            ListValue(items) => 7;
            Unset => 8;
            Derived => 9;
        };

    // The integer payload of a value; 0 for every other case.
    IntegerPayload(a: StepAttribute): Integer
        => match (a) {
            IntegerValue(v) => v;
            RealValue(v) => 0;
            StringValue(s) => 0;
            EnumValue(n) => 0;
            BinaryValue(b) => 0;
            Reference(id) => id.Value;
            Typed(n, inner) => inner.Value;
            ListValue(items) => 0;
            Unset => 0;
            Derived => 0;
        };

    // The number payload of a value; 0 for every other case.
    RealPayload(a: StepAttribute): Number
        => match (a) {
            IntegerValue(v) => 0.0;
            RealValue(v) => v;
            StringValue(s) => 0.0;
            EnumValue(n) => 0.0;
            BinaryValue(b) => 0.0;
            Reference(id) => 0.0;
            Typed(n, inner) => 0.0;
            ListValue(items) => 0.0;
            Unset => 0.0;
            Derived => 0.0;
        };

    // The text payload of a value (a string, an enumeration name, binary
    // digits, a typed parameter's keyword); "" for every other case.
    TextPayload(a: StepAttribute): String
        => match (a) {
            IntegerValue(v) => "";
            RealValue(v) => "";
            StringValue(s) => s;
            EnumValue(n) => n;
            BinaryValue(b) => b;
            Reference(id) => "";
            Typed(n, inner) => n;
            ListValue(items) => "";
            Unset => "";
            Derived => "";
        };

    // The list payload of a value; empty for every other case.
    ListPayload(a: StepAttribute): Array<StepAttributeIndex>
        => match (a) {
            IntegerValue(v) => [];
            RealValue(v) => [];
            StringValue(s) => [];
            EnumValue(n) => [];
            BinaryValue(b) => [];
            Reference(id) => [];
            Typed(n, inner) => [];
            ListValue(items) => items;
            Unset => [];
            Derived => [];
        };

    // True when two attribute values have the same case and the same payload.
    // Every payload is one of the four projections above, so agreement on the
    // tag and all four is equality.
    IsSameAttribute(a: StepAttribute, b: StepAttribute): Boolean
        => a.AttributeTag == b.AttributeTag
            && a.IntegerPayload == b.IntegerPayload
            && a.RealPayload.Identical(b.RealPayload)
            && a.TextPayload == b.TextPayload
            && a.ListPayload.IsSameIndices(b.ListPayload);

    // True when two files are the same data: headers, instances, and attribute
    // arenas equal element by element.
    IsSameFile(a: Part21File, b: Part21File): Boolean
        => a.Header.IsSameHeader(b.Header)
            && a.Instances.Corresponds(b.Instances, (x, y) => x.IsSameInstance(y))
            && a.Attributes.Corresponds(b.Attributes, (x, y) => x.IsSameAttribute(y));
}

//==
// # Sewing within a declared-closed shell, and reporting the shells left open (TKT-467)
//
// A file may write the faces of a closed shell with vertex and edge records of their own, so two
// faces meet along two edge records at the same positions and each record is cited once. Layer
// 3's Reduced merges only vertices that an edge or a loop's head-to-tail joint brings together,
// so nothing joins such records. Sewn joins them within each shell the file declares closed, and
// only along the shell's open boundary: the edges its faces cite once, and their end vertices.
// An edge already cited by two faces is never merged, even with a coincident twin: two such
// edges are two manifold edges at one place, and merging them makes one edge of four faces (in
// CEL/LENA-R8.STEP, 19 such pairs of B-spline edges would have become 20 non-manifold and 40
// misoriented mesh edges). Two steps:
//
// - Vertices: the boundary's vertices that coincide at the length tolerance (layer 2's grid
//   coincidence classes) are merged into their class's first vertex, but only those within the
//   tolerance of that vertex itself. The classes are transitive, so a chain of coincident pairs
//   can join vertices farther apart than the tolerance; a member beyond it is left as it is
//   (Reduced's caveat, avoided here).
// - Edges: the boundary's edges whose ends, after the vertex merge, are the same two vertices and
//   whose curves agree (each one's middle point lies on the other's arc within the tolerance) are
//   merged into the first; a coedge citing a merged edge cites the kept one, reversed when the
//   two run opposite ways. A closed edge (one vertex at both ends) is never merged.
//
// A vertex or edge in two declared-closed shells is merged at most once, by the first shell, and
// never into a vertex or edge that is itself merged. Each vertex merge is a RepairRecord
// (MergedInto, as Reduced writes; its RawVertex is the merged vertex's index in the model
// before sewing, the reduced model's, not the decoder's) and a diagnostic; each edge merge a
// RepairRecord (MergedEdgeInto, its RawEdge likewise the reduced model's index) and a
// diagnostic. The kept vertex of every earlier MergedInto is moved to the sewn model's numbering.
// PrepareModelWith (step.library.plato) calls Sewn after LoopsChained.
//
// After sewing, a declared-closed shell some of whose edges its faces cite once is open in the
// file. Supervisor's decision of 2026-10-22: no sewing across shells (that would merge touching
// bodies, which the file does not state). Instead one diagnostic per such shell (measure: the
// count of its once-cited edges) and one per once-cited edge (measure: the index of another shell
// holding an edge at the same two positions, its twin, or Unmeasured when none does), so a
// boundary edge there is counted as the file's, not the mesher's.
//
// Sections, in order:
//  - Small helpers (with LoopFaces and FaceEdgeIndices, which the sheet repair and the laws read)
//  - Vertices
//  - Edges
//  - The sewn model
//  - The raw model
//  - Shells left open

library V1JodyShellSewing
{
    //==
    // # Small helpers

    // The distinct values of xs, increasing.
    DistinctSorted(xs: Array<Integer>): Array<Integer>
    {
        var sorted = xs.Sort((a, b) => a <= b);
        return sorted.Count.Range.FlatMap(i => (i == 0 ? true : sorted[i] != sorted[i - 1]) ? [sorted[i]] : Integer.NoIndices);
    }

    // The vertices at the ends of the edges shell s's faces cite once (its open boundary),
    // distinct and increasing.
    ShellBoundaryVertexIndices(m: BrepModel, s: ShellIndex): Array<Integer>
        => DistinctSorted(m.OnceCitedEdges(s).FlatMap(e => [m.Edges[e].Start.Value, m.Edges[e].End.Value]));

    // The indices of the shells the file declares closed, increasing.
    DeclaredClosedShells(m: BrepModel): Array<Integer>
        => m.Shells.Count.Range.FlatMap(s => m.Shells[s].DeclaredClosed ? [s] : Integer.NoIndices);

    // The first target given for each item: target[i] for the first pair (i, target) in pairs
    // whose target is not itself the first item of any pair; i where no such pair names i.
    // pairs holds [item, target] arrays.
    FirstValidTargets(n: Integer, pairs: Array<Array<Integer>>): Array<Integer>
    {
        var moved = new Buffer<Boolean>(n);
        var i = 0;
        while (i < n)
        {
            moved = moved.Set(i, false);
            i = i + 1;
        }
        var k = 0;
        while (k < pairs.Count)
        {
            moved = moved.Set(pairs[k][0], true);
            k = k + 1;
        }
        var isMoved = moved.Freeze();
        var valid = pairs.FlatMap(p => isMoved[p[1]] ? pairs.Take(0) : [p]);
        var target = new Buffer<Integer>(n);
        var j = 0;
        while (j < n)
        {
            target = target.Set(j, j);
            j = j + 1;
        }
        var r = valid.Count - 1;
        while (r >= 0)
        {
            target = target.Set(valid[r][0], valid[r][1]);
            r = r - 1;
        }
        return target.Freeze();
    }

    // The face each loop bounds: the first face whose bounds name it, or -1.
    LoopFaces(m: BrepModel): Array<Integer>
    {
        var owner = new Buffer<Integer>(m.Loops.Count);
        var i = 0;
        while (i < m.Loops.Count)
        {
            owner = owner.Set(i, -1);
            i = i + 1;
        }
        var f = m.Faces.Count - 1;
        while (f >= 0)
        {
            var b = 0;
            while (b < m.Faces[f].Bounds.Count)
            {
                owner = owner.Set(m.Faces[f].Bounds[b].Loop.Value, f);
                b = b + 1;
            }
            f = f - 1;
        }
        return owner.Freeze();
    }

    // The edges face f's loops cite, distinct and increasing.
    FaceEdgeIndices(m: BrepModel, f: Integer): Array<Integer>
        => DistinctSorted(m.Faces[f].Bounds.FlatMap(b => m.Loops[b.Loop.Value].CoedgesOf.Map(c => c.Edge.Value)));

    //==
    // # Vertices

    // For each point, the point it merges into or itself: its coincidence class's first point
    // when that is another point within the length tolerance of it, else itself. No chain: a
    // point merges only into a point it coincides with, and that point merges into nothing.
    StarRoots(m: BrepModel, points: Array<Point3D>): Array<Integer>
    {
        var roots = m.CoincidenceRootsByGrid(points);
        return points.Count.MapRange(k => (roots[k] != k && m.IsCoincident(points[k], points[roots[k]])) ? roots[k] : k);
    }

    // The merges one shell asks for, each [vertex, kept vertex]: StarRoots over the vertices of
    // the shell's open boundary.
    ShellVertexMerges(m: BrepModel, s: ShellIndex): Array<Array<Integer>>
    {
        var vs = m.ShellBoundaryVertexIndices(s);
        var roots = m.StarRoots(vs.Map(v => m.Vertices[v].Point));
        return vs.Count.Range.FlatMap(k => roots[k] != k ? [[vs[k], vs[roots[k]]]] : [[0, 0]].Take(0));
    }

    // For every vertex, the vertex it is merged into, or itself: the merges of every declared-
    // closed shell in shell order, the first for a vertex winning, none into a merged vertex.
    SewnVertexRoots(m: BrepModel): Array<Integer>
        => FirstValidTargets(m.Vertices.Count, m.DeclaredClosedShells.FlatMap(s => m.ShellVertexMerges(ShellIndex(s))));

    //==
    // # Edges

    // Whether point p lies on edge e's arc: its closest parameter on e's curve, moved by whole
    // periods to at or after the range's start on a curve with a seam, inside the edge's range,
    // and the curve's point there within the length tolerance of p.
    LiesOnEdgeArc(m: BrepModel, e: BrepEdgeIndex, p: Point3D): Boolean
    {
        var curve = m.Edges[e].Curve;
        var d = m.Geometry.Domain(curve);
        var range = m.EdgeDomain(e).Range;
        var t = m.Geometry.ClosestParameter(curve, p);
        var u = d.HasSeam ? t.PeriodicRepresentativeAbove(range.Start, d.Periodicity.PeriodOr(0.0)) : t;
        var slack = ResolutionAt(range.Start.Abs.Max(range.End.Abs)).Value;
        return u >= range.Start - slack && u <= range.End + slack
            && m.EdgeCurvePoint(e, u).Distance(p) <= m.Tolerances.Length.Value;
    }

    // The point in the middle of edge e's range.
    EdgeMiddlePoint(m: BrepModel, e: BrepEdgeIndex): Point3D
        => m.EdgeCurvePoint(e, 0.5 * (m.EdgeDomain(e).Range.Start + m.EdgeDomain(e).Range.End));

    // Whether edges a and b run along the same curve: each one's middle point lies on the other's
    // arc.
    CurvesAgree(m: BrepModel, a: BrepEdgeIndex, b: BrepEdgeIndex): Boolean
        => m.LiesOnEdgeArc(b, m.EdgeMiddlePoint(a)) && m.LiesOnEdgeArc(a, m.EdgeMiddlePoint(b));

    // Edge e's two vertex roots, smaller first.
    EndKey(m: BrepModel, roots: Array<Integer>, e: Integer): Array<Integer>
    {
        var a = roots[m.Edges[e].Start.Value];
        var b = roots[m.Edges[e].End.Value];
        return [a.Min(b), a.Max(b)];
    }

    // Whether key a sorts at or before key b, then edge i at or before edge j.
    KeyAtMost(a: Array<Integer>, i: Integer, b: Array<Integer>, j: Integer): Boolean
        => a[0] < b[0] || (a[0] == b[0] && (a[1] < b[1] || (a[1] == b[1] && i <= j)));

    // The merges one shell asks for, each [edge, kept edge]: among the edges the shell's faces
    // cite once whose two vertex roots differ, sorted by those roots, every edge whose group's
    // first edge is another and whose curve agrees with it.
    ShellEdgeMerges(m: BrepModel, s: ShellIndex, roots: Array<Integer>): Array<Array<Integer>>
    {
        var open = m.OnceCitedEdges(s).FlatMap(e => m.EndKey(roots, e)[0] != m.EndKey(roots, e)[1] ? [e] : Integer.NoIndices);
        var keys = open.Map(e => m.EndKey(roots, e));
        var order = open.Count.Range.Sort((x, y) => KeyAtMost(keys[x], open[x], keys[y], open[y]));
        var firstOf = new Buffer<Integer>(order.Count);
        var i = 0;
        while (i < order.Count)
        {
            var same = i > 0 ? (keys[order[i]][0] == keys[order[i - 1]][0] && keys[order[i]][1] == keys[order[i - 1]][1]) : false;
            firstOf = firstOf.Set(i, same ? 0 : 1);
            i = i + 1;
        }
        var starts = firstOf.Freeze();
        var groupStart = new Buffer<Integer>(order.Count);
        var current = 0;
        var k = 0;
        while (k < order.Count)
        {
            if (starts[k] == 1)
            {
                current = k;
            }
            groupStart = groupStart.Set(k, current);
            k = k + 1;
        }
        var first = groupStart.Freeze();
        return order.Count.Range.FlatMap(q => (first[q] != q && m.CurvesAgree(BrepEdgeIndex(open[order[q]]), BrepEdgeIndex(open[order[first[q]]])))
            ? [[open[order[q]], open[order[first[q]]]]]
            : [[0, 0]].Take(0));
    }

    // For every edge, the edge it is merged into, or itself, given the vertex roots.
    SewnEdgeRoots(m: BrepModel, roots: Array<Integer>): Array<Integer>
        => FirstValidTargets(m.Edges.Count, m.DeclaredClosedShells.FlatMap(s => m.ShellEdgeMerges(ShellIndex(s), roots)));

    //==
    // # The sewn model

    // Whether merged edge e runs the other way from its kept edge k, given the vertex roots.
    RunsOpposite(m: BrepModel, roots: Array<Integer>, e: Integer, k: Integer): Boolean
        => roots[m.Edges[e].Start.Value] != roots[m.Edges[k].Start.Value];

    // The coedge citing the kept edge, at its new index, reversed when the cited edge runs the
    // other way from the kept one.
    SewnCoedge(m: BrepModel, c: Coedge, roots: Array<Integer>, edgeRoots: Array<Integer>, edgeAt: Array<Integer>): Coedge
    {
        var e = c.Edge.Value;
        var k = edgeRoots[e];
        return Coedge(BrepEdgeIndex(edgeAt[k]), m.RunsOpposite(roots, e, k) ? c.Orientation.Opposite : c.Orientation);
    }

    // A loop of the sewn model.
    SewnLoop(m: BrepModel, l: BrepLoop, roots: Array<Integer>, vertexAt: Array<Integer>, edgeRoots: Array<Integer>, edgeAt: Array<Integer>): BrepLoop
        => match (l) {
            EdgeLoop(coedges) => BrepLoop.EdgeLoop(coedges.Map(c => m.SewnCoedge(c, roots, edgeRoots, edgeAt)));
            VertexLoop(vertex) => BrepLoop.VertexLoop(BrepVertexIndex(vertexAt[roots[vertex.Value]]));
            PolyLoop(points) => l;
        };

    // The model with the merged vertices and edges removed and every reference renumbered;
    // faces, shells, bodies and the arena keep their rows.
    SewnModelWith(m: BrepModel, roots: Array<Integer>, edgeRoots: Array<Integer>): BrepModel
    {
        var vertexAt = m.Vertices.Count.MapRange(v => roots[v] == v).Renumbering;
        var edgeAt = m.Edges.Count.MapRange(e => edgeRoots[e] == e).Renumbering;
        var vertices = m.Vertices.Count.Range.FlatMap(v => roots[v] == v ? [m.Vertices[v]] : m.Vertices.Take(0));
        var edges = m.Edges.Count.Range.FlatMap(e => edgeRoots[e] == e
            ? [BrepEdge(BrepVertexIndex(vertexAt[roots[m.Edges[e].Start.Value]]), BrepVertexIndex(vertexAt[roots[m.Edges[e].End.Value]]), m.Edges[e].Curve, m.Edges[e].SameSense)]
            : m.Edges.Take(0));
        return BrepModel(m.Geometry, vertices, edges, m.Loops.Map(l => m.SewnLoop(l, roots, vertexAt, edgeRoots, edgeAt)),
            m.Faces, m.Shells, m.Bodies, m.Tolerances, m.Unit);
    }

    // The model sewn within each declared-closed shell.
    SewnModel(m: BrepModel): BrepModel
    {
        var roots = m.SewnVertexRoots;
        return m.SewnModelWith(roots, m.SewnEdgeRoots(roots));
    }

    //==
    // # The raw model

    // The raw model sewn within each declared-closed shell: the sewn model, the sources of the
    // removed vertices and edges dropped, one MergedInto repair per merged vertex then one
    // MergedEdgeInto repair per merged edge, one ShellVertexSewn diagnostic per merged vertex in
    // index order, one ShellEdgeSewn diagnostic per merged edge in index order, then the
    // diagnostics of the shells left open. The raw model unchanged, but
    // for those diagnostics, when nothing is merged. Precondition: raw.Model.IsEveryIndexInRange.
    Sewn(raw: RawDecodedModel): RawDecodedModel
    {
        var m = raw.Model;
        var roots = m.SewnVertexRoots;
        var edgeRoots = m.SewnEdgeRoots(roots);
        var mergedVertices = m.Vertices.Count.Range.FlatMap(v => roots[v] != v ? [v] : Integer.NoIndices);
        var mergedEdges = m.Edges.Count.Range.FlatMap(e => edgeRoots[e] != e ? [e] : Integer.NoIndices);
        var sewn = (mergedVertices.Count == 0 && mergedEdges.Count == 0) ? m : m.SewnModelWith(roots, edgeRoots);
        var vertexAt = m.Vertices.Count.MapRange(v => roots[v] == v).Renumbering;
        var edgeAt = m.Edges.Count.MapRange(e => edgeRoots[e] == e).Renumbering;
        var s = raw.Sources;
        var sources = KernelSources(
            m.Vertices.Count.Range.FlatMap(v => roots[v] == v ? [s.Vertices[v]] : s.Vertices.Take(0)),
            m.Edges.Count.Range.FlatMap(e => edgeRoots[e] == e ? [s.Edges[e]] : s.Edges.Take(0)),
            s.Loops, s.Faces, s.Shells, s.Bodies, s.Curves, s.Curves2D, s.Pcurves, s.Surfaces);
        var repairs = mergedVertices.Map(v => RepairRecord(s.Vertices[v], StepRepair.MergedInto(BrepVertexIndex(vertexAt[roots[v]]), BrepVertexIndex(v))))
            .Concatenate(mergedEdges.Map(e => RepairRecord(s.Edges[e], StepRepair.MergedEdgeInto(BrepEdgeIndex(edgeAt[edgeRoots[e]]), BrepEdgeIndex(e)))));
        var vertexFindings = mergedVertices.Map(v => Diagnose(StepDiagnosticCode.ShellVertexSewn,
            Provenance.AtInstance(s.Vertices[v].Instance), m.Vertices[v].Point.Distance(m.Vertices[roots[v]].Point)));
        var edgeFindings = mergedEdges.Map(e => Diagnose(StepDiagnosticCode.ShellEdgeSewn, Provenance.AtInstance(s.Edges[e].Instance), edgeAt[edgeRoots[e]].ToNumber));
        var earlier = raw.Repairs.Map(r => RepairRecord(r.Source, r.Repair.WithKeptVertexMoved(roots, vertexAt)));
        var sewnRaw = RawDecodedModel(sewn, raw.Occurrences, sources, raw.Folds, earlier.Concatenate(repairs),
            raw.Units, raw.LengthFactor, raw.AngleFactor,
            raw.Diagnostics.Concatenate(vertexFindings).Concatenate(edgeFindings));
        return sewnRaw.WithOpenShellsReported;
    }

    // An earlier repair with its kept vertex moved to the sewn model: a MergedInto's Vertex is an
    // index in the model that comes out of preparation, so when sewing merges and renumbers
    // vertices it follows them; every other repair as it is.
    WithKeptVertexMoved(r: StepRepair, roots: Array<Integer>, vertexAt: Array<Integer>): StepRepair
        => match (r) {
            MergedInto(vertex, rawVertex) => StepRepair.MergedInto(BrepVertexIndex(vertexAt[roots[vertex.Value]]), rawVertex);
            DroppedZeroLengthEdge(rawEdge) => r;
            MergedEdgeInto(edge, rawEdge) => r;
            Skipped => r;
        };

    //==
    // # Shells left open

    // The edges of shell s that its faces cite once, increasing.
    OnceCitedEdges(m: BrepModel, s: ShellIndex): Array<Integer>
    {
        var t = m.EdgeUseTable(s);
        return m.EdgesOfShell(s).Map(e => e.Value).FlatMap(e => t.UseCountIn(BrepEdgeIndex(e)) == 1 ? [e] : Integer.NoIndices);
    }

    // Every once-cited edge of every declared-closed shell, as [edge, shell], in shell order.
    OnceCitedUses(m: BrepModel): Array<Array<Integer>>
        => m.DeclaredClosedShells.FlatMap(s => m.OnceCitedEdges(ShellIndex(s)).Map(e => [e, s]));

    // For each once-cited use, the shell of another use whose edge lies at the same two positions
    // (both ends coincident, either way round), or -1: the uses' end points' coincidence classes
    // give each edge a key, and the first use with the same key in another shell is its twin.
    TwinShells(m: BrepModel, uses: Array<Array<Integer>>): Array<Integer>
    {
        var points = uses.FlatMap(u => [m.Vertices[m.Edges[u[0]].Start].Point, m.Vertices[m.Edges[u[0]].End].Point]);
        var roots = m.CoincidenceRootsByGrid(points);
        var keys = uses.Count.MapRange(i => [roots[2 * i].Min(roots[2 * i + 1]), roots[2 * i].Max(roots[2 * i + 1])]);
        var order = uses.Count.Range.Sort((x, y) => KeyAtMost(keys[x], x, keys[y], y));
        var position = new Buffer<Integer>(uses.Count);
        var p = 0;
        while (p < order.Count)
        {
            position = position.Set(order[p], p);
            p = p + 1;
        }
        var at = position.Freeze();
        return uses.Count.MapRange(i => order.TwinShellNear(keys, uses, at[i]));
    }

    // Whether the uses at sorted positions a and b have the same key.
    SameKeyAt(order: Array<Integer>, keys: Array<Array<Integer>>, a: Integer, b: Integer): Boolean
        => keys[order[a]][0] == keys[order[b]][0] && keys[order[a]][1] == keys[order[b]][1];

    // The shell of the nearest use in sorted order around position q with the same key and
    // another shell, or -1. (Each loop test indexes only after the bound is checked: Plato's &&
    // evaluates both sides.)
    TwinShellNear(order: Array<Integer>, keys: Array<Array<Integer>>, uses: Array<Array<Integer>>, q: Integer): Integer
    {
        var mine = uses[order[q]][1];
        var found = -1;
        var j = q - 1;
        var going = j >= 0 ? order.SameKeyAt(keys, j, q) : false;
        while (going)
        {
            found = uses[order[j]][1] != mine ? uses[order[j]][1] : -1;
            j = j - 1;
            going = found < 0 ? (j >= 0 ? order.SameKeyAt(keys, j, q) : false) : false;
        }
        var k = q + 1;
        going = found < 0 ? (k < order.Count ? order.SameKeyAt(keys, k, q) : false) : false;
        while (going)
        {
            found = uses[order[k]][1] != mine ? uses[order[k]][1] : -1;
            k = k + 1;
            going = found < 0 ? (k < order.Count ? order.SameKeyAt(keys, k, q) : false) : false;
        }
        return found;
    }

    // The raw model with one ClosedShellOpen diagnostic per declared-closed shell that has a
    // once-cited edge, then one OnceCitedEdge diagnostic per such edge, in shell and edge order.
    WithOpenShellsReported(raw: RawDecodedModel): RawDecodedModel
    {
        var m = raw.Model;
        var uses = m.OnceCitedUses;
        var twins = m.TwinShells(uses);
        var openShells = DistinctSorted(uses.Map(u => u[1]));
        var shellFindings = openShells.Map(s => Diagnose(StepDiagnosticCode.ClosedShellOpen,
            Provenance.AtInstance(raw.Sources.Shells[s].Instance), uses.Reduce(0, (n, u) => u[1] == s ? n + 1 : n).ToNumber));
        var edgeFindings = uses.Count.MapRange(i => Diagnose(StepDiagnosticCode.ClosedShellEdgeCitedOnce, Provenance.AtInstance(raw.Sources.Edges[uses[i][0]].Instance), twins[i] >= 0 ? twins[i].ToNumber : Number.Unmeasured));
        return RawDecodedModel(m, raw.Occurrences, raw.Sources, raw.Folds, raw.Repairs, raw.Units, raw.LengthFactor, raw.AngleFactor,
            raw.Diagnostics.Concatenate(shellFindings).Concatenate(edgeFindings));
    }
}

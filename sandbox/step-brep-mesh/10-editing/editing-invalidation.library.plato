//==
// # Editing: invalidation
//
// TYPE-CATALOG.md section 12. What an edit stales downstream, read from the
// edit and the model before it, never from a diff of before and after. The
// indices are the model's before the edit; a remap carries them over.
//
// Sections, in order:
//  - Invalidation sets
//  - Invalidation of an edit

library BrepEditingInvalidation
{
    //==
    // # Invalidation sets

    // The invalidation of a closure's edges and faces.
    ToInvalidation(c: SelectionClosure): Invalidation
        => Invalidation(c.Edges, c.Faces, false);

    // The invalidation of every mesh.
    WholeModelInvalidation(m: BrepModel): Invalidation
        => Invalidation(m.Edges.Count.MapRange(i => BrepEdgeIndex(i)), m.Faces.Count.MapRange(i => BrepFaceIndex(i)), true);

    // The invalidation of faces only, kept in range and each once.
    FacesInvalidation(m: BrepModel, fs: Array<BrepFaceIndex>): Invalidation
        => Invalidation(0.MapRange(k => BrepEdgeIndex(k)), m.FaceSet(fs), false);

    // Nothing invalidated: an edit that only adds.
    NoInvalidation(_: Invalidation): Invalidation
        => Invalidation(0.MapRange(k => BrepEdgeIndex(k)), 0.MapRange(k => BrepFaceIndex(k)), false);

    // Whether face f's mesh is stale under inv.
    Covers(inv: Invalidation, f: BrepFaceIndex): Boolean
        => inv.CoversSorted(f);

    // The reference: the form before chunk L8.
    CoversScanned(inv: Invalidation, f: BrepFaceIndex): Boolean
        => inv.WholeModel ? true : inv.Faces.HoldsFace(f);

    // Whether edge e's discretization is stale under inv.
    Covers(inv: Invalidation, e: BrepEdgeIndex): Boolean
        => inv.CoversSorted(e);

    // The reference: the form before chunk L8.
    CoversScanned(inv: Invalidation, e: BrepEdgeIndex): Boolean
        => inv.WholeModel ? true : inv.Edges.HoldsEdge(e);

    //==
    // # Invalidation of an edit

    // A geometric edit's invalidation. A vertex move stales the edges at the
    // vertex and their faces (and faces with a vertex loop there); a curve
    // replacement the edges on the curve and their faces; a surface
    // replacement the faces on it; a whole-model transform or scale every
    // mesh, a partial one the selection's closure.
    InvalidationOfGeometric(m: BrepModel, g: GeometricEdit): Invalidation
        => match (g) {
            MoveVertex(v, to) => m.ClosureOfVertices([v]).ToInvalidation;
            ReplaceCurve(c, with) => m.ClosureOfEdges(m.EdgesOnCurve(c)).ToInvalidation;
            ReplaceSurface(s, with) => m.FacesInvalidation(m.FacesOnSurface(s));
            Transform(target, by) => target.IsEverything ? m.WholeModelInvalidation : m.ClosureOf(target).ToInvalidation;
            Scale(target, by) => target.IsEverything ? m.WholeModelInvalidation : m.ClosureOf(target).ToInvalidation;
        };

    // A topological edit's invalidation: the faces and edges it rewrites. An
    // edit that only adds (AddFace, RestoreFace) stales no existing mesh; the
    // added face is meshed fresh and the remap renumbers the others.
    InvalidationOfTopological(m: BrepModel, t: TopologicalEdit): Invalidation
        => match (t) {
            SplitEdge(e, at) => m.ClosureOfEdges([e]).ToInvalidation;
            MergeEdges(a, b) => m.ClosureOfEdges([a, b]).ToInvalidation;
            SplitFace(f, along) => m.ClosureOfFaces([f]).ToInvalidation;
            RemoveFace(f) => m.FacesInvalidation([f]);
            AddFace(face) => Invalidation.NoInvalidation;
            RestoreFace(at, face, uses) => Invalidation.NoInvalidation;
            ReverseFace(f) => m.FacesInvalidation([f]);
            ReverseLoop(l) => m.FacesInvalidation(m.FacesOfLoop(l));
            RetrimFace(f, bounds) => m.ClosureOfFaces([f]).ToInvalidation;
        };

    // What edit stales in m's meshes. A tolerance edit stales every mesh.
    InvalidationOf(m: BrepModel, edit: ModelEdit): Invalidation
        => match (edit) {
            Geometric(g) => m.InvalidationOfGeometric(g);
            Topological(t) => m.InvalidationOfTopological(t);
            Tolerance(t) => m.WholeModelInvalidation;
        };

    // What remains to re-mesh after a transaction: the invalidation of its
    // script's edits, each read against the model before the script. Right
    // for scripts whose edits keep every table size (geometric, tolerance,
    // reversals); after a removal or insertion a later edit's indices are not
    // Before's, and carrying each invalidation through the remaps is not done
    // here (README.md, "Deferred edits"; FINDINGS F-58).
    DirtyAfter(t: Transaction): Dirty
        => DirtyAfterOnce(t);

    // The reference: the form before chunk L8.
    DirtyAfterScanned(t: Transaction): Dirty
        => Dirty(t, Invalidation(
            t.Before.EdgeSet(t.Script.Edits.FlatMap(e => t.Before.InvalidationOf(e).Edges)),
            t.Before.FaceSet(t.Script.Edits.FlatMap(e => t.Before.InvalidationOf(e).Faces)),
            t.Script.Edits.Any(e => t.Before.InvalidationOf(e).WholeModel)));
}

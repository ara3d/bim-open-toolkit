//==
// # Face quality check laws
//
// Each quality check agrees with its law (face-quality.laws.plato); moved from
// 07-validation/validation.laws.plato with the checks (face-quality-validation.library.plato).

library FaceQualityValidationLaws
{
    // Check_ElementNormalAgreesWithSurface agrees with its law at element k
    // of the face mesh.
    Law_FaceElementNormalCheckAgrees(m: BrepModel, fm: FaceMesh, c: FaceMeshingCriteria, k: ElementIndex): Boolean
        => (c.SurfaceAngular.Radians >= 0.0 ? m.Check_ElementNormalAgreesWithSurface(fm, c).Holds : false)
            ? Law_ElementNormalAgreesWithSurface(m, fm, c, k)
            : true;

    // Check_SurfaceEdgeNormalTurnWithinSurfaceAngular agrees with its law at
    // element k and edge j.
    Law_NormalTurnCheckAgrees(m: BrepModel, d: EdgeDiscretizations, fm: FaceMesh, c: FaceMeshingCriteria, k: ElementIndex, j: Integer): Boolean
        => ((c.SurfaceAngular.Radians >= 0.0 && j >= 0 && j < 4) ? m.Check_SurfaceEdgeNormalTurnWithinSurfaceAngular(d, fm, c).Holds : false)
            ? Law_SurfaceEdgeNormalTurnWithinSurfaceAngular(m, d, fm, c, k, j)
            : true;

    // Check_QuadPlanarWithinSurfaceChordal agrees with its law at quad q.
    Law_QuadPlanarCheckAgrees(fm: FaceMesh, c: FaceMeshingCriteria, q: FaceIndex): Boolean
        => (c.SurfaceChordal >= 0.0 ? fm.Check_QuadPlanarWithinSurfaceChordal(c).Holds : false)
            ? Law_QuadPlanarWithinSurfaceChordal(fm, c, q)
            : true;
}

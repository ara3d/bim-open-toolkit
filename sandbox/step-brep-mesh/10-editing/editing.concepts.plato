//==
// # Editing

// A value an edit applies to. Law: applying the outcome's Inverse to the
// outcome's model gives the value back (Law_InverseUndoes). BrepModel
// meets the obligation through BrepEditing's Apply, but it is a layer 2 type
// and this concept is layer 10's, so its implements clause cannot name it;
// moving the concept down is an open decision (reviews/FINDINGS.md, F-58).
interface IEditable
{
    Apply(x: Self, edit: ModelEdit): EditOutcome;
}

//==
// # Face quality laws (version 1 gate split, TKT-418)
//
// The laws of layer 5 that state quality, not the version 1 mesh contract
// (sandbox/step-brep-mesh/README.md, "Version 1 mesh contract"): angles (including the Delaunay
// property, which exists to maximise the smallest angle), the side-normal turn and element-normal
// agreement, quad planarity and convexity, and refinement targets. They belong to the improvement
// pass. Moved here from layer 5 with bodies and comments unchanged; the helpers they call stay
// where they are, since layer 10 sees layer 5.
//
// Sections, in order:
//  - Face meshes and quads
//  - Angle passes
//  - Triangulated witnesses

library FaceQualityLaws
{
    //==
    // # Face meshes and quads

    // Every element that touches no collapsed line has its normal within SurfaceAngular of the
    // face normal at its parameter centroid.
    Law_ElementNormalAgreesWithSurface(m: BrepModel, fm: FaceMesh, c: FaceMeshingCriteria, k: ElementIndex): Boolean
        => m.CanMeasure(fm, k)
            ? (m.TouchesCollapsedLine(fm, k) ? true : m.ElementNormalDeviation(fm, k) <= c.SurfaceAngular)
            : true;

    // The face normal turns by at most SurfaceAngular along every surface edge of every element
    // (edge j of element k): the definition of SurfaceAngular.
    Law_SurfaceEdgeNormalTurnWithinSurfaceAngular(m: BrepModel, d: EdgeDiscretizations, fm: FaceMesh, c: FaceMeshingCriteria, k: ElementIndex, j: Integer): Boolean
        => (m.CanMeasure(fm, k) && m.IsDiscretizedFace(fm.Face, d))
            ? ((j >= 0 && j < fm.ElementCorners(k).Count)
                ? (m.IsSurfaceEdge(d, fm, fm.ElementCorners(k)[j], fm.ElementCorners(k).AtModulo(j + 1))
                    ? fm.EdgeNormalTurn(k, j) <= c.SurfaceAngular
                    : true)
                : true)
            : true;

    // Every quad of a face mesh is planar within SurfaceChordal: no corner lies farther than that
    // from its mid-plane.
    Law_QuadPlanarWithinSurfaceChordal(fm: FaceMesh, c: FaceMeshingCriteria, q: FaceIndex): Boolean
        => fm.IsMeasurableQuad(q) ? fm.QuadWarp(q) <= c.SurfaceChordal : true;

    // Every quad of a face mesh is strictly convex.
    Law_QuadConvex(fm: FaceMesh, q: FaceIndex): Boolean
        => fm.IsMeasurableQuad(q) ? fm.IsConvexQuad(q) : true;

    //==
    // # Angle passes

    // AnglePassBuilt gives AnglePassLocal's triangulation, and the surface point of each of its
    // points, from every face's constrained Delaunay triangulation of sample k with every
    // triangle below the angle.
    Law_AnglePassBuiltAgrees(k: Integer): Boolean
        => EveryTriangulableFace(k, (m, f, r, chart) => m.AnglePassAgreesOn(f, r, chart));

    // The strip of the count witness at 32 points: the angle pass over builders agrees with
    // AnglePassLocal there too, so the witness measures the same insertions.
    Law_StripPassAgrees(_: Integer): Boolean
    {
        var m = BrepModel.Witness_UnitBox;
        var f = BrepFaceIndex(0);
        var r = StripRegion(32);
        var chart = m.ChartOf(f, r);
        return m.AnglePassAgreesOn(f, r, chart);
    }

    // The counted angle test lifts exactly the triangles no mark skips: all of them with no
    // marks, none when every one is known good, half when every other one is; and it adds one
    // index per triangle it keeps.
    Law_BelowAngleCountsItsLifts(n: Integer): Boolean
    {
        var m = BrepModel.Witness_UnitBox;
        var f = BrepFaceIndex(0);
        var t = PlaneStrip(2 * (((n % 16) + 16) % 16) + 2);
        var count = t.Triangles.Count;
        var plain = m.BelowAngleCounted(f, t, [false].Take(0), [false].Take(0));
        var allGood = m.BelowAngleCounted(f, t, [false].Take(0), t.Triangles.Map(x => true));
        var evenGood = m.BelowAngleCounted(f, t, [false].Take(0), count.MapRange(k => k % 2 == 0));
        return plain.Work.Evaluations == 3 * count && plain.Work.Insertions == plain.Value.Count
            && allGood.Work.Evaluations == 0 && allGood.Value.Count == 0
            && evenGood.Work.Evaluations == 3 * (count / 2)
            && evenGood.Value.All(k => k % 2 == 1);
    }

    //==
    // # Triangulated witnesses

    // Law_CdtNoFlippableEdge: no edge is flippable by the in-circle determinant.
    Law_CdtNoFlippableEdge(w: TriangulatedWitness): Boolean
        => w.Region.FlippableEdgeCount(w.Cdt, w.Chart) == 0;

    // Law_RefinedNoFlippableEdge: the refined triangulation is still constrained Delaunay.
    Law_RefinedNoFlippableEdge(w: TriangulatedWitness): Boolean
        => w.Region.FlippableEdgeCount(w.Refined, w.Chart) == 0;

    // Law_MinAngleNoWorseThanLibrary: the refinement's smallest lifted angle is no smaller than
    // RefinedTriangulation's, within 1e-5 rad; one fresh RefinedTriangulation per face.
    Law_MinAngleNoWorseThanLibrary(w: TriangulatedWitness): Boolean
    {
        var library = w.Model.RefinedTriangulation(w.Face, w.Region, w.Chart, TriCriteria(0));
        return w.Model.SmallestLiftedAngle(w.Face, w.Refined) >= w.Model.SmallestLiftedAngle(w.Face, library) - 1e-5;
    }

    // Law_MinAngleBetterOnCylinders: on every face of the cylinder (sample 1) and the quarter
    // sector (4), the smallest lifted angle is larger than the library's before the merge, 4.99
    // and 8.50 degrees. The original compared the least over the faces, which is the same claim.
    Law_MinAngleBetterOnCylinders(w: TriangulatedWitness): Boolean
        => (w.Sample == 1 || w.Sample == 4)
            ? w.Model.SmallestLiftedAngle(w.Face, w.Refined) > (w.Sample == 4 ? 8.50 : 4.99) * Number.Pi / 180.0
            : true;

    // The quality requests at 30 degrees for the witness's face, on its refined triangulation.
    QualityRequestsOn(w: TriangulatedWitness): Array<EdgeRefinementRequest>
        => w.Model.QualitySegmentRequestsCdt(w.Face, w.Discretizations, w.Region, w.Refined, TriCriteria(0), 30.0.Degrees);

    // The sum of the extents of the face mesh's positions along x, y and z: for a face of the
    // 2 x 3 x 4 box, 6 exactly on its 2 x 4 faces (5 on the 2 x 3 and 7 on the 3 x 4).
    ExtentSum(fm: FaceMesh): Number
    {
        var p = fm.Positions;
        var lo = p.Reduce(Point3D(Number.MaxValue, Number.MaxValue, Number.MaxValue), (a, x) => Point3D(a.X.Min(x.X), a.Y.Min(x.Y), a.Z.Min(x.Z)));
        var hi = p.Reduce(Point3D(0.0 - Number.MaxValue, 0.0 - Number.MaxValue, 0.0 - Number.MaxValue), (a, x) => Point3D(a.X.Max(x.X), a.Y.Max(x.Y), a.Z.Max(x.Z)));
        return (hi.X - lo.X) + (hi.Y - lo.Y) + (hi.Z - lo.Z);
    }

    // Law_QualityRequestsOnBoxes: the quality requests at 30 degrees ask for nothing on the unit
    // box (sample 0), and on the 2 x 3 x 4 box (5) every request names an edge of its face. The
    // original's "some face of the 2 x 3 x 4 box asks" is stated per face, and more sharply: a
    // face asks exactly when it is a 2 x 4 face, the one shape whose two triangles stay below 30
    // degrees (atan(1/2) = 26.6; atan(2/3) = 33.7 and atan(3/4) = 36.9 pass).
    Law_QualityRequestsOnBoxes(w: TriangulatedWitness): Boolean
    {
        var requests = (w.Sample == 0 || w.Sample == 5) ? QualityRequestsOn(w) : EdgeRefinementRequest.NoRequests;
        return w.Sample == 0
            ? requests.Count == 0
            : (w.Sample == 5
                ? (requests.Count > 0) == ((ExtentSum(w.Outcome.Mesh) - 6.0).Abs < 1e-9)
                    && requests.All(q => w.Model.FaceEdges(w.Face).Any(e => e == q.Edge))
                : true);
    }
}

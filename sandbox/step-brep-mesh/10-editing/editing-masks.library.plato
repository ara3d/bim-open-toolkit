//==
// # Editing: index sets by mask, closures and invalidation in one pass (complexity sweep, chunk L8)
//
// Ranked candidate 41 of docs/plans/step-mesher-complexity.md, layer 10. VertexSet, EdgeSet and
// FaceSet test every row of a table against every given index, O(N k); ClosureOfVertices lists
// the edges at each vertex twice, each by a scan of every edge, then asks FacesOfEdge (a scan of
// every face's coedges) per edge and FacesWithVertexLoopAt (a scan of every face) per vertex;
// Covers scans an invalidation's sorted index set linearly; DirtyAfter computes each edit's
// invalidation three times. Each function here returns what its namesake returns, for every
// input, in time linear in the table plus the input.
//
// Sections, in order:
//  - Marks
//  - Index sets
//  - Faces citing marked edges or vertices
//  - Closures
//  - Invalidation

library BrepEditingMasks
{
    //==
    // # Marks

    // One flag per row of a table of n rows: whether xs names the row. Values of xs outside
    // [0, n) are skipped. O(n + k) for k values.
    RowMarks(n: Integer, xs: Array<Integer>): Array<Boolean>
    {
        var marks = new Buffer<Boolean>(n.Max(1));
        var i = 0;
        while (i < n)
        {
            marks = marks.Set(i, false);
            i = i + 1;
        }
        var k = 0;
        while (k < xs.Count)
        {
            if (xs[k] >= 0 && xs[k] < n)
            {
                marks = marks.Set(xs[k], true);
            }
            k = k + 1;
        }
        var marked = marks.Freeze();
        return n.MapRange(r => marked[r]);
    }

    // The rows a mark array flags, in increasing order.
    MarkedRows(marks: Array<Boolean>): Array<Integer>
    {
        var rows = new List<Integer>();
        var r = 0;
        while (r < marks.Count)
        {
            if (marks[r])
            {
                rows = rows.Add(r);
            }
            r = r + 1;
        }
        return rows.Freeze();
    }

    // Whether value x is named: by its mark when it is a row of the marks, else by a scan of the
    // values outside the marks' rows (none for a well-formed selection).
    IsMarkedValue(marks: Array<Boolean>, outside: Array<Integer>, x: Integer): Boolean
        => (x >= 0 && x < marks.Count) ? marks[x] : outside.Any(y => y == x);

    // The values of xs outside [0, n).
    OutsideRows(n: Integer, xs: Array<Integer>): Array<Integer>
        => xs.FlatMap(x => (x >= 0 && x < n) ? xs.Take(0) : [x]);

    //==
    // # Index sets
    //
    // BrepEditingClosure's VertexSet, EdgeSet and FaceSet: the rows named in xs, each once, in
    // increasing order, from one mark per row filled in one pass. O(N + k).

    // The vertices of m named in xs, each once, in increasing order.
    VertexSetByMask(m: BrepModel, xs: Array<BrepVertexIndex>): Array<BrepVertexIndex>
        => RowMarks(m.Vertices.Count, xs.IndexValues).MarkedRows.Map(i => BrepVertexIndex(i));

    // The edges of m named in xs, each once, in increasing order.
    EdgeSetByMask(m: BrepModel, xs: Array<BrepEdgeIndex>): Array<BrepEdgeIndex>
        => RowMarks(m.Edges.Count, xs.IndexValues).MarkedRows.Map(i => BrepEdgeIndex(i));

    // The faces of m named in xs, each once, in increasing order.
    FaceSetByMask(m: BrepModel, xs: Array<BrepFaceIndex>): Array<BrepFaceIndex>
        => RowMarks(m.Faces.Count, xs.IndexValues).MarkedRows.Map(i => BrepFaceIndex(i));

    //==
    // # Faces citing marked edges or vertices

    // The faces of m, in increasing order, with a bound on a loop in range that has a coedge
    // citing an edge e in range with edgeMarks[e], or that is a vertex loop at a vertex value
    // IsMarkedValue(vertexMarks, outside, value) names. One pass over every face's bounds and
    // loops. Insertions counts the faces and the coedges visited, so F + C for F faces and C
    // coedges.
    FacesCitingCounted(m: BrepModel, edgeMarks: Array<Boolean>, vertexMarks: Array<Boolean>, outside: Array<Integer>): Counted<Array<BrepFaceIndex>>
    {
        var faces = new List<BrepFaceIndex>();
        var visits = 0;
        var f = 0;
        while (f < m.Faces.Count)
        {
            visits = visits + 1;
            var hit = false;
            var bounds = m.Faces[f].Bounds;
            var b = 0;
            while (b < bounds.Count)
            {
                if (m.IsLoopInRange(bounds[b].Loop))
                {
                    var coedges = m.Loops[bounds[b].Loop].CoedgesOf;
                    var k = 0;
                    while (k < coedges.Count)
                    {
                        visits = visits + 1;
                        var e = coedges[k].Edge.Value;
                        if (e >= 0 && e < edgeMarks.Count)
                        {
                            if (edgeMarks[e])
                            {
                                hit = true;
                            }
                        }
                        k = k + 1;
                    }
                    var poles = m.Loops[bounds[b].Loop].VertexLoopVertexOf;
                    var p = 0;
                    while (p < poles.Count)
                    {
                        if (IsMarkedValue(vertexMarks, outside, poles[p].Value))
                        {
                            hit = true;
                        }
                        p = p + 1;
                    }
                }
                b = b + 1;
            }
            if (hit)
            {
                faces = faces.Add(BrepFaceIndex(f));
            }
            f = f + 1;
        }
        return Counted(faces.Freeze(), Insertions(visits));
    }

    // The edges of m in range with an end vertex whose value IsMarkedValue names, in increasing
    // order: BrepEditingClosure's EdgesAtVertex for every named vertex, as one set. O(E).
    EdgesAtMarkedVertices(m: BrepModel, vertexMarks: Array<Boolean>, outside: Array<Integer>): Array<Boolean>
        => m.Edges.Count.MapRange(e =>
            IsMarkedValue(vertexMarks, outside, m.Edges[e].Start.Value) || IsMarkedValue(vertexMarks, outside, m.Edges[e].End.Value));

    //==
    // # Closures

    // ClosureOfVertices: the vertices, the edges at them, and the faces of those edges and of
    // vertex loops at them, from one vertex mark, one pass over the edges and one over the faces'
    // coedges. O(V + E + F + C + k).
    ClosureOfVerticesOnce(m: BrepModel, vs: Array<BrepVertexIndex>): SelectionClosure
    {
        var values = vs.IndexValues;
        var vertexMarks = RowMarks(m.Vertices.Count, values);
        var outside = OutsideRows(m.Vertices.Count, values);
        var edgeMarks = m.EdgesAtMarkedVertices(vertexMarks, outside);
        return SelectionClosure(
            vertexMarks.MarkedRows.Map(i => BrepVertexIndex(i)),
            edgeMarks.MarkedRows.Map(i => BrepEdgeIndex(i)),
            m.FacesCitingCounted(edgeMarks, vertexMarks, outside).Value);
    }

    //==
    // # Invalidation

    // Whether the strictly increasing index values xs hold x: binary search, O(log k). The index
    // sets of an Invalidation are strictly increasing by construction (every builder ends in
    // VertexSet, EdgeSet, FaceSet or a MapRange over a table; Law_Perf_InvalidationSetsAreSorted).
    HoldsSorted(xs: Array<$T>, x: Integer): Boolean where $T: IIndex
    {
        var lo = 0;
        var hi = xs.Count;
        while (lo < hi)
        {
            var mid = (lo + hi) / 2;
            if (xs[mid].Value < x)
            {
                lo = mid + 1;
            }
            else
            {
                hi = mid;
            }
        }
        return lo < xs.Count ? xs[lo].Value == x : false;
    }

    // Covers(inv, f) by binary search in the sorted face set.
    CoversSorted(inv: Invalidation, f: BrepFaceIndex): Boolean
        => inv.WholeModel ? true : inv.Faces.HoldsSorted(f.Value);

    // Covers(inv, e) by binary search in the sorted edge set.
    CoversSorted(inv: Invalidation, e: BrepEdgeIndex): Boolean
        => inv.WholeModel ? true : inv.Edges.HoldsSorted(e.Value);

    // DirtyAfter with each edit's invalidation computed once and the sets built by mask.
    DirtyAfterOnce(t: Transaction): Dirty
    {
        var invs = t.Script.Edits.Map(e => t.Before.InvalidationOf(e));
        return Dirty(t, Invalidation(
            t.Before.EdgeSetByMask(invs.FlatMap(i => i.Edges)),
            t.Before.FaceSetByMask(invs.FlatMap(i => i.Faces)),
            invs.Any(i => i.WholeModel)));
    }
}

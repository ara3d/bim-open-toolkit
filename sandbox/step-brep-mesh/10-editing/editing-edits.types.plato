//==
// # Editing: edits as data
//
// TYPE-CATALOG.md section 12. An edit is a value; Apply (BrepEditing)
// evaluates it and returns its inverse, so undo is applying the inverse.
//
// Sections, in order:
//  - Edits
//  - Euler operators
//  - Outcomes
//  - Scripts and transactions

//==
// # Edits

// Edits that change no table size, so their remap is the identity. MoveVertex
// sets one vertex's point. ReplaceCurve and ReplaceSurface swap one arena
// record. Transform and Scale act on a selection; only Everything is
// implemented, since moving part of a model must split the curves and
// surfaces it shares with the rest. Removes: a geometric edit that renumbers.
type GeometricEdit
    = MoveVertex(Vertex: BrepVertexIndex, To: ModelPoint)
    | ReplaceCurve(Curve: CurveIndex, With: BrepCurve)
    | ReplaceSurface(Surface: SurfaceIndex, With: BrepSurface)
    | Transform(Target: Selection, By: Pose3D)
    | Scale(Target: Selection, By: PowerOfTwo);

// One shell's citation of a face: the shell and the face's position in that
// shell's Faces. What RestoreFace needs to put a removed face back in place.
type FaceUse
    implements IValue
{
    Shell: ShellIndex;
    Slot: Integer;
}

// Edits that change table sizes and return a KernelRemap. RestoreFace is the
// inverse of RemoveFace, a case the catalog only sketched as AddFace: it puts
// Face back at index At and into every shell slot of Uses, so the undo is
// exact. Removes: a split that returns no renumbering, and an undo of a
// removal that appends the face at the end of the table.
type TopologicalEdit
    = SplitEdge(Edge: BrepEdgeIndex, At: EdgeParameter)
    | MergeEdges(A: BrepEdgeIndex, B: BrepEdgeIndex)
    | SplitFace(Face: BrepFaceIndex, Along: Array<EdgeParameter>)
    | RemoveFace(Face: BrepFaceIndex)
    | AddFace(Face: BrepFace)
    | RestoreFace(At: BrepFaceIndex, Face: BrepFace, Uses: Array<FaceUse>)
    | ReverseFace(Face: BrepFaceIndex)
    | ReverseLoop(Loop: BrepLoopIndex)
    | RetrimFace(Face: BrepFaceIndex, Bounds: Array<FaceBound>);

// Edits of the model's tolerances: replace them, or scale the length ones by
// a positive factor (layer 0's ScaledTolerances). Removes: a tolerance changed
// in place without invalidating every mesh made under the old one.
type ToleranceEdit
    = SetTolerances(Tolerances: Tolerances)
    | ScaleTolerances(Factor: Number);

// Any edit of a BrepModel. Removes: three apply functions a caller must pick
// between.
type ModelEdit
    = Geometric(Edit: GeometricEdit)
    | Topological(Edit: TopologicalEdit)
    | Tolerance(Edit: ToleranceEdit);

//==
// # Euler operators

// The Euler operators of solid modelling, each with the indices it needs and
// no more. MakeVertexEdge: a new vertex at At and an edge from From to it
// along Curve, inside Loop. MakeEdgeFace: an edge from From to To along Curve
// that cuts Loop in two, one half a new face. KillEdgeMakeRing: remove an
// edge that joins a loop to itself, leaving two loops of one face.
// MakeEdgeKillRing: an edge from From on Outer to To on Ring that joins the
// two loops into one. KillEdgeVertex: remove an edge and its end Vertex.
// KillFaceMakeRingHole: remove Face, its loop becoming a ring of Into, which
// adds one through hole. CountDelta gives each one's cell changes. Removes: a
// split that forgets the vertex.
type EulerOperator
    = MakeVertexEdge(Loop: BrepLoopIndex, From: BrepVertexIndex, At: ModelPoint, Curve: CurveIndex)
    | MakeEdgeFace(Loop: BrepLoopIndex, From: BrepVertexIndex, To: BrepVertexIndex, Curve: CurveIndex)
    | KillEdgeMakeRing(Edge: BrepEdgeIndex)
    | MakeEdgeKillRing(Outer: BrepLoopIndex, Ring: BrepLoopIndex, From: BrepVertexIndex, To: BrepVertexIndex, Curve: CurveIndex)
    | KillEdgeVertex(Edge: BrepEdgeIndex, Vertex: BrepVertexIndex)
    | KillFaceMakeRingHole(Face: BrepFaceIndex, Into: BrepFaceIndex);

//==
// # Outcomes

// The precondition an edit failed. NotYetImplemented is never returned by a
// body written here; it is what a deferred edit's stand-in would give.
// Removes: a refusal that says only "no".
type EditPrecondition
    = VertexInRange
    | EdgeInRange
    | LoopInRange
    | FaceInRange
    | ShellInRange
    | CurveInRange
    | SurfaceInRange
    | FaceSlotInRange
    | SelectionIsWholeModel
    | FactorIsPositive
    | ToleranceIsPositive
    | ParameterInDomain
    | FaceHasBound
    | LoopIsChained
    | EdgesShareVertex
    | NotYetImplemented;

// What applying an edit gives: the new model, the renumbering of every table,
// and the edit that undoes it; or the failed precondition and where it failed,
// with the model untouched. Removes: an edit that cannot be undone, and one
// that half-applies.
type EditOutcome
    = Applied(Model: BrepModel, Remap: KernelRemap, Inverse: ModelEdit)
    | Refused(Precondition: EditPrecondition, Where: Provenance);

//==
// # Scripts and transactions

// Edits applied in order, each to the model the one before it made.
type EditScript
{
    Edits: Array<ModelEdit>;
}

// What applying a script gives: the last model, the composed remap, and the
// script that undoes it (the inverses in reverse order); or the position of
// the first edit refused and why. The catalog's Apply(m, script) returns an
// EditOutcome, whose Inverse is one edit; a script's inverse is a script.
// Removes: a script that stops halfway and reports success.
type ScriptOutcome
    = ScriptApplied(Model: BrepModel, Remap: KernelRemap, Inverse: EditScript)
    | ScriptRefused(Step: Integer, Precondition: EditPrecondition, Where: Provenance);

// One applied script with the models before and after and the composed remap.
// After is Before with Script applied. Removes: an undo history that keeps
// only the edits and must replay from the start.
type Transaction
{
    Before: BrepModel;
    Script: EditScript;
    After: BrepModel;
    Remap: KernelRemap;
}

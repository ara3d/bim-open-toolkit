//==
// # Editing: masks, one-pass closures, sorted invalidation and scripts: laws (complexity sweep, chunk L8)
//
// The staged functions agree with their BrepEditingClosure, BrepEditingInvalidation and
// BrepEditing namesakes on the unit box, the cylinder (a seam), the repair sample model (a poly
// loop in an open shell) and the sphere (two vertex loops), with the selectors of
// BrepEditingLaws (Integers drawn in [-8, 8], so indices in and out of range). The three
// rewritten laws state BrepEditingLaws' Law_ScriptInverseUndoes,
// Law_RemapIsIdentityForGeometricEdits and Law_ComposeWithIdentityIsIdentity with each witness
// built once per case and each edit applied once per witness.
//
// Sections, in order:
//  - Models
//  - Index sets and closures
//  - Invalidation
//  - Scripts
//  - The rewritten laws

library BrepEditingPerfLaws
{
    //==
    // # Models

    // The number of models EditPerfModelAt draws from.
    EditPerfModelCount(_: Invalidation): Integer
        => 4;

    // Model w (0 to 3): the unit box, the cylinder, the repair sample model, the sphere.
    EditPerfModelAt(w: Integer): BrepModel
        => w == 0 ? BrepModel.Witness_UnitBox
            : w == 1 ? BrepModel.Witness_Cylinder
            : w == 2 ? Defect.RepairSampleModel
            : BrepModel.Witness_Sphere;

    //==
    // # Index sets and closures

    // The selectors as index values, with a repeat and -1: [i, k, i, -1, i + 3, k - 2].
    SelectorValues(k: Integer, i: Integer): Array<Integer>
        => [i, k, i, -1, i + 3, k - 2];

    // The three sets by mask are VertexSet, EdgeSet and FaceSet.
    SetsAgreeOn(m: BrepModel, xs: Array<Integer>): Boolean
        => m.VertexSetByMask(xs.Map(x => BrepVertexIndex(x))).Corresponds(m.VertexSetScanned(xs.Map(x => BrepVertexIndex(x))), (p, q) => p == q)
            && m.EdgeSetByMask(xs.Map(x => BrepEdgeIndex(x))).Corresponds(m.EdgeSetScanned(xs.Map(x => BrepEdgeIndex(x))), (p, q) => p == q)
            && m.FaceSetByMask(xs.Map(x => BrepFaceIndex(x))).Corresponds(m.FaceSetScanned(xs.Map(x => BrepFaceIndex(x))), (p, q) => p == q);

    // The statement above, on every model, and on no values.
    Law_SetsByMaskAgree(k: Integer, i: Integer): Boolean
        => Invalidation.EditPerfModelCount.Range.All(w =>
            SetsAgreeOn(EditPerfModelAt(w), SelectorValues(k, i)) && SetsAgreeOn(EditPerfModelAt(w), [0].Take(0)));

    // Whether two closures are equal, set by set.
    SameClosure(a: SelectionClosure, b: SelectionClosure): Boolean
        => a.Vertices.Corresponds(b.Vertices, (p, q) => p == q)
            && a.Edges.Corresponds(b.Edges, (p, q) => p == q)
            && a.Faces.Corresponds(b.Faces, (p, q) => p == q);

    // ClosureOfVerticesOnce is ClosureOfVertices on the selector vertices, on one of them, and
    // on every vertex of the model at once.
    ClosureOfVerticesAgreesOn(m: BrepModel, k: Integer, i: Integer): Boolean
    {
        var some = SelectorValues(k, i).Map(x => BrepVertexIndex(x));
        var one = [BrepVertexIndex(i)];
        var every = m.Vertices.Count.MapRange(v => BrepVertexIndex(v));
        return SameClosure(m.ClosureOfVerticesOnce(some), m.ClosureOfVerticesScanned(some))
            && SameClosure(m.ClosureOfVerticesOnce(one), m.ClosureOfVerticesScanned(one))
            && SameClosure(m.ClosureOfVerticesOnce(every), m.ClosureOfVerticesScanned(every));
    }

    // The statement above, on every model.
    Law_ClosureOfVerticesOnceAgrees(k: Integer, i: Integer): Boolean
        => Invalidation.EditPerfModelCount.Range.All(w => ClosureOfVerticesAgreesOn(EditPerfModelAt(w), k, i));

    //==
    // # Invalidation

    // Whether index values are strictly increasing.
    IsStrictlyIncreasing(xs: Array<Integer>): Boolean
        => (xs.Count - 1).Max(0).Range.All(j => xs[j] < xs[j + 1]);

    // The invalidation of edit kind k at index i on m, and of a two-edit transaction's dirty set,
    // name strictly increasing edges and faces: what CoversSorted's binary search needs.
    InvalidationSortedOn(m: BrepModel, k: Integer, i: Integer): Boolean
    {
        var inv = m.InvalidationOf(m.EditAt(k, i));
        var dirty = DirtyAfterOnce(Transaction(m, EditScript([m.EditAt(k, i), m.EditAt(k + 3, i - 1)]), m, m.IdentityRemap)).Invalidation;
        return inv.Edges.IndexValues.IsStrictlyIncreasing && inv.Faces.IndexValues.IsStrictlyIncreasing
            && dirty.Edges.IndexValues.IsStrictlyIncreasing && dirty.Faces.IndexValues.IsStrictlyIncreasing;
    }

    // The statement above, on every model.
    Law_InvalidationSetsAreSorted(k: Integer, i: Integer): Boolean
        => Invalidation.EditPerfModelCount.Range.All(w => InvalidationSortedOn(EditPerfModelAt(w), k, i));

    // CoversSorted is Covers for every face and edge of m and two past each end.
    CoversAgreesOn(m: BrepModel, k: Integer, i: Integer): Boolean
    {
        var inv = m.InvalidationOf(m.EditAt(k, i));
        return (m.Faces.Count + 4).Range.All(f => inv.CoversSorted(BrepFaceIndex(f - 2)) == inv.CoversScanned(BrepFaceIndex(f - 2)))
            && (m.Edges.Count + 4).Range.All(e => inv.CoversSorted(BrepEdgeIndex(e - 2)) == inv.CoversScanned(BrepEdgeIndex(e - 2)));
    }

    // The statement above, on every model.
    Law_CoversSortedAgrees(k: Integer, i: Integer): Boolean
        => Invalidation.EditPerfModelCount.Range.All(w => CoversAgreesOn(EditPerfModelAt(w), k, i));

    // Whether two invalidations are equal.
    SameInvalidation(a: Invalidation, b: Invalidation): Boolean
        => a.Edges.Corresponds(b.Edges, (p, q) => p == q)
            && a.Faces.Corresponds(b.Faces, (p, q) => p == q)
            && a.WholeModel == b.WholeModel;

    // DirtyAfterOnce is DirtyAfter for two-edit scripts of kinds k1 and k2 at indices -1 (out of
    // range below), 1 (in range of every table the edits read; a vertex-loop vertex on the
    // sphere) and 9 (out of range above for most tables).
    DirtyAfterAgreesOn(m: BrepModel, k1: Integer, k2: Integer): Boolean
        => [-1, 1, 9].All(i => [-1, 1, 9].All(j => m.DirtyAfterAgreesAt(EditScript([m.EditAt(k1, i), m.EditAt(k2, j)]))));

    // DirtyAfterOnce is DirtyAfter for one script on m.
    DirtyAfterAgreesAt(m: BrepModel, script: EditScript): Boolean
    {
        var t = Transaction(m, script, m, m.IdentityRemap);
        return SameInvalidation(DirtyAfterOnce(t).Invalidation, DirtyAfterScanned(t).Invalidation);
    }

    // The statement above, on every model.
    Law_DirtyAfterOnceAgrees(k1: Integer, k2: Integer): Boolean
        => Invalidation.EditPerfModelCount.Range.All(w => DirtyAfterAgreesOn(EditPerfModelAt(w), k1, k2));

    //==
    // # Scripts

    // A script outcome's remap; the identity of m when refused.
    ScriptRemapOr(m: BrepModel, o: ScriptOutcome): KernelRemap
        => match (o) {
            ScriptApplied(model, remap, inverse) => remap;
            ScriptRefused(step, precondition, where) => m.IdentityRemap;
        };

    // A script outcome's refused step; -1 when applied.
    RefusedStepOf(o: ScriptOutcome): Integer
        => match (o) {
            ScriptApplied(model, remap, inverse) => -1;
            ScriptRefused(step, precondition, where) => step;
        };

    // Whether two remaps are equal in every table.
    SameRemap(a: KernelRemap, b: KernelRemap): Boolean
        => 10.Range.All(t => a.NewOfValues(TableNameAt(t)).Corresponds(b.NewOfValues(TableNameAt(t)), (p, q) => p == q));

    //==
    // # The rewritten laws
    //
    // Each is the BrepEditingLaws law of the same name without Perf_, with the witness built once
    // per law case and the edit applied once per witness. At merge their bodies replace the
    // library laws' bodies, with Apply (ApplyScriptComposingRenumberings before the merge) read as Apply.

    // ScriptInverseUndoesAt for a witness built once: the two-edit script, then its inverse,
    // gives m back exactly, unless a kind is not exactly invertible.
    ScriptInverseUndoesOn(m: BrepModel, k1: Integer, i1: Integer, k2: Integer, i2: Integer): Boolean
        => k1.IsExactlyInvertible && k2.IsExactlyInvertible
            ? m.ScriptRoundTrips(EditScript([m.EditAt(k1, i1), m.EditAt(k2, i2)]))
            : true;

    // Whether applying script to m, then its inverse script, gives m back exactly.
    ScriptRoundTrips(m: BrepModel, script: EditScript): Boolean
    {
        var o = m.Apply(script);
        var after = m.ResultModel(o);
        return after.ResultModel(after.Apply(o.InverseScript)).SameModel(m);
    }

    // ScriptInverseUndoesOn on witness m, built once, with the first edit at the count indices
    // from first on and the second at every index from -1 to 9.
    ScriptInverseUndoesOver(m: BrepModel, k1: Integer, k2: Integer, first: Integer, count: Integer): Boolean
        => count.Range.All(i => 11.Range.All(j => m.ScriptInverseUndoesOn(k1, first + i, k2, j - 1)));

    // A two-edit script, then the script it returned, gives the model back exactly, on the unit
    // box, with the first edit at every index from -1 to 4 and the second at every index from -1
    // to 9. With the two laws below it states Law_ScriptInverseUndoes (both witnesses, both
    // edits at every index from -1 to 9), split so each part runs within the 2 s budget: one
    // SameModel and six identity remaps per script and inverse cost about 60 us on the box.
    Law_ScriptInverseUndoes(k1: Integer, k2: Integer): Boolean
        => EditWitnessAt(0).ScriptInverseUndoesOver(k1, k2, -1, 6);

    // The statement above with the first edit at every index from 5 to 9.
    Law_ScriptInverseUndoesFromFive(k1: Integer, k2: Integer): Boolean
        => EditWitnessAt(0).ScriptInverseUndoesOver(k1, k2, 5, 5);

    // The statement above on the cylinder, the first edit at every index from -1 to 9.
    Law_ScriptInverseUndoesOnCylinder(k1: Integer, k2: Integer): Boolean
        => EditWitnessAt(1).ScriptInverseUndoesOver(k1, k2, -1, 11);

    // RemapIsIdentityForGeometricEditsAt with the edit applied once for all ten tables.
    RemapIsIdentityOn(m: BrepModel, k: Integer, i: Integer): Boolean
        => k.IsGeometricOrTolerance ? m.RemapIsIdentityFor(m.ResultRemap(m.Apply(m.EditAt(k, i)))) : true;

    // Whether r is the identity of every table's row count of m.
    RemapIsIdentityFor(m: BrepModel, r: KernelRemap): Boolean
        => 10.Range.All(t => r.NewOfValues(TableNameAt(t)).Corresponds(m.RowCount(TableNameAt(t)).IdentityNewOf, (p, q) => p == q));

    // A geometric or tolerance edit renumbers no table, over both witnesses and every table.
    Law_RemapIsIdentityForGeometricEdits(k: Integer, i: Integer): Boolean
        => 2.Range.All(w => EditWitnessAt(w).RemapIsIdentityOn(k, i));

    // ComposeWithIdentityIsIdentityAt with the edit applied and the identity built once for all
    // ten tables.
    ComposeWithIdentityOn(m: BrepModel, k: Integer, i: Integer): Boolean
    {
        var r = m.ResultRemap(m.Apply(m.EditAt(k, i)));
        return SameRemap(m.IdentityRemap.Compose(r), r);
    }

    // Composing the identity remap before any remap gives that remap, over both witnesses and
    // every table.
    Law_ComposeWithIdentityIsIdentity(k: Integer, i: Integer): Boolean
        => 2.Range.All(w => EditWitnessAt(w).ComposeWithIdentityOn(k, i));
}

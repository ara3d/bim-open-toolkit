//==
// # Editing: Euler operators
//
// TYPE-CATALOG.md section 12. Each Euler operator's change to a shell's cell
// counts, the table Law_EulerOperatorKeepsCharacteristic reads. The
// operators themselves are applied by a deferred body.
//
// Sections, in order:
//  - Count deltas
//  - Application

library BrepEditingEuler
{
    //==
    // # Count deltas
    //
    // Layer 2's ShellCounts counts vertices V, edges E, faces F and face
    // bounds L, so V - E + 2F - L = V - E + F - R, R = L - F the rings, which
    // Euler-Poincare sets to 2 (S - H) for S shells and H through holes. An
    // operator's change is a ShellCountsDelta, signed, and its
    // CharacteristicDelta is the change to that value: every operator but
    // KillFaceMakeRingHole keeps S and H.

    // The change each operator makes to V, E, F and L.
    CountDelta(op: EulerOperator): ShellCountsDelta
        => match (op) {
            MakeVertexEdge(loop, from, at, curve) => ShellCountsDelta(1, 1, 0, 0);
            MakeEdgeFace(loop, from, to, curve) => ShellCountsDelta(0, 1, 1, 1);
            KillEdgeMakeRing(edge) => ShellCountsDelta(0, -1, 0, 1);
            MakeEdgeKillRing(outer, ring, from, to, curve) => ShellCountsDelta(0, 1, 0, -1);
            KillEdgeVertex(edge, vertex) => ShellCountsDelta(-1, -1, 0, 0);
            KillFaceMakeRingHole(face, into) => ShellCountsDelta(0, 0, -1, 0);
        };

    // The change each operator makes to the number of through holes H.
    HoleDelta(op: EulerOperator): Integer
        => match (op) {
            MakeVertexEdge(loop, from, at, curve) => 0;
            MakeEdgeFace(loop, from, to, curve) => 0;
            KillEdgeMakeRing(edge) => 0;
            MakeEdgeKillRing(outer, ring, from, to, curve) => 0;
            KillEdgeVertex(edge, vertex) => 0;
            KillFaceMakeRingHole(face, into) => 1;
        };

    //==
    // # Application

    // deferred: rewrite the vertex, edge, loop and face tables for one Euler
    // operator; the outcome's Inverse undoes it (contract in the spec file).
    ApplyEuler(m: BrepModel, op: EulerOperator): EditOutcome;
}

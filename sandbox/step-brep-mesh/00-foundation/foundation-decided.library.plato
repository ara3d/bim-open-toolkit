//==
// # Decided values (functions)
//
// IsDecided and ValueOr for every Decided* of foundation-decided.types.plato.
// Each sum is its own monomorphic type, so each has its own pair; a caller
// that needs the reason matches. CaseNumber gives each case of a multi-case
// sum its position in declaration order, from zero, so a law can check that
// every case round-trips. The termination certificate's constructor is here too.
//
// Sections, in order:
//  - Reasons
//  - Scalars and quantities
//  - Points and directions
//  - Indices, ranges, and rounds
//  - Kept segments
//  - Termination

library BrepFoundationDecided
{
    //==
    // # Reasons

    // The position of r's case in UndecidedReason, from 0.
    CaseNumber(r: UndecidedReason): Integer
        => match (r) {
            OutOfDomain => 0;
            DegenerateAt(side) => 1;
            NoConvergence(iterations) => 2;
            Unbounded => 3;
            NotApplicable(kind) => 4;
            BelowResolution => 5;
            ToleranceExceeded(by) => 6;
            Fails(property) => 7;
        };

    //==
    // # Scalars and quantities

    // True when d holds a Number.
    IsDecided(d: DecidedNumber): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The Number d holds, or fallback when d is undecided.
    ValueOr(d: DecidedNumber, fallback: Number): Number
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => fallback;
        };

    // True when d holds a Angle.
    IsDecided(d: DecidedAngle): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The Angle d holds, or fallback when d is undecided.
    ValueOr(d: DecidedAngle, fallback: Angle): Angle
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => fallback;
        };

    // True when d holds a ModelLength.
    IsDecided(d: DecidedLength): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The ModelLength d holds, or fallback when d is undecided.
    ValueOr(d: DecidedLength, fallback: ModelLength): ModelLength
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => fallback;
        };

    // True when d holds a CurveParameter.
    IsDecided(d: DecidedParameter): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The CurveParameter d holds, or fallback when d is undecided.
    ValueOr(d: DecidedParameter, fallback: CurveParameter): CurveParameter
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => fallback;
        };

    // True when d holds a Sign.
    IsDecided(d: DecidedSign): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The Sign d holds, or fallback when d is undecided.
    ValueOr(d: DecidedSign, fallback: Sign): Sign
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => fallback;
        };

    // True when d holds a closure decision.
    IsDecided(d: DecidedClosure): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The decision d holds, or fallback when d is undecided.
    ValueOr(d: DecidedClosure, fallback: Boolean): Boolean
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => fallback;
        };

    // True when d is decided closed; an undecided closure is not closed.
    IsClosed(d: DecidedClosure): Boolean
        => d.ValueOr(false);

    //==
    // # Points and directions

    // True when d holds a UvPoint.
    IsDecided(d: DecidedUv): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The UvPoint d holds, or fallback when d is undecided.
    ValueOr(d: DecidedUv, fallback: UvPoint): UvPoint
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => fallback;
        };

    // True when d holds a ModelPoint.
    IsDecided(d: DecidedPoint): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The ModelPoint d holds, or fallback when d is undecided.
    ValueOr(d: DecidedPoint, fallback: ModelPoint): ModelPoint
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => fallback;
        };

    // True when d holds a Direction3D.
    IsDecided(d: DecidedDirection): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The Direction3D d holds, or fallback when d is undecided.
    ValueOr(d: DecidedDirection, fallback: Direction3D): Direction3D
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => fallback;
        };

    //==
    // # Indices, ranges, and rounds

    // True when d holds a BrepFaceIndex.
    IsDecided(d: DecidedFaceIndex): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The BrepFaceIndex d holds, or fallback when d is undecided.
    ValueOr(d: DecidedFaceIndex, fallback: BrepFaceIndex): BrepFaceIndex
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => fallback;
        };

    // True when d holds a BrepEdgeIndex.
    IsDecided(d: DecidedEdgeIndex): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The BrepEdgeIndex d holds, or fallback when d is undecided.
    ValueOr(d: DecidedEdgeIndex, fallback: BrepEdgeIndex): BrepEdgeIndex
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => fallback;
        };

    // True when d holds a ParameterRange.
    IsDecided(d: DecidedRange): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The ParameterRange d holds, or fallback when d is undecided.
    ValueOr(d: DecidedRange, fallback: ParameterRange): ParameterRange
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => fallback;
        };

    // True when d holds a Round.
    IsDecided(d: DecidedRound): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The Round d holds, or fallback when d is undecided.
    ValueOr(d: DecidedRound, fallback: Round): Round
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => fallback;
        };

    //==
    // # Kept segments

    // The position of r's case in KeepReason, from 0.
    CaseNumber(r: KeepReason): Integer
        => match (r) {
            MeetsCriteria => 0;
            BelowMinLength => 1;
            AtMinSegments => 2;
            AtRoundLimit => 3;
        };

    //==
    // # Termination

    // The work a budget counts: the sum of its four counts, a negative count
    // read as zero.
    WorkTotal(w: WorkBudget): Integer
        => w.Evaluations.Max(0) + w.Insertions.Max(0) + w.Flips.Max(0) + w.Projections.Max(0);

    // The certificate of a round that started with the work before and ended
    // with the work after: Decreased exactly when the total fell strictly.
    // The one constructor a refinement round uses.
    CertifyRound(before: WorkBudget, after: WorkBudget): TerminationCertificate
        => TerminationCertificate(after, after.WorkTotal < before.WorkTotal);

    // True when the loop must stop after this round: the work did not
    // decrease, or none is left.
    IsTerminal(c: TerminationCertificate): Boolean
        => c.Decreased ? c.Work.WorkTotal <= 0 : true;
}

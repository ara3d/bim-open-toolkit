//==
// # Counts
//
// TYPE-CATALOG.md section 1 (layer 0). One type per thing counted, so a
// segment count is never passed where a sample count is expected.
//
// Sections, in order:
//  - Counts

//==
// # Counts

// A number of things, at least zero. Removes: a count confused with an index.
// Invariant: Value >= 0.
type Count
    implements IValue, IHashable, IComparable
{
    Value: Integer;
}

// A count that is at least one. Removes: a division by an empty count.
// Invariant: Value >= 1.
type NonZeroCount
    implements IValue, IHashable, IComparable
{
    Value: Integer;
}

// The number of segments of a polyline, at least one (at least three for a
// closed edge: ClosedEdgeMinimum). Removes: a segment count passed where a
// sample count is expected. Invariant: Value >= 1.
type SegmentCount
    implements IValue, IHashable, IComparable
{
    Value: Integer;
}

// The number of points of a polyline: its segments plus one, so at least two.
// Removes: the off-by-one at every polyline's end. Invariant: Value >= 2.
type SampleCount
    implements IValue, IHashable, IComparable
{
    Value: Integer;
}

// A refinement round, counted from zero. Removes: a round counter compared
// with a segment floor. Invariant: Value >= 0.
type Round
    implements IValue, IHashable, IComparable
{
    Value: Integer;
}

// A recursion or subdivision depth, counted from zero at the root. Removes: a
// depth compared with a count of items. Invariant: Value >= 0.
type Depth
    implements IValue, IHashable, IComparable
{
    Value: Integer;
}

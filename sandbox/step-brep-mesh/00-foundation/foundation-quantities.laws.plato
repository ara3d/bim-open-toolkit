//==
// # Lengths, areas, volumes, ratios, and measures (laws)
//
// One statement per law; a leading `? :` guard makes a law vacuously true
// where its precondition fails. Laws that compare computed Numbers allow the
// arithmetic resolution at their magnitude (layer 0's ResolutionAt), never a
// literal epsilon.
//
// Sections, in order:
//  - Helpers
//  - Units
//  - Powers of a length
//  - Scaling
//  - Fractions and resolution
//  - Measures

library BrepFoundationQuantitiesLaws
{
    //==
    // # Helpers

    // True when a and b differ by no more than the resolution at their
    // magnitude: equal up to rounding.
    CatalogAgreesToRounding(a: Number, b: Number): Boolean
        => (a - b).Abs <= ResolutionAt(a.Abs.Max(b.Abs)).Value;

    // One of the six length units, chosen by k (any Integer): the runner
    // cannot build a sum, so laws over units take a selector.
    CatalogUnitAt(k: Integer): LengthUnit
    {
        var i = (k % 6 + 6) % 6;
        return i == 0 ? LengthUnit.Metre
            : (i == 1 ? LengthUnit.Millimetre
            : (i == 2 ? LengthUnit.Centimetre
            : (i == 3 ? LengthUnit.Inch
            : (i == 4 ? LengthUnit.Foot
            : LengthUnit.Scaled(0.3)))));
    }

    //==
    // # Units

    // A length converted to metres and back is the length, up to rounding.
    Law_UnitRoundTrips(l: ModelLength, k: Integer): Boolean
        => CatalogAgreesToRounding(l.ToMetres(CatalogUnitAt(k)).ToModel(CatalogUnitAt(k)).Value, l.Value);

    //==
    // # Powers of a length

    // The root of a square is the length's magnitude.
    Law_SquaredThenSqrtIsMagnitude(l: ModelLength): Boolean
        => CatalogAgreesToRounding(l.Squared.Sqrt.Value, l.Value.Abs);

    // A squared distance is never negative.
    Law_SquaredDistanceIsNonNegative(a: Point3D, b: Point3D): Boolean
        => SquaredDistance(a, b).Value >= 0.0;

    //==
    // # Scaling

    // Scaling a length by f scales the area of its square by f^2.
    Law_AreaScalesBySquare(l: ModelLength, f: PowerOfTwo): Boolean
        => CatalogAgreesToRounding(l.AreaOfSquare.ScaledBy(f).Value, l.ScaledBy(f).AreaOfSquare.Value);

    // Scaling a length by f scales the volume of its cube by f^3.
    Law_VolumeScalesByCube(l: ModelLength, f: PowerOfTwo): Boolean
        => CatalogAgreesToRounding(l.VolumeOfCube.ScaledBy(f).Value, l.ScaledBy(f).VolumeOfCube.Value);

    // Scaling by f, then by f's inverse, gives the length back.
    Law_ScaledThenUnscaledIsIdentity(l: ModelLength, f: PowerOfTwo): Boolean
        => CatalogAgreesToRounding(l.ScaledBy(f).ScaledBy(f.Inverse).Value, l.Value);

    // A factor times its inverse's factor is one.
    Law_FactorTimesInverseIsOne(f: PowerOfTwo): Boolean
        => CatalogAgreesToRounding(f.Factor * f.Inverse.Factor, 1.0);

    //==
    // # Fractions and resolution

    // FractionOf always lies in [0, 1].
    Law_FractionOfIsInUnitInterval(x: Number): Boolean
        => FractionOf(x).Value >= 0.0 && FractionOf(x).Value <= 1.0;

    // FractionOf keeps a value already in [0, 1].
    Law_FractionOfKeepsUnitValues(x: Number): Boolean
        => x >= 0.0 && x <= 1.0 ? FractionOf(x).Value == x : true;   // exact by construction

    // A resolution is positive at every magnitude.
    Law_ResolutionIsPositive(magnitude: Number): Boolean
        => ResolutionAt(magnitude).Value > 0.0;

    //==
    // # Measures

    // A length measures as a length.
    Law_ToMeasureKeepsLengthKind(l: ModelLength): Boolean
        => ToMeasure(l).Kind == MeasureKind.LengthKind;

    // A length is never within an angle bound, whatever the numbers.
    Law_LengthIsNeverWithinAngleBound(l: ModelLength, a: Angle): Boolean
        => !ToMeasure(l).IsWithin(ToMeasure(a));

    // A measure is within a bound equal to itself.
    Law_MeasureIsWithinItself(l: ModelLength): Boolean
        => ToMeasure(l).IsWithin(ToMeasure(l));
}

//==
// # Typed indices
//
// Layer 0 of the STEP B-rep to mesh design. Every reference in the library is
// a typed index into one flat table, so an index into the edge table cannot be
// passed where a face is meant. Each is a single Integer; a negative Value
// (conventionally -1, written BrepEdgeIndex(-1)) means "none". IsNone,
// IsPresent, Hash, ordering, xs[i] and xs.IsValidIndex(i) come from the
// stdlib's generic IIndex functions (collections.library.plato) and are not
// redeclared. Mesh vertex and face indices are the stdlib's VertexIndex and
// FaceIndex; CornerIndex is the stdlib's too, and a corner slot is an Integer.
//
// Sections, in order:
//  - Geometry arena
//  - Topology tables
//  - STEP file
//  - Mesh

//==
// # Geometry arena

// A 3D curve: a position in the geometry arena's curve table (layer 1,
// GeometrySet.Curves).
type CurveIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

// A 2D curve in some surface's parameter space: a position in the arena's 2D
// curve table (GeometrySet.Curves2D).
type Curve2DIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

// A pcurve, a 2D curve paired with the surface whose parameter space it lies
// in: a position in GeometrySet.Pcurves.
type PcurveIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

// A surface: a position in GeometrySet.Surfaces.
type SurfaceIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

//==
// # Topology tables

// A B-rep vertex: a position in BrepModel.Vertices (layer 2).
type BrepVertexIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

// A B-rep edge: a position in BrepModel.Edges.
type BrepEdgeIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

// A B-rep loop: a position in BrepModel.Loops.
type BrepLoopIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

// A B-rep face: a position in BrepModel.Faces.
type BrepFaceIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

// A shell: a position in BrepModel.Shells.
type ShellIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

// A body (a solid or a shell set): a position in BrepModel.Bodies.
type BodyIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

//==
// # STEP file

// A Part 21 entity instance name: the n of "#n" in the file, not a position in
// any table. Instance names are positive, so -1 still means none.
type StepInstanceId
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

// An attribute value: a position in the attribute arena of a parsed Part 21
// file (layer 3, Part21File.Attributes).
type StepAttributeIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

// An occurrence of a STEP instance in the decoded assembly tree: a position
// in layer 3's ProvenanceMap.Occurrences. -1 means none (the parent of a root
// occurrence).
type StepOccurrenceIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

//==
// # Mesh

// A mesh element: a position in the concatenation of a mesh's triangles and
// then its quads, so element k is Triangles[k] when k < Triangles.Count and
// Quads[k - Triangles.Count] otherwise (layer 6, ModelMesh).
type ElementIndex
    implements IValue, IHashable, IComparable, IIndex
{
    Value: Integer;
}

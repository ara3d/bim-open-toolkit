//==
// # Lengths, areas, volumes, ratios, and measures (functions)
//
// Constructors, conversions and orders for foundation-quantities.types.plato.
//
// Sections, in order:
//  - Orders
//  - Units
//  - Powers of a length
//  - Scaling
//  - Fractions and resolution
//  - Measures

library BrepFoundationQuantities
{
    //==
    // # Orders

    // The order of lengths in one unit.
    LessThanOrEquals(a: ModelLength, b: ModelLength): Boolean
        => a.Value <= b.Value;

    // The order of lengths in metres.
    LessThanOrEquals(a: Metres, b: Metres): Boolean
        => a.Value <= b.Value;

    // The order of squared lengths.
    LessThanOrEquals(a: SquaredLength, b: SquaredLength): Boolean
        => a.Value <= b.Value;

    // The order of areas.
    LessThanOrEquals(a: AreaMeasure, b: AreaMeasure): Boolean
        => a.Value <= b.Value;

    // The order of volumes.
    LessThanOrEquals(a: VolumeMeasure, b: VolumeMeasure): Boolean
        => a.Value <= b.Value;

    // The order of ratios.
    LessThanOrEquals(a: Ratio, b: Ratio): Boolean
        => a.Value <= b.Value;

    // The order of fractions.
    LessThanOrEquals(a: Fraction, b: Fraction): Boolean
        => a.Value <= b.Value;

    // The order of resolutions.
    LessThanOrEquals(a: Resolution, b: Resolution): Boolean
        => a.Value <= b.Value;

    //==
    // # Units

    // The length l, in model unit `unit`, in metres. Layer 2's ScaleToMetres
    // gives the length of one unit in metres.
    ToMetres(l: ModelLength, unit: LengthUnit): Metres
        => Metres(l.Value * unit.ScaleToMetres);

    // The length m, in metres, in model unit `unit`: the inverse of ToMetres.
    // Precondition: unit.ScaleToMetres is positive.
    ToModel(m: Metres, unit: LengthUnit): ModelLength
        => ModelLength(m.Value / unit.ScaleToMetres);

    //==
    // # Powers of a length

    // The square of a length.
    Squared(l: ModelLength): SquaredLength
        => SquaredLength(l.Value * l.Value);

    // The squared distance between two model positions.
    SquaredDistance(a: Point3D, b: Point3D): SquaredLength
        => SquaredLength((b - a).LengthSquared);

    // The length whose square is sq. Precondition: sq.Value >= 0.
    Sqrt(sq: SquaredLength): ModelLength
        => ModelLength(sq.Value.Sqrt);

    // The area of a square with side l.
    AreaOfSquare(l: ModelLength): AreaMeasure
        => AreaMeasure(l.Value * l.Value);

    // The volume of a cube with side l.
    VolumeOfCube(l: ModelLength): VolumeMeasure
        => VolumeMeasure(l.Value * l.Value * l.Value);

    //==
    // # Scaling

    // 2^Exponent, built by exact halvings or doublings.
    Factor(p: PowerOfTwo): Number
    {
        var x = 1.0;
        var k = p.Exponent;
        while (k > 0)
        {
            x = x * 2.0;
            k = k - 1;
        }
        while (k < 0)
        {
            x = x * 0.5;
            k = k + 1;
        }
        return x;
    }

    // The factor that undoes p.
    Inverse(p: PowerOfTwo): PowerOfTwo
        => PowerOfTwo(0 - p.Exponent);

    // A length scaled by f.
    ScaledBy(l: ModelLength, f: PowerOfTwo): ModelLength
        => ModelLength(l.Value * f.Factor);

    // A squared length scaled by f: by f^2.
    ScaledBy(s: SquaredLength, f: PowerOfTwo): SquaredLength
        => SquaredLength(s.Value * f.Factor * f.Factor);

    // An area scaled by f: by f^2.
    ScaledBy(a: AreaMeasure, f: PowerOfTwo): AreaMeasure
        => AreaMeasure(a.Value * f.Factor * f.Factor);

    // A volume scaled by f: by f^3.
    ScaledBy(v: VolumeMeasure, f: PowerOfTwo): VolumeMeasure
        => VolumeMeasure(v.Value * f.Factor * f.Factor * f.Factor);

    //==
    // # Fractions and resolution

    // x clamped into [0, 1]: the only constructor of a Fraction.
    FractionOf(x: Number): Fraction
        => Fraction(x.Max(0.0).Min(1.0));

    //==
    // # Measures

    // A length as a measure.
    ToMeasure(l: ModelLength): Measure
        => Measure(l.Value, MeasureKind.LengthKind);

    // An angle as a measure, in radians.
    ToMeasure(a: Angle): Measure
        => Measure(a.Radians, MeasureKind.AngleKind);

    // An area as a measure.
    ToMeasure(a: AreaMeasure): Measure
        => Measure(a.Value, MeasureKind.AreaKind);

    // A volume as a measure.
    ToMeasure(v: VolumeMeasure): Measure
        => Measure(v.Value, MeasureKind.VolumeKind);

    // A count as a measure.
    ToMeasure(c: Count): Measure
        => Measure(c.Value.ToNumber, MeasureKind.CountKind);

    // A ratio as a measure.
    ToMeasure(r: Ratio): Measure
        => Measure(r.Value, MeasureKind.RatioKind);

    // A curve parameter as a measure.
    ToMeasure(t: CurveParameter): Measure
        => Measure(t.Value, MeasureKind.ParameterKind);

    // True when a and b have one dimension, so one may be graded against the
    // other.
    IsComparableWith(a: Measure, b: Measure): Boolean
        => a.Kind == b.Kind;

    // True when a measure is within a bound of the same kind; false for a
    // bound of another kind.
    IsWithin(worst: Measure, bound: Measure): Boolean
        => worst.IsComparableWith(bound) ? worst.Value <= bound.Value : false;
}

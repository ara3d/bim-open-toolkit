//==
// # Budgets and elapsed time: invariants and constructors
//
// SPEC-DSL.md section 3. Not compiled; each invariant cites the law in
// foundation-budgets.laws.plato that checks it.

spec TimeBudget
{
    invariant self.Milliseconds >= 0;   // Law_TimeBudgetIsNonNegative
    constructor TimeBudgetOf;
}

spec Elapsed
{
    invariant self.Milliseconds >= 0;   // Law_ElapsedIsNonNegative
    constructor ElapsedOf;
}

spec WorkBudget
{
    invariant self.Evaluations >= 0;
    invariant self.Insertions >= 0;
    invariant self.Flips >= 0;
    invariant self.Projections >= 0;   // Law_WorkBudgetIsNonNegative
    invariant self.WorkTotal >= 0;
    constructor WorkBudgetOf;
    constructor NoWork;
    constructor Add;                   // Law_WorkTotalIsAdditive
}

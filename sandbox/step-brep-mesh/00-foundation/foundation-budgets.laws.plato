//==
// # Budgets and elapsed time (laws)
//
// The laws of foundation-budgets.library.plato, over Integers (moved from
// catalog-validation at the catalog merge, validation, 2026-10-20). Each is
// exact: budgets are whole numbers.
//
// Sections, in order:
//  - Time
//  - Work

library BrepFoundationBudgetsLaws
{
    //==
    // # Time

    // A time budget is never negative.
    Law_TimeBudgetIsNonNegative(ms: Integer): Boolean
        => TimeBudgetOf(ms).Milliseconds >= 0;

    // An elapsed time is never negative.
    Law_ElapsedIsNonNegative(ms: Integer): Boolean
        => ElapsedOf(ms).Milliseconds >= 0;

    // A run within its budget is within any larger budget.
    Law_WithinBudgetIsMonotone(e: Integer, b: Integer, extra: Integer): Boolean
        => ElapsedOf(e).IsWithin(TimeBudgetOf(b))
            ? ElapsedOf(e).IsWithin(TimeBudgetOf(b + extra.Max(0)))
            : true;

    //==
    // # Work

    // Every count of a work budget is at least zero.
    Law_WorkBudgetIsNonNegative(a: Integer, b: Integer, c: Integer, d: Integer): Boolean
    {
        var w = WorkBudgetOf(a, b, c, d);
        return w.Evaluations >= 0 && w.Insertions >= 0 && w.Flips >= 0 && w.Projections >= 0;
    }

    // The total of two steps' work is the sum of their totals.
    Law_WorkTotalIsAdditive(a: Integer, b: Integer, c: Integer, d: Integer): Boolean
        => Add(WorkBudgetOf(a, b, c, d), WorkBudgetOf(d, c, b, a)).WorkTotal
            == WorkBudgetOf(a, b, c, d).WorkTotal + WorkBudgetOf(d, c, b, a).WorkTotal;

    // Work is within any budget it was added to.
    Law_WorkIsWithinItsSum(a: Integer, b: Integer, c: Integer, d: Integer): Boolean
        => WorkBudgetOf(a, b, c, d).IsWithin(Add(WorkBudgetOf(a, b, c, d), WorkBudgetOf(d, c, b, a)));
}

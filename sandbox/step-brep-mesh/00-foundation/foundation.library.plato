//==
// # BrepFoundation
//
// Layer 0 of the STEP B-rep to mesh design (README.md beside this file): the
// arithmetic every other layer leans on. Almost every body here is its own
// specification; nothing is deferred. Contracts are in foundation.spec.plato,
// laws in foundation.laws.plato.
//
// Sections, in order:
//  - Arithmetic resolution
//  - Tolerances
//  - Parameter tolerance at a point
//  - Approximate equality
//  - Periodic arithmetic
//  - Curve domains
//  - Surface domains and their sides
//  - Sampling
//  - Provenance
//  - Severity
//  - Checks
//  - Diagnostics and reports
//  - Identity of copied values
//  - Integer folds
//  - Equivalence classes

library BrepFoundation
{
    //==
    // # Arithmetic resolution
    //
    // Number has finite precision: a 32-bit float in the C# backend today
    // (PLATO-PRIMER.md D.1), 64-bit in the design's intent. A tolerance below
    // the rounding error at the magnitude of the values it compares cannot be
    // honoured, so laws state their rounding bound with ResolutionAt instead of
    // a literal epsilon.

    // The unit roundoff of Number: the largest power of two u with 1 + u == 1,
    // so that every arithmetic operation rounds with relative error at most u.
    // 2^-53 for a 64-bit Number, 2^-24 for a 32-bit one. Not Number.Epsilon,
    // which is the smallest positive subnormal in the C# backend
    // (float.Epsilon). The comparisons here define u; they compare nothing.
    RoundingUnit(_: Number): Number
    {
        var u = 1.0;
        while (1.0 + u != 1.0)
        {
            u = u * 0.5;
        }
        return u;
    }

    // The smallest positive normal Number: 2^-1022 (about 2.2e-308) in 64
    // bits, 2^-126 (about 1.2e-38) in 32. Below it the spacing of Numbers is
    // fixed rather than proportional, so relative error bounds fail. x is
    // halved while x / 2 is still normal; a power of two y is normal exactly
    // when adding y * 2u to it changes it.
    SmallestNormal(_: Number): Number
    {
        var step = Number.RoundingUnit * 2.0;
        var x = 1.0;
        while (x * 0.5 + x * 0.5 * step != x * 0.5)
        {
            x = x * 0.5;
        }
        return x;
    }

    // The smallest difference this design treats as resolvable between values
    // whose magnitude is at most |magnitude|: 32 unit roundoffs of it, sixteen
    // spacings of adjacent Numbers, and never less than the smallest normal
    // Number. The functions of this layer err by at most about 14 unit
    // roundoffs (README, "Arithmetic resolution"), so a difference this large
    // is never rounding noise. At magnitude 1e5 it is 3.6e-10 for a 64-bit
    // Number and 0.19 for a 32-bit one.
    ResolutionAt(magnitude: Number): Number
        => (magnitude.Abs * Number.RoundingUnit * 32.0).Max(Number.SmallestNormal);

    // True when the length tolerance is no smaller than the arithmetic
    // resolution at the magnitude: a model whose coordinates reach 1e5 mm can
    // honour a 1e-6 mm tolerance with a 64-bit Number and cannot with a 32-bit
    // one.
    IsResolvable(t: LengthTolerance, magnitude: Number): Boolean
        => t.Value >= ResolutionAt(magnitude);

    // True when the parameter tolerance is no smaller than the arithmetic
    // resolution at the parameter magnitude.
    IsResolvable(t: ParameterTolerance, magnitude: Number): Boolean
        => t.Value >= ResolutionAt(magnitude);

    // The Number that marks a measure that was not, or could not be, taken:
    // NaN. Every comparison with it is false, so a check built on it fails, and
    // it is never turned into a zero.
    Unmeasured(_: Number): Number
        => 0.0 / 0.0;

    //==
    // # Tolerances
    //
    // "Positive" for a tolerance means finite and at least the smallest normal
    // Number (ResolutionAt(0.0)): a tolerance of 1e-310 is positive in the
    // reals and has no relative precision in the arithmetic.

    // True when the length tolerance is a positive finite length.
    IsWellFormed(t: LengthTolerance): Boolean
        => t.Value.IsFinite && t.Value >= ResolutionAt(0.0);

    // True when the angle tolerance is a positive finite angle.
    IsWellFormed(t: AngleTolerance): Boolean
        => t.Value.Radians.IsFinite && t.Value.Radians >= ResolutionAt(0.0);

    // True when the parameter tolerance is a positive finite number.
    IsWellFormed(t: ParameterTolerance): Boolean
        => t.Value.IsFinite && t.Value >= ResolutionAt(0.0);

    // True when both directions' parameter tolerances are well formed.
    IsWellFormed(t: UvTolerance): Boolean
        => t.U.IsWellFormed && t.V.IsWellFormed;

    // True when all of a model's tolerances, both parameter floors included,
    // are well formed.
    IsWellFormed(t: Tolerances): Boolean
        => t.Length.IsWellFormed
            && t.Angle.IsWellFormed
            && t.LengthParameter.IsWellFormed
            && t.AngleParameter.IsWellFormed;

    // The smallest length this model can tell apart from zero at its
    // coordinates: the length tolerance, raised to the arithmetic resolution
    // at the coordinate extent (the largest absolute coordinate) when the
    // file's tolerance is finer than the Numbers can resolve there. Both
    // parameter floors divide it by a speed.
    ResolvableLength(length: LengthTolerance, extent: Number): Number
        => length.Value.Max(ResolutionAt(extent));

    // The parameter floor of a length parameter (a line's, a cylinder's
    // height, an extrusion's depth), Tolerances.LengthParameter: the
    // resolvable length over the speed of a unit-speed parameterization, 1.
    // extent is the coordinate extent (layer 2's CoordinateExtent). Scales
    // with the model: doubling the length tolerance and the extent doubles it
    // (Law_LengthParameterFloorScalesWithModel). Example: 1e-6 mm at
    // coordinates within 1000 mm gives 1e-6 mm; at survey coordinates of 5e9
    // mm it gives the resolution there, 1.8e-5 mm.
    LengthParameterFloor(length: LengthTolerance, extent: Number): ParameterTolerance
        => ParameterTolerance(length.ResolvableLength(extent));

    // The parameter floor of an angle parameter (a circle's, a sphere's
    // longitude and latitude), Tolerances.AngleParameter, in radians: the
    // resolvable length over the largest radius an analytic surface of the
    // model has, at most the model size (layer 2's ModelSize, the diagonal of
    // the bounding box), and never below the resolution of angle values,
    // which reach two turns. Dimensionless, so scaling the model leaves it
    // unchanged (Law_AngleParameterFloorIgnoresScale). Example: 1e-6 mm over
    // a 1000 mm model gives 1e-9 rad.
    AngleParameterFloor(length: LengthTolerance, modelSize: Number, extent: Number): ParameterTolerance
    {
        var r = length.ResolvableLength(extent);
        return ParameterTolerance((r / modelSize.Max(r)).Max(ResolutionAt(Number.Tau * 2.0)));
    }

    // The tolerances of a model scaled by factor: the length tolerance and the
    // length parameter floor scaled (LengthParameterFloor doubles
    // when the length and the extent double), the angle tolerance and the
    // angle parameter floor kept (AngleParameterFloor ignores scale).
    ScaledTolerances(t: Tolerances, factor: Number): Tolerances
        => Tolerances(
            LengthTolerance(t.Length.Value * factor),
            t.Angle,
            ParameterTolerance(t.LengthParameter.Value * factor),
            t.AngleParameter);

    //==
    // # Parameter tolerance at a point
    //
    // The decision recorded in README "The parameter tolerance": the tolerance
    // on a parameter is the length tolerance pulled back through the
    // parameterization, so it depends on the point. Layer 1 applies these
    // functions with the speeds it evaluates; layers 2, 4 and 5 consume the
    // results.

    // The parameter tolerance at a point where a unit change of the parameter
    // moves the point by `speed` model units (|c'(t)| on a curve, |dS/du| on a
    // surface): Length / speed, so that a parameter step within it moves the
    // point by at most the length tolerance to first order; lowered to `cap`
    // where that quotient would exceed it (at a pole the speed is zero and
    // every parameter value is the same point); raised to `floor`, the model's
    // floor for this direction's kind (t.LengthParameter or t.AngleParameter,
    // chosen by layer 1). A sphere of radius 100 with Length 1e-3 gets 1e-5
    // rad in u at the equator, 5.7e-3 rad at latitude 89.9 degrees, and the
    // cap pi at the pole.
    ParameterToleranceAt(t: Tolerances, floor: ParameterTolerance, speed: Number, cap: Number): ParameterTolerance
        => ParameterTolerance((speed * cap > t.Length.Value ? t.Length.Value / speed : cap).Max(floor.Value));

    // True when speed is a finite non-negative speed and cap a finite positive
    // cap: ParameterToleranceAt's precondition on its two numbers.
    IsSpeedAndCap(speed: Number, cap: Number): Boolean
        => speed.IsFinite && speed >= 0.0 && cap.IsFinite && cap > 0.0;

    // The largest parameter tolerance a direction admits: half the period for
    // a periodic or closed direction (no two parameters of a loop are farther
    // apart around it), the range's length for a bounded aperiodic one, and
    // the largest Number for an unbounded one.
    ParameterToleranceCap(d: CurveDomain): Number
        => match (d.Periodicity)
        {
            Aperiodic => d.ParameterLength.IsFinite ? d.ParameterLength : Number.MaxValue;
            Periodic(period) => period * 0.5;
            Closed(period) => period * 0.5;
        };

    // The parameter tolerance in each direction of a surface at a point where
    // dS/du has length speedU and dS/dv has length speedV, with floor.U and
    // floor.V the floors of the two directions' kinds (a cylinder: the angle
    // floor in u, the length floor in v). Each direction gets half the length
    // tolerance, so a displacement within both moves the point by at most
    // |dS/du| |du| + |dS/dv| |dv| <= Length to first order, by the triangle
    // inequality, whatever the angle between the two partials.
    UvToleranceAt(t: Tolerances, floor: UvTolerance, speedU: Number, speedV: Number, d: SurfaceDomain): UvTolerance
        => UvTolerance(
            t.ParameterToleranceAt(floor.U, speedU * 2.0, d.U.ParameterToleranceCap),
            t.ParameterToleranceAt(floor.V, speedV * 2.0, d.V.ParameterToleranceCap));

    //==
    // # Approximate equality
    //
    // Each relation is reflexive and symmetric and not transitive: a and b
    // within t, b and c within t, give a and c within 2t only
    // (Law_CoincidenceComposesWithSummedTolerance).

    // True when a and b are the same point within the length tolerance: their
    // distance is at most t.
    Coincident(a: Point3D, b: Point3D, t: LengthTolerance): Boolean
        => a.Distance(b) <= t.Value;

    // True when a and b are the same point within a model's length tolerance.
    Coincident(a: Point3D, b: Point3D, t: Tolerances): Boolean
        => a.Coincident(b, t.Length);

    // True when two points of a plane measured in model length units are the
    // same point within the length tolerance.
    Coincident(a: Point2D, b: Point2D, t: LengthTolerance): Boolean
        => a.Distance(b) <= t.Value;

    // The angle between two directions, in [0, pi], as atan2(|a x b|, a . b).
    // Unlike the acos of the dot product, which cannot resolve angles below
    // about 1.5e-8 rad in 64 bits (3.5e-4 rad in 32), it keeps its relative
    // precision for small angles. Scale-invariant, so an unnormalized
    // Direction3D gives the right angle; a zero vector gives 0.
    AngleBetweenDirections(a: Direction3D, b: Direction3D): Angle
        => a.Vector.Cross(b.Vector).Length.Atan2(a.Vector.Dot(b.Vector));

    // True when a and b are the same direction within the angle tolerance.
    SameDirection(a: Direction3D, b: Direction3D, t: AngleTolerance): Boolean
        => a.AngleBetweenDirections(b) <= t.Value;

    // True when a and b are the same direction within a model's angle
    // tolerance.
    SameDirection(a: Direction3D, b: Direction3D, t: Tolerances): Boolean
        => a.SameDirection(b, t.Angle);

    // True when two values of one aperiodic parameter are the same within t.
    // For a periodic parameter use the CurveDomain form, which measures around
    // the circle. There is deliberately no form taking Tolerances: the model's
    // parameter fields are floors, not the tolerance at a point.
    SameParameter(a: Number, b: Number, t: ParameterTolerance): Boolean
        => (a - b).Abs <= t.Value;

    // True when a and b are the same parameter of the domain d within t,
    // measured around the loop when d is periodic or closed: 0.01 and 6.28 are
    // the same angle within 0.01 on a circle, and the two ends of a closed
    // B-spline's range are the same parameter. Precondition: CanWrap(b - a,
    // period) when d has a seam.
    SameParameter(d: CurveDomain, a: Number, b: Number, t: ParameterTolerance): Boolean
        => match (d.Periodicity)
        {
            Aperiodic => a.SameParameter(b, t);
            Periodic(period) => PeriodicDistance(a, b, period) <= t.Value;
            Closed(period) => PeriodicDistance(a, b, period) <= t.Value;
        };

    // True when two parameter-space points are within t.U in u and within t.V
    // in v: a box, not a disc, because the two directions carry different
    // units.
    SameParameter(a: UvCoordinate, b: UvCoordinate, t: UvTolerance): Boolean
        => a.U.SameParameter(b.U, t.U) && a.V.SameParameter(b.V, t.V);

    // True when two parameter-space points are within t in both directions.
    SameParameter(a: UvCoordinate, b: UvCoordinate, t: ParameterTolerance): Boolean
        => a.SameParameter(b, UvTolerance(t, t));

    // True when a and b are the same point of the surface domain d within t,
    // measured around the loop in each periodic or closed direction.
    SameParameter(d: SurfaceDomain, a: UvCoordinate, b: UvCoordinate, t: UvTolerance): Boolean
        => d.U.SameParameter(a.U, b.U, t.U) && d.V.SameParameter(a.V, b.V, t.V);

    //==
    // # Periodic arithmetic
    //
    // A periodic parameter lives on the circle R / (period Z). Wrap picks the
    // representative in [0, period); ShortestDifference is the signed step
    // along the shorter arc; NearestUnwrapped lifts a value next to a
    // reference, which is how a loop of parameters is unwrapped.
    //
    // A Closed direction's point set is the same circle, so every function
    // that reasons about seams sees its Period as a period: HasSeam, PeriodOr,
    // ParameterToleranceCap, SameParameter, IsFullPeriod, CanWrap, Wrap,
    // NearestUnwrapped and ContainsParameter on a CurveDomain, and their
    // SurfaceDomain forms. Only IsPeriodic, which says the formula itself
    // wraps, is false for it: a closed B-spline is evaluated only inside its
    // range, so a caller wraps (Wrap) before it evaluates.

    // True when the parameter's period is well formed: aperiodic, or a
    // positive finite period.
    IsWellFormed(p: Periodicity): Boolean
        => match (p)
        {
            Aperiodic => true;
            Periodic(period) => period.IsFinite && period > 0.0;
            Closed(period) => period.IsFinite && period > 0.0;
        };

    // True when the formula wraps: the curve or surface can be evaluated at
    // any parameter, t + Period giving the point of t. False for Closed.
    IsPeriodic(p: Periodicity): Boolean
        => match (p)
        {
            Aperiodic => false;
            Periodic(period) => true;
            Closed(period) => false;
        };

    // True when the point set wraps, so the two ends of one period are one
    // seam: Periodic or Closed. The test every seam, unwrapping, winding, and
    // edge-domain decision reads.
    HasSeam(p: Periodicity): Boolean
        => match (p)
        {
            Aperiodic => false;
            Periodic(period) => true;
            Closed(period) => true;
        };

    // The period of a periodic or closed parameter, or fallback when the
    // parameter is aperiodic.
    PeriodOr(p: Periodicity, fallback: Number): Number
        => match (p)
        {
            Aperiodic => fallback;
            Periodic(period) => period;
            Closed(period) => period;
        };

    // True when Wrap(t, period) is computable to within rounding: t and the
    // period are finite and the period exceeds the arithmetic resolution at t,
    // which keeps t / period far inside the range where Floor is exact. Wrap's
    // precondition.
    CanWrap(t: Number, period: Number): Boolean
        => t.IsFinite && period.IsFinite && period > ResolutionAt(t);

    // t reduced into [0, period) by removing whole periods: the canonical
    // representative of t on the circle of circumference period. The two
    // corrections absorb the rounding of t / period next to a multiple of the
    // period. Wrap(7.0, 2 pi) is 0.7168...; Wrap(-0.5, 2 pi) is 5.7831....
    // Precondition: CanWrap(t, period).
    Wrap(t: Number, period: Number): Number
    {
        var r = t - period * (t / period).Floor;
        var s = r < 0.0 ? r + period : r;
        return s >= period ? s - period : s;
    }

    // The signed shortest step from `from` to `to` on the circle of
    // circumference period: the d in [-period/2, period/2) with to = from + d
    // modulo the period; a tie at exactly half a period goes to -period/2. The
    // half-period test doubles w instead of halving the period, so it is exact.
    // ShortestDifference(6.0, 0.5, 2 pi) is 0.7832.... Precondition:
    // CanWrap(to - from, period).
    ShortestDifference(from: Number, to: Number, period: Number): Number
    {
        var w = (to - from).Wrap(period);
        return w + w < period ? w : w - period;
    }

    // The distance between a and b on the circle of circumference period: the
    // length of the shorter arc, in [0, period/2]. The quotient metric.
    // Precondition: CanWrap(b - a, period).
    PeriodicDistance(a: Number, b: Number, period: Number): Number
        => ShortestDifference(a, b, period).Abs;

    // The copy t + k * period nearest to reference: reference plus the
    // shortest step from reference to t. NearestUnwrapped(0.1, 6.2, 2 pi) is
    // 6.3831.... Precondition: CanWrap(t - reference, period).
    NearestUnwrapped(t: Number, reference: Number, period: Number): Number
        => reference + ShortestDifference(reference, t, period);

    // The copy of t in (reference, reference + period]: the end of a range
    // that starts at reference and runs forward around the circle to t. A t
    // congruent to reference gives a full period, reference + period. Layer
    // 2's edge domains use it. PeriodicRepresentativeAbove(0.5, 5.5, 2 pi)
    // is 6.7831.... Precondition: CanWrap(t - reference, period).
    PeriodicRepresentativeAbove(t: Number, reference: Number, period: Number): Number
    {
        var w = (t - reference).Wrap(period);
        return w > 0.0 ? reference + w : reference + period;
    }

    //==
    // # Curve domains

    // The length of the domain's range, End - Start; 0 for an inverted range
    // and infinite for an unbounded one. The measure of the parameter
    // interval, not the arc length of a curve over it.
    ParameterLength(d: CurveDomain): Number
        => (d.Range.End - d.Range.Start).Max(0.0);

    // True when the domain can be sampled and meshed: a finite length (so
    // neither infinite ends nor ends at -MaxValue and MaxValue), longer than
    // the tolerance, a well-formed periodicity, and, when periodic, no longer
    // than one period plus the tolerance. An edge on a full circle has length
    // exactly one period and is proper.
    IsProper(d: CurveDomain, t: ParameterTolerance): Boolean
        => d.Range.Start.IsFinite
            && d.Range.End.IsFinite
            && d.ParameterLength.IsFinite
            && d.Range.End - d.Range.Start > t.Value
            && d.Periodicity.IsWellFormed
            && d.ParameterLength <= d.Periodicity.PeriodOr(d.ParameterLength) + t.Value;

    // True when the domain has a seam (periodic or closed) and spans one
    // whole period within t: a closed curve, or an edge that goes all the way
    // round.
    IsFullPeriod(d: CurveDomain, t: ParameterTolerance): Boolean
        => match (d.Periodicity)
        {
            Aperiodic => false;
            Periodic(period) => (d.ParameterLength - period).Abs <= t.Value;
            Closed(period) => (d.ParameterLength - period).Abs <= t.Value;
        };

    // True when the domain's formula wraps: its periodicity is Periodic, not
    // Closed and not Aperiodic. The CurveDomain form of IsPeriodic, a match on
    // d.Periodicity itself for the reason HasSeam(d) gives.
    IsPeriodicDomain(d: CurveDomain): Boolean
        => match (d.Periodicity)
        {
            Aperiodic => false;
            Periodic(period) => true;
            Closed(period) => false;
        };

    // The domain of an unbounded aperiodic parameter, the whole real line,
    // with the largest finite Numbers as its ends, the stdlib's convention for
    // an unbounded box (Bounds3D.Empty): a line, a plane, the v of a cylinder.
    // ParameterLength is infinite on it, so IsProper rejects it and Samples
    // does not take it.
    UnboundedDomain(_: CurveDomain): CurveDomain
        => CurveDomain(NumberInterval(Number.MinValue, Number.MaxValue), Periodicity.Aperiodic);

    // True when the domain has a seam: its periodicity is Periodic or Closed.
    // A match on d.Periodicity itself, for callers whose match subject the
    // sum checker cannot type through an overloaded chain (CHK304).
    HasSeam(d: CurveDomain): Boolean
        => match (d.Periodicity)
        {
            Aperiodic => false;
            Periodic(period) => true;
            Closed(period) => true;
        };

    // The domain form of Wrap's precondition: t is finite, and when the
    // domain has a seam its period is resolvable at t's offset from the range
    // start.
    CanWrap(d: CurveDomain, t: Number): Boolean
        => match (d.Periodicity)
        {
            Aperiodic => t.IsFinite;
            Periodic(period) => (t - d.Range.Start).CanWrap(period);
            Closed(period) => (t - d.Range.Start).CanWrap(period);
        };

    // t moved by whole periods into [Range.Start, Range.Start + period) when
    // the domain has a seam; t itself when it does not. On a closed domain the
    // result lies in the range within rounding
    // (Law_WrapOnClosedDomainStaysInRange), so it can be evaluated.
    // Precondition: d.CanWrap(t).
    Wrap(d: CurveDomain, t: Number): Number
        => match (d.Periodicity)
        {
            Aperiodic => t;
            Periodic(period) => d.Range.Start + (t - d.Range.Start).Wrap(period);
            Closed(period) => d.Range.Start + (t - d.Range.Start).Wrap(period);
        };

    // The copy of t nearest to reference when the domain has a seam; t itself
    // when it does not. On a closed domain the copy may lie outside the range:
    // it is a coordinate for unwrapping, and is wrapped before it is
    // evaluated. Precondition: CanWrap(t - reference, period) when the domain
    // has a seam.
    NearestUnwrapped(d: CurveDomain, t: Number, reference: Number): Number
        => match (d.Periodicity)
        {
            Aperiodic => t;
            Periodic(period) => t.NearestUnwrapped(reference, period);
            Closed(period) => t.NearestUnwrapped(reference, period);
        };

    // True when t lies in the domain within the tolerance: in [Start - tol,
    // End + tol], or, when the domain has a seam, some copy t + k * period
    // does. On the edge domain [5.5, 7.0] of a circle, 0.5 is contained (as
    // 6.783...). Precondition: d.CanWrap(t).
    ContainsParameter(d: CurveDomain, t: Number, tol: ParameterTolerance): Boolean
        => match (d.Periodicity)
        {
            Aperiodic => d.Range.Start - tol.Value <= t && t <= d.Range.End + tol.Value;
            Periodic(period) => d.Range.ContainsPeriodic(t, period, tol);
            Closed(period) => d.Range.ContainsPeriodic(t, period, tol);
        };

    // The periodic case of ContainsParameter: the copy w of t in [Start, Start
    // + period) is at most End + tol, or the copy one period below it is at
    // least Start - tol (t lies just below Start).
    ContainsPeriodic(r: NumberInterval, t: Number, period: Number, tol: ParameterTolerance): Boolean
    {
        var w = r.Start + (t - r.Start).Wrap(period);
        return w <= r.End + tol.Value || w - period >= r.Start - tol.Value;
    }

    // The copies of parameter b strictly inside the range r: b itself on an
    // aperiodic domain when inside, and on a domain with a seam every b + k
    // period inside (at most two, since an edge domain spans at most one
    // period). Moved from layer 4 on 2026-10-18 so that layer 2 can use it.
    CopiesInside(d: CurveDomain, b: Number, r: NumberInterval): Array<Number>
    {
        var period = d.Periodicity.PeriodOr(0.0);
        var first = period > 0.0 ? b.PeriodicRepresentativeAbove(r.Start, period) : b;
        var copies = period > 0.0 ? [first, first + period] : [first];
        return copies.FlatMap(t => (t > r.Start && t < r.End) ? [t] : copies.Take(0));
    }

    //==
    // # Surface domains and their sides

    // True when both directions of the surface domain are proper.
    IsProper(d: SurfaceDomain, t: UvTolerance): Boolean
        => d.U.IsProper(t.U) && d.V.IsProper(t.V);

    // True when both coordinates of uv can be wrapped on the domain.
    CanWrap(d: SurfaceDomain, uv: UvCoordinate): Boolean
        => d.U.CanWrap(uv.U) && d.V.CanWrap(uv.V);

    // uv with each periodic or closed coordinate wrapped into its direction's
    // fundamental interval. Precondition: d.CanWrap(uv).
    Wrap(d: SurfaceDomain, uv: UvCoordinate): UvCoordinate
        => UvCoordinate(d.U.Wrap(uv.U), d.V.Wrap(uv.V));

    // uv with each periodic or closed coordinate replaced by its copy nearest
    // to the reference's: the step that unwraps a loop of parameter-space
    // points across a seam.
    NearestUnwrapped(d: SurfaceDomain, uv: UvCoordinate, reference: UvCoordinate): UvCoordinate
        => UvCoordinate(d.U.NearestUnwrapped(uv.U, reference.U), d.V.NearestUnwrapped(uv.V, reference.V));

    // True when uv lies in the surface domain within the tolerance, around the
    // loop in each periodic or closed direction. Precondition: d.CanWrap(uv).
    ContainsParameter(d: SurfaceDomain, uv: UvCoordinate, t: UvTolerance): Boolean
        => d.U.ContainsParameter(uv.U, t.U) && d.V.ContainsParameter(uv.V, t.V);

    // True for the two sides of constant u (UMin, UMax), which run along v.
    IsUSide(s: DomainSide): Boolean
        => match (s)
        {
            UMin => true;
            UMax => true;
            VMin => false;
            VMax => false;
        };

    // The side across the rectangle: the other copy of a seam.
    OppositeSide(s: DomainSide): DomainSide
        => match (s)
        {
            UMin => DomainSide.UMax;
            UMax => DomainSide.UMin;
            VMin => DomainSide.VMax;
            VMax => DomainSide.VMin;
        };

    // The parameter value that is constant along the side: U.Range.Start on
    // UMin, V.Range.End on VMax.
    SideValue(d: SurfaceDomain, s: DomainSide): Number
        => match (s)
        {
            UMin => d.U.Range.Start;
            UMax => d.U.Range.End;
            VMin => d.V.Range.Start;
            VMax => d.V.Range.End;
        };

    // The range of the other parameter along the side: V.Range along a u side,
    // U.Range along a v side.
    SideRange(d: SurfaceDomain, s: DomainSide): NumberInterval
        => s.IsUSide ? d.V.Range : d.U.Range;

    // The parameter-space point on side s where the other parameter is along:
    // (U.Range.Start, along) on UMin, (along, V.Range.End) on VMax. Face
    // meshing uses it for synthetic seam and pole points.
    SidePoint(d: SurfaceDomain, s: DomainSide, along: Number): UvCoordinate
        => s.IsUSide ? UvCoordinate(d.SideValue(s), along) : UvCoordinate(along, d.SideValue(s));

    //==
    // # Sampling

    // count equally spaced values from range.Start to range.End, both ends
    // included and copied, not computed: element i is Start + (End - Start) *
    // i / (count - 1), computed from i and never by accumulating a step, so
    // the error does not grow along the array. Samples((0, 1), 5) is [0,
    // 0.25, 0.5, 0.75, 1]. Precondition: count >= 2, both ends finite, and
    // End - Start finite: on [-MaxValue, MaxValue], the range layer 1 gives an
    // unbounded direction, End - Start overflows and every interior sample is
    // infinite.
    Samples(range: NumberInterval, count: Integer): Array<Number>
        => count.MapRange(i =>
            i == 0
                ? range.Start
                : (i == count - 1
                    ? range.End
                    : range.Start + (range.End - range.Start) * (i.ToNumber / (count - 1).ToNumber)));

    // True when the range's length is finite and each of the count - 1 equal
    // steps of range exceeds the arithmetic resolution at its ends; then
    // Samples(range, count) is strictly increasing. False on an unbounded
    // range, whose length overflows.
    StepsAreResolvable(range: NumberInterval, count: Integer): Boolean
        => count >= 2
            ? range.Start.IsFinite
                && range.End.IsFinite
                && (range.End - range.Start).IsFinite
                && (range.End - range.Start) / (count - 1).ToNumber > ResolutionAt(range.Start.Abs.Max(range.End.Abs))
            : false;

    // plan.Count samples of the domain's range, ends included. On a full
    // periodic domain the two ends are the same point, sampled twice.
    // Precondition: d.ParameterLength is finite. A law over an unbounded
    // direction (a line, a plane, the v of a cylinder) samples a bounded
    // window instead: the edge's domain, or the face's parameter box.
    Samples(d: CurveDomain, plan: SamplePlan): Array<Number>
        => d.Range.Samples(plan.Count);

    // A plan.Count by plan.Count grid over the surface domain, u varying
    // fastest: point k is (u sample k % Count, v sample k / Count).
    Samples(d: SurfaceDomain, plan: SamplePlan): Array<UvCoordinate>
    {
        var us = d.U.Samples(plan);
        var vs = d.V.Samples(plan);
        return (plan.Count * plan.Count).MapRange(k => UvCoordinate(us[k % plan.Count], vs[k / plan.Count]));
    }

    // True when the plan takes at least the two ends.
    IsWellFormed(p: SamplePlan): Boolean
        => p.Count >= 2;

    //==
    // # Provenance

    // The model object a mesh vertex sits on, for a diagnostic; drops the
    // parameter, so lossy.
    ToProvenance(p: MeshVertexProvenance): Provenance
        => match (p)
        {
            OnVertex(vertex) => Provenance.KernelVertex(vertex);
            OnEdge(edge, parameter) => Provenance.KernelEdge(edge);
            OnFace(face, uv) => Provenance.KernelFace(face);
        };

    // True when the mesh vertex lies in the interior of face f: its carrier
    // is f itself, not one of f's edges or vertices. Layers 5 and 6 test the
    // provenance of face-interior points with it.
    IsOnFace(p: MeshVertexProvenance, f: BrepFaceIndex): Boolean
        => match (p)
        {
            OnVertex(vertex) => false;
            OnEdge(edge, parameter) => false;
            OnFace(face, uv) => face == f;
        };

    // The dimension of the cell a mesh vertex sits on: 0 for a model vertex,
    // 1 for an edge interior, 2 for a face interior. The global mesh vertex
    // numbering (layer 6) orders vertices by it.
    CarrierDimension(p: MeshVertexProvenance): Integer
        => match (p)
        {
            OnVertex(vertex) => 0;
            OnEdge(edge, parameter) => 1;
            OnFace(face, uv) => 2;
        };

    //==
    // # Severity

    // True for severity Error.
    IsError(s: Severity): Boolean
        => match (s)
        {
            Error => true;
            Warning => false;
            Info => false;
        };

    // The severity of a failed check with this worst measure and bound
    // (SPEC-DSL.md section 4): Error for a topological law; for a geometric
    // law, Warning while the worst measure stays below ten times the bound and
    // Error from there on, or when it is unmeasured; Info for a quality
    // threshold.
    SeverityOf(g: ConstraintGroup, worst: Number, bound: Number): Severity
        => match (g)
        {
            Topological => Severity.Error;
            Geometric => worst < bound * 10.0 ? Severity.Warning : Severity.Error;
            Quality => Severity.Info;
        };

    //==
    // # Checks

    // The check of a measured law at one sample, or over samples that share
    // one bound: it holds exactly when worst <= bound, and it keeps the bound.
    // worst is the largest measure seen, larger meaning worse, or
    // Number.Unmeasured, which fails. Precondition: bound is a finite
    // non-negative Number.
    CheckWithin(law: String, worst: Number, bound: Number, where: Provenance): Check
        => Check(law, worst <= bound, worst, bound, where);

    // The check of an exact law: Worst is 0 when it holds and 1 when it
    // fails, against the bound 0.
    CheckExact(law: String, holds: Boolean, where: Provenance): Check
        => Check(law, holds, holds ? 0.0 : 1.0, 0.0, where);

    // How far the check's Worst is past its own Bound, as a multiple of the
    // bound: Worst / Bound for a positive bound; for the bound 0 of an exact
    // law, 0 when Worst <= 0 and infinity otherwise. NaN when Worst is. The
    // measure SeverityOf grades, so comparing it, not the raw Worst, ranks
    // samples whose per-point bounds differ.
    Exceedance(c: Check): Number
        => c.Bound > 0.0 ? c.Worst / c.Bound : (c.Worst > 0.0 ? 1.0 / 0.0 : (c.Worst.IsNaN ? c.Worst : 0.0));

    // True when a is at least as bad as b: a failing check outranks a holding
    // one; between two that agree on that, an unmeasured Worst outranks a
    // measured one, and a larger Exceedance a smaller. A total preorder, which
    // is what makes WorseOf associative.
    Outranks(a: Check, b: Check): Boolean
        => a.Holds != b.Holds
            ? !a.Holds
            : (a.Worst.IsNaN ? true : (b.Worst.IsNaN ? false : a.Exceedance >= b.Exceedance));

    // The worse of two checks of one law, the left one on a tie: the fold
    // that turns per-sample checks into one Check, keeping the bound of the
    // sample it keeps. Seed the fold with CheckExact(law, true,
    // Provenance.Nowhere). Precondition: a.Law == b.Law.
    WorseOf(a: Check, b: Check): Check
        => a.Outranks(b) ? a : b;

    //==
    // # Diagnostics and reports

    // The finding for a failed check: severity from the constraint group and
    // the check's own Worst and Bound, the law's name as the code, the
    // check's provenance, its Worst as the measure. Precondition: the check
    // failed.
    DiagnosticOf(c: Check, g: ConstraintGroup, message: String): Diagnostic
        => Diagnostic(g.SeverityOf(c.Worst, c.Bound), c.Law, message, c.Where, c.Worst);

    // The report with no checks and no diagnostics: Merge's identity.
    Empty(_: Report): Report
        => Report([], []);

    // a's checks then b's, and a's diagnostics then b's.
    Merge(a: Report, b: Report): Report
        => Report(a.Checks.Concatenate(b.Checks), a.Diagnostics.Concatenate(b.Diagnostics));

    // The report of one check: the check, and its diagnostic when it failed.
    // The one place a Check becomes a Diagnostic; the bound is the check's
    // own.
    ReportOf(c: Check, g: ConstraintGroup, message: String): Report
        => Report([c], (c.Holds ? 0 : 1).MapRange(i => c.DiagnosticOf(g, message)));

    // The report of findings that no check produced, such as a decoder's
    // diagnostics for unsupported entities.
    ReportOf(diagnostics: Array<Diagnostic>): Report
        => Report([], diagnostics);

    // The number of diagnostics with severity Error.
    ErrorCount(r: Report): Integer
        => r.Diagnostics.Reduce(0, (n, d) => d.Severity.IsError ? n + 1 : n);

    // True when no diagnostic has severity Error: the verdict of a validation.
    IsClean(r: Report): Boolean
        => !r.Diagnostics.Any(d => d.Severity.IsError);

    // The diagnostic located at where when its own provenance is Nowhere;
    // unchanged otherwise. A stage that knows what a finding is about (the
    // face it was meshing, the whole input) locates the findings of the
    // functions it called.
    Located(d: Diagnostic, where: Provenance): Diagnostic
        => d.Where == Provenance.Nowhere
            ? Diagnostic(d.Severity, d.Code, d.Message, where, d.Measure)
            : d;

    // The report with every diagnostic whose provenance is Nowhere located at
    // where. Checks, codes, and severities are kept, so every failed check
    // keeps its diagnostic and IsClean is unchanged: the fourth constructor of
    // Report beside Empty, Merge, and ReportOf.
    Located(r: Report, where: Provenance): Report
        => Report(r.Checks, r.Diagnostics.Map(d => d.Located(where)));

    //==
    // # Identity of copied values
    //
    // Record equality in the generated C# compares arrays by reference, and
    // NaN equals nothing, so reports are compared with these instead of ==.

    // True when a and b are the same Number, every NaN counting as the same as
    // every NaN: the equality of a value with its copy, the executable form of
    // SPEC-DSL.md's "exact by construction". Never a comparison of computed
    // values.
    Identical(a: Number, b: Number): Boolean
        => a == b || (a.IsNaN && b.IsNaN);

    // True when two checks agree field by field.
    Identical(a: Check, b: Check): Boolean
        => a.Law == b.Law
            && a.Holds == b.Holds
            && a.Worst.Identical(b.Worst)
            && a.Bound.Identical(b.Bound)
            && a.Where == b.Where;

    // True when two diagnostics agree field by field.
    Identical(a: Diagnostic, b: Diagnostic): Boolean
        => a.Severity == b.Severity
            && a.Code == b.Code
            && a.Message == b.Message
            && a.Where == b.Where
            && a.Measure.Identical(b.Measure);

    // True when two reports hold identical checks and identical diagnostics in
    // the same order.
    Identical(a: Report, b: Report): Boolean
        => a.Checks.Corresponds(b.Checks, (x, y) => x.Identical(y))
            && a.Diagnostics.Corresponds(b.Diagnostics, (x, y) => x.Identical(y));

    // True when xs and ys have the same count and same(xs[i], ys[i]) holds at
    // every i. The count is compared first, so no index is out of range.
    Corresponds(xs: Array<$T>, ys: Array<$T>, same: Function2<$T, $T, Boolean>): Boolean
        => xs.Count == ys.Count ? xs.Count.Range.All(i => same(xs[i], ys[i])) : false;

    //==
    // # Integer folds

    // The sum of an array of integers; 0 for an empty array. Counting
    // functions in layers 3 and 6 fold with it.
    IntegerTotal(xs: Array<Integer>): Integer
        => xs.Reduce(0, (a, b) => a + b);

    //==
    // # Equivalence classes
    //
    // The union-find that layers 2 and 6 run over vertices, edge ends, faces
    // and mesh elements (their "deferred: union-find" notes), written once.
    // Items are 0 to n - 1; a join is a pair of items at one position of two
    // arrays. Joining always hangs the larger root under the smaller, so the
    // root of a class is its smallest item, whatever the join order.

    // The root of every item: the smallest item of its class under the
    // equivalence generated by joining first[k] with second[k] for every k.
    // A pair with an item outside 0 to n - 1 is ignored. Precondition:
    // first.Count == second.Count, n >= 0.
    ClassRoots(n: Integer, first: Array<Integer>, second: Array<Integer>): Array<Integer>
    {
        var parent = new Buffer<Integer>(n);
        var i = 0;
        while (i < n)
        {
            parent = parent.Set(i, i);
            i = i + 1;
        }
        var k = 0;
        while (k < first.Count)
        {
            var x = first[k];
            var y = second[k];
            if (x >= 0 && x < n && y >= 0 && y < n)
            {
                while (parent.At(x) != x)
                {
                    x = parent.At(x);
                }
                while (parent.At(y) != y)
                {
                    y = parent.At(y);
                }
                if (x < y)
                {
                    parent = parent.Set(y, x);
                }
                else
                {
                    parent = parent.Set(x, y);
                }
            }
            k = k + 1;
        }
        var roots = new Buffer<Integer>(n);
        var j = 0;
        while (j < n)
        {
            var r = j;
            while (parent.At(r) != r)
            {
                r = parent.At(r);
            }
            roots = roots.Set(j, r);
            j = j + 1;
        }
        return roots.Freeze();
    }

    // The number of classes ClassRoots found: the items that are their own
    // root.
    ClassCount(roots: Array<Integer>): Integer
        => roots.Count.Range.Reduce(0, (c, i) => roots[i] == i ? c + 1 : c);
}

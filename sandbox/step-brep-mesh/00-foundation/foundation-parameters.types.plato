//==
// # Parameters, angles, and parameter ranges
//
// TYPE-CATALOG.md section 2 (layers 0 and 1). One type per parameter space,
// so a pcurve is never evaluated at a 3D curve's parameter and a seam is never
// crossed by a range written with swapped ends.
//
// Sections, in order:
//  - Curve parameters
//  - Positions along an edge
//  - Angles
//  - Ranges
//  - Iso-lines

//==
// # Curve parameters

// A parameter on a 3D curve's own domain (a CurveIndex). Removes: a 3D
// curve evaluated at a pcurve's parameter.
type CurveParameter
    implements IValue, IOrderable
{
    Value: Number;
}

// A parameter on a parameter-plane curve (a Curve2DIndex). Not the 3D
// curve's parameter even for a matching pcurve; PcurveRangeOver maps between
// them. Removes: a pcurve evaluated at a 3D curve's parameter.
type Curve2DParameter
    implements IValue, IOrderable
{
    Value: Number;
}

// A parameter on an edge's domain (layer 2's EdgeDomain), increasing from
// Start to End: what EdgeDiscretization.Parameters holds. Removes: a reversed
// coedge's sample taken at the un-reversed parameter.
type EdgeParameter
    implements IValue, IOrderable
{
    Value: Number;
}

// A value in a B-spline's knot domain. Removes: a knot span index used as a
// parameter.
type KnotParameter
    implements IValue, IOrderable
{
    Value: Number;
}

//==
// # Positions along an edge

// A position along an edge by length from its start. Removes: a midpoint
// computed as the parameter midpoint on a curve whose speed varies.
type ArcLength
    implements IValue, IOrderable
{
    Value: ModelLength;
}

// A position along a range as a fraction of it: 0 at Start, 1 at End.
// Removes: a fraction of a range used as a parameter of the curve.
type NormalizedParameter
    implements IValue, IOrderable
{
    Value: Fraction;
}

//==
// # Angles

// An angle wrapped into [0, 2 pi): a point on the circle. Removes: the seam
// bug, a loop point at 2 pi - e joined to one at 0 + e across the whole
// domain. Wrap and NearestUnwrapped are the only conversions.
// Invariant: 0 <= Value.Radians < 2 pi.
type WrappedAngle
    implements IValue
{
    Value: Angle;
}

// An angle lifted off the circle: may exceed one turn, may be negative.
// Removes: a lifted angle compared with a wrapped one.
type UnwrappedAngle
    implements IValue
{
    Value: Angle;
}

//==
// # Ranges

// A parameter range with Start <= End by construction (RangeOf sorts).
// Removes: a NumberInterval that is empty because its ends were swapped.
// Invariant: Start <= End.
type ParameterRange
    implements IValue
{
    Start: Number;
    End: Number;
}

// A parameter range in traversal order: may decrease, for a coedge run
// against its edge. Removes: a traversal's direction lost by sorting.
type DirectedRange
    implements IValue, IReversible
{
    Start: Number;
    End: Number;
}

// A range on a periodic direction: Start, a length in [0, Period], and the
// Period. Length is exactly one Period for a closed edge. Removes: a range
// given as [5.9, 0.4] meaning "across the seam". Invariant: Period > 0 and
// 0 <= Length <= Period.
type PeriodicRange
    implements IValue
{
    Start: Number;
    Length: Number;
    Period: Number;
}

//==
// # Iso-lines

// A line of constant u or v in a surface's natural parameters: Constant
// names the parameter held fixed and At its value, so (ParameterU, 0.5) is
// the line u = 0.5 along which v runs. Removes: "the v-line at u" and "the
// u-line at v" confused in pole and seam code.
type IsoLine
    implements IValue
{
    Constant: SurfaceParameter;
    At: Number;
}

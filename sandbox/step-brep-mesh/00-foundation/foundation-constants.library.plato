//==
// # Arithmetic resolution as closed forms (complexity sweep, chunk I1)
//
// RoundingUnit and SmallestNormal (foundation.library.plato) find their values
// by halving: about 53 + 1,022 halvings under cpu64 and 24 + 126 under gpu32,
// and ResolutionAt runs both on every call, inside projection polish loops,
// CanWrap and per-sample sign tests. The constants here compute the same two
// powers of two from the profile's representation limits in five operations,
// with no loop, so one expression serves both profiles where a literal could
// serve only one.
//
// The halving loops stay as the definitions the constants are checked against
// (RoundingUnitByHalving, SmallestNormalByHalving), in counted form so the
// work the constants remove is a number.
//
// Sections, in order:
//  - Closed forms
//  - The halving definitions
//  - Counted forms

library BrepFoundationConstants
{
    //==
    // # Closed forms
    //
    // For a binary format with p significand bits (hidden bit included) and
    // largest exponent E: u = 2^-p, Number.MaxValue = 2^E (2 - 2^(1-p)), and
    // Number.Epsilon, the smallest positive subnormal, is 2^(2 - E - p).
    // cpu64: p = 53, E = 1023; gpu32: p = 24, E = 127.

    // The unit roundoff, 2^-53 under cpu64 and 2^-24 under gpu32, bit for bit
    // the value RoundingUnitByHalving finds. MaxValue * Epsilon is exactly
    // 8u(1 - u) (1 - u has p bits, so the product is representable); a quarter
    // of it is 2u - 2u^2. 1 + 2u - 2u^2 lies 2u^2 below 1 + 2u, the next
    // Number above 1, and 2u - 2u^2 above 1, so it rounds to 1 + 2u.
    // Subtracting 1 is then exact and leaves 2u.
    RoundingUnitConstant(_: Number): Number
        => (1.0 + Number.MaxValue * Number.Epsilon * 0.25 - 1.0) * 0.5;

    // The smallest positive normal Number, 2^-1022 under cpu64 and 2^-126
    // under gpu32: the smallest subnormal 2^(2 - E - p) over 2u = 2^(1 - p).
    // Division by a power of two with a normal result is exact.
    SmallestNormalConstant(_: Number): Number
        => Number.Epsilon / (Number.RoundingUnitConstant * 2.0);

    // ResolutionAt's expression over the closed forms: the same operations in
    // the same order, so the same Resolution bit for bit.
    ResolutionAtConstant(magnitude: Number): Resolution
        => Resolution((magnitude.Abs * Number.RoundingUnitConstant * 32.0).Max(Number.SmallestNormalConstant));

    //==
    // # The halving definitions
    //
    // RoundingUnit's and SmallestNormal's loops as foundation.library.plato
    // writes them, counting each halving as a Flip. They define the two values
    // (foundation.spec.plato states the comparisons); the closed forms above
    // are checked against them, and they are never on a hot path.

    // The largest power of two u with 1 + u == 1, and the halvings it took.
    RoundingUnitByHalvingCounted(_: Number): Counted<Number>
    {
        var u = 1.0;
        var halvings = 0;
        while (1.0 + u != 1.0)
        {
            u = u * 0.5;
            halvings = halvings + 1;
        }
        return Counted(u, Flips(halvings));
    }

    // The smallest power of two x whose half is not normal (adding half * 2u
    // to the half leaves it unchanged), and the halvings it took, those of
    // RoundingUnitByHalvingCounted included, as SmallestNormal calls
    // RoundingUnit.
    SmallestNormalByHalvingCounted(_: Number): Counted<Number>
    {
        var unit = Number.RoundingUnitByHalvingCounted;
        var step = unit.Value * 2.0;
        var x = 1.0;
        var halvings = unit.Work.Flips;
        while (x * 0.5 + x * 0.5 * step != x * 0.5)
        {
            x = x * 0.5;
            halvings = halvings + 1;
        }
        return Counted(x, Flips(halvings));
    }

    RoundingUnitByHalving(_: Number): Number
        => Number.RoundingUnitByHalvingCounted.Value;

    SmallestNormalByHalving(_: Number): Number
        => Number.SmallestNormalByHalvingCounted.Value;

    //==
    // # Counted forms

    // ResolutionAtConstant and the halvings it does: none, at any magnitude.
    ResolutionAtCounted(magnitude: Number): Counted<Resolution>
        => Counted(ResolutionAtConstant(magnitude), Flips(0));

    // ResolutionAt as foundation.library.plato computes it, by halving, and
    // the halvings: those of both loops, on every call.
    ResolutionAtByHalvingCounted(magnitude: Number): Counted<Resolution>
    {
        var unit = Number.RoundingUnitByHalvingCounted;
        var normal = Number.SmallestNormalByHalvingCounted;
        return Counted(Resolution((magnitude.Abs * unit.Value * 32.0).Max(normal.Value)),
            unit.Work.Add(normal.Work));
    }
}

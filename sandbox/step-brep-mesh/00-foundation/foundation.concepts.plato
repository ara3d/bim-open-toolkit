//==
// # Concepts over the foundation types
//
// TYPE-CATALOG.md section 15, the concepts that need only section 1 to 3
// types and the stdlib. One concept states a law once over every type that
// implements it.
//
// Sections, in order:
//  - Transformations
//  - Domains
//  - Indexed tables
//  - Tolerances and provenance
//  - Budgets

//==
// # Transformations

// A value the metamorphic laws scale by a power of two. Law: scaling by f
// then by f's inverse is the identity (ScaledThenUnscaledIsIdentity).
interface IScaled
{
    ScaledBy(x: Self, factor: PowerOfTwo): Self;
}

// A value the metamorphic laws move rigidly.
interface IMoved
{
    Moved(x: Self, motion: Pose3D): Self;
}

// A value with a reverse traversal. Law: reversing twice is the identity
// (ReversedTwiceIsIdentity).
interface IReversible
{
    Reversed(x: Self): Self;
}

//==
// # Domains

// A value defined over a parameter domain: TDomain is CurveDomain or
// SurfaceDomain.
interface IHasDomain<TDomain>
{
    Domain(x: Self): TDomain;
}

//==
// # Indexed tables
//
// No kernel table implements IIndexedTable: the tables are Array<T> fields of BrepModel and
// GeometrySet, Array<T> cannot gain an implements clause, and BrepModel cannot implement it once
// per table because RowCountOf(x: Self) would then have six meanings. The one law over ten
// tables is stated over TableName instead (Law_RowInRangeAgreesWithTable).

// A table of TRow rows addressed by a TIndex typed index: its row count, the row at an index, and
// whether an index names a row. The obligations are not named Count and At, which the stdlib's
// ICountable and IIndexable already own. Removes: a range check written per table.
interface IIndexedTable<TIndex, TRow>
{
    RowCountOf(x: Self): Integer;
    RowAt(x: Self, i: TIndex): TRow;
    IsRowIndex(x: Self, i: TIndex): Boolean;
}

//==
// # Tolerances and provenance

// A value that carries the tolerances it was made under (layer 3's
// PreparedModel, layer 2's ResolvableModel). Removes: a mesh validated under
// a different tolerance from the one it was built with.
interface IToleranced
{
    Tolerance(x: Self): Tolerances;
}

// A value a diagnostic can point at: the kernel element it is about (the
// proofs of layers 2 and 4; Check and Diagnostic discharge it through their
// Where field). Removes: a diagnostic about a checked loop or shell located
// Nowhere.
interface IHasProvenance
{
    Where(x: Self): Provenance;
}

//==
// # Budgets

// A refinement result that reports the work it took, so the termination laws are one law over
// every implementer. Removes: a refinement loop whose cost nobody can state.
interface IBudgeted
{
    Work(x: Self): WorkBudget;
}

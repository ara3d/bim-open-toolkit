//==
// # Tolerances
//
// Layer 0 of the STEP B-rep to mesh design (README.md beside this file). The
// three kinds of coincidence tolerance a B-rep needs, and the record that holds
// a model's own values. A tolerance defines a relation "within t", which is
// reflexive and symmetric but not transitive (README, "Tolerance as a
// relation"); every approximate comparison in the design names one of these.
//
// Sections, in order:
//  - The three tolerances
//  - The model's tolerances

//==
// # The three tolerances

// The largest distance, in the model's length unit, at which two points count
// as the same point: the STEP file's uncertainty_measure_with_unit for length.
// Invariant: Value is positive and finite (Law_LengthTolerancePositive).
type LengthTolerance
    implements IValue
{
    Value: Number;
}

// The largest angle at which two directions count as the same direction.
// Invariant: Value is positive and finite (Law_AngleTolerancePositive).
type AngleTolerance
    implements IValue
{
    Value: Angle;
}

// The largest difference between two values of one curve or surface parameter
// at which they count as the same parameter, in that parameter's own unit
// (radians for an angle parameter, model length units for a length
// parameter). Not one number per model: the parameter tolerance at a point is
// derived from the length tolerance and the local speed of the
// parameterization (ParameterToleranceAt). Invariant: Value is positive and
// finite (Law_ParameterTolerancePositive).
type ParameterTolerance
    implements IValue
{
    Value: Number;
}

// A parameter tolerance for each direction of a surface's parameter space. A
// uv displacement (du, dv) is within it when |du| <= U and |dv| <= V; built by
// UvToleranceAt so that such a displacement moves the surface point by at most
// the length tolerance, to first order. UvCoordinate holds natural parameters
// here (radians, model lengths), not the stdlib's normalized ones.
type UvTolerance
    implements IValue
{
    U: ParameterTolerance;
    V: ParameterTolerance;
}

//==
// # The model's tolerances

// A model's own tolerances, read from the STEP file's geometric context.
// Length is the file's length uncertainty; Angle its plane-angle uncertainty,
// or a decoder default when the file has none. LengthParameter and
// AngleParameter are the model-wide parameter FLOORS, one per kind of
// parameter because the two carry different units: LengthParameter, in model
// lengths, for a direction whose parameter is a length (LengthParameterFloor);
// AngleParameter, in radians, for one whose parameter is an angle
// (AngleParameterFloor). Each is the smallest parameter tolerance used in a
// direction of its kind, never the tolerance at a particular point; layer 1
// picks the floor by the direction's kind. Meshing criteria (chordal, angular,
// length) are separate and user-supplied.
type Tolerances
    implements IValue
{
    Length: LengthTolerance;
    Angle: AngleTolerance;
    LengthParameter: ParameterTolerance;
    AngleParameter: ParameterTolerance;
}

//==
// # Points and boxes (laws)
//
// Sections, in order:
//  - Helpers
//  - Differences
//  - The unit square
//  - The chart
//  - Model points
//  - Boxes and corners

library BrepFoundationPointsLaws
{
    //==
    // # Helpers

    // True when p and q agree in both coordinates up to rounding.
    CatalogUvAgreesToRounding(p: UvPoint, q: UvPoint): Boolean
        => CatalogAgreesToRounding(p.U, q.U) && CatalogAgreesToRounding(p.V, q.V);

    // The aperiodic surface domain over the ranges spanned by the four ends.
    CatalogDomainOf(u0: Number, u1: Number, v0: Number, v1: Number): SurfaceDomain
        => SurfaceDomain(CurveDomain(RangeOf(u0, u1).ToNumberInterval, Periodicity.Aperiodic),
            CurveDomain(RangeOf(v0, v1).ToNumberInterval, Periodicity.Aperiodic));

    // One of the four corners, chosen by k (any Integer).
    CatalogCornerAt(k: Integer): DomainCorner
    {
        var i = (k % 4 + 4) % 4;
        return i == 0 ? DomainCorner.MinMin
            : (i == 1 ? DomainCorner.MaxMin
            : (i == 2 ? DomainCorner.MaxMax : DomainCorner.MinMax));
    }

    //==
    // # Differences

    // A point plus the step to another point is the other point.
    Law_UvDeltaRoundTrips(a: UvPoint, b: UvPoint): Boolean
        => CatalogUvAgreesToRounding(b.Add(a.Subtract(b)), a);

    //==
    // # The unit square

    // A point taken to the unit square and back is the point, for a domain
    // whose two ranges have resolvable length.
    Law_UnitSquareRoundTrips(u0: Number, u1: Number, v0: Number, v1: Number, p: UvPoint): Boolean
        => RangeOf(u0, u1).RangeLength > ResolutionAt(u0.Abs.Max(u1.Abs)).Value && RangeOf(v0, v1).RangeLength > ResolutionAt(v0.Abs.Max(v1.Abs)).Value
            ? (p.U - FromUnitSquare(CatalogDomainOf(u0, u1, v0, v1), ToUnitSquare(CatalogDomainOf(u0, u1, v0, v1), p)).U).Abs
                    <= ResolutionAt(p.U.Abs + u0.Abs + u1.Abs).Value
                && (p.V - FromUnitSquare(CatalogDomainOf(u0, u1, v0, v1), ToUnitSquare(CatalogDomainOf(u0, u1, v0, v1), p)).V).Abs
                    <= ResolutionAt(p.V.Abs + v0.Abs + v1.Abs).Value
            : true;

    //==
    // # The chart

    // A point taken to the chart and back is the point, for positive scales.
    Law_ChartRoundTrips(chart: FaceChart, p: UvPoint): Boolean
        => chart.ScaleU > 0.0 && chart.ScaleV > 0.0
            ? CatalogUvAgreesToRounding(chart.FromChart(chart.ToChart(p)), p)
            : true;

    // A mirrored chart reverses the sign of u and keeps v.
    Law_MirrorNegatesChartX(scaleU: Number, scaleV: Number, p: UvPoint): Boolean
        => FaceChart(true, scaleU, scaleV).ToChart(p).X == 0.0 - FaceChart(false, scaleU, scaleV).ToChart(p).X;   // exact by construction

    //==
    // # Model points

    // Placing a local point is moving it by the placement.
    Law_PlacedIsMoved(p: Point3D, pose: Pose3D): Boolean
        => LocalPoint(p).Placed(pose) == ModelPoint(p).Moved(pose);   // exact by construction

    //==
    // # Boxes and corners

    // The box spanned by two points contains both.
    Law_UvBoxOfContainsBothPoints(a: UvPoint, b: UvPoint): Boolean
        => UvBoxOf(a, b).Contains(a) && UvBoxOf(a, b).Contains(b);

    // The chart box spanned by two chart points contains both.
    Law_ChartBoxOfContainsBothPoints(a: ChartPoint, b: ChartPoint): Boolean
        => ChartBoxOf(a, b).Contains(a) && ChartBoxOf(a, b).Contains(b);

    // Four steps of NextCorner return to the start.
    Law_NextCornerCyclesInFour(k: Integer): Boolean
        => CatalogCornerAt(k).NextCorner.NextCorner.NextCorner.NextCorner == CatalogCornerAt(k);

    // A domain's corners lie in its box.
    Law_CornerIsInDomainBox(k: Integer, u0: Number, u1: Number, v0: Number, v1: Number): Boolean
        => CatalogDomainOf(u0, u1, v0, v1).ToUvBox.Contains(CatalogDomainOf(u0, u1, v0, v1).CornerPoint(CatalogCornerAt(k)));
}

//==
// # Counted work: functions (complexity sweep)
//
// Constructors and arithmetic for foundation-work.types.plato.
//
// Sections, in order:
//  - Counted values
//  - Claims

library BrepFoundationWork
{
    //==
    // # Counted values

    // A counted value is built by its constructor, Counted(value, work), at the
    // use site. (No generic helper: the C# writer does not monomorphize a
    // library function whose first parameter is concrete and whose second is a
    // type variable, "no ground TIR for moved member", found 2026-10-21.)

    // The work of one evaluation, insertion, flip or projection, n times.
    Evaluations(n: Integer): WorkBudget
        => WorkBudget(n.Max(0), 0, 0, 0);

    Insertions(n: Integer): WorkBudget
        => WorkBudget(0, n.Max(0), 0, 0);

    Flips(n: Integer): WorkBudget
        => WorkBudget(0, 0, n.Max(0), 0);

    Projections(n: Integer): WorkBudget
        => WorkBudget(0, 0, 0, n.Max(0));

    //==
    // # Claims

    // A work budget scaled by a size: the most work a slope allows at that size.
    Times(w: WorkBudget, n: Integer): WorkBudget
        => WorkBudget(w.Evaluations * n, w.Insertions * n, w.Flips * n, w.Projections * n);

    // f applied at n. A function-typed parameter is called directly, as CheckGrid
    // calls holds; a function-typed field is not: the interpreter projects a
    // record field only in a call with no other argument (Dispatch.cs, the
    // PlatoRecord case), and the checker cannot type a local bound to one
    // (CHK101). So the field is projected alone and passed here.
    MeasureAt(n: Integer, f: Function1<Integer, WorkBudget>): WorkBudget
        => f(n);

    // The work the claim's function measures at size n.
    MeasuredAt(c: WorkClaim, n: Integer): WorkBudget
        => MeasureAt(n, c.WorkAt);

    // True when the work measured at every size is within Slope times that size.
    HoldsAtEverySize(c: WorkClaim): Boolean
        => c.Sizes.All(n => c.MeasuredAt(n).IsWithin(c.Slope.Times(n)));

    // True when the claim names at least two sizes, in increasing order.
    HasGrowingSizes(c: WorkClaim): Boolean
        => c.Sizes.Count >= 2
            && (c.Sizes.Count - 1).Range.All(i => c.Sizes[i] < c.Sizes[i + 1]);
}

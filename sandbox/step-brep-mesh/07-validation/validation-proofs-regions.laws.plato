//==
// # Laws of the parameter-space proofs (layer 5)
//
// Two laws per proof type of 05-face-meshing/face-meshing-proofs.types.plato,
// as in validation-proofs-kernel.laws.plato. The runner cannot build a
// UvLoop, so the laws build squares (counter-clockwise for a positive side,
// clockwise for a negative one) and a bow-tie from its Numbers, and take
// faces of this layer's witnesses (CatalogProofModelAt).
//
// Sections, in order:
//  - Loops
//  - Simple loops
//  - Closed loops
//  - Oriented regions

library BrepCheckingProofsRegionsLaws
{
    //==
    // # Loops

    // The square with corner (x, y) and side s, as an interior loop:
    // counter-clockwise when s is positive, clockwise when negative.
    CatalogSquareLoop(x: Number, y: Number, s: Number): UvLoop
        => UvLoop(
            [UvCoordinate(x, y), UvCoordinate(x + s, y), UvCoordinate(x + s, y + s), UvCoordinate(x, y + s)],
            [UvPointSource.Interior, UvPointSource.Interior, UvPointSource.Interior, UvPointSource.Interior]);

    // A unit bow-tie at (x, y): its first and third sides cross.
    CatalogBowtieLoop(x: Number, y: Number): UvLoop
        => UvLoop(
            [UvCoordinate(x, y), UvCoordinate(x + 1.0, y + 1.0), UvCoordinate(x + 1.0, y), UvCoordinate(x, y + 1.0)],
            [UvPointSource.Interior, UvPointSource.Interior, UvPointSource.Interior, UvPointSource.Interior]);

    // Loop k: a unit square at (x, y) for an even k, the bow-tie for an odd.
    CatalogLoopAt(k: Integer, x: Number, y: Number): UvLoop
        => ((k % 2) + 2) % 2 == 0 ? CatalogSquareLoop(x, y, 1.0) : CatalogBowtieLoop(x, y);

    // The region with outer square (x, y, s) and one hole: the square of
    // side -s / 2 a quarter side inside it, wound against the outer.
    CatalogRegionAt(x: Number, y: Number, s: Number): UvRegion
        => UvRegion(CatalogSquareLoop(x, y, s), [CatalogSquareLoop(x + 0.75 * s, y + 0.25 * s, -0.5 * s)]);

    //==
    // # Simple loops

    // CheckSimpleUvLoop succeeds exactly when the loop, as a region with
    // no holes, is simple under the tolerance.
    Law_SimpleUvLoopIffSimpleRegion(k: Integer, x: Number, y: Number, tol: UvTolerance): Boolean
        => (tol.U.Value > 0.0 && tol.V.Value > 0.0)
            ? CheckSimpleUvLoop(CatalogLoopAt(k, x, y), tol).IsDecided
                == UvRegion(CatalogLoopAt(k, x, y), [CatalogLoopAt(k, x, y)].Take(0)).IsSimpleRegion(tol)
            : true;

    // A SimpleUvLoop keeps the loop and the tolerance it was checked under.
    Law_SimpleUvLoopRecordsTolerance(k: Integer, x: Number, y: Number, tol: UvTolerance): Boolean
        => (tol.U.Value > 0.0 && tol.V.Value > 0.0)
            ? CatalogSimpleUvLoopRecords(CatalogLoopAt(k, x, y), tol, CheckSimpleUvLoop(CatalogLoopAt(k, x, y), tol))
            : true;

    // The claim of Law_SimpleUvLoopRecordsTolerance for the result
    // d of checking loop l under tol.
    CatalogSimpleUvLoopRecords(l: UvLoop, tol: UvTolerance, d: DecidedSimpleUvLoop): Boolean
        => match (d) {
            Decided(p) => p.Tolerance == tol && p.Loop.Points.Count == l.Points.Count;
            Undecided(r) => true;
        };

    // The bow-tie is never simple, under any tolerance: the check refuses
    // it.
    Law_BowtieIsNotSimple(x: Number, y: Number, tol: UvTolerance): Boolean
        => (tol.U.Value > 0.0 && tol.V.Value > 0.0)
            ? CheckSimpleUvLoop(CatalogBowtieLoop(x, y), tol).IsDecided.Not
            : true;

    //==
    // # Closed loops

    // CheckClosedUvLoop succeeds exactly when the face is intact and the
    // loop winds zero times in u and in v.
    Law_ClosedUvLoopIffUnwound(k: Integer, f: Integer, x: Number, y: Number, s: Number): Boolean
    {
        var m = CatalogProofModelAt(k);
        var i = BrepFaceIndex(f);
        var l = CatalogSquareLoop(x, y, s);
        return CheckClosedUvLoop(m, i, l).IsDecided
            == (m.IsFaceIntact(i) ? (m.UWinding(i, l) == 0 && m.VWinding(i, l) == 0) : false);
    }

    // A ClosedUvLoop names its face and keeps its loop.
    Law_ClosedUvLoopRecordsFace(k: Integer, f: Integer, x: Number, y: Number, s: Number): Boolean
        => CatalogClosedUvLoopRecords(BrepFaceIndex(f), CatalogSquareLoop(x, y, s),
            CheckClosedUvLoop(CatalogProofModelAt(k), BrepFaceIndex(f), CatalogSquareLoop(x, y, s)));

    // The claim of Law_ClosedUvLoopRecordsFace for the result d of
    // checking loop l of face f.
    CatalogClosedUvLoopRecords(f: BrepFaceIndex, l: UvLoop, d: DecidedClosedUvLoop): Boolean
        => match (d) {
            Decided(p) => p.Face == f && p.Loop.Points.Count == l.Points.Count;
            Undecided(r) => true;
        };

    //==
    // # Oriented regions

    // CheckOrientedUvRegion succeeds exactly when the face is intact, the
    // outer loop is positive in its chart, and every hole negative.
    Law_OrientedUvRegionIffWindings(k: Integer, f: Integer, x: Number, y: Number, s: Number): Boolean
    {
        var m = CatalogProofModelAt(k);
        var i = BrepFaceIndex(f);
        var r = CatalogRegionAt(x, y, s);
        return CheckOrientedUvRegion(m, i, r).IsDecided
            == (m.IsFaceIntact(i)
                ? (m.UvRegionWindingPositive(i, r) && r.Holes.Count.Range.All(h => Law_UvHoleWindingNegative(m, i, r, h)))
                : false);
    }

    // An OrientedUvRegion names its face and keeps its holes.
    Law_OrientedUvRegionRecordsFace(k: Integer, f: Integer, x: Number, y: Number, s: Number): Boolean
        => CatalogOrientedUvRegionRecords(BrepFaceIndex(f), CatalogRegionAt(x, y, s),
            CheckOrientedUvRegion(CatalogProofModelAt(k), BrepFaceIndex(f), CatalogRegionAt(x, y, s)));

    // The claim of Law_OrientedUvRegionRecordsFace for the result d
    // of checking region r of face f.
    CatalogOrientedUvRegionRecords(f: BrepFaceIndex, r: UvRegion, d: DecidedOrientedUvRegion): Boolean
        => match (d) {
            Decided(p) => p.Face == f && p.Region.Holes.Count == r.Holes.Count;
            Undecided(r2) => true;
        };
}

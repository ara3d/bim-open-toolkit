//==
// # The Green oracle computed once per face (complexity sweep, chunk L5)
//
// Replacements for layer 07's Green area and divergence volume readers (validation-oracles,
// validation-checks-cross, validation.laws): each face's boundary is built twice, at n and at 2n
// chords, and every reader takes the value, the allowance and the area tolerance from that one
// GreenEstimate (green-once.types.plato). The paths are built in List builders instead of a
// Concatenate or Append inside a Reduce. Results are bit-identical to the originals
// (green-once.laws.plato, the agreement laws). At merge each original points at its replacement
// (TRACK.md).
//
// Sections, in order:
//  - Guards
//  - Building the boundary
//  - Face areas
//  - Shell and body volumes
//  - Readers: tolerance, tube, solid volume, Gauss-Bonnet
//  - Checks

library BrepOraclesOnce
{
    //==
    // # Guards

    // The whole-model part of CanGreen: every index of the model in range and the arena well
    // formed. Computed once per model by a reader that runs the oracle on many faces.
    GreenModelOk(m: BrepModel): Boolean
        => m.IsEveryIndexInRange ? m.Geometry.IsWellFormed : false;

    // CanGreen with its whole-model part given (ok = m.GreenModelOk): the face intact and no
    // poly loop.
    CanGreenGiven(m: BrepModel, f: BrepFaceIndex, ok: Boolean): Boolean
        => ok ? (m.IsFaceIntact(f) ? m.Faces[f].Bounds.All(b => m.Loops[b.Loop].IsPolyLoop.Not) : false) : false;

    //==
    // # Building the boundary
    //
    // GreenBoundary, with the lifted paths built in List builders and the curve evaluations and
    // projections counted: each coedge sample is one curve evaluation and one projection; a
    // vertex loop projects its vertex and, through FaceReferenceV, the start vertex of every
    // coedge of the face.

    // GreenBoundary(f, n), and the evaluations and projections it made (as Evaluations).
    GreenBoundaryCounted(m: BrepModel, f: BrepFaceIndex, n: Integer): Counted<Array<GreenSegment>>
    {
        var counted = m.Faces[f].Bounds.Count.MapRange(j => m.GreenPathsOfLoopCounted(f, j, n, m.Loops[m.Faces[f].Bounds[j].Loop]));
        var paths = counted.FlatMap(c => c.Value);
        var evaluations = counted.Reduce(0, (k, c) => k + c.Work.Evaluations);
        return Counted(paths.FlatMap(p => p.PathSegments)
                .Concatenate(m.ImplicitPoleSegments(f, paths))
                .Concatenate(m.CutSegments(f, paths)),
            Evaluations(evaluations));
    }

    // GreenPathsOfLoop with its evaluations counted, the edge loop's path built by
    // EdgeLoopPathBuilt.
    GreenPathsOfLoopCounted(m: BrepModel, f: BrepFaceIndex, j: Integer, n: Integer, loop: BrepLoop): Counted<Array<GreenPath>>
        => match (loop)
        {
            EdgeLoop(coedges) => Counted([m.EdgeLoopPathBuilt(f, j, n)], Evaluations(2 * (n + 1) * coedges.Count));
            VertexLoop(vertex) => Counted(m.VertexLoopPaths(f, vertex), Evaluations(1 + m.CoedgeSitesOfFace(f).Count));
            PolyLoop(points) => Counted(0.MapRange(k => m.EdgeLoopPathBuilt(f, j, n)), WorkBudget.NoWork);
        };

    // EdgeLoopPath with the points gathered in a List builder: each coedge's lifted samples,
    // shifted to join the points so far, added once; then closed.
    EdgeLoopPathBuilt(m: BrepModel, f: BrepFaceIndex, j: Integer, n: Integer): GreenPath
    {
        var count = m.LoopCoedges(m.Faces[f].Bounds[j].Loop).Count;
        var points = new List<UvCoordinate>();
        var k = 0;
        while (k < count)
        {
            var path = m.CoedgeUvPathBuilt(CoedgeSite(f, BoundSlot(j), CoedgeSlot(k)), n);
            var shift = points.Count < 2
                ? Vector2D(0.0, 0.0)
                : m.JunctionShift(f, points.At(points.Count - 2), points.At(points.Count - 1), path.First);
            points = points.AddRange(path.Map(uv => uv + shift));
            k = k + 1;
        }
        return m.ClosedPath(f, points.Freeze());
    }

    // CoedgeUvPath, lifted by UnwrappedFromBuilt.
    CoedgeUvPathBuilt(m: BrepModel, site: CoedgeSite, n: Integer): Array<UvCoordinate>
    {
        var s = m.Faces[site.Face].Surface;
        var raw = m.CoedgeSamplePoints(site, n).Map(p => m.Geometry.Project(s, p));
        var filled = raw.Count.MapRange(k => m.IsAtVCollapse(site.Face, raw[k])
            ? UvCoordinate(raw[k == 0 ? 1 : k - 1].U, raw[k].V)
            : raw[k]);
        return filled.UnwrappedFromBuilt(m.Geometry.Domain(s));
    }

    // UnwrappedFrom with the outputs added to a List builder: each the copy, by whole periods,
    // of the input nearest the previous output.
    UnwrappedFromBuilt(uvs: Array<UvCoordinate>, d: SurfaceDomain): Array<UvCoordinate>
    {
        var lifted = new List<UvCoordinate>();
        var k = 0;
        while (k < uvs.Count)
        {
            lifted = lifted.Add(k == 0 ? uvs[0] : d.NearestUnwrapped(uvs[k], lifted.At(k - 1)));
            k = k + 1;
        }
        return lifted.Freeze();
    }

    //==
    // # Face areas

    // The estimate of no oracle: Ran false, every number NaN.
    NoGreenEstimate(_: GreenEstimate): GreenEstimate
        => GreenEstimate(false, Number.Unmeasured, Number.Unmeasured, 0, Number.Unmeasured);

    // Face f's Green areas at GreenChords and twice as many chords, from two boundary builds.
    GreenAreaPair(m: BrepModel, f: BrepFaceIndex): GreenEstimate
        => m.GreenAreaPairGiven(f, m.GreenModelOk);

    // GreenAreaPair with the whole-model guard given (ok = m.GreenModelOk).
    GreenAreaPairGiven(m: BrepModel, f: BrepFaceIndex, ok: Boolean): GreenEstimate
        => m.GreenAreaPairCounted(f, ok, Integer.GreenChords).Value;

    // Face f's Green areas at n and 2n chords per coedge, counting each boundary build as a
    // Flip and the boundaries' curve evaluations and projections as Evaluations: 2 Flips on a
    // face the oracle can run on, none otherwise. The cone's nappe sign is read from the coarse
    // boundary, which at n = GreenChords is the boundary FaceNappeSign reads.
    GreenAreaPairCounted(m: BrepModel, f: BrepFaceIndex, ok: Boolean, n: Integer): Counted<GreenEstimate>
        => m.CanGreenGiven(f, ok)
            ? m.GreenAreaPairFrom(f, m.GreenBoundaryCounted(f, n), m.GreenBoundaryCounted(f, 2 * n))
            : Counted(GreenEstimate.NoGreenEstimate, WorkBudget.NoWork);

    // The estimate from face f's coarse and fine boundaries.
    GreenAreaPairFrom(m: BrepModel, f: BrepFaceIndex, coarse: Counted<Array<GreenSegment>>, fine: Counted<Array<GreenSegment>>): Counted<GreenEstimate>
    {
        var surface = m.Geometry.SurfaceAt(m.Faces[f].Surface);
        var nappe = surface.IsConeSurface ? surface.NappeSign(coarse.Value) : 1.0;
        var coneRadius = coarse.Value.Reduce(Number.MaxValue, (best, seg) => best.Min(surface.ConeRadiusAt(seg.From.V)));
        return Counted(
            GreenEstimate(true,
                m.GreenAreaOfRaw(f, m.RawGreenAreaOf(f, coarse.Value, nappe)),
                m.GreenAreaOfRaw(f, m.RawGreenAreaOf(f, fine.Value, nappe)),
                fine.Value.Count, coneRadius),
            Flips(2).Add(coarse.Work).Add(fine.Work));
    }

    // RawGreenArea over a built boundary b with the face's nappe sign.
    RawGreenAreaOf(m: BrepModel, f: BrepFaceIndex, b: Array<GreenSegment>, nappe: Number): Number
    {
        var surface = m.Geometry.SurfaceAt(m.Faces[f].Surface);
        return b.Map(seg => surface.AreaSegment(m.Geometry, seg, nappe)).SumOf * m.FaceNormalSign(f).ToNumber;
    }

    // GreenArea from the raw area: a non-positive result on a closed surface moved up by the
    // surface's whole area.
    GreenAreaOfRaw(m: BrepModel, f: BrepFaceIndex, raw: Number): Number
    {
        var total = m.Geometry.SurfaceAt(m.Faces[f].Surface).ClosedSurfaceArea;
        return raw > 0.0 ? raw : (total.IsFinite ? raw + total : raw);
    }

    // The Richardson extrapolation of the estimate's two results; NaN when the oracle did not run.
    RichardsonOf(e: GreenEstimate): Number
        => e.Ran ? Richardson(e.Coarse, e.Fine) : Number.Unmeasured;

    // Oracle_FaceAreaByGreen from one pair of boundary builds.
    Oracle_FaceAreaByGreenOnce(m: BrepModel, f: BrepFaceIndex): Number
        => m.GreenAreaPair(f).RichardsonOf;

    // GreenAllowance from the estimate: the Richardson correction plus the rounding of the fine
    // boundary's sum.
    GreenAllowanceOf(e: GreenEstimate): Number
        => e.Ran
            ? (e.Fine - e.Coarse).Abs / 3.0 + ResolutionAt(e.Fine * e.FineSegments.ToNumber).Value
            : Number.Unmeasured;

    //==
    // # Shell and body volumes

    // Shell s's divergence volumes at GreenChords and twice as many chords, each face's two
    // boundaries built once and the origin once.
    ShellVolumePair(m: BrepModel, s: ShellIndex): GreenEstimate
        => m.IsShellInRange(s) ? m.ShellVolumePairGiven(s, m.GreenModelOk) : GreenEstimate.NoGreenEstimate;

    // ShellVolumePair for a shell in range, the whole-model guard given.
    ShellVolumePairGiven(m: BrepModel, s: ShellIndex, ok: Boolean): GreenEstimate
    {
        var o = m.ShellOrigin(s);
        var terms = m.ShellFaces(s).Map(f => m.FaceVolumePair(f, ok, o));
        return GreenEstimate(true,
            terms.Map(t => t.Coarse).SumOf / 3.0,
            terms.Map(t => t.Fine).SumOf / 3.0,
            terms.Map(t => t.FineSegments).IntegerTotal,
            Number.Unmeasured);
    }

    // Face f's volume terms (FaceVolumeTerm) about o at GreenChords and twice as many, from two
    // boundary builds.
    FaceVolumePair(m: BrepModel, f: BrepFaceIndex, ok: Boolean, o: Point3D): GreenEstimate
        => m.CanGreenGiven(f, ok)
            ? m.FaceVolumePairFrom(f, o, m.GreenBoundaryCounted(f, Integer.GreenChords).Value, m.GreenBoundaryCounted(f, 2 * Integer.GreenChords).Value)
            : GreenEstimate.NoGreenEstimate;

    // The volume terms from face f's coarse and fine boundaries.
    FaceVolumePairFrom(m: BrepModel, f: BrepFaceIndex, o: Point3D, coarse: Array<GreenSegment>, fine: Array<GreenSegment>): GreenEstimate
    {
        var surface = m.Geometry.SurfaceAt(m.Faces[f].Surface);
        var nappe = surface.IsConeSurface ? surface.NappeSign(coarse) : 1.0;
        return GreenEstimate(true, m.FaceVolumeTermOf(f, o, coarse, nappe), m.FaceVolumeTermOf(f, o, fine, nappe), fine.Count, Number.Unmeasured);
    }

    // FaceVolumeTerm over a built boundary b.
    FaceVolumeTermOf(m: BrepModel, f: BrepFaceIndex, o: Point3D, b: Array<GreenSegment>, nappe: Number): Number
    {
        var surface = m.Geometry.SurfaceAt(m.Faces[f].Surface);
        return b.Map(seg => surface.VolumeSegment(m.Geometry, o, seg)).SumOf
            + (m.RawGreenAreaOf(f, b, nappe) > 0.0
                ? 0.0
                : 3.0 * surface.ClosedSurfaceVolume * m.FaceNormalSign(f).ToNumber);
    }

    // Oracle_DivergenceVolume from one ShellVolumePair.
    Oracle_DivergenceVolumeOnce(m: BrepModel, s: ShellIndex): Number
        => m.ShellVolumePair(s).RichardsonOf;

    // DivergenceAllowance from the estimate.
    DivergenceAllowanceOf(e: GreenEstimate): Number
        => e.Ran
            ? (e.Fine - e.Coarse).Abs / 3.0 + ResolutionAt(e.Fine.Abs * e.FineSegments.ToNumber).Value
            : Number.Unmeasured;

    // Oracle_BodyVolume over Oracle_DivergenceVolumeOnce.
    Oracle_BodyVolumeOnce(m: BrepModel, b: BodyIndex): Number
        => m.IsBodyInRange(b) ? m.BodyShells(b).Map(s => m.Oracle_DivergenceVolumeOnce(s)).SumOf : Number.Unmeasured;

    //==
    // # Readers: tolerance, tube, solid volume, Gauss-Bonnet

    // FaceAreaTolerance from face f's estimate e: the area, the allowance and the cone's smallest
    // radius read from e, not from three more boundary builds.
    FaceAreaToleranceOf(m: BrepModel, f: BrepFaceIndex, c: FaceMeshingCriteria, e: GreenEstimate): Number
    {
        var a = e.RichardsonOf;
        var kappa = m.Geometry.SurfaceAt(m.Faces[f].Surface).CurvatureBound(e.ConeRadius, m, f);
        var d = c.SurfaceChordal + m.Tolerances.Length.Value;
        var de = c.Discretization.EffectiveChordal(m.Tolerances) + m.Tolerances.Length.Value;
        var theta = c.SurfaceAngular.Radians * 2.0;
        var stretch = (1.0 + kappa * d) * (1.0 + kappa * d);
        return theta < Number.HalfPi
            ? a * (stretch / theta.Cos - 1.0) + de * m.Oracle_FacePerimeter(f) + e.GreenAllowanceOf
            : Number.MaxValue;
    }

    // FaceAreaTolerance from one GreenAreaPair.
    FaceAreaToleranceOnce(m: BrepModel, f: BrepFaceIndex, c: FaceMeshingCriteria): Number
        => m.FaceAreaToleranceOf(f, c, m.GreenAreaPair(f));

    // ShellOracleArea with the whole-model guard computed once.
    ShellOracleAreaOnce(m: BrepModel, s: ShellIndex): Number
        => m.ShellOracleAreaGiven(s, m.GreenModelOk);

    // ShellOracleArea with the whole-model guard given.
    ShellOracleAreaGiven(m: BrepModel, s: ShellIndex, ok: Boolean): Number
        => m.ShellFaces(s).Map(f => m.GreenAreaPairGiven(f, ok).RichardsonOf).SumOf;

    // TubeVolume with each face's area from one pair and the whole-model guard once.
    TubeVolumeOnce(m: BrepModel, b: BodyIndex, c: FaceMeshingCriteria): Number
    {
        var ok = m.GreenModelOk;
        var d = m.MeshDeviationBound(c);
        var area = m.BodyShells(b).Map(s => m.ShellOracleAreaGiven(s, ok)).SumOf;
        var chi = m.BodyShells(b).Reduce(0, (n, s) => n + m.ShellEulerPoincare(s)).Abs;
        return 2.0 * d * area + 2.0 * Number.Tau / 3.0 * chi.ToNumber * d * d * d;
    }

    // SolidVolumeWithinTube with the body's oracle volume and tube computed once each, and only
    // where the guard before them holds.
    SolidVolumeWithinTubeOnce(m: BrepModel, mesh: ModelMesh, c: FaceMeshingCriteria, b: BodyIndex): Boolean
        => m.IsSolidVolumeShaped(mesh, b) ? m.SolidVolumeWithinTubeGiven(mesh, c, b, m.Oracle_BodyVolumeOnce(b)) : true;

    // The structural hypotheses of SolidVolumeWithinTube (IsSolidVolumeJudged without its two
    // finiteness tests): indices in range, the outer shell in range, every shell of b meshed whole.
    IsSolidVolumeShaped(m: BrepModel, mesh: ModelMesh, b: BodyIndex): Boolean
        => (m.IsEveryIndexInRange ? m.IsBodyInRange(b) : false)
            ? (m.IsShellInRange(m.Bodies[b].OuterShellOf) ? m.BodyShells(b).All(s => m.IsCompleteShellMesh(mesh, s)) : false)
            : false;

    // SolidVolumeWithinTube given body b's oracle volume.
    SolidVolumeWithinTubeGiven(m: BrepModel, mesh: ModelMesh, c: FaceMeshingCriteria, b: BodyIndex, volume: Number): Boolean
        => volume.IsFinite ? m.MeshVolumeWithinTube(mesh, b, volume, m.TubeVolumeOnce(b, c)) : true;

    // The mesh volume of body b is within tube of volume; vacuous for a tube with no number.
    MeshVolumeWithinTube(m: BrepModel, mesh: ModelMesh, b: BodyIndex, volume: Number, tube: Number): Boolean
        => tube.IsFinite ? (m.BodyMeshVolume(mesh, b) - volume).Abs <= tube : true;

    // AngleDefectMatchesBrepEuler with the shell's restriction built once and its vertex and quad
    // count once (the original built the restriction six times).
    AngleDefectMatchesBrepEulerOnce(m: BrepModel, mesh: ModelMesh, s: ShellIndex): Boolean
        => (m.IsEveryIndexInRange ? m.IsShellInRange(s) : false)
            ? (m.IsClosedAndOrientedShellMesh(mesh, s) ? m.AngleDefectWithin(s, m.RestrictedToShell(mesh, s)) : true)
            : true;

    // The Gauss-Bonnet comparison on shell s's restricted mesh r.
    AngleDefectWithin(m: BrepModel, s: ShellIndex, r: ModelMesh): Boolean
        => m.AngleDefectWithinCount(s, r, r.ReferencedVertexCount + r.Quads.Count);

    // The Gauss-Bonnet comparison given the count k of referenced vertices and quads.
    AngleDefectWithinCount(m: BrepModel, s: ShellIndex, r: ModelMesh, k: Integer): Boolean
        => (r.Oracle_AngleDefectSum - r.Oracle_QuadDefectSum - Number.Tau * m.ShellEulerPoincare(s).ToNumber).Abs
            <= m.Tolerances.Angle.Value.Radians * k.ToNumber + ResolutionAt(Number.Tau * k.ToNumber).Value;

    //==
    // # Checks

    // Check_FaceAreaMatchesOracle with one GreenAreaPair per face and the tolerance once per
    // judged face (the original made about seven oracle calls per face).
    Check_FaceAreaMatchesOracleOnce(m: BrepModel, mesh: ModelMesh, c: FaceMeshingCriteria): Check
    {
        var ok = m.GreenModelOk;
        var estimates = m.Faces.Count.MapRange(f => m.GreenAreaPairGiven(BrepFaceIndex(f), ok));
        var tolerances = m.Faces.Count.MapRange(f => estimates[f].RichardsonOf.IsFinite
            ? m.FaceAreaToleranceOf(BrepFaceIndex(f), c, estimates[f])
            : Number.Unmeasured);
        return CheckAllWithinEach("FaceAreaMatchesOracle", m.Faces.Count,
            f => tolerances[f].IsFinite ? (mesh.MeshFaceArea(BrepFaceIndex(f)) - estimates[f].RichardsonOf).Abs : 0.0,
            f => tolerances[f].IsFinite ? tolerances[f] : 0.0,
            f => AtFace(f));
    }

    // Check_SolidVolumeWithinTube with each body's oracle volume and tube once.
    Check_SolidVolumeWithinTubeOnce(m: BrepModel, mesh: ModelMesh, c: FaceMeshingCriteria): Check
    {
        var volumes = m.Bodies.Count.MapRange(b => m.IsSolidVolumeShaped(mesh, BodyIndex(b)) ? m.Oracle_BodyVolumeOnce(BodyIndex(b)) : Number.Unmeasured);
        var tubes = m.Bodies.Count.MapRange(b => volumes[b].IsFinite ? m.TubeVolumeOnce(BodyIndex(b), c) : Number.Unmeasured);
        return CheckAllWithinEach("SolidVolumeWithinTube", m.Bodies.Count,
            b => tubes[b].IsFinite ? (m.BodyMeshVolume(mesh, BodyIndex(b)) - volumes[b]).Abs : 0.0,
            b => tubes[b].IsFinite ? tubes[b] : 0.0,
            b => AtBody(b));
    }
}

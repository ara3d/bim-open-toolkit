//==
// # Version 1: degenerate elements a face diagnostic explains are warnings (V1G-19)
//
// Under the supervisor's rule for cusps, an element the file's geometry forces below the length tolerance is
// meshed and diagnosed, not left as a hole. A face meshed that way carries a diagnostic that says so, FACE-ZERO-WIDTH
// (V1ZeroWidth) or FACE-CUSP (v1-edges' E5b). Layer 7's ElementIsNotDegenerate and VerticesOfOneComponentAreApart
// then fail on its elements, as an Error, and the run is not Ok although nothing is wrong that the mesher could
// change. ForcedDegenerateExplanations is the one list of those codes. ExplainedReport splits the two checks'
// failures by face: an element on a face whose outcome carries a listed code, or a vertex pair whose two vertices
// are corners of elements of one such face, is a Warning that names the code; every other failure stays one Error,
// located at the first of them, as before. The harness's "explained" reads the same list.
//
// Sections, in order:
//  - The explaining codes
//  - Splitting the findings

library V1ForcedDegenerate
{
    //==
    // # The explaining codes

    // The face diagnostics that explain forced degenerate elements, one row per code. A track that adds such a
    // diagnostic adds its row here.
    ForcedDegenerateExplanations(_: Integer): Array<ForcedDegenerateExplanation>
        => [ForcedDegenerateExplanation("FACE-ZERO-WIDTH",
                "Element is not degenerate does not hold on a face reported FACE-ZERO-WIDTH: the face has no width, so the file forces its elements below the length tolerance.",
                "Vertices of one component are apart does not hold on a face reported FACE-ZERO-WIDTH: the face has no width, so the file forces its vertices within the length tolerance."),
            ForcedDegenerateExplanation("FACE-CUSP",
                "Element is not degenerate does not hold on a face reported FACE-CUSP: the face's cusp forces an element below the length tolerance.",
                "Vertices of one component are apart does not hold on a face reported FACE-CUSP: the face's cusp forces its vertices within the length tolerance.")];

    // The row of ForcedDegenerateExplanations for diagnostic code c, as its index, or -1 when c explains nothing.
    ExplanationIndexOf(c: String): Integer
    {
        var rows = ForcedDegenerateExplanations(0);
        return rows.Count.Range.Reduce(-1, (found, k) => found >= 0 ? found : (rows[k].Code == c ? k : -1));
    }

    // For each face meshed by outcomes, the row of the first of its diagnostics that explains forced degenerate
    // elements, or -1.
    ExplanationsOfFaces(outcomes: Array<FaceMeshOutcome>): Array<Integer>
        => outcomes.Map(o => o.Diagnostics.Reduce(-1, (found, d) => found >= 0 ? found : ExplanationIndexOf(d.Code)));

    //==
    // # Splitting the findings

    // The explanation row of element e of mesh: its face's, or -1.
    ElementExplanation(mesh: ModelMesh, faces: Array<Integer>, e: Integer): Integer
    {
        var f = mesh.ElementFaceAt(e).Value;
        return f >= 0 && f < faces.Count ? faces[f] : -1;
    }

    // For each vertex of mesh, the explanation row of a face it is a corner of when that face has one, else -1;
    // with a second such face, -2 (a pair there is not on one face).
    VertexExplanations(mesh: ModelMesh, faces: Array<Integer>): Array<Integer>
    {
        var rows = new List<Integer>().AddRange(mesh.Positions.Map(p => -1));
        var owner = new List<Integer>().AddRange(mesh.Positions.Map(p => -1));
        var e = 0;
        while (e < mesh.ElementCount)
        {
            var k = mesh.ElementExplanation(faces, e);
            if (k >= 0)
            {
                var f = mesh.ElementFaceAt(e).Value;
                var cs = mesh.CornersOf(ElementIndex(e)).CornerList;
                var i = 0;
                while (i < cs.Count)
                {
                    var v = cs[i].Value;
                    if (owner.At(v) < 0)
                    {
                        rows = rows.Set(v, k);
                        owner = owner.Set(v, f);
                    }
                    else
                    {
                        if (owner.At(v) != f)
                        {
                            rows = rows.Set(v, -2);
                        }
                    }
                    i = i + 1;
                }
            }
            e = e + 1;
        }
        return rows.Freeze();
    }

    // Report r of mesh with its ElementIsNotDegenerate and VerticesOfOneComponentAreApart findings split by
    // the explanation rows of the faces (ExplanationsOfFaces): each of the two checks' diagnostics in r is
    // replaced by an Error at the first failure that no face explains, when there is one, and a Warning for every
    // failure one does, naming the code. The checks themselves are kept as r has them; r is returned as it is
    // when it has neither diagnostic, or when no face has an explanation.
    ExplainedReport(mesh: ModelMesh, t: Tolerances, faces: Array<Integer>, r: Report): Report
        => (faces.Any(k => k >= 0)
                && r.Diagnostics.Any(d => d.Code == "ElementIsNotDegenerate" || d.Code == "VerticesOfOneComponentAreApart"))
            ? mesh.SplitDegenerateFindings(t, faces, r,
                r.Diagnostics.Any(d => d.Code == "ElementIsNotDegenerate"),
                r.Diagnostics.Any(d => d.Code == "VerticesOfOneComponentAreApart"))
            : r;

    // ExplainedReport's split, for the checks whose diagnostics r has (hasElement, hasPair).
    SplitDegenerateFindings(mesh: ModelMesh, t: Tolerances, faces: Array<Integer>, r: Report, hasElement: Boolean, hasPair: Boolean): Report
    {
        var rows = ForcedDegenerateExplanations(0);
        var degenerate = mesh.ElementCount.Range.FlatMap(e => ElementIsNotDegenerate(mesh, ElementIndex(e), t.Length) ? [e].Take(0) : [e]);
        var comps = mesh.ComponentsOf;
        var close = mesh.CoincidentVertexPairs(comps, t.Length).FlatMap(p =>
            mesh.VerticesOfOneComponentAreApartGiven(comps, p.A, p.B, t.Length) ? [p].Take(0) : [p]);
        var vertex = mesh.VertexExplanations(faces);
        var pairRow = close.Map(p => (vertex[p.A.Value] >= 0 && vertex[p.A.Value] == vertex[p.B.Value]) ? vertex[p.A.Value] : -1);
        var elementRow = degenerate.Map(e => mesh.ElementExplanation(faces, e));
        var looseElements = degenerate.Count.Range.FlatMap(i => elementRow[i] < 0 ? [degenerate[i]] : [0].Take(0));
        var loosePairs = close.Count.Range.FlatMap(i => pairRow[i] < 0 ? [close[i]] : [close[i]].Take(0));
        var kept = r.Diagnostics.FlatMap(d => ((hasElement && d.Code == "ElementIsNotDegenerate") || (hasPair && d.Code == "VerticesOfOneComponentAreApart")) ? [d].Take(0) : [d]);
        var elementError = (hasElement && looseElements.Count > 0)
            ? [Diagnostic(Severity.Error, "ElementIsNotDegenerate", "Element is not degenerate does not hold.", AtElement(looseElements[0]), 1.0)]
            : [Diagnostic(Severity.Error, "", "", Provenance.WholeInput, 0.0)].Take(0);
        var pairError = (hasPair && loosePairs.Count > 0)
            ? [Diagnostic(Severity.Error, "VerticesOfOneComponentAreApart", "Vertices of one component are apart does not hold.", AtMeshVertex(loosePairs[0].A.Value), 1.0)]
            : [Diagnostic(Severity.Error, "", "", Provenance.WholeInput, 0.0)].Take(0);
        var elementWarnings = degenerate.Count.Range.FlatMap(i => (hasElement && elementRow[i] >= 0)
            ? [Diagnostic(Severity.Warning, "ElementIsNotDegenerate", rows[elementRow[i]].ElementMessage, AtElement(degenerate[i]), 1.0)]
            : [Diagnostic(Severity.Warning, "", "", Provenance.WholeInput, 0.0)].Take(0));
        var pairWarnings = close.Count.Range.FlatMap(i => (hasPair && pairRow[i] >= 0)
            ? [Diagnostic(Severity.Warning, "VerticesOfOneComponentAreApart", rows[pairRow[i]].PairMessage, AtMeshVertex(close[i].A.Value), 1.0)]
            : [Diagnostic(Severity.Warning, "", "", Provenance.WholeInput, 0.0)].Take(0));
        return Report(r.Checks, kept.Concatenate(elementError).Concatenate(pairError).Concatenate(elementWarnings).Concatenate(pairWarnings));
    }
}

//==
// # Validation: invariants and constructors of the claim types
//
// SPEC-DSL.md section 3. Not compiled; each invariant cites the law in
// validation-claims.laws.plato that checks it, or is a one-line expression
// whose law form would be a wrapper.
//
// Sections, in order:
//  - Check records
//  - Allowances and sums
//  - Scope and levels

//==
// # Check records

spec PairBudget
{
    invariant self.MaxElements >= 0;
    constructor PairBudgetOf;
}

spec CheckRecord
{
    invariant self.Claim.Law.Value != "";
    constructor ToCheckRecord;   // Law_ToCheckRecordPreservesHolds, ...ExactHolds, ...KeepsLaw
}

spec ToCheckRecord(c: Check, kind: MeasureKind, samples: SampleCount): CheckRecord
{
    ensures result.Holds == c.Holds;
    ensures result.Claim.Law == c.Law;
    ensures result.Claim.Tolerance.Kind == kind;
}

//==
// # Allowances and sums

spec Allowance
{
    invariant self.Value.Value >= 0.0;
    constructor AllowanceFromRounding;
    constructor AllowanceFromModelTolerance;
    constructor AllowanceFromCriteria;
    constructor AllowanceFromOracleBound;
    constructor AllowanceStated;
}

spec AllowanceFromRounding(operations: Count, resolution: Resolution, kind: MeasureKind): Allowance
{
    requires resolution.Value >= 0.0;
    ensures result.Value.Value == operations.Value.ToNumber * resolution.Value;   // Law_RoundingAllowanceIsCountTimesResolution
    ensures result.Value.Kind == kind;                                            // Law_RoundingAllowanceKeepsKind
}

spec CompensatedSum
{
    invariant self.Terms >= 0;
    invariant self.Error >= 0.0;   // Law_CompensatedSumErrorIsNonNegative
    constructor CompensatedSumOf;
}

spec CompensatedSumOf(values: Array<Number>): CompensatedSum
{
    ensures result.Terms == values.Count;   // Law_CompensatedSumCountsTerms
    ensures (result.Value - values.CompensatedSum).Abs <= 2.0 * result.Error;   // Law_CompensatedSumAgreesWithLibrary
    measure values.Count;
}

spec OracleAgreement
{
    invariant self.Agree == (self.MeshValue.Kind == self.OracleValue.Kind
        ? IsWithin(Measure((self.MeshValue.Value - self.OracleValue.Value).Abs, self.MeshValue.Kind), self.Allowance.Value)
        : false);   // Law_OracleAgreesIffWithinAllowance, Law_OracleOfOtherKindNeverAgrees
    constructor OracleAgreementOf;
}

spec SampleGrid
{
    invariant self.Checked == self.Plan.IsWellFormed;
    constructor SampleGridOf;
}

//==
// # Scope and levels

spec ScopeAllows(scope: CheckScope, elements: Count, budget: PairBudget): Boolean
{
    ensures scope == CheckScope.PerPair ? result == (elements.Value <= budget.MaxElements) : result;   // Law_PairScopeRespectsBudget, Law_PerElementScopeIsUnlimited
}

spec LevelProof
{
    invariant self.Proves(self.Level);   // Law_LevelProofProvesItsLevel
    constructor LevelProofOf;
}

//==
// # Shell meshes by face mask: laws over generated meshes (complexity sweep, chunk M3)
//
// The layer 07 replacements of validation-checks-masks.library.plato that need no model agree
// exactly with the functions they replace on every mesh the runner generates; the shell forms
// are checked on the shared meshed witnesses (masks-witnesses.laws.plato).

library BrepCrossCheckingMasksLaws
{
    // FacesWithElements flags exactly the faces HasMeshElements finds, for every face index from
    // 0 to n - 1.
    Law_FacesWithElementsAgrees(mesh: ModelMesh, n: Integer): Boolean
    {
        var flags = mesh.FacesWithElements(n);
        return flags.Count == n.Max(0)
            && n.Max(0).Range.All(f => flags[f] == mesh.HasMeshElements(BrepFaceIndex(f)));
    }

}

//==
// # Validation: sample grids, expectations, and proofs of level
//
// TYPE-CATALOG.md section 10, layer 7: what a sample grid is built from,
// what a witness is for, and the proof that a report ran the checks of a
// level (moved from catalog-validation at the catalog merge, validation,
// 2026-10-20). WitnessSpec and VerdictDelta name layer 9's WitnessFamily and
// LawVerdict, so they are in 09-tooling/tooling-witness-specs.types.plato.
//
// Sections, in order:
//  - Sampling
//  - Expectations
//  - Levels

//==
// # Sampling

// A sample grid over a surface domain, built once per arena (chunk H2):
// the plan, the domain, and whether the grid was checked against the
// domain. Removes: a grid rebuilt for every check.
type SampleGrid
{
    Plan: SamplePlan;
    Domain: SurfaceDomain;
    Checked: Boolean;
}

//==
// # Expectations

// What a witness is for: to pass, to fail one law, or to warn with one code.
// Removes: a negative witness that quietly started passing. Whether a
// verdict meets it is layer 9's IsMet, since verdicts are layer 9's.
type Expectation
    = ShouldPass
    | ShouldFail(Law: LawName)
    | ShouldWarn(Code: String);

//==
// # Levels

// The check families that ran for a report, with the level they prove.
// Built only by LevelProofOf, so a ValidatedReport cannot claim a level its
// checks did not run. Invariant: every family Level requires is in Ran.
type LevelProof
{
    Level: ConformanceLevel;
    Ran: Array<CheckFamily>;
}

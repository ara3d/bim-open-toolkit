//==
// # Validation: specification
//
// Layer 7 of the STEP B-rep to mesh design (README.md beside this file). The
// invariants of the layer's records, the contracts of its entry points, its
// three deferred functions, every witness model, and the theorems the checks
// and oracles rest on. SPEC-DSL.md section 3 constructs only; every ensures
// is a Law_ or an expression a law runner can evaluate on witnesses.
//
// Sections, in order:
//  - Records
//  - Entry points
//  - Oracles
//  - Deferred functions
//  - Positive witnesses
//  - Negative witnesses
//  - Theorems

//==
// # Records

// The facts of a witness: one genus and one signed volume per shell, both
// in shell order. Built only by the facts functions.
spec WitnessFacts
{
    invariant self.Genera.Count == self.Shells.Count;
    invariant self.ShellVolumes.Count == self.Shells.Count;
    invariant self.Shells.Count >= 1;
    constructor BoxFacts;
    constructor CylinderFacts;
    constructor SphereFacts;
    constructor SphereByPoleLoopsFacts;
    constructor TorusFacts;
    constructor ConeFacts;
    constructor BlockWithThroughHoleFacts;
    constructor HollowBoxFacts;
    constructor BSplinePatchSolidFacts;
}

// A corpus entry exercises at least one feature, and every count and
// published measure it carries is positive.
spec CorpusEntry
{
    invariant self.Exercises.Count > 0;
    invariant self.ExpectedVolume.IsSensibleMeasure;
    invariant self.ExpectedArea.IsSensibleMeasure;
    invariant forall (k: Integer) in self.Counts.Count.Range : self.Counts[k].CountValue > 0;
    constructor CorpusFile;
    constructor NistTestCase;
}

// A lifted bound has at least one point; a closed one winds in neither
// parameter. Plain data: built by the oracle's path functions.
spec GreenPath
{
    invariant self.Points.Count >= 1;
    invariant self.Closed ? (self.WindingU == 0 && self.WindingV == 0) : true;
}

//==
// # Entry points

// The model's checks at a level: clean at a level means clean at every
// lower one.
spec ValidateBrep(m: BrepModel, level: ConformanceLevel): Report
{
    ensures result.IsClean ? m.ValidateBrep(ConformanceLevel.Structural).IsClean : true;
    ensures level.LevelRank >= 1 ? (result.IsClean ? m.ValidateBrep(ConformanceLevel.Geometric).IsClean : true) : true;
    ensures (result.IsClean && level.LevelRank == 2) ? forall (s: ShellIndex) : Law_ReducedEulerMatchesOracle(m, s) : true;
    measure m.Faces.Count + m.Edges.Count + m.Vertices.Count + m.Geometry.Curves.Count + m.Geometry.Surfaces.Count;
}

// A file's checks at a level.
spec ValidateStep(file: Part21File, level: ConformanceLevel): Report
{
    ensures result.IsClean ? file.ValidateStep(ConformanceLevel.Structural).IsClean : true;
    measure file.Instances.Count;
}

// A mesh against its model at a level: when clean, every face has an
// element, and every shell's mesh has the shell's Euler characteristic and is
// closed exactly when the shell is.
spec CrossCheck(m: BrepModel, mesh: ModelMesh, level: ConformanceLevel): Report
{
    requires m.IsEveryIndexInRange;
    ensures result.IsClean ? forall (f: BrepFaceIndex) : EveryFaceIsMeshed(m, mesh, f) : true;
    ensures result.IsClean ? forall (s: ShellIndex) : MeshEulerEqualsBrepEuler(m, mesh, s) : true;
    ensures result.IsClean ? forall (s: ShellIndex) : MeshClosedExactlyWhenShellClosed(m, mesh, s) : true;
    ensures result.IsClean ? forall (v: VertexIndex) : ProvenanceNamesModelCell(m, mesh, v) : true;
    measure mesh.Positions.Count + mesh.ElementCount + m.Faces.Count;
}

// CrossCheck with the criteria: when clean at Oracle, every face's mesh
// area is within its envelope.
spec CrossCheck(m: BrepModel, mesh: ModelMesh, level: ConformanceLevel, c: FaceMeshingCriteria): Report
{
    requires m.IsEveryIndexInRange;
    ensures result.IsClean ? m.CrossCheck(mesh, level).IsClean : true;
    ensures (result.IsClean && level.LevelRank == 2) ? forall (f: BrepFaceIndex) : FaceAreaMatchesOracle(m, mesh, c, f) : true;
    measure mesh.Positions.Count + mesh.ElementCount + m.Faces.Count * 4 * 64;
}

//==
// # Oracles

// The Green's-theorem area of a face: exact up to rounding on loops straight
// in (u, v), within its own allowance otherwise.
spec Oracle_FaceAreaByGreen(m: BrepModel, f: BrepFaceIndex): Number
{
    requires m.CanGreen(f);
    ensures result.IsFinite ? result >= 0.0 - m.GreenAllowance(f) : true;
    ensures Law_PlanarFaceAreaMatchesGreen(m, f);
    measure m.GreenBoundary(f, 2 * Integer.GreenChords).Count;
}

// The divergence-theorem volume of a shell: positive for an outer shell,
// negative for a void, NaN where a face's term is NaN.
spec Oracle_DivergenceVolume(m: BrepModel, s: ShellIndex): Number
{
    requires m.IsShellInRange(s);
    ensures result.IsFinite ? m.DivergenceAllowance(s).IsFinite : true;
    measure m.ShellFaces(s).Count * 2 * Integer.GreenChords;
}

// The oracle's Euler characteristic of a shell: raw counts plus the
// reduction's corrections, equal to layer 2's union-find count.
spec Oracle_EulerCharacteristic(m: BrepModel, s: ShellIndex): Integer
{
    requires m.IsEveryIndexInRange;
    requires m.IsShellInRange(s);
    ensures result == m.ShellEulerPoincare(s);
    measure m.ShellFaces(s).Count + m.Edges.Count + m.Vertices.Count;
}

//==
// # Deferred functions

// The Green integral of one segment on a surface with no closed-form
// potential.
spec AreaSegmentByQuadrature(surface: BrepSurface, g: GeometrySet, seg: GreenSegment): Number
{
    requires seg.From.U.IsFinite && seg.From.V.IsFinite && seg.To.U.IsFinite && seg.To.V.IsFinite;
    ensures result.IsFinite;
    ensures (seg.From.U == seg.To.U) ? result == 0.0 : true;
    measure 5 * 8;
    deferred "Gauss-Legendre: the inner integral in v with ceil(3p/2) points per knot span (8 off a spline), the outer 5-point rule along the segment";
}

// An upper bound on the absolute principal curvature over a face whose
// surface has no closed form for it.
spec SampledCurvatureBound(m: BrepModel, f: BrepFaceIndex): Number
{
    requires m.IsFaceInRange(f);
    ensures result >= 0.0;
    measure 81 + m.GreenBoundary(f, Integer.GreenChords).Count;
    deferred "shape-operator eigenvalues from second differences of Eval on a 9 by 9 grid and the coarse boundary, times 1.5";
}

// The length of an edge's curve by adaptive quadrature.
spec EdgeLengthByQuadrature(m: BrepModel, e: BrepEdgeIndex): Number
{
    requires m.IsEdgeInRange(e);
    ensures result >= 0.0;
    measure m.Edges.Count;
    deferred "5-point Gauss-Legendre on every span between breakpoints, halved until two results agree within the length tolerance";
}

//==
// # Positive witnesses
//
// Counts are raw (RawCounts); areas and volumes as the facts state them;
// every positive witness validates clean at every level.

// The unit box, written out in full.
spec Witness_UnitBox(_: BrepModel): BrepModel
{
    ensures result.Shells.Count == 1;
    ensures result.Faces.Count == 6;
    ensures result.RawCounts(ShellIndex(0)) == ShellCounts(8, 12, 6, 6);
    ensures result.ShellEulerPoincare(ShellIndex(0)) == 2;
    ensures result.ValidateBrep(ConformanceLevel.Oracle).IsClean;
    ensures (result.Oracle_DivergenceVolume(ShellIndex(0)) - 1.0).Abs <= result.DivergenceAllowance(ShellIndex(0));
    ensures result.SameModel(BrepModel.Witness_Box(1.0, 1.0, 1.0));
    measure result.Faces.Count;
}

// The box w x d x h with a corner at the origin.
spec Witness_Box(_: BrepModel, w: Number, d: Number, h: Number): BrepModel
{
    requires w > 0.0 && d > 0.0 && h > 0.0;
    ensures result.RawCounts(ShellIndex(0)) == ShellCounts(8, 12, 6, 6);
    ensures result.ShellEulerPoincare(ShellIndex(0)) == 2;
    ensures result.ValidateBrep.IsClean;
    ensures forall (k: Integer) in 6.Range : Law_GreenEqualsBoxFaceArea(w, d, h, k);
    ensures (result.Oracle_DivergenceVolume(ShellIndex(0)) - w * d * h).Abs <= result.DivergenceAllowance(ShellIndex(0));
    measure result.Faces.Count;
}

// The cylinder of radius r and height h: seamed for a whole turn (one seam,
// two circles, planar caps), a sector otherwise.
spec Witness_Cylinder(_: BrepModel, r: Number, h: Number, sweep: Angle): BrepModel
{
    requires r > 0.0 && h > 0.0 && sweep.Radians > 0.0 && sweep.Radians <= Number.Tau;
    ensures result.RawCounts(ShellIndex(0)) == CylinderFacts(r, h, sweep).Shells[0];
    ensures result.ShellEulerPoincare(ShellIndex(0)) == 2;
    ensures result.ValidateBrep.IsClean;
    ensures sweep.Radians >= Number.Tau ? Law_GreenEqualsCylinderPatchArea(r, h) : Law_GreenEqualsCylinderSectorPatchArea(r, h, sweep.Radians);
    ensures (result.Oracle_DivergenceVolume(ShellIndex(0)) - CylinderFacts(r, h, sweep).ShellVolumes[0]).Abs <= result.DivergenceAllowance(ShellIndex(0));
    measure result.Faces.Count;
}

// The unit cylinder, a whole turn.
spec Witness_Cylinder(_: BrepModel): BrepModel
{
    ensures result.SameModel(BrepModel.Witness_Cylinder(1.0, 1.0, Angle(Number.Tau)));
    measure 3;
}

// The sphere of radius r: one meridian seam whose ends are the poles.
spec Witness_Sphere(_: BrepModel, r: Number): BrepModel
{
    requires r > 0.0;
    ensures result.RawCounts(ShellIndex(0)) == ShellCounts(2, 1, 1, 1);
    ensures result.ShellEulerPoincare(ShellIndex(0)) == 2;
    ensures result.ValidateBrep.IsClean;
    ensures Law_GreenEqualsSphereArea(r);
    ensures (result.Oracle_DivergenceVolume(ShellIndex(0)) - 2.0 * Number.Tau * r * r * r / 3.0).Abs <= result.DivergenceAllowance(ShellIndex(0));
    measure result.Faces.Count;
}

// The unit sphere.
spec Witness_Sphere(_: BrepModel): BrepModel
{
    ensures result.SameModel(BrepModel.Witness_Sphere(1.0));
    measure 1;
}

// The sphere of radius r bounded by two pole vertex loops and no edge.
spec Witness_SphereByPoleLoops(_: BrepModel, r: Number): BrepModel
{
    requires r > 0.0;
    ensures result.RawCounts(ShellIndex(0)) == ShellCounts(2, 0, 1, 2);
    ensures result.ShellEulerPoincare(ShellIndex(0)) == 2;
    ensures result.ValidateBrep.IsClean;
    ensures Law_GreenEqualsSphereAreaByPoleLoops(r);
    measure result.Faces.Count;
}

// The ring torus of radii major > minor: two seams crossing at one vertex.
spec Witness_Torus(_: BrepModel, major: Number, minor: Number): BrepModel
{
    requires minor > 0.0 && major > minor;
    ensures result.RawCounts(ShellIndex(0)) == ShellCounts(1, 2, 1, 1);
    ensures result.ShellEulerPoincare(ShellIndex(0)) == 0;
    ensures result.ShellGenus(ShellIndex(0)) == 1;
    ensures result.ValidateBrep.IsClean;
    ensures Law_GreenEqualsTorusArea(major, minor);
    ensures Law_DivergenceEqualsTorusVolume(major, minor);
    measure result.Faces.Count;
}

// The torus (2, 1/2).
spec Witness_Torus(_: BrepModel): BrepModel
{
    ensures result.SameModel(BrepModel.Witness_Torus(2.0, 0.5));
    measure 1;
}

// The cone of base radius r and height h, apex below the base: an apex
// vertex on the side's collapsed line.
spec Witness_Cone(_: BrepModel, r: Number, h: Number): BrepModel
{
    requires r > 0.0 && h > 0.0;
    ensures result.RawCounts(ShellIndex(0)) == ShellCounts(2, 2, 2, 2);
    ensures result.ShellEulerPoincare(ShellIndex(0)) == 2;
    ensures result.ValidateBrep.IsClean;
    ensures Law_GreenEqualsConePatchArea(r, h);
    ensures Law_PlanarOracleEqualsDiskArea(r);
    ensures (result.Oracle_DivergenceVolume(ShellIndex(0)) - Number.Pi * r * r * h / 3.0).Abs <= result.DivergenceAllowance(ShellIndex(0));
    measure result.Faces.Count;
}

// The cone (1, 1).
spec Witness_Cone(_: BrepModel): BrepModel
{
    ensures result.SameModel(BrepModel.Witness_Cone(1.0, 1.0));
    measure 2;
}

// The block a x a x c with a square through hole of side w: genus one.
spec Witness_BlockWithThroughHole(_: BrepModel, a: Number, c: Number, w: Number): BrepModel
{
    requires a > w && w > 0.0 && c > 0.0;
    ensures result.RawCounts(ShellIndex(0)) == ShellCounts(16, 24, 10, 12);
    ensures result.ShellEulerPoincare(ShellIndex(0)) == 0;
    ensures result.ShellGenus(ShellIndex(0)) == 1;
    ensures result.ValidateBrep.IsClean;
    ensures (result.Oracle_DivergenceVolume(ShellIndex(0)) - (a * a - w * w) * c).Abs <= result.DivergenceAllowance(ShellIndex(0));
    measure result.Faces.Count;
}

// The block (3, 1, 1).
spec Witness_BlockWithThroughHole(_: BrepModel): BrepModel
{
    ensures result.SameModel(BrepModel.Witness_BlockWithThroughHole(3.0, 1.0, 1.0));
    measure 10;
}

// The cube of side a around a cubic void of side b: two closed shells, the
// void's faces pointing into the void.
spec Witness_HollowBox(_: BrepModel, a: Number, b: Number): BrepModel
{
    requires a > b && b > 0.0;
    ensures result.Shells.Count == 2;
    ensures result.RawCounts(ShellIndex(0)) == ShellCounts(8, 12, 6, 6);
    ensures result.RawCounts(ShellIndex(1)) == ShellCounts(8, 12, 6, 6);
    ensures result.ValidateBrep.IsClean;
    ensures Law_OuterShellExactVolumePositive(result, BodyIndex(0));
    ensures Law_VoidShellExactVolumeNegative(result, BodyIndex(0), 0);
    measure result.Faces.Count;
}

// The hollow box (2, 1).
spec Witness_HollowBox(_: BrepModel): BrepModel
{
    ensures result.SameModel(BrepModel.Witness_HollowBox(2.0, 1.0));
    measure 12;
}

// The unit cube whose top is a biquadratic Bezier patch raised by bump at
// its centre.
spec Witness_BSplinePatchSolid(_: BrepModel, bump: Number): BrepModel
{
    requires bump > 0.0 && bump < 1.0;
    ensures result.RawCounts(ShellIndex(0)) == ShellCounts(8, 12, 6, 6);
    ensures result.ShellEulerPoincare(ShellIndex(0)) == 2;
    ensures result.ValidateBrep.IsClean;
    ensures Law_BSplineTopAreaInBracket(bump);
    ensures (result.Oracle_DivergenceVolume(ShellIndex(0)) - (1.0 + bump / 9.0)).Abs <= result.DivergenceAllowance(ShellIndex(0));
    measure result.Faces.Count;
}

// The B-spline patch solid with bump 1/2.
spec Witness_BSplinePatchSolid(_: BrepModel): BrepModel
{
    ensures result.SameModel(BrepModel.Witness_BSplinePatchSolid(0.5));
    measure 6;
}

//==
// # Negative witnesses

// The seamed sphere with redundant pole loops besides: fails exactly
// Law_NoRedundantVertexLoop (a Warning) and Law_VertexLoopVertexIsIsolated.
spec Witness_SphereWithRedundantPoleLoops(_: BrepModel, r: Number): BrepModel
{
    requires r > 0.0;
    ensures result.RawCounts(ShellIndex(0)) == ShellCounts(2, 1, 1, 3);
    ensures Law_RedundantPoleLoopsAreRedundant(r);
    ensures Law_RedundantPoleLoopVertexIsNotIsolated(r);
    ensures Law_RedundantPoleLoopsFailExactlyTwoLaws(r);
    ensures Law_RedundantPoleLoopsReduceToSphere(r);
    measure result.Faces.Count;
}

// The unit box with its bottom face's sense flipped: fails exactly
// Law_LoopWindingMatchesSameSense.
spec Witness_BoxWithFlippedFace(_: BrepModel): BrepModel
{
    ensures result.RawCounts(ShellIndex(0)) == ShellCounts(8, 12, 6, 6);
    ensures Law_FlippedFaceBreaksWinding(result);
    ensures Law_FlippedFaceFailsExactlyOneLaw(result);
    measure result.Faces.Count;
}

// The unit box beside a faceted sheet: a valid model whose face 6, bounded
// by a poly loop, layer 5 does not mesh; the planted bad face of layer 8's
// failure-isolation law, with exactly two Errors at the face and none
// outside the sheet. What meshing it gives is stated by layer 8's
// StepToMeshWitnessesLaws, since meshing is layer 8's.
spec Witness_BoxWithPolyLoopSheet(_: BrepModel): BrepModel
{
    ensures result.Faces.Count == 7;
    ensures result.RawCounts(ShellIndex(1)) == ShellCounts(0, 0, 1, 1);
    measure result.Faces.Count;
}

// Two unit boxes touching at a corner in one shell: fails exactly
// Law_EulerPoincareEvenAndBounded and Law_VertexLinkIsOneCycle.
spec Witness_TwoBoxesSharingCorner(_: BrepModel): BrepModel
{
    ensures result.RawCounts(ShellIndex(0)) == ShellCounts(15, 24, 12, 12);
    ensures Law_SharedCornerBreaksEuler(result);
    ensures Law_SharedCornerBreaksVertexLink(result);
    ensures Law_SharedCornerFailsExactlyTwoLaws(result);
    measure result.Faces.Count;
}

//==
// # Theorems

// A sampled check holds exactly when its law holds at every sample, and a
// failing one names a failing sample.
theorem SampledCheckAgreesWithLaw
{
    given law: String, n: Integer, holds: Function1<Integer, Boolean>, where: Function1<Integer, Provenance>;
    conclude CheckAll(law, n, holds, where).Holds == n.Range.All(i => holds(i));
    because "CheckAll folds CheckExact over 0 to n - 1 with WorseOf from a holding seed; WorseOf keeps a failing check over a holding one (Outranks), so the fold fails exactly when some sample fails, and keeps that sample's provenance.";
    tested by Law_CheckAllHoldsExactlyWhenEverySampleHolds, Law_FailingCheckAllNamesAFailingSample, Law_CheckAllWithinHoldsExactlyWhenEveryMeasureIsWithin, Law_CheckGridHoldsExactlyWhenEverySampleHolds;
}

// Clean at a level means clean at every lower one.
theorem HigherLevelCleanImpliesLowerClean
{
    given m: BrepModel;
    assume m.ValidateBrep(ConformanceLevel.Oracle).IsClean;
    conclude m.ValidateBrep(ConformanceLevel.Geometric).IsClean && m.ValidateBrep(ConformanceLevel.Structural).IsClean;
    because "ForLevel merges the per-family reports of the families a level requires; the Oracle level requires a superset of the Geometric level's, which requires a superset of the Structural level's; IsClean of a merge is the conjunction of its parts' (ReportsFormAMonoid).";
    tested by Law_MergeAllIsCleanExactlyWhenEveryPartIsClean, Law_GeometricRequiresWhatStructuralRequires, Law_OracleRequiresWhatGeometricRequires;
}

// Green's theorem with pole sides gives a face's area exactly on loops
// straight in (u, v).
theorem GreenAreaExactOnStraightLoops
{
    given m: BrepModel, f: BrepFaceIndex;
    assume m.CanGreen(f);
    conclude (m.Oracle_FaceAreaByGreen(f) - m.GreenArea(f, Integer.GreenChords)).Abs <= m.GreenAllowance(f);
    because "With P = -G(v), dP/dv = -h, so the boundary integral of P du is the integral of h over the region (Green). G is the closed-form antiderivative of the area element h in v for planes, cylinders, cones, spheres and tori. On an iso-line segment the integrand is constant or linear in the parameter, so the n-chord sum is exact; a seam's two uses cancel; a pole side at a collapsed line contributes -G(v_pole) times the u-span the boundary misses there, which closes the region. Richardson therefore changes nothing but rounding, and the allowance bounds that.";
    tested by Law_GreenEqualsCylinderPatchArea, Law_GreenEqualsSphereArea, Law_GreenEqualsSphereAreaByPoleLoops, Law_GreenEqualsTorusArea, Law_GreenEqualsConePatchArea, Law_GreenEqualsBoxFaceArea, Law_WitnessGreenAreaMatchesFacts;
}

// A mesh within the criteria has each face's area within the envelope.
theorem MeshAreaWithinEnvelope
{
    given m: BrepModel, mesh: ModelMesh, c: FaceMeshingCriteria, f: BrepFaceIndex;
    assume m.CrossCheck(mesh, ConformanceLevel.Geometric, c).IsClean;
    assume m.Oracle_FaceAreaByGreen(f).IsFinite;
    conclude FaceAreaMatchesOracle(m, mesh, c, f);
    because "Each element lies within d = SurfaceChordal + Length of the surface along normals, and its normal within 2 SurfaceAngular of the surface's (element normal law plus the corner normals). Projecting an element onto the surface along the normal field scales area by at most (1 + kappa d)^2 and tilts it by at most 2 SurfaceAngular, so the element's area is at most the patch's times (1 + kappa d)^2 / cos(2 SurfaceAngular) and at least it divided by that. Chordal alone does not bound area: a fine zigzag within d of the surface has unbounded area. The boundary chords differ from the exact boundary by at most d_e = EffectiveChordal + Length, sweeping at most d_e P. The oracle adds its own allowance.";
    tested by FaceAreaMatchesOracle;
}

// The mesh of a shell has the shell's reduced Euler characteristic.
theorem MeshEulerEqualsBrepEulerByConstruction
{
    given m: BrepModel, mesh: ModelMesh, s: ShellIndex;
    assume m.ValidateBrep(ConformanceLevel.Structural).IsClean;
    assume m.CrossCheck(mesh, ConformanceLevel.Structural).IsClean;
    conclude MeshEulerEqualsBrepEuler(m, mesh, s);
    because "Each face's mesh is a triangulation of a disk-with-holes region whose boundary vertices are the discretization points of its bounds; numbering by site glues faces along shared edges exactly as the B-rep's edges glue them. Every reduced face is a disk-with-holes cell complex refined by its mesh, and refinement does not change the Euler characteristic. The reduced counts drop redundant vertex loops and closed degenerate edges, which the mesh does not represent.";
    tested by MeshEulerEqualsBrepEuler, AngleDefectMatchesBrepEuler;
}

// Two routes to the reduced Euler characteristic agree.
theorem ReducedEulerOracleAgrees
{
    given m: BrepModel, s: ShellIndex;
    assume m.ValidateBrep(ConformanceLevel.Structural).IsClean;
    assume m.IsShellInRange(s);
    conclude m.Oracle_EulerCharacteristic(s) == m.ShellEulerPoincare(s);
    because "Merging a degenerate edge's two vertex classes removes one vertex and one edge (chi unchanged) unless the edge is closed, which removes the edge alone (chi + 1); a redundant vertex loop removes one loop and its vertex's duplicate count (chi + 1 per loop). With degenerate edges forming a forest and no loop of only degenerate edges, the corrections are additive.";
    tested by Law_ReducedEulerMatchesOracle, Law_WitnessOracleEulerMatchesLayerTwo;
}

// The outer shell of a valid solid encloses positive volume; each void
// negative.
theorem SolidShellVolumeSigns
{
    given m: BrepModel, b: BodyIndex, k: Integer;
    assume m.ValidateBrep(ConformanceLevel.Geometric).IsClean;
    conclude Law_OuterShellExactVolumePositive(m, b) && Law_VoidShellExactVolumeNegative(m, b, k);
    because "Layer 3 folds every shell so its faces point out of the material; by the divergence theorem the flux of x/3 through an outward closed surface is the enclosed volume, positive; a void's faces point into the void, so its flux is minus the void's volume. A shell thinner than 2 Length A would be within the file's own tolerance of zero volume.";
    tested by Law_OuterShellExactVolumePositive, Law_VoidShellExactVolumeNegative, Law_WitnessDivergenceVolumeMatchesFacts;
}

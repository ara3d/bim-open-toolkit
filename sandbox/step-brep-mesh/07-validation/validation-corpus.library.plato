//==
// # BrepCorpus
//
// Layer 7 of the STEP B-rep to mesh design (README.md beside this file): the
// public STEP files the design is validated against, as data. Each entry
// names the file, where to fetch it, the exporter that wrote it, the
// conventions and defects it exercises (research/STEP-BREP-MODEL.md 6 and
// 8), and the quantities a test can compare with. No volume or area is
// written here unless its publisher states it: a NIST test case carries its
// own in AP242 validation properties, read at test time; every other file's
// measures are Unpublished, and a test checks only the counts and that
// ValidateStep, ValidateBrep and CrossCheck report nothing above Warning.
//
// An entry's Source is the collection the file is fetched from, and the
// file is its Name within it (a path for the u-blox library).
//
// Sources: STEP Tools sample files (AP203 and AP214 pages), OpenCascade's
// data/step folder, the u-blox 3D-Step-Models-Library, NASA 3D Resources,
// and NIST's MBE PMI test cases. The u-blox and NASA paths are relative to
// their repositories; the survey's local copies are under
// C:\Users\cdigg\git\3d-format-shootout\data\submodules\.

library BrepCorpus
{
    //==
    // # Building entries

    // An entry with no published measures.
    CorpusFile(name: String, source: String, exporter: String, exercises: Array<CorpusFeature>, counts: Array<CorpusCount>): CorpusEntry
        => CorpusEntry(name, source, exporter, exercises, ExpectedMeasure.Unpublished, ExpectedMeasure.Unpublished, counts);

    // A STEP Tools AP203 sample file.
    StepToolsAp203(name: String, exporter: String, exercises: Array<CorpusFeature>, counts: Array<CorpusCount>): CorpusEntry
        => CorpusFile(name, "https://www.steptools.com/docs/stpfiles/ap203/", exporter, exercises, counts);

    // A STEP Tools AP214 sample file.
    StepToolsAp214(name: String, exporter: String, exercises: Array<CorpusFeature>, counts: Array<CorpusCount>): CorpusEntry
        => CorpusFile(name, "https://www.steptools.com/docs/stpfiles/ap214/", exporter, exercises, counts);

    // A file of the u-blox library, by its path in the repository.
    UBlox(path: String, exporter: String, exercises: Array<CorpusFeature>, counts: Array<CorpusCount>): CorpusEntry
        => CorpusFile(path, "https://github.com/u-blox/3D-Step-Models-Library/", exporter, exercises, counts);

    // A file of OpenCascade's sample data.
    OpenCascadeData(name: String, exercises: Array<CorpusFeature>): CorpusEntry
        => CorpusFile(name, "https://github.com/Open-Cascade-SAS/OCCT/tree/master/data/step/", "Euclid", exercises, []);

    // A NIST MBE PMI test case: machined parts with cylinders, cones, tori
    // and B-spline blends, whose volume and area come from the file's own
    // validation properties.
    NistTestCase(name: String): CorpusEntry
        => CorpusEntry(name, "https://www.nist.gov/document/nist-pmi-step-files", "CATIA, NX, Creo, SolidWorks or Inventor (AP242)",
            [CorpusFeature.PlanarFaces, CorpusFeature.CylinderBands, CorpusFeature.Cones, CorpusFeature.Tori, CorpusFeature.BSplineFaces],
            ExpectedMeasure.InFileValidationProperties, ExpectedMeasure.InFileValidationProperties, []);

    //==
    // # The corpus

    // The STEP Tools files.
    StepToolsCorpus(_: CorpusEntry): Array<CorpusEntry>
        => [
            StepToolsAp203("block.stp", "ACIS",
                [CorpusFeature.PlanarFaces, CorpusFeature.IntersectionCurveOnBarePlanes, CorpusFeature.DegreeUnits,
                    CorpusFeature.PlacementsWithoutRefDirection],
                [CorpusCount.FaceCount(6)]),
            StepToolsAp203("moon_buggy_asm.stp", "Unigraphics 10.5",
                [CorpusFeature.PoleVertexLoop, CorpusFeature.ApexVertexLoop, CorpusFeature.Tori, CorpusFeature.SpindleTorusAsFullTorus,
                    CorpusFeature.Cones, CorpusFeature.Spheres, CorpusFeature.MappedItemAssembly, CorpusFeature.LinearExtrusions,
                    CorpusFeature.BSplineFaces, CorpusFeature.InchUnits, CorpusFeature.DegreeUnits],
                []),
            StepToolsAp203("as1_pe.stp", "Pro/ENGINEER",
                [CorpusFeature.ContextAssembly, CorpusFeature.InchUnits, CorpusFeature.DegreeUnits],
                []),
            StepToolsAp203("turbine.stp", "Unigraphics 13",
                [CorpusFeature.Cones, CorpusFeature.DegreeUnits, CorpusFeature.LargeModel],
                [CorpusCount.FaceCount(1241)]),
            StepToolsAp203("bull.stp", "CADDS 5",
                [CorpusFeature.BSplineFaces, CorpusFeature.RationalBSplines],
                []),
            StepToolsAp203("clip.stp", "CATIA V4",
                [CorpusFeature.ShortNames, CorpusFeature.FacetedPolyLoops],
                []),
            StepToolsAp203("cubcylso.stp", "CATIA V4",
                [CorpusFeature.CoarseUncertainty],
                []),
            StepToolsAp214("as1-ec-214.stp", "CAS.CADE",
                [CorpusFeature.Pcurves, CorpusFeature.MasterSecondPcurve],
                []),
            StepToolsAp214("io1-tc-214.stp", "Theorem",
                [CorpusFeature.SurfacesOfRevolution, CorpusFeature.TinyUncertainty, CorpusFeature.NonUnitDirections],
                []),
            StepToolsAp214("as1-ug-214.stp", "Unigraphics 16",
                [CorpusFeature.ContextAssembly, CorpusFeature.DegreeUnits],
                [])];

    // The OpenCascade sample files.
    OpenCascadeCorpus(_: CorpusEntry): Array<CorpusEntry>
        => [
            OpenCascadeData("screw.step",
                [CorpusFeature.SeamEdges, CorpusFeature.Pcurves, CorpusFeature.Tori, CorpusFeature.Cones,
                    CorpusFeature.RationalBSplines, CorpusFeature.LineBreaksInStrings]),
            OpenCascadeData("linkrods.step",
                [CorpusFeature.SeamEdges, CorpusFeature.Pcurves, CorpusFeature.RationalBSplines])];

    // The u-blox files and the NASA rover.
    ModuleCorpus(_: CorpusEntry): Array<CorpusEntry>
        => [
            UBlox("SHO/NORA-B101.step", "OpenCascade 6.8",
                [CorpusFeature.SeamEdges, CorpusFeature.BSplineFaces, CorpusFeature.ContextAssembly],
                [CorpusCount.SeamLoopCount(117)]),
            UBlox("SHO/IRIS-W1x1.step", "OpenCascade 6.8",
                [CorpusFeature.PoleVertexLoop, CorpusFeature.SeamEdges, CorpusFeature.Spheres],
                []),
            UBlox("SHO/ELLA-W1.STEP", "OpenCascade 6.2",
                [CorpusFeature.Pcurves],
                [CorpusCount.PcurveCount(8386)]),
            UBlox("SHO/NINA-B222-W1x2.STEP", "FreeCAD (OpenCascade 7.3)",
                [CorpusFeature.Pcurves, CorpusFeature.SeamCurveEntity],
                []),
            UBlox("SHO/c211_case_with_odin_v1.step", "Autodesk",
                [CorpusFeature.SeamEdges, CorpusFeature.Cones, CorpusFeature.Spheres, CorpusFeature.Tori],
                []),
            UBlox("SHO/ODIN-W260.STEP", "Spatial",
                [CorpusFeature.Voids, CorpusFeature.CylinderBands, CorpusFeature.TwoOuterBounds, CorpusFeature.PoleInsideWrappingLoop,
                    CorpusFeature.ComplexUnitsOutOfOrder, CorpusFeature.MetreUnits],
                []),
            UBlox("SHO/THEO-P173.STEP", "Spatial",
                [CorpusFeature.ClosedShellsWithFreeEdges],
                [CorpusCount.SurfaceModelCount(366)]),
            UBlox("POS/ANN-MB2.step", "SolidWorks 2016",
                [CorpusFeature.Voids],
                []),
            UBlox("SHO/BMD-301.STEP", "SolidWorks 2017",
                [CorpusFeature.LinesWithLargeMagnitude, CorpusFeature.SplitPeriodicFaces],
                []),
            UBlox("SHO/JODY-W3.STEP", "SolidWorks 2017",
                [CorpusFeature.PoleAsLoopVertex, CorpusFeature.Spheres],
                [CorpusCount.SphereFacesWithPoleVertex(24), CorpusCount.SurfaceModelCount(16)]),
            UBlox("CEL/LENA-R8.STEP", "Creo 2022",
                [CorpusFeature.DegreeUnits, CorpusFeature.LinearExtrusions],
                []),
            UBlox("SHO/M2-JODY-W377-00C_PCIE-UART.step", "FreeCAD",
                [CorpusFeature.ContextAssembly, CorpusFeature.LargeModel],
                [CorpusCount.OccurrenceCount(1218), CorpusCount.SurfaceModelCount(1071)]),
            CorpusFile("rassor_shrinkwrap.stp",
                "https://github.com/nasa/NASA-3D-Resources/ (3D Models/Regolith Advanced Surface Systems Operations Robot (RASSOR)/)",
                "Creo",
                [CorpusFeature.LargeModel, CorpusFeature.Voids, CorpusFeature.DegreeUnits, CorpusFeature.LinearExtrusions,
                    CorpusFeature.BSplineFaces],
                [CorpusCount.FaceCount(13394), CorpusCount.VoidBodyCount(2)])];

    // The NIST combined and fully toleranced test cases.
    NistCorpus(_: CorpusEntry): Array<CorpusEntry>
        => ["NIST CTC-01", "NIST CTC-02", "NIST CTC-03", "NIST CTC-04", "NIST CTC-05",
            "NIST FTC-06", "NIST FTC-07", "NIST FTC-08", "NIST FTC-09", "NIST FTC-10", "NIST FTC-11"].Map(x => NistTestCase(x));

    // Every corpus entry, in the order above.
    Corpus(_: CorpusEntry): Array<CorpusEntry>
        => CorpusEntry.StepToolsCorpus
            .Concatenate(CorpusEntry.OpenCascadeCorpus)
            .Concatenate(CorpusEntry.ModuleCorpus)
            .Concatenate(CorpusEntry.NistCorpus);

    //==
    // # Queries

    // True when the entry exercises the feature.
    ExercisesFeature(e: CorpusEntry, feature: CorpusFeature): Boolean
        => e.Exercises.Any(x => x == feature);

    // True when a measure is published with a value and a tolerance.
    IsPublished(x: ExpectedMeasure): Boolean
        => match (x)
        {
            Unpublished => false;
            InFileValidationProperties => false;
            Published(value, tolerance) => true;
        };

    // A published measure's value and tolerance are positive and finite;
    // every other measure has nothing to check.
    IsSensibleMeasure(x: ExpectedMeasure): Boolean
        => match (x)
        {
            Unpublished => true;
            InFileValidationProperties => true;
            Published(value, tolerance) => value > 0.0 && value.IsFinite && tolerance > 0.0 && tolerance.IsFinite;
        };

    // The value of a count, whichever count it is.
    CountValue(c: CorpusCount): Integer
        => match (c)
        {
            FaceCount(value) => value;
            PcurveCount(value) => value;
            OccurrenceCount(value) => value;
            SurfaceModelCount(value) => value;
            SeamLoopCount(value) => value;
            SphereFacesWithPoleVertex(value) => value;
            VoidBodyCount(value) => value;
        };
}

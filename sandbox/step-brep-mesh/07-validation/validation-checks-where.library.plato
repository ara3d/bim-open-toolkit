    //==
    // # The report of every WHERE rule

    // The reports of every WHERE rule check of a file, each with the
    // severity layer 3 gives its law and its law's first sentence as the
    // message.
    WhereRulesReport(f: Part21File): Report
        => MergeAll([
            ExactReport(f.Check_Where_UncertaintyMeasureWithUnit_WR1,
                "uncertainty_measure_with_unit WR1 (P43 4.4.23): the value is positive."),
            ExactReport(f.Check_Where_LengthMeasureWithUnit_WR1,
                "length_measure_with_unit WR1 (P41): the unit is a length unit."),
            ExactReport(f.Check_Where_PlaneAngleMeasureWithUnit_WR1,
                "plane_angle_measure_with_unit WR1 (P41): the unit is a plane-angle unit."),
            ExactReport(f.Check_Where_ConversionBasedUnit_WR1,
                "conversion_based_unit WR1 (P41, AP203 edition 2 and AP242): the unit's dimensions equal those of its conversion factor's unit."),
            ExactReport(f.Check_Where_LengthUnit_WR1,
                "length_unit WR1 (P41): the dimensional exponents are those of length, (1, 0, 0, 0, 0, 0, 0)."),
            ExactReport(f.Check_Where_PlaneAngleUnit_WR1,
                "plane_angle_unit WR1 (P41): every dimensional exponent is zero."),
            ExactReport(f.Check_Where_Direction_WR1,
                "direction WR1 (P42 4.5.14): at least one ratio is non-zero."),
            ExactReport(f.Check_Where_Vector_WR1,
                "vector WR1 (P42 4.5.15): the magnitude is not negative."),
            ExactReport(f.Check_Where_Axis1Placement_WR1,
                "axis1_placement WR1 (P42 4.5.17): the placement is three-dimensional."),
            ExactReport(f.Check_Where_Axis2Placement2D_WR1,
                "axis2_placement_2d WR1 (P42 4.5.18): the placement is two-dimensional."),
            ExactReport(f.Check_Where_Axis2Placement3D_WR1,
                "axis2_placement_3d WR1 (P42 4.5.19): the location is three-dimensional."),
            ExactReport(f.Check_Where_Axis2Placement3D_WR2,
                "axis2_placement_3d WR2: the axis, when present, is three-dimensional."),
            ExactReport(f.Check_Where_Axis2Placement3D_WR3,
                "axis2_placement_3d WR3: the ref_direction, when present, is three-dimensional."),
            ExactReport(f.Check_Where_Axis2Placement3D_WR4,
                "axis2_placement_3d WR4: axis and ref_direction, when both present, are not parallel."),
            WarningReport(f.Check_Practice_Axis2Placement3D_Orthogonal,
                "Practice, not an ISO rule: axis and ref_direction, when both present, are orthogonal within tol."),
            ExactReport(f.Check_Where_CartesianTransformationOperator_WR1,
                "cartesian_transformation_operator WR1 (P42 4.5.20): the derived scale (scale, or 1.0 when absent) is positive."),
            ExactReport(f.Check_Where_CartesianTransformationOperator3D_WR1,
                "cartesian_transformation_operator_3d WR1 (P42 4.5.21): the operator is three-dimensional."),
            ExactReport(f.Check_Where_Line_WR1,
                "line WR1 (P42 4.5.24): the vector has the dimension of the point."),
            ExactReport(f.Check_Where_Parabola_WR1,
                "parabola WR1 (P42 4.5.29): the focal distance is not zero."),
            ExactReport(f.Check_Where_BSplineCurve_WR1,
                "b_spline_curve WR1 (P42 4.5.34): the curve is also one of the four knot subtypes, which fix its knots."),
            ExactReport(f.Check_Where_BSplineCurveWithKnots_WR1_DegreePositive,
                "b_spline_curve_with_knots WR1 (P42 4.5.35, constraints_param_b_spline 4.6.11), first condition: the degree is at least 1."),
            ExactReport(f.Check_Where_BSplineCurveWithKnots_WR1_EnoughControlPoints,
                "b_spline_curve_with_knots WR1, second condition: there are at least degree + 1 control points."),
            ExactReport(f.Check_Where_BSplineCurveWithKnots_WR1_TwoKnots,
                "b_spline_curve_with_knots WR1, third condition: there are at least two knot values."),
            ExactReport(f.Check_Where_BSplineCurveWithKnots_WR1_KnotsIncrease,
                "b_spline_curve_with_knots WR1, fourth condition: the knot values strictly increase."),
            ExactReport(f.Check_Where_BSplineCurveWithKnots_WR1_MultiplicitySum,
                "b_spline_curve_with_knots WR1, fifth condition: the multiplicities sum to degree + control point count + 1."),
            ExactReport(f.Check_Where_BSplineCurveWithKnots_WR1_EndMultiplicities,
                "b_spline_curve_with_knots WR1, sixth condition: the first and last multiplicities lie in [1, degree + 1]."),
            ExactReport(f.Check_Where_BSplineCurveWithKnots_WR1_InteriorMultiplicities,
                "b_spline_curve_with_knots WR1, seventh condition: every interior multiplicity lies in [1, degree]."),
            ExactReport(f.Check_Where_BSplineCurveWithKnots_WR2,
                "b_spline_curve_with_knots WR2: the multiplicity and knot lists have the same length."),
            ExactReport(f.Check_Where_RationalBSplineCurve_WR1,
                "rational_b_spline_curve WR1 (P42 4.5.39): one weight per control point."),
            ExactReport(f.Check_Where_RationalBSplineCurve_WR2,
                "rational_b_spline_curve WR2 (curve_weights_positive): every weight is positive."),
            ExactReport(f.Check_Where_TrimmedCurve_WR1,
                "trimmed_curve WR1 (P42 4.5.43): when trim_1 has two values, one is a point and the other a parameter."),
            ExactReport(f.Check_Where_TrimmedCurve_WR2,
                "trimmed_curve WR2: the same for trim_2."),
            ExactReport(f.Check_Where_CompositeCurve_WR1,
                "composite_curve WR1 (P42 4.5.44): an open curve has exactly one discontinuous transition, at its last segment, and a closed curve none; equivalently no segment before the last is discontinuous."),
            ExactReport(f.Check_Where_CompositeCurveSegment_WR1,
                "composite_curve_segment WR1 (P42 4.5.45): the parent curve is bounded."),
            ExactReport(f.Check_Where_ReparametrisedCompositeCurveSegment_WR1,
                "reparametrised_composite_curve_segment WR1 (P42 4.5.46): the parameter length is positive."),
            ExactReport(f.Check_Where_OffsetCurve3D_WR1,
                "offset_curve_3d WR1 (P42 4.5.55): the basis curve and the reference direction are three-dimensional."),
            ExactReport(f.Check_Where_Pcurve_WR1,
                "pcurve WR1 (P42 4.5.47): the definitional representation has exactly one item."),
            ExactReport(f.Check_Where_Pcurve_WR2,
                "pcurve WR2: that item is a curve."),
            ExactReport(f.Check_Where_Pcurve_WR3,
                "pcurve WR3: that item is two-dimensional."),
            ExactReport(f.Check_Where_DefinitionalRepresentation_WR1,
                "definitional_representation WR1 (P43 4.4.4): its context is a parametric_representation_context."),
            ExactReport(f.Check_Where_SurfaceCurve_WR1,
                "surface_curve WR1 (P42 4.5.49): curve_3d is three-dimensional."),
            ExactReport(f.Check_Where_SurfaceCurve_WR2,
                "surface_curve WR2: the master representation is pcurve_s1 only when the first associated geometry is a pcurve."),
            ExactReport(f.Check_Where_SurfaceCurve_WR3,
                "surface_curve WR3: the master representation is pcurve_s2 only when the second associated geometry is a pcurve."),
            ExactReport(f.Check_Where_SurfaceCurve_WR4,
                "surface_curve WR4: curve_3d is not a pcurve."),
            ExactReport(f.Check_Where_SeamCurve_WR1,
                "seam_curve WR1 (P42 4.5.51): there are two associated geometries."),
            ExactReport(f.Check_Where_SeamCurve_WR2,
                "seam_curve WR2: both lie on the same surface instance."),
            ExactReport(f.Check_Where_SeamCurve_WR3,
                "seam_curve WR3: the first associated geometry is a pcurve."),
            ExactReport(f.Check_Where_SeamCurve_WR4,
                "seam_curve WR4: the second associated geometry is a pcurve."),
            ExactReport(f.Check_Where_IntersectionCurve_WR1,
                "intersection_curve WR1 (P42 4.5.50): there are two associated geometries."),
            ExactReport(f.Check_Where_IntersectionCurve_WR2,
                "intersection_curve WR2: they lie on distinct surface instances."),
            ExactReport(f.Check_Where_ConicalSurface_WR1,
                "conical_surface WR1 (P42 4.5.61): the radius is not negative."),
            ExactReport(f.Check_Where_DegenerateToroidalSurface_WR1,
                "degenerate_toroidal_surface WR1 (P42 4.5.64): the major radius is below the minor radius."),
            ExactReport(f.Check_Where_BSplineSurface_WR1,
                "b_spline_surface WR1 (P42 4.5.72): the surface is also one of the four knot subtypes."),
            ExactReport(f.Check_Where_BSplineSurfaceWithKnots_WR1,
                "b_spline_surface_with_knots WR1 (P42 4.5.73): constraints_param_b_spline holds in u."),
            ExactReport(f.Check_Where_BSplineSurfaceWithKnots_WR2,
                "b_spline_surface_with_knots WR2: constraints_param_b_spline holds in v."),
            ExactReport(f.Check_Where_BSplineSurfaceWithKnots_WR3,
                "b_spline_surface_with_knots WR3: the u multiplicity and knot lists have the same length."),
            ExactReport(f.Check_Where_BSplineSurfaceWithKnots_WR4,
                "b_spline_surface_with_knots WR4: the v multiplicity and knot lists have the same length."),
            ExactReport(f.Check_Where_RationalBSplineSurface_WR1,
                "rational_b_spline_surface WR1 (P42 4.5.77): the weights have the shape of the control points, row for row."),
            ExactReport(f.Check_Where_RationalBSplineSurface_WR2,
                "rational_b_spline_surface WR2: every weight is positive."),
            ExactReport(f.Check_Where_RectangularTrimmedSurface_WR1,
                "rectangular_trimmed_surface WR1 (P42 4.5.80): u1 and u2 differ."),
            ExactReport(f.Check_Where_RectangularTrimmedSurface_WR2,
                "rectangular_trimmed_surface WR2: v1 and v2 differ."),
            ExactReport(f.Check_Where_RectangularTrimmedSurface_WR3,
                "rectangular_trimmed_surface WR3: usense is (u2 > u1), unless the basis is a non-planar elementary surface or a surface of revolution (closed in u, where a trim may wrap)."),
            ExactReport(f.Check_Where_RectangularTrimmedSurface_WR4,
                "rectangular_trimmed_surface WR4: vsense is (v2 > v1), unless the basis is a sphere or a torus (closed in v)."),
            ExactReport(f.Check_Where_OrientedEdge_WR1,
                "oriented_edge WR1 (P42 5.5.6): the element is not itself an oriented edge."),
            ExactReport(f.Check_Where_Path_WR1,
                "path WR1 (P42 5.5.9, path_head_to_tail 5.6.18): each oriented edge ends at the same vertex instance the next one starts at."),
            ExactReport(f.Check_Where_EdgeLoop_WR1,
                "edge_loop WR1 (P42 5.5.15): the loop closes: the first oriented edge starts at the same vertex instance the last one ends at."),
            ExactReport(f.Check_Where_Face_WR1,
                "face WR1 (P42 5.5.19, mixed_loop_type_set 5.6.16): poly loops are not mixed with other loop kinds among a face's bounds."),
            WarningReport(f.Check_Where_Face_WR2,
                "face WR2 (P42 5.5.19): a face has at most one face_outer_bound."),
            ExactReport(f.Check_Where_FaceSurface_WR1,
                "face_surface WR1 (P42 5.5.20): the face geometry is not an oriented_surface."),
            ExactReport(f.Check_Where_OrientedFace_WR1,
                "oriented_face WR1 (P42 5.5.21): the element is not itself an oriented face."),
            ExactReport(f.Check_Where_OrientedClosedShell_WR1,
                "oriented_closed_shell WR1 (P42 5.5.29): the element is not itself an oriented closed shell."),
            ExactReport(f.Check_Where_OrientedOpenShell_WR1,
                "oriented_open_shell WR1 (P42 5.5.27): the element is not itself an oriented open shell."),
            ExactReport(f.Check_Where_ShellBasedSurfaceModel_WR1,
                "shell_based_surface_model WR1 (P42 6.4.44): every shell is an open or a closed shell (no vertex or wire shells)."),
            ExactReport(f.Check_Where_AdvancedFace_WR1,
                "advanced_face WR1: the face geometry is exactly one of an elementary surface, a B-spline surface, or a swept surface."),
            ExactReport(f.Check_Where_AdvancedFace_WR2,
                "advanced_face WR2: every oriented edge of every edge loop has an edge_curve as its element."),
            ExactReport(f.Check_Where_AdvancedFace_WR3,
                "advanced_face WR3: every edge geometry is exactly one of a line, a conic, a polyline, a surface curve, or a B-spline curve."),
            ExactReport(f.Check_Where_AdvancedFace_WR4,
                "advanced_face WR4: both vertices of every edge are vertex_points on cartesian_points."),
            ExactReport(f.Check_Where_AdvancedFace_WR5,
                "advanced_face WR5: no edge loop is an oriented_path."),
            ExactReport(f.Check_Where_AdvancedFace_WR6,
                "advanced_face WR6: a swept surface's swept curve is a line, a conic, a polyline, or a B-spline curve."),
            ExactReport(f.Check_Where_AdvancedFace_WR7,
                "advanced_face WR7: a vertex loop's vertex is a vertex_point on a cartesian_point."),
            ExactReport(f.Check_Where_AdvancedFace_WR8,
                "advanced_face WR8: every bound is an edge loop or a vertex loop (no poly loops)."),
            WarningReport(f.Check_Where_AdvancedFace_WR9,
                "advanced_face WR9: a surface_curve edge geometry has only pcurves as associated geometry, no bare surfaces."),
            ExactReport(f.Check_Where_AdvancedFace_WR10,
                "advanced_face WR10: a polyline used as edge geometry or as a swept curve has at least three points."),
            ExactReport(f.Check_Where_AdvancedBrepShapeRepresentation_WR1,
                "advanced_brep_shape_representation WR1 (AIC 514): every item is a manifold solid B-rep, a faceted B-rep, a mapped item, or a placement."),
            ExactReport(f.Check_Where_AdvancedBrepShapeRepresentation_WR2,
                "advanced_brep_shape_representation WR2: at least one item is a solid or a mapped item."),
            ExactReport(f.Check_Where_AdvancedBrepShapeRepresentation_WR3,
                "advanced_brep_shape_representation WR3: every face of every shell of every solid is an advanced_face."),
            ExactReport(f.Check_Where_AdvancedBrepShapeRepresentation_WR4,
                "advanced_brep_shape_representation WR4: no solid's outer shell is an oriented_closed_shell."),
            ExactReport(f.Check_Where_AdvancedBrepShapeRepresentation_WR5,
                "advanced_brep_shape_representation WR5: every void of a brep_with_voids has orientation .F.."),
            ExactReport(f.Check_Where_AdvancedBrepShapeRepresentation_WR6,
                "advanced_brep_shape_representation WR6: every mapped item maps another advanced_brep_shape_representation."),
            ExactReport(f.Check_Where_FacetedBrepShapeRepresentation_WR1,
                "faceted_brep_shape_representation WR1 (AIM): every item is a faceted B-rep, a mapped item, or a placement."),
            ExactReport(f.Check_Where_FacetedBrepShapeRepresentation_WR3,
                "faceted_brep_shape_representation WR3: every face is a face_surface on a plane whose position's location is a cartesian_point."),
            ExactReport(f.Check_Where_FacetedBrepShapeRepresentation_WR4,
                "faceted_brep_shape_representation WR4: every face has exactly one face_outer_bound."),
            ExactReport(f.Check_Where_FacetedBrepShapeRepresentation_WR5,
                "faceted_brep_shape_representation WR5: no outer shell is oriented."),
            ExactReport(f.Check_Where_FacetedBrepShapeRepresentation_WR6,
                "faceted_brep_shape_representation WR6: every void has orientation .F.."),
            ExactReport(f.Check_Where_ManifoldSurfaceShapeRepresentation_WR1,
                "manifold_surface_shape_representation WR1 (AIM): every item is a shell-based surface model, a mapped item, or a placement."),
            ExactReport(f.Check_Where_ManifoldSurfaceShapeRepresentation_WR2,
                "manifold_surface_shape_representation WR2: at least one item is a surface model or a mapped item."),
            ExactReport(f.Check_Where_ManifoldSurfaceShapeRepresentation_WR4,
                "manifold_surface_shape_representation WR4: every shell is an open shell, a closed shell, or an oriented closed shell (not an oriented open shell)."),
            ExactReport(f.Check_Where_ManifoldSurfaceShapeRepresentation_WR5,
                "manifold_surface_shape_representation WR5: every face is a face_surface."),
            ExactReport(f.Check_Where_ManifoldSurfaceShapeRepresentation_WR6,
                "manifold_surface_shape_representation WR6: every face is an advanced face or its geometry passes msf_surface_check."),
            ExactReport(f.Check_Where_ManifoldSurfaceShapeRepresentation_WR7,
                "manifold_surface_shape_representation WR7: every bound is an edge loop or a vertex loop."),
            ExactReport(f.Check_Where_ManifoldSurfaceShapeRepresentation_WR8,
                "manifold_surface_shape_representation WR8: every edge is an edge_curve."),
            ExactReport(f.Check_Where_ManifoldSurfaceShapeRepresentation_WR9,
                "manifold_surface_shape_representation WR9: every edge geometry is a B-spline curve, conic, curve replica, line, offset curve, pcurve, polyline, or surface curve."),
            ExactReport(f.Check_Where_ManifoldSurfaceShapeRepresentation_WR10,
                "manifold_surface_shape_representation WR10: every edge geometry passes msf_curve_check."),
            ExactReport(f.Check_Where_ManifoldSurfaceShapeRepresentation_WR11,
                "manifold_surface_shape_representation WR11: every vertex is a vertex_point."),
            ExactReport(f.Check_Where_ManifoldSurfaceShapeRepresentation_WR12To14,
                "manifold_surface_shape_representation WR12 to WR14: every vertex geometry is a cartesian point, a degenerate pcurve, a point on a curve, or a point on a surface."),
            ExactReport(f.Check_Where_MappedItem_WR1,
                "mapped_item WR1 (P43 4.4.11): a mapped item does not reach itself."),
            ExactReport(f.Check_Where_RepresentationMap_WR1,
                "representation_map WR1 (P43 4.4.18): the mapping origin is founded in the mapped representation's context."),
            ExactReport(f.Check_Where_RepresentationRelationshipWithTransformation_WR1,
                "representation_relationship_with_transformation WR1 (P43 4.4.21): the two representations are in different contexts."),
            QualityReport(f.Check_Where_RepresentationRelationshipWithTransformation_WR2,
                "representation_relationship_with_transformation WR2: with an item_defined_transformation, transform_item_1 is in rep_1's context and transform_item_2 in rep_2's."),
            ExactReport(f.Check_Where_ShapeRepresentationRelationship_WR1,
                "shape_representation_relationship WR1 (AIM): one side is a shape_representation.")
        ]);
}

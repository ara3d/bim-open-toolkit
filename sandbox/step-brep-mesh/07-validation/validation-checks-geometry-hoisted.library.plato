//==
// # Geometry checks with well-formedness checked once (complexity sweep, chunk V1)
//
// The Check_ functions of BrepCheckingGeometry whose own body guards each
// sample with CanEvaluate, or builds an entry's samples per sample
// (CurveSamples, SurfaceSamples, AlongSample, DegenerateSideSample,
// OffCurvePoint, OffSurfacePoint), rewritten to run IsWellFormed once per
// check and build each entry's samples once. Each folds the same samples, in
// the same order, with the same measures, so its Check is identical to the
// library's. Where the check's own guard covers every sample, an arena that
// is not well formed gives NoSampleCheck at once: every sample would measure
// 0 and hold, and WorseOf keeps the seed on a tie.
//
// A layer 1 law that guards itself with CanEvaluate still runs IsWellFormed
// per sample; only the derivative laws have a guard-free claim
// (DerivativeAgrees, SecondDerivativeAgrees), and their checks call it.
//
// Sections, in order:
//  - Guards
//  - File geometry
//  - Curve self-tests
//  - Surface self-tests

library BrepCheckingGeometryHoisted
{
    //==
    // # Guards

    // True when every sample of a check whose measure is 0 outside CanEvaluate
    // holds against bound and so leaves the fold at its seed: the arena is not
    // well formed (ok false) and 0 <= bound. A negative or NaN bound fails
    // even a 0 measure, so then the samples are folded as the library does.
    GuardedSamplesVacuous(ok: Boolean, bound: Number): Boolean
        => ok ? false : 0.0 <= bound;

    // OffCurvePoint with ok standing for m.Geometry.IsWellFormed.
    OffCurvePointGiven(m: BrepModel, ok: Boolean, c: CurveIndex, t: Number): Point3D
        => m.Geometry.CanEvaluateGiven(ok, c)
            ? m.Geometry.Eval(c, m.Geometry.Domain(c).SampleIn(t))
                + Vector3D(m.Tolerances.Length.Value, m.Tolerances.Length.Value, m.Tolerances.Length.Value)
            : Point3D(0.0, 0.0, 0.0);

    // OffSurfacePoint with ok given.
    OffSurfacePointGiven(m: BrepModel, ok: Boolean, s: SurfaceIndex, uv: UvCoordinate): Point3D
        => m.Geometry.CanEvaluateGiven(ok, s)
            ? m.Geometry.Eval(s, m.Geometry.Domain(s).SampleIn(uv))
                + Vector3D(m.Tolerances.Length.Value, m.Tolerances.Length.Value, m.Tolerances.Length.Value)
            : Point3D(0.0, 0.0, 0.0);

    // AlongSample's plan.Count samples along a collapsed line of surface s,
    // with ok given: V's bounded range when the collapsed parameter is U, U's
    // otherwise; zeros when s cannot be evaluated.
    AlongSamplesGiven(m: BrepModel, ok: Boolean, s: SurfaceIndex, collapsedIsU: Boolean, plan: SamplePlan): Array<Number>
        => m.Geometry.CanEvaluateGiven(ok, s)
            ? (collapsedIsU
                ? m.Geometry.Domain(s).V.BoundedSampleRange.Samples(plan.Count)
                : m.Geometry.Domain(s).U.BoundedSampleRange.Samples(plan.Count))
            : plan.Count.MapRange(i => 0.0);

    // Every surface's along samples: row 2 s for U collapsed, row 2 s + 1 for
    // V collapsed.
    AlongSampleTable(m: BrepModel, ok: Boolean, plan: SamplePlan): Array<Array<Number>>
        => (2 * m.Geometry.Surfaces.Count).MapRange(r => m.AlongSamplesGiven(ok, SurfaceIndex(r / 2), r % 2 == 0, plan));

    // DegenerateSideSample for every side k < 4 and sample i of surface s, at
    // position k plan.Count + i, with ok given: DegenerateSides computed once.
    DegenerateSideRow(m: BrepModel, ok: Boolean, s: SurfaceIndex, plan: SamplePlan): Array<Number>
        => m.Geometry.CanEvaluateGiven(ok, s)
            ? m.SideSamplesOf(s, m.Geometry.DegenerateSides(s, m.Tolerances), plan)
            : (4 * plan.Count).MapRange(i => 0.0);

    // The samples along each of sides 0 to 3 of surface s, zeros past the
    // last degenerate side. Precondition: s can be evaluated.
    SideSamplesOf(m: BrepModel, s: SurfaceIndex, sides: Array<DomainSide>, plan: SamplePlan): Array<Number>
        => 4.Range.FlatMap(k => sides.IsValidIndex(k)
            ? m.Geometry.Domain(s).DomainAlong(sides[k].AlongParameter).BoundedSampleRange.Samples(plan.Count)
            : plan.Count.MapRange(i => 0.0));

    //==
    // # File geometry

    // Check_TrimmedRangeInsideBasis with IsWellFormed run once.
    Check_TrimmedRangeInsideBasisHoisted(m: BrepModel): Check
    {
        var ok = m.Geometry.IsWellFormed;
        return !ok
            ? NoSampleCheck("Law_TrimmedRangeInsideBasis")
            : CheckAllWithinEach("Law_TrimmedRangeInsideBasis", m.Geometry.Curves.Count,
                c => m.Geometry.CanEvaluateGiven(ok, CurveIndex(c)) ? m.Geometry.TrimExcess(CurveIndex(c)) : 0.0,
                c => m.Geometry.CanEvaluateGiven(ok, CurveIndex(c)) ? m.Geometry.ParameterFloorOf(CurveIndex(c), m.Tolerances).Value : 0.0,
                c => m.CurveSite(CurveIndex(c)));
    }

    // Check_RectangularTrimmedInsideBasis with IsWellFormed run once.
    Check_RectangularTrimmedInsideBasisHoisted(m: BrepModel): Check
    {
        var ok = m.Geometry.IsWellFormed;
        return !ok
            ? NoSampleCheck("Law_RectangularTrimmedInsideBasis")
            : CheckGridWithinEach("Law_RectangularTrimmedInsideBasis", m.Geometry.Surfaces.Count, 2,
                (s, k) => m.Geometry.CanEvaluateGiven(ok, SurfaceIndex(s)) ? m.Geometry.TrimBoxExcess(SurfaceIndex(s), k.ParameterOfSlot) : 0.0,
                (s, k) => m.Geometry.CanEvaluateGiven(ok, SurfaceIndex(s))
                    ? m.Geometry.ParameterFloorAlong(SurfaceIndex(s), k.ParameterOfSlot, m.Tolerances).Value
                    : 0.0,
                (s, k) => m.SurfaceSite(SurfaceIndex(s)));
    }

    // Check_CompositeSegmentsChain with IsWellFormed run once.
    Check_CompositeSegmentsChainHoisted(m: BrepModel): Check
    {
        var ok = m.Geometry.IsWellFormed;
        return GuardedSamplesVacuous(ok, m.Tolerances.Length.Value)
            ? NoSampleCheck("Law_CompositeSegmentsChain")
            : CheckGridWithin("Law_CompositeSegmentsChain", m.Geometry.Curves.Count, m.Geometry.MostCompositeSegments,
                (c, i) => m.Geometry.CanEvaluateGiven(ok, CurveIndex(c)) ? m.Geometry.SegmentGap(CurveIndex(c), i) : 0.0,
                m.Tolerances.Length.Value,
                (c, i) => m.CurveSite(CurveIndex(c)));
    }

    // Check_SurfaceCurveLiesOnSupport with IsWellFormed run once and each
    // curve's samples built once.
    Check_SurfaceCurveLiesOnSupportHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        var samples = m.CurveSampleTable(ok, plan);
        return GuardedSamplesVacuous(ok, m.Tolerances.Length.Value)
            ? NoSampleCheck("Law_SurfaceCurveLiesOnSupport")
            : CheckGridWithin("Law_SurfaceCurveLiesOnSupport", m.Geometry.Curves.Count, 2 * plan.Count,
                (c, j) => m.Geometry.CanEvaluateGiven(ok, CurveIndex(c))
                    ? m.Geometry.SupportGap(CurveIndex(c), samples[c][j % plan.Count], j / plan.Count)
                    : 0.0,
                m.Tolerances.Length.Value,
                (c, j) => m.CurveSite(CurveIndex(c)));
    }

    // Check_SurfaceCurvePcurveLiesOnCurve with IsWellFormed run once and each
    // curve's samples built once.
    Check_SurfaceCurvePcurveLiesOnCurveHoisted(m: BrepModel, plan: SamplePlan): Check
        => m.Check_SurfaceCurvePcurveLiesOnCurveOnce(plan);

    // Check_SurfaceCurveLiesOnPcurve with IsWellFormed run once and each
    // curve's samples built once.
    Check_SurfaceCurveLiesOnPcurveHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        var samples = m.CurveSampleTable(ok, plan);
        return GuardedSamplesVacuous(ok, m.Tolerances.Length.Value)
            ? NoSampleCheck("Law_SurfaceCurveLiesOnPcurve")
            : CheckGridWithin("Law_SurfaceCurveLiesOnPcurve", m.Geometry.Curves.Count, 2 * plan.Count,
                (c, j) => m.Geometry.CanEvaluateGiven(ok, CurveIndex(c))
                    ? m.Geometry.CurveToPcurveGap(CurveIndex(c), samples[c][j % plan.Count], j / plan.Count)
                    : 0.0,
                m.Tolerances.Length.Value,
                (c, j) => m.CurveSite(CurveIndex(c)));
    }

    // Check_PcurveWithinSurfaceDomain with IsWellFormed run once and each
    // pcurve's samples built once.
    Check_PcurveWithinSurfaceDomainHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        var samples = m.PcurveSampleTable(ok, plan);
        return !ok
            ? NoSampleCheck("Law_PcurveWithinSurfaceDomain")
            : CheckGridWithinEach("Law_PcurveWithinSurfaceDomain", m.Geometry.Pcurves.Count, 2 * plan.Count,
                (p, j) => m.Geometry.CanEvaluateGiven(ok, PcurveIndex(p))
                    ? m.Geometry.PcurveDomainExcess(PcurveIndex(p), samples[p][j % plan.Count], (j / plan.Count).ParameterOfSlot)
                    : 0.0,
                (p, j) => m.Geometry.CanEvaluateGiven(ok, PcurveIndex(p))
                    ? m.Geometry.ParameterFloorAlong(m.Geometry.PcurveAt(PcurveIndex(p)).Surface, (j / plan.Count).ParameterOfSlot, m.Tolerances).Value
                    : 0.0,
                (p, j) => m.PcurveSite(PcurveIndex(p)));
    }

    // Check_CollapsedLineIsOnePoint with IsWellFormed run once and each
    // surface's along samples built once.
    Check_CollapsedLineIsOnePointHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        var along = m.AlongSampleTable(ok, plan);
        return GuardedSamplesVacuous(ok, m.Tolerances.Length.Value)
            ? NoSampleCheck("Law_CollapsedLineIsOnePoint")
            : CheckGridWithin("Law_CollapsedLineIsOnePoint", m.Geometry.Surfaces.Count, 4 * plan.Count * plan.Count,
                (s, j) => m.Geometry.CanEvaluateGiven(ok, SurfaceIndex(s))
                    ? m.Geometry.CollapsedLineSpread(SurfaceIndex(s),
                        j < 2 * plan.Count * plan.Count ? SurfaceParameter.ParameterU : SurfaceParameter.ParameterV,
                        (j / (plan.Count * plan.Count)) % 2,
                        along[2 * s + (j < 2 * plan.Count * plan.Count ? 0 : 1)][(j / plan.Count) % plan.Count],
                        along[2 * s + (j < 2 * plan.Count * plan.Count ? 0 : 1)][j % plan.Count],
                        m.Tolerances)
                    : 0.0,
                m.Tolerances.Length.Value,
                (s, j) => m.SurfaceSite(SurfaceIndex(s)));
    }

    // Check_TangentialPartialVanishesOnDegenerateSide with IsWellFormed run
    // once for the samples and each surface's degenerate sides found once.
    // The law guards itself, so it is folded at every sample.
    Check_TangentialPartialVanishesOnDegenerateSideHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        var rows = m.Geometry.Surfaces.Count.MapRange(s => m.DegenerateSideRow(ok, SurfaceIndex(s), plan));
        return CheckGrid("Law_TangentialPartialVanishesOnDegenerateSide", m.Geometry.Surfaces.Count, 4 * plan.Count,
            (s, j) => Law_TangentialPartialVanishesOnDegenerateSide(m.Geometry, SurfaceIndex(s), j / plan.Count, rows[s][j], m.Tolerances),
            (s, j) => m.SurfaceSite(SurfaceIndex(s)));
    }

    //==
    // # Curve self-tests

    // Check_DerivativeMatchesCentralDifference with IsWellFormed run once:
    // the law's guard-free claim behind CanEvaluateGiven.
    Check_DerivativeMatchesCentralDifferenceHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        return !ok
            ? NoSampleCheck("Law_DerivativeMatchesCentralDifference")
            : m.CheckCurveSamplesGiven(ok, plan, "Law_DerivativeMatchesCentralDifference",
                (c, t) => m.Geometry.CanEvaluateGiven(ok, c) ? m.Geometry.DerivativeAgrees(c, t) : true);
    }

    // Check_SecondDerivativeMatchesCentralDifference with IsWellFormed run once.
    Check_SecondDerivativeMatchesCentralDifferenceHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        return !ok
            ? NoSampleCheck("Law_SecondDerivativeMatchesCentralDifference")
            : m.CheckCurveSamplesGiven(ok, plan, "Law_SecondDerivativeMatchesCentralDifference",
                (c, t) => m.Geometry.CanEvaluateGiven(ok, c) ? m.Geometry.SecondDerivativeAgrees(c, t) : true);
    }

    // Check_Curve2DDerivativeMatchesCentralDifference with IsWellFormed run once.
    Check_Curve2DDerivativeMatchesCentralDifferenceHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        return !ok
            ? NoSampleCheck("Law_Curve2DDerivativeMatchesCentralDifference")
            : m.CheckCurve2DSamplesGiven(ok, plan, "Law_Curve2DDerivativeMatchesCentralDifference",
                (c, t) => m.Geometry.CanEvaluateGiven(ok, c) ? m.Geometry.DerivativeAgrees(c, t) : true);
    }

    // Check_Curve2DSecondDerivativeMatchesCentralDifference with IsWellFormed
    // run once.
    Check_Curve2DSecondDerivativeMatchesCentralDifferenceHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        return !ok
            ? NoSampleCheck("Law_Curve2DSecondDerivativeMatchesCentralDifference")
            : m.CheckCurve2DSamplesGiven(ok, plan, "Law_Curve2DSecondDerivativeMatchesCentralDifference",
                (c, t) => m.Geometry.CanEvaluateGiven(ok, c) ? m.Geometry.SecondDerivativeAgrees(c, t) : true);
    }

    // Check_PcurveDerivativeMatchesCentralDifference with IsWellFormed run once.
    Check_PcurveDerivativeMatchesCentralDifferenceHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        return !ok
            ? NoSampleCheck("Law_PcurveDerivativeMatchesCentralDifference")
            : m.CheckPcurveSamplesGiven(ok, plan, "Law_PcurveDerivativeMatchesCentralDifference",
                (p, t) => m.Geometry.CanEvaluateGiven(ok, p) ? m.Geometry.DerivativeAgrees(p, t) : true);
    }

    // Check_PcurveSecondDerivativeMatchesCentralDifference with IsWellFormed
    // run once.
    Check_PcurveSecondDerivativeMatchesCentralDifferenceHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        return !ok
            ? NoSampleCheck("Law_PcurveSecondDerivativeMatchesCentralDifference")
            : m.CheckPcurveSamplesGiven(ok, plan, "Law_PcurveSecondDerivativeMatchesCentralDifference",
                (p, t) => m.Geometry.CanEvaluateGiven(ok, p) ? m.Geometry.SecondDerivativeAgrees(p, t) : true);
    }

    // Check_ClosestParameterNoWorseThanSample with IsWellFormed run once for
    // the samples and query points, and each curve's samples and off-curve
    // points built once. The law guards itself.
    Check_ClosestParameterNoWorseThanSampleHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        var samples = m.CurveSampleTable(ok, plan);
        var off = m.Geometry.Curves.Count.MapRange(c => samples[c].Map(t => m.OffCurvePointGiven(ok, CurveIndex(c), t)));
        return CheckGrid("Law_ClosestParameterNoWorseThanSample", m.Geometry.Curves.Count, plan.Count * plan.Count,
            (c, ij) => Law_ClosestParameterNoWorseThanSample(m.Geometry, CurveIndex(c), off[c][ij / plan.Count], samples[c][ij % plan.Count]),
            (c, ij) => m.CurveSite(CurveIndex(c)));
    }

    // Check_ClosestParameterIsStationary with IsWellFormed run once for the
    // samples and query points. The law guards itself.
    Check_ClosestParameterIsStationaryHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        return m.CheckCurveSamplesGiven(ok, plan, "Law_ClosestParameterIsStationary",
            (c, t) => Law_ClosestParameterIsStationary(m.Geometry, c, m.OffCurvePointGiven(ok, c, t)));
    }

    //==
    // # Surface self-tests

    // Check_ProjectNoWorseThanSample with IsWellFormed run once for the
    // samples and query points, and each surface's grid and off-surface
    // points built once. The law guards itself.
    Check_ProjectNoWorseThanSampleHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        var samples = m.SurfaceSampleTable(ok, plan);
        var off = m.Geometry.Surfaces.Count.MapRange(s => samples[s].Map(uv => m.OffSurfacePointGiven(ok, SurfaceIndex(s), uv)));
        return CheckGrid("Law_ProjectNoWorseThanSample", m.Geometry.Surfaces.Count, plan.Count * plan.Count * plan.Count * plan.Count,
            (s, ij) => Law_ProjectNoWorseThanSample(m.Geometry, SurfaceIndex(s),
                off[s][ij / (plan.Count * plan.Count)], samples[s][ij % (plan.Count * plan.Count)]),
            (s, ij) => m.SurfaceSite(SurfaceIndex(s)));
    }

    // Check_ProjectIsStationary with IsWellFormed run once for the samples
    // and query points. The law guards itself.
    Check_ProjectIsStationaryHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        return m.CheckSurfaceParameterSamplesGiven(ok, plan, "Law_ProjectIsStationary",
            (s, uv, which) => Law_ProjectIsStationary(m.Geometry, s, m.OffSurfacePointGiven(ok, s, uv), which));
    }

    // Check_ProjectNearRecoversFromNearbySeed with IsWellFormed run once for
    // the samples and each surface's grid built once. The law guards itself.
    Check_ProjectNearRecoversFromNearbySeedHoisted(m: BrepModel, plan: SamplePlan): Check
    {
        var ok = m.Geometry.IsWellFormed;
        var samples = m.SurfaceSampleTable(ok, plan);
        return CheckGrid("Law_ProjectNearRecoversFromNearbySeed", m.Geometry.Surfaces.Count, 4 * plan.Count * plan.Count,
            (s, j) => Law_ProjectNearRecoversFromNearbySeed(m.Geometry, SurfaceIndex(s),
                samples[s][j % (plan.Count * plan.Count)],
                (j / (plan.Count * plan.Count)) % 2 == 0 ? 0.5 : -0.5,
                j / (2 * plan.Count * plan.Count) == 0 ? 0.5 : -0.5,
                m.Tolerances),
            (s, j) => m.SurfaceSite(SurfaceIndex(s)));
    }
}

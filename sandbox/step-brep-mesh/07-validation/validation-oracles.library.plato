//==
// # BrepOracles
//
// Layer 7 of the STEP B-rep to mesh design (README.md beside this file): the
// second source of truth. Each Oracle_ computes a quantity by a route that
// shares no code with layers 4 to 6, the code it is compared against: closed
// forms of patch areas; the area of a face by Green's theorem over its own
// loops in parameter space, built here from layer 1's evaluation and inverse
// evaluation and layer 2's edge domains and senses, never from a
// discretization or a triangulation; the volume of a shell by the divergence
// theorem over the same loops; the Euler characteristic from raw cell counts
// and the reduction's corrections; the angle-defect sum of a mesh vertex by
// vertex. The derivations are in the README, "The Green's-theorem oracle".
//
// Sections, in order:
//  - Closed forms
//  - Planar faces, exactly
//  - The Green's-theorem oracle
//  - Loops into the parameter plane
//  - Poles, windings and cuts
//  - Area potentials per surface
//  - The divergence-theorem volume
//  - Volume potentials per surface
//  - Euler characteristic and angle defects
//  - Curvature, perimeter, and the area tolerance
//  - Quadrature and helpers

library BrepOracles
{
    //==
    // # Closed forms
    //
    // Areas of patches of the elementary surfaces over a u sweep and a v
    // range, in ISO 10303-42's natural parameters (research/VALIDATION-MATH.md
    // 5.1). Each is the integral of the area element h over the rectangle.

    // A cylinder patch: h = R, so R |sweep| |height|.
    Oracle_CylinderPatchArea(radius: Number, sweep: Angle, height: Number): Number
        => radius.Abs * sweep.Radians.Abs * height.Abs;

    // A cone patch over v in [v0, v1] on one nappe (R + v tan a keeps its
    // sign): h = |R + v tan a| / cos a, so |sweep (G(v1) - G(v0))| with
    // G(v) = (R v + tan a v^2 / 2) / cos a. The frustum of radii r1, r2 and
    // slant s gives pi (r1 + r2) s.
    Oracle_ConePatchArea(radius: Number, semiAngle: Angle, sweep: Angle, v0: Number, v1: Number): Number
        => (sweep.Radians * (ConePotential(radius, semiAngle, v1) - ConePotential(radius, semiAngle, v0))).Abs;

    // The whole sphere: 4 pi R^2.
    Oracle_SphereArea(radius: Number): Number
        => 2.0 * Number.Tau * radius * radius;

    // A sphere zone over latitudes [v0, v1]: h = R^2 cos v, so
    // R^2 |sweep| (sin v1 - sin v0).
    Oracle_SphereZoneArea(radius: Number, sweep: Angle, v0: Number, v1: Number): Number
        => (radius * radius * sweep.Radians * (v1.Sin - v0.Sin)).Abs;

    // The whole ring torus: 4 pi^2 R r.
    Oracle_TorusArea(major: Number, minor: Number): Number
        => (Number.Tau * Number.Tau * major * minor).Abs;

    // A ring torus patch over v in [v0, v1]: h = r (R + r cos v), so
    // r |sweep| (R (v1 - v0) + r (sin v1 - sin v0)).
    Oracle_TorusPatchArea(major: Number, minor: Number, sweep: Angle, v0: Number, v1: Number): Number
        => (minor * sweep.Radians * (major * (v1 - v0) + minor * (v1.Sin - v0.Sin))).Abs;

    // The cone's area potential G(v) = (R v + tan a v^2 / 2) / cos a.
    ConePotential(radius: Number, semiAngle: Angle, v: Number): Number
        => (radius * v + semiAngle.Tan * v * v * 0.5) / semiAngle.Cos;

    //==
    // # Planar faces, exactly
    //
    // On a plane the area element is 1, and (1/2) the closed integral of
    // x dy - y dx over the exact edge curves is the area. A line edge
    // contributes its chord term; a circle or ellipse C + s1 cos t X' +
    // s2 sin t Y' contributes, with X' = (a, b) and Y' = (c, d) in the plane's
    // axes, (1/2)[Cx (s1 b (cos t1 - cos t0) + s2 d (sin t1 - sin t0))
    // - Cy (s1 a (cos t1 - cos t0) + s2 c (sin t1 - sin t0))
    // + s1 s2 (a d - b c)(t1 - t0)] (research/VALIDATION-MATH.md 5.4,
    // generalized to an ellipse in any orientation). Exact for faces bounded
    // by lines and conics; NaN when an edge is another curve.

    // The area of planar face f from its exact edge curves; NaN when f is
    // not on a plane, cannot be evaluated, or has an edge that is not a line,
    // circle or ellipse.
    Oracle_PlanarFaceArea(m: BrepModel, f: BrepFaceIndex): Number
        => (m.CanGreen(f) ? m.Geometry.SurfaceAt(m.Faces[f].Surface).IsPlaneCase : false)
            ? m.CoedgeSitesOfFace(f).Map(site => m.PlanarEdgeTerm(site, m.Geometry.SurfaceAt(m.Faces[f].Surface).PlacementOr(Frame3D.NaNFrame))).SumOf
                * m.FaceNormalSign(f).ToNumber
            : Number.Unmeasured;

    // The contribution (1/2) of x dy - y dx of the coedge at a site, in the
    // plane frame's axes, run the way the face runs it.
    PlanarEdgeTerm(m: BrepModel, site: CoedgeSite, frame: Frame3D): Number
    {
        var e = m.CoedgeAt(site).Edge;
        var range = m.EdgeDomain(e).Range;
        var forward = m.CoedgeRunsForwardOnCurve(site);
        return m.Geometry.CurveAt(m.Edges[e].Curve).PlanarArcTerm(m.Geometry, frame,
            forward ? range.Start : range.End, forward ? range.End : range.Start);
    }

    // (1/2) of x dy - y dx along a line or conic from t0 to t1, in the plane
    // frame's axes; NaN for every other curve.
    PlanarArcTerm(curve: BrepCurve, g: GeometrySet, frame: Frame3D, t0: Number, t1: Number): Number
        => match (curve)
        {
            Line(origin, velocity) => ChordTerm(frame, curve.Eval(g, t0), curve.Eval(g, t1));
            Circle(placement, radius) => ConicTerm(frame, placement, radius, radius, t0, t1);
            Ellipse(placement, semiAxis1, semiAxis2) => ConicTerm(frame, placement, semiAxis1, semiAxis2, t0, t1);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => Number.Unmeasured;
            Parabola(placement, focalDistance) => Number.Unmeasured;
            Polyline(points) => Number.Unmeasured;
            BSpline(data) => Number.Unmeasured;
            Trimmed(basis, range, sameSense) => Number.Unmeasured;
            Composite(segments) => Number.Unmeasured;
            Offset(basis, distance, reference) => Number.Unmeasured;
            OnSurface(spaceCurve, supports, master) => Number.Unmeasured;
        };

    // (1/2)(x_a y_b - x_b y_a) of the chord from a to b in the frame's axes:
    // the shoelace term.
    ChordTerm(frame: Frame3D, a: Point3D, b: Point3D): Number
        => 0.5 * (frame.LocalCoordinates(a).X * frame.LocalCoordinates(b).Y - frame.LocalCoordinates(b).X * frame.LocalCoordinates(a).Y);

    // (1/2) of x dy - y dx along the conic C + s1 cos t X' + s2 sin t Y' from
    // t0 to t1, in the plane frame's axes (the formula in the section note).
    ConicTerm(frame: Frame3D, placement: Frame3D, s1: Number, s2: Number, t0: Number, t1: Number): Number
    {
        var cx = frame.LocalCoordinates(placement.Origin).X;
        var cy = frame.LocalCoordinates(placement.Origin).Y;
        var a = placement.XAxis.Vector.Dot(frame.XAxis.Vector);
        var b = placement.XAxis.Vector.Dot(frame.YAxis.Vector);
        var c = placement.YAxis.Vector.Dot(frame.XAxis.Vector);
        var d = placement.YAxis.Vector.Dot(frame.YAxis.Vector);
        var dcos = t1.Cos - t0.Cos;
        var dsin = t1.Sin - t0.Sin;
        return 0.5 * (cx * (s1 * b * dcos + s2 * d * dsin) - cy * (s1 * a * dcos + s2 * c * dsin) + s1 * s2 * (a * d - b * c) * (t1 - t0));
    }

    // True for the Plane case.
    IsPlaneCase(surface: BrepSurface): Boolean
        => match (surface)
        {
            Plane(placement) => true;
            Cylinder(placement, radius) => false;
            Cone(placement, radius, semiAngle) => false;
            Sphere(placement, radius) => false;
            Torus(placement, major, minor, part) => false;
            Revolution(profile, axis) => false;
            LinearExtrusion(profile, extrusion) => false;
            BSpline(data) => false;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => false;
            Offset(basis, distance) => false;
        };

    // The placement of a placement-based surface, or fallback.
    PlacementOr(surface: BrepSurface, fallback: Frame3D): Frame3D
        => match (surface)
        {
            Plane(placement) => placement;
            Cylinder(placement, radius) => placement;
            Cone(placement, radius, semiAngle) => placement;
            Sphere(placement, radius) => placement;
            Torus(placement, major, minor, part) => placement;
            Revolution(profile, axis) => fallback;
            LinearExtrusion(profile, extrusion) => fallback;
            BSpline(data) => fallback;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => fallback;
            Offset(basis, distance) => fallback;
        };

    // A frame of NaNs: what a computation that needs a placement gets when
    // there is none, so its result is NaN rather than a number.
    NaNFrame(_: Frame3D): Frame3D
        => Frame3D(Point3D(Number.Unmeasured, Number.Unmeasured, Number.Unmeasured),
            Direction3D(Vector3D(Number.Unmeasured, Number.Unmeasured, Number.Unmeasured)),
            Direction3D(Vector3D(Number.Unmeasured, Number.Unmeasured, Number.Unmeasured)),
            Direction3D(Vector3D(Number.Unmeasured, Number.Unmeasured, Number.Unmeasured)));

    //==
    // # The Green's-theorem oracle
    //
    // A face's area is the integral of h over its region D in the parameter
    // plane. With P = -G, G an antiderivative of h in v, Green's theorem makes
    // it the closed integral of P du over the boundary of D run the way the
    // face runs it, times FaceNormalSign (which is +1 exactly when the stored
    // loops run counter-clockwise in (u, v)). Segments of constant u (seams,
    // cuts) contribute nothing; segments of constant v at a collapsed line
    // (pole sides) contribute -G(v_pole) du and must be present. The boundary
    // is built by GreenBoundary; the oracle runs it at two resolutions and
    // extrapolates (Richardson), which is exact for loops straight in (u, v)
    // and leaves an O(n^-4) error otherwise.

    // The number of chords per coedge of the oracle's coarse polygon; the fine
    // polygon has twice as many.
    GreenChords(_: Integer): Integer
        => 32;

    // The area of face f by Green's theorem over its own loops in parameter
    // space, including pole sides and cuts; NaN when the face cannot be
    // evaluated, has a poly loop, or lies on a surface the closed forms do not
    // cover and whose quadrature is not yet implemented.
    Oracle_FaceAreaByGreen(m: BrepModel, f: BrepFaceIndex): Number
        => m.CanGreen(f)
            ? Richardson(m.GreenArea(f, Integer.GreenChords), m.GreenArea(f, 2 * Integer.GreenChords))
            : Number.Unmeasured;

    // True when the oracle can run on face f: every index of the model in
    // range, the arena well formed, the face intact, and no poly loop.
    CanGreen(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.Geometry.IsWellFormed ? (m.IsFaceIntact(f) ? m.Faces[f].Bounds.All(b => m.Loops[b.Loop].IsPolyLoop.Not) : false) : false)
            : false;

    // The Richardson extrapolation of two results at n and 2n chords whose
    // error is c / n^2 + O(n^-4): (4 fine - coarse) / 3.
    Richardson(coarse: Number, fine: Number): Number
        => (4.0 * fine - coarse) / 3.0;

    // The oracle's own error budget for face f: the size of the Richardson
    // correction, |A(2n) - A(n)| / 3, which bounds the remaining O(n^-4)
    // error by a wide margin, plus the rounding of a sum of as many terms as
    // the boundary has segments, each at most the area.
    GreenAllowance(m: BrepModel, f: BrepFaceIndex): Number
        => m.CanGreen(f)
            ? (m.GreenArea(f, 2 * Integer.GreenChords) - m.GreenArea(f, Integer.GreenChords)).Abs / 3.0
                + ResolutionAt(m.GreenArea(f, 2 * Integer.GreenChords) * m.GreenBoundary(f, 2 * Integer.GreenChords).Count.ToNumber)
            : Number.Unmeasured;

    // The area of face f from its n-chord boundary: the signed integral times
    // FaceNormalSign. On a closed surface (a whole sphere or torus) a region
    // is fixed by its loops only up to the whole surface, so a non-positive
    // result is moved up by the surface's total area.
    GreenArea(m: BrepModel, f: BrepFaceIndex, n: Integer): Number
    {
        var raw = m.RawGreenArea(f, n);
        var total = m.Geometry.SurfaceAt(m.Faces[f].Surface).ClosedSurfaceArea;
        return raw > 0.0 ? raw : (total.IsFinite ? raw + total : raw);
    }

    // The signed Green integral of face f's n-chord boundary times
    // FaceNormalSign, before the closed-surface correction; the cone's
    // potential takes the face's nappe sign (FaceNappeSign).
    RawGreenArea(m: BrepModel, f: BrepFaceIndex, n: Integer): Number
    {
        var surface = m.Geometry.SurfaceAt(m.Faces[f].Surface);
        var nappe = m.FaceNappeSign(f);
        return m.GreenBoundary(f, n).Map(seg => surface.AreaSegment(m.Geometry, seg, nappe)).SumOf
            * m.FaceNormalSign(f).ToNumber;
    }

    // The whole area of a closed surface: a sphere's 4 pi R^2, a ring
    // torus's 4 pi^2 R r; NaN for every surface that is not closed in both
    // directions.
    ClosedSurfaceArea(surface: BrepSurface): Number
        => match (surface)
        {
            Plane(placement) => Number.Unmeasured;
            Cylinder(placement, radius) => Number.Unmeasured;
            Cone(placement, radius, semiAngle) => Number.Unmeasured;
            Sphere(placement, radius) => Oracle_SphereArea(radius);
            Torus(placement, major, minor, part) => part == TorusPart.Full && major > minor ? Oracle_TorusArea(major, minor) : Number.Unmeasured;
            Revolution(profile, axis) => Number.Unmeasured;
            LinearExtrusion(profile, extrusion) => Number.Unmeasured;
            BSpline(data) => Number.Unmeasured;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => Number.Unmeasured;
            Offset(basis, distance) => Number.Unmeasured;
        };

    // The volume a closed surface encloses, its whole outward flux over
    // three: a sphere's 4 pi R^3 / 3, a ring torus's 2 pi^2 R r^2; NaN where
    // ClosedSurfaceArea is NaN. Its outward side is the side S_u x S_v points
    // to, so a face whose normal agrees with the surface's adds it.
    ClosedSurfaceVolume(surface: BrepSurface): Number
        => match (surface)
        {
            Plane(placement) => Number.Unmeasured;
            Cylinder(placement, radius) => Number.Unmeasured;
            Cone(placement, radius, semiAngle) => Number.Unmeasured;
            Sphere(placement, radius) => 2.0 * Number.Tau * radius.Abs * radius * radius / 3.0;
            Torus(placement, major, minor, part) => part == TorusPart.Full && major > minor ? Number.Pi * Number.Tau * major * minor * minor : Number.Unmeasured;
            Revolution(profile, axis) => Number.Unmeasured;
            LinearExtrusion(profile, extrusion) => Number.Unmeasured;
            BSpline(data) => Number.Unmeasured;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => Number.Unmeasured;
            Offset(basis, distance) => Number.Unmeasured;
        };

    // The boundary of face f's region in its parameter plane at n chords per
    // coedge: the segments of every bound's lifted path, the implicit pole
    // sides that balance the paths' net winding in u, and the cut pairs of
    // paths that wind in v.
    GreenBoundary(m: BrepModel, f: BrepFaceIndex, n: Integer): Array<GreenSegment>
    {
        var paths = m.Faces[f].Bounds.Count.Range.FlatMap(j => m.GreenPathsOfBound(f, j, n));
        return paths.FlatMap(p => p.PathSegments)
            .Concatenate(m.ImplicitPoleSegments(f, paths))
            .Concatenate(m.CutSegments(f, paths));
    }

    // The segments of a lifted path: between consecutive points, and from
    // the last back to the first when the path closes in the plane.
    PathSegments(p: GreenPath): Array<GreenSegment>
        => (p.Points.Count - 1).Max(0).MapRange(i => GreenSegment(p.Points[i], p.Points[i + 1]))
            .Concatenate(p.Closed ? (p.Points.Count > 1 ? [GreenSegment(p.Points.Last, p.Points.First)] : []) : []);

    //==
    // # Loops into the parameter plane
    //
    // Each coedge is sampled at n + 1 equal steps of its edge domain, in the
    // direction the face runs it, mapped by layer 1's Project, and lifted by
    // continuity (layer 0's NearestUnwrapped). A sample on a collapsed line
    // in v (a pole, an apex) has no u of its own and takes its neighbour's.
    // Consecutive coedges are joined by shifting each by whole periods: by
    // continuity at an ordinary vertex; at a vertex on a collapsed line by the
    // pole rule (PoleDeltaU), which makes the jump in u the pole side.

    // The lifted paths of bound j of face f: one for an edge loop; one pole
    // side for a vertex loop on a collapsed line; none for a vertex loop
    // elsewhere (a point hole, which bounds no area) or a poly loop.
    GreenPathsOfBound(m: BrepModel, f: BrepFaceIndex, j: Integer, n: Integer): Array<GreenPath>
        => m.GreenPathsOfLoop(f, j, n, m.Loops[m.Faces[f].Bounds[j].Loop]);

    // GreenPathsOfBound for the bound's loop record (a parameter, so the
    // match subject has a declared type).
    GreenPathsOfLoop(m: BrepModel, f: BrepFaceIndex, j: Integer, n: Integer, loop: BrepLoop): Array<GreenPath>
        => match (loop)
        {
            EdgeLoop(coedges) => [m.EdgeLoopPath(f, j, n)];
            VertexLoop(vertex) => m.VertexLoopPaths(f, vertex);
            PolyLoop(points) => [];
        };

    // The lifted path of edge-loop bound j of face f: every coedge's lifted
    // samples, each coedge shifted to join the one before it, then closed.
    EdgeLoopPath(m: BrepModel, f: BrepFaceIndex, j: Integer, n: Integer): GreenPath
        => m.ClosedPath(f, m.LoopCoedges(m.Faces[f].Bounds[j].Loop).Count.Range.Reduce(UvCoordinate.NoUvs, (acc, k) =>
            acc.Concatenate(m.ShiftedCoedgePath(f, acc, CoedgeSite(f, j, k), n))));

    // The lifted samples of the coedge at a site, shifted by whole periods to
    // join the path so far (acc); unshifted for the first coedge.
    ShiftedCoedgePath(m: BrepModel, f: BrepFaceIndex, acc: Array<UvCoordinate>, site: CoedgeSite, n: Integer): Array<UvCoordinate>
    {
        var path = m.CoedgeUvPath(site, n);
        var shift = acc.Count < 2 ? Vector2D(0.0, 0.0) : m.JunctionShift(f, acc[acc.Count - 2], acc.Last, path.First);
        return path.Map(uv => uv + shift);
    }

    // The n + 1 samples of the coedge at a site, in the direction the face
    // runs it, mapped into the face's parameter plane, collapsed-line samples
    // given their neighbour's u, lifted by continuity.
    CoedgeUvPath(m: BrepModel, site: CoedgeSite, n: Integer): Array<UvCoordinate>
    {
        var s = m.Faces[site.Face].Surface;
        var raw = m.CoedgeSamplePoints(site, n).Map(p => m.Geometry.Project(s, p));
        var filled = raw.Count.MapRange(k => m.IsAtVCollapse(site.Face, raw[k])
            ? UvCoordinate(raw[k == 0 ? 1 : k - 1].U, raw[k].V)
            : raw[k]);
        return filled.UnwrappedFrom(m.Geometry.Domain(s));
    }

    // The n + 1 points of the coedge's edge curve at equal steps of the edge
    // domain, in the direction the face runs the coedge.
    CoedgeSamplePoints(m: BrepModel, site: CoedgeSite, n: Integer): Array<Point3D>
    {
        var e = m.CoedgeAt(site).Edge;
        var range = m.EdgeDomain(e).Range;
        var forward = m.CoedgeRunsForwardOnCurve(site);
        return (n + 1).MapRange(k => m.Geometry.Eval(m.Edges[e].Curve,
            range.Lerp((forward ? k : n - k).ToNumber / n.ToNumber)));
    }

    // The points lifted by continuity: each the copy, by whole periods, of
    // the input nearest the previous output.
    UnwrappedFrom(uvs: Array<UvCoordinate>, d: SurfaceDomain): Array<UvCoordinate>
        => uvs.Count.Range.Reduce(UvCoordinate.NoUvs, (acc, k) =>
            acc.Append(k == 0 ? uvs[0] : d.NearestUnwrapped(uvs[k], acc.Last)));

    // The shift that joins a coedge starting at `start` to a path arriving at
    // `arrive` (after `before`): continuity in both directions at an ordinary
    // vertex; at a vertex on a collapsed line in v, continuity in v and the
    // pole rule in u, so that the jump from arrive to the shifted start is
    // the pole side.
    JunctionShift(m: BrepModel, f: BrepFaceIndex, before: UvCoordinate, arrive: UvCoordinate, start: UvCoordinate): Vector2D
    {
        var continuity = m.Geometry.Domain(m.Faces[f].Surface).NearestUnwrapped(start, arrive) - start;
        return m.IsAtVCollapse(f, arrive)
            ? Vector2D(arrive.U + m.PoleDeltaU(f, before, arrive, start) - start.U, continuity.Y)
            : continuity;
    }

    // The u step of a pole side at the collapsed line through `arrive`, from
    // the arriving u to the leaving one. The face lies below a pole it
    // approached going up (before.V < arrive.V) and above one it approached
    // going down; with sigma = (below ? -1 : +1) times FaceNormalSign, the side
    // runs with sigma > 0 in (0, P] and with sigma < 0 in [-P, 0), the
    // representative of start - arrive modulo the period P, a whole period
    // when the two are the same parameter within u's parameter floor
    // (the face goes all the way round the pole). An aperiodic u gives the
    // plain difference.
    PoleDeltaU(m: BrepModel, f: BrepFaceIndex, before: UvCoordinate, arrive: UvCoordinate, start: UvCoordinate): Number
    {
        var period = m.Geometry.Domain(m.Faces[f].Surface).U.Periodicity.PeriodOr(0.0);
        var floor = m.Geometry.ParameterFloorAlong(m.Faces[f].Surface, SurfaceParameter.ParameterU, m.Tolerances).Value;
        var sigma = (before.V < arrive.V ? -1 : 1) * m.FaceNormalSign(f);
        var w = period > 0.0 ? (start.U - arrive.U).Wrap(period) : start.U - arrive.U;
        var whole = period > 0.0 ? (w <= floor || period - w <= floor) : false;
        return period > 0.0
            ? (sigma > 0 ? (whole ? period : w) : (whole ? 0.0 - period : w - period))
            : w;
    }

    // The path of points closed back to its first: at a collapsed line the
    // closing pole side is added (the pole rule), then the path closes when
    // its last point is its first up to no whole period, and otherwise
    // records how many periods it winds in u and in v.
    ClosedPath(m: BrepModel, f: BrepFaceIndex, points: Array<UvCoordinate>): GreenPath
    {
        var d = m.Geometry.Domain(m.Faces[f].Surface);
        var last = points.Last;
        var atPole = m.IsAtVCollapse(f, last);
        var landing = atPole
            ? UvCoordinate(last.U + m.PoleDeltaU(f, points[points.Count - 2], last, points.First), last.V)
            : last;
        var windingU = d.U.Periodicity.IsPeriodic ? ((landing.U - points.First.U) / d.U.Periodicity.PeriodOr(1.0)).ToInteger : 0;
        var windingV = d.V.Periodicity.IsPeriodic ? ((landing.V - points.First.V) / d.V.Periodicity.PeriodOr(1.0)).ToInteger : 0;
        return GreenPath(atPole ? points.Append(landing) : points, windingU == 0 && windingV == 0, windingU, windingV);
    }

    // The empty array of parameter-plane points.
    NoUvs(_: UvCoordinate): Array<UvCoordinate>
        => [UvCoordinate(0.0, 0.0)].Take(0);

    //==
    // # Poles, windings and cuts

    // True when uv lies on a collapsed line in v of face f's surface (a pole,
    // an apex): within v's parameter floor of a value CollapsedAt
    // lists, measured around the circle when v is periodic.
    IsAtVCollapse(m: BrepModel, f: BrepFaceIndex, uv: UvCoordinate): Boolean
        => m.Geometry.CollapsedAt(m.Faces[f].Surface, SurfaceParameter.ParameterV, m.Tolerances)
            .Any(c => m.Geometry.Domain(m.Faces[f].Surface).V.SameParameter(uv.V, c,
                m.Geometry.ParameterFloorAlong(m.Faces[f].Surface, SurfaceParameter.ParameterV, m.Tolerances)));

    // The pole side of a vertex loop at vertex v of face f: a whole period in
    // u at the vertex's collapsed line, run by the pole rule (the face lies
    // below a collapse above the face's other points, above one below them);
    // none when the vertex is not on a collapsed line (a point hole).
    VertexLoopPaths(m: BrepModel, f: BrepFaceIndex, v: BrepVertexIndex): Array<GreenPath>
    {
        var uv = m.Geometry.Project(m.Faces[f].Surface, m.Vertices[v].Point);
        var period = m.Geometry.Domain(m.Faces[f].Surface).U.Periodicity.PeriodOr(Number.Unmeasured);
        var sigma = (uv.V > m.FaceReferenceV(f) ? -1 : 1) * m.FaceNormalSign(f);
        return m.IsAtVCollapse(f, uv)
            ? [GreenPath([UvCoordinate(0.0, uv.V), UvCoordinate(sigma.ToNumber * period, uv.V)], false, sigma, 0)]
            : [];
    }

    // The v the side of a vertex-loop pole is judged against: the mean v of
    // the projections of the face's edge-loop vertices that are on no
    // collapsed line, or the middle of the surface's v range when there are
    // none (a whole sphere bounded by two pole vertex loops).
    FaceReferenceV(m: BrepModel, f: BrepFaceIndex): Number
    {
        var s = m.Faces[f].Surface;
        var vs = m.CoedgeSitesOfFace(f)
            .Map(site => m.Geometry.Project(s, m.Vertices[m.StartVertex(m.CoedgeAt(site))].Point))
            .FlatMap(uv => m.IsAtVCollapse(f, uv) ? [] : [uv.V]);
        return vs.Count > 0 ? vs.SumOf / vs.Count.ToNumber : m.Geometry.Domain(s).V.BoundedSampleRange.Lerp(0.5);
    }

    // The implicit pole side that balances the paths' net winding W in u: a
    // region whose loops wind round the period without reaching a pole
    // contains one (a hemisphere bounded by its equator). It runs -W periods
    // at the collapsed line on the face's side of the paths (above them when
    // W times FaceNormalSign is positive); a NaN segment when no collapsed
    // line lies there, so the oracle reports no number for a region it cannot
    // close.
    ImplicitPoleSegments(m: BrepModel, f: BrepFaceIndex, paths: Array<GreenPath>): Array<GreenSegment>
    {
        var w = paths.Reduce(0, (n, p) => n + p.WindingU);
        var period = m.Geometry.Domain(m.Faces[f].Surface).U.Periodicity.PeriodOr(Number.Unmeasured);
        var c = m.ImplicitPoleV(f, w * m.FaceNormalSign(f) > 0, paths.Count > 0 ? (paths[0].Points.Count > 0 ? paths[0].Points.First.V : 0.0) : 0.0);
        return w == 0 ? [] : [GreenSegment(UvCoordinate(0.0, c), UvCoordinate(0.0 - w.ToNumber * period, c))];
    }

    // The collapsed line in v of face f's surface nearest above (or below)
    // the reference v; NaN when there is none on that side.
    ImplicitPoleV(m: BrepModel, f: BrepFaceIndex, above: Boolean, reference: Number): Number
        => m.Geometry.CollapsedAt(m.Faces[f].Surface, SurfaceParameter.ParameterV, m.Tolerances).Reduce(Number.Unmeasured, (best, c) =>
            (above ? c > reference : c < reference)
                ? (best.IsNaN ? c : (above ? best.Min(c) : best.Max(c)))
                : best);

    // The cut pairs of the paths that wind in v (a torus band between two
    // meridians): for each such path L, with k its winding in v and (u_L, v_L)
    // its first point, a segment at v_L + k Pv from u_L back to u_ref and one
    // at v_L from u_ref to u_L, u_ref the first such path's u. Each pair
    // contributes -k times the integral of the potential's jump over one
    // period in v from u_ref to u_L, which closes the lifted region in the
    // plane (README, "The Green's-theorem oracle").
    CutSegments(m: BrepModel, f: BrepFaceIndex, paths: Array<GreenPath>): Array<GreenSegment>
    {
        var winding = paths.FlatMap(p => p.WindingV == 0 ? [] : [p]);
        var pv = m.Geometry.Domain(m.Faces[f].Surface).V.Periodicity.PeriodOr(Number.Unmeasured);
        var uref = winding.Count > 0 ? winding[0].Points.First.U : 0.0;
        return winding.FlatMap(p => [
            GreenSegment(
                UvCoordinate(p.Points.First.U, p.Points.First.V + p.WindingV.ToNumber * pv),
                UvCoordinate(uref, p.Points.First.V + p.WindingV.ToNumber * pv)),
            GreenSegment(UvCoordinate(uref, p.Points.First.V), UvCoordinate(p.Points.First.U, p.Points.First.V))]);
    }

    //==
    // # Area potentials per surface
    //
    // The integral of P du = -G(v) du along a straight segment from (u0, v0)
    // to (u1, v1) is -du times the mean of G over it, with vm the mid v,
    // dv = v1 - v0, and the means of sin and cos over the segment
    // sin(vm) sinc(dv/2) and cos(vm) sinc(dv/2) (research/VALIDATION-MATH.md
    // 5.2). Exact on every segment.

    // The integral of P du along the segment for the surface's area
    // potential; quadrature for the cases with no closed form. nappe is the
    // cone's sign for the whole face (FaceNappeSign), 1 elsewhere.
    AreaSegment(surface: BrepSurface, g: GeometrySet, seg: GreenSegment, nappe: Number): Number
    {
        var du = seg.To.U - seg.From.U;
        var v0 = seg.From.V;
        var v1 = seg.To.V;
        var vm = (v0 + v1) * 0.5;
        var meanSquare = (v0 * v0 + v0 * v1 + v1 * v1) / 3.0;
        return match (surface)
        {
            Plane(placement) => 0.0 - du * vm;
            Cylinder(placement, radius) => 0.0 - du * radius.Abs * vm;
            Cone(placement, radius, semiAngle) => ConeAreaSegment(radius, semiAngle, seg) * nappe;
            Sphere(placement, radius) => 0.0 - du * radius * radius * vm.Sin * Sinc((v1 - v0) * 0.5);
            Torus(placement, major, minor, part) => 0.0 - du * minor.Abs * (major * vm + minor * vm.Sin * Sinc((v1 - v0) * 0.5))
                * (major + minor * vm.Cos).Sign.ToNumber;
            Revolution(profile, axis) => surface.RevolutionAreaSegment(g, seg);
            LinearExtrusion(profile, extrusion) => surface.ExtrusionAreaSegment(g, seg);
            BSpline(data) => surface.AreaSegmentByQuadrature(g, seg);
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => surface.AreaSegmentByQuadrature(g, seg);
            Offset(basis, distance) => surface.AreaSegmentByQuadrature(g, seg);
        };
    }

    // The sign of the cone's signed radius over face f: -1 when the face lies
    // on the nappe where rho = R + v tan a is negative, +1 otherwise and on
    // every surface that is not a cone. Read at the boundary point of f's
    // Green boundary where |rho| is largest, so a segment on the apex, where
    // rho is 0, takes its face's nappe. Precondition: m.CanGreen(f).
    FaceNappeSign(m: BrepModel, f: BrepFaceIndex): Number
        => m.Geometry.SurfaceAt(m.Faces[f].Surface).IsConeSurface
            ? m.Geometry.SurfaceAt(m.Faces[f].Surface).NappeSign(m.GreenBoundary(f, Integer.GreenChords))
            : 1.0;

    // NappeSign for one surface record and the segments of a face's boundary.
    NappeSign(surface: BrepSurface, segs: Array<GreenSegment>): Number
        => match (surface)
        {
            Plane(placement) => 1.0;
            Cylinder(placement, radius) => 1.0;
            Cone(placement, radius, semiAngle) => radius.FarthestSignedRadius(semiAngle, segs) < 0.0 ? -1.0 : 1.0;
            Sphere(placement, radius) => 1.0;
            Torus(placement, major, minor, part) => 1.0;
            Revolution(profile, axis) => 1.0;
            LinearExtrusion(profile, extrusion) => 1.0;
            BSpline(data) => 1.0;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => 1.0;
            Offset(basis, distance) => 1.0;
        };

    // The signed radius R + v tan a of largest magnitude over the start points
    // of the segments; 0 when there are none.
    FarthestSignedRadius(radius: Number, semiAngle: Angle, segs: Array<GreenSegment>): Number
        => segs.Reduce(0.0, (best, s) =>
            (radius + s.From.V * semiAngle.Tan).Abs > best.Abs ? radius + s.From.V * semiAngle.Tan : best);

    // The cone's integral of -G(v) du along a straight segment, unsigned by
    // the nappe: the library's Cone arm of AreaSegment without its sign.
    ConeAreaSegment(radius: Number, semiAngle: Angle, seg: GreenSegment): Number
    {
        var du = seg.To.U - seg.From.U;
        var vm = (seg.From.V + seg.To.V) * 0.5;
        var meanSquare = (seg.From.V * seg.From.V + seg.From.V * seg.To.V + seg.To.V * seg.To.V) / 3.0;
        return 0.0 - du * (radius * vm + semiAngle.Tan * meanSquare * 0.5) / semiAngle.Cos;
    }

    // Whether a surface record is a cone.
    IsConeSurface(surface: BrepSurface): Boolean
        => match (surface)
        {
            Plane(placement) => false;
            Cylinder(placement, radius) => false;
            Cone(placement, radius, semiAngle) => true;
            Sphere(placement, radius) => false;
            Torus(placement, major, minor, part) => false;
            Revolution(profile, axis) => false;
            LinearExtrusion(profile, extrusion) => false;
            BSpline(data) => false;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => false;
            Offset(basis, distance) => false;
        };

    // A surface of revolution of a line profile in a plane through the axis:
    // h(v) = |V| rho(v), rho the distance of the profile point from the axis,
    // linear in v (rho(v) = rho0 + (rho1 - rho0) v from the profile's points at
    // 0 and 1), so G(v) = |V| (rho0 v + (rho1 - rho0) v^2 / 2) on a segment
    // that does not cross the axis. Quadrature for every other profile, and
    // for a line profile not coplanar with the axis (a hyperboloid), whose
    // area element is not |V| rho.
    RevolutionAreaSegment(surface: BrepSurface, g: GeometrySet, seg: GreenSegment): Number
        => match (surface)
        {
            Plane(placement) => Number.Unmeasured;
            Cylinder(placement, radius) => Number.Unmeasured;
            Cone(placement, radius, semiAngle) => Number.Unmeasured;
            Sphere(placement, radius) => Number.Unmeasured;
            Torus(placement, major, minor, part) => Number.Unmeasured;
            Revolution(profile, axis) => g.IsCoplanarLineProfile(profile, axis)
                ? 0.0 - (seg.To.U - seg.From.U) * g.Derivative(profile, 0.0).Length
                    * (g.AxisDistance(profile, axis, 0.0) * (seg.From.V + seg.To.V) * 0.5
                        + (g.AxisDistance(profile, axis, 1.0) - g.AxisDistance(profile, axis, 0.0))
                            * (seg.From.V * seg.From.V + seg.From.V * seg.To.V + seg.To.V * seg.To.V) / 6.0)
                : surface.AreaSegmentByQuadrature(g, seg);
            LinearExtrusion(profile, extrusion) => Number.Unmeasured;
            BSpline(data) => Number.Unmeasured;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => Number.Unmeasured;
            Offset(basis, distance) => Number.Unmeasured;
        };

    // A linear extrusion whose area element |L'(u) x V| is constant (a line
    // profile, or a circle in a plane perpendicular to V): G(v) = h v, so
    // -du h vm. Quadrature otherwise.
    ExtrusionAreaSegment(surface: BrepSurface, g: GeometrySet, seg: GreenSegment): Number
        => match (surface)
        {
            Plane(placement) => Number.Unmeasured;
            Cylinder(placement, radius) => Number.Unmeasured;
            Cone(placement, radius, semiAngle) => Number.Unmeasured;
            Sphere(placement, radius) => Number.Unmeasured;
            Torus(placement, major, minor, part) => Number.Unmeasured;
            Revolution(profile, axis) => Number.Unmeasured;
            LinearExtrusion(profile, extrusion) => g.HasConstantExtrusionElement(profile, extrusion)
                ? 0.0 - (seg.To.U - seg.From.U) * g.Derivative(profile, 0.0).Cross(extrusion).Length * (seg.From.V + seg.To.V) * 0.5
                : surface.AreaSegmentByQuadrature(g, seg);
            BSpline(data) => Number.Unmeasured;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => Number.Unmeasured;
            Offset(basis, distance) => Number.Unmeasured;
        };

    // True when the profile is a line lying in a plane through the axis: its
    // direction, its offset from the axis origin, and the axis are coplanar
    // within the angle tolerance of the arena's own scale (the triple product
    // against the product of the lengths).
    IsCoplanarLineProfile(g: GeometrySet, profile: CurveIndex, axis: InfiniteLine3D): Boolean
        => g.CurveAt(profile).IsLineCase
            ? axis.Direction.Vector.Dot((g.Eval(profile, 0.0) - axis.Origin).Cross(g.Derivative(profile, 0.0))).Abs
                <= ResolutionAt((g.Eval(profile, 0.0) - axis.Origin).Length * g.Derivative(profile, 0.0).Length)
            : false;

    // The distance from the axis of the profile's point at parameter t.
    AxisDistance(g: GeometrySet, profile: CurveIndex, axis: InfiniteLine3D, t: Number): Number
        => axis.Direction.Vector.Cross(g.Eval(profile, t) - axis.Origin).Length;

    // True when |L'(u) x V| does not depend on u: a line profile, or a circle
    // whose plane is perpendicular to V (its axis parallel to V within
    // rounding).
    HasConstantExtrusionElement(g: GeometrySet, profile: CurveIndex, extrusion: Vector3D): Boolean
        => g.CurveAt(profile).IsLineCase
            ? true
            : (g.CurveAt(profile).IsCircleCase
                ? g.Derivative(profile, 0.0).Dot(extrusion).Abs
                    <= ResolutionAt(g.Derivative(profile, 0.0).Length * extrusion.Length)
                : false);

    // True for the Line case of a curve.
    IsLineCase(curve: BrepCurve): Boolean
        => match (curve)
        {
            Line(origin, velocity) => true;
            Circle(placement, radius) => false;
            Ellipse(placement, semiAxis1, semiAxis2) => false;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => false;
            Parabola(placement, focalDistance) => false;
            Polyline(points) => false;
            BSpline(data) => false;
            Trimmed(basis, range, sameSense) => false;
            Composite(segments) => false;
            Offset(basis, distance, reference) => false;
            OnSurface(spaceCurve, supports, master) => false;
        };

    // True for the Circle case of a curve.
    IsCircleCase(curve: BrepCurve): Boolean
        => match (curve)
        {
            Line(origin, velocity) => false;
            Circle(placement, radius) => true;
            Ellipse(placement, semiAxis1, semiAxis2) => false;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => false;
            Parabola(placement, focalDistance) => false;
            Polyline(points) => false;
            BSpline(data) => false;
            Trimmed(basis, range, sameSense) => false;
            Composite(segments) => false;
            Offset(basis, distance, reference) => false;
            OnSurface(spaceCurve, supports, master) => false;
        };

    // deferred: the integral of P du along the segment for a surface with no
    // closed-form area potential (B-spline, offset, rectangular trimmed, a
    // general swept surface): P(u, v) = -(integral from v_ref to v of h(u, s)
    // ds), the inner integral by Gauss-Legendre with ceil(3p/2) points per
    // knot span in v (p the degree in v; 8 points for a non-spline surface),
    // the outer by the 5-point rule along the segment (GaussLegendreNodes). Converges
    // exponentially on each smooth patch; not exact (h is a square root).
    AreaSegmentByQuadrature(surface: BrepSurface, g: GeometrySet, seg: GreenSegment): Number;

    //==
    // # The divergence-theorem volume
    //
    // The volume a closed shell encloses is (1/3) the sum over its faces of
    // the integral of (sigma - O) . (S_u x S_v) over the face's region, for any
    // origin O (research/VALIDATION-MATH.md 5.6). The integrand f has P = -F,
    // F an antiderivative of f in v, so each face contributes (1/3) the
    // closed integral of P du over the same boundary the area uses, in the
    // stored orientation (FaceNormalSign cancels: n_out dA = FaceNormalSign
    // (S_u x S_v) du dv, and the stored loops run with that sign). Outer
    // shells give positive volumes, voids negative.

    // The volume shell s encloses by the divergence theorem over its exact
    // faces, about the centre of the bounding box of its vertices; NaN when a
    // face cannot be integrated (a poly loop, or a surface with no
    // closed-form potential). Total over loops that wind in v and over
    // regions fixed only up to their whole closed surface (FaceVolumeTerm).
    Oracle_DivergenceVolume(m: BrepModel, s: ShellIndex): Number
        => m.IsShellInRange(s)
            ? Richardson(m.ShellVolume(s, Integer.GreenChords), m.ShellVolume(s, 2 * Integer.GreenChords))
            : Number.Unmeasured;

    // The divergence oracle's own error budget for shell s, as GreenAllowance
    // is the area oracle's: the size of the Richardson correction,
    // |V(2n) - V(n)| / 3, plus the rounding of a sum of as many terms as the
    // shell's fine boundaries have segments, each at most the volume.
    DivergenceAllowance(m: BrepModel, s: ShellIndex): Number
        => m.IsShellInRange(s)
            ? (m.ShellVolume(s, 2 * Integer.GreenChords) - m.ShellVolume(s, Integer.GreenChords)).Abs / 3.0
                + ResolutionAt(m.ShellVolume(s, 2 * Integer.GreenChords).Abs
                    * m.ShellFaces(s).Map(f => m.GreenBoundary(f, 2 * Integer.GreenChords).Count).IntegerTotal.ToNumber)
            : Number.Unmeasured;

    // The volume a body encloses: the sum over its shells (the outer shell
    // positive, every void negative).
    Oracle_BodyVolume(m: BrepModel, b: BodyIndex): Number
        => m.IsBodyInRange(b) ? m.BodyShells(b).Map(s => m.Oracle_DivergenceVolume(s)).SumOf : Number.Unmeasured;

    // The shells of a body: the outer and the voids of a solid, all of a
    // shell set.
    BodyShells(m: BrepModel, b: BodyIndex): Array<ShellIndex>
        => m.Bodies[b].ShellsOfBody;

    // ShellsOfBody for one body record.
    ShellsOfBody(body: BrepBody): Array<ShellIndex>
        => match (body)
        {
            ManifoldSolid(outer) => [outer];
            SolidWithVoids(outer, voids) => [outer].Concatenate(voids);
            ShellSet(shells) => shells;
        };

    // The n-chord volume of shell s: one third of the sum of its faces' terms.
    ShellVolume(m: BrepModel, s: ShellIndex, n: Integer): Number
        => m.ShellFaces(s).Map(f => m.FaceVolumeTerm(f, m.ShellOrigin(s), n)).SumOf / 3.0;

    // The closed integral of the volume potential about origin o over face
    // f's n-chord boundary, the area's boundary with its pole sides and cut
    // pairs: Green's theorem on the cut-open region holds for any potential,
    // and the cut pairs lie at constant v, where IntegrateTrig is exact, so a
    // loop that winds in v (the torus witness) is integrated like any other.
    // Where the area oracle fixes the region only up to the whole closed
    // surface (its raw area is not positive, so the region is the loops'
    // region plus the surface), the surface's whole flux, three times the
    // volume it encloses, is added with the face's normal sign, as
    // GreenArea adds the whole area. NaN when the oracle cannot run on the
    // face or the surface has no closed-form potential.
    FaceVolumeTerm(m: BrepModel, f: BrepFaceIndex, o: Point3D, n: Integer): Number
        => m.CanGreen(f)
            ? m.GreenBoundary(f, n).Map(seg => m.Geometry.SurfaceAt(m.Faces[f].Surface).VolumeSegment(m.Geometry, o, seg)).SumOf
                + (m.RawGreenArea(f, n) > 0.0
                    ? 0.0
                    : 3.0 * m.Geometry.SurfaceAt(m.Faces[f].Surface).ClosedSurfaceVolume * m.FaceNormalSign(f).ToNumber)
            : Number.Unmeasured;

    // The centre of the bounding box of shell s's vertex points: the origin
    // of the volume sums, which keeps the products small far from the world
    // origin (research/VALIDATION-MATH.md 4.7).
    ShellOrigin(m: BrepModel, s: ShellIndex): Point3D
        => m.VerticesOfShell(s).Reduce(Bounds3D.Empty, (box, v) => box.Union(m.Vertices[v].Point)).Center;

    // The integral of P du along the segment for the volume potential about
    // o: exact on a segment of constant v (exact by construction: pole sides
    // and cuts copy their v), the 5-point Gauss-Legendre rule otherwise.
    VolumeSegment(surface: BrepSurface, g: GeometrySet, o: Point3D, seg: GreenSegment): Number
        => seg.From.V == seg.To.V
            ? surface.VolumeCoefficients(g, o, seg.From.V).IntegrateTrig(seg.From.U, seg.To.U)
            : (seg.To.U - seg.From.U) * Number.GaussLegendreNodes.Count.Range.Map(k =>
                Number.GaussLegendreWeights[k] * surface.VolumeCoefficients(g, o, seg.From.V + (seg.To.V - seg.From.V) * Number.GaussLegendreNodes[k])
                    .TrigAt(seg.From.U + (seg.To.U - seg.From.U) * Number.GaussLegendreNodes[k])).SumOf;

    // The integral of Constant + Cosine cos u + Sine sin u from u0 to u1.
    IntegrateTrig(t: TrigCoefficients, u0: Number, u1: Number): Number
        => t.Constant * (u1 - u0) + t.Cosine * (u1.Sin - u0.Sin) + t.Sine * (u0.Cos - u1.Cos);

    // Constant + Cosine cos u + Sine sin u at u.
    TrigAt(t: TrigCoefficients, u: Number): Number
        => t.Constant + t.Cosine * u.Cos + t.Sine * u.Sin;

    //==
    // # Volume potentials per surface
    //
    // P(u, v) = -F(u, v), F the antiderivative in v of
    // f = (sigma - O) . (S_u x S_v), with c = C - O in the placement's axes
    // (c = -LocalCoordinates(placement, O)), t = tan a, rho = R + t v:
    //   plane     f = c_z;                                  F = c_z v
    //   cylinder  f = R (c_x cos u + c_y sin u + R);        F = R v (c_x cos u + c_y sin u + R)
    //   cone      f = rho (c_x cos u + c_y sin u + R - t c_z);   F = (R v + t v^2/2)(c_x cos u + c_y sin u + R - t c_z)
    //   sphere    f = R^2 cos v (cos v (c_x cos u + c_y sin u) + c_z sin v + R)
    //             F = R^2 ((c_x cos u + c_y sin u)(v/2 + sin 2v / 4) + c_z sin^2 v / 2 + R sin v)
    //   torus     f = r (R + r cos v)((a + R) cos v + c_z sin v + r), a = c_x cos u + c_y sin u
    //             F = r ((a + R) S1 + c_z S2 + r R v + r^2 sin v),
    //             S1 = R sin v + r (v/2 + sin 2v / 4), S2 = -R cos v + r sin^2 v / 2
    // derived in the README, "The divergence-theorem volume".

    // The volume potential at v as Constant + Cosine cos u + Sine sin u; NaN
    // coefficients for the surfaces with no closed form (their volume is by
    // quadrature, deferred with AreaSegmentByQuadrature's rule).
    VolumeCoefficients(surface: BrepSurface, g: GeometrySet, o: Point3D, v: Number): TrigCoefficients
        => match (surface)
        {
            Plane(placement) => TrigCoefficients(0.0 - placement.OriginOffset(o).Z * v, 0.0, 0.0);
            Cylinder(placement, radius) => TrigCoefficients(
                0.0 - radius * radius * v,
                0.0 - radius * placement.OriginOffset(o).X * v,
                0.0 - radius * placement.OriginOffset(o).Y * v);
            Cone(placement, radius, semiAngle) => TrigCoefficients(
                0.0 - (radius * v + semiAngle.Tan * v * v * 0.5) * (radius - semiAngle.Tan * placement.OriginOffset(o).Z),
                0.0 - (radius * v + semiAngle.Tan * v * v * 0.5) * placement.OriginOffset(o).X,
                0.0 - (radius * v + semiAngle.Tan * v * v * 0.5) * placement.OriginOffset(o).Y);
            Sphere(placement, radius) => TrigCoefficients(
                0.0 - radius * radius * (placement.OriginOffset(o).Z * v.Sin * v.Sin * 0.5 + radius * v.Sin),
                0.0 - radius * radius * placement.OriginOffset(o).X * (v * 0.5 + (2.0 * v).Sin * 0.25),
                0.0 - radius * radius * placement.OriginOffset(o).Y * (v * 0.5 + (2.0 * v).Sin * 0.25));
            Torus(placement, major, minor, part) => TrigCoefficients(
                0.0 - minor * (major * TorusS1(major, minor, v) + placement.OriginOffset(o).Z * TorusS2(major, minor, v)
                    + minor * major * v + minor * minor * v.Sin),
                0.0 - minor * placement.OriginOffset(o).X * TorusS1(major, minor, v),
                0.0 - minor * placement.OriginOffset(o).Y * TorusS1(major, minor, v));
            Revolution(profile, axis) => TrigCoefficients.NaNCoefficients;
            LinearExtrusion(profile, extrusion) => TrigCoefficients.NaNCoefficients;
            BSpline(data) => TrigCoefficients.NaNCoefficients;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => TrigCoefficients.NaNCoefficients;
            Offset(basis, distance) => TrigCoefficients.NaNCoefficients;
        };

    // c = C - O in the placement's axes: the surface origin's offset from the
    // volume origin.
    OriginOffset(placement: Frame3D, o: Point3D): Vector3D
        => Vector3D(0.0, 0.0, 0.0) - placement.LocalCoordinates(o);

    // The torus's S1(v) = R sin v + r (v/2 + sin 2v / 4).
    TorusS1(major: Number, minor: Number, v: Number): Number
        => major * v.Sin + minor * (v * 0.5 + (2.0 * v).Sin * 0.25);

    // The torus's S2(v) = -R cos v + r sin^2 v / 2.
    TorusS2(major: Number, minor: Number, v: Number): Number
        => minor * v.Sin * v.Sin * 0.5 - major * v.Cos;

    // Coefficients of NaN: the potential of a surface with no closed form.
    NaNCoefficients(_: TrigCoefficients): TrigCoefficients
        => TrigCoefficients(Number.Unmeasured, Number.Unmeasured, Number.Unmeasured);

    //==
    // # Euler characteristic and angle defects

    // The reduced Euler characteristic of shell s by an independent route:
    // the raw counts' V - E + 2F - L (layer 2's RawCounts, a definition),
    // plus one for every closed degenerate edge (deleting it removes an edge
    // and nothing else) and one for every redundant vertex loop (dropping it
    // removes a bound); an open degenerate edge changes nothing (contracting
    // it removes an edge and merges two vertices). Equals layer 2's
    // ShellEulerPoincare (union-find over the same rule) when the open
    // degenerate edges form a forest and no edge loop consists of degenerate
    // edges only (research/VALIDATION-MATH.md 1.4).
    Oracle_EulerCharacteristic(m: BrepModel, s: ShellIndex): Integer
        => m.RawCounts(s).EulerPoincare + m.ClosedDegenerateEdgeCount(s) + m.RedundantVertexLoopCount(s);

    // The number of distinct edges of shell s that are degenerate and closed.
    ClosedDegenerateEdgeCount(m: BrepModel, s: ShellIndex): Integer
        => m.EdgesOfShell(s).Reduce(0, (n, e) => (m.IsClosedEdge(e) ? m.IsDegenerateEdge(e) : false) ? n + 1 : n);

    // The number of vertex loops of shell s's faces whose vertex lies on
    // another bound of the same face or repeats an earlier vertex loop there.
    RedundantVertexLoopCount(m: BrepModel, s: ShellIndex): Integer
        => m.ShellFaces(s).Reduce(0, (n, f) => n + m.RedundantVertexLoops(f));

    // The number of redundant vertex loops of face f, by the oracle's own
    // rule (OracleDropsVertexLoop), not layer 2's IsRedundantVertexLoop.
    RedundantVertexLoops(m: BrepModel, f: BrepFaceIndex): Integer
        => m.Faces[f].Bounds.Count.Range.Reduce(0, (n, j) =>
            m.OracleDropsVertexLoop(f, j) ? n + 1 : n);

    // Whether bound b of face f is a vertex loop the counting rule drops
    // (research/VALIDATION-MATH.md 1.4), written apart from layer 2's
    // IsRedundantVertexLoop so that the oracle checks that rule instead of
    // repeating it (finding F-48.1): the loop's vertex is an end of an edge
    // that an edge loop of f cites, or the vertex of a vertex loop of f at an
    // earlier position (a poly loop names no vertex). Reads the edge records directly, not layer 2's traversal.
    // Precondition: m.IsFaceIntact(f) and b a position in its bounds.
    OracleDropsVertexLoop(m: BrepModel, f: BrepFaceIndex, b: Integer): Boolean
        => m.OracleLoopVertex(m.Loops[m.Faces[f].Bounds[b].Loop]).Any(v =>
            m.Faces[f].Bounds.Count.Range.Any(j =>
                j == b ? false : m.OracleLoopCites(m.Loops[m.Faces[f].Bounds[j].Loop], v, j < b)));

    // The vertex of a vertex loop, as an array of one; empty for the other
    // loop kinds.
    OracleLoopVertex(m: BrepModel, loop: BrepLoop): Array<BrepVertexIndex>
        => match (loop)
        {
            EdgeLoop(coedges) => m.Vertices.Count.MapRange(i => BrepVertexIndex(i)).Take(0);
            VertexLoop(vertex) => [vertex];
            PolyLoop(points) => m.Vertices.Count.MapRange(i => BrepVertexIndex(i)).Take(0);
        };

    // Whether loop cites vertex v: an edge loop when v ends one of its edges,
    // a vertex loop when it is v and stands earlier in the face (earlier
    // true), a poly loop never.
    OracleLoopCites(m: BrepModel, loop: BrepLoop, v: BrepVertexIndex, earlier: Boolean): Boolean
        => match (loop)
        {
            EdgeLoop(coedges) => coedges.Any(c => m.Edges[c.Edge].Start == v || m.Edges[c.Edge].End == v);
            VertexLoop(vertex) => earlier ? vertex == v : false;
            PolyLoop(points) => false;
        };

    // The sum over the mesh's referenced vertices of the angle defect 2 pi
    // minus the corner angles there, in radians, by its own route: corner
    // angles by layer 0's AngleBetweenDirections (atan2 of the cross and dot
    // products), referenced vertices counted from the corners. On a closed
    // mesh of triangles it is 2 pi times the Euler characteristic (discrete
    // Gauss-Bonnet); with quads add the quads' own defects
    // (research/VALIDATION-MATH.md 4.5).
    Oracle_AngleDefectSum(mesh: ModelMesh): Number
        => Number.Tau * mesh.ReferencedVertexCount.ToNumber
            - mesh.ElementCount.MapRange(k => mesh.OracleAngleSum(ElementIndex(k))).SumOf;

    // The sum over the quads of 2 pi minus their corner angles: 0 exactly for
    // planar convex quads.
    Oracle_QuadDefectSum(mesh: ModelMesh): Number
        => mesh.Quads.Count.MapRange(q => Number.Tau - mesh.OracleAngleSum(ElementIndex(mesh.Triangles.Count + q))).SumOf;

    // The sum of element e's corner angles by AngleBetweenDirections; 0 when
    // a corner is out of range.
    OracleAngleSum(mesh: ModelMesh, e: ElementIndex): Number
        => mesh.HasValidCorners(e)
            ? mesh.ElementArity(e).MapRange(s => AngleBetweenDirections(
                Direction3D(mesh.CornerPoint(e, (s + 1) % mesh.ElementArity(e)) - mesh.CornerPoint(e, s)),
                Direction3D(mesh.CornerPoint(e, (s + mesh.ElementArity(e) - 1) % mesh.ElementArity(e)) - mesh.CornerPoint(e, s))).Radians).SumOf
            : 0.0;

    // The number of vertices that are a corner of some element, counted from
    // the corners: a flag per vertex set by every corner in range.
    ReferencedVertexCount(mesh: ModelMesh): Integer
    {
        var seen = new Buffer<Boolean>(mesh.Positions.Count);
        var corners = mesh.ElementCount.Range.FlatMap(k => mesh.ElementCorners(ElementIndex(k)));
        var i = 0;
        while (i < corners.Count)
        {
            if (mesh.Positions.IsValidIndex(corners[i]))
            {
                seen = seen.Set(corners[i].Value, true);
            }
            i = i + 1;
        }
        return seen.Freeze().Map(b => b ? 1 : 0).Reduce(0, (n, x) => n + x);
    }

    //==
    // # Curvature, perimeter, and the area tolerance

    // The largest absolute principal curvature of face f's surface over the
    // face: 0 on a plane, 1/R on a cylinder and a sphere, max(1/r, 1/(R - r))
    // on a ring torus, cos a / rho_min on a cone (rho_min the smallest
    // |R + v tan a| over the face's boundary, so infinite on a face that
    // reaches the apex, where the surface has no reach); by sampling for the
    // other surfaces (deferred).
    FaceCurvatureBound(m: BrepModel, f: BrepFaceIndex): Number
        => m.Geometry.SurfaceAt(m.Faces[f].Surface).CurvatureBound(m.FaceSmallestConeRadius(f), m, f);

    // CurvatureBound for one surface record; coneRadius is the face's
    // smallest |R + v tan a| when the surface is a cone.
    CurvatureBound(surface: BrepSurface, coneRadius: Number, m: BrepModel, f: BrepFaceIndex): Number
        => match (surface)
        {
            Plane(placement) => 0.0;
            Cylinder(placement, radius) => 1.0 / radius.Abs;
            Cone(placement, radius, semiAngle) => semiAngle.Cos / coneRadius;
            Sphere(placement, radius) => 1.0 / radius.Abs;
            Torus(placement, major, minor, part) => (1.0 / minor.Abs).Max(1.0 / (major - minor).Abs);
            Revolution(profile, axis) => m.SampledCurvatureBound(f);
            LinearExtrusion(profile, extrusion) => m.SampledCurvatureBound(f);
            BSpline(data) => m.SampledCurvatureBound(f);
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => m.SampledCurvatureBound(f);
            Offset(basis, distance) => m.SampledCurvatureBound(f);
        };

    // The smallest |R + v tan a| over face f's coarse Green boundary, when
    // its surface is a cone; NaN otherwise.
    FaceSmallestConeRadius(m: BrepModel, f: BrepFaceIndex): Number
        => m.CanGreen(f)
            ? m.GreenBoundary(f, Integer.GreenChords).Reduce(Number.MaxValue, (best, seg) =>
                best.Min(m.Geometry.SurfaceAt(m.Faces[f].Surface).ConeRadiusAt(seg.From.V)))
            : Number.Unmeasured;

    // |R + v tan a| on a cone; NaN on every other surface.
    ConeRadiusAt(surface: BrepSurface, v: Number): Number
        => match (surface)
        {
            Plane(placement) => Number.Unmeasured;
            Cylinder(placement, radius) => Number.Unmeasured;
            Cone(placement, radius, semiAngle) => (radius + v * semiAngle.Tan).Abs;
            Sphere(placement, radius) => Number.Unmeasured;
            Torus(placement, major, minor, part) => Number.Unmeasured;
            Revolution(profile, axis) => Number.Unmeasured;
            LinearExtrusion(profile, extrusion) => Number.Unmeasured;
            BSpline(data) => Number.Unmeasured;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => Number.Unmeasured;
            Offset(basis, distance) => Number.Unmeasured;
        };

    // deferred: the largest absolute principal curvature of face f's surface
    // over the face's parameter box: the eigenvalues of the shape operator
    // from second differences of Eval at the Green oracle's coarse boundary
    // points and a 9 by 9 grid of the box, times 1.5 for the space between
    // samples; infinite where the area element vanishes (an axis point).
    SampledCurvatureBound(m: BrepModel, f: BrepFaceIndex): Number;

    // The length of edge e's curve over its edge domain: |V| times the domain
    // length on a line, R times it on a circle, by quadrature otherwise.
    Oracle_EdgeLength(m: BrepModel, e: BrepEdgeIndex): Number
        => m.Geometry.CurveAt(m.Edges[e].Curve).IsLineCase
            ? m.Geometry.Derivative(m.Edges[e].Curve, 0.0).Length * m.EdgeDomain(e).ParameterLength
            : (m.Geometry.CurveAt(m.Edges[e].Curve).IsCircleCase
                ? m.Geometry.Derivative(m.Edges[e].Curve, 0.0).Length * m.EdgeDomain(e).ParameterLength
                : m.EdgeLengthByQuadrature(e));

    // deferred: the integral of |C'(t)| over edge e's domain by the 5-point
    // Gauss-Legendre rule on every span between consecutive breakpoints
    // (Breakpoints), each span halved until two successive results agree
    // within the length tolerance.
    EdgeLengthByQuadrature(m: BrepModel, e: BrepEdgeIndex): Number;

    // The length of face f's boundary: the lengths of the edges its coedges
    // cite, a seam counted twice (it bounds the face's parameter region on
    // both sides).
    Oracle_FacePerimeter(m: BrepModel, f: BrepFaceIndex): Number
        => m.CoedgeSitesOfFace(f).Map(site => m.Oracle_EdgeLength(m.CoedgeAt(site).Edge)).SumOf;

    // How far a face mesh made under criteria c may differ in area from the
    // exact face f (README, "The area tolerance"): with A the oracle's area,
    // kappa the face's curvature bound, d = SurfaceChordal + Length the
    // interior deviation, d_e = the effective edge chordal + Length the
    // boundary chords' deviation, P the perimeter, and theta = 2
    // SurfaceAngular the largest angle between an element's normal and the
    // surface normal under it,
    //   A ((1 + kappa d)^2 / cos theta - 1) + d_e P + the oracle's allowance.
    // The largest Number (no bound) when theta reaches pi/2.
    FaceAreaTolerance(m: BrepModel, f: BrepFaceIndex, c: FaceMeshingCriteria): Number
    {
        var a = m.Oracle_FaceAreaByGreen(f);
        var kappa = m.FaceCurvatureBound(f);
        var d = c.SurfaceChordal + m.Tolerances.Length.Value;
        var de = c.Discretization.EffectiveChordal(m.Tolerances) + m.Tolerances.Length.Value;
        var theta = c.SurfaceAngular.Radians * 2.0;
        var stretch = (1.0 + kappa * d) * (1.0 + kappa * d);
        return theta < Number.HalfPi
            ? a * (stretch / theta.Cos - 1.0) + de * m.Oracle_FacePerimeter(f) + m.GreenAllowance(f)
            : Number.MaxValue;
    }

    //==
    // # Quadrature and helpers

    // The nodes of the 5-point Gauss-Legendre rule on [0, 1], the one rule
    // this layer uses: exact for polynomials of degree 9 in the segment's
    // parameter.
    GaussLegendreNodes(_: Number): Array<Number>
        => [0.046910077030668, 0.230765344947158, 0.5, 0.769234655052842, 0.953089922969332];

    // The weights of the 5-point Gauss-Legendre rule on [0, 1], summing to 1.
    GaussLegendreWeights(_: Number): Array<Number>
        => [0.118463442528095, 0.239314335249683, 0.284444444444444, 0.239314335249683, 0.118463442528095];

    // sin(x) / x, 1 at 0: the series 1 - x^2 / 6 below |x| = 1e-4, where its
    // error x^4 / 120 is below 1e-18, and the quotient above.
    Sinc(x: Number): Number
        => x.Abs < 1e-4 ? 1.0 - x * x / 6.0 : x.Sin / x;
}

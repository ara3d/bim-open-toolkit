//==
// # TermWitnesses
//
// Track "termination" (TKT-346). The model that hung the mesher,
// built without a file: adapter/fixtures/unit-cube.stp with its plane #118
// replaced by a curved surface the cube's edges do not lie on (the TKT-313
// build-log entry of docs/plans/step-reader.md). Surface 5 of layer 7's
// Witness_UnitBoxMillimetres is #118 (planes #113 to #118 are surfaces 0 to
// 5): the plane x = 0, face 5, bounded by edges 3, 8, 7 and 11. Edge 3 (#56)
// runs from (0, 1, 0) to (0, 0, 0) and is shared with the bottom face 0,
// whose plane it does lie on.
//
// The names carry no Witness_ prefix on purpose: the law runner would feed
// an inconsistent model to every law over a BrepModel. The laws of this
// track name them.
//
// Sections, in order:
//  - The cube with one face off its edges

library TermWitnesses
{
    //==
    // # The cube with one face off its edges

    // The 1 mm unit box with surface 5 replaced by the k-th curved surface
    // of the C# finding, each on plane #118's own placement (origin, normal
    // -x): 0, SPHERICAL_SURFACE radius 0.5; 1, CYLINDRICAL_SURFACE radius
    // 0.5; 2, TOROIDAL_SURFACE major 2, minor 0.5. Any other k gives the
    // unchanged box, whose edges all lie on their faces. Both vertices of
    // edge 3 are at least 0.5 mm from each of the three surfaces (the one at
    // the origin is the sphere's centre and on the cylinder's axis), far
    // beyond any chordal bound; its midpoint lies on the sphere and the
    // cylinder.
    TermOffSurfaceCube(_: BrepModel, k: Integer): BrepModel
    {
        var box = BrepModel.Witness_UnitBoxMillimetres;
        var g = box.Geometry;
        var frame = FrameAt(Point3D(0.0, 0.0, 0.0), Vector3D(0.0, 0.0, 1.0), Vector3D(0.0, 1.0, 0.0), Vector3D(-1.0, 0.0, 0.0));
        var surface = k == 0 ? BrepSurface.Sphere(frame, 0.5)
            : (k == 1 ? BrepSurface.Cylinder(frame, 0.5)
            : (k == 2 ? BrepSurface.Torus(frame, 2.0, 0.5, TorusPart.Full)
            : g.Surfaces[5]));
        var surfaces = g.Surfaces.Count.MapRange(i => i == 5 ? surface : g.Surfaces[i]);
        return BrepModel(
            GeometrySet(g.Curves, g.Curves2D, g.Pcurves, surfaces, g.Closures),
            box.Vertices, box.Edges, box.Loops, box.Faces, box.Shells, box.Bodies, box.Tolerances, box.Unit);
    }

    // The criteria of the C# finding: DefaultCriteria(0.001), a 0.001 mm
    // chordal bound and a 1e-4 mm minimum length, so a 1 mm line may be cut
    // into up to 10^4 segments.
    TermFindingCriteria(_: DiscretizationCriteria): DiscretizationCriteria
        => DefaultCriteria(0.001);
}

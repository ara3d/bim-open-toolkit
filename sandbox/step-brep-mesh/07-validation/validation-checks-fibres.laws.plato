//==
// # Version 1: the identification checks in n log n, laws (TKT-399, second criterion)
//
// The indexed checks of v1-fibres.library.plato give the reference checks' Check, field for
// field, on every face mesh of every PoleWitness (07-validation/poles-witness) and on two mutations
// of each that break the identification: two unrelated points merged into one local vertex, and
// one point moved to a local vertex of its own. Some mutated mesh fails each check, so the
// agreement is not only on holding meshes.
//
// Sections, in order:
//  - Mutations
//  - Agreement
//  - Timing

library V1FibresLaws
{
    //==
    // # Mutations

    // Face mesh fm with its local vertex table replaced by lv.
    WithLocalVertex(fm: FaceMesh, lv: Array<VertexIndex>): FaceMesh
        => FaceMesh(fm.Face, fm.UvPoints, fm.Sources, lv, fm.Positions, fm.Normals, fm.Triangles, fm.Quads, fm.Provenance);

    // fm with its last point sent to its first point's local vertex: a merge the sources do not
    // identify (unless they do, when the checks hold on both forms).
    MergedFirstAndLast(fm: FaceMesh): FaceMesh
    {
        var n = fm.LocalVertex.Count;
        return n < 2 ? fm : fm.WithLocalVertex(n.MapRange(i => i == n - 1 ? fm.LocalVertex[0] : fm.LocalVertex[i]));
    }

    // fm with its first point sent to a new local vertex past the last one: a split of an
    // identified pair when the first point has a twin, and a local vertex no point maps to when
    // it had none (the vertex it left).
    SplitFirst(fm: FaceMesh): FaceMesh
        => fm.LocalVertex.Count == 0 ? fm
            : fm.WithLocalVertex(fm.LocalVertex.Count.MapRange(i => i == 0 ? VertexIndex(fm.Positions.Count) : fm.LocalVertex[i]));

    // The face meshes of witness w with both mutations of each.
    MeshesAndMutations(w: PoleWitness): Array<FaceMesh>
        => w.FaceMeshes.FlatMap(fm => [fm, fm.MergedFirstAndLast, fm.SplitFirst]);

    //==
    // # Agreement

    // True when two checks are equal in every field.
    SameCheck(a: Check, b: Check): Boolean
        => a.Law.Value == b.Law.Value && a.Holds == b.Holds && a.Worst == b.Worst && a.Bound == b.Bound && a.Where == b.Where;

    // The indexed fibre check is the reference's on every mesh and mutation of the witness.
    Law_V1Gate_FibresIndexedAgrees(w: PoleWitness): Boolean
        => w.MeshesAndMutations.All(fm => SameCheck(fm.Check_LocalVertexFibresAreIdentificationsIndexed, fm.Check_LocalVertexFibresAreIdentificationsReference));

    // The indexed surjectivity check is the reference's on every mesh and mutation of the witness.
    Law_V1Gate_SurjectiveIndexedAgrees(w: PoleWitness): Boolean
        => w.MeshesAndMutations.All(fm => SameCheck(fm.Check_LocalVertexSurjectiveIndexed, fm.Check_LocalVertexSurjectiveReference));

    // The mutations reach failures: on the sphere's face mesh the merge breaks the fibre check, and
    // the split leaves its first point's old local vertex unhit or breaks the fibres.
    Law_V1Gate_MutationsFail(w: PoleWitness): Boolean
        => w.Name == "Sphere"
            ? w.FaceMeshes[0].MergedFirstAndLast.Check_LocalVertexFibresAreIdentificationsIndexed.Holds.Not
                && (w.FaceMeshes[0].SplitFirst.Check_LocalVertexSurjectiveIndexed.Holds.Not
                    || w.FaceMeshes[0].SplitFirst.Check_LocalVertexFibresAreIdentificationsIndexed.Holds.Not)
            : true;

    // The indexed checks alone on every face mesh of the witness: the law's time is theirs.
    Law_V1Gate_IndexedChecksHold(w: PoleWitness): Boolean
        => w.FaceMeshes.All(fm => fm.Check_LocalVertexFibresAreIdentificationsIndexed.Holds && fm.Check_LocalVertexSurjectiveIndexed.Holds);

    //==
    // # Timing

    // ValidateFaceMesh at Geometric on every face mesh of the witness named name, all its checks
    // holding or not: the law's time is the validation's (TKT-399's second criterion).
    ValidatesOn(w: PoleWitness, name: String): Boolean
        => w.Name == name
            ? w.FaceMeshes.All(fm => w.Model.ValidateFaceMesh(w.Discretizations, fm, w.Options.Face, ConformanceLevel.Geometric).Checks.Count >= 0)
            : true;

    // ValidateFaceMesh on the Sphere pole witness's face meshes.
    Law_V1Gate_ValidateFaceMeshOnSphere(w: PoleWitness): Boolean
        => w.ValidatesOn("Sphere");

    // ValidateFaceMesh on the Torus pole witness's face meshes.
    Law_V1Gate_ValidateFaceMeshOnTorus(w: PoleWitness): Boolean
        => w.ValidatesOn("Torus");

    // ValidateFaceMesh on the Cone pole witness's face meshes.
    Law_V1Gate_ValidateFaceMeshOnCone(w: PoleWitness): Boolean
        => w.ValidatesOn("Cone");

    // ValidateFaceMesh on the TorusAtVertex pole witness's face meshes.
    Law_V1Gate_ValidateFaceMeshOnTorusAtVertex(w: PoleWitness): Boolean
        => w.ValidatesOn("TorusAtVertex");

    // ValidateFaceMesh on the SphereByPoleLoops pole witness's face meshes.
    Law_V1Gate_ValidateFaceMeshOnSphereByPoleLoops(w: PoleWitness): Boolean
        => w.ValidatesOn("SphereByPoleLoops");

    // ValidateFaceMesh on the RedundantPoleLoops pole witness's face meshes.
    Law_V1Gate_ValidateFaceMeshOnRedundantPoleLoops(w: PoleWitness): Boolean
        => w.ValidatesOn("RedundantPoleLoops");

    // ValidateFaceMesh on the SphereFine pole witness's face meshes.
    Law_V1Gate_ValidateFaceMeshOnSphereFine(w: PoleWitness): Boolean
        => w.ValidatesOn("SphereFine");

    // ValidateFaceMesh on the SphereByPoleLoopsFine pole witness's face meshes.
    Law_V1Gate_ValidateFaceMeshOnSphereByPoleLoopsFine(w: PoleWitness): Boolean
        => w.ValidatesOn("SphereByPoleLoopsFine");
}

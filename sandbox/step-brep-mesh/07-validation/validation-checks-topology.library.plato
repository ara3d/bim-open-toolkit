//==
// # BrepCheckingTopology
//
// Layer 7 of the STEP B-rep to mesh design (README.md beside this file): one
// Check_ per law of 02-topology and per model law of 00-foundation, each the
// law evaluated over every row (or pair of rows, or row and sample fraction)
// it quantifies over. Every comment names the Law_ evaluated, its constraint
// group, and the severity rule. Exact laws are folded from CheckExact and
// reported by ExactReport (an Error on failure); the geometric coupling laws
// measure the distance layer 2 exports for them (DomainEndDeviation,
// VertexCurveDeviation, SurfaceDeviationAt, PcurveDeviationAt,
// StartVertexDeviationAt) and compare it with the length tolerance, so a
// failure is a Warning below ten times the tolerance and an Error above. The
// guards are the laws' own, so a check holds exactly when its law does at
// every sample (validation.laws.plato, "Agreement of checks and laws").
//
// Sections, in order:
//  - Model tolerances (00-foundation)
//  - Indices, loops and bounds
//  - Edge uses and vertex links
//  - Euler-Poincare and bodies
//  - Edge domains and degenerate edges
//  - Geometry coupling
//  - Parameter-space winding
//  - Measures

library BrepCheckingTopology
{
    //==
    // # Model tolerances (00-foundation)

    // Law_LengthTolerancePositive on the model's length tolerance.
    // Topological group (a malformed tolerance makes every geometric verdict
    // meaningless): Error.
    Check_LengthTolerancePositive(m: BrepModel): Check
        => CheckOnce("Law_LengthTolerancePositive", Law_LengthTolerancePositive(m.Tolerances.Length));

    // Law_AngleTolerancePositive on the model's angle tolerance. Topological
    // group: Error.
    Check_AngleTolerancePositive(m: BrepModel): Check
        => CheckOnce("Law_AngleTolerancePositive", Law_AngleTolerancePositive(m.Tolerances.Angle));

    // Law_ParameterTolerancePositive on both of the model's parameter floors,
    // the length floor then the angle floor (layer 0's per-dimension floors).
    // Structure: Error.
    Check_ParameterTolerancePositive(m: BrepModel): Check
        => CheckAll("Law_ParameterTolerancePositive", 2,
            k => Law_ParameterTolerancePositive(k == 0 ? m.Tolerances.LengthParameter : m.Tolerances.AngleParameter),
            k => Provenance.WholeInput);

    // Law_LengthToleranceResolvable at the model's coordinate extent (layer
    // 2's CoordinateExtent, the largest absolute coordinate: rounding depends
    // on how large the coordinates are, not on how large the model is, review
    // F6): Worst is the arithmetic resolution
    // there, the bound the length tolerance, so the check holds exactly when
    // the law does. Geometric group: Warning while the resolution is below ten
    // times the tolerance, Error above (the verdicts at that size are then
    // rounding noise).
    Check_LengthToleranceResolvable(m: BrepModel): Check
        => CheckWithin("Law_LengthToleranceResolvable",
            m.CoordinateExtent.IsFinite ? ResolutionAt(m.CoordinateExtent) : 0.0,
            m.Tolerances.Length.Value,
            Provenance.WholeInput);

    //==
    // # Indices, loops and bounds

    // Law_IndicesInRange over the whole model. Topological group: Error.
    Check_IndicesInRange(m: BrepModel): Check
        => CheckOnce("Law_IndicesInRange", Law_IndicesInRange(m));

    // Law_LoopsChainEndToStart at every loop. Topological group: Error.
    Check_LoopsChainEndToStart(m: BrepModel): Check
        => m.CheckLoops("Law_LoopsChainEndToStart", l => Law_LoopsChainEndToStart(m, l));

    // Law_AtMostOneOuterBound at every face. Topological group: Error.
    Check_AtMostOneOuterBound(m: BrepModel): Check
        => m.CheckFaces("Law_AtMostOneOuterBound", f => Law_AtMostOneOuterBound(m, f));

    // Law_AtLeastOneBound at every face. Topological group: Error.
    Check_AtLeastOneBound(m: BrepModel): Check
        => m.CheckFaces("Law_AtLeastOneBound", f => Law_AtLeastOneBound(m, f));

    // Law_FaceBoundsShareNoVertex at every face, the redundant vertex loops
    // left out (layer 2 reports those by Law_NoRedundantVertexLoop).
    // Topological group: Error.
    Check_FaceBoundsShareNoVertex(m: BrepModel): Check
        => m.CheckFaces("Law_FaceBoundsShareNoVertex", f => Law_FaceBoundsShareNoVertex(m, f));

    // Law_NoRedundantVertexLoop at every face. Structure, a defect the
    // reduction repairs exactly: Warning (layer 2, decision 12).
    Check_NoRedundantVertexLoop(m: BrepModel): Check
        => m.CheckFaces("Law_NoRedundantVertexLoop", f => Law_NoRedundantVertexLoop(m, f));

    // Law_PolyLoopHasThreePoints at every loop. Structure: Error.
    Check_PolyLoopHasThreePoints(m: BrepModel): Check
        => m.CheckLoops("Law_PolyLoopHasThreePoints", l => Law_PolyLoopHasThreePoints(m, l));

    //==
    // # Edge uses and vertex links

    // Law_EveryEdgeUsedTwiceInClosedShell at every shell and edge.
    // Topological group: Error.
    Check_EveryEdgeUsedTwiceInClosedShell(m: BrepModel): Check
        => m.CheckShellEdges("Law_EveryEdgeUsedTwiceInClosedShell", (s, e) => Law_EveryEdgeUsedTwiceInClosedShell(m, s, e));

    // Law_OpenShellEdgesUsedAtMostTwice at every shell and edge. Topological
    // group: Error.
    Check_OpenShellEdgesUsedAtMostTwice(m: BrepModel): Check
        => m.CheckShellEdges("Law_OpenShellEdgesUsedAtMostTwice", (s, e) => Law_OpenShellEdgesUsedAtMostTwice(m, s, e));

    // Law_DeclaredClosedIsClosed at every shell. Topological group: Error.
    Check_DeclaredClosedIsClosed(m: BrepModel): Check
        => m.CheckShells("Law_DeclaredClosedIsClosed", s => Law_DeclaredClosedIsClosed(m, s));

    // Law_EdgeUsesHaveOppositeOrientation at every shell and edge.
    // Topological group: Error.
    Check_EdgeUsesHaveOppositeOrientation(m: BrepModel): Check
        => m.CheckShellEdges("Law_EdgeUsesHaveOppositeOrientation", (s, e) => Law_EdgeUsesHaveOppositeOrientation(m, s, e));

    // Law_SeamUsesRunOpposite at every face and edge. Topological group:
    // Error.
    Check_SeamUsesRunOpposite(m: BrepModel): Check
        => m.CheckFaceEdges("Law_SeamUsesRunOpposite", (f, e) => Law_SeamUsesRunOpposite(m, f, e));

    // Law_VertexLinkIsOneCycle at every shell and vertex. Topological group:
    // Error.
    Check_VertexLinkIsOneCycle(m: BrepModel): Check
        => m.CheckShellVertices("Law_VertexLinkIsOneCycle", (s, v) => Law_VertexLinkIsOneCycle(m, s, v));

    // Law_OpenShellVertexLinkIsCycleOrPath at every shell and vertex.
    // Structure: Error.
    Check_OpenShellVertexLinkIsCycleOrPath(m: BrepModel): Check
        => m.CheckShellVertices("Law_OpenShellVertexLinkIsCycleOrPath", (s, v) => Law_OpenShellVertexLinkIsCycleOrPath(m, s, v));

    // Law_PolyLoopEdgesPairUp at every shell. Structure: Error.
    Check_PolyLoopEdgesPairUp(m: BrepModel): Check
        => m.CheckShells("Law_PolyLoopEdgesPairUp", s => Law_PolyLoopEdgesPairUp(m, s));

    // Law_VertexLoopVertexIsIsolated at every shell and vertex. Topological
    // group: Error.
    Check_VertexLoopVertexIsIsolated(m: BrepModel): Check
        => m.CheckShellVertices("Law_VertexLoopVertexIsIsolated", (s, v) => Law_VertexLoopVertexIsIsolated(m, s, v));

    //==
    // # Euler-Poincare and bodies

    // Law_EulerPoincareEvenAndBounded at every shell. Topological group:
    // Error.
    Check_EulerPoincareEvenAndBounded(m: BrepModel): Check
        => m.CheckShells("Law_EulerPoincareEvenAndBounded", s => Law_EulerPoincareEvenAndBounded(m, s));

    // Law_OpenShellEulerEvenAndBounded at every shell. Structure: Error.
    Check_OpenShellEulerEvenAndBounded(m: BrepModel): Check
        => m.CheckShells("Law_OpenShellEulerEvenAndBounded", s => Law_OpenShellEulerEvenAndBounded(m, s));

    // Law_ShellIsConnected at every shell (review M1: a sphere and a torus
    // in one shell pass every other law). Structure: Error.
    Check_ShellIsConnected(m: BrepModel): Check
        => m.CheckShells("Law_ShellIsConnected", s => Law_ShellIsConnected(m, s));

    // Law_ShellIsOrientable at every shell. Structure: Error.
    Check_ShellIsOrientable(m: BrepModel): Check
        => m.CheckShells("Law_ShellIsOrientable", s => Law_ShellIsOrientable(m, s));

    // Law_SolidShellsAreDeclaredClosed at every body. Topological group:
    // Error.
    Check_SolidShellsAreDeclaredClosed(m: BrepModel): Check
        => m.CheckBodies("Law_SolidShellsAreDeclaredClosed", b => Law_SolidShellsAreDeclaredClosed(m, b));

    //==
    // # Edge domains and degenerate edges

    // Law_EdgeDomainIsForward at every edge. Topological group (the law
    // compares with the parameter floor but states structure): Error.
    Check_EdgeDomainIsForward(m: BrepModel): Check
        => m.CheckEdges("Law_EdgeDomainIsForward", e => Law_EdgeDomainIsForward(m, e));

    // Law_CoincidentEndsAreOneVertex at every edge. Topological group: Error.
    Check_CoincidentEndsAreOneVertex(m: BrepModel): Check
        => m.CheckEdges("Law_CoincidentEndsAreOneVertex", e => Law_CoincidentEndsAreOneVertex(m, e));

    // Law_EdgeHasPositiveExtent at every edge. Structure, a defect the
    // reduction repairs exactly: Warning (layer 2, decision 12).
    Check_EdgeHasPositiveExtent(m: BrepModel): Check
        => m.CheckEdges("Law_EdgeHasPositiveExtent", e => Law_EdgeHasPositiveExtent(m, e));

    // Law_DegenerateEdgeHasCoincidentVertices at every edge. Topological
    // group: Error.
    Check_DegenerateEdgeHasCoincidentVertices(m: BrepModel): Check
        => m.CheckEdges("Law_DegenerateEdgeHasCoincidentVertices", e => Law_DegenerateEdgeHasCoincidentVertices(m, e));

    // Law_DegenerateEdgeStaysAtStart at every edge and every fraction of the
    // plan, measured by StartVertexDeviationAt on degenerate edges (0 on the
    // others, where the law is vacuous). A library law, the contract of the
    // deferred IsDegenerateEdge: self-test, Error.
    Check_DegenerateEdgeStaysAtStart(m: BrepModel, plan: SamplePlan): Check
        => CheckGridWithin("Law_DegenerateEdgeStaysAtStart", m.Edges.Count, plan.Count,
            (e, j) => m.DegenerateDeviationAt(BrepEdgeIndex(e), plan.PlanFractions[j]),
            m.Tolerances.Length.Value,
            (e, j) => AtEdge(e));

    //==
    // # Geometry coupling

    // Law_EdgeDomainEndsAtVertices at every edge and both ends, measured by
    // DomainEndDeviation. Geometric group, bound Tolerances.Length: Warning
    // below ten times it, Error above.
    Check_EdgeDomainEndsAtVertices(m: BrepModel): Check
        => CheckGridWithin("Law_EdgeDomainEndsAtVertices", m.Edges.Count, 2,
            (e, k) => m.EndDeviation(BrepEdgeIndex(e), k == 0),
            m.Tolerances.Length.Value,
            (e, k) => AtEdge(e));

    // Law_VertexCoincidesWithCurveEnd at every edge and both ends, measured
    // by VertexCurveDeviation. Geometric group, bound Tolerances.Length.
    Check_VertexCoincidesWithCurveEnd(m: BrepModel): Check
        => CheckGridWithin("Law_VertexCoincidesWithCurveEnd", m.Edges.Count, 2,
            (e, k) => m.VertexOnCurveDeviation(BrepEdgeIndex(e), k == 0),
            m.Tolerances.Length.Value,
            (e, k) => AtEdge(e));

    // Law_EdgeLiesOnAdjacentSurfaces at every coedge site and every fraction
    // of the plan, measured by SurfaceDeviationAt. Geometric group, bound
    // Tolerances.Length. Reported at the face of the site.
    Check_EdgeLiesOnAdjacentSurfaces(m: BrepModel, plan: SamplePlan): Check
        => CheckGridWithin("Law_EdgeLiesOnAdjacentSurfaces", m.AllCoedgeSites.Count, plan.Count,
            (k, j) => m.SiteSurfaceDeviation(m.AllCoedgeSites[k], plan.PlanFractions[j]),
            m.Tolerances.Length.Value,
            (k, j) => Provenance.KernelFace(m.AllCoedgeSites[k].Face));

    // Law_PcurveAgreesWithCurve at every edge, each of its pcurves k = 0, 1,
    // and every fraction of the plan, measured by PcurveDeviationAt.
    // Geometric group, bound Tolerances.Length.
    Check_PcurveAgreesWithCurve(m: BrepModel, plan: SamplePlan): Check
        => CheckGridWithin("Law_PcurveAgreesWithCurve", m.Edges.Count, 2 * plan.Count,
            (e, j) => m.PcurveCurveDeviation(BrepEdgeIndex(e), j / plan.Count, plan.PlanFractions[j % plan.Count]),
            m.Tolerances.Length.Value,
            (e, j) => AtEdge(e));

    // Law_CurveAgreesWithPcurve at every edge, each of its pcurves k = 0, 1,
    // and every fraction of the plan, measured by CurvePcurveDeviationAt
    // (review M3, curve to pcurve). Geometric group, bound Tolerances.Length.
    Check_CurveAgreesWithPcurve(m: BrepModel, plan: SamplePlan): Check
        => CheckGridWithin("Law_CurveAgreesWithPcurve", m.Edges.Count, 2 * plan.Count,
            (e, j) => m.CurvePcurveDeviation(BrepEdgeIndex(e), j / plan.Count, plan.PlanFractions[j % plan.Count]),
            m.Tolerances.Length.Value,
            (e, j) => AtEdge(e));

    // Law_PcurveRunsWithCurve at every edge, pcurve and fraction of the plan.
    // Structure (an exact sign): Error.
    Check_PcurveRunsWithCurve(m: BrepModel, plan: SamplePlan): Check
        => CheckGrid("Law_PcurveRunsWithCurve", m.Edges.Count, 2 * plan.Count,
            (e, j) => Law_PcurveRunsWithCurve(m, BrepEdgeIndex(e), j / plan.Count, plan.PlanFractions[j % plan.Count]),
            (e, j) => AtEdge(e));

    // Law_PcurveSurfaceIsAFaceSurface at every edge and pcurve. Structure, an
    // ignored pcurve: Warning.
    Check_PcurveSurfaceIsAFaceSurface(m: BrepModel): Check
        => CheckGrid("Law_PcurveSurfaceIsAFaceSurface", m.Edges.Count, 2,
            (e, k) => Law_PcurveSurfaceIsAFaceSurface(m, BrepEdgeIndex(e), k), (e, k) => AtEdge(e));

    //==
    // # Self-tests

    // Law_EdgeReversalKeepsCoedgeSense at every coedge site. Self-test:
    // Error.
    Check_EdgeReversalKeepsCoedgeSense(m: BrepModel): Check
        => CheckAll("Law_EdgeReversalKeepsCoedgeSense", m.AllCoedgeSites.Count,
            k => Law_EdgeReversalKeepsCoedgeSense(m, m.AllCoedgeSites[k]),
            k => Provenance.KernelFace(m.AllCoedgeSites[k].Face));

    // Law_EdgeReversalKeepsEdgeDomain at every edge. Self-test: Error.
    Check_EdgeReversalKeepsEdgeDomain(m: BrepModel): Check
        => m.CheckEdges("Law_EdgeReversalKeepsEdgeDomain", e => Law_EdgeReversalKeepsEdgeDomain(m, e));

    // Law_ParameterizationSignIsConstantOnFace at every coedge site and
    // fraction of the plan. Self-test: Error.
    Check_ParameterizationSignIsConstantOnFace(m: BrepModel, plan: SamplePlan): Check
        => CheckGrid("Law_ParameterizationSignIsConstantOnFace", m.AllCoedgeSites.Count, plan.Count,
            (k, j) => Law_ParameterizationSignIsConstantOnFace(m, m.AllCoedgeSites[k], plan.PlanFractions[j]),
            (k, j) => Provenance.KernelFace(m.AllCoedgeSites[k].Face));

    // Law_ReversingEveryFaceKeepsCoherence at every shell. Self-test: Error.
    Check_ReversingEveryFaceKeepsCoherence(m: BrepModel): Check
        => m.CheckShells("Law_ReversingEveryFaceKeepsCoherence", s => Law_ReversingEveryFaceKeepsCoherence(m, s));

    // Law_ScalingScalesExtent over the whole model, scaling by 2. Self-test:
    // Error.
    Check_ScalingScalesExtent(m: BrepModel): Check
        => CheckOnce("Law_ScalingScalesExtent", Law_ScalingScalesExtent(m, 2.0));

    // Law_ModelSizeWithinExtent over the whole model. Self-test: Error.
    Check_ModelSizeWithinExtent(m: BrepModel): Check
        => CheckOnce("Law_ModelSizeWithinExtent", Law_ModelSizeWithinExtent(m));

    //==
    // # Parameter-space winding

    // Law_LoopWindingMatchesSameSense at every face. Topological group (an
    // exact sign): Error.
    Check_LoopWindingMatchesSameSense(m: BrepModel): Check
        => m.CheckFaces("Law_LoopWindingMatchesSameSense", f => Law_LoopWindingMatchesSameSense(m, f));

    //==
    // # Measures
    //
    // Each measure is the left side of its law's comparison behind the law's
    // own guard, and 0 where the guard makes the law vacuous, so the check
    // that folds it agrees with the law.


    // DomainEndDeviation behind Law_EdgeDomainEndsAtVertices's guard.
    EndDeviation(m: BrepModel, e: BrepEdgeIndex, atStart: Boolean): Number
        => m.IsEveryIndexInRange ? (m.IsEdgeInRange(e) ? m.DomainEndDeviation(e, atStart) : 0.0) : 0.0;

    // VertexCurveDeviation behind Law_VertexCoincidesWithCurveEnd's guard.
    VertexOnCurveDeviation(m: BrepModel, e: BrepEdgeIndex, atStart: Boolean): Number
        => m.IsEveryIndexInRange ? (m.IsEdgeInRange(e) ? m.VertexCurveDeviation(e, atStart) : 0.0) : 0.0;

    // StartVertexDeviationAt behind Law_DegenerateEdgeStaysAtStart's guard.
    DegenerateDeviationAt(m: BrepModel, e: BrepEdgeIndex, t: Number): Number
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e) ? (m.IsDegenerateEdge(e) ? m.StartVertexDeviationAt(e, t) : 0.0) : 0.0)
            : 0.0;

    // SurfaceDeviationAt behind Law_EdgeLiesOnAdjacentSurfaces's guard.
    SiteSurfaceDeviation(m: BrepModel, site: CoedgeSite, t: Number): Number
        => m.IsEveryIndexInRange ? (m.IsCoedgeSiteInRange(site) ? m.SurfaceDeviationAt(site, t) : 0.0) : 0.0;

    // CurvePcurveDeviationAt behind Law_CurveAgreesWithPcurve's guard.
    CurvePcurveDeviation(m: BrepModel, e: BrepEdgeIndex, k: Integer, t: Number): Number
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e) ? (m.HasPcurve(e, k) ? m.CurvePcurveDeviationAt(e, k, t) : 0.0) : 0.0)
            : 0.0;

    // PcurveDeviationAt behind Law_PcurveAgreesWithCurve's guard.
    PcurveCurveDeviation(m: BrepModel, e: BrepEdgeIndex, k: Integer, t: Number): Number
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e)
                ? (m.Geometry.PcurvesOf(m.Edges[e].Curve).IsValidIndex(k) ? m.PcurveDeviationAt(e, k, t) : 0.0)
                : 0.0)
            : 0.0;
}

//==
// # BrepCheckingGeometry
//
// Layer 7 of the STEP B-rep to mesh design (README.md beside this file): one
// Check_ per law of 01-geometry, each the law evaluated over every entry of
// the model's geometry arena it quantifies over, at the plan's samples where
// the law is pointwise (BrepCheckingCommon's arena samplers), with the model's
// own tolerances. Every comment names the Law_ evaluated, its family, and the
// severity rule. Layer 1 exports its laws as Booleans and none of the
// measures behind them, so every check here is folded from CheckExact and a
// failure is an Error, also for the file laws layer 1's README grades "10x"
// (README, "Findings in lower layers"). Laws over a B-spline record are run on
// every arena entry of the B-spline case through the HoldsFor helpers, and
// are vacuous on the other cases.
//
// Sections, in order:
//  - The arena: references, cycles, shapes (structure)
//  - B-spline records (structure)
//  - Curves and surfaces, case by case (structure)
//  - File geometry (geometry)
//  - Library self-tests: curves
//  - Library self-tests: parameter-plane curves and pcurves
//  - Library self-tests: surfaces
//  - Helpers by case

library BrepCheckingGeometry
{
    //==
    // # The arena: references, cycles, shapes (structure)

    // Law_CurveReferencesInRange at every curve. Structure: Error.
    Check_CurveReferencesInRange(m: BrepModel): Check
        => m.CheckCurves("Law_CurveReferencesInRange", c => Law_CurveReferencesInRange(m.Geometry, c));

    // Law_Curve2DReferencesInRange at every parameter-plane curve. Structure:
    // Error.
    Check_Curve2DReferencesInRange(m: BrepModel): Check
        => m.CheckCurves2D("Law_Curve2DReferencesInRange", c => Law_Curve2DReferencesInRange(m.Geometry, c));

    // Law_PcurveReferencesInRange at every pcurve. Structure: Error.
    Check_PcurveReferencesInRange(m: BrepModel): Check
        => m.CheckPcurves("Law_PcurveReferencesInRange", p => Law_PcurveReferencesInRange(m.Geometry, p));

    // Law_SurfaceReferencesInRange at every surface. Structure: Error.
    Check_SurfaceReferencesInRange(m: BrepModel): Check
        => m.CheckSurfaces("Law_SurfaceReferencesInRange", s => Law_SurfaceReferencesInRange(m.Geometry, s));

    // Law_CurveReferencesAcyclic at every curve. Structure: Error.
    Check_CurveReferencesAcyclic(m: BrepModel): Check
        => m.CheckCurves("Law_CurveReferencesAcyclic", c => Law_CurveReferencesAcyclic(m.Geometry, c));

    // Law_Curve2DReferencesAcyclic at every parameter-plane curve. Structure:
    // Error.
    Check_Curve2DReferencesAcyclic(m: BrepModel): Check
        => m.CheckCurves2D("Law_Curve2DReferencesAcyclic", c => Law_Curve2DReferencesAcyclic(m.Geometry, c));

    // Law_SurfaceReferencesAcyclic at every surface. Structure: Error.
    Check_SurfaceReferencesAcyclic(m: BrepModel): Check
        => m.CheckSurfaces("Law_SurfaceReferencesAcyclic", s => Law_SurfaceReferencesAcyclic(m.Geometry, s));

    // Law_CurveHasEvaluableShape at every curve. Structure: Error.
    Check_CurveHasEvaluableShape(m: BrepModel): Check
        => m.CheckCurves("Law_CurveHasEvaluableShape", c => Law_CurveHasEvaluableShape(m.Geometry, c));

    // Law_Curve2DHasEvaluableShape at every parameter-plane curve. Structure:
    // Error.
    Check_Curve2DHasEvaluableShape(m: BrepModel): Check
        => m.CheckCurves2D("Law_Curve2DHasEvaluableShape", c => Law_Curve2DHasEvaluableShape(m.Geometry, c));

    // Law_SurfaceHasEvaluableShape at every surface. Structure: Error.
    Check_SurfaceHasEvaluableShape(m: BrepModel): Check
        => m.CheckSurfaces("Law_SurfaceHasEvaluableShape", s => Law_SurfaceHasEvaluableShape(m.Geometry, s));

    //==
    // # B-spline records (structure)
    //
    // ISO 10303-42 4.6.11 and 4.5.39, one rule per check, on every B-spline
    // entry of the arena. Structure: Error.

    // Law_BSplineCurveDegreePositive at every B-spline curve.
    Check_BSplineCurveDegreePositive(m: BrepModel): Check
        => m.CheckCurves("Law_BSplineCurveDegreePositive", c => m.Geometry.HoldsForBSplineCurve(c, d => Law_BSplineCurveDegreePositive(d)));

    // Law_BSplineCurveKnotCount at every B-spline curve.
    Check_BSplineCurveKnotCount(m: BrepModel): Check
        => m.CheckCurves("Law_BSplineCurveKnotCount", c => m.Geometry.HoldsForBSplineCurve(c, d => Law_BSplineCurveKnotCount(d)));

    // Law_BSplineCurveKnotsNonDecreasing at every B-spline curve.
    Check_BSplineCurveKnotsNonDecreasing(m: BrepModel): Check
        => m.CheckCurves("Law_BSplineCurveKnotsNonDecreasing", c => m.Geometry.HoldsForBSplineCurve(c, d => Law_BSplineCurveKnotsNonDecreasing(d)));

    // Law_BSplineCurveKnotMultiplicityBounded at every B-spline curve.
    Check_BSplineCurveKnotMultiplicityBounded(m: BrepModel): Check
        => m.CheckCurves("Law_BSplineCurveKnotMultiplicityBounded", c => m.Geometry.HoldsForBSplineCurve(c, d => Law_BSplineCurveKnotMultiplicityBounded(d)));

    // Law_BSplineCurveDomainNonEmpty at every B-spline curve.
    Check_BSplineCurveDomainNonEmpty(m: BrepModel): Check
        => m.CheckCurves("Law_BSplineCurveDomainNonEmpty", c => m.Geometry.HoldsForBSplineCurve(c, d => Law_BSplineCurveDomainNonEmpty(d)));

    // Law_BSplineCurveWeightCount at every B-spline curve.
    Check_BSplineCurveWeightCount(m: BrepModel): Check
        => m.CheckCurves("Law_BSplineCurveWeightCount", c => m.Geometry.HoldsForBSplineCurve(c, d => Law_BSplineCurveWeightCount(d)));

    // Law_BSplineCurveWeightsPositive at every B-spline curve.
    Check_BSplineCurveWeightsPositive(m: BrepModel): Check
        => m.CheckCurves("Law_BSplineCurveWeightsPositive", c => m.Geometry.HoldsForBSplineCurve(c, d => Law_BSplineCurveWeightsPositive(d)));

    // Law_BSplineCurve2DDegreePositive at every B-spline parameter-plane curve.
    Check_BSplineCurve2DDegreePositive(m: BrepModel): Check
        => m.CheckCurves2D("Law_BSplineCurve2DDegreePositive", c => m.Geometry.HoldsForBSplineCurve2D(c, d => Law_BSplineCurve2DDegreePositive(d)));

    // Law_BSplineCurve2DKnotCount at every B-spline parameter-plane curve.
    Check_BSplineCurve2DKnotCount(m: BrepModel): Check
        => m.CheckCurves2D("Law_BSplineCurve2DKnotCount", c => m.Geometry.HoldsForBSplineCurve2D(c, d => Law_BSplineCurve2DKnotCount(d)));

    // Law_BSplineCurve2DKnotsNonDecreasing at every B-spline parameter-plane
    // curve.
    Check_BSplineCurve2DKnotsNonDecreasing(m: BrepModel): Check
        => m.CheckCurves2D("Law_BSplineCurve2DKnotsNonDecreasing", c => m.Geometry.HoldsForBSplineCurve2D(c, d => Law_BSplineCurve2DKnotsNonDecreasing(d)));

    // Law_BSplineCurve2DKnotMultiplicityBounded at every B-spline
    // parameter-plane curve.
    Check_BSplineCurve2DKnotMultiplicityBounded(m: BrepModel): Check
        => m.CheckCurves2D("Law_BSplineCurve2DKnotMultiplicityBounded", c => m.Geometry.HoldsForBSplineCurve2D(c, d => Law_BSplineCurve2DKnotMultiplicityBounded(d)));

    // Law_BSplineCurve2DDomainNonEmpty at every B-spline parameter-plane curve.
    Check_BSplineCurve2DDomainNonEmpty(m: BrepModel): Check
        => m.CheckCurves2D("Law_BSplineCurve2DDomainNonEmpty", c => m.Geometry.HoldsForBSplineCurve2D(c, d => Law_BSplineCurve2DDomainNonEmpty(d)));

    // Law_BSplineCurve2DWeightCount at every B-spline parameter-plane curve.
    Check_BSplineCurve2DWeightCount(m: BrepModel): Check
        => m.CheckCurves2D("Law_BSplineCurve2DWeightCount", c => m.Geometry.HoldsForBSplineCurve2D(c, d => Law_BSplineCurve2DWeightCount(d)));

    // Law_BSplineCurve2DWeightsPositive at every B-spline parameter-plane curve.
    Check_BSplineCurve2DWeightsPositive(m: BrepModel): Check
        => m.CheckCurves2D("Law_BSplineCurve2DWeightsPositive", c => m.Geometry.HoldsForBSplineCurve2D(c, d => Law_BSplineCurve2DWeightsPositive(d)));

    // Law_BSplineSurfaceDegreePositive at every B-spline surface, both
    // parameters.
    Check_BSplineSurfaceDegreePositive(m: BrepModel): Check
        => m.CheckSurfaceParameters("Law_BSplineSurfaceDegreePositive", (s, which) => m.Geometry.HoldsForBSplineSurface(s, d => Law_BSplineSurfaceDegreePositive(d, which)));

    // Law_BSplineSurfaceKnotCount at every B-spline surface, both parameters.
    Check_BSplineSurfaceKnotCount(m: BrepModel): Check
        => m.CheckSurfaceParameters("Law_BSplineSurfaceKnotCount", (s, which) => m.Geometry.HoldsForBSplineSurface(s, d => Law_BSplineSurfaceKnotCount(d, which)));

    // Law_BSplineSurfaceKnotsNonDecreasing at every B-spline surface, both
    // parameters.
    Check_BSplineSurfaceKnotsNonDecreasing(m: BrepModel): Check
        => m.CheckSurfaceParameters("Law_BSplineSurfaceKnotsNonDecreasing", (s, which) => m.Geometry.HoldsForBSplineSurface(s, d => Law_BSplineSurfaceKnotsNonDecreasing(d, which)));

    // Law_BSplineSurfaceKnotMultiplicityBounded at every B-spline surface,
    // both parameters.
    Check_BSplineSurfaceKnotMultiplicityBounded(m: BrepModel): Check
        => m.CheckSurfaceParameters("Law_BSplineSurfaceKnotMultiplicityBounded", (s, which) => m.Geometry.HoldsForBSplineSurface(s, d => Law_BSplineSurfaceKnotMultiplicityBounded(d, which)));

    // Law_BSplineSurfaceDomainNonEmpty at every B-spline surface, both
    // parameters.
    Check_BSplineSurfaceDomainNonEmpty(m: BrepModel): Check
        => m.CheckSurfaceParameters("Law_BSplineSurfaceDomainNonEmpty", (s, which) => m.Geometry.HoldsForBSplineSurface(s, d => Law_BSplineSurfaceDomainNonEmpty(d, which)));

    // Law_BSplineSurfaceNetConsistent at every B-spline surface.
    Check_BSplineSurfaceNetConsistent(m: BrepModel): Check
        => m.CheckSurfaces("Law_BSplineSurfaceNetConsistent", s => m.Geometry.HoldsForBSplineSurface(s, d => Law_BSplineSurfaceNetConsistent(d)));

    // Law_BSplineSurfaceWeightGridMatchesNet at every B-spline surface.
    Check_BSplineSurfaceWeightGridMatchesNet(m: BrepModel): Check
        => m.CheckSurfaces("Law_BSplineSurfaceWeightGridMatchesNet", s => m.Geometry.HoldsForBSplineSurface(s, d => Law_BSplineSurfaceWeightGridMatchesNet(d)));

    // Law_BSplineSurfaceWeightsPositive at every B-spline surface.
    Check_BSplineSurfaceWeightsPositive(m: BrepModel): Check
        => m.CheckSurfaces("Law_BSplineSurfaceWeightsPositive", s => m.Geometry.HoldsForBSplineSurface(s, d => Law_BSplineSurfaceWeightsPositive(d)));

    //==
    // # Curves and surfaces, case by case (structure)

    // Law_TrimmedRangeIsForward at every curve. Structure: Error.
    Check_TrimmedRangeIsForward(m: BrepModel): Check
        => m.CheckCurves("Law_TrimmedRangeIsForward", c => Law_TrimmedRangeIsForward(m.Geometry, c, m.Tolerances));

    // Law_RectangularTrimmedRangeIsForward at every surface and parameter.
    // Structure: Error.
    Check_RectangularTrimmedRangeIsForward(m: BrepModel): Check
        => m.CheckSurfaceParameters("Law_RectangularTrimmedRangeIsForward", (s, which) => Law_RectangularTrimmedRangeIsForward(m.Geometry, s, which, m.Tolerances));

    // Law_CompositeSegmentsBounded at every curve. Structure: Error.
    Check_CompositeSegmentsBounded(m: BrepModel): Check
        => m.CheckCurves("Law_CompositeSegmentsBounded", c => Law_CompositeSegmentsBounded(m.Geometry, c));

    // Law_SurfaceCurvePcurveSameSense at every curve, sample, and support.
    // Structure (an exact sign): Error.
    Check_SurfaceCurvePcurveSameSense(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurveSupportSamples(plan, "Law_SurfaceCurvePcurveSameSense", (c, t, k) => Law_SurfaceCurvePcurveSameSense(m.Geometry, c, t, k));

    // Law_AreaElementPositiveAwayFromCollapse at every surface and grid
    // point. Structure (an exact sign about the file's surface): Error.
    Check_AreaElementPositiveAwayFromCollapse(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_AreaElementPositiveAwayFromCollapse", (s, uv) => Law_AreaElementPositiveAwayFromCollapse(m.Geometry, s, uv, m.Tolerances));

    //==
    // # File geometry (geometry)
    //
    // Laws about what the file supplied, with the model's length, angle, or
    // parameter tolerance. Each folds the measure layer 1 exports beside its
    // law (PlacementDeviation, TrimExcess, SegmentGap, SupportGap, ...) behind
    // the law's guard, 0 outside it, so a failure is a Warning below ten times
    // the tolerance and an Error above. The two lower-bound laws
    // (OffsetReferenceAngle, ExtrusionProfileAngle at least the angle
    // tolerance) have no excess to grade ten times over and stay exact Errors.

    // The surface parameter of slot k: u for 0, v otherwise.
    ParameterOfSlot(k: Integer): SurfaceParameter
        => k == 0 ? SurfaceParameter.ParameterU : SurfaceParameter.ParameterV;

    // Law_CurvePlacementOrthonormal at every curve, measured by layer 1's
    // PlacementDeviation in radians against the angle tolerance.
    Check_CurvePlacementOrthonormal(m: BrepModel): Check
        => CheckAllWithin("Law_CurvePlacementOrthonormal", m.Geometry.Curves.Count,
            c => m.Geometry.IsCurveInRange(CurveIndex(c)) ? m.Geometry.PlacementDeviation(CurveIndex(c)) : 0.0,
            m.Tolerances.Angle.Value.Radians,
            c => m.CurveSite(CurveIndex(c)));

    // Law_Curve2DPlacementOrthonormal at every parameter-plane curve.
    Check_Curve2DPlacementOrthonormal(m: BrepModel): Check
        => CheckAllWithin("Law_Curve2DPlacementOrthonormal", m.Geometry.Curves2D.Count,
            c => m.Geometry.IsCurve2DInRange(Curve2DIndex(c)) ? m.Geometry.PlacementDeviation(Curve2DIndex(c)) : 0.0,
            m.Tolerances.Angle.Value.Radians,
            c => m.Curve2DSite(Curve2DIndex(c)));

    // Law_SurfacePlacementOrthonormal at every surface.
    Check_SurfacePlacementOrthonormal(m: BrepModel): Check
        => CheckAllWithin("Law_SurfacePlacementOrthonormal", m.Geometry.Surfaces.Count,
            s => m.Geometry.IsSurfaceInRange(SurfaceIndex(s)) ? m.Geometry.PlacementDeviation(SurfaceIndex(s)) : 0.0,
            m.Tolerances.Angle.Value.Radians,
            s => m.SurfaceSite(SurfaceIndex(s)));

    // Law_TrimmedRangeInsideBasis at every curve.
    Check_TrimmedRangeInsideBasis(m: BrepModel): Check
        => CheckAllWithinEach("Law_TrimmedRangeInsideBasis", m.Geometry.Curves.Count,
            c => m.Geometry.CanEvaluate(CurveIndex(c)) ? m.Geometry.TrimExcess(CurveIndex(c)) : 0.0,
            c => m.Geometry.CanEvaluate(CurveIndex(c)) ? m.Geometry.ParameterFloorOf(CurveIndex(c), m.Tolerances).Value : 0.0,
            c => m.CurveSite(CurveIndex(c)));

    // Law_RectangularTrimmedInsideBasis at every surface and parameter.
    Check_RectangularTrimmedInsideBasis(m: BrepModel): Check
        => CheckGridWithinEach("Law_RectangularTrimmedInsideBasis", m.Geometry.Surfaces.Count, 2,
            (s, k) => m.Geometry.CanEvaluate(SurfaceIndex(s)) ? m.Geometry.TrimBoxExcess(SurfaceIndex(s), k.ParameterOfSlot) : 0.0,
            (s, k) => m.Geometry.CanEvaluate(SurfaceIndex(s))
                ? m.Geometry.ParameterFloorAlong(SurfaceIndex(s), k.ParameterOfSlot, m.Tolerances).Value
                : 0.0,
            (s, k) => m.SurfaceSite(SurfaceIndex(s)));

    // Law_CompositeSegmentsChain at every curve and every join i (vacuous
    // past the curve's last segment).
    Check_CompositeSegmentsChain(m: BrepModel): Check
        => CheckGridWithin("Law_CompositeSegmentsChain", m.Geometry.Curves.Count, m.Geometry.MostCompositeSegments,
            (c, i) => m.Geometry.CanEvaluate(CurveIndex(c)) ? m.Geometry.SegmentGap(CurveIndex(c), i) : 0.0,
            m.Tolerances.Length.Value,
            (c, i) => m.CurveSite(CurveIndex(c)));

    // Law_OffsetReferenceNotTangent at every curve and sample.
    Check_OffsetReferenceNotTangent(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurveSamples(plan, "Law_OffsetReferenceNotTangent", (c, t) => Law_OffsetReferenceNotTangent(m.Geometry, c, t, m.Tolerances));

    // Law_ExtrusionProfileTransverse at every surface and grid point (its u).
    Check_ExtrusionProfileTransverse(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_ExtrusionProfileTransverse", (s, uv) => Law_ExtrusionProfileTransverse(m.Geometry, s, uv.U, m.Tolerances));

    // Law_SurfaceCurveLiesOnSupport at every curve, sample, and support k:
    // sample j is the plan's sample j % n of support j / n.
    Check_SurfaceCurveLiesOnSupport(m: BrepModel, plan: SamplePlan): Check
        => CheckGridWithin("Law_SurfaceCurveLiesOnSupport", m.Geometry.Curves.Count, 2 * plan.Count,
            (c, j) => m.Geometry.CanEvaluate(CurveIndex(c))
                ? m.Geometry.SupportGap(CurveIndex(c), m.CurveSamples(CurveIndex(c), plan)[j % plan.Count], j / plan.Count)
                : 0.0,
            m.Tolerances.Length.Value,
            (c, j) => m.CurveSite(CurveIndex(c)));

    // Law_SurfaceCurvePcurveLiesOnCurve at every curve, sample, and support.
    Check_SurfaceCurvePcurveLiesOnCurve(m: BrepModel, plan: SamplePlan): Check
        => CheckGridWithin("Law_SurfaceCurvePcurveLiesOnCurve", m.Geometry.Curves.Count, 2 * plan.Count,
            (c, j) => m.Geometry.CanEvaluate(CurveIndex(c))
                ? m.Geometry.PcurveToCurveGap(CurveIndex(c), m.CurveSamples(CurveIndex(c), plan)[j % plan.Count], j / plan.Count)
                : 0.0,
            m.Tolerances.Length.Value,
            (c, j) => m.CurveSite(CurveIndex(c)));

    // Law_SurfaceCurveLiesOnPcurve at every curve, sample, and support.
    Check_SurfaceCurveLiesOnPcurve(m: BrepModel, plan: SamplePlan): Check
        => CheckGridWithin("Law_SurfaceCurveLiesOnPcurve", m.Geometry.Curves.Count, 2 * plan.Count,
            (c, j) => m.Geometry.CanEvaluate(CurveIndex(c))
                ? m.Geometry.CurveToPcurveGap(CurveIndex(c), m.CurveSamples(CurveIndex(c), plan)[j % plan.Count], j / plan.Count)
                : 0.0,
            m.Tolerances.Length.Value,
            (c, j) => m.CurveSite(CurveIndex(c)));

    // Law_PcurveWithinSurfaceDomain at every pcurve and sample.
    Check_PcurveWithinSurfaceDomain(m: BrepModel, plan: SamplePlan): Check
        => CheckGridWithinEach("Law_PcurveWithinSurfaceDomain", m.Geometry.Pcurves.Count, 2 * plan.Count,
            (p, j) => m.Geometry.CanEvaluate(PcurveIndex(p))
                ? m.Geometry.PcurveDomainExcess(PcurveIndex(p), m.PcurveSamples(PcurveIndex(p), plan)[j % plan.Count], (j / plan.Count).ParameterOfSlot)
                : 0.0,
            (p, j) => m.Geometry.CanEvaluate(PcurveIndex(p))
                ? m.Geometry.ParameterFloorAlong(m.Geometry.PcurveAt(PcurveIndex(p)).Surface, (j / plan.Count).ParameterOfSlot, m.Tolerances).Value
                : 0.0,
            (p, j) => m.PcurveSite(PcurveIndex(p)));

    // Law_CollapsedLineIsOnePoint at every surface, both parameters, the
    // first two collapsed lines of each, and every pair of the plan's samples
    // along the line. File law for splines and revolutions, library law for
    // the analytic cases.
    Check_CollapsedLineIsOnePoint(m: BrepModel, plan: SamplePlan): Check
        => CheckGridWithin("Law_CollapsedLineIsOnePoint", m.Geometry.Surfaces.Count, 4 * plan.Count * plan.Count,
            (s, j) => m.Geometry.CanEvaluate(SurfaceIndex(s))
                ? m.Geometry.CollapsedLineSpread(SurfaceIndex(s),
                    j < 2 * plan.Count * plan.Count ? SurfaceParameter.ParameterU : SurfaceParameter.ParameterV,
                    (j / (plan.Count * plan.Count)) % 2,
                    m.AlongSample(SurfaceIndex(s), j < 2 * plan.Count * plan.Count, plan, (j / plan.Count) % plan.Count),
                    m.AlongSample(SurfaceIndex(s), j < 2 * plan.Count * plan.Count, plan, j % plan.Count),
                    m.Tolerances)
                : 0.0,
            m.Tolerances.Length.Value,
            (s, j) => m.SurfaceSite(SurfaceIndex(s)));

    // Law_TangentialPartialVanishesOnDegenerateSide at every surface, each of
    // its at most four degenerate sides, and every sample along the side.
    // File law for splines and revolutions, library law otherwise.
    Check_TangentialPartialVanishesOnDegenerateSide(m: BrepModel, plan: SamplePlan): Check
        => CheckGrid("Law_TangentialPartialVanishesOnDegenerateSide", m.Geometry.Surfaces.Count, 4 * plan.Count,
            (s, j) => Law_TangentialPartialVanishesOnDegenerateSide(m.Geometry, SurfaceIndex(s), j / plan.Count,
                m.DegenerateSideSample(SurfaceIndex(s), j / plan.Count, plan, j % plan.Count), m.Tolerances),
            (s, j) => m.SurfaceSite(SurfaceIndex(s)));

    //==
    // # Library self-tests: curves
    //
    // Laws that test layer 1's own formulas against an independent route (a
    // difference quotient, the Cox-de Boor oracle, inverse evaluation),
    // evaluated on the arena in hand. Self-test: a failure is a defect of the
    // library, Error.

    // Law_BSplineCurveDomainIsKnotSpan at every curve.
    Check_BSplineCurveDomainIsKnotSpan(m: BrepModel): Check
        => m.CheckCurves("Law_BSplineCurveDomainIsKnotSpan", c => Law_BSplineCurveDomainIsKnotSpan(m.Geometry, c));

    // Law_BSplineCurveMatchesBasisSum at every curve and sample.
    Check_BSplineCurveMatchesBasisSum(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurveSamples(plan, "Law_BSplineCurveMatchesBasisSum", (c, t) => Law_BSplineCurveMatchesBasisSum(m.Geometry, c, t));

    // Law_PeriodicCurveSpansOnePeriod at every curve.
    Check_PeriodicCurveSpansOnePeriod(m: BrepModel): Check
        => m.CheckCurves("Law_PeriodicCurveSpansOnePeriod", c => Law_PeriodicCurveSpansOnePeriod(m.Geometry, c, m.Tolerances));

    // Law_PeriodicCurveIsClosed at every curve.
    Check_PeriodicCurveIsClosed(m: BrepModel): Check
        => m.CheckCurves("Law_PeriodicCurveIsClosed", c => Law_PeriodicCurveIsClosed(m.Geometry, c, m.Tolerances));

    // Law_CurveRepeatsWithPeriod at every curve and sample.
    Check_CurveRepeatsWithPeriod(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurveSamples(plan, "Law_CurveRepeatsWithPeriod", (c, t) => Law_CurveRepeatsWithPeriod(m.Geometry, c, t));

    // Law_DerivativeMatchesCentralDifference at every curve and sample.
    Check_DerivativeMatchesCentralDifference(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurveSamples(plan, "Law_DerivativeMatchesCentralDifference", (c, t) => Law_DerivativeMatchesCentralDifference(m.Geometry, c, t));

    // Law_SecondDerivativeMatchesCentralDifference at every curve and sample.
    Check_SecondDerivativeMatchesCentralDifference(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurveSamples(plan, "Law_SecondDerivativeMatchesCentralDifference", (c, t) => Law_SecondDerivativeMatchesCentralDifference(m.Geometry, c, t));

    // Law_ClosestParameterRecoversPoint at every curve and sample.
    Check_ClosestParameterRecoversPoint(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurveSamples(plan, "Law_ClosestParameterRecoversPoint", (c, t) => Law_ClosestParameterRecoversPoint(m.Geometry, c, t, m.Tolerances));

    // Law_ClosestParameterIsCanonical at every curve and sample.
    Check_ClosestParameterIsCanonical(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurveSamples(plan, "Law_ClosestParameterIsCanonical", (c, t) => Law_ClosestParameterIsCanonical(m.Geometry, c, t, m.Tolerances));

    // Law_ClosestParameterNoWorseThanSample at every curve, every sample i
    // whose point, moved off the curve (OffCurvePoint), is the query, and
    // every sample j as the competitor (review M4). Self-test: Error.
    Check_ClosestParameterNoWorseThanSample(m: BrepModel, plan: SamplePlan): Check
        => CheckGrid("Law_ClosestParameterNoWorseThanSample", m.Geometry.Curves.Count, plan.Count * plan.Count,
            (c, ij) => Law_ClosestParameterNoWorseThanSample(m.Geometry, CurveIndex(c),
                m.OffCurvePoint(CurveIndex(c), m.CurveSamples(CurveIndex(c), plan)[ij / plan.Count]),
                m.CurveSamples(CurveIndex(c), plan)[ij % plan.Count]),
            (c, ij) => m.CurveSite(CurveIndex(c)));

    // Law_ClosestParameterIsStationary at every curve and the off-curve point
    // of every sample. Self-test: Error.
    Check_ClosestParameterIsStationary(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurveSamples(plan, "Law_ClosestParameterIsStationary",
            (c, t) => Law_ClosestParameterIsStationary(m.Geometry, c, m.OffCurvePoint(c, t)));

    // Law_PcurveClosestParameterIsBounded at every pcurve and sample (review
    // F4b). Self-test: Error.
    Check_PcurveClosestParameterIsBounded(m: BrepModel, plan: SamplePlan): Check
        => m.CheckPcurveSamples(plan, "Law_PcurveClosestParameterIsBounded",
            (p, t) => Law_PcurveClosestParameterIsBounded(m.Geometry, p, t, m.Tolerances));

    // Law_ScaledCurvePointIsScaled at every curve and sample, scaling by 2.
    // Self-test: Error.
    Check_ScaledCurvePointIsScaled(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurveSamples(plan, "Law_ScaledCurvePointIsScaled", (c, t) => Law_ScaledCurvePointIsScaled(m.Geometry, c, t, 2.0));

    // Law_ScaledPcurvePointIsScaled at every pcurve and sample, scaling by 2.
    // Self-test: Error.
    Check_ScaledPcurvePointIsScaled(m: BrepModel, plan: SamplePlan): Check
        => m.CheckPcurveSamples(plan, "Law_ScaledPcurvePointIsScaled", (p, t) => Law_ScaledPcurvePointIsScaled(m.Geometry, p, t, 2.0));

    // Law_ClosureMarkInRange at every closure mark. Structure: Error.
    Check_ClosureMarkInRange(m: BrepModel): Check
        => CheckAll("Law_ClosureMarkInRange", m.Geometry.Closures.Count,
            k => Law_ClosureMarkInRange(m.Geometry, k), k => Provenance.WholeInput);

    // Law_ClosureMarkNamesBoundedAperiodic at every closure mark. Structure:
    // Error.
    Check_ClosureMarkNamesBoundedAperiodic(m: BrepModel): Check
        => CheckAll("Law_ClosureMarkNamesBoundedAperiodic", m.Geometry.Closures.Count,
            k => Law_ClosureMarkNamesBoundedAperiodic(m.Geometry, k), k => Provenance.WholeInput);

    // Curve c's point at t moved off the curve by the length tolerance along
    // each axis: a query point off the curve, as vertices and edge samples
    // are (review M4); the origin where c cannot be evaluated (the law is
    // vacuous there, and its argument is computed first).
    OffCurvePoint(m: BrepModel, c: CurveIndex, t: Number): Point3D
        => m.Geometry.CanEvaluate(c)
            ? m.Geometry.Eval(c, m.Geometry.Domain(c).SampleIn(t))
                + Vector3D(m.Tolerances.Length.Value, m.Tolerances.Length.Value, m.Tolerances.Length.Value)
            : Point3D(0.0, 0.0, 0.0);

    // Surface s's point at uv moved off the surface the same way.
    OffSurfacePoint(m: BrepModel, s: SurfaceIndex, uv: UvCoordinate): Point3D
        => m.Geometry.CanEvaluate(s)
            ? m.Geometry.Eval(s, m.Geometry.Domain(s).SampleIn(uv))
                + Vector3D(m.Tolerances.Length.Value, m.Tolerances.Length.Value, m.Tolerances.Length.Value)
            : Point3D(0.0, 0.0, 0.0);

    // Law_TrimmedStartsAtSensedEnd at every curve.
    Check_TrimmedStartsAtSensedEnd(m: BrepModel): Check
        => m.CheckCurves("Law_TrimmedStartsAtSensedEnd", c => Law_TrimmedStartsAtSensedEnd(m.Geometry, c, m.Tolerances));

    //==
    // # Library self-tests: parameter-plane curves and pcurves

    // Law_BSplineCurve2DDomainIsKnotSpan at every parameter-plane curve.
    Check_BSplineCurve2DDomainIsKnotSpan(m: BrepModel): Check
        => m.CheckCurves2D("Law_BSplineCurve2DDomainIsKnotSpan", c => Law_BSplineCurve2DDomainIsKnotSpan(m.Geometry, c));

    // Law_BSplineCurve2DMatchesBasisSum at every parameter-plane curve and
    // sample.
    Check_BSplineCurve2DMatchesBasisSum(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurve2DSamples(plan, "Law_BSplineCurve2DMatchesBasisSum", (c, t) => Law_BSplineCurve2DMatchesBasisSum(m.Geometry, c, t));

    // Law_Curve2DRepeatsWithPeriod at every parameter-plane curve and sample.
    Check_Curve2DRepeatsWithPeriod(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurve2DSamples(plan, "Law_Curve2DRepeatsWithPeriod", (c, t) => Law_Curve2DRepeatsWithPeriod(m.Geometry, c, t));

    // Law_Curve2DDerivativeMatchesCentralDifference at every parameter-plane
    // curve and sample.
    Check_Curve2DDerivativeMatchesCentralDifference(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurve2DSamples(plan, "Law_Curve2DDerivativeMatchesCentralDifference", (c, t) => Law_Curve2DDerivativeMatchesCentralDifference(m.Geometry, c, t));

    // Law_Curve2DSecondDerivativeMatchesCentralDifference at every
    // parameter-plane curve and sample.
    Check_Curve2DSecondDerivativeMatchesCentralDifference(m: BrepModel, plan: SamplePlan): Check
        => m.CheckCurve2DSamples(plan, "Law_Curve2DSecondDerivativeMatchesCentralDifference", (c, t) => Law_Curve2DSecondDerivativeMatchesCentralDifference(m.Geometry, c, t));

    // Law_PcurveDerivativeMatchesCentralDifference at every pcurve and sample.
    Check_PcurveDerivativeMatchesCentralDifference(m: BrepModel, plan: SamplePlan): Check
        => m.CheckPcurveSamples(plan, "Law_PcurveDerivativeMatchesCentralDifference", (p, t) => Law_PcurveDerivativeMatchesCentralDifference(m.Geometry, p, t));

    // Law_PcurveSecondDerivativeMatchesCentralDifference at every pcurve and
    // sample.
    Check_PcurveSecondDerivativeMatchesCentralDifference(m: BrepModel, plan: SamplePlan): Check
        => m.CheckPcurveSamples(plan, "Law_PcurveSecondDerivativeMatchesCentralDifference", (p, t) => Law_PcurveSecondDerivativeMatchesCentralDifference(m.Geometry, p, t));

    //==
    // # Library self-tests: surfaces

    // Law_BSplineSurfaceDomainIsKnotSpan at every surface and parameter.
    Check_BSplineSurfaceDomainIsKnotSpan(m: BrepModel): Check
        => m.CheckSurfaceParameters("Law_BSplineSurfaceDomainIsKnotSpan", (s, which) => Law_BSplineSurfaceDomainIsKnotSpan(m.Geometry, s, which));

    // Law_BSplineSurfaceMatchesBasisSum at every surface and grid point.
    Check_BSplineSurfaceMatchesBasisSum(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_BSplineSurfaceMatchesBasisSum", (s, uv) => Law_BSplineSurfaceMatchesBasisSum(m.Geometry, s, uv));

    // Law_PeriodicSurfaceSpansOnePeriod at every surface and parameter.
    Check_PeriodicSurfaceSpansOnePeriod(m: BrepModel): Check
        => m.CheckSurfaceParameters("Law_PeriodicSurfaceSpansOnePeriod", (s, which) => Law_PeriodicSurfaceSpansOnePeriod(m.Geometry, s, which, m.Tolerances));

    // Law_SurfaceRepeatsWithPeriod at every surface, grid point, and
    // parameter.
    Check_SurfaceRepeatsWithPeriod(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceParameterSamples(plan, "Law_SurfaceRepeatsWithPeriod", (s, uv, which) => Law_SurfaceRepeatsWithPeriod(m.Geometry, s, uv, which));

    // Law_PartialMatchesCentralDifference at every surface, grid point, and
    // parameter.
    Check_PartialMatchesCentralDifference(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceParameterSamples(plan, "Law_PartialMatchesCentralDifference", (s, uv, which) => Law_PartialMatchesCentralDifference(m.Geometry, s, uv, which));

    // Law_NormalIsUnit at every surface and grid point.
    Check_NormalIsUnit(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_NormalIsUnit", (s, uv) => Law_NormalIsUnit(m.Geometry, s, uv));

    // Law_NormalOrthogonalToPartial at every surface, grid point, and
    // parameter.
    Check_NormalOrthogonalToPartial(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceParameterSamples(plan, "Law_NormalOrthogonalToPartial", (s, uv, which) => Law_NormalOrthogonalToPartial(m.Geometry, s, uv, which));

    // Law_NormalSenseMatchesParameterization at every surface and grid point.
    Check_NormalSenseMatchesParameterization(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_NormalSenseMatchesParameterization", (s, uv) => Law_NormalSenseMatchesParameterization(m.Geometry, s, uv));

    // Law_AreaElementMatchesCrossProduct at every surface and grid point.
    Check_AreaElementMatchesCrossProduct(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_AreaElementMatchesCrossProduct", (s, uv) => Law_AreaElementMatchesCrossProduct(m.Geometry, s, uv));

    // Law_ConeAreaElement at every surface and grid point.
    Check_ConeAreaElement(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_ConeAreaElement", (s, uv) => Law_ConeAreaElement(m.Geometry, s, uv));

    // Law_SphereAreaElement at every surface and grid point.
    Check_SphereAreaElement(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_SphereAreaElement", (s, uv) => Law_SphereAreaElement(m.Geometry, s, uv));

    // Law_TorusAreaElement at every surface and grid point.
    Check_TorusAreaElement(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_TorusAreaElement", (s, uv) => Law_TorusAreaElement(m.Geometry, s, uv));

    // Law_ProjectRecoversPoint at every surface and grid point.
    Check_ProjectRecoversPoint(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_ProjectRecoversPoint", (s, uv) => Law_ProjectRecoversPoint(m.Geometry, s, uv, m.Tolerances));

    // Law_ProjectRecoversParameter at every surface and grid point.
    Check_ProjectRecoversParameter(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_ProjectRecoversParameter", (s, uv) => Law_ProjectRecoversParameter(m.Geometry, s, uv, m.Tolerances));

    // Law_ProjectNearRecoversParameter at every surface and grid point.
    Check_ProjectNearRecoversParameter(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_ProjectNearRecoversParameter", (s, uv) => Law_ProjectNearRecoversParameter(m.Geometry, s, uv, m.Tolerances));

    // Law_ProjectNoWorseThanSample at every surface, every grid point whose
    // point, moved off the surface, is the query, and every grid point as the
    // competitor (review M4). Self-test: Error.
    Check_ProjectNoWorseThanSample(m: BrepModel, plan: SamplePlan): Check
        => CheckGrid("Law_ProjectNoWorseThanSample", m.Geometry.Surfaces.Count, plan.Count * plan.Count * plan.Count * plan.Count,
            (s, ij) => Law_ProjectNoWorseThanSample(m.Geometry, SurfaceIndex(s),
                m.OffSurfacePoint(SurfaceIndex(s), m.SurfaceSamples(SurfaceIndex(s), plan)[ij / (plan.Count * plan.Count)]),
                m.SurfaceSamples(SurfaceIndex(s), plan)[ij % (plan.Count * plan.Count)]),
            (s, ij) => m.SurfaceSite(SurfaceIndex(s)));

    // Law_ProjectIsStationary at every surface, grid point (moved off the
    // surface) and parameter. Self-test: Error.
    Check_ProjectIsStationary(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceParameterSamples(plan, "Law_ProjectIsStationary",
            (s, uv, which) => Law_ProjectIsStationary(m.Geometry, s, m.OffSurfacePoint(s, uv), which));

    // Law_ProjectNearRecoversFromNearbySeed at every surface, grid point, and
    // the four seeds offset by half the near-seed radius in each parameter
    // (review section 5: seeded off the answer). Self-test: Error.
    Check_ProjectNearRecoversFromNearbySeed(m: BrepModel, plan: SamplePlan): Check
        => CheckGrid("Law_ProjectNearRecoversFromNearbySeed", m.Geometry.Surfaces.Count, 4 * plan.Count * plan.Count,
            (s, j) => Law_ProjectNearRecoversFromNearbySeed(m.Geometry, SurfaceIndex(s),
                m.SurfaceSamples(SurfaceIndex(s), plan)[j % (plan.Count * plan.Count)],
                (j / (plan.Count * plan.Count)) % 2 == 0 ? 0.5 : -0.5,
                j / (2 * plan.Count * plan.Count) == 0 ? 0.5 : -0.5,
                m.Tolerances),
            (s, j) => m.SurfaceSite(SurfaceIndex(s)));

    // Law_ScaledSurfacePointIsScaled at every surface and grid point, scaling
    // by 2. Self-test: Error.
    Check_ScaledSurfacePointIsScaled(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_ScaledSurfacePointIsScaled", (s, uv) => Law_ScaledSurfacePointIsScaled(m.Geometry, s, uv, 2.0));

    // Law_ProjectIsCanonical at every surface and grid point.
    Check_ProjectIsCanonical(m: BrepModel, plan: SamplePlan): Check
        => m.CheckSurfaceSamples(plan, "Law_ProjectIsCanonical", (s, uv) => Law_ProjectIsCanonical(m.Geometry, s, uv, m.Tolerances));

    //==
    // # Helpers by case

    // True when curve c is not a B-spline, or its record satisfies rule.
    // Precondition: c in range.
    HoldsForBSplineCurve(g: GeometrySet, c: CurveIndex, rule: Function1<BSplineCurveData, Boolean>): Boolean
        => g.CurveAt(c).HoldsForBSpline(rule);

    // HoldsForBSplineCurve for one record.
    HoldsForBSpline(curve: BrepCurve, rule: Function1<BSplineCurveData, Boolean>): Boolean
        => match (curve)
        {
            Line(origin, velocity) => true;
            Circle(placement, radius) => true;
            Ellipse(placement, semiAxis1, semiAxis2) => true;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => true;
            Parabola(placement, focalDistance) => true;
            Polyline(points) => true;
            BSpline(data) => rule(data);
            Trimmed(basis, range, sameSense) => true;
            Composite(segments) => true;
            Offset(basis, distance, reference) => true;
            OnSurface(spaceCurve, supports, master) => true;
        };

    // True when parameter-plane curve c is not a B-spline, or its record
    // satisfies rule. Precondition: c in range.
    HoldsForBSplineCurve2D(g: GeometrySet, c: Curve2DIndex, rule: Function1<BSplineCurve2DData, Boolean>): Boolean
        => g.Curve2DAt(c).HoldsForBSpline(rule);

    // HoldsForBSplineCurve2D for one record.
    HoldsForBSpline(curve: BrepCurve2D, rule: Function1<BSplineCurve2DData, Boolean>): Boolean
        => match (curve)
        {
            Line(origin, velocity) => true;
            Circle(placement, radius) => true;
            Ellipse(placement, semiAxis1, semiAxis2) => true;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => true;
            Parabola(placement, focalDistance) => true;
            Polyline(points) => true;
            BSpline(data) => rule(data);
            Trimmed(basis, range, sameSense) => true;
            Composite(segments) => true;
            Offset(basis, distance) => true;
        };

    // True when surface s is not a B-spline, or its record satisfies rule.
    // Precondition: s in range.
    HoldsForBSplineSurface(g: GeometrySet, s: SurfaceIndex, rule: Function1<BSplineSurfaceData, Boolean>): Boolean
        => g.SurfaceAt(s).HoldsForBSpline(rule);

    // HoldsForBSplineSurface for one record.
    HoldsForBSpline(surface: BrepSurface, rule: Function1<BSplineSurfaceData, Boolean>): Boolean
        => match (surface)
        {
            Plane(placement) => true;
            Cylinder(placement, radius) => true;
            Cone(placement, radius, semiAngle) => true;
            Sphere(placement, radius) => true;
            Torus(placement, major, minor, part) => true;
            Revolution(profile, axis) => true;
            LinearExtrusion(profile, extrusion) => true;
            BSpline(data) => rule(data);
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => true;
            Offset(basis, distance) => true;
        };

    // The number of segments of a composite curve, 0 for every other case.
    CompositeSegmentCount(curve: BrepCurve): Integer
        => match (curve)
        {
            Line(origin, velocity) => 0;
            Circle(placement, radius) => 0;
            Ellipse(placement, semiAxis1, semiAxis2) => 0;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => 0;
            Parabola(placement, focalDistance) => 0;
            Polyline(points) => 0;
            BSpline(data) => 0;
            Trimmed(basis, range, sameSense) => 0;
            Composite(segments) => segments.Count;
            Offset(basis, distance, reference) => 0;
            OnSurface(spaceCurve, supports, master) => 0;
        };

    // The largest segment count of any composite curve of the arena: how
    // many joins Check_CompositeSegmentsChain samples per curve.
    MostCompositeSegments(g: GeometrySet): Integer
        => g.Curves.Reduce(0, (n, curve) => n.Max(curve.CompositeSegmentCount));

    // Sample i of the plan along a collapsed line of surface s: a sample of
    // V's bounded range when the collapsed parameter is U (collapsedIsU), of
    // U's otherwise, which is the parameter that varies along the line. 0
    // when s cannot be evaluated.
    AlongSample(m: BrepModel, s: SurfaceIndex, collapsedIsU: Boolean, plan: SamplePlan, i: Integer): Number
        => m.Geometry.CanEvaluate(s)
            ? (collapsedIsU
                ? m.Geometry.Domain(s).V.BoundedSampleRange.Samples(plan.Count)[i]
                : m.Geometry.Domain(s).U.BoundedSampleRange.Samples(plan.Count)[i])
            : 0.0;

    // Sample i of the plan along degenerate side k of surface s: a sample of
    // the bounded range of the parameter that varies along the side. 0 when
    // s cannot be evaluated or has no side k.
    DegenerateSideSample(m: BrepModel, s: SurfaceIndex, k: Integer, plan: SamplePlan, i: Integer): Number
        => m.Geometry.CanEvaluate(s)
            ? (m.Geometry.DegenerateSides(s, m.Tolerances).IsValidIndex(k)
                ? m.Geometry.Domain(s).DomainAlong(m.Geometry.DegenerateSides(s, m.Tolerances)[k].AlongParameter)
                    .BoundedSampleRange.Samples(plan.Count)[i]
                : 0.0)
            : 0.0;
}

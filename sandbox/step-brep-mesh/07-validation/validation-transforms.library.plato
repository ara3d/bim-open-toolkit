//==
// # BrepTransforms
//
// Layer 7 of the STEP B-rep to mesh design (README.md beside this file): what
// the metamorphic laws need to state "move or scale the model, then mesh":
// rigid motions and uniform scalings of curves, surfaces and models; scaled
// meshing criteria; one meshing round over every face (the pipeline without
// its refinement loop, which is layer 8's); and comparisons of meshes and
// models. The transforms belong to lower layers, which do not declare them
// yet; each is marked with the layer it belongs in.
//
// Sections, in order:
//  - Rigid motions
//  - Uniform scalings
//  - Meshing once
//  - Comparisons

library BrepTransforms
{
    //==
    // # Rigid motions
    //
    // The motion of a frame f: a point p goes to f.Origin + p.X f.X + p.Y f.Y
    // + p.Z f.Z, a vector v to v.X f.X + v.Y f.Y + v.Z f.Z. A rigid motion
    // when f is orthonormal and right-handed.

    // belongs-in: 01-geometry
    // The point p moved by f.
    MovedPoint(f: Frame3D, p: Point3D): Point3D
        => f.Origin + f.FrameVector(p.X, p.Y, p.Z);

    // belongs-in: 01-geometry
    // The vector v moved by f (no translation).
    MovedVector(f: Frame3D, v: Vector3D): Vector3D
        => f.FrameVector(v.X, v.Y, v.Z);

    // belongs-in: 01-geometry
    // The frame g moved by f: its origin moved, its axes turned.
    MovedFrame(f: Frame3D, g: Frame3D): Frame3D
        => Frame3D(f.MovedPoint(g.Origin), Direction3D(f.MovedVector(g.XAxis.Vector)),
            Direction3D(f.MovedVector(g.YAxis.Vector)), Direction3D(f.MovedVector(g.ZAxis.Vector)));

    // belongs-in: 01-geometry
    // A curve moved by f: points, placements and directions moved; cases that
    // only name other arena entries unchanged.
    MovedCurve(curve: BrepCurve, f: Frame3D): BrepCurve
        => match (curve)
        {
            Line(origin, velocity) => BrepCurve.Line(f.MovedPoint(origin), f.MovedVector(velocity));
            Circle(placement, radius) => BrepCurve.Circle(f.MovedFrame(placement), radius);
            Ellipse(placement, semiAxis1, semiAxis2) => BrepCurve.Ellipse(f.MovedFrame(placement), semiAxis1, semiAxis2);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => BrepCurve.Hyperbola(f.MovedFrame(placement), semiAxis, semiImaginaryAxis);
            Parabola(placement, focalDistance) => BrepCurve.Parabola(f.MovedFrame(placement), focalDistance);
            Polyline(points) => BrepCurve.Polyline(points.Map(p => f.MovedPoint(p)));
            BSpline(data) => BrepCurve.BSpline(BSplineCurveData(data.Basis, data.ControlPoints.Map(p => f.MovedPoint(p)), data.Weights));
            Trimmed(basis, range, sameSense) => curve;
            Composite(segments) => curve;
            Offset(basis, distance, reference) => BrepCurve.Offset(basis, distance, Direction3D(f.MovedVector(reference.Vector)));
            OnSurface(spaceCurve, supports, master) => curve;
        };

    // belongs-in: 01-geometry
    // A surface moved by f.
    MovedSurface(surface: BrepSurface, f: Frame3D): BrepSurface
        => match (surface)
        {
            Plane(placement) => BrepSurface.Plane(f.MovedFrame(placement));
            Cylinder(placement, radius) => BrepSurface.Cylinder(f.MovedFrame(placement), radius);
            Cone(placement, radius, semiAngle) => BrepSurface.Cone(f.MovedFrame(placement), radius, semiAngle);
            Sphere(placement, radius) => BrepSurface.Sphere(f.MovedFrame(placement), radius);
            Torus(placement, major, minor, part) => BrepSurface.Torus(f.MovedFrame(placement), major, minor, part);
            Revolution(profile, axis) => BrepSurface.Revolution(profile,
                InfiniteLine3D(f.MovedPoint(axis.Origin), Direction3D(f.MovedVector(axis.Direction.Vector))));
            LinearExtrusion(profile, extrusion) => BrepSurface.LinearExtrusion(profile, f.MovedVector(extrusion));
            BSpline(data) => BrepSurface.BSpline(BSplineSurfaceData(data.U, data.V,
                MakeArray2D(data.ControlPoints.ColumnCount, data.ControlPoints.RowCount, (i, j) => f.MovedPoint(data.ControlPoints.At(i, j))),
                data.Weights));
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => surface;
            Offset(basis, distance) => surface;
        };

    // belongs-in: 02-topology
    // The model moved by f: every vertex, curve and surface; the topology,
    // the parameter-plane curves, the tolerances and the unit unchanged.
    MovedBy(m: BrepModel, f: Frame3D): BrepModel
        => BrepModel(
            GeometrySet(m.Geometry.Curves.Map(c => c.MovedCurve(f)), m.Geometry.Curves2D, m.Geometry.Pcurves,
                m.Geometry.Surfaces.Map(s => s.MovedSurface(f))),
            m.Vertices.Map(v => BrepVertex(f.MovedPoint(v.Point))),
            m.Edges, m.Loops, m.Faces, m.Shells, m.Bodies, m.Tolerances, m.Unit);

    //==
    // # Uniform scalings
    //
    // Scaling by k about the origin: points and vectors times k, lengths
    // times k, angles unchanged. A length parameter (a line's, through its
    // scaled velocity) keeps its values; preconditions for exactness are in
    // the README, "Metamorphic relations" (no parameter-plane curves, no
    // rectangular trim of a length parameter).

    // belongs-in: 01-geometry
    // The frame g with its origin scaled by k.
    ScaledFrame(g: Frame3D, k: Number): Frame3D
        => Frame3D(g.Origin.ScaledPoint(k), g.XAxis, g.YAxis, g.ZAxis);

    // belongs-in: 01-geometry
    // The point p scaled by k about the origin.
    ScaledPoint(p: Point3D, k: Number): Point3D
        => Point3D(p.X * k, p.Y * k, p.Z * k);

    // belongs-in: 01-geometry
    // A curve scaled by k.
    ScaledCurve(curve: BrepCurve, k: Number): BrepCurve
        => match (curve)
        {
            Line(origin, velocity) => BrepCurve.Line(origin.ScaledPoint(k), velocity * k);
            Circle(placement, radius) => BrepCurve.Circle(placement.ScaledFrame(k), radius * k);
            Ellipse(placement, semiAxis1, semiAxis2) => BrepCurve.Ellipse(placement.ScaledFrame(k), semiAxis1 * k, semiAxis2 * k);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => BrepCurve.Hyperbola(placement.ScaledFrame(k), semiAxis * k, semiImaginaryAxis * k);
            Parabola(placement, focalDistance) => BrepCurve.Parabola(placement.ScaledFrame(k), focalDistance * k);
            Polyline(points) => BrepCurve.Polyline(points.Map(p => p.ScaledPoint(k)));
            BSpline(data) => BrepCurve.BSpline(BSplineCurveData(data.Basis, data.ControlPoints.Map(p => p.ScaledPoint(k)), data.Weights));
            Trimmed(basis, range, sameSense) => curve;
            Composite(segments) => curve;
            Offset(basis, distance, reference) => BrepCurve.Offset(basis, distance * k, reference);
            OnSurface(spaceCurve, supports, master) => curve;
        };

    // belongs-in: 01-geometry
    // A surface scaled by k.
    ScaledSurface(surface: BrepSurface, k: Number): BrepSurface
        => match (surface)
        {
            Plane(placement) => BrepSurface.Plane(placement.ScaledFrame(k));
            Cylinder(placement, radius) => BrepSurface.Cylinder(placement.ScaledFrame(k), radius * k);
            Cone(placement, radius, semiAngle) => BrepSurface.Cone(placement.ScaledFrame(k), radius * k, semiAngle);
            Sphere(placement, radius) => BrepSurface.Sphere(placement.ScaledFrame(k), radius * k);
            Torus(placement, major, minor, part) => BrepSurface.Torus(placement.ScaledFrame(k), major * k, minor * k, part);
            Revolution(profile, axis) => BrepSurface.Revolution(profile, InfiniteLine3D(axis.Origin.ScaledPoint(k), axis.Direction));
            LinearExtrusion(profile, extrusion) => BrepSurface.LinearExtrusion(profile, extrusion * k);
            BSpline(data) => BrepSurface.BSpline(BSplineSurfaceData(data.U, data.V,
                MakeArray2D(data.ControlPoints.ColumnCount, data.ControlPoints.RowCount, (i, j) => data.ControlPoints.At(i, j).ScaledPoint(k)),
                data.Weights));
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => surface;
            Offset(basis, distance) => BrepSurface.Offset(basis, distance * k);
        };

    // belongs-in: 02-topology
    // The model scaled by k about the origin, its length tolerance with it;
    // the angle tolerance and the parameter floor unchanged. Curves that
    // refer to others by index (trimmed, composite, on-surface) scale through
    // them. Parameter-plane curves and pcurves are kept as they are, which is
    // exact on every surface whose parameters are angles or a line's
    // parameter, but not on a plane, whose (u, v) are lengths: the witnesses
    // carry no pcurves, and a corpus model with pcurves on planes needs them
    // scaled too (README, "Open items").
    ScaledBy(m: BrepModel, k: Number): BrepModel
        => BrepModel(
            GeometrySet(m.Geometry.Curves.Map(c => c.ScaledCurve(k)), m.Geometry.Curves2D, m.Geometry.Pcurves,
                m.Geometry.Surfaces.Map(s => s.ScaledSurface(k))),
            m.Vertices.Map(v => BrepVertex(v.Point.ScaledPoint(k))),
            m.Edges, m.Loops, m.Faces, m.Shells, m.Bodies,
            Tolerances(LengthTolerance(m.Tolerances.Length.Value * k), m.Tolerances.Angle, m.Tolerances.Parameter),
            m.Unit);

    // belongs-in: 04-discretization
    // A length limit scaled by k.
    ScaledLimit(l: Limit, k: Number): Limit
        => match (l)
        {
            Unlimited => Limit.Unlimited;
            AtMost(v) => Limit.AtMost(v * k);
        };

    // belongs-in: 05-face-meshing
    // Meshing criteria with every length scaled by k: the chordal bounds and
    // the length limits; the angular bounds, the segment count and the quad
    // preference unchanged.
    ScaledCriteria(c: FaceMeshingCriteria, k: Number): FaceMeshingCriteria
        => FaceMeshingCriteria(
            DiscretizationCriteria(c.Discretization.Chordal * k, c.Discretization.Angular,
                c.Discretization.MaxLength.ScaledLimit(k), c.Discretization.MinLength * k, c.Discretization.MinSegments),
            c.SurfaceChordal * k,
            c.SurfaceAngular,
            c.PreferQuads);

    //==
    // # Meshing once

    // One round of meshing a model under criteria c: every edge discretized
    // with no floors, every face meshed (an empty face mesh where meshing
    // refused it), the vertices numbered, the face meshes assembled. Layer 8
    // runs the refinement loop around this; the witness laws need no
    // refinement, since every witness edge is a line or a circle whose
    // closed-form split meets the image criteria (README, "Metamorphic
    // relations").
    MeshOnce(m: BrepModel, c: FaceMeshingCriteria): ModelMesh
    {
        var d = m.DiscretizeAll(c.Discretization, SegmentFloors.NoFloors);
        var faceMeshes = m.Faces.Count.MapRange(f => m.MeshFace(BrepFaceIndex(f), d, c).Mesh);
        return m.AssembleModelMesh(faceMeshes, m.NumberMeshVertices(d, faceMeshes));
    }

    // The criteria the witness laws mesh with by default: chordal 1/100 of a
    // unit, 15 degrees on edges and surfaces, no length limit, triangles.
    WitnessCriteria(_: FaceMeshingCriteria): FaceMeshingCriteria
        => FaceMeshingCriteria(DefaultCriteria(0.01), 0.01, 15.0.Degrees, false);

    //==
    // # Comparisons

    // True when two meshes have the same elements, corner for corner, and the
    // same element faces: the same connectivity whatever their positions.
    SameConnectivity(a: ModelMesh, b: ModelMesh): Boolean
        => a.Triangles.Corresponds(b.Triangles, (x, y) => x == y)
            && a.Quads.Corresponds(b.Quads, (x, y) => x == y)
            && a.ElementFace.Corresponds(b.ElementFace, (x, y) => x == y)
            && a.Positions.Count == b.Positions.Count;

    // True when two models hold the same tables value for value: points,
    // records and geometry compared exactly (every value is copied or computed
    // the same way in both), arrays compared element by element.
    SameModel(a: BrepModel, b: BrepModel): Boolean
        => a.Geometry.Curves.Corresponds(b.Geometry.Curves, (x, y) => x == y)
            && a.Geometry.Surfaces.Corresponds(b.Geometry.Surfaces, (x, y) => x == y)
            && a.Vertices.Corresponds(b.Vertices, (x, y) => x == y)
            && a.Edges.Corresponds(b.Edges, (x, y) => x == y)
            && a.Loops.Corresponds(b.Loops, (x, y) => x.CoedgesOf.Corresponds(y.CoedgesOf, (p, q) => p == q)
                && x.VertexLoopVertexOf.Corresponds(y.VertexLoopVertexOf, (p, q) => p == q))
            && a.Faces.Corresponds(b.Faces, (x, y) => x.Surface == y.Surface && x.SameSense == y.SameSense
                && x.Bounds.Corresponds(y.Bounds, (p, q) => p == q))
            && a.Shells.Corresponds(b.Shells, (x, y) => x.DeclaredClosed == y.DeclaredClosed
                && x.Faces.Corresponds(y.Faces, (p, q) => p == q))
            && a.Bodies.Corresponds(b.Bodies, (x, y) => x.ShellsOfBody.Corresponds(y.ShellsOfBody, (p, q) => p == q))
            && a.Tolerances == b.Tolerances
            && a.Unit == b.Unit;

    // True when every curve of the model is a line or a circle.
    HasOnlyLinesAndCircles(m: BrepModel): Boolean
        => m.Geometry.Curves.All(c => c.IsLineCase || c.IsCircleCase);

    // The largest sampled sagitta over every segment of every entry.
    MaxEdgeSagitta(m: BrepModel, d: EdgeDiscretizations, plan: SamplePlan): Number
        => d.ByEdge.Reduce(0.0, (worst, x) => x.SegmentCount.Max(0).Range.Reduce(worst, (w, i) =>
            m.IsEvaluableSegment(x, i) ? w.Max(m.SampledSagitta(x, plan, i)) : w));
}

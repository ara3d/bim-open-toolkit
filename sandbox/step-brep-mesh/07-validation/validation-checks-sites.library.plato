//==
// # Finding sites of pcurves and parameter-plane curves as tables (complexity sweep, chunk V3)
//
// BrepCheckingCommon's PcurveSite scans every edge for each pcurve, and
// Curve2DSite scans every pcurve and then calls PcurveSite, and CheckAll
// computes the site for every entry, holding or not: O(P E) per pcurve check
// and O(C2 P E) per parameter-plane curve check, over about ten Structure
// checks. The tables here are built in one pass over the edges (and one over
// the pcurves), and the checks read them: O(E + P + C2) per check for the
// sites. Entry p of PcurveSiteTable is PcurveSite(m, p), entry c of
// Curve2DSiteTable is Curve2DSite(m, c), so each Check is identical.
//
// Sections, in order:
//  - Site tables
//  - Checks over the tables

library BrepCheckingSites
{
    //==
    // # Site tables

    // PcurveSiteTable with its work counted: Insertions is the number of
    // edges visited plus the number of entries filled, E + P. The pass
    // visits edges in increasing order and records an edge for a pcurve only
    // when none is recorded yet, so each pcurve keeps the first edge whose
    // curve (in range) carries it, PcurveSite's choice; a pcurve no edge
    // carries is reported at its surface, PcurveSite's seed. A support naming
    // a pcurve outside the arena is skipped, as PcurveSite never asks for one.
    PcurveSiteTableCounted(m: BrepModel): Counted<Array<Provenance>>
    {
        var pcurveCount = m.Geometry.Pcurves.Count;
        var edgeCount = m.Edges.Count;
        var first = new Buffer<Integer>(pcurveCount.Max(1));
        var i = 0;
        while (i < pcurveCount)
        {
            first = first.Set(i, -1);
            i = i + 1;
        }
        var visits = 0;
        var e = 0;
        while (e < edgeCount)
        {
            visits = visits + 1;
            var c = m.Edges[e].Curve;
            if (m.Geometry.IsCurveInRange(c))
            {
                var carried = m.Geometry.PcurvesOf(c);
                var k = 0;
                while (k < carried.Count)
                {
                    var p = carried[k].Value;
                    if (p >= 0 && p < pcurveCount)
                    {
                        if (first.At(p) < 0)
                        {
                            first = first.Set(p, e);
                        }
                    }
                    k = k + 1;
                }
            }
            e = e + 1;
        }
        var firsts = first.Freeze();
        var sites = pcurveCount.MapRange(p => firsts[p] >= 0
            ? AtEdge(firsts[p])
            : Provenance.KernelSurface(m.Geometry.Pcurves[p].Surface));
        return Counted(sites, Insertions(visits + pcurveCount));
    }

    // PcurveSite of every pcurve, by pcurve position.
    PcurveSiteTable(m: BrepModel): Array<Provenance>
        => m.PcurveSiteTableCounted.Value;

    // Curve2DSite of every parameter-plane curve, given the pcurve sites: the
    // site of the first pcurve whose 2D curve it is, or the whole input when
    // no pcurve uses it. One pass over the pcurves.
    Curve2DSiteTableGiven(m: BrepModel, pcurveSites: Array<Provenance>): Array<Provenance>
    {
        var curveCount = m.Geometry.Curves2D.Count;
        var first = new Buffer<Integer>(curveCount.Max(1));
        var i = 0;
        while (i < curveCount)
        {
            first = first.Set(i, -1);
            i = i + 1;
        }
        var k = 0;
        while (k < m.Geometry.Pcurves.Count)
        {
            var c = m.Geometry.Pcurves[k].Curve.Value;
            if (c >= 0 && c < curveCount)
            {
                if (first.At(c) < 0)
                {
                    first = first.Set(c, k);
                }
            }
            k = k + 1;
        }
        var firsts = first.Freeze();
        return curveCount.MapRange(c => firsts[c] >= 0 ? pcurveSites[firsts[c]] : Provenance.WholeInput);
    }

    // Curve2DSite of every parameter-plane curve, by position.
    Curve2DSiteTable(m: BrepModel): Array<Provenance>
        => m.Curve2DSiteTableGiven(m.PcurveSiteTable);

    //==
    // # Checks over the tables

    // CheckPcurves with every site read from the table.
    CheckPcurvesIndexed(m: BrepModel, law: String, holds: Function1<PcurveIndex, Boolean>): Check
    {
        var sites = m.PcurveSiteTable;
        return CheckAll(law, m.Geometry.Pcurves.Count, i => holds(PcurveIndex(i)), i => sites[i]);
    }

    // CheckCurves2D with every site read from the table.
    CheckCurves2DIndexed(m: BrepModel, law: String, holds: Function1<Curve2DIndex, Boolean>): Check
    {
        var sites = m.Curve2DSiteTable;
        return CheckAll(law, m.Geometry.Curves2D.Count, i => holds(Curve2DIndex(i)), i => sites[i]);
    }

    // CheckPcurveSamplesGiven with every site read from the table.
    CheckPcurveSamplesIndexed(m: BrepModel, ok: Boolean, plan: SamplePlan, law: String, holds: Function2<PcurveIndex, Number, Boolean>): Check
    {
        var samples = m.PcurveSampleTable(ok, plan);
        var sites = m.PcurveSiteTable;
        return CheckGrid(law, m.Geometry.Pcurves.Count, plan.Count,
            (p, j) => holds(PcurveIndex(p), samples[p][j]),
            (p, j) => sites[p]);
    }

    // CheckCurve2DSamplesGiven with every site read from the table.
    CheckCurve2DSamplesIndexed(m: BrepModel, ok: Boolean, plan: SamplePlan, law: String, holds: Function2<Curve2DIndex, Number, Boolean>): Check
    {
        var samples = m.Curve2DSampleTable(ok, plan);
        var sites = m.Curve2DSiteTable;
        return CheckGrid(law, m.Geometry.Curves2D.Count, plan.Count,
            (c, j) => holds(Curve2DIndex(c), samples[c][j]),
            (c, j) => sites[c]);
    }
}

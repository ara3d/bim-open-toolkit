//==
// # Spec of the validated-report proof
//
// The invariant a ValidatedReport keeps and the single function permitted
// to build it (CheckCheckedMesh's spec is beside its type, in
// 06-mesh/mesh-proofs.spec.plato). m is the model the constructor was
// given. Not compiled; the runner skips this file.
//
// Sections, in order:
//  - Reports

//==
// # Reports

spec ValidatedReport
{
    invariant self.Report.IsClean;   // Law_ValidatedReportIffClean
    invariant self.Report.Checks.Count == m.ValidateBrep(self.Level).Checks.Count;   // Law_ValidatedReportRecordsLevel
    constructor CheckValidatedReport;
}

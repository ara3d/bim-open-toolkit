//==
// # Face-meshing self-tests with each recomputed value built once (complexity sweep, chunk L6)
//
// BrepCheckingFaceMeshing's recomputation self-tests passed m.FaceLoopAt,
// m.RegionOf, m.FaceTriangulation or m.MeshFace inside the per-sample
// lambda, so each sample re-mapped the face's loops, rebuilt its region or
// re-meshed the face; several laws behind them also recomputed a
// whole-region value per sample (Unwrap of the loop, the region tolerance,
// IsSimpleRegion, IsIndexedRegion, CornersInRange, the face's edge images).
// Each Check_<Name>Once here builds those values once per check and folds
// the same samples, in the same order, with the same claims, so its Check is
// the original's. A claim that needs a value only behind a guard takes it as
// an array of at most one entry, empty where the guard fails, so nothing is
// built that the original would not build.
//
// Sections, in order:
//  - Loops, recomputed once
//  - Region, recomputed once
//  - Triangulation and outcome, recomputed once
//  - Claims with their whole-region values given

library BrepCheckingFaceMeshingOnce
{
    //==
    // # Loops, recomputed once

    // Every bound of face f mapped into parameter space once (FaceLoopAt).
    FaceLoopsOf(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations): Array<UvLoop>
        => m.FaceBoundCount(f).MapRange(b => m.FaceLoopAt(f, d, b));

    // MostLoopPoints of the loops given.
    MostPointsOf(loops: Array<UvLoop>): Integer
        => loops.Reduce(0, (n, l) => n.Max(l.Points.Count));

    // Check_LoopPointLiftsToSharedPoint with the loops mapped once.
    Check_LoopPointLiftsToSharedPointOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations): Check
    {
        var loops = m.FaceLoopsOf(f, d);
        return CheckGrid("Law_LoopPointLiftsToSharedPoint", loops.Count, loops.MostPointsOf,
            (b, i) => Law_LoopPointLiftsToSharedPoint(m, f, d, loops[b], i),
            (b, i) => Provenance.KernelFace(f));
    }

    // Check_PcurveAgreesWithProjection with the face's coedge sites, each
    // used edge's image and its image points built once per edge (the
    // original found the face's uses, the image and its points per sample,
    // and projected each sample three times).
    Check_PcurveAgreesWithProjectionOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations): Check
    {
        var sites = m.CoedgeSitesOfFace(f);
        var faceOk = m.IsFaceIntact(f) && m.Geometry.IsEveryIndexInRange;
        var images = m.Edges.Count.MapRange(e => m.CheckedImageOf(f, d, sites, faceOk, BrepEdgeIndex(e)));
        var points = m.Edges.Count.MapRange(e => images[e].Pcurve.IsNone
            ? 0.MapRange(i => UvCoordinate(0.0, 0.0))
            : m.ImagePoints(d.ByEdge[e], images[e]));
        return CheckGrid("Law_PcurveAgreesWithProjection", m.Edges.Count, d.MostPoints,
            (e, k) => d.HasSample(BrepEdgeIndex(e), k) ? m.ImageAgreesWithProjectionGiven(f, images[e], points[e], d.ByEdge[e], k) : true,
            (e, k) => AtEdge(e));
    }

    // Check_SeamUsesOnOppositeCopies with the loops mapped once and the
    // face's edges listed once.
    Check_SeamUsesOnOppositeCopiesOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations): Check
    {
        var loops = m.FaceLoopsOf(f, d);
        var most = loops.MostPointsOf;
        var edges = m.FaceEdges(f);
        return CheckGrid("Law_SeamUsesOnOppositeCopies", loops.Count * edges.Count.Max(1), most * most,
            (be, ij) => edges.Count > 0
                ? Law_SeamUsesOnOppositeCopies(m, f, loops[be / edges.Count], edges[be % edges.Count], ij / most, ij % most)
                : true,
            (be, ij) => Provenance.KernelFace(f));
    }

    // Check_UnwrapKeepsSources with the loops mapped and unwrapped once.
    Check_UnwrapKeepsSourcesOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations): Check
    {
        var loops = m.FaceLoopsOf(f, d);
        var intact = m.IsFaceIntact(f);
        var unwrapped = loops.Map(l => m.UnwrappedIf(f, l, intact && l.Points.Count > 0 && l.Sources.Count > 0));
        return CheckGrid("Law_UnwrapKeepsSources", loops.Count, loops.MostPointsOf,
            (b, i) => (intact && loops[b].HasLoopPoint(i)) ? unwrapped[b].SourceAtIs(i, loops[b].Sources[i]) : true,
            (b, i) => Provenance.KernelFace(f));
    }

    // Check_UnwrapMovesByWholePeriods with the loops mapped and unwrapped
    // once.
    Check_UnwrapMovesByWholePeriodsOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations): Check
    {
        var loops = m.FaceLoopsOf(f, d);
        var intact = m.IsFaceIntact(f);
        var unwrapped = loops.Map(l => m.UnwrappedIf(f, l, intact && l.Points.Count == l.Sources.Count && l.Points.Count > 0));
        return CheckGrid("Law_UnwrapMovesByWholePeriods", loops.Count, loops.MostPointsOf,
            (b, i) => (intact && loops[b].Points.Count == loops[b].Sources.Count && loops[b].HasLoopPoint(i))
                ? (m.IsOnCollapsedLine(f, loops[b].Points[i]) ? true : m.MovedByWholePeriods(f, loops[b].Points[i], unwrapped[b], i))
                : true,
            (b, i) => Provenance.KernelFace(f));
    }

    // Check_UnwrappedStepBelowHalfPeriod with the loops mapped and
    // unwrapped once.
    Check_UnwrappedStepBelowHalfPeriodOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations): Check
    {
        var loops = m.FaceLoopsOf(f, d);
        var intact = m.IsFaceIntact(f);
        var unwrapped = loops.Map(l => m.UnwrappedIf(f, l, intact && l.Points.Count == l.Sources.Count));
        return CheckGrid("Law_UnwrappedStepBelowHalfPeriod", loops.Count, loops.MostPointsOf,
            (b, i) => (intact && loops[b].Points.Count == loops[b].Sources.Count) ? m.IsUnwrappedStep(f, unwrapped[b], i) : true,
            (b, i) => Provenance.KernelFace(f));
    }

    //==
    // # Region, recomputed once

    // Check_RegionLoopClosesInPlane with the region built once.
    Check_RegionLoopClosesInPlaneOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Check
    {
        var r = m.RegionOf(f, d, c);
        return CheckAll("Law_RegionLoopClosesInPlane", r.NumberOfLoops,
            k => Law_RegionLoopClosesInPlane(m, f, r, k),
            k => Provenance.KernelFace(f));
    }

    // Check_UvHoleWindingNegative with the region built once.
    Check_UvHoleWindingNegativeOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Check
    {
        var r = m.RegionOf(f, d, c);
        return CheckAll("Law_UvHoleWindingNegative", r.Holes.Count,
            h => UvHoleWindingNegative(m, f, r, h),
            h => Provenance.KernelFace(f));
    }

    // Check_RegionSegmentsSeparated with the region built once (five times
    // per pair in the original) and its tolerance computed once (once per
    // pair in the law).
    Check_RegionSegmentsSeparatedOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Check
    {
        var r = m.RegionOf(f, d, c);
        var tol = m.RegionToleranceIfIntact(f, r);
        return CheckGrid("Law_RegionSegmentsSeparated", r.BoundaryCount, r.BoundaryCount,
            (a, b) => r.SegmentsSeparatedGiven(tol,
                r.LoopOfBoundaryPoint(a), r.SlotOfBoundaryPoint(a),
                r.LoopOfBoundaryPoint(b), r.SlotOfBoundaryPoint(b)),
            (a, b) => Provenance.KernelFace(f));
    }

    // Check_HoleInsideOuter with the region built once and its simplicity
    // decided once (once per hole in HoleInsideOuter).
    Check_HoleInsideOuterOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Check
    {
        var r = m.RegionOf(f, d, c);
        var intact = m.IsFaceIntact(f);
        var simple = (intact && r.Holes.Count > 0) ? r.IsSimpleRegion(m.RegionToleranceOf(f, r)) : false;
        return CheckAll("Law_HoleInsideOuter", r.Holes.Count,
            h => (intact && r.Holes.IsValidIndex(h))
                ? (r.Holes[h].Points.IsEmpty ? true : (simple ? r.HoleInsideOuter(h) : true))
                : true,
            h => Provenance.KernelFace(f));
    }

    // Check_SeamCutCopiesRunOpposite with the region built once.
    Check_SeamCutCopiesRunOppositeOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Check
    {
        var r = m.RegionOf(f, d, c);
        return CheckAll("Law_SeamCutCopiesRunOpposite", r.Outer.Sources.Count,
            i => Law_SeamCutCopiesRunOpposite(r, i),
            i => Provenance.KernelFace(f));
    }

    //==
    // # Triangulation and outcome, recomputed once

    // Check_TriangulationKeepsBoundary with the region and triangulation
    // built once and IsIndexedRegion decided once.
    Check_TriangulationKeepsBoundaryOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Check
    {
        var r = m.RegionOf(f, d, c);
        var t = m.FaceTriangulation(f, d, c);
        var indexed = r.IsIndexedRegion;
        return CheckAll("Law_TriangulationKeepsBoundary", r.BoundaryCount,
            i => (indexed && i >= 0 && i < r.BoundaryCount)
                ? ((t.Points.IsValidIndex(i) && t.Sources.IsValidIndex(i))
                    ? r.BoundaryPoints[i].SameParameters(t.Points[i]) && r.BoundarySources[i] == t.Sources[i]
                    : false)
                : true,
            i => Provenance.KernelFace(f));
    }

    // Check_BoundarySegmentIsElementSide with the region and triangulation
    // built once and their whole-value guards decided once.
    Check_BoundarySegmentIsElementSideOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Check
    {
        var r = m.RegionOf(f, d, c);
        var t = m.FaceTriangulation(f, d, c);
        var ok = r.IsIndexedRegion && t.CornersInRange;
        return CheckGrid("Law_BoundarySegmentIsElementSide", r.NumberOfLoops, r.BoundaryCount,
            (k, i) => r.HasSegment(k, i)
                ? ((r.LoopAt(k).Points.Count >= 3 && ok)
                    ? t.SideCount(VertexIndex(r.LoopOffset(k) + i), VertexIndex(r.NextBoundaryPoint(r.LoopOffset(k) + i))) == 1
                        && t.SideCount(VertexIndex(r.NextBoundaryPoint(r.LoopOffset(k) + i)), VertexIndex(r.LoopOffset(k) + i)) == 0
                    : true)
                : true,
            (k, i) => Provenance.KernelFace(f));
    }

    // Check_InteriorSideIsShared with the region and triangulation built
    // once (once per element side in the original) and their whole-value
    // guards decided once.
    Check_InteriorSideIsSharedOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Check
    {
        var r = m.RegionOf(f, d, c);
        var t = m.FaceTriangulation(f, d, c);
        var ok = t.CornersInRange && r.IsIndexedRegion;
        return CheckGrid("Law_InteriorSideIsShared", t.ElementCount, 4,
            (k, j) => (t.HasElement(ElementIndex(k)) && ok)
                ? ((j >= 0 && j < t.ElementCorners(ElementIndex(k)).Count)
                    ? t.InteriorSideIsShared(r, t.ElementCorners(ElementIndex(k))[j], t.ElementCorners(ElementIndex(k)).AtModulo(j + 1))
                    : true)
                : true,
            (k, j) => Provenance.KernelFace(f));
    }

    // Check_ElementLiftsFacingFaceNormal with the triangulation built once.
    Check_ElementLiftsFacingFaceNormalOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Check
    {
        var t = m.FaceTriangulation(f, d, c);
        return CheckAll("Law_ElementLiftsFacingFaceNormal", t.ElementCount,
            k => Law_ElementLiftsFacingFaceNormal(m, f, t, ElementIndex(k)),
            k => Provenance.KernelFace(f));
    }

    // Check_RequestsNameFaceEdges with the face meshed once (once per
    // request in the original).
    Check_RequestsNameFaceEdgesOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Check
        => m.IsDiscretizedFace(f, d)
            ? m.RequestsNameFaceEdgesGiven(f, c, m.MeshFace(f, d, c))
            : CheckAll("Law_RequestsNameFaceEdges", 0, q => true, q => Provenance.KernelFace(f));

    // Check_RequestsNameFaceEdges on a discretized face f whose outcome is o.
    RequestsNameFaceEdgesGiven(m: BrepModel, f: BrepFaceIndex, c: FaceMeshingCriteria, o: FaceMeshOutcome): Check
    {
        var wellFormed = c.IsWellFormed;
        return CheckAll("Law_RequestsNameFaceEdges", o.Requests.Count,
            q => wellFormed ? m.RequestNamesFaceEdge(f, o, q) : true,
            q => Provenance.KernelFace(f));
    }

    // Check_TriangulationAddsOnlyInteriorPoints with the region and
    // triangulation built once and the region tolerance computed once.
    Check_TriangulationAddsOnlyInteriorPointsOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Check
    {
        var r = m.RegionOf(f, d, c);
        var t = m.FaceTriangulation(f, d, c);
        var tol = m.RegionToleranceIfIntact(f, r);
        return CheckAll("Law_TriangulationAddsOnlyInteriorPoints", t.Points.Count,
            i => (tol.Count > 0 && i >= r.BoundaryCount && t.Points.IsValidIndex(i) && t.Sources.IsValidIndex(i))
                ? t.Sources[i] == UvPointSource.Interior && r.IsStrictlyInside(t.Points[i], tol[0])
                : true,
            i => Provenance.KernelFace(f));
    }

    // Check_EveryPointIsACorner with the triangulation built once.
    Check_EveryPointIsACornerOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Check
    {
        var t = m.FaceTriangulation(f, d, c);
        return CheckAll("Law_EveryPointIsACorner", t.Points.Count,
            i => EveryPointIsACorner(t, i),
            i => Provenance.KernelFace(f));
    }

    // Check_LiftKeepsPoints with the triangulation built once.
    Check_LiftKeepsPointsOnce(m: BrepModel, d: EdgeDiscretizations, fm: FaceMesh, c: FaceMeshingCriteria): Check
    {
        var t = m.FaceTriangulation(fm.Face, d, c);
        return CheckAll("Law_LiftKeepsPoints", t.Points.Count,
            i => LiftKeepsPoints(t, fm, i),
            i => Provenance.KernelFace(fm.Face));
    }

    //==
    // # Claims with their whole-region values given

    // Unwrap of loop l of face f when unwrap holds, else l itself, which no
    // claim reads: the caller's guard is the claim's own.
    UnwrappedIf(m: BrepModel, f: BrepFaceIndex, l: UvLoop, unwrap: Boolean): UvLoop
        => unwrap ? m.Unwrap(f, l) : l;

    // The region tolerance of r on face f, as one entry, when f is intact;
    // none otherwise (the laws read it only behind IsFaceIntact).
    RegionToleranceIfIntact(m: BrepModel, f: BrepFaceIndex, r: UvRegion): Array<UvTolerance>
        => m.IsFaceIntact(f) ? [m.RegionToleranceOf(f, r)] : 0.MapRange(i => m.RegionToleranceOf(f, r));

    // Law_RegionSegmentsSeparated's claim, tol RegionToleranceIfIntact.
    SegmentsSeparatedGiven(r: UvRegion, tol: Array<UvTolerance>, k: Integer, i: Integer, q: Integer, j: Integer): Boolean
        => (tol.Count > 0 && r.HasSegment(k, i) && r.HasSegment(q, j))
            ? r.SegmentsSeparated(tol[0], k, i, q, j)
            : true;

    // The image Law_PcurveAgreesWithProjection reads for edge e of face f
    // where a sample can reach it (the face uses e, both are intact, and e
    // has a sample); elsewhere an image with no pcurve, whose claim is
    // vacuous. sites is CoedgeSitesOfFace(f), faceOk the face and arena
    // guard.
    CheckedImageOf(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, sites: Array<CoedgeSite>, faceOk: Boolean, e: BrepEdgeIndex): EdgeImage
        => (faceOk && m.IsEdgeIntact(e) && d.HasSample(e, 0) && m.SitesCiting(sites, e).Count > 0)
            ? m.ImageInFace(f, e)
            : EdgeImage(f, PcurveIndex(-1));

    // ImageAgreesWithProjection with the image's points given (points is
    // ImagePoints(de, img) when img has a pcurve) and sample k projected
    // once.
    ImageAgreesWithProjectionGiven(m: BrepModel, f: BrepFaceIndex, img: EdgeImage, points: Array<UvCoordinate>,
        de: EdgeDiscretization, k: Integer): Boolean
        => (img.Pcurve.IsNone || points.IsValidIndex(k).Not)
            ? true
            : m.ProjectionAgreesAt(f, points[k], m.Geometry.Project(m.SurfaceOf(f), de.Points[k]));

    // The claim of ImageAgreesWithProjection at one sample: image is the
    // image's point, projected the sample's projection onto the surface.
    ProjectionAgreesAt(m: BrepModel, f: BrepFaceIndex, image: UvCoordinate, projected: UvCoordinate): Boolean
        => m.IsOnCollapsedLine(f, projected)
            ? true
            : m.SurfaceDomainOf(f).SameParameter(image, projected, m.PointTolerance(f, projected));
}

//==
// # BrepCheckingReports
//
// Layer 7 of the STEP B-rep to mesh design (README.md beside this file): the
// reports of the checks of layers 0 to 6, one function per layer and input,
// each split by CheckFamily so that a ConformanceLevel picks what runs.
// Generated from the check libraries by the layer's report script (README,
// "Implementation notes"): a check's family comes from its section
// (structure, geometry, quality, self-tests); a measured check carries its
// law's bound in its own Bound (layer 0's Check), so the report states none;
// a check whose law layer 3 or 2 grades a Warning gets WarningReport; an Info
// check gets QualityReport. Each message is the law's name in words, and the
// diagnostic's code is the law's name.

library BrepCheckingReports
{
    // The checks of layer 0's model tolerances and of layer 2's topology laws, in
    // one family, each with its law's grade: exact laws Error, measured laws
    // against the length tolerance, Law_EdgeDomainEndsAtVertices a Warning.
    TopologyReport(m: BrepModel, plan: SamplePlan, family: CheckFamily): Report
        => match (family)
        {
            StructureChecks => MergeAll([
                ExactReport(m.Check_LengthTolerancePositive,
                    "Length tolerance positive does not hold."),
                ExactReport(m.Check_AngleTolerancePositive,
                    "Angle tolerance positive does not hold."),
                ExactReport(m.Check_ParameterTolerancePositive,
                    "Parameter tolerance positive does not hold."),
                ExactReport(m.Check_IndicesInRange,
                    "Indices in range does not hold."),
                ExactReport(m.Check_LoopsChainEndToStart,
                    "Loops chain end to start does not hold."),
                ExactReport(m.Check_AtMostOneOuterBound,
                    "At most one outer bound does not hold."),
                ExactReport(m.Check_AtLeastOneBound,
                    "At least one bound does not hold."),
                ExactReport(m.Check_FaceBoundsShareNoVertex,
                    "Face bounds share no vertex does not hold."),
                WarningReport(m.Check_NoRedundantVertexLoop,
                    "A face has a redundant vertex loop; the reduction drops it."),
                ExactReport(m.Check_PolyLoopHasThreePoints,
                    "Poly loop has three points does not hold."),
                ExactReport(m.Check_OpenShellVertexLinkIsCycleOrPath,
                    "Open shell vertex link is cycle or path does not hold."),
                ExactReport(m.Check_PolyLoopEdgesPairUp,
                    "Poly loop edges pair up does not hold."),
                ExactReport(m.Check_OpenShellEulerEvenAndBounded,
                    "Open shell Euler even and bounded does not hold."),
                ExactReport(m.Check_ShellIsConnected,
                    "Shell is connected does not hold."),
                ExactReport(m.Check_ShellIsOrientable,
                    "Shell is orientable does not hold."),
                ExactReport(m.Check_PcurveRunsWithCurve(plan),
                    "Pcurve runs with curve does not hold."),
                WarningReport(m.Check_PcurveSurfaceIsAFaceSurface,
                    "A pcurve lies on no surface of a face citing its edge; it is ignored."),
                ExactReport(m.Check_EveryEdgeUsedTwiceInClosedShell,
                    "Every edge used twice in closed shell does not hold."),
                ExactReport(m.Check_OpenShellEdgesUsedAtMostTwice,
                    "Open shell edges used at most twice does not hold."),
                ExactReport(m.Check_DeclaredClosedIsClosed,
                    "Declared closed is closed does not hold."),
                ExactReport(m.Check_EdgeUsesHaveOppositeOrientation,
                    "Edge uses have opposite orientation does not hold."),
                ExactReport(m.Check_SeamUsesRunOpposite,
                    "Seam uses are in one face does not hold."),
                ExactReport(m.Check_VertexLinkIsOneCycle,
                    "Vertex link is one cycle does not hold."),
                ExactReport(m.Check_VertexLoopVertexIsIsolated,
                    "Vertex loop vertex is isolated does not hold."),
                ExactReport(m.Check_EulerPoincareEvenAndBounded,
                    "Euler Poincare even and bounded does not hold."),
                ExactReport(m.Check_SolidShellsAreDeclaredClosed,
                    "Solid shells are declared closed does not hold."),
                ExactReport(m.Check_EdgeDomainIsForward,
                    "Edge domain is forward does not hold."),
                ExactReport(m.Check_CoincidentEndsAreOneVertex,
                    "Coincident ends are one vertex does not hold."),
                WarningReport(m.Check_EdgeHasPositiveExtent,
                    "Edge has positive extent does not hold; the reduction contracts it."),
                ExactReport(m.Check_DegenerateEdgeHasCoincidentVertices,
                    "Degenerate edge has coincident vertices does not hold."),
                ExactReport(m.Check_LoopWindingMatchesSameSense,
                    "Loop winding matches same sense does not hold.")]);
            GeometryChecks => MergeAll([
                MeasuredReport(m.Check_LengthToleranceResolvable,
                    "Length tolerance resolvable does not hold."),
                MeasuredReport(m.Check_DegenerateEdgeStaysAtStart(plan),
                    "Degenerate edge stays at start does not hold."),
                MeasuredReport(m.Check_EdgeDomainEndsAtVertices,
                    "Edge domain ends at vertices does not hold."),
                MeasuredReport(m.Check_VertexCoincidesWithCurveEnd,
                    "Vertex coincides with curve end does not hold."),
                MeasuredReport(m.Check_EdgeLiesOnAdjacentSurfaces(plan),
                    "Edge lies on adjacent surfaces does not hold."),
                MeasuredReport(m.Check_PcurveAgreesWithCurve(plan),
                    "Pcurve agrees with curve does not hold."),
                MeasuredReport(m.Check_CurveAgreesWithPcurve(plan),
                    "Curve agrees with pcurve does not hold.")]);
            QualityChecks => Report.Empty;
            OracleChecks => Report.Empty;
            SelfTestChecks => MergeAll([
                ExactReport(m.Check_EdgeReversalKeepsCoedgeSense,
                    "Edge reversal keeps coedge sense does not hold."),
                ExactReport(m.Check_EdgeReversalKeepsEdgeDomain,
                    "Edge reversal keeps edge domain does not hold."),
                ExactReport(m.Check_ParameterizationSignIsConstantOnFace(plan),
                    "Parameterization sign is constant on face does not hold."),
                ExactReport(m.Check_ReversingEveryFaceKeepsCoherence,
                    "Reversing every face keeps coherence does not hold."),
                ExactReport(m.Check_ScalingScalesExtent,
                    "Scaling the model by 2 does not scale its coordinate extent."),
                ExactReport(m.Check_ModelSizeWithinExtent,
                    "Model size within extent does not hold.")]);
        };

    // The checks of layer 1's laws over the model's geometry arena, in one
    // family: records and shapes (structure), what the file supplied (geometry),
    // and the library's own self-tests.
    GeometryArenaReport(m: BrepModel, plan: SamplePlan, family: CheckFamily): Report
        => match (family)
        {
            StructureChecks => MergeAll([
                ExactReport(m.Check_CurveReferencesInRange,
                    "Curve references in range does not hold."),
                ExactReport(m.Check_Curve2DReferencesInRange,
                    "Curve2 d references in range does not hold."),
                ExactReport(m.Check_PcurveReferencesInRange,
                    "Pcurve references in range does not hold."),
                ExactReport(m.Check_SurfaceReferencesInRange,
                    "Surface references in range does not hold."),
                ExactReport(m.Check_ClosureMarkInRange,
                    "A closure mark names no entry of the arena."),
                ExactReport(m.Check_ClosureMarkNamesBoundedAperiodic,
                    "A closure mark names a direction that is unbounded or already periodic."),
                ExactReport(m.Check_CurveReferencesAcyclic,
                    "Curve references acyclic does not hold."),
                ExactReport(m.Check_Curve2DReferencesAcyclic,
                    "Curve2 d references acyclic does not hold."),
                ExactReport(m.Check_SurfaceReferencesAcyclic,
                    "Surface references acyclic does not hold."),
                ExactReport(m.Check_CurveHasEvaluableShape,
                    "Curve has evaluable shape does not hold."),
                ExactReport(m.Check_Curve2DHasEvaluableShape,
                    "Curve2 d has evaluable shape does not hold."),
                ExactReport(m.Check_SurfaceHasEvaluableShape,
                    "Surface has evaluable shape does not hold."),
                ExactReport(m.Check_BSplineCurveDegreePositive,
                    "B spline curve degree positive does not hold."),
                ExactReport(m.Check_BSplineCurveKnotCount,
                    "B spline curve knot count does not hold."),
                ExactReport(m.Check_BSplineCurveKnotsNonDecreasing,
                    "B spline curve knots non decreasing does not hold."),
                ExactReport(m.Check_BSplineCurveKnotMultiplicityBounded,
                    "B spline curve knot multiplicity bounded does not hold."),
                ExactReport(m.Check_BSplineCurveDomainNonEmpty,
                    "B spline curve domain non empty does not hold."),
                ExactReport(m.Check_BSplineCurveWeightCount,
                    "B spline curve weight count does not hold."),
                ExactReport(m.Check_BSplineCurveWeightsPositive,
                    "B spline curve weights positive does not hold."),
                ExactReport(m.Check_BSplineCurve2DDegreePositive,
                    "B spline curve2 d degree positive does not hold."),
                ExactReport(m.Check_BSplineCurve2DKnotCount,
                    "B spline curve2 d knot count does not hold."),
                ExactReport(m.Check_BSplineCurve2DKnotsNonDecreasing,
                    "B spline curve2 d knots non decreasing does not hold."),
                ExactReport(m.Check_BSplineCurve2DKnotMultiplicityBounded,
                    "B spline curve2 d knot multiplicity bounded does not hold."),
                ExactReport(m.Check_BSplineCurve2DDomainNonEmpty,
                    "B spline curve2 d domain non empty does not hold."),
                ExactReport(m.Check_BSplineCurve2DWeightCount,
                    "B spline curve2 d weight count does not hold."),
                ExactReport(m.Check_BSplineCurve2DWeightsPositive,
                    "B spline curve2 d weights positive does not hold."),
                ExactReport(m.Check_BSplineSurfaceDegreePositive,
                    "B spline surface degree positive does not hold."),
                ExactReport(m.Check_BSplineSurfaceKnotCount,
                    "B spline surface knot count does not hold."),
                ExactReport(m.Check_BSplineSurfaceKnotsNonDecreasing,
                    "B spline surface knots non decreasing does not hold."),
                ExactReport(m.Check_BSplineSurfaceKnotMultiplicityBounded,
                    "B spline surface knot multiplicity bounded does not hold."),
                ExactReport(m.Check_BSplineSurfaceDomainNonEmpty,
                    "B spline surface domain non empty does not hold."),
                ExactReport(m.Check_BSplineSurfaceNetConsistent,
                    "B spline surface net consistent does not hold."),
                ExactReport(m.Check_BSplineSurfaceWeightGridMatchesNet,
                    "B spline surface weight grid matches net does not hold."),
                ExactReport(m.Check_BSplineSurfaceWeightsPositive,
                    "B spline surface weights positive does not hold."),
                ExactReport(m.Check_TrimmedRangeIsForward,
                    "Trimmed range is forward does not hold."),
                ExactReport(m.Check_RectangularTrimmedRangeIsForward,
                    "Rectangular trimmed range is forward does not hold."),
                ExactReport(m.Check_CompositeSegmentsBounded,
                    "Composite segments bounded does not hold."),
                ExactReport(m.Check_SurfaceCurvePcurveSameSense(plan),
                    "Surface curve pcurve same sense does not hold."),
                ExactReport(m.Check_AreaElementPositiveAwayFromCollapse(plan),
                    "Area element positive away from collapse does not hold.")]);
            GeometryChecks => MergeAll([
                MeasuredReport(m.Check_CurvePlacementOrthonormal,
                    "Curve placement orthonormal does not hold."),
                MeasuredReport(m.Check_Curve2DPlacementOrthonormal,
                    "Curve2 d placement orthonormal does not hold."),
                MeasuredReport(m.Check_SurfacePlacementOrthonormal,
                    "Surface placement orthonormal does not hold."),
                MeasuredReport(m.Check_TrimmedRangeInsideBasis,
                    "Trimmed range inside basis does not hold."),
                MeasuredReport(m.Check_RectangularTrimmedInsideBasis,
                    "Rectangular trimmed inside basis does not hold."),
                MeasuredReport(m.Check_CompositeSegmentsChain,
                    "Composite segments chain does not hold."),
                ExactReport(m.Check_OffsetReferenceNotTangent(plan),
                    "Offset reference not tangent does not hold."),
                ExactReport(m.Check_ExtrusionProfileTransverse(plan),
                    "Extrusion profile transverse does not hold."),
                MeasuredReport(m.Check_SurfaceCurveLiesOnSupport(plan),
                    "Surface curve lies on support does not hold."),
                MeasuredReport(m.Check_SurfaceCurvePcurveLiesOnCurve(plan),
                    "Surface curve pcurve lies on curve does not hold."),
                MeasuredReport(m.Check_SurfaceCurveLiesOnPcurve(plan),
                    "Surface curve lies on pcurve does not hold."),
                MeasuredReport(m.Check_PcurveWithinSurfaceDomain(plan),
                    "Pcurve within surface domain does not hold."),
                MeasuredReport(m.Check_CollapsedLineIsOnePoint(plan),
                    "Collapsed line is one point does not hold."),
                ExactReport(m.Check_TangentialPartialVanishesOnDegenerateSide(plan),
                    "Tangential partial vanishes on degenerate side does not hold.")]);
            QualityChecks => Report.Empty;
            OracleChecks => Report.Empty;
            SelfTestChecks => MergeAll([
                ExactReport(m.Check_BSplineCurveDomainIsKnotSpan,
                    "B spline curve domain is knot span does not hold."),
                ExactReport(m.Check_BSplineCurveMatchesBasisSum(plan),
                    "B spline curve matches basis sum does not hold."),
                ExactReport(m.Check_PeriodicCurveSpansOnePeriod,
                    "Periodic curve spans one period does not hold."),
                ExactReport(m.Check_PeriodicCurveIsClosed,
                    "Periodic curve is closed does not hold."),
                ExactReport(m.Check_CurveRepeatsWithPeriod(plan),
                    "Curve repeats with period does not hold."),
                ExactReport(m.Check_DerivativeMatchesCentralDifference(plan),
                    "Derivative matches central difference does not hold."),
                ExactReport(m.Check_SecondDerivativeMatchesCentralDifference(plan),
                    "Second derivative matches central difference does not hold."),
                ExactReport(m.Check_ClosestParameterNoWorseThanSample(plan),
                    "ClosestParameter found a worse point than a sample of the curve."),
                ExactReport(m.Check_ClosestParameterIsStationary(plan),
                    "ClosestParameter returned an interior parameter that is not stationary."),
                ExactReport(m.Check_PcurveClosestParameterIsBounded(plan),
                    "ClosestParameter on a pcurve returned an unbounded or unrepresentative parameter."),
                ExactReport(m.Check_ScaledCurvePointIsScaled(plan),
                    "Scaling the arena does not scale a curve's point."),
                ExactReport(m.Check_ScaledPcurvePointIsScaled(plan),
                    "Scaling the arena does not scale a pcurve's point."),
                ExactReport(m.Check_ClosestParameterRecoversPoint(plan),
                    "Closest parameter recovers point does not hold."),
                ExactReport(m.Check_ClosestParameterIsCanonical(plan),
                    "Closest parameter is canonical does not hold."),
                ExactReport(m.Check_TrimmedStartsAtSensedEnd,
                    "Trimmed starts at sensed end does not hold."),
                ExactReport(m.Check_BSplineCurve2DDomainIsKnotSpan,
                    "B spline curve2 d domain is knot span does not hold."),
                ExactReport(m.Check_BSplineCurve2DMatchesBasisSum(plan),
                    "B spline curve2 d matches basis sum does not hold."),
                ExactReport(m.Check_Curve2DRepeatsWithPeriod(plan),
                    "Curve2 d repeats with period does not hold."),
                ExactReport(m.Check_Curve2DDerivativeMatchesCentralDifference(plan),
                    "Curve2 d derivative matches central difference does not hold."),
                ExactReport(m.Check_Curve2DSecondDerivativeMatchesCentralDifference(plan),
                    "Curve2 d second derivative matches central difference does not hold."),
                ExactReport(m.Check_PcurveDerivativeMatchesCentralDifference(plan),
                    "Pcurve derivative matches central difference does not hold."),
                ExactReport(m.Check_PcurveSecondDerivativeMatchesCentralDifference(plan),
                    "Pcurve second derivative matches central difference does not hold."),
                ExactReport(m.Check_BSplineSurfaceDomainIsKnotSpan,
                    "B spline surface domain is knot span does not hold."),
                ExactReport(m.Check_BSplineSurfaceMatchesBasisSum(plan),
                    "B spline surface matches basis sum does not hold."),
                ExactReport(m.Check_PeriodicSurfaceSpansOnePeriod,
                    "Periodic surface spans one period does not hold."),
                ExactReport(m.Check_SurfaceRepeatsWithPeriod(plan),
                    "Surface repeats with period does not hold."),
                ExactReport(m.Check_PartialMatchesCentralDifference(plan),
                    "Partial matches central difference does not hold."),
                ExactReport(m.Check_NormalIsUnit(plan),
                    "Normal is unit does not hold."),
                ExactReport(m.Check_NormalOrthogonalToPartial(plan),
                    "Normal orthogonal to partial does not hold."),
                ExactReport(m.Check_NormalSenseMatchesParameterization(plan),
                    "Normal sense matches parameterization does not hold."),
                ExactReport(m.Check_AreaElementMatchesCrossProduct(plan),
                    "Area element matches cross product does not hold."),
                ExactReport(m.Check_ConeAreaElement(plan),
                    "Cone area element does not hold."),
                ExactReport(m.Check_SphereAreaElement(plan),
                    "Sphere area element does not hold."),
                ExactReport(m.Check_TorusAreaElement(plan),
                    "Torus area element does not hold."),
                ExactReport(m.Check_ProjectRecoversPoint(plan),
                    "Project recovers point does not hold."),
                ExactReport(m.Check_ProjectRecoversParameter(plan),
                    "Project recovers parameter does not hold."),
                ExactReport(m.Check_ProjectNearRecoversParameter(plan),
                    "Project near recovers parameter does not hold."),
                ExactReport(m.Check_ProjectIsCanonical(plan),
                    "Project is canonical does not hold."),
                ExactReport(m.Check_ProjectNoWorseThanSample(plan),
                    "Project found a worse point than a sample of the surface."),
                ExactReport(m.Check_ProjectIsStationary(plan),
                    "Project returned an interior parameter that is not stationary."),
                ExactReport(m.Check_ProjectNearRecoversFromNearbySeed(plan),
                    "ProjectNear seeded near the answer did not recover it."),
                ExactReport(m.Check_ScaledSurfacePointIsScaled(plan),
                    "Scaling the arena does not scale a surface's point.")]);
        };

    // The checks of layer 4's laws over one set of edge discretizations, in one
    // family: shape and agreement with the model (structure), the criteria
    // (geometry), a forced short segment (quality), and the self-tests.
    DiscretizationReport(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria, floors: SegmentFloors, plan: SamplePlan, family: CheckFamily): Report
        => match (family)
        {
            StructureChecks => MergeAll([
                ExactReport(d.Check_ParameterCountEqualsPointCount,
                    "Parameter count equals point count does not hold."),
                ExactReport(d.Check_EmptyOrAtLeastTwoParameters,
                    "Empty or at least two parameters does not hold."),
                ExactReport(m.Check_UndiscretizedExactlyWhenUnusable(d, c),
                    "Undiscretized exactly when unusable does not hold."),
                ExactReport(d.Check_ParametersStrictlyMonotone,
                    "Parameters strictly monotone does not hold."),
                ExactReport(d.Check_ParametersStrictlyIncreasing,
                    "Parameters strictly increasing does not hold."),
                ExactReport(m.Check_LowestParameterIsDomainStart(d),
                    "Lowest parameter is domain start does not hold."),
                ExactReport(m.Check_HighestParameterIsDomainEnd(d),
                    "Highest parameter is domain end does not hold."),
                ExactReport(m.Check_DomainStartPointIsVertex(d),
                    "Domain start point is vertex does not hold."),
                ExactReport(m.Check_DomainEndPointIsVertex(d),
                    "Domain end point is vertex does not hold."),
                ExactReport(m.Check_SeedsAreSampled(d),
                    "Seeds are sampled does not hold."),
                ExactReport(m.Check_DegenerateEdgeHasOneSegment(d),
                    "Degenerate edge has one segment does not hold."),
                ExactReport(m.Check_ClosedEdgeHasMinSegments(d, c),
                    "Closed edge has min segments does not hold."),
                ExactReport(m.Check_SegmentFloorMet(d, c, floors),
                    "Segment floor met does not hold."),
                ExactReport(d.Check_DiscretizationsIndexedByEdge,
                    "Discretizations indexed by edge does not hold."),
                ExactReport(m.Check_DiscretizationsCoverEdges(d),
                    "Discretizations cover edges does not hold."),
                ExactReport(m.Check_ImageHasOnePointPerPoint(d),
                    "Image has one point per point does not hold."),
                ExactReport(m.Check_ImagePointReevaluates(d),
                    "Image point reevaluates does not hold."),
                ExactReport(m.Check_ImageStepsAreUnwrapped(d),
                    "Image steps are unwrapped does not hold.")]);
            GeometryChecks => MergeAll([
                MeasuredReport(m.Check_PointsLieOnCurve(d),
                    "Points lie on curve does not hold."),
                MeasuredReport(m.Check_SagittaWithinChordal(d, c, plan),
                    "Sagitta within chordal does not hold."),
                MeasuredReport(m.Check_TangentDeviationWithinHalfAngular(d, c, plan),
                    "Tangent deviation within half angular does not hold."),
                MeasuredReport(m.Check_TurningAngleWithinAngular(d, c),
                    "Turning angle within angular does not hold."),
                MeasuredReport(m.Check_SegmentWithinMaxLength(d, c),
                    "Segment within max length does not hold."),
                MeasuredReport(m.Check_ImageChordWithinChordal(d, c, plan),
                    "Image chord within chordal does not hold.")]);
            QualityChecks => QualityReport(m.Check_ShortSegmentIsForced(d, c, floors),
                    "Short segment is forced does not hold.");
            OracleChecks => Report.Empty;
            SelfTestChecks => MergeAll([
                ExactReport(m.Check_CertifiedSagittaWithinChordal(d, c),
                    "A segment's exact sagitta exceeds the chordal bound Discretize promises."),
                ExactReport(d.Check_ReversedIsInvolution,
                    "Reversed is involution does not hold."),
                ExactReport(d.Check_ReversedReversesParameters,
                    "Reversed reverses parameters does not hold."),
                ExactReport(d.Check_ReversedReversesPoints,
                    "Reversed reverses points does not hold."),
                ExactReport(m.Check_OppositeUsesSeeReversedPoints(d),
                    "Opposite uses see reversed points does not hold."),
                ExactReport(m.Check_EdgeReversalLeavesDiscretization(c, floors),
                    "Edge reversal leaves discretization does not hold."),
                ExactReport(m.Check_TighterChordalNeverFewerPoints(c, floors),
                    "Tighter chordal never fewer points does not hold."),
                ExactReport(m.Check_RefineKeepsUnrequestedEdges(d, c),
                    "Refine keeps unrequested edges does not hold."),
                ExactReport(m.Check_RefineNeverCoarsens(d, c),
                    "Refine never coarsens does not hold."),
                ExactReport(m.Check_RefineMeetsRequestedSegments(d, c),
                    "Refine meets requested segments does not hold."),
                ExactReport(m.Check_ArcCriteriaCountMeetsChordal(c),
                    "Arc criteria count meets chordal does not hold.")]);
        };

    // The checks of layer 5's laws over one face mesh that need neither the edge
    // discretizations nor the outcome, in one family.
    FaceMeshOwnReport(m: BrepModel, fm: FaceMesh, c: FaceMeshingCriteria, family: CheckFamily): Report
        => match (family)
        {
            StructureChecks => MergeAll([
                ExactReport(fm.Check_LocalVertexInRange,
                    "Local vertex in range does not hold."),
                ExactReport(fm.Check_LocalVertexSurjective,
                    "Local vertex surjective does not hold."),
                ExactReport(fm.Check_LocalVertexFibresAreIdentifications,
                    "Local vertex fibres are identifications does not hold."),
                ExactReport(m.Check_ElementFacesFaceNormal(fm),
                    "Element faces face normal does not hold."),
                ExactReport(fm.Check_QuadConvex,
                    "Quad convex does not hold."),
                ExactReport(fm.Check_TriangulationCornersInRange,
                    "Triangulation corners in range does not hold."),
                ExactReport(m.Check_ElementPositiveInChart(fm),
                    "Element positive in chart does not hold."),
                ExactReport(m.Check_ElementSpansBelowHalfPeriod(fm),
                    "Element spans below half period does not hold.")]);
            GeometryChecks => MergeAll([
                ExactReport(m.Check_PointNormalIsFaceNormal(fm),
                    "Point normal is face normal does not hold."),
                MeasuredReport(m.Check_ElementNormalAgreesWithSurface(fm, c),
                    "Element normal agrees with surface does not hold."),
                MeasuredReport(fm.Check_QuadPlanarWithinSurfaceChordal(c),
                    "Quad planar within surface chordal does not hold.")]);
            QualityChecks => Report.Empty;
            OracleChecks => Report.Empty;
            SelfTestChecks => Report.Empty;
        };

    // The checks of layer 5's laws over one face mesh against the edge
    // discretizations it was built on, in one family; the recomputed region and
    // triangulation self-tests run on the mesh's face.
    FaceMeshAgainstEdgesReport(m: BrepModel, d: EdgeDiscretizations, fm: FaceMesh, c: FaceMeshingCriteria, family: CheckFamily): Report
        => match (family)
        {
            StructureChecks => MergeAll([
                ExactReport(m.Check_SharedPositionIsCopied(d, fm),
                    "Shared position is copied does not hold."),
                ExactReport(d.Check_ProvenanceMatchesSource(fm),
                    "Provenance matches source does not hold.")]);
            GeometryChecks => MergeAll([
                MeasuredReport(m.Check_SurfaceEdgeNormalTurnWithinSurfaceAngular(d, fm, c),
                    "Surface edge normal turn within surface angular does not hold."),
                MeasuredReport(m.Check_ElementDeviationWithinSurfaceChordal(d, fm, c),
                    "Element deviation within surface chordal does not hold."),
                MeasuredReport(m.Check_SurfaceWithinSurfaceChordalOfElement(d, fm, c),
                    "The surface under an element lies farther from it than the surface chordal criterion.")]);
            QualityChecks => Report.Empty;
            OracleChecks => Report.Empty;
            SelfTestChecks => MergeAll([
                ExactReport(m.Check_LoopPointLiftsToSharedPoint(fm.Face, d),
                    "Loop point lifts to shared point does not hold."),
                ExactReport(m.Check_LoopToUvCountMatchesDiscretization(fm.Face, d),
                    "Loop to uv count matches discretization does not hold."),
                ExactReport(m.Check_PcurveAgreesWithProjection(fm.Face, d),
                    "Pcurve agrees with projection does not hold."),
                ExactReport(m.Check_SeamUsesOnOppositeCopies(fm.Face, d),
                    "The two uses of a seam do not lie on opposite copies by the left rule."),
                ExactReport(m.Check_UnwrapKeepsSources(fm.Face, d),
                    "Unwrap keeps sources does not hold."),
                ExactReport(m.Check_UnwrapMovesByWholePeriods(fm.Face, d),
                    "Unwrap moves by whole periods does not hold."),
                ExactReport(m.Check_UnwrappedStepBelowHalfPeriod(fm.Face, d),
                    "Unwrapped step below half period does not hold."),
                ExactReport(m.Check_RegionLoopClosesInPlane(fm.Face, d, c),
                    "Region loop closes in plane does not hold."),
                ExactReport(m.Check_UvRegionWindingPositive(fm.Face, d, c),
                    "Uv region winding positive does not hold."),
                ExactReport(m.Check_UvHoleWindingNegative(fm.Face, d, c),
                    "Uv hole winding negative does not hold."),
                ExactReport(m.Check_RegionSegmentsSeparated(fm.Face, d, c),
                    "Region segments separated does not hold."),
                ExactReport(m.Check_HoleInsideOuter(fm.Face, d, c),
                    "Hole inside outer does not hold."),
                ExactReport(m.Check_SeamCutCopiesRunOpposite(fm.Face, d, c),
                    "Seam cut copies run opposite does not hold."),
                ExactReport(m.Check_MeshedFaceHasSimpleRegion(fm.Face, d, c),
                    "Meshed face has simple region does not hold."),
                ExactReport(m.Check_TriangulationKeepsBoundary(fm.Face, d, c),
                    "Triangulation keeps boundary does not hold."),
                ExactReport(m.Check_TriangulationAddsOnlyInteriorPoints(fm.Face, d, c),
                    "Triangulation adds only interior points does not hold."),
                ExactReport(m.Check_BoundarySegmentIsElementSide(fm.Face, d, c),
                    "A boundary segment of the region is not the side of exactly one element."),
                ExactReport(m.Check_InteriorSideIsShared(fm.Face, d, c),
                    "An interior element side is not shared by exactly two elements running opposite ways."),
                ExactReport(m.Check_ElementLiftsFacingFaceNormal(fm.Face, d, c),
                    "An element lifts facing away from the face normal."),
                ExactReport(m.Check_RequestsNameFaceEdges(fm.Face, d, c),
                    "A refinement request names an edge the face does not cite."),
                ExactReport(m.Check_EveryPointIsACorner(fm.Face, d, c),
                    "Every point is a corner does not hold."),
                ExactReport(m.Check_ElementAreasSumToRegionArea(fm.Face, d, c),
                    "Element areas sum to region area does not hold."),
                ExactReport(m.Check_LiftKeepsPoints(d, fm, c),
                    "Lift keeps points does not hold."),
                ExactReport(m.Check_DroppedElementsArePoleCollapsed(d, fm, c),
                    "Dropped elements are pole collapsed does not hold."),
                ExactReport(m.Check_CollapsedQuadsBecomeTriangles(d, fm, c),
                    "Collapsed quads become triangles does not hold."),
                ExactReport(m.Check_NoQuadsUnlessPreferred(fm.Face, d, c),
                    "No quads unless preferred does not hold.")]);
        };

    // The checks of layer 5's laws over one face's meshing outcome, in one family.
    FaceMeshOutcomeReport(o: FaceMeshOutcome, family: CheckFamily): Report
        => match (family)
        {
            StructureChecks => MergeAll([
                ExactReport(o.Check_BlockingRequestMeansEmptyMesh,
                    "Blocking request means empty mesh does not hold."),
                ExactReport(o.Check_RequestHasDiagnostic,
                    "Request has diagnostic does not hold."),
                ExactReport(o.Check_EmptyMeshIsExplained,
                    "Empty mesh is explained does not hold.")]);
            GeometryChecks => Report.Empty;
            QualityChecks => Report.Empty;
            OracleChecks => Report.Empty;
            SelfTestChecks => Report.Empty;
        };

    // The checks of layer 6's laws that need only the mesh, its tolerances and
    // the quality thresholds, in one family, with the library's self-tests.
    ModelMeshReport(mesh: ModelMesh, t: Tolerances, th: MeshQualityThresholds, family: CheckFamily): Report
        => match (family)
        {
            StructureChecks => MergeAll([
                ExactReport(mesh.Check_ElementFaceHasOneEntryPerElement,
                    "Element face has one entry per element does not hold."),
                ExactReport(mesh.Check_CornerNormalsHaveOneEntryPerCorner,
                    "Corner normals have one entry per corner does not hold."),
                ExactReport(mesh.Check_CornerUvsHaveOneEntryPerCorner,
                    "Corner uvs have one entry per corner does not hold."),
                ExactReport(mesh.Check_VertexProvenanceHasOneEntryPerVertex,
                    "Vertex provenance has one entry per vertex does not hold."),
                ExactReport(mesh.Check_ElementCornersInRange,
                    "Element corners in range does not hold."),
                ExactReport(mesh.Check_VertexProvenanceMatchesNumbering,
                    "Vertex provenance matches numbering does not hold."),
                ExactReport(mesh.Check_EdgeRunsFollowModelVertices,
                    "Edge runs follow model vertices does not hold."),
                ExactReport(mesh.Check_FaceRunsFollowEdgeRuns,
                    "Face runs follow edge runs does not hold."),
                ExactReport(mesh.Check_EdgeRunHasNonNegativeLength,
                    "Edge run has non negative length does not hold."),
                ExactReport(mesh.Check_FaceRunHasNonNegativeLength,
                    "Face run has non negative length does not hold."),
                ExactReport(mesh.Check_NumberingCoversPositions,
                    "Numbering covers positions does not hold."),
                ExactReport(mesh.Check_ClosedMeshHasNoPinchedVertex,
                    "Closed mesh has no pinched vertex does not hold."),
                ExactReport(mesh.Check_OrientedSurfaceWithBoundaryHasGenus,
                    "A component with boundary has no genus: 2 - chi - B is odd or negative."),
                ExactReport(mesh.Check_ComponentCountIsRootCount,
                    "Component count is root count does not hold."),
                ExactReport(mesh.Check_ComponentParentIsInItsComponent,
                    "Component parent is in its component does not hold."),
                ExactReport(mesh.Check_ComponentParentIsOneShallower,
                    "Component parent is one shallower does not hold."),
                ExactReport(mesh.Check_ComponentParentSharesAVertex,
                    "Component parent shares a vertex does not hold."),
                ExactReport(mesh.Check_ComponentRootHasDepthZero,
                    "Component root has depth zero does not hold."),
                ExactReport(mesh.Check_ComponentsAreNumberedByRoot,
                    "Components are numbered by root does not hold."),
                ExactReport(mesh.Check_ComponentRootIsItsLowestElement,
                    "Component root is its lowest element does not hold."),
                ExactReport(mesh.Check_ClosedOrientedSurfaceHasGenus,
                    "Closed oriented surface has genus does not hold."),
                ExactReport(mesh.Check_ElementHasNoRepeatedCorner,
                    "Element has no repeated corner does not hold."),
                ExactReport(mesh.Check_ElementIsNotFolded,
                    "Element is not folded does not hold."),
                ExactReport(mesh.Check_QuadIsConvex,
                    "Quad is convex does not hold."),
                ExactReport(mesh.Check_TriangleAngleSumIsPi,
                    "Triangle angle sum is pi does not hold."),
                ExactReport(mesh.Check_AngleDefectSumIsTwoPiTimesEuler,
                    "Angle defect sum is two pi times Euler does not hold."),
                ExactReport(mesh.Check_AngleDefectSumIsTwoPiTimesEulerPlusQuadDefects,
                    "Angle defect sum is two pi times Euler plus quad defects does not hold."),
                ExactReport(mesh.Check_ElementIsNotDegenerate(t),
                    "Element is not degenerate does not hold."),
                ExactReport(mesh.Check_VerticesOfOneComponentAreApart(t),
                    "Vertices of one component are apart does not hold.")]);
            GeometryChecks => Report.Empty;
            QualityChecks => MergeAll([
                QualityReport(mesh.Check_TriangleMinAngleMeetsThreshold(th),
                    "Triangle min angle meets threshold does not hold."),
                QualityReport(mesh.Check_TriangleMaxAngleMeetsThreshold(th),
                    "Triangle max angle meets threshold does not hold."),
                QualityReport(mesh.Check_TriangleRadiusRatioMeetsThreshold(th),
                    "Triangle radius ratio meets threshold does not hold."),
                QualityReport(mesh.Check_TriangleAspectRatioMeetsThreshold(th),
                    "Triangle aspect ratio meets threshold does not hold."),
                QualityReport(mesh.Check_QuadSkewMeetsThreshold(th),
                    "Quad skew meets threshold does not hold."),
                QualityReport(mesh.Check_QuadWarpMeetsThreshold(th),
                    "Quad warp meets threshold does not hold."),
                QualityReport(mesh.Check_QuadAngleDefectMeetsThreshold(th),
                    "Quad angle defect meets threshold does not hold."),
                QualityReport(mesh.Check_QuadScaledJacobianMeetsThreshold(th),
                    "Quad scaled jacobian meets threshold does not hold.")]);
            OracleChecks => Report.Empty;
            SelfTestChecks => MergeAll([
                ExactReport(mesh.Check_ReversalPermutesCorners,
                    "Reversal permutes corners does not hold."),
                ExactReport(mesh.Check_ReversalMovesCornerUvWithCorner,
                    "Reversal moves corner uv with corner does not hold."),
                ExactReport(mesh.Check_IndexOfSiteIsInRange,
                    "Index of site is in range does not hold."),
                ExactReport(mesh.Check_SiteAtInvertsIndexOfSite,
                    "Site at inverts index of site does not hold."),
                ExactReport(mesh.Check_IndexOfSiteInvertsSiteAt,
                    "Index of site inverts site at does not hold."),
                ExactReport(mesh.Check_ModelVertexKeepsItsIndex,
                    "Model vertex keeps its index does not hold."),
                ExactReport(mesh.Check_EdgeTableHasOneCountPerEdge,
                    "Edge table has one count per edge does not hold."),
                ExactReport(mesh.Check_EdgeTableHasOneDirectionSumPerEdge,
                    "Edge table has one direction sum per edge does not hold."),
                ExactReport(mesh.Check_EdgeTableEdgeIsCanonical,
                    "Edge table edge is canonical does not hold."),
                ExactReport(mesh.Check_EdgeTableIsStrictlySorted,
                    "Edge table is strictly sorted does not hold."),
                ExactReport(mesh.Check_EdgeTableListsOnlyUsedEdges,
                    "Edge table lists only used edges does not hold."),
                ExactReport(mesh.Check_EdgeTableCountsEveryProperSide,
                    "Edge table counts every proper side does not hold."),
                ExactReport(mesh.Check_EdgeTableListsEveryProperSide,
                    "Edge table lists every proper side does not hold."),
                ExactReport(mesh.Check_EdgeTableCountMatchesItsSides,
                    "Edge table count matches its sides does not hold."),
                ExactReport(mesh.Check_EdgeTableDirectionSumMatchesItsSides,
                    "Edge table direction sum matches its sides does not hold."),
                ExactReport(mesh.Check_DirectionSumIsBoundedByCount,
                    "Direction sum is bounded by count does not hold."),
                ExactReport(mesh.Check_DirectionSumHasTheParityOfCount,
                    "Direction sum has the parity of count does not hold."),
                ExactReport(mesh.Check_ReversalNegatesEveryDirectionSum,
                    "Reversal negates every direction sum does not hold."),
                ExactReport(mesh.Check_ClosedMeansEveryEdgeHasTwoSides,
                    "Closed means every edge has two sides does not hold."),
                ExactReport(mesh.Check_ManifoldMeansNoEdgeHasMoreThanTwoSides,
                    "Manifold means no edge has more than two sides does not hold."),
                ExactReport(mesh.Check_OrientedExactlyWhenNoEdgeIsMisoriented,
                    "Oriented exactly when no edge is misoriented does not hold."),
                ExactReport(mesh.Check_ElementCornersShareItsComponent,
                    "Element corners share its component does not hold."),
                ExactReport(mesh.Check_ComponentEulerCharacteristicsAddUp,
                    "Component Euler characteristics add up does not hold."),
                ExactReport(mesh.Check_EulerIsTwoMinusTwiceGenusMinusBoundaryCycles,
                    "Euler is two minus twice genus minus boundary cycles does not hold."),
                ExactReport(mesh.Check_VectorAreaVanishes,
                    "A component's vector area does not vanish within its rounding bound."),
                ExactReport(mesh.Check_RestrictionKeepsTheElementsOfTheFaces,
                    "Restriction keeps the elements of the faces does not hold."),
                ExactReport(mesh.Check_RestrictionKeepsEachElementFace,
                    "Restriction keeps each element face does not hold."),
                ExactReport(mesh.Check_RestrictionKeepsEachCorner,
                    "Restriction keeps each corner does not hold."),
                ExactReport(mesh.Check_RestrictionToEveryFaceKeepsTheEulerCharacteristic,
                    "Restriction to every face keeps the Euler characteristic does not hold."),
                ExactReport(mesh.Check_ClosedComponentEulerIsTwoMinusTwiceGenus,
                    "Closed component Euler is two minus twice genus does not hold."),
                ExactReport(mesh.Check_ReversalNegatesSignedVolume,
                    "Reversal negates signed volume does not hold."),
                ExactReport(ModelMesh.Check_OutwardTetrahedronHasPositiveVolume,
                    "Outward tetrahedron has positive volume does not hold."),
                ExactReport(mesh.Check_QuadAngleDefectIsNotNegative,
                    "Quad angle defect is not negative does not hold."),
                ExactReport(mesh.Check_ReportedPairIsCoincident(t),
                    "Reported pair is coincident does not hold."),
                ExactReport(mesh.Check_CoincidentPairIsReported(t),
                    "Coincident pair is reported does not hold."),
                ExactReport(mesh.Check_RadiusRatioIsAtLeastOne,
                    "Radius ratio is at least one does not hold."),
                ExactReport(mesh.Check_AspectRatioIsAtLeastOne,
                    "Aspect ratio is at least one does not hold."),
                ExactReport(ModelMesh.Check_EquilateralTriangleHasUnitRadiusRatio,
                    "Equilateral triangle has unit radius ratio does not hold."),
                ExactReport(ModelMesh.Check_EquilateralTriangleHasUnitAspectRatio,
                    "Equilateral triangle has unit aspect ratio does not hold."),
                ExactReport(ModelMesh.Check_UnitSquareHasZeroSkew,
                    "Unit square has zero skew does not hold."),
                ExactReport(ModelMesh.Check_UnitSquareHasUnitScaledJacobian,
                    "Unit square has unit scaled jacobian does not hold."),
                ExactReport(ModelMesh.Check_DartQuadIsNotConvex,
                    "Dart quad is not convex does not hold."),
                ExactReport(mesh.Check_TriangleMeshKeepsPositions,
                    "Triangle mesh keeps positions does not hold."),
                ExactReport(mesh.Check_TriangleMeshSplitsEachQuadInTwo,
                    "Triangle mesh splits each quad in two does not hold."),
                ExactReport(mesh.Check_TriangulatedCornerNamesTheTriangleCorner,
                    "Triangulated corner names the triangle corner does not hold."),
                ExactReport(mesh.Check_TriangleMeshKeepsArea,
                    "Triangle mesh keeps area does not hold."),
                ExactReport(mesh.Check_QuadMeshIsOkExactlyWithoutTriangles,
                    "Quad mesh is ok exactly without triangles does not hold."),
                ExactReport(mesh.Check_QuadMeshKeepsPositions,
                    "Quad mesh keeps positions does not hold."),
                ExactReport(mesh.Check_QuadMeshKeepsAreaWhenOk,
                    "Quad mesh keeps area when ok does not hold."),
                ExactReport(mesh.Check_PolygonMeshKeepsPositions,
                    "Polygon mesh keeps positions does not hold."),
                ExactReport(mesh.Check_PolygonMeshHasOneFacePerElement,
                    "Polygon mesh has one face per element does not hold."),
                ExactReport(mesh.Check_PolygonMeshKeepsArea,
                    "Polygon mesh keeps area does not hold."),
                ExactReport(mesh.Check_SplitHasAtLeastAsManyVertices,
                    "Split has at least as many vertices does not hold."),
                ExactReport(mesh.Check_SplitSplitsEachQuadInTwo,
                    "Split splits each quad in two does not hold."),
                ExactReport(mesh.Check_SplitHasOneNormalPerVertex,
                    "Split has one normal per vertex does not hold."),
                ExactReport(mesh.Check_SplitHasOneUvPerVertex,
                    "Split has one uv per vertex does not hold."),
                ExactReport(mesh.Check_SplitHasOneSourcePerVertex,
                    "Split has one source per vertex does not hold."),
                ExactReport(mesh.Check_SplitVertexKeepsItsSourcePosition,
                    "Split vertex keeps its source position does not hold."),
                ExactReport(mesh.Check_SplitFollowsTheTriangulation,
                    "Split follows the triangulation does not hold."),
                ExactReport(mesh.Check_SplitVertexCarriesItsCornerNormal,
                    "Split vertex carries its corner normal does not hold."),
                ExactReport(mesh.Check_SplitVertexCarriesItsCornerUv,
                    "Split vertex carries its corner uv does not hold."),
                ExactReport(mesh.Check_SplitVerticesDiffer,
                    "Split vertices differ does not hold.")]);
        };

    // The checks of layer 6's laws that compare a mesh with the model it came
    // from, in one family.
    MeshAgainstModelReport(m: BrepModel, mesh: ModelMesh, family: CheckFamily): Report
        => match (family)
        {
            StructureChecks => MergeAll([
                ExactReport(m.Check_CornerProvenanceIsOnItsElementFace(mesh),
                    "A corner's provenance is not on its element's face, an edge it cites, or a vertex of its bounds."),
                ExactReport(m.Check_ElementFaceIsModelFace(mesh),
                    "Element face is model face does not hold."),
                ExactReport(m.Check_NumberingHasOneEdgeRunPerEdge(mesh),
                    "Numbering has one edge run per edge does not hold."),
                ExactReport(m.Check_NumberingHasOneFaceRunPerFace(mesh),
                    "Numbering has one face run per face does not hold."),
                ExactReport(m.Check_NumberingCountsEveryModelVertex(mesh),
                    "Numbering counts every model vertex does not hold.")]);
            GeometryChecks => Report.Empty;
            QualityChecks => Report.Empty;
            OracleChecks => Report.Empty;
            SelfTestChecks => Report.Empty;
        };

    // The checks of layer 6's laws over the assembly's inputs, the face meshes
    // and the vertex numbering, in one family.
    AssemblyReport(m: BrepModel, d: EdgeDiscretizations, faceMeshes: Array<FaceMesh>, n: MeshVertexNumbering, family: CheckFamily): Report
        => match (family)
        {
            StructureChecks => MergeAll([
                ExactReport(faceMeshes.Check_FaceMeshesAgreeOnSharedSites,
                    "Face meshes agree on shared sites does not hold."),
                ExactReport(m.Check_FaceMeshModelVertexIsModelPoint(faceMeshes),
                    "Face mesh model vertex is model point does not hold."),
                ExactReport(n.Check_FaceMeshPointHasNumberedSite(faceMeshes),
                    "Face mesh point has numbered site does not hold."),
                ExactReport(faceMeshes.Check_FaceMeshSourceAgreesWithProvenance,
                    "Face mesh source agrees with provenance does not hold."),
                ExactReport(n.Check_SeamCopiesShareOneGlobalVertex(faceMeshes),
                    "Seam copies share one global vertex does not hold."),
                ExactReport(n.Check_DistinctLocalVerticesHaveDistinctGlobalVertices(faceMeshes),
                    "Distinct local vertices have distinct global vertices does not hold.")]);
            GeometryChecks => Report.Empty;
            QualityChecks => Report.Empty;
            OracleChecks => Report.Empty;
            SelfTestChecks => MergeAll([
                ExactReport(m.Check_AssemblyKeepsTheNumbering(faceMeshes, n),
                    "Assembly keeps the numbering does not hold."),
                ExactReport(m.Check_AssemblyKeepsEveryTriangle(faceMeshes, n),
                    "Assembly keeps every triangle does not hold."),
                ExactReport(m.Check_AssemblyKeepsEveryQuad(faceMeshes, n),
                    "Assembly keeps every quad does not hold."),
                ExactReport(m.Check_AssembledModelVertexIsModelPoint(faceMeshes, n),
                    "Assembled model vertex is model point does not hold."),
                ExactReport(m.Check_AssembledPositionIsFaceMeshPosition(faceMeshes, n),
                    "Assembled position is face mesh position does not hold."),
                ExactReport(m.Check_AssembledCornerIsGlobalVertexOfFaceMeshCorner(faceMeshes, n),
                    "Assembled corner is global vertex of face mesh corner does not hold."),
                ExactReport(m.Check_AssembledElementRemembersItsFace(faceMeshes, n),
                    "Assembled element remembers its face does not hold."),
                ExactReport(m.Check_AssembledCornerUvIsCopied(faceMeshes, n),
                    "Assembled corner uv is copied does not hold."),
                ExactReport(m.Check_AssembledCornerNormalIsCopied(faceMeshes, n),
                    "Assembled corner normal is copied does not hold."),
                ExactReport(m.Check_AssembledSharedBoundaryCornersCoincide(faceMeshes, n),
                    "Assembled shared boundary corners coincide does not hold."),
                ExactReport(m.Check_NumberingCountsCitedEdgeInteriors(d, faceMeshes),
                    "Numbering counts cited edge interiors does not hold."),
                ExactReport(n.Check_SharedBoundarySampleHasOneGlobalVertex(faceMeshes),
                    "Shared boundary sample has one global vertex does not hold."),
                ExactReport(m.Check_AreaIsSumOfFaceMeshAreas(faceMeshes, n),
                    "Area is sum of face mesh areas does not hold.")]);
        };

    // The checks of layer 3's laws over one Part 21 file, in one family; the
    // structure family includes every WHERE rule (WhereRulesReport).
    StepFileReport(f: Part21File, family: CheckFamily): Report
        => match (family)
        {
            StructureChecks => MergeAll([
                ExactReport(f.Check_InstanceIdsPositive,
                    "Instance ids positive does not hold."),
                ExactReport(f.Check_InstanceIdsAscending,
                    "Instance ids ascending does not hold."),
                ExactReport(f.Check_InstanceIdsUnique,
                    "Instance ids unique does not hold."),
                ExactReport(f.Check_InstancePositionIsExact,
                    "Instance position is exact does not hold."),
                ExactReport(f.Check_RecordIndicesInRange,
                    "Record indices in range does not hold."),
                ExactReport(f.Check_ChildrenPrecedeParent,
                    "Children precede parent does not hold."),
                WarningReport(f.Check_ReferencesResolve,
                    "References resolve does not hold."),
                WarningReport(f.Check_HeaderNamesASchema,
                    "Header names a schema does not hold."),
                ExactReport(f.Check_AttributeCountMatchesSchema,
                    "Attribute count matches schema does not hold."),
                ExactReport(f.Check_AttributeKindsMatchSchema,
                    "Attribute kinds match schema does not hold."),
                ExactReport(f.Check_AggregateBoundsHold,
                    "Aggregate bounds hold does not hold."),
                ExactReport(f.Check_DefinedTypeRulesHold,
                    "Defined type rules hold does not hold."),
                f.WhereRulesReport]);
            GeometryChecks => Report.Empty;
            QualityChecks => QualityReport(f.Check_ComplexPartsInStandardOrder,
                    "Complex parts in standard order does not hold.");
            OracleChecks => Report.Empty;
            SelfTestChecks => MergeAll([
                ExactReport(f.Check_DecodedMagnitudesAreTheModels,
                    "The decode's exported model size or coordinate extent is not the model's."),
                ExactReport(f.Check_DecodedToleranceResolvable,
                    "The decoded length tolerance is below the resolution at the coordinate extent."),
                ExactReport(f.Check_ParameterFloorsFollowLength,
                    "The decoded parameter floors are not layer 0's functions of the length tolerance."),
                ExactReport(f.Check_ClosureMarksAreTheDecisions,
                    "The decoded closure marks are not the closures the tolerances decide."),
                ExactReport(f.Check_CurveClosureDecidedByEnds,
                    "A decoded curve's closure disagrees with its ends."),
                ExactReport(f.Check_SurfaceClosureDecidedBySides,
                    "A decoded surface's closure disagrees with its sides."),
                ExactReport(f.Check_MirrorFoldRecordedOnce,
                    "A face of a mirrored occurrence has no fold record, or more than one."),
                ExactReport(f.Check_LeftHandedSurfacesAreFolded,
                    "A face on a left-handed surface was not folded."),
                ExactReport(f.Check_DecodeIsTotal,
                    "Decode is total does not hold."),
                ExactReport(f.Check_DecodedTolerancesWellFormed,
                    "Decoded tolerances well formed does not hold."),
                ExactReport(f.Check_RepairsAreDiagnosed,
                    "Repairs are diagnosed does not hold."),
                ExactReport(f.Check_ProvenanceCoversModel,
                    "Provenance covers model does not hold."),
                ExactReport(f.Check_ProvenanceSourcesDistinct,
                    "Provenance sources distinct does not hold."),
                ExactReport(f.Check_ProvenanceLookupInvertsSources,
                    "Provenance lookup inverts sources does not hold."),
                ExactReport(f.Check_SourceKindMatchesTable,
                    "Source kind matches table does not hold."),
                ExactReport(f.Check_RepairedSourcesAreUnmapped,
                    "Repaired sources are unmapped does not hold."),
                ExactReport(f.Check_ReachedInstancesAreAccountedFor,
                    "Reached instances are accounted for does not hold."),
                ExactReport(f.Check_VertexCountMatchesInstances,
                    "Vertex count matches instances does not hold."),
                ExactReport(f.Check_EdgeCountMatchesInstances,
                    "Edge count matches instances does not hold."),
                ExactReport(f.Check_LoopCountMatchesInstances,
                    "Loop count matches instances does not hold."),
                ExactReport(f.Check_FaceCountMatchesInstances,
                    "Face count matches instances does not hold."),
                ExactReport(f.Check_ShellCountMatchesInstances,
                    "Shell count matches instances does not hold."),
                ExactReport(f.Check_BodyCountMatchesInstances,
                    "Body count matches instances does not hold."),
                ExactReport(f.Check_CurveCountMatchesInstances,
                    "Curve count matches instances does not hold."),
                ExactReport(f.Check_PcurveCountMatchesInstances,
                    "Pcurve count matches instances does not hold."),
                ExactReport(f.Check_SurfaceCountMatchesInstances,
                    "Surface count matches instances does not hold."),
                ExactReport(f.Check_CirclePeriodIsTwoPi,
                    "Circle period is two pi does not hold."),
                ExactReport(f.Check_AngleUnitIsReported,
                    "Angle unit is reported does not hold."),
                ExactReport(f.Check_UncertaintyDefaultExactlyWhenAbsent,
                    "Uncertainty default exactly when absent does not hold."),
                ExactReport(f.Check_ToleranceCoversStatedUncertainties,
                    "Tolerance covers stated uncertainties does not hold."),
                ExactReport(f.Check_ModelUnitIsRootUnit,
                    "Model unit is root unit does not hold."),
                ExactReport(f.Check_EdgeSenseCopied,
                    "Edge sense copied does not hold."),
                ExactReport(f.Check_PcurvesComeFromPcurveInstances,
                    "Pcurves come from pcurve instances does not hold."),
                ExactReport(f.Check_DeclaredClosedCopied,
                    "Declared closed copied does not hold."),
                ExactReport(f.Check_OuterFlagClearedWhenDoubled,
                    "Outer flag cleared when doubled does not hold."),
                ExactReport(f.Check_OuterFlagCopiedWhenSingle,
                    "Outer flag copied when single does not hold."),
                ExactReport(f.Check_MergedVerticesCoincide,
                    "Merged vertices coincide does not hold."),
                ExactReport(f.Check_FoldPreservesInteriorSide,
                    "Fold preserves interior side does not hold."),
                ExactReport(f.Check_FoldFlipsExactlyRecorded,
                    "Fold flips exactly recorded does not hold."),
                ExactReport(f.Check_FoldRecordsNameFalseFlags,
                    "Fold records name false flags does not hold."),
                ExactReport(Part21File.Check_SchemaNamesUnique,
                    "Schema names unique does not hold."),
                ExactReport(Part21File.Check_SchemaShortNamesUnique,
                    "Schema short names unique does not hold."),
                ExactReport(Part21File.Check_SchemaShortNameIsNoOtherLongName,
                    "Schema short name is no other long name does not hold."),
                ExactReport(Part21File.Check_SchemaSupertypesPrecede,
                    "Schema supertypes precede does not hold."),
                ExactReport(Part21File.Check_SchemaDerivesAreInherited,
                    "Schema derives are inherited does not hold."),
                ExactReport(f.Check_ParsePrintParseIsIdentity,
                    "Parse print parse is identity does not hold."),
                ExactReport(f.Check_ParseOkIffNoError,
                    "Parse ok iff no error does not hold.")]);
        };
}

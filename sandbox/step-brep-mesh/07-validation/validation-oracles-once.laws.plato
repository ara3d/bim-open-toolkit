//==
// # The Green oracle computed once per face: laws (complexity sweep, chunk L5)
//
// The work claim and exact count of GreenAreaPair (green-once.library.plato), the agreement of
// every replacement with the original it replaces on layer 07's ten witnesses and on the meshed
// witnesses, and the Green and divergence laws of BrepCheckingLaws, BrepWitnessesLaws and
// BsplineOraclesLaws restated with the witness and its GreenEstimate bound once (the originals
// built the witness model and the boundary again for the value and for the allowance). At merge
// each Law_<X> replaces Law_<X> (TRACK.md).
//
// Sections, in order:
//  - Work
//  - Agreement
//  - Oracles against the closed forms
//  - Witness facts and the B-spline top

library BrepOraclesOnceLaws
{
    //==
    // # Work

    // The curve evaluations and projections GreenAreaPairCounted makes on face 0 of the unit box
    // (four line coedges) at size / 8 chords per coedge, so its fine boundary has size chords.
    GreenPairEvaluationsAt(size: Integer): WorkBudget
        => WorkBudgetOf(BrepModel.Witness_UnitBox.GreenAreaPairCounted(BrepFaceIndex(0), BrepModel.Witness_UnitBox.GreenModelOk, size / 8).Work.Evaluations, 0, 0, 0);

    // GreenAreaPair evaluates each boundary point once and projects it once: on a four-edge face
    // 24 k + 16 Evaluations at k chords per coedge, at most 4 per chord of the fine boundary
    // (8 k chords), at 32 and 128 chords.
    Witness_GreenAreaPairWork(_: WorkClaim): WorkClaim
        => WorkClaim("GreenAreaPair: curve evaluations and projections per fine boundary chord", Evaluations(4), [32, 128], n => GreenPairEvaluationsAt(n));

    // GreenAreaPair builds two boundaries on every face of the analytic witnesses: the coarse and
    // the fine (the original oracle with its allowance and tolerance built five to seven).
    Law_GreenAreaPairBuildsTwoBoundaries(_: Integer): Boolean
        => Integer.AnalyticWitnesses.All(k => BrepModel.WitnessAt(k).GreenPairBuildsTwoPerFace);

    // Every face of m: two boundary builds when the oracle can run, none otherwise.
    GreenPairBuildsTwoPerFace(m: BrepModel): Boolean
        => m.Faces.Count.Range.All(f =>
            m.GreenAreaPairCounted(BrepFaceIndex(f), m.GreenModelOk, Integer.GreenChords).Work.Flips
                == (m.CanGreen(BrepFaceIndex(f)) ? 2 : 0));

    //==
    // # Agreement
    //
    // Over the nine witnesses of WitnessAt whose faces have closed-form potentials; the B-spline
    // patch solid (index 7) has its own law, since the original oracle's quadrature on its top
    // takes seconds per face compiled.

    // The indices of WitnessAt other than the B-spline patch solid.
    AnalyticWitnesses(_: Integer): Array<Integer>
        => [0, 1, 2, 3, 4, 5, 6, 8, 9];

    //==
    // # Oracles against the closed forms
    //
    // BrepCheckingLaws' laws of the same names, the witness built once and its estimate once.

    // Face f of m has its Green area within its allowance of exact.
    GreenAreaWithin(m: BrepModel, f: BrepFaceIndex, exact: Number): Boolean
        => m.GreenAreaPair(f).GreenEstimateWithin(exact);

    // The estimate's area is within its allowance of exact.
    GreenEstimateWithin(e: GreenEstimate, exact: Number): Boolean
        => (e.RichardsonOf - exact).Abs <= e.GreenAllowanceOf;

    // The estimate's volume is within its divergence allowance of exact.
    DivergenceEstimateWithin(e: GreenEstimate, exact: Number): Boolean
        => (e.RichardsonOf - exact).Abs <= e.DivergenceAllowanceOf;

    Law_GreenEqualsCylinderPatchArea(r: Number, h: Number): Boolean
        => (r > 0.0 && h > 0.0 && r.IsFinite && h.IsFinite)
            ? BrepModel.Witness_Cylinder(r, h, Angle(Number.Tau)).GreenAreaWithin(BrepFaceIndex(0), Oracle_CylinderPatchArea(r, Angle(Number.Tau), h))
            : true;

    Law_GreenEqualsCylinderSectorPatchArea(r: Number, h: Number, sweep: Number): Boolean
        => (r > 0.0 && h > 0.0 && sweep > 0.0 && sweep < Number.Tau && r.IsFinite && h.IsFinite)
            ? BrepModel.Witness_Cylinder(r, h, Angle(sweep)).GreenAreaWithin(BrepFaceIndex(2), Oracle_CylinderPatchArea(r, Angle(sweep), h))
            : true;

    Law_GreenEqualsSphereArea(r: Number): Boolean
        => (r > 0.0 && r.IsFinite)
            ? BrepModel.Witness_Sphere(r).GreenAreaWithin(BrepFaceIndex(0), Oracle_SphereArea(r))
            : true;

    Law_GreenEqualsSphereAreaByPoleLoops(r: Number): Boolean
        => (r > 0.0 && r.IsFinite)
            ? BrepModel.Witness_SphereByPoleLoops(r).GreenAreaWithin(BrepFaceIndex(0), Oracle_SphereArea(r))
            : true;

    Law_GreenEqualsTorusArea(major: Number, minor: Number): Boolean
        => (minor > 0.0 && major > minor && major.IsFinite)
            ? BrepModel.Witness_Torus(major, minor).GreenAreaWithin(BrepFaceIndex(0), Oracle_TorusArea(major, minor))
            : true;

    Law_DivergenceEqualsTorusVolume(major: Number, minor: Number): Boolean
        => (minor > 0.0 && major > minor && major.IsFinite)
            ? BrepModel.Witness_Torus(major, minor).ShellVolumePair(ShellIndex(0)).DivergenceEstimateWithin(Number.Pi * Number.Tau * major * minor * minor)
            : true;

    Law_GreenEqualsConePatchArea(r: Number, h: Number): Boolean
        => (r > 0.0 && h > 0.0 && r.IsFinite && h.IsFinite)
            ? BrepModel.Witness_Cone(r, h).GreenAreaWithin(BrepFaceIndex(0), Oracle_ConePatchArea(r, (r / h).Atan, Angle(Number.Tau), 0.0 - h, 0.0))
            : true;

    Law_GreenEqualsBoxFaceArea(w: Number, d: Number, h: Number, k: Integer): Boolean
        => (w > 0.0 && d > 0.0 && h > 0.0 && w.IsFinite && d.IsFinite && h.IsFinite && k >= 0 && k < 6)
            ? BrepModel.Witness_Box(w, d, h).GreenAreaWithin(BrepFaceIndex(k), BoxFacts(w, d, h).FaceAreas[k])
            : true;

    Law_GreenDiskAreaWithinArcResidual(r: Number): Boolean
        => (r > 0.0 && r.IsFinite)
            ? (BrepModel.Witness_Cone(r, 1.0).Oracle_FaceAreaByGreenOnce(BrepFaceIndex(1)) - Number.Pi * r * r).Abs
                <= ArcResidual(r, Number.Tau, Integer.GreenChords) + ResolutionAt(Number.Pi * r * r * 256.0).Value
            : true;

    // Law_PlanarFaceAreaMatchesGreen with the planar area once and the Green estimate once.
    Law_PlanarFaceAreaMatchesGreen(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.PlanarAreaMatchesGreen(f, m.Oracle_PlanarFaceArea(f));

    // The planar area of face f matches its Green area, where both are finite.
    PlanarAreaMatchesGreen(m: BrepModel, f: BrepFaceIndex, planar: Number): Boolean
        => planar.IsFinite ? m.GreenAreaPair(f).GreenMatchesWhereFinite(planar) : true;

    // The estimate's area is within its allowance of exact, where it has a number.
    GreenMatchesWhereFinite(e: GreenEstimate, exact: Number): Boolean
        => e.RichardsonOf.IsFinite ? e.GreenEstimateWithin(exact) : true;

    //==
    // # Witness facts and the B-spline top
    //
    // BrepWitnessesLaws' and BsplineOraclesLaws' laws of the same names, the facts and the
    // estimate bound once.

    Law_WitnessGreenAreaMatchesFacts(k: Integer, f: Integer): Boolean
        => k.WitnessGreenAreaMatches(f, WitnessFacts.FactsAt(k).FaceAreas);

    // Face f of witness k has its stated area, where areas states a finite one.
    WitnessGreenAreaMatches(k: Integer, f: Integer, areas: Array<Number>): Boolean
        => (areas.IsValidIndex(f) ? areas[f].IsFinite : false)
            ? BrepModel.WitnessAt(k).GreenAreaWithin(BrepFaceIndex(f), areas[f])
            : true;

    Law_WitnessDivergenceVolumeMatchesFacts(k: Integer, s: Integer): Boolean
        => k.WitnessDivergenceVolumeMatches(s, WitnessFacts.FactsAt(k).ShellVolumes);

    // Shell s of witness k has its stated volume, where volumes states one and the oracle has a
    // number.
    WitnessDivergenceVolumeMatches(k: Integer, s: Integer, volumes: Array<Number>): Boolean
        => volumes.IsValidIndex(s)
            ? BrepModel.WitnessAt(k).ShellVolumePair(ShellIndex(s)).DivergenceMatchesWhereFinite(volumes[s])
            : true;

    // The estimate's volume is within its allowance of exact, where it has a number.
    DivergenceMatchesWhereFinite(e: GreenEstimate, exact: Number): Boolean
        => e.RichardsonOf.IsFinite ? e.DivergenceEstimateWithin(exact) : true;

    // Law_BSplineTopAreaInBracket with the witness built once and its top's estimate once.
    Law_BSplineTopAreaInBracket(bump: Number): Boolean
        => (bump > 0.0 && bump < 1.0)
            ? BrepModel.Witness_BSplinePatchSolid(bump).GreenAreaPair(BrepFaceIndex(1)).IsInBumpBracket(bump)
            : true;

    // The estimate's area lies in [1, 1 + 16 bump^2 / 45], widened by its allowance.
    IsInBumpBracket(e: GreenEstimate, bump: Number): Boolean
        => e.RichardsonOf >= 1.0 - e.GreenAllowanceOf
            && e.RichardsonOf <= 1.0 + 16.0 * bump * bump / 45.0 + e.GreenAllowanceOf;

}

//==
// # Euler-Poincare over the closed manifold witnesses (F5)
//
// Layer 2's Law_EulerPoincareEvenAndBounded(m, s) takes any model and any shell index, so the law
// runner draws its shell from random integers and its premise (a shell in range, declared closed,
// every vertex link one cycle) held on 1 of 25 sampled cases after 0eb11cd2 gave it that premise.
// The cases here are layer 7's witness models whose shells are closed manifolds, every shell of
// each: one shell each but the hollow box (an outer shell and a void), genus 0 but the block with a
// through hole (genus 1, chi 0) and the tori (genus 1). A law states that the premise holds on
// every shell, so the cases stay real, and the law states Euler-Poincare on each.
//
// Sections, in order:
//  - Cases
//  - Laws

library EulerPoincareWitnessLaws
{
    //==
    // # Cases

    Witness_UnitBoxShells(_: ManifoldShellCase): ManifoldShellCase
        => ManifoldShellCase("UnitBox", BrepModel.Witness_UnitBox);
    Witness_UnitBoxMillimetresShells(_: ManifoldShellCase): ManifoldShellCase
        => ManifoldShellCase("UnitBoxMillimetres", BrepModel.Witness_UnitBoxMillimetres);
    Witness_CylinderShells(_: ManifoldShellCase): ManifoldShellCase
        => ManifoldShellCase("Cylinder", BrepModel.Witness_Cylinder);
    Witness_SphereShells(_: ManifoldShellCase): ManifoldShellCase
        => ManifoldShellCase("Sphere", BrepModel.Witness_Sphere);
    Witness_TorusShells(_: ManifoldShellCase): ManifoldShellCase
        => ManifoldShellCase("Torus", BrepModel.Witness_Torus);
    Witness_ConeShells(_: ManifoldShellCase): ManifoldShellCase
        => ManifoldShellCase("Cone", BrepModel.Witness_Cone);
    Witness_BlockWithThroughHoleShells(_: ManifoldShellCase): ManifoldShellCase
        => ManifoldShellCase("BlockWithThroughHole", BrepModel.Witness_BlockWithThroughHole);
    Witness_HollowBoxShells(_: ManifoldShellCase): ManifoldShellCase
        => ManifoldShellCase("HollowBox", BrepModel.Witness_HollowBox);
    Witness_BSplinePatchSolidShells(_: ManifoldShellCase): ManifoldShellCase
        => ManifoldShellCase("BSplinePatchSolid", BrepModel.Witness_BSplinePatchSolid);
    Witness_QuarterCylinderShells(_: ManifoldShellCase): ManifoldShellCase
        => ManifoldShellCase("QuarterCylinder", BrepModel.WitnessAt(8));
    Witness_SphereByPoleLoopsShells(_: ManifoldShellCase): ManifoldShellCase
        => ManifoldShellCase("SphereByPoleLoops", BrepModel.Witness_SphereByPoleLoops(1.0));
    Witness_HemispheresShells(_: ManifoldShellCase): ManifoldShellCase
        => ManifoldShellCase("Hemispheres", BrepModel.Witness_Hemispheres(1.0));
    Witness_TorusAtVertexShells(_: ManifoldShellCase): ManifoldShellCase
        => ManifoldShellCase("TorusAtVertex", BrepModel.Witness_TorusAtVertex(2.0, 0.5));

    // The names of the cases above.
    ManifoldShellCaseNames(_: ManifoldShellCase): Array<String>
        => ["UnitBox", "UnitBoxMillimetres", "Cylinder", "Sphere", "Torus", "Cone", "BlockWithThroughHole",
            "HollowBox", "BSplinePatchSolid", "QuarterCylinder", "SphereByPoleLoops", "Hemispheres", "TorusAtVertex"];

    // Whether case w is one of the witnesses above, by name. The law runner also draws cases at
    // random (any model, any name); the others hold vacuously.
    IsManifoldShellCase(w: ManifoldShellCase): Boolean
        => ManifoldShellCase.ManifoldShellCaseNames.Any(n => n == w.Name);

    //==
    // # Laws

    // Every shell of a case satisfies Law_EulerPoincareEvenAndBounded's premise: declared closed,
    // every vertex link one cycle. Keeps the next law's cases real.
    Law_EulerPoincarePremiseHoldsOnWitnesses(w: ManifoldShellCase): Boolean
        => w.IsManifoldShellCase
            ? w.Model.Shells.Count.Range.All(s => w.Model.Premise_EulerPoincareEvenAndBounded(ShellIndex(s)))
            : true;

    // Law_EulerPoincareEvenAndBounded on every shell of every case.
    Law_EulerPoincareEvenAndBoundedOnWitnesses(w: ManifoldShellCase): Boolean
        => w.IsManifoldShellCase
            ? w.Model.Shells.Count.Range.All(s => Law_EulerPoincareEvenAndBounded(w.Model, ShellIndex(s)))
            : true;
}

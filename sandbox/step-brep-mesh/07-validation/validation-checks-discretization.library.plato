//==
// # BrepCheckingDiscretization
//
// Layer 7 of the STEP B-rep to mesh design (README.md beside this file): one
// Check_ per law of 04-discretization, each the law evaluated over every
// entry of a model's EdgeDiscretizations and, where the law is about one
// point, segment, seed, or image, over every one of them (an index past an
// entry's end makes the law vacuous, so the grids run to the largest count of
// any entry). Model laws use the criteria the polylines were made under;
// library laws are self-tests on the entries in hand. Where layer 4 exports
// the measure a criterion compares (SampledSagitta, TangentDeviation,
// TurningAngle, SegmentLength, ImageChordDeviations) the check
// folds it with CheckWithin against the criterion widened as the law widens
// it, and a segment the refinement floor stopped measures 0, the law's
// exemption; so a failure is a Warning below ten times the bound and an Error
// above. Every comment names the Law_, its family, and its severity rule.
//
// Sections, in order:
//  - Shape (structure)
//  - Agreement with the model (structure)
//  - Criteria (geometry)
//  - Counts (structure)
//  - Parameter-space images (structure and geometry)
//  - Reversal, sharing and refinement (self-tests)
//  - Helpers and measures

library BrepCheckingDiscretization
{
    //==
    // # Shape (structure)

    // Law_ParameterCountEqualsPointCount at every entry. Structure: Error.
    Check_ParameterCountEqualsPointCount(d: EdgeDiscretizations): Check
        => d.CheckEntries("Law_ParameterCountEqualsPointCount", x => ParameterCountEqualsPointCount(x));

    // Law_EmptyOrAtLeastTwoParameters at every entry. Structure: Error.
    Check_EmptyOrAtLeastTwoParameters(d: EdgeDiscretizations): Check
        => d.CheckEntries("Law_EmptyOrAtLeastTwoParameters", x => EmptyOrAtLeastTwoParameters(x));

    // Law_UndiscretizedExactlyWhenUnusable at every entry, under the
    // criteria the entries were made for. Structure: Error.
    Check_UndiscretizedExactlyWhenUnusable(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria): Check
        => CheckAll("Law_UndiscretizedExactlyWhenUnusable", d.ByEdge.Count,
            i => UndiscretizedExactlyWhenUnusable(m, d, c, i), i => AtEdge(i));

    // Law_ParametersStrictlyMonotone at every entry and parameter. Structure:
    // Error.
    Check_ParametersStrictlyMonotone(d: EdgeDiscretizations): Check
        => d.CheckEntryPoints("Law_ParametersStrictlyMonotone", (x, i) => Law_ParametersStrictlyMonotone(x, i));

    // Law_ParametersStrictlyIncreasing at every entry and parameter: entries
    // are canonical. Structure: Error.
    Check_ParametersStrictlyIncreasing(d: EdgeDiscretizations): Check
        => d.CheckEntryPoints("Law_ParametersStrictlyIncreasing", (x, i) => ParametersStrictlyIncreasing(x, i));

    //==
    // # Agreement with the model (structure)

    // Law_LowestParameterIsDomainStart at every entry. Structure (exact,
    // copied): Error.
    Check_LowestParameterIsDomainStart(m: BrepModel, d: EdgeDiscretizations): Check
        => d.CheckEntries("Law_LowestParameterIsDomainStart", x => LowestParameterIsDomainStart(m, x));

    // Law_HighestParameterIsDomainEnd at every entry. Structure: Error.
    Check_HighestParameterIsDomainEnd(m: BrepModel, d: EdgeDiscretizations): Check
        => d.CheckEntries("Law_HighestParameterIsDomainEnd", x => HighestParameterIsDomainEnd(m, x));

    // Law_PointsLieOnCurve at every entry and point, measured by the distance
    // from the point to the curve at its parameter against
    // Tolerances.Length. Layer 4 grades it structure: Error at any excess,
    // with the distance as the diagnostic's measure.
    Check_PointsLieOnCurve(m: BrepModel, d: EdgeDiscretizations): Check
        => CheckGridWithin("Law_PointsLieOnCurve", d.ByEdge.Count, d.MostPoints,
            (k, i) => m.PointCurveGap(d.ByEdge[k], i),
            m.Tolerances.Length.Value,
            (k, i) => AtEdge(k));

    // Law_DomainStartPointIsVertex at every entry. Structure (copied): Error.
    Check_DomainStartPointIsVertex(m: BrepModel, d: EdgeDiscretizations): Check
        => d.CheckEntries("Law_DomainStartPointIsVertex", x => Law_DomainStartPointIsVertex(m, x));

    // Law_DomainEndPointIsVertex at every entry. Structure (copied): Error.
    Check_DomainEndPointIsVertex(m: BrepModel, d: EdgeDiscretizations): Check
        => d.CheckEntries("Law_DomainEndPointIsVertex", x => Law_DomainEndPointIsVertex(m, x));

    // Law_SeedsAreSampled at every entry and seed. Structure (copied): Error.
    Check_SeedsAreSampled(m: BrepModel, d: EdgeDiscretizations): Check
        => CheckGrid("Law_SeedsAreSampled", d.ByEdge.Count, m.MostSeeds,
            (k, j) => SeedsAreSampled(m, d.ByEdge[k], j),
            (k, j) => AtEdge(k));

    // Law_DegenerateEdgeHasOneSegment at every entry. Structure: Error.
    Check_DegenerateEdgeHasOneSegment(m: BrepModel, d: EdgeDiscretizations): Check
        => d.CheckEntries("Law_DegenerateEdgeHasOneSegment", x => Law_DegenerateEdgeHasOneSegment(m, x));

    //==
    // # Criteria (geometry)

    // Law_SagittaWithinChordal at every entry and segment, measured by
    // SampledSagitta (0 at the length floor) against the effective chordal
    // bound plus Tolerances.Length. Geometry: Warning below ten times the
    // bound, Error above.
    Check_SagittaWithinChordal(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria, plan: SamplePlan): Check
        => CheckGridWithin("Law_SagittaWithinChordal", d.ByEdge.Count, d.MostPoints,
            (k, i) => m.SagittaExcess(d.ByEdge[k], c, plan, i),
            c.EffectiveChordal(m.Tolerances) + m.Tolerances.Length.Value,
            (k, i) => AtEdge(k));

    // Law_CertifiedSagittaWithinChordal at every entry and segment, measured
    // by layer 4's exact Sagitta of the segment's arc (0 at the length floor)
    // against the effective chordal bound plus Tolerances.Length: what
    // Discretize promises, which the sampled check above can miss between its
    // samples. A library law, self-test: Error.
    Check_CertifiedSagittaWithinChordal(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria): Check
        => CheckGridWithin("Law_CertifiedSagittaWithinChordal", d.ByEdge.Count, d.MostPoints,
            (k, i) => m.CertifiedSagittaAt(d.ByEdge[k], c, i),
            c.EffectiveChordal(m.Tolerances) + m.Tolerances.Length.Value,
            (k, i) => AtEdge(k));

    // Law_TangentDeviationWithinHalfAngular at every entry and segment,
    // measured by TangentDeviation in radians (0 at the length floor) against
    // half the effective angular bound plus Tolerances.Angle. Geometry: W/E.
    Check_TangentDeviationWithinHalfAngular(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria, plan: SamplePlan): Check
        => CheckGridWithin("Law_TangentDeviationWithinHalfAngular", d.ByEdge.Count, d.MostPoints,
            (k, i) => m.TangentExcess(d.ByEdge[k], c, plan, i),
            (c.EffectiveAngular * 0.5 + m.Tolerances.Angle.Value).Radians,
            (k, i) => AtEdge(k));

    // Law_TurningAngleWithinAngular at every entry and interior point,
    // measured by TurningAngle in radians (0 at a seed or beside a floored
    // segment) against the effective angular bound plus Tolerances.Angle.
    // Geometry: W/E.
    Check_TurningAngleWithinAngular(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria): Check
        => CheckGridWithin("Law_TurningAngleWithinAngular", d.ByEdge.Count, d.MostPoints,
            (k, i) => m.TurningExcess(d.ByEdge[k], c, i),
            (c.EffectiveAngular + m.Tolerances.Angle.Value).Radians,
            (k, i) => AtEdge(k));

    // Law_SegmentWithinMaxLength at every entry and segment, measured by the
    // chord length less Tolerances.Length (0 at the length floor) against the
    // limit (the largest Number when unlimited). Geometry: W/E.
    Check_SegmentWithinMaxLength(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria): Check
        => CheckGridWithin("Law_SegmentWithinMaxLength", d.ByEdge.Count, d.MostPoints,
            (k, i) => m.LengthExcess(d.ByEdge[k], c, i),
            c.MaxLength.LimitValue,
            (k, i) => AtEdge(k));

    // Law_ShortSegmentIsForced at every entry and segment. Quality: Info.
    Check_ShortSegmentIsForced(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria, floors: SegmentFloors): Check
        => d.CheckEntryPoints("Law_ShortSegmentIsForced", (x, i) => Law_ShortSegmentIsForced(m, x, c, floors, i));

    //==
    // # Counts (structure)

    // Law_ClosedEdgeHasMinSegments at every entry. Structure: Error.
    Check_ClosedEdgeHasMinSegments(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria): Check
        => d.CheckEntries("Law_ClosedEdgeHasMinSegments", x => ClosedEdgeHasMinSegments(m, x, c));

    // Law_SegmentFloorMet at every entry. Structure: Error.
    Check_SegmentFloorMet(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria, floors: SegmentFloors): Check
        => d.CheckEntries("Law_SegmentFloorMet", x => Law_SegmentFloorMet(m, x, c, floors));

    // Law_DiscretizationsIndexedByEdge at every entry. Structure: Error.
    Check_DiscretizationsIndexedByEdge(d: EdgeDiscretizations): Check
        => CheckAll("Law_DiscretizationsIndexedByEdge", d.ByEdge.Count, k => DiscretizationsIndexedByEdge(d, k), k => AtEdge(k));

    // Law_DiscretizationsCoverEdges. Structure: Error.
    Check_DiscretizationsCoverEdges(m: BrepModel, d: EdgeDiscretizations): Check
        => CheckOnce("Law_DiscretizationsCoverEdges", DiscretizationsCoverEdges(m, d));

    //==
    // # Parameter-space images (structure and geometry)

    // Law_ImageHasOnePointPerPoint at every entry and each of its images.
    // Structure: Error.
    Check_ImageHasOnePointPerPoint(m: BrepModel, d: EdgeDiscretizations): Check
        => CheckGrid("Law_ImageHasOnePointPerPoint", d.ByEdge.Count, m.MostImages,
            (k, j) => m.ImageAt(d.ByEdge[k], j, x => Law_ImageHasOnePointPerPoint(m, d.ByEdge[k], x)),
            (k, j) => AtEdge(k));

    // Law_ImagePointReevaluates at every entry, image, and point. Geometry,
    // no measure exported by layer 4: Error.
    Check_ImagePointReevaluates(m: BrepModel, d: EdgeDiscretizations): Check
        => CheckGrid("Law_ImagePointReevaluates", d.ByEdge.Count, m.MostImages * d.MostPoints,
            (k, j) => m.ImageAt(d.ByEdge[k], j / d.MostPoints, x => Law_ImagePointReevaluates(m, d.ByEdge[k], x, j % d.MostPoints)),
            (k, j) => AtEdge(k));

    // Law_ImageStepsAreUnwrapped at every entry, image, and point. Structure:
    // Error.
    Check_ImageStepsAreUnwrapped(m: BrepModel, d: EdgeDiscretizations): Check
        => CheckGrid("Law_ImageStepsAreUnwrapped", d.ByEdge.Count, m.MostImages * d.MostPoints,
            (k, j) => m.ImageAt(d.ByEdge[k], j / d.MostPoints, x => Law_ImageStepsAreUnwrapped(m, d.ByEdge[k], x, j % d.MostPoints)),
            (k, j) => AtEdge(k));

    // Law_ImageChordWithinChordal at every entry, image, and segment,
    // measured by ImageChordDeviations (0 at the length floor) against the
    // effective chordal bound plus twice Tolerances.Length. Geometry: W/E.
    Check_ImageChordWithinChordal(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria, plan: SamplePlan): Check
        => CheckGridWithin("Law_ImageChordWithinChordal", d.ByEdge.Count, m.MostImages * d.MostPoints,
            (k, j) => m.ImageChordExcess(d.ByEdge[k], c, plan, j / d.MostPoints, j % d.MostPoints),
            c.EffectiveChordal(m.Tolerances) + 2.0 * m.Tolerances.Length.Value,
            (k, j) => AtEdge(k));

    //==
    // # Reversal, sharing and refinement (self-tests)
    //
    // Library laws evaluated on the entries in hand. Self-test: Error.

    // Law_ReversedIsInvolution at every entry.
    Check_ReversedIsInvolution(d: EdgeDiscretizations): Check
        => d.CheckEntries("Law_ReversedIsInvolution", x => Law_ReversedIsInvolution(x));

    // Law_ReversedReversesParameters at every entry and parameter.
    Check_ReversedReversesParameters(d: EdgeDiscretizations): Check
        => d.CheckEntryPoints("Law_ReversedReversesParameters", (x, i) => Law_ReversedReversesParameters(x, i));

    // Law_ReversedReversesPoints at every entry and point.
    Check_ReversedReversesPoints(d: EdgeDiscretizations): Check
        => d.CheckEntryPoints("Law_ReversedReversesPoints", (x, i) => Law_ReversedReversesPoints(x, i));

    // Law_OppositeUsesSeeReversedPoints at every entry, for its first two
    // coedge sites anywhere in the model, at every point.
    Check_OppositeUsesSeeReversedPoints(m: BrepModel, d: EdgeDiscretizations): Check
        => CheckGrid("Law_OppositeUsesSeeReversedPoints", d.ByEdge.Count, d.MostPoints,
            (k, i) => m.OppositeUsesAt(d.ByEdge[k], i),
            (k, i) => AtEdge(k));

    // Law_EdgeReversalLeavesDiscretization at every edge.
    Check_EdgeReversalLeavesDiscretization(m: BrepModel, c: DiscretizationCriteria, floors: SegmentFloors): Check
        => m.CheckEdges("Law_EdgeReversalLeavesDiscretization", e => Law_EdgeReversalLeavesDiscretization(m, e, c, floors));

    // Law_TighterChordalNeverFewerPoints at every edge, at half the chordal
    // bound.
    Check_TighterChordalNeverFewerPoints(m: BrepModel, c: DiscretizationCriteria, floors: SegmentFloors): Check
        => m.CheckEdges("Law_TighterChordalNeverFewerPoints", e => Law_TighterChordalNeverFewerPoints(m, e, c, floors, c.Chordal * 0.5));

    // Law_RefineKeepsUnrequestedEdges at every edge, for the self-test
    // requests (every even edge at half the chordal bound).
    Check_RefineKeepsUnrequestedEdges(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria): Check
        => m.CheckEdges("Law_RefineKeepsUnrequestedEdges", e => Law_RefineKeepsUnrequestedEdges(m, d, m.SelfTestRequests(c), c, e));

    // Law_RefineNeverCoarsens at every edge and old parameter, for the
    // self-test requests.
    Check_RefineNeverCoarsens(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria): Check
        => CheckGrid("Law_RefineNeverCoarsens", m.Edges.Count, d.MostPoints,
            (e, k) => Law_RefineNeverCoarsens(m, d, m.SelfTestRequests(c), c, BrepEdgeIndex(e), k),
            (e, k) => AtEdge(e));

    // Law_RefineMeetsRequestedSegments at every edge, for the self-test
    // requests.
    Check_RefineMeetsRequestedSegments(m: BrepModel, d: EdgeDiscretizations, c: DiscretizationCriteria): Check
        => m.CheckEdges("Law_RefineMeetsRequestedSegments", e => Law_RefineMeetsRequestedSegments(m, d, m.SelfTestRequests(c), c, e));

    // Law_ArcCriteriaCountMeetsChordal at every circular edge, with its
    // radius and the sweep of its edge domain (vacuous on other curves,
    // whose radius is NaN).
    Check_ArcCriteriaCountMeetsChordal(m: BrepModel, c: DiscretizationCriteria): Check
        => m.CheckEdges("Law_ArcCriteriaCountMeetsChordal", e => Law_ArcCriteriaCountMeetsChordal(
            m.EdgeCircleRadius(e), Angle(m.EdgeSweep(e)), c, m.Tolerances));

    //==
    // # Helpers and measures

    // An exact law at every entry, reported at the entry's position as an
    // edge.
    CheckEntries(d: EdgeDiscretizations, law: String, holds: Function1<EdgeDiscretization, Boolean>): Check
        => CheckAll(law, d.ByEdge.Count, k => holds(d.ByEdge[k]), k => AtEdge(k));

    // An exact law at every entry and every point index below the largest
    // point count of any entry.
    CheckEntryPoints(d: EdgeDiscretizations, law: String, holds: Function2<EdgeDiscretization, Integer, Boolean>): Check
        => CheckGrid(law, d.ByEdge.Count, d.MostPoints, (k, i) => holds(d.ByEdge[k], i), (k, i) => AtEdge(k));

    // The largest point count of any entry: the extent of the per-point grids.
    MostPoints(d: EdgeDiscretizations): Integer
        => d.ByEdge.Reduce(0, (n, x) => n.Max(x.Points.Count).Max(x.Parameters.Count));

    // The largest seed count of any evaluable edge.
    MostSeeds(m: BrepModel): Integer
        => m.Edges.Count.Range.Reduce(0, (n, e) =>
            m.IsEdgeEvaluable(BrepEdgeIndex(e)) ? n.Max(m.EdgeSeeds(BrepEdgeIndex(e)).Count) : n);

    // The largest image count of any edge.
    MostImages(m: BrepModel): Integer
        => m.Edges.Count.Range.Reduce(0, (n, e) => n.Max(m.EdgeImages(BrepEdgeIndex(e)).Count));

    // The image claim at image j of the entry's edge; true (vacuous) when the
    // edge has no image j.
    ImageAt(m: BrepModel, x: EdgeDiscretization, j: Integer, claim: Function1<EdgeImage, Boolean>): Boolean
        => m.IsEdgeEvaluable(x.Edge) ? (m.EdgeImages(x.Edge).IsValidIndex(j) ? claim(m.EdgeImages(x.Edge)[j]) : true) : true;

    // The largest Number when unlimited, the limit's value otherwise.
    LimitValue(l: Limit): Number
        => match (l)
        {
            Unlimited => Number.MaxValue;
            AtMost(v) => v;
        };

    // The distance from point i to the edge's curve at parameter i, behind
    // Law_PointsLieOnCurve's guard.
    PointCurveGap(m: BrepModel, x: EdgeDiscretization, i: Integer): Number
        => (m.IsEvaluable(x) && x.Points.IsValidIndex(i))
            ? x.Points[i].Distance(m.PointOnEdge(x.Edge, x.Parameters[i]))
            : 0.0;

    // SampledSagitta of segment i behind Law_SagittaWithinChordal's guard and
    // exemption.
    SagittaExcess(m: BrepModel, x: EdgeDiscretization, c: DiscretizationCriteria, plan: SamplePlan, i: Integer): Number
        => m.IsEvaluableSegment(x, i) ? (m.IsAtLengthFloor(x, c, i) ? 0.0 : m.SampledSagitta(x, plan, i)) : 0.0;

    // TangentDeviation of segment i in radians behind
    // Law_TangentDeviationWithinHalfAngular's guard and exemption.
    TangentExcess(m: BrepModel, x: EdgeDiscretization, c: DiscretizationCriteria, plan: SamplePlan, i: Integer): Number
        => m.IsEvaluableSegment(x, i) ? (m.IsAtLengthFloor(x, c, i) ? 0.0 : m.TangentDeviation(x, plan, i).Radians) : 0.0;

    // TurningAngle at point i in radians behind
    // Law_TurningAngleWithinAngular's guard and exemptions.
    TurningExcess(m: BrepModel, x: EdgeDiscretization, c: DiscretizationCriteria, i: Integer): Number
        => (m.IsEvaluable(x) && i >= 1 && i + 1 < x.Points.Count)
            ? ((m.IsSeedParameter(x.Edge, x.Parameters[i]) || m.IsAtLengthFloor(x, c, i - 1) || m.IsAtLengthFloor(x, c, i))
                ? 0.0
                : x.TurningAngle(i).Radians)
            : 0.0;

    // Layer 4's exact Sagitta of segment i's arc behind
    // Law_CertifiedSagittaWithinChordal's guard and exemption.
    CertifiedSagittaAt(m: BrepModel, x: EdgeDiscretization, c: DiscretizationCriteria, i: Integer): Number
        => m.IsEvaluableSegment(x, i)
            ? (m.IsAtLengthFloor(x, c, i)
                ? 0.0
                : m.Sagitta(x.Edge, x.Parameters[i].Min(x.Parameters[i + 1]), x.Parameters[i].Max(x.Parameters[i + 1])))
            : 0.0;

    // Segment i's chord length less Tolerances.Length behind
    // Law_SegmentWithinMaxLength's guard and exemption.
    LengthExcess(m: BrepModel, x: EdgeDiscretization, c: DiscretizationCriteria, i: Integer): Number
        => m.IsEvaluableSegment(x, i) ? (m.IsAtLengthFloor(x, c, i) ? 0.0 : x.SegmentLength(i) - m.Tolerances.Length.Value) : 0.0;

    // The image chord deviation of segment i in image j behind
    // Law_ImageChordWithinChordal's guard and exemption.
    ImageChordExcess(m: BrepModel, x: EdgeDiscretization, c: DiscretizationCriteria, plan: SamplePlan, j: Integer, i: Integer): Number
        => (m.IsEvaluableSegment(x, i) && m.EdgeImages(x.Edge).IsValidIndex(j))
            ? (m.IsImageEvaluable(m.EdgeImages(x.Edge)[j])
                ? (m.ImageChordDeviations(x, m.EdgeImages(x.Edge)[j], plan).IsValidIndex(i)
                    ? (m.IsAtLengthFloor(x, c, i) ? 0.0 : m.ImageChordDeviations(x, m.EdgeImages(x.Edge)[j], plan)[i])
                    : 0.0)
                : 0.0)
            : 0.0;

    // The coedge sites of the model that cite edge e, in any face.
    SitesOfEdge(m: BrepModel, e: BrepEdgeIndex): Array<CoedgeSite>
        => m.AllCoedgeSites.FlatMap(s => m.CoedgeAt(s).Edge == e ? [s] : m.AllCoedgeSites.Take(0));

    // Law_OppositeUsesSeeReversedPoints for the entry's first two uses at
    // point i; vacuous when the edge has fewer than two uses.
    OppositeUsesAt(m: BrepModel, x: EdgeDiscretization, i: Integer): Boolean
    {
        var uses = m.IsEdgeEvaluable(x.Edge) ? m.SitesOfEdge(x.Edge) : m.AllCoedgeSites.Take(0);
        return uses.Count >= 2
            ? Law_OppositeUsesSeeReversedPoints(m, x, m.BoundAt(uses[0]), m.CoedgeAt(uses[0]), m.BoundAt(uses[1]), m.CoedgeAt(uses[1]), i)
            : true;
    }

    // The refinement requests the self-tests use: every edge of even index,
    // at half the chordal bound, for no particular count.
    SelfTestRequests(m: BrepModel, c: DiscretizationCriteria): Array<EdgeRefinementRequest>
        => m.Edges.Count.Range.FlatMap(e => e % 2 == 0
            ? [EdgeRefinementRequest(BrepEdgeIndex(e), RefinementReason.TooCoarseInParameterSpace, c.Chordal * 0.5, 0)]
            : []);

    // The radius of edge e's curve when it is a circle, NaN otherwise.
    EdgeCircleRadius(m: BrepModel, e: BrepEdgeIndex): Number
        => m.IsEdgeEvaluable(e) ? m.Geometry.CurveAt(m.Edges[e].Curve).CircleRadius : Number.Unmeasured;

    // The radius of a circle, NaN for every other case.
    CircleRadius(curve: BrepCurve): Number
        => match (curve)
        {
            Line(origin, velocity) => Number.Unmeasured;
            Circle(placement, radius) => radius;
            Ellipse(placement, semiAxis1, semiAxis2) => Number.Unmeasured;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => Number.Unmeasured;
            Parabola(placement, focalDistance) => Number.Unmeasured;
            Polyline(points) => Number.Unmeasured;
            BSpline(data) => Number.Unmeasured;
            Trimmed(basis, range, sameSense) => Number.Unmeasured;
            Composite(segments) => Number.Unmeasured;
            Offset(basis, distance, reference) => Number.Unmeasured;
            OnSurface(spaceCurve, supports, master) => Number.Unmeasured;
        };

    // The length of edge e's domain in its curve's parameter: the sweep of a
    // circular edge in radians. 0 when the model's indices are not in range.
    EdgeSweep(m: BrepModel, e: BrepEdgeIndex): Number
        => m.Law_IndicesInRange ? (m.IsEdgeEvaluable(e) ? m.EdgeDomain(e).ParameterLength : 0.0) : 0.0;
}

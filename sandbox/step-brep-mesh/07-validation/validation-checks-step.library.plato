//==
// # BrepCheckingStep
//
// Layer 7 of the STEP B-rep to mesh design (README.md beside this file): one
// Check_ per law of 03-step outside the WHERE rules (those are
// BrepCheckingWhere's): the laws of the file as data (instance names, the
// attribute arena, references, the header), of a file against the schema
// table (arity, kinds, aggregate bounds, defined-type rules, complex part
// order), of the decode (totality, the provenance map, counts per kind,
// units, folding), of the schema table itself, and of the text round trip.
// The file laws are model laws about the file: a failure is an Error, except
// Law_ReferencesResolve and Law_HeaderNamesASchema (Warning) and
// Law_ComplexPartsInStandardOrder (Info), as layer 3 grades them. The decode
// laws and the table and text laws are library laws, run as self-tests on
// the file in hand: a failure is a defect of the decoder, an Error. Every
// comment names the Law_, its family, and its severity rule.
//
// Sections, in order:
//  - The file as data (structure)
//  - The file against the schema table (structure)
//  - The decode (self-tests)
//  - Units, sense and folding (self-tests)
//  - The schema table and the text round trip (self-tests)
//  - Helpers

library BrepCheckingStep
{
    //==
    // # The file as data (structure)

    // Law_InstanceIdsPositive at every instance position. Structure: Error.
    Check_InstanceIdsPositive(f: Part21File): Check
        => f.CheckInstances("Law_InstanceIdsPositive", i => Law_InstanceIdsPositive(f, i));

    // Law_InstanceIdsAscending at every instance position. Structure: Error.
    Check_InstanceIdsAscending(f: Part21File): Check
        => f.CheckInstances("Law_InstanceIdsAscending", i => Law_InstanceIdsAscending(f, i));

    // Law_InstanceIdsUnique at every pair of adjacent positions (i, i + 1).
    // When Law_InstanceIdsAscending holds a repeated name sits at adjacent
    // positions, so the adjacent pairs are every pair that can fail.
    // Structure: Error.
    Check_InstanceIdsUnique(f: Part21File): Check
        => f.CheckInstances("Law_InstanceIdsUnique", i => Law_InstanceIdsUnique(f, i, i + 1));

    // Law_InstancePositionIsExact at the name of every instance and at the
    // name one past the largest, which no instance has. Structure: Error.
    Check_InstancePositionIsExact(f: Part21File): Check
        => CheckAll("Law_InstancePositionIsExact", f.Instances.Count + 1,
            i => Law_InstancePositionIsExact(f, i < f.Instances.Count ? f.IdAt(i) : StepInstanceId(f.LargestInstanceId + 1)),
            i => Provenance.WholeInput);

    // Law_RecordIndicesInRange at every instance, record, and attribute.
    // Structure: Error.
    Check_RecordIndicesInRange(f: Part21File): Check
        => f.CheckRecordSlots("Law_RecordIndicesInRange", (i, r, k) => Law_RecordIndicesInRange(f, i, r, k));

    // Law_ChildrenPrecedeParent at every attribute and child. Structure:
    // Error.
    Check_ChildrenPrecedeParent(f: Part21File): Check
        => CheckGrid("Law_ChildrenPrecedeParent", f.Attributes.Count, f.MostChildren,
            (a, k) => Law_ChildrenPrecedeParent(f, a, k), (a, k) => Provenance.WholeInput);

    // Law_ReferencesResolve at every attribute. Structure; layer 3 grades a
    // dangling reference a Warning (an Error where a decoded instance needs
    // it, which the decoder's own diagnostic reports).
    Check_ReferencesResolve(f: Part21File): Check
        => f.CheckAttributes("Law_ReferencesResolve", a => Law_ReferencesResolve(f, a));

    // Law_HeaderNamesASchema. Structure; Warning.
    Check_HeaderNamesASchema(f: Part21File): Check
        => CheckOnce("Law_HeaderNamesASchema", Law_HeaderNamesASchema(f));

    //==
    // # The file against the schema table (structure)

    // Law_AttributeCountMatchesSchema at every instance and record.
    // Structure: Error.
    Check_AttributeCountMatchesSchema(f: Part21File): Check
        => CheckGrid("Law_AttributeCountMatchesSchema", f.Instances.Count, f.MostRecords,
            (i, r) => Law_AttributeCountMatchesSchema(f, i, r), (i, r) => f.AtInstance(i));

    // Law_AttributeKindsMatchSchema at every instance, record, and attribute.
    // Structure: Error.
    Check_AttributeKindsMatchSchema(f: Part21File): Check
        => f.CheckRecordSlots("Law_AttributeKindsMatchSchema", (i, r, k) => Law_AttributeKindsMatchSchema(f, i, r, k));

    // Law_AggregateBoundsHold at every instance, record, and attribute.
    // Structure: Error.
    Check_AggregateBoundsHold(f: Part21File): Check
        => f.CheckRecordSlots("Law_AggregateBoundsHold", (i, r, k) => Law_AggregateBoundsHold(f, i, r, k));

    // Law_DefinedTypeRulesHold at every instance, record, and attribute.
    // Structure: Error.
    Check_DefinedTypeRulesHold(f: Part21File): Check
        => f.CheckRecordSlots("Law_DefinedTypeRulesHold", (i, r, k) => Law_DefinedTypeRulesHold(f, i, r, k));

    // Law_ComplexPartsInStandardOrder at every instance and record.
    // Structure; Info (the decoder matches parts by name).
    Check_ComplexPartsInStandardOrder(f: Part21File): Check
        => CheckGrid("Law_ComplexPartsInStandardOrder", f.Instances.Count, f.MostRecords,
            (i, r) => Law_ComplexPartsInStandardOrder(f, i, r), (i, r) => f.AtInstance(i));

    //==
    // # The decode (self-tests)
    //
    // Library laws of the decoder evaluated on the file in hand: each decodes
    // the file with the standard policy. Self-test: Error.

    // Law_DecodeIsTotal.
    Check_DecodeIsTotal(f: Part21File): Check
        => CheckOnce("Law_DecodeIsTotal", Law_DecodeIsTotal(f));

    // Law_DecodedMagnitudesAreTheModels.
    Check_DecodedMagnitudesAreTheModels(f: Part21File): Check
        => CheckOnce("Law_DecodedMagnitudesAreTheModels", Law_DecodedMagnitudesAreTheModels(f));

    // Law_DecodedToleranceResolvable (review F6: at the coordinate extent).
    Check_DecodedToleranceResolvable(f: Part21File): Check
        => CheckOnce("Law_DecodedToleranceResolvable", Law_DecodedToleranceResolvable(f));

    // Law_ParameterFloorsFollowLength.
    Check_ParameterFloorsFollowLength(f: Part21File): Check
        => CheckOnce("Law_ParameterFloorsFollowLength", Law_ParameterFloorsFollowLength(f));

    // Law_ClosureMarksAreTheDecisions.
    Check_ClosureMarksAreTheDecisions(f: Part21File): Check
        => CheckOnce("Law_ClosureMarksAreTheDecisions", Law_ClosureMarksAreTheDecisions(f));

    // Law_CurveClosureDecidedByEnds at every decoded curve.
    Check_CurveClosureDecidedByEnds(f: Part21File): Check
        => CheckAll("Law_CurveClosureDecidedByEnds", f.DecodeBrep.Model.Geometry.Curves.Count,
            k => Law_CurveClosureDecidedByEnds(f, k), k => Provenance.KernelCurve(CurveIndex(k)));

    // Law_SurfaceClosureDecidedBySides at every decoded surface and both
    // parameters.
    Check_SurfaceClosureDecidedBySides(f: Part21File): Check
        => CheckGrid("Law_SurfaceClosureDecidedBySides", f.DecodeBrep.Model.Geometry.Surfaces.Count, 2,
            (k, w) => Law_SurfaceClosureDecidedBySides(f, k, w == 0 ? SurfaceParameter.ParameterU : SurfaceParameter.ParameterV),
            (k, w) => Provenance.KernelSurface(SurfaceIndex(k)));

    // Law_MirrorFoldRecordedOnce at every decoded face.
    Check_MirrorFoldRecordedOnce(f: Part21File): Check
        => CheckAll("Law_MirrorFoldRecordedOnce", f.DecodeBrep.Model.Faces.Count,
            k => Law_MirrorFoldRecordedOnce(f, k), k => AtFace(k));

    // Law_LeftHandedSurfacesAreFolded at every decoded face (review F2).
    Check_LeftHandedSurfacesAreFolded(f: Part21File): Check
        => CheckAll("Law_LeftHandedSurfacesAreFolded", f.DecodeBrep.Model.Faces.Count,
            k => Law_LeftHandedSurfacesAreFolded(f, k), k => AtFace(k));

    // Law_DecodedTolerancesWellFormed.
    Check_DecodedTolerancesWellFormed(f: Part21File): Check
        => CheckOnce("Law_DecodedTolerancesWellFormed", Law_DecodedTolerancesWellFormed(f));

    // Law_RepairsAreDiagnosed at every repair.
    Check_RepairsAreDiagnosed(f: Part21File): Check
        => CheckAll("Law_RepairsAreDiagnosed", f.DecodeBrep.Map.Repairs.Count, r => Law_RepairsAreDiagnosed(f, r), r => Provenance.WholeInput);

    // Law_ProvenanceCoversModel.
    Check_ProvenanceCoversModel(f: Part21File): Check
        => CheckOnce("Law_ProvenanceCoversModel", Law_ProvenanceCoversModel(f));

    // Law_ProvenanceSourcesDistinct at every pair of sources (quadratic as
    // written; the sorted ByInstance table makes it a scan of neighbours).
    Check_ProvenanceSourcesDistinct(f: Part21File): Check
        => CheckGrid("Law_ProvenanceSourcesDistinct", f.SourceCount, f.SourceCount,
            (a, b) => Law_ProvenanceSourcesDistinct(f, a, b), (a, b) => Provenance.WholeInput);

    // Law_ProvenanceLookupInvertsSources at every source.
    Check_ProvenanceLookupInvertsSources(f: Part21File): Check
        => CheckAll("Law_ProvenanceLookupInvertsSources", f.SourceCount, a => Law_ProvenanceLookupInvertsSources(f, a), a => Provenance.WholeInput);

    // Law_SourceKindMatchesTable at every source.
    Check_SourceKindMatchesTable(f: Part21File): Check
        => CheckAll("Law_SourceKindMatchesTable", f.SourceCount, a => Law_SourceKindMatchesTable(f, a), a => Provenance.WholeInput);

    // Law_RepairedSourcesAreUnmapped at every repair.
    Check_RepairedSourcesAreUnmapped(f: Part21File): Check
        => CheckAll("Law_RepairedSourcesAreUnmapped", f.DecodeBrep.Map.Repairs.Count, r => Law_RepairedSourcesAreUnmapped(f, r), r => Provenance.WholeInput);

    // Law_ReachedInstancesAreAccountedFor at every occurrence and every
    // instance position (the reached list of an occurrence is never longer).
    Check_ReachedInstancesAreAccountedFor(f: Part21File): Check
        => CheckGrid("Law_ReachedInstancesAreAccountedFor", f.DecodeBrep.Map.Occurrences.Count, f.Instances.Count,
            (o, k) => Law_ReachedInstancesAreAccountedFor(f, o, k), (o, k) => Provenance.WholeInput);

    // Law_VertexCountMatchesInstances.
    Check_VertexCountMatchesInstances(f: Part21File): Check
        => CheckOnce("Law_VertexCountMatchesInstances", Law_VertexCountMatchesInstances(f));

    // Law_EdgeCountMatchesInstances.
    Check_EdgeCountMatchesInstances(f: Part21File): Check
        => CheckOnce("Law_EdgeCountMatchesInstances", Law_EdgeCountMatchesInstances(f));

    // Law_LoopCountMatchesInstances.
    Check_LoopCountMatchesInstances(f: Part21File): Check
        => CheckOnce("Law_LoopCountMatchesInstances", Law_LoopCountMatchesInstances(f));

    // Law_FaceCountMatchesInstances.
    Check_FaceCountMatchesInstances(f: Part21File): Check
        => CheckOnce("Law_FaceCountMatchesInstances", Law_FaceCountMatchesInstances(f));

    // Law_ShellCountMatchesInstances.
    Check_ShellCountMatchesInstances(f: Part21File): Check
        => CheckOnce("Law_ShellCountMatchesInstances", Law_ShellCountMatchesInstances(f));

    // Law_BodyCountMatchesInstances.
    Check_BodyCountMatchesInstances(f: Part21File): Check
        => CheckOnce("Law_BodyCountMatchesInstances", Law_BodyCountMatchesInstances(f));

    // Law_CurveCountMatchesInstances.
    Check_CurveCountMatchesInstances(f: Part21File): Check
        => CheckOnce("Law_CurveCountMatchesInstances", Law_CurveCountMatchesInstances(f));

    // Law_PcurveCountMatchesInstances.
    Check_PcurveCountMatchesInstances(f: Part21File): Check
        => CheckOnce("Law_PcurveCountMatchesInstances", Law_PcurveCountMatchesInstances(f));

    // Law_SurfaceCountMatchesInstances.
    Check_SurfaceCountMatchesInstances(f: Part21File): Check
        => CheckOnce("Law_SurfaceCountMatchesInstances", Law_SurfaceCountMatchesInstances(f));

    //==
    // # Units, sense and folding (self-tests)

    // Law_CirclePeriodIsTwoPi at every decoded curve, with the decoded
    // model's angle parameter floor (a circle's parameter is an angle).
    Check_CirclePeriodIsTwoPi(f: Part21File): Check
        => CheckAll("Law_CirclePeriodIsTwoPi", f.DecodeBrep.Model.Geometry.Curves.Count,
            k => Law_CirclePeriodIsTwoPi(f, k, f.DecodeBrep.Model.Tolerances.AngleParameter), k => Provenance.KernelCurve(CurveIndex(k)));

    // Law_AngleUnitIsReported at every context of the file (a position past
    // the used contexts is vacuous).
    Check_AngleUnitIsReported(f: Part21File): Check
        => CheckAll("Law_AngleUnitIsReported", f.Instances.Count, c => Law_AngleUnitIsReported(f, c), c => f.AtInstance(c));

    // Law_UncertaintyDefaultExactlyWhenAbsent.
    Check_UncertaintyDefaultExactlyWhenAbsent(f: Part21File): Check
        => CheckOnce("Law_UncertaintyDefaultExactlyWhenAbsent", Law_UncertaintyDefaultExactlyWhenAbsent(f));

    // Law_ToleranceCoversStatedUncertainties at every context position.
    Check_ToleranceCoversStatedUncertainties(f: Part21File): Check
        => CheckAll("Law_ToleranceCoversStatedUncertainties", f.Instances.Count, c => Law_ToleranceCoversStatedUncertainties(f, c), c => f.AtInstance(c));

    // Law_ModelUnitIsRootUnit.
    Check_ModelUnitIsRootUnit(f: Part21File): Check
        => CheckOnce("Law_ModelUnitIsRootUnit", Law_ModelUnitIsRootUnit(f));

    // Law_EdgeSenseCopied at every decoded edge.
    Check_EdgeSenseCopied(f: Part21File): Check
        => CheckAll("Law_EdgeSenseCopied", f.DecodeBrep.Model.Edges.Count, e => Law_EdgeSenseCopied(f, e), e => AtEdge(e));

    // Law_PcurvesComeFromPcurveInstances at every decoded pcurve.
    Check_PcurvesComeFromPcurveInstances(f: Part21File): Check
        => CheckAll("Law_PcurvesComeFromPcurveInstances", f.DecodeBrep.Model.Geometry.Pcurves.Count, k => Law_PcurvesComeFromPcurveInstances(f, k), k => Provenance.WholeInput);

    // Law_DeclaredClosedCopied at every decoded shell.
    Check_DeclaredClosedCopied(f: Part21File): Check
        => CheckAll("Law_DeclaredClosedCopied", f.DecodeBrep.Model.Shells.Count, s => Law_DeclaredClosedCopied(f, s), s => AtShell(s));

    // Law_OuterFlagClearedWhenDoubled at every decoded face.
    Check_OuterFlagClearedWhenDoubled(f: Part21File): Check
        => CheckAll("Law_OuterFlagClearedWhenDoubled", f.DecodeBrep.Model.Faces.Count, k => Law_OuterFlagClearedWhenDoubled(f, k), k => AtFace(k));

    // Law_OuterFlagCopiedWhenSingle at every decoded face and bound.
    Check_OuterFlagCopiedWhenSingle(f: Part21File): Check
        => CheckGrid("Law_OuterFlagCopiedWhenSingle", f.DecodeBrep.Model.Faces.Count, f.DecodeBrep.Model.MostBounds,
            (k, j) => Law_OuterFlagCopiedWhenSingle(f, k, j), (k, j) => AtFace(k));

    // Law_MergedVerticesCoincide at every repair.
    Check_MergedVerticesCoincide(f: Part21File): Check
        => CheckAll("Law_MergedVerticesCoincide", f.DecodeBrep.Map.Repairs.Count, r => Law_MergedVerticesCoincide(f, r), r => Provenance.WholeInput);

    // Law_FoldPreservesInteriorSide at every decoded face and bound.
    Check_FoldPreservesInteriorSide(f: Part21File): Check
        => CheckGrid("Law_FoldPreservesInteriorSide", f.DecodeBrep.Model.Faces.Count, f.DecodeBrep.Model.MostBounds,
            (k, j) => Law_FoldPreservesInteriorSide(f, k, j), (k, j) => AtFace(k));

    // Law_FoldFlipsExactlyRecorded at every decoded face.
    Check_FoldFlipsExactlyRecorded(f: Part21File): Check
        => CheckAll("Law_FoldFlipsExactlyRecorded", f.DecodeBrep.Model.Faces.Count, k => Law_FoldFlipsExactlyRecorded(f, k), k => AtFace(k));

    // Law_FoldRecordsNameFalseFlags at every fold record.
    Check_FoldRecordsNameFalseFlags(f: Part21File): Check
        => CheckAll("Law_FoldRecordsNameFalseFlags", f.DecodeBrep.Map.Folds.Count, r => Law_FoldRecordsNameFalseFlags(f, r), r => Provenance.WholeInput);

    //==
    // # The schema table and the text round trip (self-tests)

    // Law_SchemaNamesUnique at every pair of table positions.
    Check_SchemaNamesUnique(_: Part21File): Check
        => CheckGrid("Law_SchemaNamesUnique", Part21File.SchemaSize, Part21File.SchemaSize,
            (a, b) => Law_SchemaNamesUnique(a, b), (a, b) => Provenance.WholeInput);

    // Law_SchemaShortNamesUnique at every pair of table positions.
    Check_SchemaShortNamesUnique(_: Part21File): Check
        => CheckGrid("Law_SchemaShortNamesUnique", Part21File.SchemaSize, Part21File.SchemaSize,
            (a, b) => Law_SchemaShortNamesUnique(a, b), (a, b) => Provenance.WholeInput);

    // Law_SchemaShortNameIsNoOtherLongName at every pair of table positions.
    Check_SchemaShortNameIsNoOtherLongName(_: Part21File): Check
        => CheckGrid("Law_SchemaShortNameIsNoOtherLongName", Part21File.SchemaSize, Part21File.SchemaSize,
            (a, b) => Law_SchemaShortNameIsNoOtherLongName(a, b), (a, b) => Provenance.WholeInput);

    // Law_SchemaSupertypesPrecede at every table position and its first
    // eight supertypes (no entity of the table names more).
    Check_SchemaSupertypesPrecede(_: Part21File): Check
        => CheckGrid("Law_SchemaSupertypesPrecede", Part21File.SchemaSize, 8,
            (a, k) => Law_SchemaSupertypesPrecede(a, k), (a, k) => Provenance.WholeInput);

    // Law_SchemaDerivesAreInherited at every table position and its first
    // eight derived names.
    Check_SchemaDerivesAreInherited(_: Part21File): Check
        => CheckGrid("Law_SchemaDerivesAreInherited", Part21File.SchemaSize, 8,
            (a, k) => Law_SchemaDerivesAreInherited(a, k), (a, k) => Provenance.WholeInput);

    // Law_ParsePrintParseIsIdentity on the file's own print.
    Check_ParsePrintParseIsIdentity(f: Part21File): Check
        => CheckOnce("Law_ParsePrintParseIsIdentity", Law_ParsePrintParseIsIdentity(f.PrintStep));

    // Law_ParseOkIffNoError on the file's own print.
    Check_ParseOkIffNoError(f: Part21File): Check
        => CheckOnce("Law_ParseOkIffNoError", Law_ParseOkIffNoError(f.PrintStep));

    //==
    // # Helpers

    // An exact law at every instance, record, and attribute position of a
    // file (positions past a record's end are vacuous in every such law).
    CheckRecordSlots(f: Part21File, law: String, holds: Function3<Integer, Integer, Integer, Boolean>): Check
        => CheckGrid(law, f.Instances.Count, f.MostRecords * f.MostRecordAttributes,
            (i, j) => holds(i, j / f.MostRecordAttributes.Max(1), j % f.MostRecordAttributes.Max(1)),
            (i, j) => f.AtInstance(i));

    // The largest record count of any instance: 1 for a simple instance, the
    // part count for a complex one.
    MostRecords(f: Part21File): Integer
        => f.Instances.Count.Range.Reduce(0, (n, i) => n.Max(f.RecordsAt(i).Count));

    // The largest attribute count of any record.
    MostRecordAttributes(f: Part21File): Integer
        => f.Instances.Count.Range.Reduce(0, (n, i) => f.RecordsAt(i).Reduce(n, (x, r) => x.Max(r.Attributes.Count)));

    // The largest child count of any attribute value.
    MostChildren(f: Part21File): Integer
        => f.Attributes.Count.Range.Reduce(0, (n, a) => n.Max(f.ChildrenOf(StepAttributeIndex(a)).Count));

    // The largest instance name of the file; 0 for a file with no instance.
    LargestInstanceId(f: Part21File): Integer
        => f.Instances.Reduce(0, (n, x) => n.Max(x.Id.Value));

    // The number of sources of the file's decode with the standard policy.
    SourceCount(f: Part21File): Integer
        => f.DecodeBrep.Map.Sources.AllSources.Count;

    // The largest bound count of any face of a model.
    MostBounds(m: BrepModel): Integer
        => m.Faces.Reduce(0, (n, face) => n.Max(face.Bounds.Count));

    // The number of entities of the supported schema table.
    SchemaSize(_: Part21File): Integer
        => Part21File.SupportedSchema.Count;
}

//==
// # Component checks over tables built once: laws (complexity sweep, chunk V6)
//
// Every check of validation-checks-components.library.plato is Identical to the library check it
// replaces, field for field, on the literal meshes of 06-mesh's IncidenceTestMeshAt (a closed
// tetrahedron and its reversal, an open fan, two tetrahedra pinched at a vertex, two components
// interleaved in element order with an unreferenced vertex, a quad beside a triangle repeating a
// vertex) and on every mesh the runner gives; the Structure report is Identical to
// ModelMeshReport's Structure family and builds ComponentsOf once. The linear root check is
// Identical to the grid on any component table, including a literal table whose second root is
// not its component's lowest element, so the agreement is shown on a failing case too. One count
// witness reads ModelMeshStructureReportCounted on fans.
//
// Sections, in order:
//  - Literal values
//  - Comparisons
//  - Agreement
//  - Failing cases
//  - Count witness

library ComponentChecksGivenLaws
{
    //==
    // # Literal values

    // A component table for IncidenceTestInterleaved (elements 0 and 3 in component 0, the rest
    // in component 1) whose forest roots component 0 at element 3, above element 0: roots 1 and
    // 3. Law_ComponentRootIsItsLowestElement fails at r = 3 and Law_ComponentsAreNumberedByRoot at
    // r = 1 (component 1 with no root below it).
    MisrootedComponents(_: MeshComponents): MeshComponents
        => MeshComponents(
            [0, 1, 1, 0, 1, 1].Map(x => MeshComponentIndex(x)),
            [1, 1, 1, 1, 0, 0, 0, 0, -1].Map(x => MeshComponentIndex(x)),
            2,
            [3, 1, 1, 3, 1, 1].Map(x => ElementIndex(x)),
            [1, 0, 1, 0, 1, 1]);

    // The tolerances the literal laws use.
    ComponentTolerances(_: Tolerances): Tolerances
        => Tolerances.Witness_Tolerances;

    //==
    // # Comparisons

    // Law_ComponentRootIsItsLowestElement over comps on the N x N grid, as the library's check
    // samples it.
    RootIsLowestGrid(mesh: ModelMesh, comps: MeshComponents): Check
        => CheckGrid("Law_ComponentRootIsItsLowestElement", mesh.ElementCount, mesh.ElementCount,
            (r, e) => mesh.ComponentRootIsItsLowestElementGiven(comps, ElementIndex(r), ElementIndex(e)), (r, e) => AtElement(r));

    // Whether the linear root check over comps is Identical to the grid.
    RootIsLowestLinearAgreesOn(mesh: ModelMesh, comps: MeshComponents): Boolean
        => Identical(mesh.Check_ComponentRootIsItsLowestElementLinear(comps, mesh.ComponentRootTablesOf(comps)),
            mesh.RootIsLowestGrid(comps));

    // Whether RootsBelow read from the root tables equals RootsBelow counted, at every r from -1
    // to the parent count.
    RootsBelowAgreesOn(mesh: ModelMesh, comps: MeshComponents): Boolean
    {
        var roots = mesh.ComponentRootTablesOf(comps);
        return (comps.ElementParent.Count + 2).Range.All(i => roots.RootsBelowAt(ElementIndex(i - 1)) == comps.RootsBelow(ElementIndex(i - 1)));
    }

    //==
    // # Agreement

    // The linear root check is Identical to the grid, and the tabled RootsBelow equals the
    // counted one, on the components of each literal mesh and on the misrooted table.
    Law_RootIsLowestLinearAgrees(k: Integer): Boolean
    {
        var mesh = ModelMesh.IncidenceTestMeshAt(k);
        var interleaved = ModelMesh.IncidenceTestInterleaved;
        return mesh.RootIsLowestLinearAgreesOn(mesh.ComponentsOf) && mesh.RootsBelowAgreesOn(mesh.ComponentsOf)
            && interleaved.RootIsLowestLinearAgreesOn(MeshComponents.MisrootedComponents)
            && interleaved.RootsBelowAgreesOn(MeshComponents.MisrootedComponents);
    }

    // The same on any mesh and any component table the runner gives, consistent or not.
    Law_RootIsLowestLinearAgreesOnAnyTable(mesh: ModelMesh, comps: MeshComponents): Boolean
        => mesh.RootIsLowestLinearAgreesOn(comps) && mesh.RootsBelowAgreesOn(comps);

    //==
    // # Failing cases

    // The agreement above is not vacuous: on the misrooted table the linear root check fails at
    // element 3 and the numbering check at element 1; on the pinched pair, closed, the hoisted
    // pinch check fails at vertex 0.
    Law_FailingComponentChecksNameTheirCell(_: ModelMesh): Boolean
    {
        var interleaved = ModelMesh.IncidenceTestInterleaved;
        var comps = MeshComponents.MisrootedComponents;
        var roots = interleaved.ComponentRootTablesOf(comps);
        var lowest = interleaved.Check_ComponentRootIsItsLowestElementLinear(comps, roots);
        var numbered = interleaved.Check_ComponentsAreNumberedByRootWithComponents(comps, roots);
        var pinch = ModelMesh.IncidenceTestPinched.Check_ClosedMeshHasNoPinchedVertexHoisted;
        return !lowest.Holds && lowest.Where == AtElement(3)
            && !numbered.Holds && numbered.Where == AtElement(1)
            && !pinch.Holds && pinch.Where == AtMeshVertex(0);
    }

    //==
    // # Count witness

    // The work of the Structure report on the closed fan of n triangles about one vertex
    // (06-mesh's IncidenceTestFan: n elements, n + 1 vertices).
    ComponentChecksWorkAt(n: Integer): WorkBudget
        => IncidenceTestFan(n).ModelMeshStructureReportCounted(Tolerances.ComponentTolerances).Work;

    // The Structure report's component checks build ComponentsOf once (Flips, at most one per
    // element and exactly one per report, Law_StructureReportAgrees) and visit at most 8
    // elements per element (Insertions: the root tables' pass and six per-element checks, 7 per
    // element), on fans of 6 (IncidenceTestMeshAt's fan) and 64 triangles. The library's checks
    // build ComponentsOf several times per element per check and per sample of the N x N root
    // grid: more than N^2 builds.
    Witness_ComponentChecksWork(_: WorkClaim): WorkClaim
        => WorkClaim("ModelMeshReport Structure: ComponentsOf builds and component-check element visits per element",
            Insertions(8).Add(Flips(1)), [6, 64], n => ComponentChecksWorkAt(n));
}

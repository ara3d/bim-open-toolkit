//==
// # Conversions to the stdlib mesh types: laws
//
// Every conversion keeps the positions (copied, so compared exactly), keeps the elements (split
// quads counted as two), and keeps the total area (the same triangle areas summed in another
// grouping, both compensated, so within ResolutionAt of the total: TotalsAgree). The split mesh has its own laws: at least as
// many vertices, the triangulation's connectivity under SourceVertex, each corner's attributes,
// and no needless split.
//
// Sections, in order:
//  - Triangle mesh
//  - Quad mesh
//  - Polygon mesh
//  - Split triangle mesh
//  - Helpers

library ModelMeshConversionsLaws
{
    //==
    // # Triangle mesh

    // ToTriangleMesh3D keeps the positions.
    Law_TriangleMeshKeepsPositions(mesh: ModelMesh): Boolean
        => IsSamePoints(mesh.ToTriangleMesh3D.Positions, mesh.Positions);

    // ToTriangleMesh3D has the triangles plus two triangles per quad.
    Law_TriangleMeshSplitsEachQuadInTwo(mesh: ModelMesh): Boolean
        => mesh.ToTriangleMesh3D.Faces.Count == mesh.Triangles.Count + 2 * mesh.Quads.Count;

    // Slot s of triangle k of ToTriangleMesh3D is the vertex of model mesh corner
    // TriangulatedCorner(k, s), so per-corner attributes can be carried to the triangulation.
    Law_TriangulatedCornerNamesTheTriangleCorner(mesh: ModelMesh, k: Integer, s: Integer): Boolean
        => (mesh.ToTriangleMesh3D.Faces.IsValidIndex(k) ? (s >= 0 && s < 3) : false)
            ? mesh.ToTriangleMesh3D.Faces[k].At(s).Value == mesh.CornerVertex(mesh.TriangulatedCorner(k, s)).Value
            : true;

    // ToTriangleMesh3D keeps the total area, within the rounding of the two totals (TotalsAgree).
    Law_TriangleMeshKeepsArea(mesh: ModelMesh): Boolean
        => mesh.HasAllValidCorners
            ? TotalsAgree(mesh.ToTriangleMesh3D.Primitives.Map(t => t.Area).CompensatedSum, mesh.Area)
            : true;

    //==
    // # Quad mesh

    // ToQuadMesh3D succeeds exactly when the mesh has no triangles.
    Law_QuadMeshIsOkExactlyWithoutTriangles(mesh: ModelMesh): Boolean
        => mesh.ToQuadMesh3D.Ok == mesh.Triangles.IsEmpty;

    // ToQuadMesh3D keeps the positions, whether or not it succeeds.
    Law_QuadMeshKeepsPositions(mesh: ModelMesh): Boolean
        => IsSamePoints(mesh.ToQuadMesh3D.Mesh.Positions, mesh.Positions);

    // When ToQuadMesh3D succeeds it keeps the total area, within the rounding of the two totals.
    Law_QuadMeshKeepsAreaWhenOk(mesh: ModelMesh): Boolean
        => (mesh.ToQuadMesh3D.Ok ? mesh.HasAllValidCorners : false)
            ? TotalsAgree(mesh.ToQuadMesh3D.Mesh.Primitives.Map(q => q.Area).CompensatedSum, mesh.Area)
            : true;

    //==
    // # Polygon mesh

    // ToPolygonMesh3D keeps the positions.
    Law_PolygonMeshKeepsPositions(mesh: ModelMesh): Boolean
        => IsSamePoints(mesh.ToPolygonMesh3D.Positions, mesh.Positions);

    // ToPolygonMesh3D has one face per element.
    Law_PolygonMeshHasOneFacePerElement(mesh: ModelMesh): Boolean
        => mesh.ToPolygonMesh3D.Faces.RowCount == mesh.ElementCount;

    // ToPolygonMesh3D keeps the total area, measured through the stdlib's fan triangulation, which
    // splits a quad along A-C as this layer does; within the rounding of the two totals.
    Law_PolygonMeshKeepsArea(mesh: ModelMesh): Boolean
        => mesh.HasAllValidCorners
            ? TotalsAgree(mesh.ToPolygonMesh3D.ToTriangleMesh.Primitives.Map(t => t.Area).CompensatedSum, mesh.Area)
            : true;

    //==
    // # Split triangle mesh

    // The split mesh has at least as many vertices as the model mesh: every vertex an element
    // references becomes one split vertex or more. Guarded by IsEveryVertexReferenced, because an
    // unreferenced vertex has no corner and so no attributes, and is dropped rather than given
    // invented ones.
    Law_SplitHasAtLeastAsManyVertices(mesh: ModelMesh): Boolean
        => mesh.IsWellFormed
            ? (mesh.IsEveryVertexReferenced
                ? mesh.ToSplitTriangleMesh3D.Mesh.Positions.Count >= mesh.Positions.Count
                : true)
            : true;

    // The split mesh has the same elements as ToTriangleMesh3D: the triangles plus two per quad.
    Law_SplitSplitsEachQuadInTwo(mesh: ModelMesh): Boolean
        => mesh.IsWellFormed
            ? (mesh.ToSplitTriangleMesh3D.Mesh.Faces.Count == mesh.Triangles.Count + 2 * mesh.Quads.Count)
            : true;

    // The split mesh has one normal per vertex.
    Law_SplitHasOneNormalPerVertex(mesh: ModelMesh): Boolean
        => mesh.IsWellFormed
            ? (mesh.ToSplitTriangleMesh3D.Normals.Count == mesh.ToSplitTriangleMesh3D.Mesh.Positions.Count)
            : true;

    // The split mesh has one uv per vertex.
    Law_SplitHasOneUvPerVertex(mesh: ModelMesh): Boolean
        => mesh.IsWellFormed
            ? (mesh.ToSplitTriangleMesh3D.Uvs.Count == mesh.ToSplitTriangleMesh3D.Mesh.Positions.Count)
            : true;

    // The split mesh has one source vertex per vertex.
    Law_SplitHasOneSourcePerVertex(mesh: ModelMesh): Boolean
        => mesh.IsWellFormed
            ? (mesh.ToSplitTriangleMesh3D.SourceVertex.Count == mesh.ToSplitTriangleMesh3D.Mesh.Positions.Count)
            : true;

    // A split vertex sits at its source vertex's position.
    Law_SplitVertexKeepsItsSourcePosition(mesh: ModelMesh, v: VertexIndex): Boolean
        => mesh.IsWellFormed
            ? ((mesh.ToSplitTriangleMesh3D.Mesh.Positions.IsValidIndex(v)
                    ? mesh.ToSplitTriangleMesh3D.SourceVertex.IsValidIndex(v)
                    : false)
                ? mesh.PositionIs(mesh.ToSplitTriangleMesh3D.SourceVertex[v], mesh.ToSplitTriangleMesh3D.Mesh.Positions[v])
                : true)
            : true;

    // Under SourceVertex the split mesh's triangles are ToTriangleMesh3D's: splitting changes which
    // vertex a corner names, never which model vertex it stands for.
    Law_SplitFollowsTheTriangulation(mesh: ModelMesh, k: Integer, s: Integer): Boolean
        => mesh.IsWellFormed
            ? ((mesh.ToSplitTriangleMesh3D.Mesh.Faces.IsValidIndex(k) ? (s >= 0 && s < 3) : false)
                ? mesh.ToSplitTriangleMesh3D.SourceOfCorner(k, s).Value == mesh.CornerVertex(mesh.TriangulatedCorner(k, s)).Value
                : true)
            : true;

    // The split vertex at slot s of triangle k carries that corner's normal.
    Law_SplitVertexCarriesItsCornerNormal(mesh: ModelMesh, k: Integer, s: Integer): Boolean
        => mesh.IsWellFormed
            ? ((mesh.ToSplitTriangleMesh3D.Mesh.Faces.IsValidIndex(k) ? (s >= 0 && s < 3) : false)
                ? mesh.ToSplitTriangleMesh3D.NormalIs(mesh.ToSplitTriangleMesh3D.Mesh.Faces[k].At(s),
                    mesh.CornerNormals, mesh.TriangulatedCorner(k, s))
                : true)
            : true;

    // The split vertex at slot s of triangle k carries that corner's uv.
    Law_SplitVertexCarriesItsCornerUv(mesh: ModelMesh, k: Integer, s: Integer): Boolean
        => mesh.IsWellFormed
            ? ((mesh.ToSplitTriangleMesh3D.Mesh.Faces.IsValidIndex(k) ? (s >= 0 && s < 3) : false)
                ? mesh.ToSplitTriangleMesh3D.UvIs(mesh.ToSplitTriangleMesh3D.Mesh.Faces[k].At(s),
                    mesh.CornerUvs, mesh.TriangulatedCorner(k, s))
                : true)
            : true;

    // No vertex is split needlessly: two split vertices differ in their source vertex, their normal,
    // or their uv.
    Law_SplitVerticesDiffer(mesh: ModelMesh, a: VertexIndex, b: VertexIndex): Boolean
        => mesh.IsWellFormed
            ? ((a.Value != b.Value && mesh.ToSplitTriangleMesh3D.HasVertexRecord(a) && mesh.ToSplitTriangleMesh3D.HasVertexRecord(b))
                ? (mesh.ToSplitTriangleMesh3D.SourceVertex[a].Value != mesh.ToSplitTriangleMesh3D.SourceVertex[b].Value
                    || mesh.ToSplitTriangleMesh3D.Normals[a] != mesh.ToSplitTriangleMesh3D.Normals[b]   // exact by construction
                    || mesh.ToSplitTriangleMesh3D.Uvs[a] != mesh.ToSplitTriangleMesh3D.Uvs[b])          // exact by construction
                : true)
            : true;

    //==
    // # Helpers

    // Whether two position arrays are equal entry by entry.
    IsSamePoints(a: Array<Point3D>, b: Array<Point3D>): Boolean
        => a.Count == b.Count ? a.Count.MapRange(k => a[k] == b[k]).All(x => x) : false;   // exact by construction

    // The model mesh vertex that slot s of split triangle k stands for; -1 when it has none.
    SourceOfCorner(split: SplitTriangleMesh3D, k: Integer, s: Integer): VertexIndex
        => split.SourceVertex.IsValidIndex(split.Mesh.Faces[k].At(s))
            ? split.SourceVertex[split.Mesh.Faces[k].At(s)]
            : VertexIndex(-1);

    // Whether split vertex v has a source, a normal, and a uv.
    HasVertexRecord(split: SplitTriangleMesh3D, v: VertexIndex): Boolean
        => split.SourceVertex.IsValidIndex(v) && split.Normals.IsValidIndex(v) && split.Uvs.IsValidIndex(v);

    // Whether split vertex v's normal is entry c of a corner normal array.
    NormalIs(split: SplitTriangleMesh3D, v: VertexIndex, normals: Array<Direction3D>, c: CornerIndex): Boolean
        => (split.Normals.IsValidIndex(v) ? normals.IsValidIndex(c) : false)
            ? split.Normals[v] == normals[c]   // exact by construction
            : false;

    // Whether split vertex v's uv is entry c of a corner uv array.
    UvIs(split: SplitTriangleMesh3D, v: VertexIndex, uvs: Array<UvCoordinate>, c: CornerIndex): Boolean
        => (split.Uvs.IsValidIndex(v) ? uvs.IsValidIndex(c) : false)
            ? split.Uvs[v] == uvs[c]   // exact by construction
            : false;
}

//==
// # Model mesh measures: laws
//
// Two kinds of approximate law. A model law compares a geometric quantity with the model's own
// tolerance, a LengthTolerance parameter (degenerate elements, coincident vertices). A rounding law
// states an identity that holds exactly in real arithmetic (a sum regrouped, an orientation
// reversed, the angles of a triangle) and is judged by 00-foundation's ResolutionAt of the
// magnitude its rounding scales with, never by a model tolerance, which is a statement about the
// file and may be far larger or smaller than the rounding (reviews/MATH-REVIEW-layers-0-6.md F7).
// Exact laws compare integers, indices, or signs. Each law guards what it reads, so it is total.
//
// Sections, in order:
//  - Area and volume
//  - Angles and the discrete Gauss-Bonnet identity
//  - Degenerate elements, coincident vertices, folds
//  - Helpers

library ModelMeshMeasuresLaws
{
    //==
    // # Area and volume

    // Library law: the assembled mesh's area is the sum of its face meshes' areas. The assembly
    // copies every position and keeps every element, so the element areas are the same numbers
    // bitwise and only the grouping of the sum differs; with both totals compensated
    // (CompensatedSum) they agree within ResolutionAt of the total (TotalsAgree), for meshes of any
    // size. A model tolerance would be the wrong yardstick: this is a law about rounding
    // (reviews/MATH-REVIEW-layers-0-6.md F7).
    Law_AreaIsSumOfFaceMeshAreas(m: BrepModel, faceMeshes: Array<FaceMesh>, n: MeshVertexNumbering): Boolean
        => (m.CanAssemble(faceMeshes, n) ? m.AssembleModelMesh(faceMeshes, n).HasAllValidCorners : false)
            ? TotalsAgree(m.AssembleModelMesh(faceMeshes, n).Area, faceMeshes.Map(fm => fm.FaceMeshArea).CompensatedSum)
            : true;

    // Library law: reversing every element changes the sign of the signed volume. Each
    // tetrahedron's volume is negated exactly in real arithmetic; in floating point the triple
    // product of the reversed triangle rounds differently, so the two volumes may differ by the
    // rounding of both, which VolumeRoundingMagnitude bounds: within ResolutionAt of it.
    Law_ReversalNegatesSignedVolume(mesh: ModelMesh): Boolean
        => mesh.HasAllValidCorners
            ? (mesh.Reversed.SignedVolume + mesh.SignedVolume).Abs <= ResolutionAt(mesh.VolumeRoundingMagnitude)
            : true;

    // Library law: the vector area of a closed, consistently oriented component vanishes
    // (research/VALIDATION-MATH.md 4.6), within ResolutionAt of its rounding magnitude
    // (reviews/MATH-REVIEW-layers-0-6.md M11). Exact in real arithmetic for any positions, so a
    // failure is a defect in the orientation or counting code, not a finding about the mesh.
    Law_VectorAreaVanishes(mesh: ModelMesh, c: MeshComponentIndex): Boolean
        => (mesh.HasAllValidCorners && mesh.CountsOf(c).IsClosed && mesh.CountsOf(c).IsConsistentlyOriented)
            ? mesh.ComponentVectorArea(mesh.ComponentsOf, c).Length
                <= ResolutionAt(mesh.VectorAreaRoundingMagnitude(mesh.ComponentsOf, c))
            : true;

    // The outward-wound unit tetrahedron has positive signed volume (1/6): the sign convention, on
    // a witness whose orientation is known independently of the code.
    Law_OutwardTetrahedronHasPositiveVolume(_: ModelMesh): Boolean
        => ModelMesh.Witness_UnitTetrahedron.SignedVolume > 0.0;

    //==
    // # Angles and the discrete Gauss-Bonnet identity

    // A triangle's angles sum to pi, within the rounding of the angle sum (AngleSumResolution).
    // Exact in real arithmetic for every triangle without a zero-length side, collinear ones
    // included (0 + 0 + pi), so it fails exactly on a triangle with a zero-length side, whose angles
    // at that side are 0, or on a defect in the angle code. Error.
    Law_TriangleAngleSumIsPi(mesh: ModelMesh, e: ElementIndex): Boolean
        => (mesh.IsTriangle(e) ? mesh.HasValidCorners(e) : false)
            ? (mesh.ElementAngleSum(e) - Number.Pi).Abs <= Angle.AngleSumResolution
            : true;

    // A quad's angle defect is not negative: its angles sum to at most 2 pi
    // (research/VALIDATION-MATH.md 4.5, lemma), within the rounding of the angle sum.
    Law_QuadAngleDefectIsNotNegative(mesh: ModelMesh, e: ElementIndex): Boolean
        => (mesh.IsQuad(e) ? mesh.HasValidCorners(e) : false)
            ? mesh.QuadAngleDefect(e).Radians >= 0.0 - Angle.AngleSumResolution
            : true;

    // Discrete Gauss-Bonnet on a closed all-triangle component: its angle defects sum to 2 pi times
    // its Euler characteristic, within the rounding of the defect sum (DefectSumResolution). What it
    // checks, and what it does not: the proof uses only that each triangle's angles sum to pi and
    // that 3T = 2E, so it holds for any vertex positions at all. It cannot detect wrong geometry, a
    // wrong Euler characteristic relative to the model (comparing with the B-rep's is
    // 07-validation's Law_AngleDefectMatchesBrepEuler), or a pinched vertex. It does detect a
    // triangle with a zero-length side, an element list inconsistent with the counts behind chi,
    // and an error in either of two independently written computations.
    Law_AngleDefectSumIsTwoPiTimesEuler(mesh: ModelMesh, c: MeshComponentIndex): Boolean
        => (mesh.HasAllValidCorners && mesh.CountsOf(c).IsClosed && mesh.CountsOf(c).Quads == 0
                && mesh.CountsOf(c).Vertices > 0)
            ? (mesh.AngleDefectSum(mesh.ComponentsOf, c).Radians
                    - Number.Tau * mesh.CountsOf(c).EulerCharacteristic.ToNumber).Abs
                <= DefectSumResolution(mesh.CountsOf(c).Vertices, 0, 3 * mesh.CountsOf(c).Triangles)
            : true;

    // Discrete Gauss-Bonnet on a closed component with quads: the angle defects sum to 2 pi times
    // the Euler characteristic plus the quads' own angle defects, within the rounding of the two
    // sums. Since a quad's defect is 0 exactly when it is planar and convex, the excess measures the
    // total non-planarity of the quads.
    Law_AngleDefectSumIsTwoPiTimesEulerPlusQuadDefects(mesh: ModelMesh, c: MeshComponentIndex): Boolean
        => (mesh.HasAllValidCorners && mesh.CountsOf(c).IsClosed && mesh.CountsOf(c).Vertices > 0)
            ? (mesh.AngleDefectSum(mesh.ComponentsOf, c).Radians
                    - mesh.QuadAngleDefectSum(mesh.ComponentsOf, c).Radians
                    - Number.Tau * mesh.CountsOf(c).EulerCharacteristic.ToNumber).Abs
                <= DefectSumResolution(mesh.CountsOf(c).Vertices, mesh.CountsOf(c).Quads,
                    3 * mesh.CountsOf(c).Triangles + 4 * mesh.CountsOf(c).Quads)
            : true;

    //==
    // # Degenerate elements, coincident vertices, folds

    // Model law (Error): no element names one vertex at two corners.
    ElementHasNoRepeatedCorner(mesh: ModelMesh, e: ElementIndex): Boolean
        => mesh.IsElementInRange(e) ? mesh.HasRepeatedCorner(e).Not : true;

    // Model law (Error): every element's smallest altitude exceeds the model's length tolerance
    // (research/VALIDATION-MATH.md 4.2), which excludes both collapsed elements and needles.
    ElementIsNotDegenerate(mesh: ModelMesh, e: ElementIndex, tol: LengthTolerance): Boolean
        => mesh.HasValidCorners(e) ? mesh.ElementSmallestAltitude(e) > tol.Value : true;

    // Model law (Error): two distinct vertices of one component are farther apart than the model's
    // length tolerance. With one discretization per edge a correct mesh has no coincident vertices
    // inside a component; a pair that is coincident is a crack that index identity left open.
    VerticesOfOneComponentAreApart(mesh: ModelMesh, a: VertexIndex, b: VertexIndex,
        tol: LengthTolerance): Boolean
        => (mesh.Positions.IsValidIndex(a) && mesh.Positions.IsValidIndex(b) && a.Value != b.Value
                && mesh.ComponentsOf.VertexComponentOf(a).Value >= 0
                && mesh.ComponentsOf.VertexComponentOf(a).Value == mesh.ComponentsOf.VertexComponentOf(b).Value)
            ? mesh.Positions[a].Distance(mesh.Positions[b]) > tol.Value
            : true;

    // Library law: every pair CoincidentVertexPairs reports is two vertices of one component, the
    // first lower, within the tolerance.
    Law_ReportedPairIsCoincident(mesh: ModelMesh, k: Integer, tol: LengthTolerance): Boolean
        => mesh.CoincidentVertexPairs(mesh.ComponentsOf, tol).IsValidIndex(k)
            ? mesh.IsCoincidentPair(mesh.CoincidentVertexPairs(mesh.ComponentsOf, tol)[k], tol)
            : true;

    // Library law: every coincident pair is reported.
    Law_CoincidentPairIsReported(mesh: ModelMesh, a: VertexIndex, b: VertexIndex,
        tol: LengthTolerance): Boolean
        => mesh.IsCoincidentPair(VertexPair(a, b), tol)
            ? mesh.CoincidentVertexPairs(mesh.ComponentsOf, tol).Any(p => p.A.Value == a.Value && p.B.Value == b.Value)
            : true;

    // Model law (Error): no element is folded: its normal agrees in direction with the face normal
    // at each of its corners.
    ElementIsNotFolded(mesh: ModelMesh, e: ElementIndex): Boolean
        => (mesh.HasValidCorners(e) ? mesh.HasValidCornerAttributes(e) : false)
            ? mesh.SurfaceAlignmentAt(e) > 0.0
            : true;

    //==
    // # Helpers

    // Whether a pair names two vertices of the mesh in one component, the first lower, whose
    // distance is at most the tolerance.
    IsCoincidentPair(mesh: ModelMesh, p: VertexPair, tol: LengthTolerance): Boolean
        => (mesh.Positions.IsValidIndex(p.A) && mesh.Positions.IsValidIndex(p.B) && p.A.Value < p.B.Value
                && mesh.ComponentsOf.VertexComponentOf(p.A).Value >= 0
                && mesh.ComponentsOf.VertexComponentOf(p.A).Value == mesh.ComponentsOf.VertexComponentOf(p.B).Value)
            ? mesh.Positions[p.A].Distance(mesh.Positions[p.B]) <= tol.Value
            : false;
}

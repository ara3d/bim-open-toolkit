//==
// # Mesh vertex numbering: functions
//
// Every body here is its own specification; nothing is deferred. Out-of-range inputs never index
// out of range: a function that cannot name a vertex returns the index -1 (none) or the site
// ModelVertex(-1), the stdlib's absence encoding (CONVENTIONS.md, "Typed indices").
//
// Sections, in order:
//  - Runs of an offset array
//  - Sites to indices and back
//  - Provenance and sites
//  - Building the numbering
//  - Face mesh points to sites and global vertices
//  - Boundary samples shared between face meshes

library ModelMeshNumbering
{
    //==
    // # Runs of an offset array
    //
    // Run k of an offset array holds the indices from starts[k] up to, not including,
    // starts[k + 1]. An array of n + 1 starts has n runs. CountTrue and 00-foundation's
    // IntegerTotal serve every counting function of the layer.

    // The number of true entries.
    CountTrue(flags: Array<Boolean>): Integer
        => flags.Map(b => b ? 1 : 0).IntegerTotal;

    // The number of global mesh vertices the numbering covers: the end of the last face run. A
    // numbering with no face starts, which no constructor produces, has only its model vertices.
    NumberedVertexCount(n: MeshVertexNumbering): Integer
        => n.FaceInteriorStart.IsEmpty ? n.ModelVertexCount : n.FaceInteriorStart.Last;

    // The length of run k of an offset array; 0 when k names no run. Negative when the array
    // decreases there, which the numbering laws forbid.
    RunLength(starts: Array<Integer>, k: Integer): Integer
        => (k >= 0 && k + 1 < starts.Count) ? starts[k + 1] - starts[k] : 0;

    // The largest k in 0 to starts.Count - 2 with starts[k] <= i, by bisection; -1 when there is
    // none. For a non-decreasing offset array and starts[0] <= i < starts.Last it is the run that
    // holds i, with the empty runs before that run skipped.
    RunContaining(starts: Array<Integer>, i: Integer): Integer
    {
        var lo = 0;
        var hi = starts.Count - 2;
        var found = -1;
        while (lo <= hi)
        {
            var mid = (lo + hi) / 2;
            if (starts[mid] <= i)
            {
                found = mid;
                lo = mid + 1;
            }
            else
            {
                hi = mid - 1;
            }
        }
        return found;
    }

    // The number of interior points edge e contributes to the numbering.
    EdgeInteriorCount(n: MeshVertexNumbering, e: BrepEdgeIndex): Integer
        => n.EdgeInteriorStart.RunLength(e.Value);

    // The number of face-interior vertices face f contributes to the numbering.
    FaceInteriorCount(n: MeshVertexNumbering, f: BrepFaceIndex): Integer
        => n.FaceInteriorStart.RunLength(f.Value);

    //==
    // # Sites to indices and back

    // Whether the numbering has a slot for a site: a model vertex below ModelVertexCount, or a slot
    // inside the run of its edge or face.
    HasSite(n: MeshVertexNumbering, s: MeshVertexSite): Boolean
        => match (s) {
               ModelVertex(v) => v.Value >= 0 && v.Value < n.ModelVertexCount;
               EdgeInterior(e, slot) => slot >= 0 && slot < n.EdgeInteriorCount(e);
               FaceInterior(f, slot) => slot >= 0 && slot < n.FaceInteriorCount(f);
           };

    // The global index of a site: model vertex v is index v, the slot-th interior point of edge e
    // is EdgeInteriorStart[e] + slot, the slot-th interior vertex of face f is
    // FaceInteriorStart[f] + slot. A site the numbering has no slot for maps to -1 (none).
    IndexOfSite(n: MeshVertexNumbering, s: MeshVertexSite): VertexIndex
        => n.HasSite(s) ? n.IndexOfKnownSite(s) : VertexIndex(-1);

    // IndexOfSite for a site the numbering has a slot for. Precondition: n.HasSite(s).
    IndexOfKnownSite(n: MeshVertexNumbering, s: MeshVertexSite): VertexIndex
        => match (s) {
               ModelVertex(v) => VertexIndex(v.Value);
               EdgeInterior(e, slot) => VertexIndex(n.EdgeInteriorStart[e] + slot);
               FaceInterior(f, slot) => VertexIndex(n.FaceInteriorStart[f] + slot);
           };

    // The site of global index i: the inverse of IndexOfSite over 0 to NumberedVertexCount - 1
    // (the laws state both directions). An index outside that range maps to ModelVertex(-1).
    SiteAt(n: MeshVertexNumbering, i: VertexIndex): MeshVertexSite
        => (i.Value < 0 || i.Value >= n.NumberedVertexCount)
            ? MeshVertexSite.ModelVertex(BrepVertexIndex(-1))
            : (i.Value < n.ModelVertexCount
                ? MeshVertexSite.ModelVertex(BrepVertexIndex(i.Value))
                : n.InteriorSiteAt(i.Value));

    // The site of an index at or past ModelVertexCount and below NumberedVertexCount: a
    // face-interior site when the index lies in a face run, else an edge-interior site.
    InteriorSiteAt(n: MeshVertexNumbering, i: Integer): MeshVertexSite
    {
        var f = n.FaceInteriorStart.RunContaining(i);
        var e = n.EdgeInteriorStart.RunContaining(i);
        return f >= 0
            ? MeshVertexSite.FaceInterior(BrepFaceIndex(f), i - n.FaceInteriorStart[f])
            : (e >= 0
                ? MeshVertexSite.EdgeInterior(BrepEdgeIndex(e), i - n.EdgeInteriorStart[e])
                : MeshVertexSite.ModelVertex(BrepVertexIndex(-1)));
    }

    //==
    // # Provenance and sites
    //
    // A MeshVertexProvenance (00-foundation) names the cell a vertex lies on and where on it (a
    // parameter, a uv). A site names the cell and which sample of it the vertex is. The slot
    // completes a provenance into a site.

    // The site of the slot-th sample of the cell a provenance names. OnVertex names the model
    // vertex itself and ignores the slot. The provenance's parameter or uv does not enter: identity
    // is combinatorial, never metric.
    SiteOf(p: MeshVertexProvenance, slot: Integer): MeshVertexSite
        => match (p) {
               OnVertex(v) => MeshVertexSite.ModelVertex(v);
               OnEdge(e, t) => MeshVertexSite.EdgeInterior(e, slot);
               OnFace(f, uv) => MeshVertexSite.FaceInterior(f, slot);
           };

    // The global index of the slot-th sample of the cell a provenance names (VOCABULARY.md, fixed).
    GlobalIndex(n: MeshVertexNumbering, p: MeshVertexProvenance, slot: Integer): VertexIndex
        => n.IndexOfSite(p.SiteOf(slot));

    // Whether a site and a provenance name the same model cell. The slot, the parameter, and the
    // uv are not compared.
    IsSiteOf(s: MeshVertexSite, p: MeshVertexProvenance): Boolean
        => match (s) {
               ModelVertex(v) => p.IsOnVertex(v);
               EdgeInterior(e, slot) => p.IsOnEdge(e);
               FaceInterior(f, slot) => p.IsOnFace(f);
           };

    // Whether a provenance is model vertex v.
    IsOnVertex(p: MeshVertexProvenance, v: BrepVertexIndex): Boolean
        => match (p) {
               OnVertex(w) => w.Value == v.Value;
               OnEdge(e, t) => false;
               OnFace(f, uv) => false;
           };

    // Whether a provenance lies in the interior of edge e.
    IsOnEdge(p: MeshVertexProvenance, e: BrepEdgeIndex): Boolean
        => match (p) {
               OnVertex(w) => false;
               OnEdge(edge, t) => edge.Value == e.Value;
               OnFace(f, uv) => false;
           };

    // Whether a provenance names a point of the closure of face f: the face itself, an edge its
    // bounds cite, or a vertex its bounds reference (vertex loops included). Precondition:
    // m.IsFaceIntact(f).
    IsOnClosureOfFace(m: BrepModel, p: MeshVertexProvenance, f: BrepFaceIndex): Boolean
        => match (p) {
               OnVertex(v) => m.Faces[f].Bounds.Any(b => m.BoundVertices(b).Any(w => w.Value == v.Value));
               OnEdge(e, t) => m.FaceUsesEdge(f, e);
               OnFace(face, uv) => face.Value == f.Value;
           };

    // Whether a provenance lies in the interior of some face.
    IsInFaceInterior(p: MeshVertexProvenance): Boolean
        => match (p) {
               OnVertex(w) => false;
               OnEdge(e, t) => false;
               OnFace(f, uv) => true;
           };

    // Whether two integer arrays are equal entry by entry.
    IsSameIntegers(a: Array<Integer>, b: Array<Integer>): Boolean
        => a.Count == b.Count ? a.Count.MapRange(k => a[k] == b[k]).All(x => x) : false;

    // Whether two numberings are equal field by field: the same model vertex count and the same
    // runs, so every site has the same index in both.
    IsSameNumbering(a: MeshVertexNumbering, b: MeshVertexNumbering): Boolean
        => a.ModelVertexCount == b.ModelVertexCount
            && IsSameIntegers(a.EdgeInteriorStart, b.EdgeInteriorStart)
            && IsSameIntegers(a.FaceInteriorStart, b.FaceInteriorStart);

    //==
    // # Building the numbering

    // The offsets of consecutive runs with the given lengths, the first starting at first:
    // counts.Count + 1 entries, entry k being first plus counts[0] to counts[k - 1].
    RunStarts(first: Integer, counts: Array<Integer>): Array<Integer>
    {
        var starts = new List<Integer>();
        var total = first;
        starts = starts.Add(total);
        var k = 0;
        while (k < counts.Count)
        {
            total = total + counts[k];
            starts = starts.Add(total);
            k = k + 1;
        }
        return starts.Freeze();
    }

    // The interior point count of edge e's discretization: every point but the two that are its
    // vertices; 0 for an edge with no discretization.
    InteriorPointCount(d: EdgeDiscretizations, e: BrepEdgeIndex): Integer
        => d.ByEdge.IsValidIndex(e) ? (d.ByEdge[e].Points.Count - 2).Max(0) : 0;

    // Whether a parameter-space point source is a point of edge e's discretization.
    IsFromEdge(s: UvPointSource, e: BrepEdgeIndex): Boolean
        => match (s) {
               FromVertex(v) => false;
               FromEdge(edge, k) => edge.Value == e.Value;
               SeamCut(side, k) => false;
               Pole(side, k) => false;
               Interior => false;
           };

    // Whether some face mesh has a parameter-space point on edge e's discretization.
    CitesEdge(faceMeshes: Array<FaceMesh>, e: BrepEdgeIndex): Boolean
        => faceMeshes.Any(fm => fm.Sources.Any(s => s.IsFromEdge(e)));

    // The number of a face mesh's local 3D vertices whose provenance is OnFace.
    FaceInteriorVertexCount(fm: FaceMesh): Integer
        => fm.Provenance.Map(p => p.IsInFaceInterior).CountTrue;

    // The numbering of a model's mesh vertices. Model vertices: all of them, so that mesh vertex v
    // is model vertex v even when no face mesh reaches v (it is then an unreferenced vertex, which
    // the topology layer counts). Edge runs: the interior point count of the edge's discretization
    // when some face mesh cites the edge, else empty, so an edge whose faces all failed to mesh
    // leaves no vertex without a position. Face runs: the face mesh's face-interior vertex count.
    // faceMeshes is indexed by BrepFaceIndex (see CanAssemble); a face with no entry gets an empty
    // run. Reference body: CitesEdge makes it quadratic, where one pass marking cited edges is
    // linear in the total size of the face meshes.
    NumberMeshVertices(m: BrepModel, d: EdgeDiscretizations, faceMeshes: Array<FaceMesh>): MeshVertexNumbering
    {
        var edgeCounts = m.Edges.Count.MapRange(k => faceMeshes.CitesEdge(BrepEdgeIndex(k))
            ? d.InteriorPointCount(BrepEdgeIndex(k))
            : 0);
        var faceCounts = m.Faces.Count.MapRange(k => faceMeshes.IsValidIndex(k)
            ? faceMeshes[k].FaceInteriorVertexCount
            : 0);
        var edgeStarts = RunStarts(m.Vertices.Count, edgeCounts);
        return MeshVertexNumbering(m.Vertices.Count, edgeStarts, RunStarts(edgeStarts.Last, faceCounts));
    }

    //==
    // # Face mesh points to sites and global vertices
    //
    // A FaceMesh (05-face-meshing) has parameter-space points with a source each, and local 3D
    // vertices with a position and a provenance each; LocalVertex maps the first to the second, so
    // the two parameter-space copies of a seam point share one local vertex. Elements index
    // parameter-space points. The site of a parameter-space point is read from its source when the
    // source is a model vertex or an edge sample, and from its local vertex's rank otherwise.

    // The rank of local vertex lv among the face mesh's face-interior local vertices: how many local
    // vertices before it have provenance OnFace. It is the slot of lv's face-interior site.
    FaceInteriorRank(fm: FaceMesh, lv: VertexIndex): Integer
        => lv.Value.Max(0).Min(fm.Provenance.Count)
            .MapRange(k => fm.Provenance[k].IsInFaceInterior)
            .CountTrue;

    // The face-interior site of the local 3D vertex of parameter-space point i. Slot -1 when i has
    // no local vertex.
    InteriorSiteOf(fm: FaceMesh, i: VertexIndex): MeshVertexSite
        => MeshVertexSite.FaceInterior(fm.Face,
            fm.LocalVertex.IsValidIndex(i) ? fm.FaceInteriorRank(fm.LocalVertex[i]) : -1);

    // The site of parameter-space point i of a face mesh: the model vertex for FromVertex; for
    // FromEdge(e, k), discretization point k of edge e, which is interior slot k - 1; otherwise (a
    // synthetic seam point, a synthetic pole point, a refinement point) the face-interior site of
    // the point's local vertex, so both copies of a seam point get one site. An index out of range
    // maps to ModelVertex(-1), meaning none.
    SiteOfUvPoint(fm: FaceMesh, i: VertexIndex): MeshVertexSite
        => fm.Sources.IsValidIndex(i) ? fm.SiteOfSource(i, fm.Sources[i]) : MeshVertexSite.ModelVertex(BrepVertexIndex(-1));

    // SiteOfUvPoint for point i whose source is s.
    SiteOfSource(fm: FaceMesh, i: VertexIndex, s: UvPointSource): MeshVertexSite
        => match (s) {
               FromVertex(v) => MeshVertexSite.ModelVertex(v);
               FromEdge(e, k) => MeshVertexSite.EdgeInterior(e, k - 1);
               SeamCut(side, k) => fm.InteriorSiteOf(i);
               Pole(side, k) => fm.InteriorSiteOf(i);
               Interior => fm.InteriorSiteOf(i);
           };

    // The global vertex of parameter-space point i of a face mesh: the map AssembleModelMesh applies
    // to every element corner. It reads the point's site and nothing else, never its position.
    GlobalVertexOf(n: MeshVertexNumbering, fm: FaceMesh, i: VertexIndex): VertexIndex
        => n.IndexOfSite(fm.SiteOfUvPoint(i));

    //==
    // # Boundary samples shared between face meshes

    // Whether two parameter-space point sources cite the same model boundary sample: the same model
    // vertex, or the same point of the same edge's discretization. Synthetic and interior points
    // belong to one face and are never shared.
    IsSameBoundarySample(a: UvPointSource, b: UvPointSource): Boolean
        => match (a) {
               FromVertex(v) => b.CitesVertex(v);
               FromEdge(e, k) => b.CitesEdgeSample(e, k);
               SeamCut(side, k) => false;
               Pole(side, k) => false;
               Interior => false;
           };

    // Whether a source is model vertex v.
    CitesVertex(s: UvPointSource, v: BrepVertexIndex): Boolean
        => match (s) {
               FromVertex(w) => w.Value == v.Value;
               FromEdge(e, k) => false;
               SeamCut(side, k) => false;
               Pole(side, k) => false;
               Interior => false;
           };

    // Whether a source is point k of edge e's discretization.
    CitesEdgeSample(s: UvPointSource, e: BrepEdgeIndex, k: Integer): Boolean
        => match (s) {
               FromVertex(w) => false;
               FromEdge(edge, j) => edge.Value == e.Value && j == k;
               SeamCut(side, j) => false;
               Pole(side, j) => false;
               Interior => false;
           };
}

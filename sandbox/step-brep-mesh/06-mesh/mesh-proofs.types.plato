//==
// # Proofs about face meshes and the model mesh (types)
//
// TYPE-CATALOG.md section 4, layers 5 and 6; CheckedMesh is chunk Y4 of
// docs/plans/step-mesher-v2.md. Built only by the Check* constructors of
// mesh-proofs.library.plato, except CheckedMesh, whose constructor reads
// layer 7's RestrictedToShell and is in
// 07-validation/validation-proofs.library.plato. Each Decided* sum is its
// constructor's result, in layer 0's pattern. Layer 7's ValidatedReport is
// in validation-proofs.types.plato.
//
// Sections, in order:
//  - Face outcomes
//  - The model mesh
//  - Quads

//==
// # Face outcomes

// Faces[i]'s outcome is Outcomes[i], and every one holds a non-empty mesh
// and no blocking request (HasBlockingRequest false). Removes: assembly
// over a face whose mesh is empty.
type MeshedFaceSet
{
    Faces: Array<BrepFaceIndex>;
    Outcomes: Array<FaceMeshOutcome>;
}

// Every face of Model, in face order, has a meshed outcome: a MeshedFaceSet
// over all of its faces. AssembleModelMesh takes this. Removes: assembly
// over a face whose mesh is empty.
type FullyMeshedModel
{
    Model: BrepModel;
    Outcomes: Array<FaceMeshOutcome>;
}

// A MeshedFaceSet, or why some face is not meshed.
type DecidedMeshedFaceSet
    = Decided(Value: MeshedFaceSet)
    | Undecided(Reason: UndecidedReason);

// A FullyMeshedModel, or why some face of the model is not meshed.
type DecidedFullyMeshedModel
    = Decided(Value: FullyMeshedModel)
    | Undecided(Reason: UndecidedReason);

//==
// # The model mesh

// A well-formed mesh every edge of which has exactly two element sides
// (IsWellFormed, IsClosed): no crack anywhere. Removes: the layer 8 laws
// re-running the closure check per law.
type WatertightMesh
{
    Mesh: ModelMesh;
}

// A well-formed mesh that is manifold, consistently oriented, and closed on
// every shell the model's topology closes, with the counts of each of its
// components (ComponentCountsOf). Chunk Y4. Removes: the layer 8 laws
// re-running the manifold check per law.
type CheckedMesh
{
    Mesh: ModelMesh;
    Counts: Array<MeshComponentCounts>;
}

// A well-formed mesh with the quality of every triangle and quad computed
// once: Triangles[k] of triangle k, Quads[q] of quad q (element
// Triangles.Count + q). Removes: the metrics recomputed by every quality law.
type QualityGradedMesh
{
    Mesh: ModelMesh;
    Triangles: Array<TriangleQuality>;
    Quads: Array<QuadQuality>;
}

// A WatertightMesh, or why the mesh has a boundary edge.
type DecidedWatertightMesh
    = Decided(Value: WatertightMesh)
    | Undecided(Reason: UndecidedReason);

// A CheckedMesh, or why the mesh failed its topology checks.
type DecidedCheckedMesh
    = Decided(Value: CheckedMesh)
    | Undecided(Reason: UndecidedReason);

// A QualityGradedMesh, or why the mesh could not be measured.
type DecidedQualityGradedMesh
    = Decided(Value: QualityGradedMesh)
    | Undecided(Reason: UndecidedReason);

//==
// # Quads

// A face-mesh quad whose corners lie within the criteria's SurfaceChordal of
// their mid-plane, with Deviation that largest distance (QuadWarp).
// Removes: a non-planar quad reaching ToQuadMesh3D.
type PlanarQuad
{
    Quad: QuadFace;
    Deviation: ModelLength;
}

// A face-mesh quad that is strictly convex (IsConvexQuad). Removes: a
// bow-tie quad reaching ToQuadMesh3D.
type ConvexQuad
{
    Quad: QuadFace;
}

// A PlanarQuad, or why the quad is not planar.
type DecidedPlanarQuad
    = Decided(Value: PlanarQuad)
    | Undecided(Reason: UndecidedReason);

// A ConvexQuad, or why the quad is not strictly convex.
type DecidedConvexQuad
    = Decided(Value: ConvexQuad)
    | Undecided(Reason: UndecidedReason);

//==
// # Model mesh topology: specification
//
// The contracts of the three deferred topology functions, the invariants of the edge table and the
// components, and the theorems the components and the genus rest on.
//
// Sections, in order:
//  - The edge table
//  - Components and their counts
//  - Theorems

//==
// # The edge table

// Every edge table lists each undirected edge once, canonically, in order, with one count and one
// direction sum each, the sums consistent with the counts.
spec MeshEdgeTable
{
    invariant EdgeTableHasOneCountPerEdge(self);
    invariant EdgeTableHasOneDirectionSumPerEdge(self);
    invariant forall (k: UndirectedEdgeIndex) : EdgeTableEdgeIsCanonical(self, k);
    invariant forall (k: UndirectedEdgeIndex) : EdgeTableIsStrictlySorted(self, k);
    invariant forall (k: UndirectedEdgeIndex) : EdgeTableListsOnlyUsedEdges(self, k);
    invariant forall (k: UndirectedEdgeIndex) : DirectionSumIsBoundedByCount(self, k);
    invariant forall (k: UndirectedEdgeIndex) : DirectionSumHasTheParityOfCount(self, k);
    constructor EdgeTableOf;
}

// The 1-skeleton of a mesh with its incidence.
spec EdgeTableOf(mesh: ModelMesh): MeshEdgeTable
{
    requires forall (e: ElementIndex) : ElementCornersInRange(mesh, e);
    ensures EdgeTableHasOneCountPerEdge(result);
    ensures EdgeTableHasOneDirectionSumPerEdge(result);
    ensures forall (k: UndirectedEdgeIndex) : EdgeTableEdgeIsCanonical(result, k);
    ensures forall (k: UndirectedEdgeIndex) : EdgeTableIsStrictlySorted(result, k);
    ensures forall (k: UndirectedEdgeIndex) : EdgeTableListsOnlyUsedEdges(result, k);
    ensures forall (e: ElementIndex) : forall (slot: Integer) : Law_EdgeTableListsEveryProperSide(mesh, e, slot);
    ensures forall (k: UndirectedEdgeIndex) : Law_EdgeTableCountMatchesItsSides(mesh, k);
    ensures forall (k: UndirectedEdgeIndex) : Law_EdgeTableDirectionSumMatchesItsSides(mesh, k);
    ensures Law_EdgeTableCountsEveryProperSide(mesh);
    measure mesh.CornerCount;
    deferred "sort the directed element sides by canonical pair and count runs, or hash them";
}

//==
// # Components and their counts

// Every component labelling labels every element and every vertex, with labels in range or -1 for
// an unreferenced vertex.
spec MeshComponents
{
    invariant self.ComponentCount >= 0;
    invariant forall (k: Integer) in self.ElementComponent.Count.Range :
        self.IsComponentInRange(self.ElementComponent[k]);
    invariant forall (k: Integer) in self.VertexComponent.Count.Range :
        self.VertexComponent[k].Value >= -1 && self.VertexComponent[k].Value < self.ComponentCount;
    invariant self.ElementParent.Count == self.ElementComponent.Count;
    invariant self.ElementDepth.Count == self.ElementComponent.Count;
    invariant forall (k: Integer) in self.ElementDepth.Count.Range : self.ElementDepth[k] >= 0;
    constructor ComponentsOf;
}

// The connected components of a mesh, by shared vertices. The contract is exact (theorem
// ComponentsAreTheChainClasses): elements sharing a vertex are forced into one component, and the
// spanning forest (ElementParent, ElementDepth) certifies that each component is joined by chains,
// so no coarser labelling satisfies it. The numbering by lowest element is pinned by the roots.
spec ComponentsOf(mesh: ModelMesh): MeshComponents
{
    requires forall (e: ElementIndex) : ElementCornersInRange(mesh, e);
    ensures result.ElementComponent.Count == mesh.ElementCount;
    ensures result.VertexComponent.Count == mesh.Positions.Count;
    ensures result.ElementParent.Count == mesh.ElementCount;
    ensures result.ElementDepth.Count == mesh.ElementCount;
    ensures forall (e: ElementIndex) : forall (slot: Integer) : Law_ElementCornersShareItsComponent(mesh, e, slot);
    ensures forall (k: Integer) in mesh.Positions.Count.Range :
        (result.VertexComponent[k].Value < 0) == mesh.LinkEdges(VertexIndex(k)).IsEmpty;
    ensures forall (e: ElementIndex) : Law_ComponentParentIsInItsComponent(mesh, e);
    ensures forall (e: ElementIndex) : Law_ComponentParentSharesAVertex(mesh, e);
    ensures forall (e: ElementIndex) : Law_ComponentRootHasDepthZero(mesh, e);
    ensures forall (e: ElementIndex) : Law_ComponentParentIsOneShallower(mesh, e);
    ensures forall (r: ElementIndex) : forall (e: ElementIndex) : Law_ComponentRootIsItsLowestElement(mesh, r, e);
    ensures forall (r: ElementIndex) : Law_ComponentsAreNumberedByRoot(mesh, r);
    ensures Law_ComponentCountIsRootCount(mesh);
    measure mesh.CornerCount;
    deferred "union-find over element-vertex incidence, roots numbered by first element, then a breadth-first spanning forest per component";
}

// The counts of each component, one entry per component.
spec ComponentCountsOf(mesh: ModelMesh, t: MeshEdgeTable, comps: MeshComponents): Array<MeshComponentCounts>
{
    requires t == mesh.EdgeTableOf;
    requires comps == mesh.ComponentsOf;
    ensures result.Count == comps.ComponentCount;
    ensures forall (c: Integer) in comps.ComponentCount.Range :
        result[c].Vertices == comps.ComponentVertexCount(MeshComponentIndex(c));
    ensures forall (c: Integer) in comps.ComponentCount.Range :
        result[c].Edges == t.CountEdges.Range
            .Map(k => comps.VertexComponentOf(t.Edges.UndirectedEdges[k].A).Value == c).CountTrue;
    ensures forall (c: Integer) in comps.ComponentCount.Range :
        result[c].Triangles == mesh.Triangles.Count.Range
            .Map(k => comps.ElementComponentOf(ElementIndex(k)).Value == c).CountTrue;
    ensures forall (c: Integer) in comps.ComponentCount.Range :
        result[c].Quads == mesh.Quads.Count.Range
            .Map(k => comps.ElementComponentOf(ElementIndex(mesh.Triangles.Count + k)).Value == c).CountTrue;
    ensures forall (c: Integer) in comps.ComponentCount.Range :
        result[c].BoundaryEdges == t.CountEdges.Range
            .Map(k => comps.VertexComponentOf(t.Edges.UndirectedEdges[k].A).Value == c
                && t.IsBoundaryEdge(UndirectedEdgeIndex(k))).CountTrue;
    ensures forall (c: Integer) in comps.ComponentCount.Range :
        result[c].NonManifoldEdges == t.CountEdges.Range
            .Map(k => comps.VertexComponentOf(t.Edges.UndirectedEdges[k].A).Value == c
                && t.IsNonManifoldEdge(UndirectedEdgeIndex(k))).CountTrue;
    ensures forall (c: Integer) in comps.ComponentCount.Range :
        result[c].MisorientedEdges == t.CountEdges.Range
            .Map(k => comps.VertexComponentOf(t.Edges.UndirectedEdges[k].A).Value == c
                && t.IsMisorientedEdge(UndirectedEdgeIndex(k))).CountTrue;
    ensures forall (c: Integer) in comps.ComponentCount.Range :
        result[c].PinchedVertices == mesh.Positions.Count.Range
            .Map(k => comps.VertexComponentOf(VertexIndex(k)).Value == c
                && mesh.IsPinchedVertex(VertexIndex(k))).CountTrue;
    ensures forall (c: Integer) in comps.ComponentCount.Range :
        result[c].BoundaryCycles == t.BoundaryEdgesOf(comps, MeshComponentIndex(c)).PieceCount;
    ensures Law_ComponentEulerCharacteristicsAddUp(mesh);
    measure mesh.Positions.Count + t.CountEdges + mesh.ElementCount;
    deferred "one pass each over vertices, table edges, and elements, accumulating by component";
}

//==
// # Theorems

// The components are exactly the classes of elements joined by chains of elements each sharing a
// vertex with the next.
theorem ComponentsAreTheChainClasses
{
    given mesh: ModelMesh, a: ElementIndex, b: ElementIndex;
    assume mesh.IsElementInRange(a);
    assume mesh.IsElementInRange(b);
    conclude (mesh.ComponentsOf.ElementComponentOf(a).Value == mesh.ComponentsOf.ElementComponentOf(b).Value)
        == mesh.IsJoinedByAChain(a, b);
    because "If a chain joins a and b, each step shares a vertex, and Law_ElementCornersShareItsComponent
             puts both elements of the step in that vertex's component, so a and b share a component.
             Conversely, follow parents from a: each step shares a vertex
             (Law_ComponentParentSharesAVertex), stays in the component
             (Law_ComponentParentIsInItsComponent), and lowers the depth by one
             (Law_ComponentParentIsOneShallower), so after depth(a) steps it reaches an element of depth
             0, a root (Law_ComponentRootHasDepthZero). Two roots r, s of one component satisfy r <= s
             and s <= r (Law_ComponentRootIsItsLowestElement), so the root is unique, and the chain
             from a, followed by the reversed chain from b, joins a and b. IsJoinedByAChain is the
             mathematical predicate, not a function of this layer.";
    tested by Law_ElementCornersShareItsComponent, Law_ComponentParentSharesAVertex,
        Law_ComponentParentIsOneShallower, Law_ComponentRootIsItsLowestElement;
}

// A connected, closed, consistently oriented surface has an even Euler characteristic of at most
// 2, and so a genus.
theorem ClosedOrientedSurfacesHaveAGenus
{
    given mesh: ModelMesh, c: MeshComponentIndex;
    assume mesh.CountsOf(c).IsClosed;
    assume mesh.CountsOf(c).IsConsistentlyOriented;
    assume mesh.CountsOf(c).IsSurface;
    conclude mesh.CountsOf(c).HasGenus;
    because "Closed with no non-manifold edge means every edge has two sides; no pinched vertex means
             every vertex link is one cycle; so the component is a closed 2-manifold, connected by
             construction of the components. Consistent orientation makes it orientable. By the
             classification of surfaces it is a sphere with g handles, whose Euler characteristic,
             computed from any cell decomposition (here V - E + F of the mesh), is 2 - 2g: even and
             at most 2.";
    tested by Law_ClosedOrientedSurfaceHasGenus, Law_ClosedComponentEulerIsTwoMinusTwiceGenus;
}

// A connected, consistently oriented surface with boundary has 2 - chi - B even and non-negative,
// B its boundary cycles, and so a genus.
theorem OrientedSurfacesWithBoundaryHaveAGenus
{
    given mesh: ModelMesh, c: MeshComponentIndex;
    assume mesh.CountsOf(c).IsConsistentlyOriented;
    assume mesh.CountsOf(c).IsSurface;
    conclude mesh.CountsOf(c).HasGenus;
    because "No non-manifold edge and no pinched vertex make the component a compact 2-manifold with
             boundary, connected by construction (theorem ComponentsAreTheChainClasses), orientable by
             the consistent orientation. At a boundary vertex the link is one path, whose two ends
             are the two boundary edges there, so the boundary edges form disjoint cycles and
             BoundaryCycles counts the boundary circles. Capping each circle with a disc gives a
             closed oriented surface with Euler characteristic chi + B, which is 2 - 2g; so
             2 - chi - B = 2g, even and non-negative.";
    tested by Law_ClosedOrientedSurfaceHasGenus, Law_OrientedSurfaceWithBoundaryHasGenus,
        Law_EulerIsTwoMinusTwiceGenusMinusBoundaryCycles;
}

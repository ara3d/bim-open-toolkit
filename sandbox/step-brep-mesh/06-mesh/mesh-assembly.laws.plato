//==
// # Assembling the model mesh: laws
//
// The contract of AssembleModelMesh as executable statements. Each law is guarded by CanAssemble,
// so it says nothing about inputs the function does not accept, and by the range of the face,
// element, and slot it names. Each holds for every accepted input; failing one is a defect in the
// assembly (or, for the copied-value laws, in the face meshes it was given). All exact; Error.
//
// Sections, in order:
//  - What the face meshes owe
//  - What the assembly keeps
//  - Where each face mesh corner goes
//  - Watertightness
//  - Helpers

library ModelMeshAssemblyLaws
{
    //==
    // # What the face meshes owe
    //
    // Preconditions of AssembleModelMesh beyond CanAssemble. They are what makes the absence of
    // welding safe: points that are one vertex must already agree, because nothing reconciles them.

    // Two parameter-space points, of one face mesh or of two, with the same site have the same 3D
    // position: both copied from one discretization point or one model vertex.
    Law_FaceMeshesAgreeOnSharedSites(fa: FaceMesh, fb: FaceMesh, i: VertexIndex, j: VertexIndex): Boolean
        => (fa.Sources.IsValidIndex(i) && fb.Sources.IsValidIndex(j) && fa.HasMappedPoints && fb.HasMappedPoints)
            ? (fa.SiteOfUvPoint(i) == fb.SiteOfUvPoint(j)
                ? fa.FaceMeshPoint(i) == fb.FaceMeshPoint(j)   // exact by construction
                : true)
            : true;

    // A parameter-space point that cites a model vertex sits at the model's point for it.
    Law_FaceMeshModelVertexIsModelPoint(m: BrepModel, fm: FaceMesh, i: VertexIndex): Boolean
        => (fm.Sources.IsValidIndex(i) && fm.HasMappedPoints)
            ? fm.IsAtModelVertex(m, i, fm.Sources[i])
            : true;

    //==
    // # What the assembly keeps

    // The assembled mesh carries the numbering it was assembled with.
    Law_AssemblyKeepsTheNumbering(m: BrepModel, faceMeshes: Array<FaceMesh>, n: MeshVertexNumbering): Boolean
        => m.CanAssemble(faceMeshes, n) ? m.AssembleModelMesh(faceMeshes, n).Numbering.IsSameNumbering(n) : true;

    // Every triangle of every face mesh becomes one triangle of the model mesh.
    Law_AssemblyKeepsEveryTriangle(m: BrepModel, faceMeshes: Array<FaceMesh>, n: MeshVertexNumbering): Boolean
        => m.CanAssemble(faceMeshes, n)
            ? m.AssembleModelMesh(faceMeshes, n).Triangles.Count == faceMeshes.TotalTriangleCount
            : true;

    // Every quad of every face mesh becomes one quad of the model mesh.
    Law_AssemblyKeepsEveryQuad(m: BrepModel, faceMeshes: Array<FaceMesh>, n: MeshVertexNumbering): Boolean
        => m.CanAssemble(faceMeshes, n)
            ? m.AssembleModelMesh(faceMeshes, n).Quads.Count == faceMeshes.Map(fm => fm.Quads.Count).IntegerTotal
            : true;

    // A model vertex's position is the model's own point, copied.
    Law_AssembledModelVertexIsModelPoint(m: BrepModel, faceMeshes: Array<FaceMesh>,
        n: MeshVertexNumbering, v: BrepVertexIndex): Boolean
        => (m.CanAssemble(faceMeshes, n) ? m.Vertices.IsValidIndex(v) : false)
            ? m.AssembleModelMesh(faceMeshes, n).PositionIs(VertexIndex(v.Value), m.Vertices[v].Point)
            : true;

    // The position at the global vertex of parameter-space point i of face f's mesh is the
    // position the face mesh gives that point. Two face meshes that share a boundary point must
    // therefore give it one position; nothing chooses between them.
    Law_AssembledPositionIsFaceMeshPosition(m: BrepModel, faceMeshes: Array<FaceMesh>,
        n: MeshVertexNumbering, f: BrepFaceIndex, i: VertexIndex): Boolean
        => (m.CanAssemble(faceMeshes, n) ? (faceMeshes.IsValidIndex(f) ? faceMeshes[f].Sources.IsValidIndex(i) : false) : false)
            ? m.AssembleModelMesh(faceMeshes, n).PositionIs(n.GlobalVertexOf(faceMeshes[f], i), faceMeshes[f].FaceMeshPoint(i))
            : true;

    //==
    // # Where each face mesh corner goes

    // Corner slot of element e of face f's mesh becomes the corner of its assembled element at the
    // global vertex of the corner's parameter-space point.
    Law_AssembledCornerIsGlobalVertexOfFaceMeshCorner(m: BrepModel, faceMeshes: Array<FaceMesh>,
        n: MeshVertexNumbering, f: BrepFaceIndex, e: ElementIndex, slot: Integer): Boolean
        => (m.CanAssemble(faceMeshes, n) ? faceMeshes.HasFaceMeshCorner(f, e, slot) : false)
            ? m.AssembleModelMesh(faceMeshes, n).ElementCorner(faceMeshes.AssembledElement(f, e), slot).Value
                == n.GlobalVertexOf(faceMeshes[f], faceMeshes[f].FaceMeshCorner(e, slot)).Value
            : true;

    // Element e of face f's mesh approximates face f in the model mesh.
    Law_AssembledElementRemembersItsFace(m: BrepModel, faceMeshes: Array<FaceMesh>,
        n: MeshVertexNumbering, f: BrepFaceIndex, e: ElementIndex): Boolean
        => (m.CanAssemble(faceMeshes, n) ? faceMeshes.HasFaceMeshCorner(f, e, 0) : false)
            ? m.AssembleModelMesh(faceMeshes, n).ElementFaceIs(faceMeshes.AssembledElement(f, e), f)
            : true;

    // The uv at an assembled corner is the face mesh's uv of the corner's parameter-space point.
    Law_AssembledCornerUvIsCopied(m: BrepModel, faceMeshes: Array<FaceMesh>, n: MeshVertexNumbering,
        f: BrepFaceIndex, e: ElementIndex, slot: Integer): Boolean
        => (m.CanAssemble(faceMeshes, n) ? faceMeshes.HasFaceMeshCorner(f, e, slot) : false)
            ? m.AssembleModelMesh(faceMeshes, n).CornerUvIsCopied(faceMeshes[f], faceMeshes.AssembledElement(f, e), e, slot)
            : true;

    // The normal at an assembled corner is the face mesh's normal at the corner's parameter-space
    // point.
    Law_AssembledCornerNormalIsCopied(m: BrepModel, faceMeshes: Array<FaceMesh>,
        n: MeshVertexNumbering, f: BrepFaceIndex, e: ElementIndex, slot: Integer): Boolean
        => (m.CanAssemble(faceMeshes, n) ? faceMeshes.HasFaceMeshCorner(f, e, slot) : false)
            ? m.AssembleModelMesh(faceMeshes, n).CornerNormalIsCopied(faceMeshes[f], faceMeshes.AssembledElement(f, e), e, slot)
            : true;

    //==
    // # Watertightness

    // Two element corners, of one face mesh or of two, whose parameter-space points cite the same
    // model vertex or the same point of one edge's discretization are one vertex of the assembled
    // mesh. With both faces adjacent to an edge citing every point of the edge's one discretization
    // (05-face-meshing), the two faces' boundary sides along the edge are the same vertex pairs, so
    // no crack and no T-junction can open there: watertight by index, with no welding by distance.
    Law_AssembledSharedBoundaryCornersCoincide(m: BrepModel, faceMeshes: Array<FaceMesh>,
        n: MeshVertexNumbering, f: BrepFaceIndex, ea: ElementIndex, sa: Integer, g: BrepFaceIndex,
        eb: ElementIndex, sb: Integer): Boolean
        => ((m.CanAssemble(faceMeshes, n) && faceMeshes.HasFaceMeshCorner(f, ea, sa) && faceMeshes.HasFaceMeshCorner(g, eb, sb))
                ? IsSameBoundarySample(faceMeshes.CornerSource(f, ea, sa), faceMeshes.CornerSource(g, eb, sb))
                : false)
            ? m.AssembleModelMesh(faceMeshes, n).ElementCorner(faceMeshes.AssembledElement(f, ea), sa).Value
                == m.AssembleModelMesh(faceMeshes, n).ElementCorner(faceMeshes.AssembledElement(g, eb), sb).Value
            : true;

    //==
    // # Helpers
    //
    // Total comparisons the laws above use: each is false, never an out-of-range read, when an
    // index it needs is missing.

    // Whether point i, whose source is s, sits at the model's point for the model vertex s cites;
    // true when s cites no model vertex. Precondition: fm.HasMappedPoints.
    IsAtModelVertex(fm: FaceMesh, m: BrepModel, i: VertexIndex, s: UvPointSource): Boolean
        => match (s) {
               FromVertex(v) => m.Vertices.IsValidIndex(v)
                   ? fm.FaceMeshPoint(i) == m.Vertices[v].Point   // exact by construction
                   : false;
               FromEdge(e, k) => true;
               SeamCut(side, k) => true;
               Pole(side, k) => true;
               Interior => true;
           };

    // Whether vertex v of the mesh exists and sits exactly at p.
    PositionIs(mesh: ModelMesh, v: VertexIndex, p: Point3D): Boolean
        => mesh.Positions.IsValidIndex(v) ? mesh.Positions[v] == p : false;   // exact by construction

    // Whether element e of the mesh exists and approximates face f.
    ElementFaceIs(mesh: ModelMesh, e: ElementIndex, f: BrepFaceIndex): Boolean
        => mesh.ElementFace.IsValidIndex(e) ? mesh.ElementFace[e].Value == f.Value : false;

    // Whether the uv at corner slot of assembled element ge equals the uv of the face mesh's
    // parameter-space point at corner slot of its element e.
    CornerUvIsCopied(mesh: ModelMesh, fm: FaceMesh, ge: ElementIndex, e: ElementIndex, slot: Integer): Boolean
        => (mesh.CornerUvs.IsValidIndex(mesh.CornerOf(ge, slot)) ? fm.UvPoints.IsValidIndex(fm.FaceMeshCorner(e, slot)) : false)
            ? mesh.CornerUvs[mesh.CornerOf(ge, slot)] == fm.UvPoints[fm.FaceMeshCorner(e, slot)]   // exact by construction
            : false;

    // Whether the normal at corner slot of assembled element ge equals the face mesh's normal at
    // the parameter-space point at corner slot of its element e.
    CornerNormalIsCopied(mesh: ModelMesh, fm: FaceMesh, ge: ElementIndex, e: ElementIndex,
        slot: Integer): Boolean
        => (mesh.CornerNormals.IsValidIndex(mesh.CornerOf(ge, slot)) ? fm.Normals.IsValidIndex(fm.FaceMeshCorner(e, slot)) : false)
            ? mesh.CornerNormals[mesh.CornerOf(ge, slot)] == fm.Normals[fm.FaceMeshCorner(e, slot)]   // exact by construction
            : false;
}

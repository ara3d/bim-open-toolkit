//==
// # Mesh vertex numbering: laws
//
// Every law here is exact: the numbering is integer bookkeeping. Each is total: an index or a site
// outside its range makes the law vacuously true, and the range itself is another law's statement.
// None can run on pseudorandom instances (every parameter holds an array or a sum); they run on
// witnesses and on the meshes validation checks. Severity when one fails on a model: Error
// (structural group, SPEC-DSL.md section 4).
//
// Sections, in order:
//  - The numbering partitions the vertex indices
//  - Sites and indices are in bijection
//  - Face meshes agree with the numbering
//  - Shared boundary samples have one global vertex

library ModelMeshNumberingLaws
{
    //==
    // # The numbering partitions the vertex indices
    //
    // Together: model vertices take 0 to V - 1; the edge runs follow in edge order, the face runs
    // in face order; no run has negative length; the last face start is the vertex count. So the
    // runs cut 0 to N - 1 into consecutive, disjoint pieces, one per model vertex, edge, and face.

    // EdgeInteriorStart has one entry per model edge plus one.
    NumberingHasOneEdgeRunPerEdge(m: BrepModel, n: MeshVertexNumbering): Boolean
        => n.EdgeInteriorStart.Count == m.Edges.Count + 1;

    // FaceInteriorStart has one entry per model face plus one.
    NumberingHasOneFaceRunPerFace(m: BrepModel, n: MeshVertexNumbering): Boolean
        => n.FaceInteriorStart.Count == m.Faces.Count + 1;

    // Every model vertex has a global index, and they come first.
    NumberingCountsEveryModelVertex(m: BrepModel, n: MeshVertexNumbering): Boolean
        => n.ModelVertexCount == m.Vertices.Count;

    // The edge runs begin where the model vertices end.
    EdgeRunsFollowModelVertices(n: MeshVertexNumbering): Boolean
        => n.EdgeInteriorStart.IsEmpty ? true : n.EdgeInteriorStart[0] == n.ModelVertexCount;

    // The face runs begin where the edge runs end.
    FaceRunsFollowEdgeRuns(n: MeshVertexNumbering): Boolean
        => (n.EdgeInteriorStart.IsEmpty || n.FaceInteriorStart.IsEmpty)
            ? true
            : n.FaceInteriorStart[0] == n.EdgeInteriorStart.Last;

    // No edge run has negative length: the edge starts do not decrease.
    EdgeRunHasNonNegativeLength(n: MeshVertexNumbering, e: BrepEdgeIndex): Boolean
        => n.EdgeInteriorCount(e) >= 0;

    // No face run has negative length: the face starts do not decrease.
    FaceRunHasNonNegativeLength(n: MeshVertexNumbering, f: BrepFaceIndex): Boolean
        => n.FaceInteriorCount(f) >= 0;

    // The numbering covers exactly the mesh's positions: the run lengths and the model vertex count
    // sum to the position count.
    NumberingCoversPositions(mesh: ModelMesh): Boolean
        => mesh.Numbering.NumberedVertexCount == mesh.Positions.Count;

    //==
    // # Sites and indices are in bijection
    //
    // IndexOfSite sends the numbered sites into 0 to N - 1, SiteAt sends 0 to N - 1 back, and each
    // undoes the other: every site has exactly one index and every index exactly one site.

    // A numbered site's index lies in 0 to N - 1.
    Law_IndexOfSiteIsInRange(n: MeshVertexNumbering, s: MeshVertexSite): Boolean
        => n.HasSite(s)
            ? (n.IndexOfSite(s).Value >= 0 && n.IndexOfSite(s).Value < n.NumberedVertexCount)
            : true;

    // SiteAt recovers a numbered site from its index, so no two sites share an index.
    Law_SiteAtInvertsIndexOfSite(n: MeshVertexNumbering, s: MeshVertexSite): Boolean
        => n.HasSite(s) ? n.SiteAt(n.IndexOfSite(s)) == s : true;

    // IndexOfSite recovers an index from its site, so every index in 0 to N - 1 has a site.
    Law_IndexOfSiteInvertsSiteAt(n: MeshVertexNumbering, i: VertexIndex): Boolean
        => (i.Value >= 0 && i.Value < n.NumberedVertexCount)
            ? n.IndexOfSite(n.SiteAt(i)).Value == i.Value
            : true;

    // A model vertex's global index is its own index: provenance OnVertex(v) maps to vertex v.
    Law_ModelVertexKeepsItsIndex(n: MeshVertexNumbering, v: BrepVertexIndex): Boolean
        => (v.Value >= 0 && v.Value < n.ModelVertexCount)
            ? n.GlobalIndex(MeshVertexProvenance.OnVertex(v), 0).Value == v.Value
            : true;

    // NumberMeshVertices gives an edge some face mesh cites one slot per interior point of its
    // discretization.
    Law_NumberingCountsCitedEdgeInteriors(m: BrepModel, d: EdgeDiscretizations,
        faceMeshes: Array<FaceMesh>, e: BrepEdgeIndex): Boolean
        => (m.Edges.IsValidIndex(e) ? faceMeshes.CitesEdge(e) : false)
            ? NumberMeshVertices(m, d, faceMeshes).EdgeInteriorCount(e) == d.InteriorPointCount(e)
            : true;

    //==
    // # Face meshes agree with the numbering
    //
    // The face mesh side of the contract: what 05-face-meshing's FaceMesh must satisfy for its
    // points to be numbered. Stated here because they are stated in terms of sites.

    // Every parameter-space point of a face mesh has a site the numbering has a slot for: an edge
    // point cites an interior point of its edge (discretization points 1 to n - 2), and the face
    // run has room for every face-interior local vertex.
    FaceMeshPointHasNumberedSite(n: MeshVertexNumbering, fm: FaceMesh, i: VertexIndex): Boolean
        => fm.Sources.IsValidIndex(i) ? n.HasSite(fm.SiteOfUvPoint(i)) : true;

    // A point's source and its local vertex's provenance name the same model cell: a FromVertex
    // point has an OnVertex vertex of that model vertex, a FromEdge point an OnEdge vertex of that
    // edge, and every other point an OnFace vertex of the face mesh's face.
    FaceMeshSourceAgreesWithProvenance(fm: FaceMesh, i: VertexIndex): Boolean
        => (fm.Sources.IsValidIndex(i) ? fm.LocalVertex.IsValidIndex(i) : false)
            ? (fm.Provenance.IsValidIndex(fm.LocalVertex[i])
                ? fm.SiteOfUvPoint(i).IsSiteOf(fm.Provenance[fm.LocalVertex[i]])
                : false)
            : true;

    // Two parameter-space copies of one local vertex (the two sides of a seam) reach one global
    // vertex.
    SeamCopiesShareOneGlobalVertex(n: MeshVertexNumbering, fm: FaceMesh, i: VertexIndex,
        j: VertexIndex): Boolean
        => (fm.LocalVertex.IsValidIndex(i) ? fm.LocalVertex.IsValidIndex(j) : false)
            ? (fm.LocalVertex[i].Value == fm.LocalVertex[j].Value
                ? n.GlobalVertexOf(fm, i).Value == n.GlobalVertexOf(fm, j).Value
                : true)
            : true;

    // Two distinct local vertices of one face mesh reach distinct global vertices: a face mesh does
    // not hold two copies of one model point.
    DistinctLocalVerticesHaveDistinctGlobalVertices(n: MeshVertexNumbering, fm: FaceMesh,
        i: VertexIndex, j: VertexIndex): Boolean
        => (fm.LocalVertex.IsValidIndex(i) ? fm.LocalVertex.IsValidIndex(j) : false)
            ? (fm.LocalVertex[i].Value != fm.LocalVertex[j].Value
                ? n.GlobalVertexOf(fm, i).Value != n.GlobalVertexOf(fm, j).Value
                : true)
            : true;

    //==
    // # Shared boundary samples have one global vertex

    // Two parameter-space points, in the same or in different face meshes, that cite the same model
    // vertex or the same point of one edge's discretization reach one global vertex. This is the
    // mechanism that makes the assembled mesh watertight; mesh-assembly.laws.plato states its
    // consequence for the assembled elements.
    SharedBoundarySampleHasOneGlobalVertex(n: MeshVertexNumbering, fa: FaceMesh, fb: FaceMesh,
        i: VertexIndex, j: VertexIndex): Boolean
        => (fa.Sources.IsValidIndex(i) ? fb.Sources.IsValidIndex(j) : false)
            ? (IsSameBoundarySample(fa.Sources[i], fb.Sources[j])
                ? n.GlobalVertexOf(fa, i).Value == n.GlobalVertexOf(fb, j).Value
                : true)
            : true;
}

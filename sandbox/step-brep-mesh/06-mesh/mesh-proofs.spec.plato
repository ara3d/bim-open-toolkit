//==
// # Specs of the face-mesh and model-mesh proofs
//
// One spec per proof type of mesh-proofs.types.plato: the invariant its
// value keeps and the single function permitted to build it. The laws
// named beside them mesh layer 8's witnesses, so they are in
// 08-pipeline/pipeline-proofs-mesh.laws.plato. m is the model the
// constructor was given. Not compiled; the runner skips this file.
//
// Sections, in order:
//  - Face outcomes
//  - The model mesh
//  - Quads

//==
// # Face outcomes

spec MeshedFaceSet
{
    invariant IsMeshedFaceSet(self.Faces, self.Outcomes);   // Law_MeshedFaceSetIffFacesMeshed, Law_MeshedFaceSetPairsFaces
    constructor CheckMeshedFaceSet;
}

spec FullyMeshedModel
{
    invariant IsMeshedFaceSet(self.Model.FacesInOrder, self.Outcomes);   // Law_FullyMeshedModelIffEveryFaceMeshed
    constructor CheckFullyMeshedModel;
}

//==
// # The model mesh

spec WatertightMesh
{
    invariant self.Mesh.IsWellFormed && self.Mesh.IsClosed;   // Law_WatertightMeshIffClosed
    constructor CheckWatertightMesh;
}

spec CheckedMesh
{
    invariant self.Mesh.IsWellFormed;
    invariant self.Mesh.IsManifold && self.Mesh.IsConsistentlyOriented;
    invariant m.IsClosedWhereShellIs(self.Mesh);   // Law_CheckedMeshIffMeshChecks
    invariant self.Counts.Count == self.Mesh.ComponentsOf.ComponentCount;   // Law_CheckedMeshRecordsCounts
    constructor CheckCheckedMesh;   // layer 7, validation-proofs.library.plato
}

spec QualityGradedMesh
{
    invariant self.Mesh.IsWellFormed && self.Mesh.IsMeasurable;   // Law_QualityGradedMeshIffMeasurable
    invariant self.Triangles.Count == self.Mesh.Triangles.Count && self.Quads.Count == self.Mesh.Quads.Count;
    invariant forall (k: Integer) in self.Triangles.Count.Range :
        self.Triangles[k] == self.Mesh.TriangleQualityAt(ElementIndex(k));   // Law_QualityGradedMeshRecordsQualities
    constructor CheckQualityGradedMesh;
}

//==
// # Quads

spec PlanarQuad
{
    // fm, q, c are the constructor's face mesh, quad, and criteria.
    invariant self.Deviation.Value == fm.QuadWarp(q) && fm.QuadWarp(q) <= c.SurfaceChordal;   // Law_PlanarQuadIffWarpWithinChordal
    constructor CheckPlanarQuad;
}

spec ConvexQuad
{
    invariant fm.IsConvexQuad(q);   // Law_ConvexQuadIffConvex
    constructor CheckConvexQuad;
}

//==
// # Conversions to the stdlib mesh types: types
//
// The two results a conversion needs that the stdlib does not have: a quad mesh conversion that
// can fail (partial-operation style 1 of stdlib CONVENTIONS.md, a record with a validity field),
// and a triangle mesh with one normal and one uv per vertex, for renderers.
//
// Sections, in order:
//  - Results

//==
// # Results

// The result of converting a model mesh to a QuadMesh3D. Ok is true exactly when the model mesh has
// no triangles; then Mesh holds every element and every position. When Ok is false, Mesh still
// holds every position and every quad, and the triangles are left out, so a caller that reads Mesh
// without Ok loses elements and Ok says so.
type QuadMeshOutcome
    implements IValue
{
    Ok: Boolean;
    Mesh: QuadMesh3D;
}

// A triangle mesh with per-vertex attributes for renderers that take one normal and one uv per
// vertex. A model mesh vertex is split into one vertex per distinct pair of corner attributes
// (normal, uv) among the corners at it, so a seam vertex becomes two and a crease vertex one per
// face; a smooth vertex stays one. Normals, Uvs, and SourceVertex are parallel to Mesh.Positions:
// SourceVertex[i] is the model mesh vertex split vertex i came from. The stdlib's RichMesh3D is
// not used: its channels are found by name, so no type states that a normal channel has one
// entry per position, and no law could index it without a lookup by string.
type SplitTriangleMesh3D
    implements IValue
{
    Mesh: TriangleMesh3D;
    Normals: Array<Direction3D>;
    Uvs: Array<UvCoordinate>;
    SourceVertex: Array<VertexIndex>;
}

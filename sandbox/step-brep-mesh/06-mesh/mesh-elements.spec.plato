//==
// # Mesh elements: specification
//
// Invariants and constructors of TYPE-CATALOG.md section 9 (SPEC-DSL.md section 3).
// Not compiled. Each invariant names the Law_ that checks it, or says it is an
// obligation of a deferred function.
//
// Sections, in order:
//  - Mesh assembly

//==
// # Mesh assembly

spec CornerAttribute<T>
{
    invariant IsPerCornerOf(self, the mesh it was read from);   // Law_CornerCountIsThreeTPlusFourQ
    constructor CornerNormalsOf;
    constructor CornerUvsOf;
}

spec Crease { invariant self.Dihedral.Radians > 0.0; }

spec ResolveElement(mesh: ModelMesh, e: ElementIndex): ElementRef
{
    ensures match (result) {
        TriangleRef(i) => mesh.IsTriangle(e) && i == e.Value;
        QuadRef(i) => mesh.IsQuad(e) && i == e.Value - mesh.Triangles.Count;
        NotAnElement => !mesh.IsElementInRange(e);
    };   // Law_ResolveElementAgreesWithAccessors
}

spec CornersOf(mesh: ModelMesh, e: ElementIndex): ElementCorners
{
    ensures CornerList(result) == mesh.ElementCornerList(e);   // Law_CornersOfAgreesWithElementCorners, Law_CornersOfHasItsKindsCount
}

spec BoundaryCycleListOf(mesh: ModelMesh): BoundaryCycleList
{
    ensures result.Cycles.Count == the library's BoundaryCycles count;   // obligation: deferred
}

spec NonManifoldEdge { invariant IsNonManifold(self); }   // obligation of the deferred NonManifoldEdgesOf
spec PinchedVertex { invariant IsPinched(self); }          // obligation of the deferred PinchedVerticesOf
spec MisorientedEdge { invariant IsTwoSided(self); }       // obligation of the deferred MisorientedEdgesOf

spec MeshSlice
{
    invariant forall e in self.Elements: IsOneOf(mesh.ElementFaceAt(e.Value), self.Faces);   // Law_SliceElementsAreOnItsFaces, Law_SliceOfAllFacesIsWholeMesh
    constructor SliceOf;
}

spec ProvenanceIndex
{
    invariant self.ByVertex.Count == mesh.Positions.Count;
    invariant forall f: self.ByFace.Row(f) == VerticesOnFace(mesh, f);   // Law_ProvenanceIndexListsElementCorners, Law_ProvenanceIndexListsNothingElse
    constructor ProvenanceIndexOf;
}

spec ElementProvenance
{
    invariant self.Face == mesh.ElementFace[e];   // Law_ElementProvenanceNamesElementFace
    constructor ElementProvenanceOf;
}

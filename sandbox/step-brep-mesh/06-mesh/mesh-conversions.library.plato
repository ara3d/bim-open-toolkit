//==
// # Conversions to the stdlib mesh types: functions
//
// All four are To* functions, because each drops something: provenance and corner attributes
// (ToTriangleMesh3D, ToQuadMesh3D, ToPolygonMesh3D) or index identity of vertices
// (ToSplitTriangleMesh3D). Positions are copied, never recomputed. A quad is split along its A-C
// diagonal, into (A, B, C) and (A, C, D), the split the stdlib's FanTriangles makes, so element k
// of the triangulation is triangle k for k < T, and the two halves of quad q are elements
// T + 2q and T + 2q + 1.
//
// Sections, in order:
//  - Positions and connectivity
//  - Split vertices for per-vertex attributes

library ModelMeshConversions
{
    //==
    // # Positions and connectivity

    // The mesh as a TriangleMesh3D: the positions unchanged, the triangles in order, then each quad
    // as the two triangles of its A-C split.
    ToTriangleMesh3D(mesh: ModelMesh): TriangleMesh3D
        => TriangleMesh3D(mesh.Positions, mesh.Triangles.Concatenate(mesh.Quads.FlatMap(q => q.FanTriangles)));

    // The mesh as a QuadMesh3D when it has no triangles (QuadMeshOutcome says what happens
    // otherwise): the positions unchanged and the quads in order.
    ToQuadMesh3D(mesh: ModelMesh): QuadMeshOutcome
        => QuadMeshOutcome(mesh.Triangles.IsEmpty, QuadMesh3D(mesh.Positions, mesh.Quads));

    // The mesh as a PolygonMesh3D, which holds triangles and quads together: the positions
    // unchanged, one face row per element in element order, corners in winding order.
    ToPolygonMesh3D(mesh: ModelMesh): PolygonMesh3D
        => PolygonMesh3D(mesh.Positions, FromRows(mesh.ElementCount.MapRange(k => mesh.ElementCorners(ElementIndex(k)))));

    // The model mesh corner that slot s of triangle k of ToTriangleMesh3D(mesh) comes from: corner
    // 3k + s for k < T; for half h of quad q (k = T + 2q + h), quad slot s for h = 0 and quad slot 0,
    // 2, 3 for s = 0, 1, 2 when h = 1. -1 when k or s names no corner.
    TriangulatedCorner(mesh: ModelMesh, k: Integer, s: Integer): CornerIndex
        => (k < 0 || k >= mesh.Triangles.Count + 2 * mesh.Quads.Count || s < 0 || s > 2)
            ? CornerIndex(-1)
            : (k < mesh.Triangles.Count
                ? CornerIndex(3 * k + s)
                : CornerIndex(3 * mesh.Triangles.Count + 4 * ((k - mesh.Triangles.Count) / 2)
                    + ((k - mesh.Triangles.Count) % 2 == 0 ? s : (s == 0 ? 0 : s + 1))));

    //==
    // # Split vertices for per-vertex attributes

    // Chunk A body (reached by every model mesh validation), from the
    // contract ToSplitTriangleMesh3D and its deferred note: the corners of
    // each vertex grouped by their (normal, uv) pair, compared exactly with
    // layer 0's Identical on each component (a NaN equals a NaN, so no group
    // splits or merges by accident); one split vertex per group, ordered by
    // source vertex and then by the group's first corner; ToTriangleMesh3D's
    // triangles with each corner replaced by its group's split vertex
    // (TriangulatedCorner). Quadratic in the corner count where the note
    // sorts each vertex's corners.
    ToSplitTriangleMesh3D(mesh: ModelMesh): SplitTriangleMesh3D
    {
        var count = mesh.CornerCount;
        var firstOf = count.MapRange(c => mesh.FirstMatchingCorner(c));
        var reps = count.Range.FlatMap(c => firstOf[c] == c ? [c] : count.Range.Take(0))
            .Sort((a, b) => mesh.CornerVertex(CornerIndex(a)).Value < mesh.CornerVertex(CornerIndex(b)).Value
                || (mesh.CornerVertex(CornerIndex(a)).Value == mesh.CornerVertex(CornerIndex(b)).Value && a <= b));
        var splitOf = count.MapRange(c => reps.PositionOfItem(firstOf[c]));
        var triangleCount = mesh.Triangles.Count + 2 * mesh.Quads.Count;
        return SplitTriangleMesh3D(
            TriangleMesh3D(
                reps.Map(c => mesh.Positions[mesh.CornerVertex(CornerIndex(c))]),
                triangleCount.MapRange(k => TriangleFace(
                    VertexIndex(splitOf[mesh.TriangulatedCorner(k, 0).Value]),
                    VertexIndex(splitOf[mesh.TriangulatedCorner(k, 1).Value]),
                    VertexIndex(splitOf[mesh.TriangulatedCorner(k, 2).Value])))),
            reps.Map(c => mesh.CornerNormals[c]),
            reps.Map(c => mesh.CornerUvs[c]),
            reps.Map(c => mesh.CornerVertex(CornerIndex(c))));
    }

    // The first corner, at or before c, of the same vertex with identical
    // corner attributes: c's group's first corner.
    FirstMatchingCorner(mesh: ModelMesh, c: Integer): Integer
        => (c + 1).Range.Reduce(-1, (found, j) => found >= 0 ? found : (mesh.HaveIdenticalCorners(j, c) ? j : -1));

    // Whether corners a and b are of one vertex and carry identical normals
    // and parameters, component by component (layer 0's Identical).
    HaveIdenticalCorners(mesh: ModelMesh, a: Integer, b: Integer): Boolean
        => mesh.CornerVertex(CornerIndex(a)).Value == mesh.CornerVertex(CornerIndex(b)).Value
            && mesh.CornerNormals[a].Vector.X.Identical(mesh.CornerNormals[b].Vector.X)
            && mesh.CornerNormals[a].Vector.Y.Identical(mesh.CornerNormals[b].Vector.Y)
            && mesh.CornerNormals[a].Vector.Z.Identical(mesh.CornerNormals[b].Vector.Z)
            && mesh.CornerUvs[a].U.Identical(mesh.CornerUvs[b].U)
            && mesh.CornerUvs[a].V.Identical(mesh.CornerUvs[b].V);
}

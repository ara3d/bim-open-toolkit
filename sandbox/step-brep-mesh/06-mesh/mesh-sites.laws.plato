//==
// # Mesh sites: laws
//
// TYPE-CATALOG.md section 3. Exact: indices, slots, and sum tags only. Laws take Integers and
// build the typed values inside.
//
// Sections, in order:
//  - Sample keys to sites

library ModelMeshSitesLaws
{
    //==
    // # Sample keys to sites

    // Sample 0 of an edge of at least two samples is its start vertex.
    Law_FirstSampleIsStartVertex(e: Integer, sampleCount: Integer, start: Integer, end: Integer): Boolean
        => sampleCount >= 2
            ? ToSiteOnEdge(BrepEdgeIndex(e), EdgeSampleIndex(0), sampleCount, BrepVertexIndex(start), BrepVertexIndex(end))
                == MeshVertexSite.ModelVertex(BrepVertexIndex(start))
            : true;

    // The last sample of an edge of at least two samples is its end vertex.
    Law_LastSampleIsEndVertex(e: Integer, sampleCount: Integer, start: Integer, end: Integer): Boolean
        => sampleCount >= 2
            ? ToSiteOnEdge(BrepEdgeIndex(e), EdgeSampleIndex(sampleCount - 1), sampleCount, BrepVertexIndex(start), BrepVertexIndex(end))
                == MeshVertexSite.ModelVertex(BrepVertexIndex(end))
            : true;

    // Interior sample k of edge e is the site EdgeInterior(e, k - 1).
    Law_InteriorSampleIsEdgeInteriorSite(e: Integer, k: Integer, sampleCount: Integer, start: Integer, end: Integer): Boolean
        => EdgeSampleIndex(k).IsInteriorSample(sampleCount)
            ? ToSiteOnEdge(BrepEdgeIndex(e), EdgeSampleIndex(k), sampleCount, BrepVertexIndex(start), BrepVertexIndex(end))
                == MeshVertexSite.EdgeInterior(BrepEdgeIndex(e), InteriorSlot(k - 1))
            : true;
}

//==
// # Model mesh topology: functions
//
// The edge table, the components, and the per-component counts are deferred (sorting, union-find,
// one counting pass). The predicates over them, and the vertex-link test with the piece count of a
// small graph it rests on, are written out, because each is the definition of the property it
// names.
//
// Sections, in order:
//  - The edge table
//  - Manifold, closed, consistently oriented
//  - Components
//  - Pieces of a small graph
//  - Euler characteristic and genus of a component

library ModelMeshTopology
{
    //==
    // # The edge table

    // Chunk A body, from the contract EdgeTableOf: the proper directed
    // element sides (AllSides, IsProper), their positions sorted by canonical
    // pair (lexicographic on the two indices, never a packed integer key, which
    // overflows a 32-bit Integer above 46,341 vertices), each run of equal
    // pairs one edge, its count the run's length, its direction sum +1 for a
    // side from the lower index to the higher and -1 for one back.
    EdgeTableOf(mesh: ModelMesh): MeshEdgeTable
    {
        var all = mesh.AllSides;
        var sides = all.FlatMap(p => p.IsProper ? [p] : all.Take(0));
        var order = sides.Count.Range.Sort((i, j) => sides[i].Canonical.IsLexicographicallyAtMost(sides[j].Canonical));
        var edges = new List<VertexPair>();
        var counts = new List<Integer>();
        var sums = new List<Integer>();
        var k = 0;
        while (k < order.Count)
        {
            var key = sides[order[k]].Canonical;
            var count = 0;
            var sum = 0;
            var j = k;
            while (j < order.Count && j - k == count)
            {
                if (sides[order[j]].Canonical == key)
                {
                    count = count + 1;
                    sum = sum + (sides[order[j]].A.Value < sides[order[j]].B.Value ? 1 : -1);
                }
                j = j + 1;
            }
            edges = edges.Add(key);
            counts = counts.Add(count);
            sums = sums.Add(sum);
            k = k + count;
        }
        return MeshEdgeTable(UndirectedEdgeList(edges.Freeze()), counts.Freeze(), sums.Freeze());
    }

    // Whether pair a comes before pair b, or equals it, ordered by first
    // index, then second.
    IsLexicographicallyAtMost(a: VertexPair, b: VertexPair): Boolean
        => a.A.Value < b.A.Value || (a.A.Value == b.A.Value && a.B.Value <= b.B.Value);

    // The number of undirected edges.
    CountEdges(t: MeshEdgeTable): Integer
        => t.Edges.UndirectedEdges.Count;

    // The number of element sides on edge k; 0 when k names no edge.
    SidesOn(t: MeshEdgeTable, k: UndirectedEdgeIndex): Integer
        => t.ElementCounts.IsValidIndex(k) ? t.ElementCounts[k] : 0;

    // The direction sum of edge k; 0 when k names no edge.
    DirectionSumOn(t: MeshEdgeTable, k: UndirectedEdgeIndex): Integer
        => t.DirectionSums.IsValidIndex(k) ? t.DirectionSums[k] : 0;

    // Whether edge k bounds one element side only: a hole in the surface.
    IsBoundaryEdge(t: MeshEdgeTable, k: UndirectedEdgeIndex): Boolean
        => t.SidesOn(k) == 1;

    // Whether more than two element sides lie on edge k.
    IsNonManifoldEdge(t: MeshEdgeTable, k: UndirectedEdgeIndex): Boolean
        => t.SidesOn(k) > 2;

    // Whether edge k has two element sides traversing it in the same direction.
    IsMisorientedEdge(t: MeshEdgeTable, k: UndirectedEdgeIndex): Boolean
        => t.SidesOn(k) == 2 && t.DirectionSumOn(k) != 0;

    // The number of boundary edges.
    CountBoundaryEdges(t: MeshEdgeTable): Integer
        => t.CountEdges.MapRange(k => t.IsBoundaryEdge(UndirectedEdgeIndex(k))).CountTrue;

    // The number of non-manifold edges.
    CountNonManifoldEdges(t: MeshEdgeTable): Integer
        => t.CountEdges.MapRange(k => t.IsNonManifoldEdge(UndirectedEdgeIndex(k))).CountTrue;

    // The number of misoriented edges.
    CountMisorientedEdges(t: MeshEdgeTable): Integer
        => t.CountEdges.MapRange(k => t.IsMisorientedEdge(UndirectedEdgeIndex(k))).CountTrue;

    // Every directed element side, element by element in winding order: 3T + 4Q pairs.
    AllSides(mesh: ModelMesh): Array<VertexPair>
        => mesh.ElementCount.MapRange(k => ElementIndex(k))
            .FlatMap(e => mesh.ElementArity(e).MapRange(s => mesh.ElementSide(e, s)));

    // Whether a side joins two distinct vertices, and so is an edge of the complex.
    IsProper(p: VertexPair): Boolean
        => p.A.Value != p.B.Value;

    // A side as an undirected edge: its ends in increasing order.
    Canonical(p: VertexPair): VertexPair
        => p.A.Value <= p.B.Value ? p : VertexPair(p.B, p.A);

    // The number of element sides whose two ends are distinct vertices: the sides the edge table
    // counts.
    ProperSideCount(mesh: ModelMesh): Integer
        => mesh.AllSides.Map(p => p.IsProper).CountTrue;

    // The number of proper element sides on the undirected edge p (canonical): the reference value
    // of the edge table's count, by a quadratic route independent of the sort.
    SideCountOf(mesh: ModelMesh, p: VertexPair): Integer
        => mesh.AllSides.Map(x => x.IsProper ? x.Canonical == p : false).CountTrue;

    // The direction sum of the undirected edge p (canonical): +1 for each side from p.A to p.B, -1
    // for each side back. The reference value of the edge table's direction sum.
    DirectionSumOf(mesh: ModelMesh, p: VertexPair): Integer
        => mesh.AllSides.Map(x => x.IsProper ? (x == p ? 1 : (x.Canonical == p ? -1 : 0)) : 0).IntegerTotal;

    // Whether the table lists the undirected edge p (canonical).
    ListsEdge(t: MeshEdgeTable, p: VertexPair): Boolean
        => t.Edges.UndirectedEdges.Any(x => x == p);

    //==
    // # Manifold, closed, consistently oriented
    //
    // These are the edge conditions. A closed, consistently oriented, edge-manifold mesh can still
    // be pinched at a vertex (two spheres touching at a point); the vertex condition is
    // IsPinchedVertex, counted per component.

    // Whether no edge has more than two element sides.
    IsManifold(t: MeshEdgeTable): Boolean
        => t.ElementCounts.All(c => c <= 2);

    // Whether every edge has exactly two element sides: a 2-complex without boundary whose edges
    // are manifold.
    IsClosed(t: MeshEdgeTable): Boolean
        => t.ElementCounts.All(c => c == 2);

    // Whether every edge with two element sides is traversed in opposite directions. Boundary edges
    // satisfy it trivially; non-manifold edges are IsManifold's concern.
    IsConsistentlyOriented(t: MeshEdgeTable): Boolean
        => t.ElementCounts.Zip(t.DirectionSums, (c, s) => c == 2 ? s == 0 : true).All(b => b);

    // IsManifold of the mesh's edge table.
    IsManifold(mesh: ModelMesh): Boolean
        => mesh.EdgeTableOf.IsManifold;

    // IsClosed of the mesh's edge table.
    IsClosed(mesh: ModelMesh): Boolean
        => mesh.EdgeTableOf.IsClosed;

    // IsConsistentlyOriented of the mesh's edge table.
    IsConsistentlyOriented(mesh: ModelMesh): Boolean
        => mesh.EdgeTableOf.IsConsistentlyOriented;

    // The Euler characteristic of the whole mesh as a 2-complex, V - E + F with F = T + Q,
    // unreferenced vertices included (each counts as a point component).
    EulerCharacteristic(mesh: ModelMesh): Integer
        => mesh.Positions.Count - mesh.EdgeTableOf.CountEdges + mesh.ElementCount;

    // The Euler characteristic of the surface the elements form, V - E + F counting only the
    // vertices some element references: the sum of the components' Euler characteristics. Of
    // RestrictedToFaces(shell's faces), it is the mesh side of 07-validation's per-shell Euler
    // identity (Law_MeshEulerEqualsBrepEuler).
    ReferencedEulerCharacteristic(mesh: ModelMesh): Integer
        => mesh.EulerCharacteristic - mesh.ComponentsOf.UnreferencedVertexCount;

    //==
    // # Components

    // Chunk A body, from the contract ComponentsOf: one breadth-first search
    // per component from its lowest unvisited element over the elements that
    // share a vertex with it (the vertex-to-element incidence built once),
    // which finds the classes the deferred note's union-find would and the
    // spanning forest in the same pass: components numbered in the order of
    // their lowest element, each element's parent and depth recorded, a root
    // its own parent at depth 0; a vertex takes the component of an element
    // that references it, -1 when none does.
    ComponentsOf(mesh: ModelMesh): MeshComponents
    {
        var vertexCount = mesh.Positions.Count;
        var elementCount = mesh.ElementCount;
        var incident = vertexCount.MapRange(v => elementCount.Range.FlatMap(e =>
            mesh.ElementCorners(ElementIndex(e)).Any(c => c.Value == v) ? [e] : elementCount.Range.Take(0)));
        var parent = new Buffer<Integer>(elementCount);
        var depth = new Buffer<Integer>(elementCount);
        var component = new Buffer<Integer>(elementCount);
        var i = 0;
        while (i < elementCount)
        {
            parent = parent.Set(i, -1);
            depth = depth.Set(i, -1);
            component = component.Set(i, -1);
            i = i + 1;
        }
        var next = 0;
        var root = 0;
        while (root < elementCount)
        {
            if (depth.At(root) < 0)
            {
                parent = parent.Set(root, root);
                depth = depth.Set(root, 0);
                component = component.Set(root, next);
                var queue = new List<Integer>().Add(root);
                var head = 0;
                while (head < queue.Count)
                {
                    var e = queue.At(head);
                    var corners = mesh.ElementCorners(ElementIndex(e));
                    var c = 0;
                    while (c < corners.Count)
                    {
                        var around = corners[c].Value >= 0 && corners[c].Value < vertexCount ? incident[corners[c].Value] : elementCount.Range.Take(0);
                        var a = 0;
                        while (a < around.Count)
                        {
                            if (depth.At(around[a]) < 0)
                            {
                                parent = parent.Set(around[a], e);
                                depth = depth.Set(around[a], depth.At(e) + 1);
                                component = component.Set(around[a], next);
                                queue = queue.Add(around[a]);
                            }
                            a = a + 1;
                        }
                        c = c + 1;
                    }
                    head = head + 1;
                }
                next = next + 1;
            }
            root = root + 1;
        }
        var elementComponent = component.Freeze();
        return MeshComponents(
            elementComponent.Map(x => MeshComponentIndex(x)),
            vertexCount.MapRange(v => incident[v].Count == 0 ? MeshComponentIndex(-1) : MeshComponentIndex(elementComponent[incident[v][0]])),
            next,
            parent.Freeze().Map(x => ElementIndex(x)),
            depth.Freeze());
    }

    // The parent of element e in the components' spanning forest; -1 when e names no element.
    ElementParentOf(comps: MeshComponents, e: ElementIndex): ElementIndex
        => comps.ElementParent.IsValidIndex(e) ? comps.ElementParent[e] : ElementIndex(-1);

    // The depth of element e in the components' spanning forest; -1 when e names no element.
    ElementDepthOf(comps: MeshComponents, e: ElementIndex): Integer
        => comps.ElementDepth.IsValidIndex(e) ? comps.ElementDepth[e] : -1;

    // Whether element e is the root of its component's tree: its own parent.
    IsComponentRoot(comps: MeshComponents, e: ElementIndex): Boolean
        => comps.ElementParent.IsValidIndex(e) ? comps.ElementParent[e].Value == e.Value : false;

    // The number of roots among the elements below e: the index the component rooted at e has
    // when components are numbered in the order of their lowest element.
    RootsBelow(comps: MeshComponents, e: ElementIndex): Integer
        => e.Value.Max(0).Min(comps.ElementParent.Count).MapRange(k => comps.IsComponentRoot(ElementIndex(k))).CountTrue;

    // The number of roots: one per component.
    RootCount(comps: MeshComponents): Integer
        => comps.ElementParent.Count.MapRange(k => comps.IsComponentRoot(ElementIndex(k))).CountTrue;

    // Whether elements a and b of the mesh have a corner vertex in common.
    SharesAVertex(mesh: ModelMesh, a: ElementIndex, b: ElementIndex): Boolean
        => mesh.ElementCorners(a).Any(v => mesh.ElementCorners(b).Any(w => w.Value == v.Value));

    // Whether c names a component.
    IsComponentInRange(comps: MeshComponents, c: MeshComponentIndex): Boolean
        => c.Value >= 0 && c.Value < comps.ComponentCount;

    // The component of element e; -1 when e names no element.
    ElementComponentOf(comps: MeshComponents, e: ElementIndex): MeshComponentIndex
        => comps.ElementComponent.IsValidIndex(e) ? comps.ElementComponent[e] : MeshComponentIndex(-1);

    // The component of vertex v; -1 when v names no vertex or no element references it.
    VertexComponentOf(comps: MeshComponents, v: VertexIndex): MeshComponentIndex
        => comps.VertexComponent.IsValidIndex(v) ? comps.VertexComponent[v] : MeshComponentIndex(-1);

    // The number of vertices no element references.
    UnreferencedVertexCount(comps: MeshComponents): Integer
        => comps.VertexComponent.Map(c => c.Value < 0).CountTrue;

    // Whether every vertex is a corner of some element.
    IsEveryVertexReferenced(mesh: ModelMesh): Boolean
        => mesh.ComponentsOf.UnreferencedVertexCount == 0;

    // The edges of the link of v: for each element corner at v, the pair (the corner before it, the
    // corner after it). The link is a graph on the vertices around v; in a 2-manifold it is one
    // cycle when v is interior and one path when v is on the boundary.
    LinkEdges(mesh: ModelMesh, v: VertexIndex): Array<VertexPair>
        => mesh.ElementCount.MapRange(k => ElementIndex(k))
            .FlatMap(e => mesh.ElementArity(e).MapRange(s => s)
                .FlatMap(s => mesh.ElementCorner(e, s).Value == v.Value
                    ? [VertexPair(mesh.ElementCorner(e, (s + mesh.ElementArity(e) - 1) % mesh.ElementArity(e)),
                        mesh.ElementCorner(e, (s + 1) % mesh.ElementArity(e)))]
                    : []));

    // The largest number of link edges at one vertex of the link of v; 0 for an empty link. Above
    // 2, the link is neither a cycle nor a path.
    LinkMaxDegree(mesh: ModelMesh, v: VertexIndex): Integer
        => mesh.LinkEdges(v).FlatMap(p => [p.A, p.B])
            .Map(w => mesh.LinkEdges(v).Map(q => q.A.Value == w.Value || q.B.Value == w.Value).CountTrue)
            .Reduce(0, (a, b) => a.Max(b));

    // Whether v is pinched: its link (LinkEdges) is neither one cycle (v interior) nor one path (v
    // on the boundary). A connected graph whose vertices all have degree at most 2 is a path or a
    // cycle, so v is pinched exactly when some link vertex has degree above 2 or the link falls into
    // more than one piece. An unreferenced vertex, whose link is empty, is not pinched. Total for
    // every v: a v that names no vertex has an empty link. The implementation walks the link from
    // one vertex in time linear in the elements at v; this body is the reference.
    IsPinchedVertex(mesh: ModelMesh, v: VertexIndex): Boolean
        => mesh.LinkEdges(v).IsEmpty
            ? false
            : (mesh.LinkMaxDegree(v) > 2 || mesh.LinkEdges(v).PieceCount != 1);

    // Chunk A body, from the contract ComponentCountsOf, each count its
    // ensures clause: per component, its vertices (ComponentVertexCount), the
    // table edges whose first vertex lies in it with their boundary,
    // non-manifold and misoriented ones, its triangles and quads, its pinched
    // vertices, and the pieces of its boundary edges (PieceCount). The
    // reference form, quadratic in mesh size where the deferred note planned
    // one pass per table.
    ComponentCountsOf(mesh: ModelMesh, t: MeshEdgeTable, comps: MeshComponents): Array<MeshComponentCounts>
        => comps.ComponentCount.MapRange(c => mesh.CountsOfComponent(t, comps, c));

    // The counts of component c, as ComponentCountsOf's contract states them.
    CountsOfComponent(mesh: ModelMesh, t: MeshEdgeTable, comps: MeshComponents, c: Integer): MeshComponentCounts
    {
        var edges = t.CountEdges.Range.FlatMap(k =>
            comps.VertexComponentOf(t.Edges.UndirectedEdges[k].A).Value == c ? [k] : t.CountEdges.Range.Take(0));
        return MeshComponentCounts(
            comps.ComponentVertexCount(MeshComponentIndex(c)),
            edges.Count,
            mesh.Triangles.Count.Range.Map(k => comps.ElementComponentOf(ElementIndex(k)).Value == c).CountTrue,
            mesh.Quads.Count.Range.Map(k => comps.ElementComponentOf(ElementIndex(mesh.Triangles.Count + k)).Value == c).CountTrue,
            edges.Map(k => t.IsBoundaryEdge(UndirectedEdgeIndex(k))).CountTrue,
            edges.Map(k => t.IsNonManifoldEdge(UndirectedEdgeIndex(k))).CountTrue,
            edges.Map(k => t.IsMisorientedEdge(UndirectedEdgeIndex(k))).CountTrue,
            mesh.Positions.Count.Range.Map(k =>
                comps.VertexComponentOf(VertexIndex(k)).Value == c ? mesh.IsPinchedVertex(VertexIndex(k)) : false).CountTrue,
            t.BoundaryEdgesOf(comps, MeshComponentIndex(c)).PieceCount);
    }

    // The counts of a component with no cells: the value CountsOf returns for a component index
    // that names none.
    NoCells(_: MeshComponentCounts): MeshComponentCounts
        => (0, 0, 0, 0, 0, 0, 0, 0, 0);

    // The counts of component c of a mesh; NoCells when c names no component.
    CountsOf(mesh: ModelMesh, c: MeshComponentIndex): MeshComponentCounts
    {
        var counts = mesh.ComponentCountsOf(mesh.EdgeTableOf, mesh.ComponentsOf);
        return counts.IsValidIndex(c) ? counts[c] : MeshComponentCounts.NoCells;
    }

    //==
    // # Pieces of a small graph
    //
    // The number of connected pieces of a graph given by its edge list, by label propagation: a
    // reference definition, cubic in the number of vertices, for the small graphs it serves (the
    // link of one vertex) and for stating the contracts of the deferred one-pass counts.

    // The position of the first entry of xs equal to v; xs.Count when there is none.
    FirstPositionOf(xs: Array<VertexIndex>, v: VertexIndex): Integer
        => xs.Count.MapRange(i => i).Reduce(xs.Count, (best, i) => (i < best && xs[i].Value == v.Value) ? i : best);

    // The distinct ends of a list of pairs, in order of first appearance: the vertices of the
    // graph the pairs are the edges of.
    DistinctEnds(edges: Array<VertexPair>): Array<VertexIndex>
    {
        var ends = edges.FlatMap(p => [p.A, p.B]);
        return ends.Count.MapRange(i => i).FlatMap(i => ends.FirstPositionOf(ends[i]) == i ? [ends[i]] : []);
    }

    // One round of label propagation: vertex i (position i of ends) takes the smallest label among
    // its own and its neighbours'. Precondition: ends is edges.DistinctEnds and labels has one
    // entry per end.
    PieceLabelRound(edges: Array<VertexPair>, ends: Array<VertexIndex>, labels: Array<Integer>): Array<Integer>
        => ends.Count.MapRange(i => edges
            .Map(p => p.A.Value == ends[i].Value
                ? labels[ends.FirstPositionOf(p.B)]
                : (p.B.Value == ends[i].Value ? labels[ends.FirstPositionOf(p.A)] : labels[i]))
            .Reduce(labels[i], (a, b) => a.Min(b)));

    // The labels after the given number of propagation rounds.
    PieceLabels(edges: Array<VertexPair>, ends: Array<VertexIndex>, labels: Array<Integer>, rounds: Integer): Array<Integer>
        => rounds <= 0 ? labels : PieceLabels(edges, ends, PieceLabelRound(edges, ends, labels), rounds - 1);

    // The number of connected pieces of the graph whose edges are given (its vertices are the
    // edges' ends, so it has no isolated vertex; a pair with equal ends is a loop). Starting from
    // each vertex's own position, one round per vertex carries every piece's smallest position to
    // all of its vertices, since no path is longer; the vertices that keep their own position are
    // one per piece.
    PieceCount(edges: Array<VertexPair>): Integer
    {
        var ends = edges.DistinctEnds;
        var labels = PieceLabels(edges, ends, ends.Count.MapRange(i => i), ends.Count);
        return ends.Count.MapRange(i => labels[i] == i).CountTrue;
    }

    //==
    // # Euler characteristic and genus of a component

    // V - E + F of a component, with F = Triangles + Quads.
    EulerCharacteristic(c: MeshComponentCounts): Integer
        => c.Vertices - c.Edges + c.Triangles + c.Quads;

    // Whether every edge of the component has exactly two element sides.
    IsClosed(c: MeshComponentCounts): Boolean
        => c.BoundaryEdges == 0 && c.NonManifoldEdges == 0;

    // Whether no edge of the component is misoriented.
    IsConsistentlyOriented(c: MeshComponentCounts): Boolean
        => c.MisorientedEdges == 0;

    // Whether the component is a 2-manifold, possibly with boundary: no non-manifold edge and no
    // pinched vertex.
    IsSurface(c: MeshComponentCounts): Boolean
        => c.NonManifoldEdges == 0 && c.PinchedVertices == 0;

    // Whether the component is a consistently oriented surface, possibly with boundary, whose
    // Euler characteristic and boundary cycle count leave an even, non-negative 2 - chi - B, so
    // that it has a genus. By the classification of compact surfaces every connected oriented
    // surface with B boundary circles has chi = 2 - 2g - B; Law_ClosedOrientedSurfaceHasGenus and
    // Law_OrientedSurfaceWithBoundaryHasGenus check that the counts agree. A closed component has
    // no boundary cycle, and then the condition is the familiar chi even and at most 2.
    HasGenus(c: MeshComponentCounts): Boolean
        => c.IsConsistentlyOriented && c.IsSurface
            && 2 - c.EulerCharacteristic - c.BoundaryCycles >= 0
            && (2 - c.EulerCharacteristic - c.BoundaryCycles) % 2 == 0;

    // The genus of the component, (2 - chi - B) / 2, the number of handles: 0 for a sphere or a
    // disc, 1 for a torus, a block with a through hole, or a torus with a hole cut in it. The
    // fallback when HasGenus is false: a non-manifold, pinched, or inconsistently oriented
    // component, or counts no surface has.
    Genus(c: MeshComponentCounts, fallback: Integer): Integer
        => c.HasGenus ? (2 - c.EulerCharacteristic - c.BoundaryCycles) / 2 : fallback;

    // The boundary edges of component c of a mesh, as canonical pairs: the graph whose pieces
    // BoundaryCycles counts.
    BoundaryEdgesOf(t: MeshEdgeTable, comps: MeshComponents, c: MeshComponentIndex): Array<VertexPair>
        => t.CountEdges.MapRange(k => UndirectedEdgeIndex(k))
            .FlatMap(k => (t.IsBoundaryEdge(k) ? comps.VertexComponentOf(t.Edges.UndirectedEdges[k].A).Value == c.Value : false)
                ? [t.Edges.UndirectedEdges[k]]
                : []);
}

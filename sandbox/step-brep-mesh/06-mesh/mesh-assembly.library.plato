//==
// # Assembling the model mesh from face meshes
//
// AssembleModelMesh concatenates the face meshes' elements in face order and sends every element
// corner, a parameter-space point of its face mesh, to the global vertex of that point's site
// (GlobalVertexOf, mesh-numbering.library.plato). Two face meshes that cite one edge sample, or one
// model vertex, therefore write one global index, and the shared boundary is welded by identity.
// No position is compared and nothing is merged by distance: coincident vertices that do not share
// a site stay distinct and are reported (CoincidentVertexPairs), never merged.
//
// Sections, in order:
//  - Face mesh elements
//  - Preconditions
//  - Where each face mesh's elements land
//  - Assembly

library ModelMeshAssembly
{
    //==
    // # Face mesh elements
    //
    // A FaceMesh's elements follow the ModelMesh convention (ArityOf, CornerVertexOf in
    // mesh.library.plato), with the difference that their corners name parameter-space points of
    // the face mesh, not 3D vertices.

    // The number of elements of a face mesh, triangles and quads together.
    FaceMeshElementCount(fm: FaceMesh): Integer
        => fm.Triangles.Count + fm.Quads.Count;

    // The parameter-space point at corner slot of element e of a face mesh; -1 when e or slot names
    // no corner.
    FaceMeshCorner(fm: FaceMesh, e: ElementIndex, slot: Integer): VertexIndex
        => CornerVertexOf(fm.Triangles, fm.Quads, e, slot);

    // Whether face f has a face mesh with an element e that has corner slot, and that corner names
    // one of the face mesh's parameter-space points.
    HasFaceMeshCorner(faceMeshes: Array<FaceMesh>, f: BrepFaceIndex, e: ElementIndex, slot: Integer): Boolean
        => faceMeshes.IsValidIndex(f)
            ? faceMeshes[f].Sources.IsValidIndex(faceMeshes[f].FaceMeshCorner(e, slot))
            : false;

    // The source of the parameter-space point at corner slot of element e of face f's mesh.
    // Precondition: faceMeshes.HasFaceMeshCorner(f, e, slot).
    CornerSource(faceMeshes: Array<FaceMesh>, f: BrepFaceIndex, e: ElementIndex, slot: Integer): UvPointSource
        => faceMeshes[f].Sources[faceMeshes[f].FaceMeshCorner(e, slot)];

    //==
    // # Preconditions

    // Whether face meshes and a numbering can be assembled over model m, the conjunction the
    // laws over AssembleModelMesh guard with (each part is also its own law): one face mesh per
    // model face, in face order; the numbering's runs sized to the model; every element corner a
    // parameter-space point; every parameter-space point's site numbered; every parameter-space
    // point mapped to a local vertex that has a position and a provenance.
    CanAssemble(m: BrepModel, faceMeshes: Array<FaceMesh>, n: MeshVertexNumbering): Boolean
        => faceMeshes.Count == m.Faces.Count
            && faceMeshes.Count.MapRange(k => faceMeshes[k].Face.Value == k).All(b => b)
            && n.ModelVertexCount == m.Vertices.Count
            && n.EdgeInteriorStart.Count == m.Edges.Count + 1
            && n.FaceInteriorStart.Count == m.Faces.Count + 1
            && faceMeshes.All(fm => fm.HasValidUvCorners)
            && faceMeshes.All(fm => fm.HasNumberedPoints(n))
            && faceMeshes.All(fm => fm.HasMappedPoints);

    // Whether every corner of every element of a face mesh names one of its parameter-space points.
    HasValidUvCorners(fm: FaceMesh): Boolean
        => fm.FaceMeshElementCount
            .MapRange(k => ArityOf(fm.Triangles, fm.Quads, ElementIndex(k))
                .MapRange(s => fm.Sources.IsValidIndex(fm.FaceMeshCorner(ElementIndex(k), s)))
                .All(x => x))
            .All(x => x);

    // Whether every parameter-space point of a face mesh has a site the numbering has a slot for.
    HasNumberedPoints(fm: FaceMesh, n: MeshVertexNumbering): Boolean
        => fm.Sources.Count.MapRange(i => n.HasSite(fm.SiteOfUvPoint(VertexIndex(i)))).All(b => b);

    // Whether every parameter-space point of a face mesh maps to a local vertex with a position and
    // a provenance.
    HasMappedPoints(fm: FaceMesh): Boolean
        => fm.LocalVertex.Count == fm.Sources.Count
            && fm.LocalVertex.All(lv => fm.Positions.IsValidIndex(lv) && fm.Provenance.IsValidIndex(lv));

    //==
    // # Where each face mesh's elements land

    // The number of triangles of the face meshes before face f's.
    TriangleCountBefore(faceMeshes: Array<FaceMesh>, f: BrepFaceIndex): Integer
        => f.Value.Max(0).Min(faceMeshes.Count)
            .MapRange(k => faceMeshes[k].Triangles.Count)
            .IntegerTotal;

    // The number of quads of the face meshes before face f's.
    QuadCountBefore(faceMeshes: Array<FaceMesh>, f: BrepFaceIndex): Integer
        => f.Value.Max(0).Min(faceMeshes.Count)
            .MapRange(k => faceMeshes[k].Quads.Count)
            .IntegerTotal;

    // The number of triangles of all face meshes.
    TotalTriangleCount(faceMeshes: Array<FaceMesh>): Integer
        => faceMeshes.Map(fm => fm.Triangles.Count).IntegerTotal;

    // The model mesh element that element e of face f's mesh becomes: triangles of all faces first,
    // in face order, then quads of all faces, in face order. -1 when f or e names nothing.
    AssembledElement(faceMeshes: Array<FaceMesh>, f: BrepFaceIndex, e: ElementIndex): ElementIndex
        => (faceMeshes.IsValidIndex(f) ? (e.Value >= 0 && e.Value < faceMeshes[f].FaceMeshElementCount) : false)
            ? (e.Value < faceMeshes[f].Triangles.Count
                ? ElementIndex(faceMeshes.TriangleCountBefore(f) + e.Value)
                : ElementIndex(faceMeshes.TotalTriangleCount + faceMeshes.QuadCountBefore(f)
                    + e.Value - faceMeshes[f].Triangles.Count))
            : ElementIndex(-1);

    //==
    // # Assembly

    // Chunk A body, from the contract AssembleModelMesh and its deferred
    // note: one pass over the face meshes in face order writes, at each
    // parameter-space point's global index (GlobalVertexOf), the position and
    // provenance of its local vertex, the first write winning; a model vertex
    // takes its model point and OnVertex provenance before any face writes;
    // an index no face writes keeps the origin and OnVertex(-1). Elements are
    // the face meshes' triangles in face order, then their quads, corners
    // mapped by GlobalVertexOf, each with its face, and corner normals and
    // parameters copied in the corner order of CornerOf.
    AssembleModelMesh(m: BrepModel, faceMeshes: Array<FaceMesh>, numbering: MeshVertexNumbering): ModelMesh
    {
        var count = numbering.NumberedVertexCount;
        var positions = new Buffer<Point3D>(count);
        var provenance = new Buffer<MeshVertexProvenance>(count);
        var written = new Buffer<Boolean>(count);
        var i = 0;
        while (i < count)
        {
            var isModel = i < m.Vertices.Count;
            positions = positions.Set(i, isModel ? m.Vertices[i].Point : Point3D(0.0, 0.0, 0.0));
            provenance = provenance.Set(i, MeshVertexProvenance.OnVertex(BrepVertexIndex(isModel ? i : -1)));
            written = written.Set(i, isModel);
            i = i + 1;
        }
        var f = 0;
        while (f < faceMeshes.Count)
        {
            var fm = faceMeshes[f];
            var p = 0;
            while (p < fm.Sources.Count)
            {
                var g = numbering.GlobalVertexOf(fm, VertexIndex(p)).Value;
                if (g >= 0 && g < count)
                {
                    if (written.At(g).Not)
                    {
                        positions = positions.Set(g, fm.Positions[fm.LocalVertex[p]]);
                        provenance = provenance.Set(g, fm.Provenance[fm.LocalVertex[p]]);
                        written = written.Set(g, true);
                    }
                }
                p = p + 1;
            }
            f = f + 1;
        }
        return ModelMesh(
            positions.Freeze(),
            faceMeshes.FlatMap(x => x.Triangles.Map(t => TriangleFace(
                numbering.GlobalVertexOf(x, t.A), numbering.GlobalVertexOf(x, t.B), numbering.GlobalVertexOf(x, t.C)))),
            faceMeshes.FlatMap(x => x.Quads.Map(q => QuadFace(
                numbering.GlobalVertexOf(x, q.A), numbering.GlobalVertexOf(x, q.B), numbering.GlobalVertexOf(x, q.C), numbering.GlobalVertexOf(x, q.D)))),
            faceMeshes.FlatMap(x => x.Triangles.FlatMap(t => t.Vertices.Map(v => x.Normals[v])))
                .Concatenate(faceMeshes.FlatMap(x => x.Quads.FlatMap(q => q.Vertices.Map(v => x.Normals[v])))),
            faceMeshes.FlatMap(x => x.Triangles.FlatMap(t => t.Vertices.Map(v => x.UvPoints[v])))
                .Concatenate(faceMeshes.FlatMap(x => x.Quads.FlatMap(q => q.Vertices.Map(v => x.UvPoints[v])))),
            faceMeshes.FlatMap(x => x.Triangles.Map(t => x.Face)).Concatenate(faceMeshes.FlatMap(x => x.Quads.Map(q => x.Face))),
            provenance.Freeze(),
            numbering);
    }
}

//==
// # The model mesh: specification
//
// What every ModelMesh satisfies, and what reversal and the witness promise. The assembly's
// contract is in mesh-assembly.spec.plato.
//
// Sections, in order:
//  - The model mesh
//  - Reversal
//  - Witness

//==
// # The model mesh

// Every model mesh is well indexed: arrays sized to the vertices, elements, and corners they
// describe; every corner a vertex; every vertex's provenance the cell its index's site names; the
// numbering covering exactly the positions. The geometric and topological laws (closed, oriented,
// not degenerate) are not invariants: a mesh of a broken model can fail them, and validation
// reports it.
spec ModelMesh
{
    invariant ElementFaceHasOneEntryPerElement(self);
    invariant CornerNormalsHaveOneEntryPerCorner(self);
    invariant CornerUvsHaveOneEntryPerCorner(self);
    invariant VertexProvenanceHasOneEntryPerVertex(self);
    invariant NumberingCoversPositions(self);
    invariant forall (e: ElementIndex) : ElementCornersInRange(self, e);
    invariant forall (v: VertexIndex) : VertexProvenanceMatchesNumbering(self, v);
    constructor AssembleModelMesh;
    constructor Reversed;
    constructor RestrictedToFaces;
    constructor Witness_UnitTetrahedron;
}

//==
// # Reversal

// The other orientation of the same 2-complex.
spec Reversed(mesh: ModelMesh): ModelMesh
{
    ensures ElementFaceHasOneEntryPerElement(result);
    ensures CornerNormalsHaveOneEntryPerCorner(result);
    ensures CornerUvsHaveOneEntryPerCorner(result);
    ensures VertexProvenanceHasOneEntryPerVertex(result);
    ensures NumberingCoversPositions(result);
    ensures forall (e: ElementIndex) : ElementCornersInRange(result, e);
    ensures forall (v: VertexIndex) : VertexProvenanceMatchesNumbering(result, v);
    ensures forall (e: ElementIndex) : forall (slot: Integer) : Law_ReversalPermutesCorners(mesh, e, slot);
    ensures forall (e: ElementIndex) : forall (slot: Integer) : Law_ReversalMovesCornerUvWithCorner(mesh, e, slot);
    ensures forall (k: UndirectedEdgeIndex) : Law_ReversalNegatesEveryDirectionSum(mesh, k);
    ensures result.IsClosed == mesh.IsClosed;
    ensures result.IsConsistentlyOriented == mesh.IsConsistentlyOriented;
    measure mesh.CornerCount;
}

//==
// # Restriction

// The sub-complex of the elements of a set of faces, over the same vertices and numbering.
spec RestrictedToFaces(mesh: ModelMesh, faces: Array<BrepFaceIndex>): ModelMesh
{
    requires forall (e: ElementIndex) in mesh.ElementCount.Range : mesh.HasValidCornerAttributes(e);
    ensures ElementFaceHasOneEntryPerElement(result);
    ensures CornerNormalsHaveOneEntryPerCorner(result);
    ensures CornerUvsHaveOneEntryPerCorner(result);
    ensures VertexProvenanceHasOneEntryPerVertex(result);
    ensures NumberingCoversPositions(result);
    ensures forall (e: ElementIndex) : ElementCornersInRange(result, e);
    ensures forall (v: VertexIndex) : VertexProvenanceMatchesNumbering(result, v);
    ensures Law_RestrictionKeepsTheElementsOfTheFaces(mesh, faces);
    ensures forall (k: Integer) : forall (slot: Integer) : Law_RestrictionKeepsEachCorner(mesh, faces, k, slot);
    ensures forall (k: Integer) : Law_RestrictionKeepsEachElementFace(mesh, faces, k);
    ensures Law_RestrictionToEveryFaceKeepsTheEulerCharacteristic(mesh);
    measure mesh.ElementCount * faces.Count;
}

//==
// # Witness

// The unit tetrahedron, outward wound.
spec Witness_UnitTetrahedron(_: ModelMesh): ModelMesh
{
    ensures result.Positions.Count == 4;
    ensures result.ElementCount == 4;
    ensures ElementFaceHasOneEntryPerElement(result);
    ensures CornerNormalsHaveOneEntryPerCorner(result);
    ensures CornerUvsHaveOneEntryPerCorner(result);
    ensures VertexProvenanceHasOneEntryPerVertex(result);
    ensures NumberingCoversPositions(result);
    ensures result.IsClosed;
    ensures result.IsConsistentlyOriented;
    ensures result.EulerCharacteristic == 2;
    ensures result.SignedVolume > 0.0;
    measure result.ElementCount;
}

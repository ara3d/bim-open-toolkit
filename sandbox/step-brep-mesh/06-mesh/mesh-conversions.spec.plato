//==
// # Conversions to the stdlib mesh types: specification
//
// The contracts of the four conversions and the invariants of the split mesh. The area laws
// (Law_TriangleMeshKeepsArea and its siblings) take a tolerance the conversions do not have; the
// validator runs them with the model's length tolerance.
//
// Sections, in order:
//  - Positions and connectivity
//  - Split vertices

//==
// # Positions and connectivity

// The positions and connectivity, quads split along A-C.
spec ToTriangleMesh3D(mesh: ModelMesh): TriangleMesh3D
{
    ensures Law_TriangleMeshKeepsPositions(mesh);
    ensures Law_TriangleMeshSplitsEachQuadInTwo(mesh);
    ensures forall (k: Integer) : forall (s: Integer) : Law_TriangulatedCornerNamesTheTriangleCorner(mesh, k, s);
    measure mesh.Positions.Count + mesh.ElementCount;
}

// The quads, when there are no triangles.
spec ToQuadMesh3D(mesh: ModelMesh): QuadMeshOutcome
{
    ensures Law_QuadMeshIsOkExactlyWithoutTriangles(mesh);
    ensures Law_QuadMeshKeepsPositions(mesh);
    ensures result.Mesh.Faces.Count == mesh.Quads.Count;
    measure mesh.Positions.Count + mesh.Quads.Count;
}

// Triangles and quads together as polygons.
spec ToPolygonMesh3D(mesh: ModelMesh): PolygonMesh3D
{
    ensures Law_PolygonMeshKeepsPositions(mesh);
    ensures Law_PolygonMeshHasOneFacePerElement(mesh);
    ensures forall (k: Integer) in mesh.ElementCount.Range :
        result.Faces.RowLength(k) == mesh.ElementArity(ElementIndex(k));
    measure mesh.Positions.Count + mesh.CornerCount;
}

//==
// # Split vertices

// Every split mesh has one normal, one uv, and one source vertex per vertex.
spec SplitTriangleMesh3D
{
    invariant self.Normals.Count == self.Mesh.Positions.Count;
    invariant self.Uvs.Count == self.Mesh.Positions.Count;
    invariant self.SourceVertex.Count == self.Mesh.Positions.Count;
    constructor ToSplitTriangleMesh3D;
}

// Vertices duplicated exactly where corner attributes differ.
spec ToSplitTriangleMesh3D(mesh: ModelMesh): SplitTriangleMesh3D
{
    requires CornerNormalsHaveOneEntryPerCorner(mesh);
    requires CornerUvsHaveOneEntryPerCorner(mesh);
    ensures Law_SplitHasOneNormalPerVertex(mesh);
    ensures Law_SplitHasOneUvPerVertex(mesh);
    ensures Law_SplitHasOneSourcePerVertex(mesh);
    ensures Law_SplitHasAtLeastAsManyVertices(mesh);
    ensures Law_SplitSplitsEachQuadInTwo(mesh);
    ensures forall (v: VertexIndex) : Law_SplitVertexKeepsItsSourcePosition(mesh, v);
    ensures forall (k: Integer) : forall (s: Integer) : Law_SplitFollowsTheTriangulation(mesh, k, s);
    ensures forall (k: Integer) : forall (s: Integer) : Law_SplitVertexCarriesItsCornerNormal(mesh, k, s);
    ensures forall (k: Integer) : forall (s: Integer) : Law_SplitVertexCarriesItsCornerUv(mesh, k, s);
    ensures forall (a: VertexIndex) : forall (b: VertexIndex) : Law_SplitVerticesDiffer(mesh, a, b);
    measure mesh.CornerCount;
    deferred "group each vertex's corners by exact (normal, uv), one split vertex per group";
}

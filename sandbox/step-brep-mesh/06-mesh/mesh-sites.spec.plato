//==
// # Mesh sites: specification
//
// The contract of ToSite (mesh-sites.library.plato), SPEC-DSL.md section 3. Not compiled.

spec ToSite(m: BrepModel, k: SampleKey, sampleCount: Integer): MeshVertexSite
{
    requires match (k) { AtVertex(v) => m.IsVertexInRange(v); AtEdgeSample(e, s) => m.IsEdgeInRange(e) && s.Value >= 0 && s.Value < sampleCount; };
    requires sampleCount >= 2;
    ensures Law_FirstSampleIsStartVertex, Law_LastSampleIsEndVertex, Law_InteriorSampleIsEdgeInteriorSite on the edge arm;
}

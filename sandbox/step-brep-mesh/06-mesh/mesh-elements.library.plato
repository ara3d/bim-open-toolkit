//==
// # Mesh elements: constructors and predicates (TYPE-CATALOG.md section 9)
//
// Sections, in order:
//  - Corner attributes
//  - Creases
//  - Elements
//  - Boundaries and defects
//  - Slices and provenance

library ModelMeshElements
{
    //==
    // # Corner attributes

    // The catalog's CornerNormals: mesh's outward normal per corner.
    CornerNormalsOf(mesh: ModelMesh): CornerAttribute<Direction3D>
        => CornerAttribute(mesh.CornerNormals);

    // The catalog's CornerUvs: mesh's natural face parameters per corner.
    CornerUvsOf(mesh: ModelMesh): CornerAttribute<UvPoint>
        => CornerAttribute(mesh.CornerUvs.Map(c => c.ToUvPoint));

    // Whether a holds one value per corner of mesh: 3T + 4Q values.
    IsPerCornerOf(a: CornerAttribute<$T>, mesh: ModelMesh): Boolean
        => a.PerCorner.Count == mesh.CornerCount;

    // The value of a at corner c. Requires c in range.
    AtCorner(a: CornerAttribute<$T>, c: CornerIndex): $T
        => a.PerCorner[c];

    //==
    // # Creases

    // Whether two corner normals that meet at dihedral make a crease under threshold.
    IsCrease(dihedral: Angle, threshold: Angle): Boolean
        => dihedral.Radians > threshold.Radians;

    // The creases of s at or above threshold.
    CreasesAbove(s: CreaseSet, threshold: Angle): CreaseSet
        => CreaseSet(s.Creases.FlatMap(c => IsCrease(c.Dihedral, threshold) ? [c] : s.Creases.Take(0)));

    //==
    // # Elements

    // The number of corners of an element of kind k.
    CornerCountOf(k: ElementKind): Integer
        => match (k) {
            TriangleKind => 3;
            QuadKind => 4;
        };

    // What e names in mesh: a triangle, a quad (counted from the first quad), or nothing.
    ResolveElement(mesh: ModelMesh, e: ElementIndex): ElementRef
        => mesh.IsTriangle(e)
            ? ElementRef.TriangleRef(e.Value)
            : (mesh.IsQuad(e) ? ElementRef.QuadRef(e.Value - mesh.Triangles.Count) : ElementRef.NotAnElement);

    // The corners of the triangle or quad r names, in winding order.
    CornersOfRef(mesh: ModelMesh, r: ElementRef): ElementCorners
        => match (r) {
            TriangleRef(i) => ElementCorners.TriangleCorners(mesh.Triangles[i].A, mesh.Triangles[i].B, mesh.Triangles[i].C);
            QuadRef(i) => ElementCorners.QuadCorners(mesh.Quads[i].A, mesh.Quads[i].B, mesh.Quads[i].C, mesh.Quads[i].D);
            NotAnElement => ElementCorners.NoCorners;
        };

    // The corners of element e of mesh, by one match.
    CornersOf(mesh: ModelMesh, e: ElementIndex): ElementCorners
        => mesh.CornersOfRef(mesh.ResolveElement(e));

    // The corners as an array in winding order; empty for NoCorners.
    CornerList(c: ElementCorners): Array<VertexIndex>
        => match (c) {
            TriangleCorners(a, b, x) => [a, b, x];
            QuadCorners(a, b, x, d) => [a, b, x, d];
            NoCorners => 0.Range.Map(i => VertexIndex(i));
        };

    //==
    // # Boundaries and defects

    // The number of edges over every cycle of l.
    CycleEdgeCount(l: BoundaryCycleList): Integer
        => l.Cycles.Reduce(0, (n, c) => n + c.Edges.Count);

    // deferred: walk the boundary half-edges of the edge table into cycles.
    BoundaryCycleListOf(mesh: ModelMesh): BoundaryCycleList;

    // deferred: the edges of the edge table with three or more sides, with the sides.
    NonManifoldEdgesOf(mesh: ModelMesh): Array<NonManifoldEdge>;

    // deferred: the vertices whose link splits into two or more fans, with the fan count.
    PinchedVerticesOf(mesh: ModelMesh): Array<PinchedVertex>;

    // deferred: the two-sided edges whose sides run the same direction.
    MisorientedEdgesOf(mesh: ModelMesh): Array<MisorientedEdge>;

    // Whether x is a non-manifold edge: three or more sides.
    IsNonManifold(x: NonManifoldEdge): Boolean
        => x.Sides.Count >= 3;

    // Whether x is pinched: two or more fans.
    IsPinched(x: PinchedVertex): Boolean
        => x.Links >= 2;

    // Whether x's two sides belong to two elements.
    IsTwoSided(x: MisorientedEdge): Boolean
        => x.Sides.First.Element != x.Sides.Second.Element;

    //==
    // # Slices and provenance

    // The model face element k approximates; none when the mesh has no entry for k.
    ElementFaceAt(mesh: ModelMesh, k: Integer): BrepFaceIndex
        => mesh.ElementFace.IsValidIndex(k) ? mesh.ElementFace[k] : BrepFaceIndex(-1);

    // Whether face f is one of faces.
    IsOneOf(f: BrepFaceIndex, faces: Array<BrepFaceIndex>): Boolean
        => faces.Any(x => x == f);

    // The restriction of mesh to faces: the elements whose ElementFace is one of them, in order.
    SliceOf(mesh: ModelMesh, faces: Array<BrepFaceIndex>): MeshSlice
        => MeshSlice(faces, mesh.ElementCount.Range
            .FlatMap(k => IsOneOf(mesh.ElementFaceAt(k), faces) ? [ElementIndex(k)] : mesh.ElementCount.Range.Take(0).Map(i => ElementIndex(i))));

    // The mesh vertices that are a corner of some element on face f, in increasing order.
    VerticesOnFace(mesh: ModelMesh, f: BrepFaceIndex): Array<VertexIndex>
        => mesh.Positions.Count.Range.FlatMap(v =>
            mesh.ElementCount.Range.Any(k => mesh.ElementFaceAt(k) == f && mesh.ElementCornerList(ElementIndex(k)).Any(x => x.Value == v))
                ? [VertexIndex(v)]
                : 0.Range.Map(i => VertexIndex(i)));

    // The provenance index of mesh over faceCount model faces. Quadratic: the specification of
    // the index, not its algorithm.
    ProvenanceIndexOf(mesh: ModelMesh, faceCount: Integer): ProvenanceIndex
        => ProvenanceIndex(mesh.VertexProvenance, FromRows(faceCount.Max(0).Range.Map(f => mesh.VerticesOnFace(BrepFaceIndex(f)))));

    // The mean of the corner uvs of element e. Requires e in range with every corner uv present.
    UvCentroidOf(mesh: ModelMesh, e: ElementIndex): UvPoint
    {
        var n = mesh.ElementArity(e);
        var uvs = n.Range.Map(s => mesh.CornerUvs[mesh.CornerOf(e, s)].ToUvPoint);
        return n == 0
            ? UvPoint(0.0, 0.0)
            : UvPoint(SumOf(uvs.Map(p => p.U)) / n.ToNumber, SumOf(uvs.Map(p => p.V)) / n.ToNumber);
    }

    // The provenance of element e made in round r.
    ElementProvenanceOf(mesh: ModelMesh, e: ElementIndex, r: Round): ElementProvenance
        => ElementProvenance(mesh.ElementFaceAt(e.Value), mesh.UvCentroidOf(e), r);
}

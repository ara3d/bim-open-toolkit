//==
// # Element quality: laws
//
// Threshold laws (Info when they fail on a model) compare one metric of one element with the
// threshold record passed in, normally MeshQualityThresholds.CubitAcceptable; the threshold is the
// tolerance and it is named. Two shape laws are Error: a non-convex quad and, in
// mesh-measures.laws.plato, a folded element. Identity laws check the metric formulas on any
// triangle, so the pseudorandom runner can exercise them (Triangle3D and ComparisonTolerance are
// records of numbers); witness laws pin the normalization on shapes whose metrics are known.
//
// Sections, in order:
//  - Triangle thresholds
//  - Quad thresholds and convexity
//  - Metric identities
//  - Witnesses

library ModelMeshQualityLaws
{
    //==
    // # Triangle thresholds

    // Info: the smallest angle of triangle e is at least the threshold.
    TriangleMinAngleMeetsThreshold(mesh: ModelMesh, e: ElementIndex, th: MeshQualityThresholds): Boolean
        => (mesh.IsTriangle(e) ? mesh.HasValidCorners(e) : false)
            ? mesh.TriangleQualityAt(e).MinAngle.Radians >= th.TriangleMinAngle.Radians
            : true;

    // Info: the largest angle of triangle e is at most the threshold. Large angles, not small ones,
    // spoil interpolated normals (research/MESHING-REQUIREMENTS.md 1.3).
    TriangleMaxAngleMeetsThreshold(mesh: ModelMesh, e: ElementIndex, th: MeshQualityThresholds): Boolean
        => (mesh.IsTriangle(e) ? mesh.HasValidCorners(e) : false)
            ? mesh.TriangleQualityAt(e).MaxAngle.Radians <= th.TriangleMaxAngle.Radians
            : true;

    // Info: the radius ratio of triangle e is at most the threshold.
    TriangleRadiusRatioMeetsThreshold(mesh: ModelMesh, e: ElementIndex,
        th: MeshQualityThresholds): Boolean
        => (mesh.IsTriangle(e) ? mesh.HasValidCorners(e) : false)
            ? mesh.TriangleQualityAt(e).RadiusRatio <= th.MaxRadiusRatio
            : true;

    // Info: the aspect ratio of triangle e is at most the threshold.
    Law_TriangleAspectRatioMeetsThreshold(mesh: ModelMesh, e: ElementIndex,
        th: MeshQualityThresholds): Boolean
        => (mesh.IsTriangle(e) ? mesh.HasValidCorners(e) : false)
            ? mesh.TriangleQualityAt(e).AspectRatio <= th.MaxAspectRatio
            : true;

    //==
    // # Quad thresholds and convexity

    // Info: the skew of quad e is at most the threshold.
    QuadSkewMeetsThreshold(mesh: ModelMesh, e: ElementIndex, th: MeshQualityThresholds): Boolean
        => (mesh.IsQuad(e) ? mesh.HasValidCorners(e) : false)
            ? mesh.QuadQualityAt(e).Skew <= th.MaxQuadSkew
            : true;

    // Info: the warp cosine of quad e is at least the threshold.
    QuadWarpMeetsThreshold(mesh: ModelMesh, e: ElementIndex, th: MeshQualityThresholds): Boolean
        => (mesh.IsQuad(e) ? mesh.HasValidCorners(e) : false)
            ? mesh.QuadQualityAt(e).WarpCosine >= th.MinQuadWarpCosine
            : true;

    // Info: the angle defect of quad e, its non-planarity and non-convexity in one angle, is at
    // most the threshold (research/VALIDATION-MATH.md 4.5, Law_QuadAngleDefectWithinTolerance).
    QuadAngleDefectMeetsThreshold(mesh: ModelMesh, e: ElementIndex, th: MeshQualityThresholds): Boolean
        => (mesh.IsQuad(e) ? mesh.HasValidCorners(e) : false)
            ? mesh.QuadQualityAt(e).AngleDefect.Radians <= th.MaxQuadAngleDefect.Radians
            : true;

    // Info: the scaled Jacobian of quad e is at least the threshold.
    QuadScaledJacobianMeetsThreshold(mesh: ModelMesh, e: ElementIndex, th: MeshQualityThresholds): Boolean
        => (mesh.IsQuad(e) ? mesh.HasValidCorners(e) : false)
            ? mesh.QuadQualityAt(e).ScaledJacobian >= th.MinQuadScaledJacobian
            : true;

    // Error: quad e is convex in its mid-plane, its scaled Jacobian positive at every corner. Face
    // meshing emits a quad only when this holds (research/MESHING-REQUIREMENTS.md 5.4), so a failure
    // is a construction defect, not a quality preference.
    QuadIsConvex(mesh: ModelMesh, e: ElementIndex): Boolean
        => (mesh.IsQuad(e) ? mesh.HasValidCorners(e) : false)
            ? mesh.QuadQualityAt(e).ScaledJacobian > 0.0
            : true;

    //==
    // # Metric identities

    // A non-degenerate triangle's radius ratio is at least 1 (Euler's inequality R >= 2r), up to the
    // comparison tolerance.
    Law_RadiusRatioIsAtLeastOne(t: Triangle3D, tol: ComparisonTolerance): Boolean
        => (tol.IsNonNegative ? t.Area > 0.0 : false)
            ? (t.TriangleQualityOf.RadiusRatio >= 1.0 || t.TriangleQualityOf.RadiusRatio.AlmostEqual(1.0, tol))
            : true;

    // A non-degenerate triangle's aspect ratio is at least 1, the equilateral triangle's, up to the
    // comparison tolerance.
    Law_AspectRatioIsAtLeastOne(t: Triangle3D, tol: ComparisonTolerance): Boolean
        => (tol.IsNonNegative ? t.Area > 0.0 : false)
            ? (t.TriangleQualityOf.AspectRatio >= 1.0 || t.TriangleQualityOf.AspectRatio.AlmostEqual(1.0, tol))
            : true;

    //==
    // # Witnesses

    // The equilateral triangle has radius ratio 1: the normalization of R / (2r).
    Law_EquilateralTriangleHasUnitRadiusRatio(tol: ComparisonTolerance): Boolean
        => tol.IsNonNegative
            ? Triangle3D.Witness_EquilateralTriangle.TriangleQualityOf.RadiusRatio.AlmostEqual(1.0, tol)
            : true;

    // The equilateral triangle has aspect ratio 1: the normalization constant sqrt(3) / 6.
    Law_EquilateralTriangleHasUnitAspectRatio(tol: ComparisonTolerance): Boolean
        => tol.IsNonNegative
            ? Triangle3D.Witness_EquilateralTriangle.TriangleQualityOf.AspectRatio.AlmostEqual(1.0, tol)
            : true;

    // The unit square has skew 0.
    Law_UnitSquareHasZeroSkew(tol: ComparisonTolerance): Boolean
        => tol.IsNonNegative ? Quad3D.Witness_UnitSquare.QuadQualityOf.Skew.AlmostEqual(0.0, tol) : true;

    // The unit square has scaled Jacobian 1.
    Law_UnitSquareHasUnitScaledJacobian(tol: ComparisonTolerance): Boolean
        => tol.IsNonNegative ? Quad3D.Witness_UnitSquare.QuadQualityOf.ScaledJacobian.AlmostEqual(1.0, tol) : true;

    // The planar dart is not convex: the rejecting witness of the convexity test, so the test is
    // known to fire (research/EXISTING-MESHER-LESSONS.md, lesson 10).
    Law_DartQuadIsNotConvex(_: Quad3D): Boolean
        => Quad3D.Witness_DartQuad.QuadQualityOf.ScaledJacobian < 0.0;

    // The equilateral triangle with unit sides in the plane z = 0.
    Witness_EquilateralTriangle(_: Triangle3D): Triangle3D
        => Triangle3D(Point3D(0.0, 0.0, 0.0), Point3D(1.0, 0.0, 0.0), Point3D(0.5, 3.0.Sqrt * 0.5, 0.0));

    // The unit square in the plane z = 0, counter-clockwise seen from +z.
    Witness_UnitSquare(_: Quad3D): Quad3D
        => Quad3D(Point3D(0.0, 0.0, 0.0), Point3D(1.0, 0.0, 0.0), Point3D(1.0, 1.0, 0.0), Point3D(0.0, 1.0, 0.0));

    // The planar dart (0,0,0), (2,0,0), (0.5,0.5,0), (0,2,0), reflex at its third corner, with
    // angle defect 1.855 radians (research/VALIDATION-MATH.md 4.5).
    Witness_DartQuad(_: Quad3D): Quad3D
        => Quad3D(Point3D(0.0, 0.0, 0.0), Point3D(2.0, 0.0, 0.0), Point3D(0.5, 0.5, 0.0), Point3D(0.0, 2.0, 0.0));

    // Whether both parts of a comparison tolerance are non-negative; the runner draws negative ones.
    IsNonNegative(tol: ComparisonTolerance): Boolean
        => tol.Absolute >= 0.0 && tol.Relative >= 0.0;
}

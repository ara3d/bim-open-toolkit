//==
// # The model mesh: laws
//
// The structural invariants of ModelMesh, the laws of reversal, and the one witness this layer
// builds. All exact; all Error when they fail on a model (structural group). Equalities on copied
// numbers carry the comment "exact by construction" (SPEC-DSL.md section 2).
//
// Sections, in order:
//  - Array lengths
//  - Ranges and provenance
//  - Reversal
//  - Restriction
//  - Witness

library ModelMeshesLaws
{
    //==
    // # Array lengths

    // ElementFace has one entry per element.
    ElementFaceHasOneEntryPerElement(mesh: ModelMesh): Boolean
        => mesh.ElementFace.Count == mesh.ElementCount;

    // CornerNormals has one entry per element corner: 3T + 4Q.
    CornerNormalsHaveOneEntryPerCorner(mesh: ModelMesh): Boolean
        => mesh.CornerNormals.Count == mesh.CornerCount;

    // CornerUvs has one entry per element corner: 3T + 4Q.
    CornerUvsHaveOneEntryPerCorner(mesh: ModelMesh): Boolean
        => mesh.CornerUvs.Count == mesh.CornerCount;

    // VertexProvenance has one entry per vertex.
    VertexProvenanceHasOneEntryPerVertex(mesh: ModelMesh): Boolean
        => mesh.VertexProvenance.Count == mesh.Positions.Count;

    //==
    // # Ranges and provenance

    // Every corner of element e names a vertex of the mesh.
    ElementCornersInRange(mesh: ModelMesh, e: ElementIndex): Boolean
        => mesh.IsElementInRange(e) ? mesh.ElementCorners(e).All(v => mesh.Positions.IsValidIndex(v)) : true;

    // The face element e approximates is a face of the model.
    ElementFaceIsModelFace(m: BrepModel, mesh: ModelMesh, e: ElementIndex): Boolean
        => mesh.ElementFace.IsValidIndex(e) ? m.Faces.IsValidIndex(mesh.ElementFace[e]) : true;

    // A vertex's provenance names the model cell its index's site names, so the cell a vertex
    // samples can be read from its index alone.
    VertexProvenanceMatchesNumbering(mesh: ModelMesh, v: VertexIndex): Boolean
        => mesh.VertexProvenance.IsValidIndex(v)
            ? mesh.Numbering.SiteAt(v).IsSiteOf(mesh.VertexProvenance[v])
            : true;

    // The provenance map is cellular (reviews/MATH-REVIEW-layers-0-6.md M9): every corner of an
    // element of face f maps into the closure of f, that is to f itself, to an edge f's bounds cite,
    // or to a vertex f's bounds reference. Exact. Error: a corner elsewhere is a vertex glued to the
    // wrong cell, which the geometric re-evaluation in 07-validation may not notice when the two
    // cells meet.
    CornerProvenanceIsOnItsElementFace(m: BrepModel, mesh: ModelMesh, e: ElementIndex, slot: Integer): Boolean
    {
        var v = mesh.ElementCorner(e, slot);
        return (mesh.VertexProvenance.IsValidIndex(v)
                ? (mesh.ElementFace.IsValidIndex(e) ? m.IsFaceIntact(mesh.ElementFace[e]) : false)
                : false)
            ? m.IsOnClosureOfFace(mesh.VertexProvenance[v], mesh.ElementFace[e])
            : true;
    }

    //==
    // # Reversal

    // Slot s of a reversed element is slot ReversedSlot(arity, s) of the original.
    Law_ReversalPermutesCorners(mesh: ModelMesh, e: ElementIndex, slot: Integer): Boolean
        => (mesh.IsElementInRange(e) ? (slot >= 0 && slot < mesh.ElementArity(e)) : false)
            ? mesh.Reversed.ElementCorner(e, slot).Value
                == mesh.ElementCorner(e, ReversedSlot(mesh.ElementArity(e), slot)).Value
            : true;

    // A corner's uv moves with its corner when the element is reversed.
    Law_ReversalMovesCornerUvWithCorner(mesh: ModelMesh, e: ElementIndex, slot: Integer): Boolean
        => ((mesh.IsElementInRange(e) ? (slot >= 0 && slot < mesh.ElementArity(e)) : false)
                ? mesh.HasValidCornerAttributes(e)
                : false)
            ? mesh.Reversed.CornerUvAt(e, slot)
                == mesh.CornerUvAt(e, ReversedSlot(mesh.ElementArity(e), slot))   // exact by construction
            : true;

    //==
    // # Restriction
    //
    // Every restriction law is over a mesh meeting the ModelMesh invariants (IsWellFormed),
    // RestrictedToFaces' precondition.

    // Library law: restricting to a set of faces keeps exactly the elements of those faces.
    Law_RestrictionKeepsTheElementsOfTheFaces(mesh: ModelMesh, faces: Array<BrepFaceIndex>): Boolean
        => mesh.IsWellFormed ? mesh.RestrictedToFaces(faces).ElementCount == mesh.ElementsOfFaces(faces).Count : true;

    // Library law: corner slot of element k of the restriction is that corner of the k-th kept
    // element.
    Law_RestrictionKeepsEachCorner(mesh: ModelMesh, faces: Array<BrepFaceIndex>, k: Integer, slot: Integer): Boolean
        => (mesh.IsWellFormed && mesh.ElementsOfFaces(faces).IsValidIndex(k))
            ? mesh.RestrictedToFaces(faces).ElementCorner(ElementIndex(k), slot).Value
                == mesh.ElementCorner(mesh.ElementsOfFaces(faces)[k], slot).Value
            : true;

    // Library law: element k of the restriction approximates the face of the k-th kept element.
    Law_RestrictionKeepsEachElementFace(mesh: ModelMesh, faces: Array<BrepFaceIndex>, k: Integer): Boolean
        => (mesh.IsWellFormed && mesh.ElementsOfFaces(faces).IsValidIndex(k))
            ? mesh.RestrictedToFaces(faces).ElementFaceIs(ElementIndex(k), mesh.ElementFace[mesh.ElementsOfFaces(faces)[k]])
            : true;

    // Library law: restricting to every face of the mesh changes nothing about its counts.
    Law_RestrictionToEveryFaceKeepsTheEulerCharacteristic(mesh: ModelMesh): Boolean
        => mesh.IsWellFormed
            ? mesh.RestrictedToFaces(mesh.ElementFace).EulerCharacteristic == mesh.EulerCharacteristic
            : true;

    //==
    // # Witness

    // The literal meshes, chosen by an Integer as layer 7's WitnessAt chooses a model, so a law
    // over them takes an Integer the runner exhausts: 0 the unit tetrahedron, 1 its reversal.
    MeshWitnessAt(_: ModelMesh, k: Integer): ModelMesh
        => ((k % 2) + 2) % 2 == 0 ? ModelMesh.Witness_UnitTetrahedron : ModelMesh.Witness_UnitTetrahedron.Reversed;

    // Every literal mesh meets the ModelMesh invariants (IsWellFormed), so a law guarded by
    // IsWellFormed is not vacuous on them.
    Law_MeshWitnessIsWellFormed(k: Integer): Boolean
        => ModelMesh.MeshWitnessAt(k).IsWellFormed;

    // The mesh of a unit tetrahedron B-rep with 4 vertices, 6 straight edges, and 4 planar faces,
    // meshed with no interior points: positions (0,0,0), (1,0,0), (0,1,0), (0,0,1); one triangle per
    // face, numbered as the faces, each wound counter-clockwise seen from outside (normals -z, -y,
    // -x, and (1,1,1) / sqrt(3)). Each face's uvs are its corners' coordinates on the two world
    // axes its plane is a graph over. Euler characteristic 2, genus 0, closed, consistently
    // oriented, signed volume 1/6.
    Witness_UnitTetrahedron(_: ModelMesh): ModelMesh
    {
        var down = Direction3D(Vector3D(0.0, 0.0, -1.0));
        var front = Direction3D(Vector3D(0.0, -1.0, 0.0));
        var left = Direction3D(Vector3D(-1.0, 0.0, 0.0));
        var slant = Direction3D(Vector3D(1.0, 1.0, 1.0).Normalize);
        return ([Point3D(0.0, 0.0, 0.0), Point3D(1.0, 0.0, 0.0), Point3D(0.0, 1.0, 0.0), Point3D(0.0, 0.0, 1.0)],
                [TriangleFace(VertexIndex(0), VertexIndex(2), VertexIndex(1)),
                 TriangleFace(VertexIndex(0), VertexIndex(1), VertexIndex(3)),
                 TriangleFace(VertexIndex(0), VertexIndex(3), VertexIndex(2)),
                 TriangleFace(VertexIndex(1), VertexIndex(2), VertexIndex(3))],
                [],
                [down, down, down, front, front, front, left, left, left, slant, slant, slant],
                [UvCoordinate(0.0, 0.0), UvCoordinate(0.0, 1.0), UvCoordinate(1.0, 0.0),
                 UvCoordinate(0.0, 0.0), UvCoordinate(1.0, 0.0), UvCoordinate(0.0, 1.0),
                 UvCoordinate(0.0, 0.0), UvCoordinate(0.0, 1.0), UvCoordinate(1.0, 0.0),
                 UvCoordinate(1.0, 0.0), UvCoordinate(0.0, 1.0), UvCoordinate(0.0, 0.0)],
                [BrepFaceIndex(0), BrepFaceIndex(1), BrepFaceIndex(2), BrepFaceIndex(3)],
                [MeshVertexProvenance.OnVertex(BrepVertexIndex(0)), MeshVertexProvenance.OnVertex(BrepVertexIndex(1)),
                 MeshVertexProvenance.OnVertex(BrepVertexIndex(2)), MeshVertexProvenance.OnVertex(BrepVertexIndex(3))],
                MeshVertexNumbering(4, [4, 4, 4, 4, 4, 4, 4], [4, 4, 4, 4, 4]));
    }
}

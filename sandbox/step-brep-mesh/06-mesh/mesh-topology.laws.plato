//==
// # Model mesh topology: laws
//
// Three kinds, told apart by their comments. Table laws state what EdgeTableOf, ComponentsOf, and
// ComponentCountsOf promise for every mesh (library laws: a failure is a defect in this layer).
// Characterization laws tie each aggregate predicate to its pointwise meaning. Model laws state
// what a correct mesh of a valid closed shell satisfies (a failure is a finding about the mesh or
// the model, severity Error). All exact: integers and indices only.
//
// Sections, in order:
//  - The edge table
//  - Closed, manifold, consistently oriented
//  - Components
//  - Euler characteristic and genus
//  - Helpers

library ModelMeshTopologyLaws
{
    //==
    // # The edge table

    // Table invariant: ElementCounts has one entry per edge.
    EdgeTableHasOneCountPerEdge(t: MeshEdgeTable): Boolean
        => t.ElementCounts.Count == t.CountEdges;

    // Table invariant: DirectionSums has one entry per edge.
    EdgeTableHasOneDirectionSumPerEdge(t: MeshEdgeTable): Boolean
        => t.DirectionSums.Count == t.CountEdges;

    // Table invariant: every listed edge is canonical, its lower vertex index first.
    EdgeTableEdgeIsCanonical(t: MeshEdgeTable, k: UndirectedEdgeIndex): Boolean
        => t.Edges.UndirectedEdges.IsValidIndex(k)
            ? t.Edges.UndirectedEdges[k].A.Value < t.Edges.UndirectedEdges[k].B.Value
            : true;

    // Table invariant: the edges are in strictly increasing lexicographic order, so none is listed twice
    // and an edge's position is its UndirectedEdgeIndex.
    EdgeTableIsStrictlySorted(t: MeshEdgeTable, k: UndirectedEdgeIndex): Boolean
        => (k.Value >= 0 && k.Value + 1 < t.CountEdges)
            ? IsLexicographicallyBefore(t.Edges.UndirectedEdges[k.Value], t.Edges.UndirectedEdges[k.Value + 1])
            : true;

    // Table invariant: every listed edge has at least one element side on it.
    EdgeTableListsOnlyUsedEdges(t: MeshEdgeTable, k: UndirectedEdgeIndex): Boolean
        => t.ElementCounts.IsValidIndex(k) ? t.SidesOn(k) >= 1 : true;

    // Table law: the counts add up to the number of element sides with two distinct ends, so every
    // such side is counted once.
    Law_EdgeTableCountsEveryProperSide(mesh: ModelMesh): Boolean
        => mesh.EdgeTableOf.ElementCounts.IntegerTotal == mesh.ProperSideCount;

    // Table law: every proper element side lies on a listed edge.
    Law_EdgeTableListsEveryProperSide(mesh: ModelMesh, e: ElementIndex, slot: Integer): Boolean
        => (mesh.IsElementInRange(e) ? (slot >= 0 && slot < mesh.ElementArity(e)) : false)
            ? (mesh.ElementSide(e, slot).IsProper ? mesh.EdgeTableOf.ListsEdge(mesh.ElementSide(e, slot).Canonical) : true)
            : true;

    // Table law: edge k's count is the number of element sides on it, counted directly
    // (SideCountOf), independently of the sort that built the table.
    Law_EdgeTableCountMatchesItsSides(mesh: ModelMesh, k: UndirectedEdgeIndex): Boolean
        => mesh.EdgeTableOf.Edges.UndirectedEdges.IsValidIndex(k)
            ? mesh.EdgeTableOf.SidesOn(k) == mesh.SideCountOf(mesh.EdgeTableOf.Edges.UndirectedEdges[k])
            : true;

    // Table law: edge k's direction sum is the sum of its sides' directions, counted directly
    // (DirectionSumOf).
    Law_EdgeTableDirectionSumMatchesItsSides(mesh: ModelMesh, k: UndirectedEdgeIndex): Boolean
        => mesh.EdgeTableOf.Edges.UndirectedEdges.IsValidIndex(k)
            ? mesh.EdgeTableOf.DirectionSumOn(k) == mesh.DirectionSumOf(mesh.EdgeTableOf.Edges.UndirectedEdges[k])
            : true;

    // Table invariant: a direction sum never exceeds its edge's side count in magnitude.
    DirectionSumIsBoundedByCount(t: MeshEdgeTable, k: UndirectedEdgeIndex): Boolean
        => t.DirectionSumOn(k).Abs <= t.SidesOn(k);

    // Table invariant: a direction sum has the parity of its edge's side count, each side adding +1 or -1.
    DirectionSumHasTheParityOfCount(t: MeshEdgeTable, k: UndirectedEdgeIndex): Boolean
        => (t.SidesOn(k) - t.DirectionSumOn(k)) % 2 == 0;

    // Whether the edge table meets its invariants above: one count and one direction sum per edge,
    // every edge canonical and used, the edges strictly sorted, every direction sum bounded by its
    // count and of its parity. EdgeTableOf builds a table that does, from any mesh meeting the
    // ModelMesh invariants (Law_EdgeTableOfIsWellFormed); a generated table need not.
    IsWellFormed(t: MeshEdgeTable): Boolean
        => EdgeTableHasOneCountPerEdge(t) && EdgeTableHasOneDirectionSumPerEdge(t)
            && t.CountEdges.Range.All(i => EdgeTableEdgeIsCanonical(t, UndirectedEdgeIndex(i))
                && EdgeTableIsStrictlySorted(t, UndirectedEdgeIndex(i))
                && EdgeTableListsOnlyUsedEdges(t, UndirectedEdgeIndex(i))
                && DirectionSumIsBoundedByCount(t, UndirectedEdgeIndex(i))
                && DirectionSumHasTheParityOfCount(t, UndirectedEdgeIndex(i)));

    // Table law: the edge table of a mesh meeting the ModelMesh invariants meets its own.
    Law_EdgeTableOfIsWellFormed(mesh: ModelMesh): Boolean
        => mesh.IsWellFormed ? mesh.EdgeTableOf.IsWellFormed : true;

    // Table law: reversing every element negates every direction sum and changes nothing else, so
    // the reversed mesh is closed and manifold exactly when the mesh is.
    Law_ReversalNegatesEveryDirectionSum(mesh: ModelMesh, k: UndirectedEdgeIndex): Boolean
        => mesh.Reversed.EdgeTableOf.DirectionSumOn(k) == 0 - mesh.EdgeTableOf.DirectionSumOn(k);

    //==
    // # Closed, manifold, consistently oriented

    // Characterization: a closed mesh has exactly two element sides on every edge.
    Law_ClosedMeansEveryEdgeHasTwoSides(t: MeshEdgeTable, k: UndirectedEdgeIndex): Boolean
        => (t.IsClosed ? t.ElementCounts.IsValidIndex(k) : false) ? t.SidesOn(k) == 2 : true;

    // Characterization: a manifold mesh has at most two element sides on every edge.
    Law_ManifoldMeansNoEdgeHasMoreThanTwoSides(t: MeshEdgeTable, k: UndirectedEdgeIndex): Boolean
        => (t.IsManifold ? t.ElementCounts.IsValidIndex(k) : false) ? t.SidesOn(k) <= 2 : true;

    // Characterization: a mesh is consistently oriented exactly when no edge with two sides has both
    // traversing it in one direction.
    Law_OrientedExactlyWhenNoEdgeIsMisoriented(t: MeshEdgeTable): Boolean
        => t.IsConsistentlyOriented == (t.CountMisorientedEdges == 0);

    // Model law: a closed mesh has no pinched vertex: around every vertex the elements form one
    // fan, so a small sphere about the vertex meets the mesh in one circle.
    Law_ClosedMeshHasNoPinchedVertex(mesh: ModelMesh, v: VertexIndex): Boolean
        => (mesh.Positions.IsValidIndex(v) ? mesh.IsClosed : false) ? mesh.IsPinchedVertex(v).Not : true;

    //==
    // # Components

    // Table law: every corner of an element lies in the element's component.
    Law_ElementCornersShareItsComponent(mesh: ModelMesh, e: ElementIndex, slot: Integer): Boolean
        => (mesh.IsElementInRange(e) ? (slot >= 0 && slot < mesh.ElementArity(e)) : false)
            ? mesh.ComponentsOf.VertexComponentOf(mesh.ElementCorner(e, slot)).Value
                == mesh.ComponentsOf.ElementComponentOf(e).Value
            : true;

    // Table law: each element's parent in the spanning forest is an element of the same component.
    Law_ComponentParentIsInItsComponent(mesh: ModelMesh, e: ElementIndex): Boolean
        => mesh.IsElementInRange(e)
            ? (mesh.IsElementInRange(mesh.ComponentsOf.ElementParentOf(e))
                ? mesh.ComponentsOf.ElementComponentOf(mesh.ComponentsOf.ElementParentOf(e)).Value
                    == mesh.ComponentsOf.ElementComponentOf(e).Value
                : false)
            : true;

    // Table law: each element that is not a root shares a vertex with its parent, so a parent
    // chain is a chain of elements each sharing a vertex with the next.
    Law_ComponentParentSharesAVertex(mesh: ModelMesh, e: ElementIndex): Boolean
        => (mesh.IsElementInRange(e) ? mesh.ComponentsOf.IsComponentRoot(e).Not : false)
            ? mesh.SharesAVertex(e, mesh.ComponentsOf.ElementParentOf(e))
            : true;

    // Table law: an element is a root exactly when its depth is 0.
    Law_ComponentRootHasDepthZero(mesh: ModelMesh, e: ElementIndex): Boolean
        => mesh.IsElementInRange(e)
            ? mesh.ComponentsOf.IsComponentRoot(e) == (mesh.ComponentsOf.ElementDepthOf(e) == 0)
            : true;

    // Table law: a non-root element is one level deeper than its parent, so every parent chain
    // reaches a root in at most its depth steps.
    Law_ComponentParentIsOneShallower(mesh: ModelMesh, e: ElementIndex): Boolean
        => (mesh.IsElementInRange(e) ? mesh.ComponentsOf.IsComponentRoot(e).Not : false)
            ? mesh.ComponentsOf.ElementDepthOf(mesh.ComponentsOf.ElementParentOf(e)) + 1
                == mesh.ComponentsOf.ElementDepthOf(e)
            : true;

    // Table law: a root is the lowest element of its component. Two roots of one component would
    // each be below the other, so a component has exactly one root.
    Law_ComponentRootIsItsLowestElement(mesh: ModelMesh, r: ElementIndex, e: ElementIndex): Boolean
        => ((mesh.IsElementInRange(r) && mesh.IsElementInRange(e)) ? mesh.ComponentsOf.IsComponentRoot(r) : false)
            ? (mesh.ComponentsOf.ElementComponentOf(r).Value == mesh.ComponentsOf.ElementComponentOf(e).Value
                ? r.Value <= e.Value
                : true)
            : true;

    // Table law: components are numbered in the order of their roots, which are their lowest
    // elements: the component rooted at r is the number of roots below r.
    Law_ComponentsAreNumberedByRoot(mesh: ModelMesh, r: ElementIndex): Boolean
        => (mesh.IsElementInRange(r) ? mesh.ComponentsOf.IsComponentRoot(r) : false)
            ? mesh.ComponentsOf.ElementComponentOf(r).Value == mesh.ComponentsOf.RootsBelow(r)
            : true;

    // Table law: there is one component per root.
    Law_ComponentCountIsRootCount(mesh: ModelMesh): Boolean
        => mesh.ComponentsOf.ComponentCount == mesh.ComponentsOf.RootCount;

    // Table law: the components' Euler characteristics, plus one for each unreferenced vertex (a
    // point is its own component), add up to the mesh's.
    Law_ComponentEulerCharacteristicsAddUp(mesh: ModelMesh): Boolean
        => mesh.IsWellFormed
            ? (mesh.ComponentCountsOf(mesh.EdgeTableOf, mesh.ComponentsOf).Map(c => c.EulerCharacteristic).IntegerTotal
                + mesh.ComponentsOf.UnreferencedVertexCount
                == mesh.EulerCharacteristic)
            : true;

    //==
    // # Euler characteristic and genus

    // Model law, by the classification of surfaces: a connected, closed, consistently oriented
    // surface has an even Euler characteristic of at most 2, so it has a genus. Failing it means
    // the counts are wrong, since no such surface exists.
    Law_ClosedOrientedSurfaceHasGenus(mesh: ModelMesh, c: MeshComponentIndex): Boolean
        => mesh.IsWellFormed
            ? ((mesh.CountsOf(c).IsClosed && mesh.CountsOf(c).IsConsistentlyOriented && mesh.CountsOf(c).IsSurface)
                ? mesh.CountsOf(c).HasGenus
                : true)
            : true;

    // Model law, by the classification of compact surfaces with boundary: a connected, consistently
    // oriented surface with boundary edges has 2 - chi - B even and non-negative, B its boundary
    // cycles, so it has a genus. The closed case is Law_ClosedOrientedSurfaceHasGenus.
    Law_OrientedSurfaceWithBoundaryHasGenus(mesh: ModelMesh, c: MeshComponentIndex): Boolean
        => (mesh.CountsOf(c).BoundaryEdges > 0 && mesh.CountsOf(c).IsConsistentlyOriented && mesh.CountsOf(c).IsSurface)
            ? mesh.CountsOf(c).HasGenus
            : true;

    // Library law: the Euler characteristic of a closed component with a genus is 2 minus twice
    // its genus. Holds for every counts record, so the runner can check it on random ones.
    Law_ClosedComponentEulerIsTwoMinusTwiceGenus(c: MeshComponentCounts): Boolean
        => (c.HasGenus && c.IsClosed && c.BoundaryCycles == 0) ? c.EulerCharacteristic == 2 - 2 * c.Genus(0) : true;

    // Library law: the Euler characteristic of a component with a genus is 2 minus twice its genus
    // minus its boundary cycles. Holds for every counts record.
    Law_EulerIsTwoMinusTwiceGenusMinusBoundaryCycles(c: MeshComponentCounts): Boolean
        => c.HasGenus ? c.EulerCharacteristic == 2 - 2 * c.Genus(0) - c.BoundaryCycles : true;

    //==
    // # Helpers

    // Whether pair a comes strictly before pair b: by A, then by B.
    IsLexicographicallyBefore(a: VertexPair, b: VertexPair): Boolean
        => a.A.Value < b.A.Value || (a.A.Value == b.A.Value && a.B.Value < b.B.Value);
}

//==
// # Proofs about face meshes and the model mesh (constructors)
//
// One Check* function per proof type of mesh-proofs.types.plato, each over
// the predicates of layers 5 and 6. CheckCheckedMesh reads layer 7's
// RestrictedToShell and is in 07-validation/validation-proofs.library.plato;
// its verdict and ComponentCountsOf are here. A property checked and found
// false is Fails, naming the predicate; an input the predicate cannot be
// asked of is OutOfDomain.
//
// Sections, in order:
//  - Face outcomes
//  - The model mesh
//  - Quads
//  - Verdicts

library ModelMeshProofs
{
    //==
    // # Face outcomes

    // True when the outcome holds a non-empty mesh and no blocking request.
    IsMeshedOutcome(o: FaceMeshOutcome): Boolean
        => o.Mesh.IsEmptyFaceMesh.Not && o.HasBlockingRequest.Not;

    // True when outcomes pairs with faces one to one, outcome i is of face
    // i, and every outcome is meshed.
    IsMeshedFaceSet(faces: Array<BrepFaceIndex>, outcomes: Array<FaceMeshOutcome>): Boolean
        => faces.Count == outcomes.Count
            ? faces.Count.Range.All(i => outcomes[i].Mesh.Face == faces[i] && outcomes[i].IsMeshedOutcome)
            : false;

    // The faces of m in face order.
    FacesInOrder(m: BrepModel): Array<BrepFaceIndex>
        => m.Faces.Count.MapRange(i => BrepFaceIndex(i));

    // The pairs as a MeshedFaceSet when every face's outcome is meshed;
    // Fails otherwise.
    CheckMeshedFaceSet(faces: Array<BrepFaceIndex>, outcomes: Array<FaceMeshOutcome>): DecidedMeshedFaceSet
        => IsMeshedFaceSet(faces, outcomes)
            ? DecidedMeshedFaceSet.Decided(MeshedFaceSet(faces, outcomes))
            : DecidedMeshedFaceSet.Undecided(UndecidedReason.Fails("IsMeshedFaceSet"));

    // The model and its outcomes as a FullyMeshedModel when the outcomes
    // are a meshed face set over every face of m, in face order; Fails
    // otherwise.
    CheckFullyMeshedModel(m: BrepModel, outcomes: Array<FaceMeshOutcome>): DecidedFullyMeshedModel
        => IsMeshedFaceSet(m.FacesInOrder, outcomes)
            ? DecidedFullyMeshedModel.Decided(FullyMeshedModel(m, outcomes))
            : DecidedFullyMeshedModel.Undecided(UndecidedReason.Fails("IsMeshedFaceSet over every face"));

    //==
    // # The model mesh

    // The mesh as a WatertightMesh when it is well formed and closed; Fails
    // when an edge lacks two sides, OutOfDomain when it is not well formed.
    CheckWatertightMesh(mesh: ModelMesh): DecidedWatertightMesh
        => mesh.IsWellFormed
            ? (mesh.IsClosed
                ? DecidedWatertightMesh.Decided(WatertightMesh(mesh))
                : DecidedWatertightMesh.Undecided(UndecidedReason.Fails("IsClosed")))
            : DecidedWatertightMesh.Undecided(UndecidedReason.OutOfDomain);

    // The counts of each component of the mesh, in component order.
    ComponentCountsOf(mesh: ModelMesh): Array<MeshComponentCounts>
        => mesh.ComponentCountsOf(mesh.EdgeTableOf, mesh.ComponentsOf);

    // True when every element of the mesh has corners naming positions, so
    // its quality can be measured.
    IsMeasurable(mesh: ModelMesh): Boolean
        => mesh.ElementCount.Range.All(e => mesh.HasValidCorners(ElementIndex(e)));

    // The mesh with the quality of each triangle and quad when it is well
    // formed and measurable; OutOfDomain otherwise.
    CheckQualityGradedMesh(mesh: ModelMesh): DecidedQualityGradedMesh
        => (mesh.IsWellFormed ? mesh.IsMeasurable : false)
            ? DecidedQualityGradedMesh.Decided(QualityGradedMesh(mesh,
                mesh.Triangles.Count.MapRange(k => mesh.TriangleQualityAt(ElementIndex(k))),
                mesh.Quads.Count.MapRange(q => mesh.QuadQualityAt(ElementIndex(mesh.Triangles.Count + q)))))
            : DecidedQualityGradedMesh.Undecided(UndecidedReason.OutOfDomain);

    //==
    // # Quads

    // Quad q of the face mesh as a PlanarQuad, with its warp, when the warp
    // is within c's SurfaceChordal; ToleranceExceeded by the excess when
    // not, OutOfDomain when the quad cannot be measured.
    CheckPlanarQuad(fm: FaceMesh, q: FaceIndex, c: FaceMeshingCriteria): DecidedPlanarQuad
        => fm.IsMeasurableQuad(q)
            ? (fm.QuadWarp(q) <= c.SurfaceChordal
                ? DecidedPlanarQuad.Decided(PlanarQuad(fm.Quads[q], ModelLength(fm.QuadWarp(q))))
                : DecidedPlanarQuad.Undecided(UndecidedReason.ToleranceExceeded(ModelLength(fm.QuadWarp(q) - c.SurfaceChordal).ToMeasure)))
            : DecidedPlanarQuad.Undecided(UndecidedReason.OutOfDomain);

    // Quad q of the face mesh as a ConvexQuad when it is strictly convex;
    // Fails when it is not, OutOfDomain when it cannot be measured.
    CheckConvexQuad(fm: FaceMesh, q: FaceIndex): DecidedConvexQuad
        => fm.IsMeasurableQuad(q)
            ? (fm.IsConvexQuad(q)
                ? DecidedConvexQuad.Decided(ConvexQuad(fm.Quads[q]))
                : DecidedConvexQuad.Undecided(UndecidedReason.Fails("IsConvexQuad")))
            : DecidedConvexQuad.Undecided(UndecidedReason.OutOfDomain);

    //==
    // # Verdicts

    // True when the check built its proof.
    IsDecided(d: DecidedMeshedFaceSet): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedFullyMeshedModel): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedWatertightMesh): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedCheckedMesh): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedQualityGradedMesh): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedPlanarQuad): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedConvexQuad): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };
}

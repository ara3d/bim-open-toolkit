//==
// # Model mesh incidence: functions (complexity sweep, chunk M2)
//
// The vertex-to-element incidence of a ModelMesh in compressed rows, built in one counting pass,
// a prefix sum and one fill pass, and the component, link and per-component counts that read it
// instead of scanning every element per vertex (docs/plans/step-mesher-complexity.md, candidate
// 10). Each function returns what its reference form in 06-mesh/mesh-topology.library.plato
// returns: ComponentsOf, IsPinchedVertex, CountsOfComponent and ComponentCountsOf.
//
// The incidence is a VertexIncidence (mesh-incidence.types.plato) with one row per vertex: row v lists, in
// increasing order and once each, the elements with a corner at v. A corner that names no
// position is in no row.
//
// Sections, in order:
//  - The incidence
//  - Components
//  - The link of a vertex
//  - Per-component counts

library ModelMeshIncidence
{
    //==
    // # The incidence

    // Whether slot s of a corner list is the first slot holding its vertex, so an element that
    // repeats a vertex enters that vertex's row once.
    IsFirstOccurrence(corners: Array<VertexIndex>, s: Integer): Boolean
        => s.Range.All(k => corners[k].Value != corners[s].Value);

    // VertexElementIncidence with its work counted: Insertions is the number of entries written
    // to the rows, one per distinct in-range corner of each element, so at most 3T + 4Q.
    VertexElementIncidenceCounted(mesh: ModelMesh): Counted<VertexIncidence>
    {
        var vertexCount = mesh.Positions.Count;
        var elementCount = mesh.ElementCount;
        var offsets = new Buffer<Integer>(vertexCount + 1);
        var i = 0;
        while (i <= vertexCount)
        {
            offsets = offsets.Set(i, 0);
            i = i + 1;
        }
        var e = 0;
        while (e < elementCount)
        {
            var corners = mesh.ElementCornerList(ElementIndex(e));
            var s = 0;
            while (s < corners.Count)
            {
                var v = corners[s].Value;
                if (v >= 0 && v < vertexCount)
                {
                    if (corners.IsFirstOccurrence(s))
                    {
                        offsets = offsets.Set(v + 1, offsets.At(v + 1) + 1);
                    }
                }
                s = s + 1;
            }
            e = e + 1;
        }
        var r = 0;
        while (r < vertexCount)
        {
            offsets = offsets.Set(r + 1, offsets.At(r + 1) + offsets.At(r));
            r = r + 1;
        }
        var starts = offsets.Freeze();
        var total = starts[vertexCount];
        var cursor = new Buffer<Integer>(vertexCount.Max(1));
        var j = 0;
        while (j < vertexCount)
        {
            cursor = cursor.Set(j, starts[j]);
            j = j + 1;
        }
        var items = new Buffer<Integer>(total.Max(1));
        var written = 0;
        var f = 0;
        while (f < elementCount)
        {
            var around = mesh.ElementCornerList(ElementIndex(f));
            var t = 0;
            while (t < around.Count)
            {
                var u = around[t].Value;
                if (u >= 0 && u < vertexCount)
                {
                    if (around.IsFirstOccurrence(t))
                    {
                        items = items.Set(cursor.At(u), f);
                        cursor = cursor.Set(u, cursor.At(u) + 1);
                        written = written + 1;
                    }
                }
                t = t + 1;
            }
            f = f + 1;
        }
        var values = items.Freeze();
        return Counted(VertexIncidence(starts, total.MapRange(k => ElementIndex(values[k]))), Insertions(written));
    }

    // The vertex-to-element incidence of the mesh: row v lists the elements with a corner at v,
    // in increasing order, once each. Offsets has one entry per vertex plus one.
    VertexElementIncidence(mesh: ModelMesh): VertexIncidence
        => mesh.VertexElementIncidenceCounted.Value;

    // The number of elements with a corner at vertex v. Precondition: v names a vertex.
    IncidentCount(incidence: VertexIncidence, v: Integer): Integer
        => incidence.Offsets[v + 1] - incidence.Offsets[v];

    // The k-th element with a corner at vertex v. Precondition: 0 <= k < IncidentCount(v).
    IncidentElement(incidence: VertexIncidence, v: Integer, k: Integer): ElementIndex
        => incidence.Elements[incidence.Offsets[v] + k];

    //==
    // # Components

    // ComponentsOfIndexed with its work counted: Insertions is the number of element visits, one
    // per element taken from the queue and one per element read from an incidence row. Each row
    // is read once, by the first element of the queue with a corner at its vertex, because that
    // read gives every element of the row a depth and a later read would change nothing; so the
    // visits are at most T + Q plus the row entries, 3T + 4Q.
    ComponentsOfIndexedCounted(mesh: ModelMesh, incidence: VertexIncidence): Counted<MeshComponents>
    {
        var vertexCount = mesh.Positions.Count;
        var elementCount = mesh.ElementCount;
        var parent = new Buffer<Integer>(elementCount.Max(1));
        var depth = new Buffer<Integer>(elementCount.Max(1));
        var component = new Buffer<Integer>(elementCount.Max(1));
        var i = 0;
        while (i < elementCount)
        {
            parent = parent.Set(i, -1);
            depth = depth.Set(i, -1);
            component = component.Set(i, -1);
            i = i + 1;
        }
        var read = new Buffer<Integer>(vertexCount.Max(1));
        var w = 0;
        while (w < vertexCount)
        {
            read = read.Set(w, 0);
            w = w + 1;
        }
        var visits = 0;
        var next = 0;
        var root = 0;
        while (root < elementCount)
        {
            if (depth.At(root) < 0)
            {
                parent = parent.Set(root, root);
                depth = depth.Set(root, 0);
                component = component.Set(root, next);
                var queue = new List<Integer>().Add(root);
                var head = 0;
                while (head < queue.Count)
                {
                    var e = queue.At(head);
                    visits = visits + 1;
                    var corners = mesh.ElementCornerList(ElementIndex(e));
                    var c = 0;
                    while (c < corners.Count)
                    {
                        var v = corners[c].Value;
                        if (v >= 0 && v < vertexCount)
                        {
                            if (read.At(v) == 0)
                            {
                                read = read.Set(v, 1);
                                var a = incidence.Offsets[v];
                                var end = incidence.Offsets[v + 1];
                                while (a < end)
                                {
                                    var x = incidence.Elements[a].Value;
                                    visits = visits + 1;
                                    if (depth.At(x) < 0)
                                    {
                                        parent = parent.Set(x, e);
                                        depth = depth.Set(x, depth.At(e) + 1);
                                        component = component.Set(x, next);
                                        queue = queue.Add(x);
                                    }
                                    a = a + 1;
                                }
                            }
                        }
                        c = c + 1;
                    }
                    head = head + 1;
                }
                next = next + 1;
            }
            root = root + 1;
        }
        var elementComponent = component.Freeze().Take(elementCount);
        var parents = parent.Freeze().Take(elementCount);
        var depths = depth.Freeze().Take(elementCount);
        return Counted(
            MeshComponents(
                elementComponent.Map(x => MeshComponentIndex(x)),
                vertexCount.MapRange(v => incidence.IncidentCount(v) == 0
                    ? MeshComponentIndex(-1)
                    : MeshComponentIndex(elementComponent[incidence.IncidentElement(v, 0).Value])),
                next,
                parents.Map(x => ElementIndex(x)),
                depths),
            Insertions(visits));
    }

    // The components of the mesh, as ComponentsOf states them, by one breadth-first search per
    // component over the given incidence. Precondition: incidence is mesh.VertexElementIncidence.
    ComponentsOfIndexed(mesh: ModelMesh, incidence: VertexIncidence): MeshComponents
        => mesh.ComponentsOfIndexedCounted(incidence).Value;

    // ComponentsOf with its incidence built here and both works added: at most
    // 2(3T + 4Q) + T + Q element visits, linear in the mesh.
    ComponentsOfCounted(mesh: ModelMesh): Counted<MeshComponents>
    {
        var incidence = mesh.VertexElementIncidenceCounted;
        var comps = mesh.ComponentsOfIndexedCounted(incidence.Value);
        return Counted(comps.Value, Add(incidence.Work, comps.Work));
    }

    //==
    // # The link of a vertex

    // LinkEdges of vertex v, read from the elements of v's incidence row instead of every
    // element: the same pairs in the same order (elements in increasing order, slots in winding
    // order). Precondition: v names a vertex.
    LinkEdgesIndexed(mesh: ModelMesh, incidence: VertexIncidence, v: Integer): Array<VertexPair>
        => incidence.IncidentCount(v).MapRange(k => incidence.IncidentElement(v, k))
            .FlatMap(e => mesh.ElementArity(e).MapRange(s => s)
                .FlatMap(s => mesh.ElementCorner(e, s).Value == v
                    ? [VertexPair(mesh.ElementCorner(e, (s + mesh.ElementArity(e) - 1) % mesh.ElementArity(e)),
                        mesh.ElementCorner(e, (s + 1) % mesh.ElementArity(e)))]
                    : []));

    // The largest number of pairs of a link meeting one of its ends; 0 for an empty link:
    // LinkMaxDegree over a link built once.
    MaxEndDegree(link: Array<VertexPair>): Integer
        => link.FlatMap(p => [p.A, p.B])
            .Map(w => link.Map(q => q.A.Value == w.Value || q.B.Value == w.Value).CountTrue)
            .Reduce(0, (a, b) => a.Max(b));

    // Whether a non-empty link is neither one cycle nor one path. The piece count runs only when
    // no link vertex has degree above 2.
    IsPinchedLink(link: Array<VertexPair>): Boolean
        => link.IsEmpty ? false : (link.MaxEndDegree > 2 ? true : link.PieceCount != 1);

    // IsPinchedVertex of v with its link built once from v's incidence row. A v that names no
    // position, which an out-of-range corner can still reference, takes the reference form.
    // Precondition: incidence is mesh.VertexElementIncidence.
    IsPinchedVertexIndexed(mesh: ModelMesh, incidence: VertexIncidence, v: VertexIndex): Boolean
        => mesh.Positions.IsValidIndex(v)
            ? mesh.LinkEdgesIndexed(incidence, v.Value).IsPinchedLink
            : mesh.IsPinchedVertex(v);

    //==
    // # Per-component counts

    // CountsOfComponent of component c, its pinched vertices tested with IsPinchedVertexIndexed
    // over the given incidence. Precondition: incidence is mesh.VertexElementIncidence.
    CountsOfComponentIndexed(mesh: ModelMesh, t: MeshEdgeTable, comps: MeshComponents,
        incidence: VertexIncidence, c: Integer): MeshComponentCounts
    {
        var edges = t.CountEdges.Range.FlatMap(k =>
            comps.VertexComponentOf(t.Edges.UndirectedEdges[k].A).Value == c ? [k] : Integer.NoIndices);
        return MeshComponentCounts(
            comps.ComponentVertexCount(MeshComponentIndex(c)),
            edges.Count,
            mesh.Triangles.Count.Range.Map(k => comps.ElementComponentOf(ElementIndex(k)).Value == c).CountTrue,
            mesh.Quads.Count.Range.Map(k => comps.ElementComponentOf(ElementIndex(mesh.Triangles.Count + k)).Value == c).CountTrue,
            edges.Map(k => t.IsBoundaryEdge(UndirectedEdgeIndex(k))).CountTrue,
            edges.Map(k => t.IsNonManifoldEdge(UndirectedEdgeIndex(k))).CountTrue,
            edges.Map(k => t.IsMisorientedEdge(UndirectedEdgeIndex(k))).CountTrue,
            mesh.Positions.Count.Range.Map(k =>
                comps.VertexComponentOf(VertexIndex(k)).Value == c ? mesh.IsPinchedVertexIndexed(incidence, VertexIndex(k)) : false).CountTrue,
            t.BoundaryEdgesOf(comps, MeshComponentIndex(c)).PieceCount);
    }

    // ComponentCountsOf over one incidence built once for every component.
    ComponentCountsOfIndexed(mesh: ModelMesh, t: MeshEdgeTable, comps: MeshComponents,
        incidence: VertexIncidence): Array<MeshComponentCounts>
        => comps.ComponentCount.MapRange(c => mesh.CountsOfComponentIndexed(t, comps, incidence, c));
}

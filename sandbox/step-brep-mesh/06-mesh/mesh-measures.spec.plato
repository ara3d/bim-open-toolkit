//==
// # Model mesh measures: specification
//
// The contract of the one deferred measure, and the theorems behind the angle and volume laws.
//
// Sections, in order:
//  - Coincident vertices
//  - The discrete Gauss-Bonnet identity
//  - Signed volume

//==
// # Coincident vertices

// The pairs of distinct vertices of one component closer than the tolerance: reported, never
// merged.
spec CoincidentVertexPairs(mesh: ModelMesh, comps: MeshComponents, tol: LengthTolerance): Array<VertexPair>
{
    requires tol.Value >= 0.0;
    requires comps == mesh.ComponentsOf;
    ensures forall (k: Integer) : Law_ReportedPairIsCoincident(mesh, k, tol);
    ensures forall (a: VertexIndex) : forall (b: VertexIndex) : Law_CoincidentPairIsReported(mesh, a, b, tol);
    ensures forall (k: Integer) in (result.Count - 1).Max(0).Range :
        IsLexicographicallyBefore(result[k], result[k + 1]);
    measure mesh.Positions.Count + result.Count;
    deferred "spatial hash of cell size tol.Value, each vertex compared with the 27 surrounding cells";
}

//==
// # The discrete Gauss-Bonnet identity

// On a closed triangle component the angle defects sum to exactly 2 pi times the Euler
// characteristic, in real arithmetic, whatever the positions.
theorem DiscreteGaussBonnet
{
    given mesh: ModelMesh, c: MeshComponentIndex;
    assume mesh.HasAllValidCorners;
    assume mesh.CountsOf(c).IsClosed;
    assume mesh.CountsOf(c).Quads == 0;
    assume forall (e: ElementIndex) : mesh.HasValidCorners(e) ? mesh.ElementSmallestAltitude(e) > 0.0 : true;
    conclude mesh.AngleDefectSum(mesh.ComponentsOf, c).Radians
        == Number.Tau * mesh.CountsOf(c).EulerCharacteristic.ToNumber;
    because "Summing the defects gives 2 pi V - (sum of all corner angles) = 2 pi V - pi T, since the
             angles of each non-degenerate flat triangle sum to pi. Closedness gives 3T = 2E, so
             T = 2(E - T) and 2 pi V - pi T = 2 pi (V - E + T) = 2 pi chi (VALIDATION-MATH.md 4.5).
             Only the angle sums and 3T = 2E are used: the identity holds for any positions, so it
             checks the angle and counting code, not the geometry. In floating point each corner
             angle carries a rounding error of about 13 unit roundoffs, which the law bounds by
             ResolutionAt of the sum's magnitude (DefectSumResolution).";
    tested by Law_AngleDefectSumIsTwoPiTimesEuler, Law_TriangleAngleSumIsPi;
}

// With quads, the defects exceed 2 pi chi by exactly the quads' own angle defects.
theorem MixedGaussBonnet
{
    given mesh: ModelMesh, c: MeshComponentIndex;
    assume mesh.HasAllValidCorners;
    assume mesh.CountsOf(c).IsClosed;
    assume forall (e: ElementIndex) : mesh.HasValidCorners(e) ? mesh.ElementSmallestAltitude(e) > 0.0 : true;
    conclude mesh.AngleDefectSum(mesh.ComponentsOf, c).Radians
        == Number.Tau * mesh.CountsOf(c).EulerCharacteristic.ToNumber
            + mesh.QuadAngleDefectSum(mesh.ComponentsOf, c).Radians;
    because "Closedness gives 2E = 3T + 4Q, so chi = V - T/2 - Q. The defect sum is
             2 pi V - pi T - (sum over quads of their angle sums) = 2 pi V - pi T - 2 pi Q
             + (sum of quad defects) = 2 pi chi + (sum of quad defects). A quad's defect is at least
             0, and 0 exactly when the quad is planar and convex (VALIDATION-MATH.md 4.5, lemma).";
    tested by Law_AngleDefectSumIsTwoPiTimesEulerPlusQuadDefects, Law_QuadAngleDefectIsNotNegative;
}

//==
// # Signed volume

// A closed, consistently oriented mesh whose elements face out of the region they bound has
// non-negative signed volume, equal to the volume of that region.
theorem SignedVolumeSignIsOrientation
{
    given mesh: ModelMesh;
    assume mesh.HasAllValidCorners;
    assume mesh.IsClosed;
    assume mesh.IsConsistentlyOriented;
    assume forall (q: Point3D) : mesh.WindingNumber(q) >= 0.0;
    conclude mesh.SignedVolume >= 0.0;
    because "By the divergence theorem with the field x / 3, the sum over elements of the signed
             tetrahedron volumes from any origin equals the integral over space of the winding
             number (VALIDATION-MATH.md 4.7). For a closed, consistently oriented mesh the winding
             number is an integer off the mesh; elements facing out of the region they bound make it
             1 inside and 0 outside, so the integral is the region's volume, at least 0. The witness
             law shows the strict sign on a tetrahedron; reversing every element negates the winding
             number and the volume.";
    tested by Law_OutwardTetrahedronHasPositiveVolume, Law_ReversalNegatesSignedVolume;
}

//==
// # Assembling the model mesh: specification
//
// The contract of AssembleModelMesh and the theorem that makes the assembled mesh watertight by
// index. Closedness of the whole mesh needs, in addition, that each face mesh tiles its face with
// every boundary segment used once (05-face-meshing's contract); 08-pipeline's
// WatertightByConstruction combines the two.
//
// Sections, in order:
//  - Assembly
//  - Watertightness

//==
// # Assembly

// Concatenates the face meshes and welds them by site, never by distance.
spec AssembleModelMesh(m: BrepModel, faceMeshes: Array<FaceMesh>, numbering: MeshVertexNumbering): ModelMesh
{
    requires m.CanAssemble(faceMeshes, numbering);
    requires forall (k: Integer) in faceMeshes.Count.Range : forall (i: VertexIndex) :
        FaceMeshSourceAgreesWithProvenance(faceMeshes[k], i);
    requires forall (k: Integer) in faceMeshes.Count.Range : forall (i: VertexIndex) : forall (j: VertexIndex) :
        DistinctLocalVerticesHaveDistinctGlobalVertices(numbering, faceMeshes[k], i, j);
    requires forall (k: Integer) in faceMeshes.Count.Range : forall (l: Integer) in faceMeshes.Count.Range :
        forall (i: VertexIndex) : forall (j: VertexIndex) : Law_FaceMeshesAgreeOnSharedSites(faceMeshes[k], faceMeshes[l], i, j);
    requires forall (k: Integer) in faceMeshes.Count.Range : forall (i: VertexIndex) :
        Law_FaceMeshModelVertexIsModelPoint(m, faceMeshes[k], i);
    ensures Law_AssemblyKeepsTheNumbering(m, faceMeshes, numbering);
    ensures Law_AssemblyKeepsEveryTriangle(m, faceMeshes, numbering);
    ensures Law_AssemblyKeepsEveryQuad(m, faceMeshes, numbering);
    ensures forall (v: BrepVertexIndex) : Law_AssembledModelVertexIsModelPoint(m, faceMeshes, numbering, v);
    ensures forall (f: BrepFaceIndex) : forall (i: VertexIndex) :
        Law_AssembledPositionIsFaceMeshPosition(m, faceMeshes, numbering, f, i);
    ensures forall (f: BrepFaceIndex) : forall (e: ElementIndex) : forall (slot: Integer) :
        Law_AssembledCornerIsGlobalVertexOfFaceMeshCorner(m, faceMeshes, numbering, f, e, slot);
    ensures forall (f: BrepFaceIndex) : forall (e: ElementIndex) :
        Law_AssembledElementRemembersItsFace(m, faceMeshes, numbering, f, e);
    ensures forall (f: BrepFaceIndex) : forall (e: ElementIndex) : forall (slot: Integer) :
        Law_AssembledCornerUvIsCopied(m, faceMeshes, numbering, f, e, slot);
    ensures forall (f: BrepFaceIndex) : forall (e: ElementIndex) : forall (slot: Integer) :
        Law_AssembledCornerNormalIsCopied(m, faceMeshes, numbering, f, e, slot);
    ensures ElementFaceHasOneEntryPerElement(result);
    ensures CornerNormalsHaveOneEntryPerCorner(result);
    ensures CornerUvsHaveOneEntryPerCorner(result);
    ensures VertexProvenanceHasOneEntryPerVertex(result);
    ensures NumberingCoversPositions(result);
    ensures forall (e: ElementIndex) : ElementCornersInRange(result, e);
    ensures forall (v: VertexIndex) : VertexProvenanceMatchesNumbering(result, v);
    ensures Law_AreaIsSumOfFaceMeshAreas(m, faceMeshes, numbering, m.Tolerances.Length);
    measure m.Vertices.Count + faceMeshes.Map(fm => fm.Sources.Count + fm.FaceMeshElementCount).IntegerTotal;
    deferred "one pass writing positions and provenance by global index; elements concatenated, corners mapped by GlobalVertexOf";
}

//==
// # Watertightness

// Element corners of different face meshes that cite one model boundary sample are one vertex of
// the assembled mesh: the shared boundary is welded by index identity, with no tolerance.
theorem WatertightByNumbering
{
    given m: BrepModel, faceMeshes: Array<FaceMesh>, n: MeshVertexNumbering,
          f: BrepFaceIndex, ea: ElementIndex, sa: Integer, g: BrepFaceIndex, eb: ElementIndex, sb: Integer;
    assume m.CanAssemble(faceMeshes, n);
    assume faceMeshes.HasFaceMeshCorner(f, ea, sa);
    assume faceMeshes.HasFaceMeshCorner(g, eb, sb);
    assume IsSameBoundarySample(faceMeshes.CornerSource(f, ea, sa), faceMeshes.CornerSource(g, eb, sb));
    conclude m.AssembleModelMesh(faceMeshes, n).ElementCorner(faceMeshes.AssembledElement(f, ea), sa)
        == m.AssembleModelMesh(faceMeshes, n).ElementCorner(faceMeshes.AssembledElement(g, eb), sb);
    because "By the contract of AssembleModelMesh (Law_AssembledCornerIsGlobalVertexOfFaceMeshCorner),
             each assembled corner is GlobalVertexOf the face mesh corner's parameter-space point. By
             SharedSamplesShareAnIndex the two points, citing one boundary sample, have one global
             vertex. Hence the two corners are equal. Consequently, when both faces adjacent to a
             model edge cite every point of that edge's single discretization along their boundary,
             their boundary sides along the edge are the same pairs of global vertices: no crack
             and no T-junction, and no vertex is merged by position.";
    tested by Law_AssembledSharedBoundaryCornersCoincide, SharedBoundarySampleHasOneGlobalVertex;
}

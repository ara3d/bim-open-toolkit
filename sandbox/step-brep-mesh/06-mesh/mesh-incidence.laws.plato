//==
// # Model mesh incidence: laws (complexity sweep, chunk M2)
//
// The indexed forms of mesh-incidence.library.plato agree with their references in
// 06-mesh/mesh-topology.library.plato on a set of small literal meshes chosen by an Integer, as
// layer 06's MeshWitnessAt chooses one: a closed tetrahedron and its reversal, an open fan, two
// tetrahedra pinched at one vertex, two components interleaved in element order with an
// unreferenced vertex, and a quad beside a triangle that repeats a vertex. One count witness
// shows ComponentsOfCounted is linear on a family of fans, where the reference reads the centre's
// row once per element.
//
// Sections, in order:
//  - Literal meshes
//  - Comparisons
//  - Agreement
//  - Count witness

library ModelMeshIncidenceLaws
{
    //==
    // # Literal meshes

    // A mesh of the given positions, triangles and quads, its corner attributes, element faces,
    // provenance and numbering filled with placeholders: only its combinatorics is read here.
    IncidenceTestMesh(positions: Array<Point3D>, triangles: Array<TriangleFace>, quads: Array<QuadFace>): ModelMesh
    {
        var corners = 3 * triangles.Count + 4 * quads.Count;
        return (positions,
            triangles,
            quads,
            corners.MapRange(k => Direction3D(Vector3D(0.0, 0.0, 1.0))),
            corners.MapRange(k => UvCoordinate(0.0, 0.0)),
            (triangles.Count + quads.Count).MapRange(k => BrepFaceIndex(0)),
            positions.Count.MapRange(k => MeshVertexProvenance.OnVertex(BrepVertexIndex(k))),
            MeshVertexNumbering(positions.Count, [positions.Count], [positions.Count]));
    }

    // A triangle of three vertex numbers.
    Tri(a: Integer, b: Integer, c: Integer): TriangleFace
        => TriangleFace(VertexIndex(a), VertexIndex(b), VertexIndex(c));

    // n distinct points, the i-th at (i, i * i, 0).
    IncidenceTestPoints(n: Integer): Array<Point3D>
        => n.MapRange(i => Point3D(i.ToNumber, (i * i).ToNumber, 0.0));

    // A fan of k triangles about vertex 0, closed around: rim vertices 1 to k, triangle i joining
    // the centre to rim vertices i + 1 and (i + 1) mod k + 1. A disc: V = k + 1, T = k, so
    // 3T + V = 4k + 1. The centre's row holds every element.
    IncidenceTestFan(k: Integer): ModelMesh
        => IncidenceTestMesh(IncidenceTestPoints(k + 1), k.MapRange(i => Tri(0, i + 1, (i + 1) % k + 1)), []);

    // Two tetrahedra sharing vertex 0 and nothing else: one component, vertex 0 pinched.
    IncidenceTestPinched(_: ModelMesh): ModelMesh
        => IncidenceTestMesh(IncidenceTestPoints(7),
            [Tri(0, 2, 1), Tri(0, 1, 3), Tri(0, 3, 2), Tri(1, 2, 3),
             Tri(0, 5, 4), Tri(0, 4, 6), Tri(0, 6, 5), Tri(4, 5, 6)],
            []);

    // A tetrahedron on vertices 0 to 3 and a triangle pair on 4 to 7, their elements interleaved,
    // the pair's first element first; vertex 8 unreferenced. Two components, numbered by their
    // lowest element.
    IncidenceTestInterleaved(_: ModelMesh): ModelMesh
        => IncidenceTestMesh(IncidenceTestPoints(9),
            [Tri(4, 5, 6), Tri(0, 2, 1), Tri(0, 1, 3), Tri(6, 5, 7), Tri(0, 3, 2), Tri(1, 2, 3)],
            []);

    // A quad on vertices 0 to 3, a triangle that repeats vertex 3, and a triangle on 4 to 6
    // apart from both.
    IncidenceTestRepeated(_: ModelMesh): ModelMesh
        => IncidenceTestMesh(IncidenceTestPoints(7),
            [Tri(3, 3, 4), Tri(5, 6, 4)],
            [QuadFace(VertexIndex(0), VertexIndex(1), VertexIndex(2), VertexIndex(3))]);

    // The literal meshes, chosen by an Integer the runner exhausts: 0 the unit tetrahedron, 1 its
    // reversal, 2 a fan of 6, 3 the pinched pair, 4 the interleaved pair, 5 the repeated corner.
    IncidenceTestMeshAt(_: ModelMesh, k: Integer): ModelMesh
    {
        var i = ((k % 6) + 6) % 6;
        return i == 0 ? ModelMesh.Witness_UnitTetrahedron
            : (i == 1 ? ModelMesh.Witness_UnitTetrahedron.Reversed
            : (i == 2 ? IncidenceTestFan(6)
            : (i == 3 ? ModelMesh.IncidenceTestPinched
            : (i == 4 ? ModelMesh.IncidenceTestInterleaved
            : ModelMesh.IncidenceTestRepeated))));
    }

    //==
    // # Comparisons

    // The elements with a corner at v, by scanning every element: the reference row.
    ScannedRow(mesh: ModelMesh, v: Integer): Array<Integer>
        => mesh.ElementCount.Range.FlatMap(e =>
            mesh.ElementCornerList(ElementIndex(e)).Any(c => c.Value == v) ? [e] : mesh.ElementCount.Range.Take(0));

    // Whether two integer arrays hold the same entries in the same order.
    SameIntegers(a: Array<Integer>, b: Array<Integer>): Boolean
        => a.Count == b.Count ? a.Count.Range.All(i => a[i] == b[i]) : false;

    // Whether two component tables are equal field by field.
    SameComponents(a: MeshComponents, b: MeshComponents): Boolean
        => a.ComponentCount == b.ComponentCount
            && SameIntegers(a.ElementComponent.Map(x => x.Value), b.ElementComponent.Map(x => x.Value))
            && SameIntegers(a.VertexComponent.Map(x => x.Value), b.VertexComponent.Map(x => x.Value))
            && SameIntegers(a.ElementParent.Map(x => x.Value), b.ElementParent.Map(x => x.Value))
            && SameIntegers(a.ElementDepth, b.ElementDepth);

    // Whether row v of the incidence is the elements with a corner at v, in increasing order,
    // once each; true when v names no vertex.
    RowIsTheScan(mesh: ModelMesh, v: VertexIndex): Boolean
    {
        var inc = mesh.VertexElementIncidence;
        return mesh.Positions.IsValidIndex(v)
            ? SameIntegers(inc.IncidentCount(v.Value).MapRange(i => inc.IncidentElement(v.Value, i).Value), mesh.ScannedRow(v.Value))
            : true;
    }

    // Whether IsPinchedVertexIndexed equals IsPinchedVertex at v.
    PinchAgrees(mesh: ModelMesh, v: VertexIndex): Boolean
        => mesh.IsPinchedVertexIndexed(mesh.VertexElementIncidence, v) == mesh.IsPinchedVertex(v);

    //==
    // # Agreement

    // The incidence has one offset per vertex plus one, starting at 0, non-decreasing, ending at
    // its entry count.
    Law_IncidenceOffsetsAreARunningTotal(k: Integer): Boolean
    {
        var mesh = ModelMesh.IncidenceTestMeshAt(k);
        var inc = mesh.VertexElementIncidence;
        return inc.Offsets.Count == mesh.Positions.Count + 1
            ? (inc.Offsets[0] == 0 && inc.Offsets[mesh.Positions.Count] == inc.Elements.Count
                && mesh.Positions.Count.Range.All(v => inc.Offsets[v] <= inc.Offsets[v + 1]))
            : false;
    }

    // Each row of the incidence of a literal mesh is the scan.
    Law_IncidenceRowIsTheScan(k: Integer, v: Integer): Boolean
        => ModelMesh.IncidenceTestMeshAt(k).RowIsTheScan(VertexIndex(v));

    // The indexed pinch test of a literal mesh equals the reference at every v, in range or not.
    Law_IsPinchedVertexIndexedAgrees(k: Integer, v: Integer): Boolean
        => ModelMesh.IncidenceTestMeshAt(k).PinchAgrees(VertexIndex(v));

    // The pinched pair has its shared vertex pinched and no other, so the agreement above is not
    // vacuous.
    Law_PinchedPairIsPinchedAtItsSharedVertex(v: Integer): Boolean
    {
        var mesh = ModelMesh.IncidenceTestPinched;
        return mesh.Positions.IsValidIndex(v)
            ? mesh.IsPinchedVertexIndexed(mesh.VertexElementIncidence, VertexIndex(v)) == (v == 0)
            : true;
    }

    // The same agreements on every mesh the runner gives, generated ones included, whose
    // corners may name no position.
    Law_IncidenceRowIsTheScanOnAnyMesh(mesh: ModelMesh, v: VertexIndex): Boolean
        => mesh.RowIsTheScan(v);

    Law_IsPinchedVertexIndexedAgreesOnAnyMesh(mesh: ModelMesh, v: VertexIndex): Boolean
        => mesh.PinchAgrees(v);

    //==
    // # Count witness

    // The element visits of ComponentsOfCounted on the fan whose size 3T + V is n (n = 4k + 1).
    ComponentsOfWorkAt(n: Integer): WorkBudget
        => IncidenceTestFan((n - 1) / 4).ComponentsOfCounted.Work;

    // ComponentsOf visits at most 4 elements per unit of 3T + V (Insertions count element
    // visits: row entries written, row entries read, elements dequeued), on fans of 8 and 64
    // triangles. The reference reads the centre's row once per element, k^2 + 4k reads, which
    // exceeds the slope at 64.
    Witness_ComponentsOfWork(_: WorkClaim): WorkClaim
        => WorkClaim("ComponentsOf: element visits per unit of 3T + V", Insertions(4), [33, 257], n => ComponentsOfWorkAt(n));
}

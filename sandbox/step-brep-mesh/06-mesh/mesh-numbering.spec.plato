//==
// # Mesh vertex numbering: specification
//
// The status of the numbering's laws: which are invariants of MeshVertexNumbering, what its
// constructor promises, and the two theorems the numbering rests on. Invented constructs only
// (SPEC-DSL.md section 3); quantifiers in prenex position (SPEC-EXECUTION.md 3.6).
//
// Sections, in order:
//  - The numbering
//  - Theorems

//==
// # The numbering

// Every numbering cuts 0 to N - 1 into consecutive runs: model vertices, then one run per edge,
// then one run per face, none of negative length.
spec MeshVertexNumbering
{
    invariant self.ModelVertexCount >= 0;
    invariant self.EdgeInteriorStart.Count >= 1;
    invariant self.FaceInteriorStart.Count >= 1;
    invariant EdgeRunsFollowModelVertices(self);
    invariant FaceRunsFollowEdgeRuns(self);
    invariant forall (e: BrepEdgeIndex) : EdgeRunHasNonNegativeLength(self, e);
    invariant forall (f: BrepFaceIndex) : FaceRunHasNonNegativeLength(self, f);
    constructor NumberMeshVertices;
    constructor Witness_UnitTetrahedron;
}

// The numbering of a model's mesh vertices from its edge discretizations and its face meshes.
spec NumberMeshVertices(m: BrepModel, d: EdgeDiscretizations, faceMeshes: Array<FaceMesh>): MeshVertexNumbering
{
    requires faceMeshes.Count == m.Faces.Count;
    requires forall (k: Integer) in faceMeshes.Count.Range : faceMeshes[k].Face.Value == k;
    ensures NumberingHasOneEdgeRunPerEdge(m, result);
    ensures NumberingHasOneFaceRunPerFace(m, result);
    ensures NumberingCountsEveryModelVertex(m, result);
    ensures EdgeRunsFollowModelVertices(result);
    ensures FaceRunsFollowEdgeRuns(result);
    ensures forall (e: BrepEdgeIndex) : EdgeRunHasNonNegativeLength(result, e);
    ensures forall (f: BrepFaceIndex) : FaceRunHasNonNegativeLength(result, f);
    ensures forall (e: BrepEdgeIndex) : Law_NumberingCountsCitedEdgeInteriors(m, d, faceMeshes, e);
    ensures forall (k: Integer) in m.Edges.Count.Range :
        faceMeshes.CitesEdge(BrepEdgeIndex(k)) ? true : result.EdgeInteriorCount(BrepEdgeIndex(k)) == 0;
    ensures forall (k: Integer) in m.Faces.Count.Range :
        result.FaceInteriorCount(BrepFaceIndex(k)) == faceMeshes[k].FaceInteriorVertexCount;
    measure m.Vertices.Count + m.Edges.Count + m.Faces.Count
        + faceMeshes.Map(fm => fm.Sources.Count + fm.Provenance.Count).IntegerTotal;
}

//==
// # Theorems

// The structural invariants make IndexOfSite one-to-one on the numbered sites: SiteAt undoes it.
theorem NumberedSitesHaveDistinctIndices
{
    given n: MeshVertexNumbering, s: MeshVertexSite;
    assume EdgeRunsFollowModelVertices(n);
    assume FaceRunsFollowEdgeRuns(n);
    assume forall (e: BrepEdgeIndex) : EdgeRunHasNonNegativeLength(n, e);
    assume forall (f: BrepFaceIndex) : FaceRunHasNonNegativeLength(n, f);
    conclude Law_SiteAtInvertsIndexOfSite(n, s);
    because "The runs are consecutive (each kind starts where the previous ends) and non-decreasing,
             so they cut 0 to N - 1 into disjoint intervals, one per model vertex, edge, and face.
             IndexOfSite sends the slot-th sample of a cell to start + slot, inside that cell's
             interval because the slot is below the run length. SiteAt finds the interval holding an
             index: below ModelVertexCount it is a model vertex; otherwise RunContaining returns the
             largest run whose start is at most the index, and that run's end, the next start, is
             above the index (else a later run would qualify), so the run holds it and the slot is
             the offset. Face runs are searched first, and every face start is at least every edge
             start, so an index in a face run is never read as an edge point.";
    tested by Law_SiteAtInvertsIndexOfSite;
}

// The same invariants make IndexOfSite onto 0 to N - 1: every index is the index of its site.
theorem EveryIndexHasASite
{
    given n: MeshVertexNumbering, i: VertexIndex;
    assume EdgeRunsFollowModelVertices(n);
    assume FaceRunsFollowEdgeRuns(n);
    assume forall (e: BrepEdgeIndex) : EdgeRunHasNonNegativeLength(n, e);
    assume forall (f: BrepFaceIndex) : FaceRunHasNonNegativeLength(n, f);
    conclude Law_IndexOfSiteInvertsSiteAt(n, i);
    because "As in NumberedSitesHaveDistinctIndices, the intervals cover 0 to N - 1, so SiteAt finds
             the interval of every index in range and returns a site whose slot is the offset in
             it; IndexOfSite adds the interval's start back.";
    tested by Law_IndexOfSiteInvertsSiteAt;
}

// Points that cite the same model boundary sample reach one global vertex: the mechanism of
// watertightness, before any element is assembled.
theorem SharedSamplesShareAnIndex
{
    given n: MeshVertexNumbering, fa: FaceMesh, fb: FaceMesh, i: VertexIndex, j: VertexIndex;
    assume fa.Sources.IsValidIndex(i);
    assume fb.Sources.IsValidIndex(j);
    assume IsSameBoundarySample(fa.Sources[i], fb.Sources[j]);
    conclude n.GlobalVertexOf(fa, i) == n.GlobalVertexOf(fb, j);
    because "IsSameBoundarySample holds only when both sources are FromVertex(v) for one v or both
             are FromEdge(e, k) for one e and k. SiteOfUvPoint reads such a source alone, giving
             ModelVertex(v) or EdgeInterior(e, k - 1) whichever face mesh holds the point, so the two
             sites are equal. GlobalVertexOf is IndexOfSite of the site, a function of the site and
             the numbering only, so the two indices are equal. No position, parameter, or tolerance
             enters.";
    tested by SharedBoundarySampleHasOneGlobalVertex;
}

// TKT-475's law (SecondDerivative of a pcurve, 01-geometry/geometry-curves.library.plato), over the NINA-B222 corpus witness, whose four surface-curve edges
// are mastered by pcurves on its cylinder and planes.
library V1ReliabilitySecondDerivativeLaws
{
    // Three parameters of pcurve p: a quarter, a half and three quarters of its 2D curve's range when it is finite,
    // 0, 0.5 and 1 otherwise.
    PcurveSamples(g: GeometrySet, p: PcurveIndex): Array<Number>
        => 3.Range.Map(i => g.Domain(p).PcurveSampleAt(i));

    // Sample i of 3 within the range when its width is below 1e6 (a 2D line's unbounded domain is a range of
    // huge finite bounds, where interpolation overflows); 0, 0.5 and 1 otherwise.
    PcurveSampleAt(d: CurveDomain, i: Integer): Number
    {
        var width = d.Range.End - d.Range.Start;
        var narrow = width.IsFinite ? width < 1000000.0 : false;
        return narrow ? d.Range.Start + width * (i.ToNumber + 1.0) * 0.25 : i.ToNumber * 0.5;
    }

    // At t, SecondDerivative agrees with a central difference of the pcurve's first derivative, to within 1e-4 of the
    // second derivative's size plus one (the difference's truncation and rounding at h = 1e-4).
    MatchesCentralDifference(g: GeometrySet, p: PcurveIndex, t: Number): Boolean
    {
        var h = 1e-4;
        var difference = (g.Derivative(p, t + h) - g.Derivative(p, t - h)) * (0.5 / h);
        var body = g.SecondDerivative(p, t);
        return (body - difference).Length <= 1e-4 * (1.0 + body.Length);
    }

    // SecondDerivative's error against the central difference at t, relative to the second derivative's size plus one.
    RelativeError(g: GeometrySet, p: PcurveIndex, t: Number): Number
    {
        var h = 1e-4;
        var difference = (g.Derivative(p, t + h) - g.Derivative(p, t - h)) * (0.5 / h);
        var body = g.SecondDerivative(p, t);
        return (body - difference).Length / (1.0 + body.Length);
    }

    // The worst RelativeError over the witness's pcurves and samples.
    Measure_V1Reliability_PcurveSecondDerivativeMatchesDifference(_: Integer): Number
    {
        var g = BrepModel.Witness_NinaB222W1x2Face678.Geometry;
        return g.Pcurves.Count.Range.Reduce(0.0, (worst, k) => g.PcurveSamples(PcurveIndex(k)).Reduce(worst, (w, t) =>
            g.RelativeError(PcurveIndex(k), t).IsFinite ? (g.RelativeError(PcurveIndex(k), t) > w ? g.RelativeError(PcurveIndex(k), t) : w) : 1000.0 + k.ToNumber + t));
    }

    // Every pcurve of the NINA-B222 witness has a second derivative, and it is the derivative's derivative. On the
    // library before TKT-475, SecondDerivative(g, p, t) threw here.
    Law_V1Reliability_PcurveSecondDerivativeMatchesDifference(_: Integer): Boolean
    {
        var g = BrepModel.Witness_NinaB222W1x2Face678.Geometry;
        return g.Pcurves.Count > 0
            && g.Pcurves.Count.Range.All(k => g.PcurveSamples(PcurveIndex(k)).All(t => g.MatchesCentralDifference(PcurveIndex(k), t)));
    }
}

//==
// # Version 1 gate: a quad's split measured as a whole (TKT-455)
//
// The gate's chordal claim on a quad (QuadSplitsWithin, 08-pipeline/pipeline-v1-gate) measured
// each triangle of a split against the surface over that triangle's own parameter triangle. On a
// long element over a non-uniformly parametrized surface, a parameter sample of one triangle lands
// in 3D beside it, on the other triangle of the split (moon_buggy_asm.stp's B-spline faces 41 and
// 117: 3.8 times the bound per triangle, within 0.96 of it as a split), so the claim failed meshes
// that meet the contract. QuadSplitsWithinV1 is the one chordal measure (ElementWithinChordal,
// v1-chordal.library.plato), which the grid keep rule also uses: each triangle to the surface by
// projection, and the surface over each split to the split as a whole. Both splits must pass. The
// harness's contract check measures the same way since bim-open-data 66f0da1.
//
// Sections, in order:
//  - Splits
//  - Witnesses

library V1GateSplits
{
    //==
    // # Splits

    // QuadSplitsWithin with each split measured as a whole: quad q of face mesh fm within `bound`
    // under the one chordal measure (ElementWithinChordal), its sampled sides the surface edges
    // (IsSurfaceEdge). A quad with a point not lifted is not measured.
    QuadSplitsWithinV1(m: BrepModel, d: EdgeDiscretizations, fm: FaceMesh, q: Integer, bound: Number): Boolean
        => fm.CornersLifted(fm.Quads[q].Vertices)
            ? m.ElementWithinChordal(fm.Face, v => fm.UvPoints[v], v => fm.PositionOf(v),
                ElementShape.QuadShape(fm.Quads[q]), (a, b) => m.IsSurfaceEdge(d, fm, a, b), bound)
            : true;

    // The per-triangle claim this chunk replaces, QuadSplitsWithin's body before it: each triangle of
    // both splits within `bound` against the surface over its own parameter triangle. Kept for the
    // law that shows where the two differ.
    QuadSplitsWithinPerTriangle(m: BrepModel, d: EdgeDiscretizations, fm: FaceMesh, q: Integer, bound: Number): Boolean
        => fm.CornersLifted(fm.Quads[q].Vertices)
            ? fm.QuadSplitTriangles(q).All(cs => m.CornerTriangleWithin(d, fm, cs, bound))
            : true;

    //==
    // # Witnesses

    // The unit box with a flat top on a biquadratic Bezier patch whose middle control column sits
    // at x = skew instead of 1/2 (Witness_BSplinePatchSolid with bump 0 and that one change): the
    // top is the unit square at height 1, exactly, but x runs unevenly with u, so the parameter
    // midpoint of the top quad's diagonal, (1/2, 1/2), lies at (skew / 2 + 1/4, 1/2, 1), off the
    // diagonal in 3D. Precondition: 0 < skew < 1.
    Witness_SkewedPatchSolid(_: BrepModel, skew: Number): BrepModel
        => BrepModel(
            GeometrySet(
                BoxCurves(BoxCorners(Point3D(0.0, 0.0, 0.0), 1.0, 1.0, 1.0)),
                [],
                [],
                BoxPlanes(Point3D(0.0, 0.0, 0.0), 1.0, 1.0, 1.0).Take(1)
                    .Concatenate([BrepSurface.BSpline(BSplineSurfaceData(
                        SplineBasis(2, KnotVector([0.0, 0.0, 0.0, 1.0, 1.0, 1.0])),
                        SplineBasis(2, KnotVector([0.0, 0.0, 0.0, 1.0, 1.0, 1.0])),
                        MakeArray2D(3, 3, (i, j) => Point3D(i == 1 ? skew : i.ToNumber * 0.5, j.ToNumber * 0.5, 1.0)),
                        MakeArray2D(3, 3, (i, j) => 1.0)))])
                    .Concatenate(BoxPlanes(Point3D(0.0, 0.0, 0.0), 1.0, 1.0, 1.0).Skip(2)), []),
            BoxCorners(Point3D(0.0, 0.0, 0.0), 1.0, 1.0, 1.0).Map(p => BrepVertex(p)),
            BoxEdges(8.Range, 0),
            6.MapRange(k => BoxLoop(12.Range, k)),
            6.MapRange(k => SingleLoopFace(k, k, true)),
            [ClosedShellOf(6.Range)],
            [BrepBody.ManifoldSolid(ShellIndex(0))],
            Tolerances.Witness_Tolerances,
            LengthUnit.Metre);

    // Face f of model m's region as one quad on its four boundary points: the grid a face would get
    // if every grid were kept. Precondition: f's region has four boundary points.
    ForcedQuadGrid(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): UvTriangulation
    {
        var r = m.RegionOf(f, d, c);
        return UvTriangulation(r.BoundaryPoints, r.BoundarySources, [TriangleFace(VertexIndex(0), VertexIndex(0), VertexIndex(0))].Take(0),
            [QuadFace(VertexIndex(0), VertexIndex(1), VertexIndex(2), VertexIndex(3))]);
    }

    // ForcedQuadGrid lifted: face f as one quad, with no keep rule.
    ForcedQuadMesh(m: BrepModel, f: BrepFaceIndex, c: FaceMeshingCriteria): FaceMesh
    {
        var d = m.DiscretizeAll(c.Discretization, SegmentFloors.NoFloors);
        return m.Lift(f, d, m.ForcedQuadGrid(f, d, c));
    }
}

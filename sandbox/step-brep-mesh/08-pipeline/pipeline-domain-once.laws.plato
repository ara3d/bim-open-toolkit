//==
// # The surface domain and the region tolerance once per face: laws (complexity sweep chunk I5, TKT-382)
//
// The "In" forms give the library's values, bit for bit, on every face of every model witness
// that can be regioned under the witness options: the unwrapped loops, the unoriented region,
// the region tolerance, the point tolerance and the collapsed-line tests at every boundary
// point; MeshRegionOnce gives MeshRegion's outcome where the region is not simple (a simple
// region reaches MeshedOutcomeIn, MeshedOutcome with an argument it does not yet read, so it is
// not meshed twice here). Unwrapping a face's loops builds its surface domain once, however many
// loops and points it has (exact law), and the count witness reads the same count.
// Laws over model witnesses: at merge this file goes to 08-pipeline (TRACK.md).
//
// Sections, in order:
//  - The domain once per face

library FaceMeshingDomainOnceLaws
{
    //==
    // # The domain once per face

    // n loops of the plane polygon of p points (UnwrapIndexedLaws.PlanePolygon).
    PlanePolygons(n: Integer, p: Integer): Array<UvLoop>
        => n.MapRange(k => PlanePolygon(p));

    // The surface domains built while unwrapping n polygons of p points on the unit box's
    // bottom face.
    UnwrapDomainBuilds(n: Integer, p: Integer): Integer
        => BrepModel.Witness_UnitBox.UnwrapLoopsCounted(BrepFaceIndex(0), PlanePolygons(n, p)).Work.Projections;

    // Unwrapping a face's loops builds its surface domain exactly once, for one or three loops
    // of 8 or 64 points: never once per point, as IsOnLine and PointTolerance did.
    Law_UnwrapBuildsTheDomainOncePerFace(_: Boolean): Boolean
        => UnwrapDomainBuilds(1, 8) == 1 && UnwrapDomainBuilds(3, 8) == 1
            && UnwrapDomainBuilds(1, 64) == 1 && UnwrapDomainBuilds(3, 64) == 1;

    // The work of unwrapping one plane polygon of n points with UnwrapLoopsCounted.
    UnwrapLoopsWork(n: Integer): WorkBudget
        => BrepModel.Witness_UnitBox.UnwrapLoopsCounted(BrepFaceIndex(0), PlanePolygons(1, n)).Work;

    // UnwrapLoopsCounted builds one surface domain per face (Projections) and visits one step per
    // point on a plane (Insertions), at 8 and 64 points; the library's unwrap built a domain per
    // collapsed-line test of every point.
    Witness_UnwrapLoopsWork(_: WorkClaim): WorkClaim
        => WorkClaim("UnwrapLoopsCounted: surface domains built per face, steps visited per point", Projections(1).Add(Insertions(1)), [8, 64], n => UnwrapLoopsWork(n));
}

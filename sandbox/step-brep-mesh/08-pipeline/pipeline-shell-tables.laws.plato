//==
// # Shell tables: laws (complexity sweep, chunk V4)
//
// The count witness for EdgeUseTableCounted, and the laws that every tabled reader returns what
// its layer 2 reference returns: rows of the edge-use table are CoedgeSitesOfEdge, rows of the
// corner table are CornersAtVertex, and the shell measures over the tables are their namesakes,
// exactly. Layer 8: the laws use layer 7's witnesses and layer 8's TablesStrayBox and
// TablesDigonBox (chunk E1).
//
// Sections, in order:
//  - Witness
//  - Agreement

library ShellTablesLaws
{
    //==
    // # Witness

    // The model of size n, the coedge count of its shell 0: the unit box (24) up to 24, the
    // 3 x 3 x 1 block with a square through hole (48) above.
    ShellTablesModelOfSize(_: BrepModel, n: Integer): BrepModel
        => n <= 24 ? BrepModel.Witness_UnitBox : BrepModel.Witness_BlockWithThroughHole;

    // The work EdgeUseTableCounted counts on shell 0 of the model of size n.
    EdgeUseTableWork(n: Integer): WorkBudget
        => BrepModel.ShellTablesModelOfSize(n).EdgeUseTableCounted(ShellIndex(0)).Work;

    // EdgeUseTable visits each coedge of the shell (Insertions) at most three times: once to read
    // its edge, twice in the counting sort. The reference UseCount rebuilds the shell's sites per
    // edge, E C visits for EdgesOfShell: 12 x 24 = 288 on the box, above 3 x 24.
    Witness_EdgeUseTableWork(_: WorkClaim): WorkClaim
        => WorkClaim("EdgeUseTable: coedge visits per coedge of the shell", Insertions(3), [24, 48], n => EdgeUseTableWork(n));

    // The witness's sizes are the coedge counts of its models' shell 0.
    Law_ShellTablesWitnessSizes(_: Integer): Boolean
        => [24, 48].All(n => BrepModel.ShellTablesModelOfSize(n).CoedgeSitesOfShell(ShellIndex(0)).Count == n);

    //==
    // # Agreement

    // The same sites in the same order.
    SameSites(a: Array<CoedgeSite>, b: Array<CoedgeSite>): Boolean
        => a.Count == b.Count ? a.Count.Range.All(k => a[k] == b[k]) : false;

    // The same edges in the same order.
    SameEdges(a: Array<BrepEdgeIndex>, b: Array<BrepEdgeIndex>): Boolean
        => a.Count == b.Count ? a.Count.Range.All(k => a[k] == b[k]) : false;

    // The same vertices in the same order.
    SameVertices(a: Array<BrepVertexIndex>, b: Array<BrepVertexIndex>): Boolean
        => a.Count == b.Count ? a.Count.Range.All(k => a[k] == b[k]) : false;

    // On shell s of m: one row per edge and per vertex; every row and every reader is its layer 2
    // reference; the shell measures over the tables are their namesakes, those that read the
    // geometry or index the vertices by an edge's ends only when every index is in range.
    ShellTablesAgreeOn(m: BrepModel, s: ShellIndex): Boolean
    {
        var t = m.EdgeUseTable(s);
        var c = m.CornersByVertex(s);
        var rows = t.Uses.Offsets.Count == m.Edges.Count + 1
            && c.Corners.Offsets.Count == m.Vertices.Count + 1;
        var uses = m.Edges.Count.Range.All(i =>
            t.UseCountIn(BrepEdgeIndex(i)) == m.UseCount(s, BrepEdgeIndex(i))
            && SameSites(t.UsesOfEdgeIn(BrepEdgeIndex(i)), m.CoedgeSitesOfEdge(s, BrepEdgeIndex(i))));
        var corners = m.Vertices.Count.Range.All(v =>
            SameSites(c.CornersAtVertexIn(BrepVertexIndex(v)), m.CornersAtVertex(s, BrepVertexIndex(v))));
        return rows && uses && corners;
    }

    // The tables agree with their references on every shell of every witness model. Exact.
    Law_ShellTablesAgree(m: BrepModel): Boolean
        => m.Shells.Count.Range.All(s => m.ShellTablesAgreeOn(ShellIndex(s)));

    // The tables agree on E1's digon box and stray box, and the cases they skip or merge occur:
    // the stray box's edge 4, cited twice by face 1 and once by its neighbour, has three uses, an
    // edge out of range has no uses.
    Law_ShellTablesAgreeOnOddModels(_: Integer): Boolean
    {
        var digon = BrepModel.TablesDigonBox;
        var stray = BrepModel.TablesStrayBox;
        var t = stray.EdgeUseTable(ShellIndex(0));
        return digon.ShellTablesAgreeOn(ShellIndex(0)) && stray.ShellTablesAgreeOn(ShellIndex(0))
            && t.UseCountIn(BrepEdgeIndex(4)) == 3
            && t.UseCountIn(BrepEdgeIndex(99)) == 0
            && t.UsesOfEdgeIn(BrepEdgeIndex(99)).Count == 0;
    }

    // A vertex loop marks its vertex: on the sphere, whose poles are vertex loops, the vertices
    // by mark are the reference's and include both poles.
    Law_VertexLoopsAreMarked(_: Integer): Boolean
    {
        var m = BrepModel.Witness_Sphere;
        var s = ShellIndex(0);
        var vs = m.VerticesOfShellByMark(s, m.EdgeUseTable(s));
        return SameVertices(vs, m.VerticesOfShell(s))
            && vs.Any(v => v.Value == 0) && vs.Any(v => v.Value == 1);
    }
}

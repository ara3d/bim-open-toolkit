//==
// # Pipeline: trace and incremental-round laws
//
// The laws of pipeline-trace.library.plato (moved from catalog-validation at
// the catalog merge, validation, 2026-10-20). The runner cannot build arrays
// or sums, so the laws take Integer selectors and build the trace or the
// changed edges inside; the incremental laws run on Witness_UnitBox.
//
// Sections, in order:
//  - Helpers
//  - Traces
//  - Incremental rounds

library StepToMeshTraceLaws
{
    //==
    // # Helpers

    // A well-ordered trace, one of three by k: a single round, two rounds
    // with discretization events between, and an empty trace.
    CatalogTraceAt(k: Integer): Trace
    {
        var i = (k % 3 + 3) % 3;
        var e = BrepEdgeIndex(0);
        var f = BrepFaceIndex(0);
        var r0 = Round.First;
        var r1 = r0.NextRound;
        return i == 0
            ? Trace([MeshingEvent.EdgeDiscretized(e, SegmentCountOf(4)),
                     MeshingEvent.FaceMeshed(f, CountOf(2), CountOf(0), r0),
                     MeshingEvent.RoundEnded(r0, CountOf(0)),
                     MeshingEvent.Assembled(CountOf(8))])
            : (i == 1
                ? Trace([MeshingEvent.FaceMeshed(f, CountOf(2), CountOf(0), r0),
                         MeshingEvent.RoundEnded(r0, CountOf(1)),
                         MeshingEvent.EdgeRefined(e, SegmentCountOf(4), SegmentCountOf(8), RefinementReason.TooCoarseInParameterSpace),
                         MeshingEvent.FaceMeshed(f, CountOf(4), CountOf(0), r1),
                         MeshingEvent.RoundEnded(r1, CountOf(0)),
                         MeshingEvent.Validated(ConformanceLevel.Geometric, true)])
                : Trace([MeshingEvent.Assembled(CountOf(0))].Take(0)));
    }

    // The edges a round changes: two of model m's, chosen by two selectors.
    CatalogChangedEdges(m: BrepModel, a: Integer, b: Integer): Array<BrepEdgeIndex>
    {
        var n = m.Edges.Count.Max(1);
        return [BrepEdgeIndex((a % n + n) % n), BrepEdgeIndex((b % n + n) % n)];
    }

    //==
    // # Traces

    // The rounds of every well-ordered trace never decrease.
    Law_TraceRoundsAreMonotone(k: Integer): Boolean
        => CatalogTraceAt(k).RoundsAreMonotone;

    // A trace whose rounds go back is not monotone: the predicate bites.
    Law_TraceWithEarlierRoundIsNotMonotone(k: Integer): Boolean
        => !CatalogTraceAt(1).Recorded(MeshingEvent.RoundEnded(Round.First, CountOf(0))).RoundsAreMonotone;

    //==
    // # Incremental rounds

    // No face a round reused cites an edge the round changed.
    Law_ReusedFacesTouchNoChangedEdge(a: Integer, b: Integer): Boolean
    {
        var m = BrepModel.Witness_UnitBox;
        var changed = CatalogChangedEdges(m, a, b);
        return m.ReusedTouchNoChangedEdge(m.IncrementalOf(changed), changed);
    }

    // A round reuses or redoes every face, each once.
    Law_IncrementalCoversEveryFace(a: Integer, b: Integer): Boolean
    {
        var m = BrepModel.Witness_UnitBox;
        var inc = m.IncrementalOf(CatalogChangedEdges(m, a, b));
        return inc.Reused.Count + inc.Redone.Count == m.Faces.Count;
    }
}

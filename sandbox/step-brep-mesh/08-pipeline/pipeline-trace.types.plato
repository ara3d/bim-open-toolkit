//==
// # Pipeline: events, traces, runs and rounds
//
// TYPE-CATALOG.md section 11, layer 8: the run is a list of events, a run
// names what makes it reproducible, and a round names what it reuses (moved
// from catalog-validation at the catalog merge, validation, 2026-10-20). The
// section's StageOutcome<T> names layer 9's RunStage, so it is in
// 09-tooling/tooling-reports.types.plato until layer 8 has its own Stage
// (FINDINGS F-58).
//
// Sections, in order:
//  - Events and traces
//  - Runs and rounds

//==
// # Events and traces

// One thing that happened in a meshing run. Removes: probes reconstructed
// from printouts.
type MeshingEvent
    = EdgeDiscretized(Edge: BrepEdgeIndex, Segments: SegmentCount)
    | EdgeRefined(Edge: BrepEdgeIndex, From: SegmentCount, To: SegmentCount, Why: RefinementReason)
    | FaceMeshed(Face: BrepFaceIndex, Triangles: Count, Quads: Count, Round: Round)
    | FaceBlocked(Face: BrepFaceIndex, Requests: RequestSet)
    | RoundEnded(Round: Round, Pending: Count)
    | Assembled(Vertices: Count)
    | Validated(Level: ConformanceLevel, Clean: Boolean);

// A run as data: its events in the order they happened. Invariant: the
// rounds the events name never decrease (RoundsAreMonotone).
type Trace
{
    Events: Array<MeshingEvent>;
}

//==
// # Runs and rounds

// What makes a run reproducible, written into every report and corpus row.
// Removes: a corpus report whose library state nobody can name.
type RunKey
{
    ModelHash: String;
    Options: MeshingOptions;
    LibraryCommit: String;
    Profile: String;
}

// What the next round must redo: the merged requests and the faces they
// touch, derived from the round's changed edges, not from "all faces".
type Pending
{
    Requests: RequestSet;
    Faces: Array<BrepFaceIndex>;
}

// What a round reused and what it redid. Built by IncrementalOf from the
// changed edges. Invariant: no reused face cites a changed edge
// (Law_ReusedFacesTouchNoChangedEdge).
type Incremental
{
    Reused: Array<BrepFaceIndex>;
    Redone: Array<BrepFaceIndex>;
}

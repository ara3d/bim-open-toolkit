//==
// # Layer 8's edge findings without the per-edge model check (complexity sweep, chunk G1)
//
// EdgeDiagnostics asked CanDiscretize, and so Law_IndicesInRange, once per edge. Here the
// model is checked once and the answer passed down to the per-edge guard.
//
// Sections, in order:
//  - Edges

library PipelineEdgeGuards
{
    //==
    // # Edges

    // EdgeDiagnostics with Law_IndicesInRange asked once for the model: an error for every edge
    // that cannot be discretized under the options, in edge order. A model with an index out of
    // range gets one per edge, as before.
    EdgeDiagnosticsInRange(m: BrepModel, o: MeshingOptions): Array<Diagnostic>
    {
        var inRange = m.Law_IndicesInRange;
        return m.Edges.Count.Range.FlatMap(i =>
            (inRange ? m.CanDiscretizeInRange(BrepEdgeIndex(i), o.Face.Discretization) : false)
                ? Diagnostic.NoDiagnostics
                : [m.UndiscretizedEdge(BrepEdgeIndex(i))]);
    }
}

//==
// # Faceted shells: laws (complexity sweep, chunk V9, TKT-377)
//
// The replacements of faceted.library.plato return what their references return, exactly, on
// faceted models built here (quad sheets and cubes on poly loops, their points jittered within
// the tolerance, moved far from the origin, or with planted edge-use defects), on layer 7's
// Witness_BoxWithPolyLoopSheet and V8's PolyTrianglesBesideBox, on the ten positive witnesses,
// and on generated point arrays with planted coincident chains. One count witness shows the grid
// linear in the poly-point count. Layer 8: the laws use layer 7's witnesses and
// ShellOrientationLaws' PolyTrianglesBesideBox.
//
// Sections, in order:
//  - Faceted models
//  - Agreement
//  - Count witness

library FacetedLaws
{
    //==
    // # Faceted models

    // The point (x + dx, y, 0) moved by origin along each axis.
    SheetPoint(x: Integer, y: Integer, dx: Number, origin: Number): Point3D
        => Point3D(x.ToNumber + dx + origin, y.ToNumber + origin, origin);

    // The poly loop of the unit square with lower corner (c, r) in the plane z = origin,
    // counter-clockwise about +z, every point moved by dx along x.
    SheetQuad(c: Integer, r: Integer, dx: Number, origin: Number): BrepLoop
        => BrepLoop.PolyLoop([SheetPoint(c, r, dx, origin), SheetPoint(c + 1, r, dx, origin),
            SheetPoint(c + 1, r + 1, dx, origin), SheetPoint(c, r + 1, dx, origin)]);

    // A model of one shell, declared closed or open, whose faces are the given poly loops in
    // order, all on surface 0 (the topology laws read no surface), every face outward except
    // face flipped (none when flipped is -1); its body is a shell set.
    FacetedModel(_: BrepModel, loops: Array<BrepLoop>, closed: Boolean, flipped: Integer): BrepModel
        => BrepModel(
            GeometrySet([], [], [], [BrepSurface.Plane(WorldFrameAt(Point3D(0.0, 0.0, 0.0)))], []),
            [], [], loops,
            loops.Count.MapRange(k => SingleLoopFace(0, k, k != flipped)),
            [BrepShell(loops.Count.MapRange(k => BrepFaceIndex(k)), closed)],
            [BrepBody.ShellSet([ShellIndex(0)])],
            Tolerances.Witness_Tolerances,
            LengthUnit.Metre);

    // The loops of a cols x rows sheet of unit quads, quad k at column k mod cols and row
    // k / cols. Each quad's points move by jitter times -1, 0 or 1 along x, by (c + 2 r) mod 3,
    // so the four copies of an inner grid point carry all three offsets: copies differ by up to
    // 2 jitter.
    SheetLoops(_: BrepModel, cols: Integer, rows: Integer, jitter: Number, origin: Number): Array<BrepLoop>
        => (cols * rows).MapRange(k => SheetQuad(k % cols, k / cols,
            jitter * ((k % cols + 2 * (k / cols)) % 3 - 1).ToNumber, origin));

    // The cols x rows sheet as one shell: 4 cols rows poly-loop points, (cols + 1)(rows + 1)
    // grid points; open, it has one boundary cycle and chi + B = 2.
    FacetedSheet(_: BrepModel, cols: Integer, rows: Integer, jitter: Number, origin: Number, closed: Boolean): BrepModel
        => BrepModel.FacetedModel(BrepModel.SheetLoops(cols, rows, jitter, origin), closed, -1);

    // The unit cube as six outward quads on poly loops, face f's points moved by jitter times
    // -1, 0 or 1 along x by f mod 3: a closed shell, chi = 2.
    FacetedCube(_: BrepModel, jitter: Number): BrepModel
    {
        var faces = [
            [Point3D(0.0, 0.0, 0.0), Point3D(0.0, 1.0, 0.0), Point3D(1.0, 1.0, 0.0), Point3D(1.0, 0.0, 0.0)],
            [Point3D(0.0, 0.0, 1.0), Point3D(1.0, 0.0, 1.0), Point3D(1.0, 1.0, 1.0), Point3D(0.0, 1.0, 1.0)],
            [Point3D(0.0, 0.0, 0.0), Point3D(1.0, 0.0, 0.0), Point3D(1.0, 0.0, 1.0), Point3D(0.0, 0.0, 1.0)],
            [Point3D(0.0, 1.0, 0.0), Point3D(0.0, 1.0, 1.0), Point3D(1.0, 1.0, 1.0), Point3D(1.0, 1.0, 0.0)],
            [Point3D(0.0, 0.0, 0.0), Point3D(0.0, 0.0, 1.0), Point3D(0.0, 1.0, 1.0), Point3D(0.0, 1.0, 0.0)],
            [Point3D(1.0, 0.0, 0.0), Point3D(1.0, 1.0, 0.0), Point3D(1.0, 1.0, 1.0), Point3D(1.0, 0.0, 1.0)]];
        var loops = 6.MapRange(f => BrepLoop.PolyLoop(faces[f].Map(p =>
            p + Vector3D(jitter * (f % 3 - 1).ToNumber, 0.0, 0.0))));
        return BrepModel.FacetedModel(loops, true, -1);
    }

    // The witness tolerance, 1e-6.
    FacetedTolerance(_: Number): Number
        => Tolerances.Witness_Tolerances.Length.Value;

    // The number of faceted cases FacetedCase cycles through.
    FacetedCaseCount(_: Integer): Integer
        => 12;

    // Faceted case k modulo FacetedCaseCount: 0 Witness_BoxWithPolyLoopSheet; 1
    // PolyTrianglesBesideBox; 2 a 3 x 2 sheet; 3 the sheet jittered by 0.45 tol; 4 jittered by
    // 0.5 tol, copies exactly tol apart; 5 moved to 1e9, beyond the grid's exact cells (the
    // pairwise fallback); 6 the cube; 7 the cube jittered by 0.45 tol; 8 the sheet declared
    // closed (its boundary edges are defects); 9 the sheet with quad 0 repeated (its edges used
    // twice the same way or three times); 10 the sheet with face 0 flipped (its inner edges
    // used twice the same way); 11 the cube with face 2 flipped.
    FacetedCase(_: BrepModel, k: Integer): BrepModel
    {
        var i = ((k % 12) + 12) % 12;
        var tol = 0.0.FacetedTolerance;
        var sheet = BrepModel.SheetLoops(3, 2, 0.0, 0.0);
        var cube = BrepModel.FacetedCube(0.0);
        return i == 0 ? BrepModel.Witness_BoxWithPolyLoopSheet
            : (i == 1 ? BrepModel.PolyTrianglesBesideBox
            : (i == 2 ? BrepModel.FacetedSheet(3, 2, 0.0, 0.0, false)
            : (i == 3 ? BrepModel.FacetedSheet(3, 2, 0.45 * tol, 0.0, false)
            : (i == 4 ? BrepModel.FacetedSheet(3, 2, 0.5 * tol, 0.0, false)
            : (i == 5 ? BrepModel.FacetedSheet(3, 2, 0.0, 1.0e9, false)
            : (i == 6 ? cube
            : (i == 7 ? BrepModel.FacetedCube(0.45 * tol)
            : (i == 8 ? BrepModel.FacetedSheet(3, 2, 0.0, 0.0, true)
            : (i == 9 ? BrepModel.FacetedModel(sheet.Concatenate([sheet[0]]), false, -1)
            : (i == 10 ? BrepModel.FacetedModel(sheet, false, 0)
            : BrepModel.FacetedModel(cube.Loops, true, 2)))))))))));
    }

    //==
    // # Agreement

    // The same integers in the same order.
    SameIntegers(a: Array<Integer>, b: Array<Integer>): Boolean
        => a.Count == b.Count ? a.Count.Range.All(k => a[k] == b[k]) : false;

    // On shell s of m, every replacement returns its reference's value: the roots, the offsets,
    // the uses (in order, and sorted), the free keys (sorted), the edge count, the boundary
    // cycles, the defects, the reduced counts, the value Law_OpenShellEulerEvenAndBounded tests,
    // and the component count. Precondition: m.IsEveryIndexInRange.
    FacetedAgreesOnShell(m: BrepModel, s: ShellIndex): Boolean
    {
        var poly = m.ShellPolyBounds(s);
        var roots = m.CoincidenceRootsPairwise(m.ShellPolyPoints(s));
        var uses = m.ImplicitEdgeUses(poly, roots);
        var p = m.ShellPolyEdgesOf(s);
        var t = m.EdgeUseTable(s);
        return SameIntegers(p.PointRoots, roots)
            && SameIntegers(m.PolyPointOffsets(poly), (poly.Count + 1).MapRange(k => m.PolyPointOffset(poly, k)))
            && SameIntegers(m.ImplicitEdgeUsesByOffsets(poly, roots), uses)
            && SameIntegers(p.SortedUses, uses.Sort((a, b) => a <= b))
            && SameIntegers(p.ImplicitFreeEdgeKeysSorted, m.ImplicitFreeEdgeKeys(s).Sort((a, b) => a <= b))
            && p.ImplicitEdgeCountSorted == m.ImplicitEdgeKeys(poly, roots).DistinctCount
            && p.ImplicitBoundaryCycleCountSorted == m.ImplicitBoundaryCycleCount(s)
            && p.PolyEdgeUseDefectsSorted(m.Shells[s].DeclaredClosed) == m.PolyEdgeUseDefects(s)
            && m.ReducedCountsPolyIndexed(s, t, p) == m.ReducedCounts(s)
            && m.BoundaryCycleCountPoly(t, p) == m.BoundaryCycleCount(s)
            && m.ShellEulerPlusBoundaryCycles(s) == m.ShellEulerPoincare(s) + m.BoundaryCycleCount(s)
            && m.ShellComponentCountByGrid(s) == m.ShellComponentCount(s);
    }

    // FacetedAgreesOnShell on every shell of m, where the laws that read these look (every
    // index in range).
    FacetedAgreesOn(m: BrepModel): Boolean
        => m.IsEveryIndexInRange
            ? m.Shells.Count.Range.All(s => m.FacetedAgreesOnShell(ShellIndex(s)))
            : true;

    // On every faceted case, the replacements agree with their references on every shell.
    Law_FacetedAgrees(_: Integer): Boolean
        => 0.FacetedCaseCount.Range.All(k => BrepModel.FacetedCase(k).FacetedAgreesOn);

    // On the ten positive witnesses, which have no poly loop, the replacements agree: the
    // faceted parts are empty and the indexed parts are V4's.
    Law_FacetedAgreesOnWitnesses(_: Integer): Boolean
        => BrepModel.WitnessCount.Range.All(k => BrepModel.WitnessAt(k).FacetedAgreesOn);

    // The cases are not vacuous: the jittered sheet's 24 points fall into its 12 grid points and
    // the far sheet's too (the fallback); the plain sheet has 17 implicit edges, one boundary
    // cycle, no defect and chi + B = 2, as the open-shell law wants; the jittered cube's 24
    // points are its 8 corners, with 12 edges, no defect and chi = 2; the sheet declared closed
    // has its 10 boundary edges as defects; the repeated quad and the flipped faces give defects;
    // the box beside three poly triangles is three components.
    Law_FacetedCasesAreFaceted(_: Integer): Boolean
    {
        var s = ShellIndex(0);
        var sheet = BrepModel.FacetedCase(2);
        var jittered = BrepModel.FacetedCase(3).ShellPolyEdgesOf(s);
        var far = BrepModel.FacetedCase(5).ShellPolyEdgesOf(s);
        var plain = sheet.ShellPolyEdgesOf(s);
        var cube = BrepModel.FacetedCase(7);
        var cubeEdges = cube.ShellPolyEdgesOf(s);
        var beside = BrepModel.FacetedCase(1);
        return jittered.PointRoots.Count == 24 && jittered.PointRoots.ClassCount == 12
            && far.PointRoots.ClassCount == 12
            && plain.ImplicitEdgeCountSorted == 17
            && plain.ImplicitBoundaryCycleCountSorted == 1
            && plain.PolyEdgeUseDefectsSorted(false) == 0
            && sheet.ShellEulerPlusBoundaryCycles(s) == 2
            && cubeEdges.PointRoots.ClassCount == 8
            && cubeEdges.ImplicitEdgeCountSorted == 12
            && cubeEdges.PolyEdgeUseDefectsSorted(true) == 0
            && cube.ReducedCountsPolyIndexed(s, cube.EdgeUseTable(s), cubeEdges).EulerPoincare == 2
            && BrepModel.FacetedCase(8).ShellPolyEdgesOf(s).PolyEdgeUseDefectsSorted(true) == 10
            && BrepModel.FacetedCase(9).ShellPolyEdgesOf(s).PolyEdgeUseDefectsSorted(false) > 0
            && BrepModel.FacetedCase(10).ShellPolyEdgesOf(s).PolyEdgeUseDefectsSorted(false) > 0
            && BrepModel.FacetedCase(11).ShellPolyEdgesOf(s).PolyEdgeUseDefectsSorted(true) > 0
            && beside.ShellComponentCountByGrid(ShellIndex(beside.Shells.Count - 1)) == 3;
    }

    // On the unit box's model (tolerance 1e-6), the grid gives the pairwise roots on every
    // generated point array with two shifted copies, 0.6 tol and 1.2 tol along x (a chain whose
    // ends are too far apart to coincide directly), and on the array scaled by tol, which packs
    // the points into a few cells.
    Law_CoincidenceRootsByGridAgrees(points: Array<Point3D>): Boolean
    {
        var m = BrepModel.Witness_UnitBox;
        var tol = 0.0.FacetedTolerance;
        var chained = points.Concatenate(points.Map(q => q + Vector3D(0.6 * tol, 0.0, 0.0)))
            .Concatenate(points.Map(q => q + Vector3D(1.2 * tol, 0.0, 0.0)));
        var close = points.Map(q => Point3D(q.X * tol, q.Y * tol, q.Z * tol));
        return SameIntegers(m.CoincidenceRootsByGrid(chained), m.CoincidenceRootsPairwise(chained))
            && SameIntegers(m.CoincidenceRootsByGrid(close), m.CoincidenceRootsPairwise(close));
    }

    //==
    // # Count witness

    // The sheet of n poly-loop points: 4 columns of quads and n / 16 rows.
    FacetedSheetOfPoints(_: BrepModel, n: Integer): BrepModel
        => BrepModel.FacetedSheet(4, n / 16, 0.0, 0.0, false);

    // The pair tests CoincidenceRootsByGridCounted counts on the points of the sheet of n points.
    FacetedSheetWork(n: Integer): WorkBudget
    {
        var m = BrepModel.FacetedSheetOfPoints(n);
        return m.CoincidenceRootsByGridCounted(m.ShellPolyPoints(ShellIndex(0))).Work;
    }

    // The witness's sizes are the poly-point counts of its sheets, and the grid tests exactly the
    // pairs of copies of each grid point: 4 corners with one copy, 2 r + 4 boundary points with
    // two and 3 (r - 1) inner points with four, r = n / 16 rows, so 196 at 64 and 1764 at 512.
    Law_FacetedSheetSizes(_: Integer): Boolean
        => [64, 512].All(n => BrepModel.FacetedSheetOfPoints(n).ShellPolyPoints(ShellIndex(0)).Count == n)
            && FacetedSheetWork(64).Insertions == 196
            && FacetedSheetWork(512).Insertions == 1764;

    // The grid tests at most 27 points per poly-loop point (Insertions count the points visited
    // in the 27 cells around each point, itself included), on sheets of 64 and 512 points: a
    // grid point's copies, up to four, share a cell or a neighbour, and no other point is within
    // two cells at the witness tolerance. Measured (the sum over grid points of their copies
    // squared) 196 at 64 and 1764 at 512, about 3.4 per point; CoincidenceRoots tests P^2 pairs,
    // 4096 and 262144.
    Witness_FacetedCoincidenceWork(_: WorkClaim): WorkClaim
        => WorkClaim("CoincidenceRootsByGrid: pair tests per poly-loop point", Insertions(27), [64, 512], n => FacetedSheetWork(n));
}

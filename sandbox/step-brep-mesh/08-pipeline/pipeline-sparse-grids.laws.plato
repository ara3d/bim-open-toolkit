//==
// # Sparse topology checks: laws (complexity sweep, chunk V5)
//
// The count witness for Check_EveryEdgeUsedTwiceInClosedShellSparseCounted, the law that every
// cell the sparse checks skip holds by its law's own guard, and the laws that each sparse check
// is its dense grid's Check, field for field (Identical), on every witness model and on the odd
// and negative models. The dense references are written out from CheckShellEdges,
// CheckShellVertices and CheckFaceEdges, not called through the Check_ functions, so the
// agreement still compares two computations after the merge points those functions at the
// sparse forms. Layer 8: the laws use layer 7's witnesses and layer 8's TablesDigonBox,
// TablesStrayBox (chunk E1) and ShellTablesModelOfSize (chunk V4).
//
// Sections, in order:
//  - Witness
//  - Uncited cells
//  - Agreement

library SparseGridsLaws
{
    //==
    // # Witness

    // The work Check_EveryEdgeUsedTwiceInClosedShellSparseCounted counts on V4's model of size
    // n, the coedge count of its one shell: the unit box (24), the block with a through hole (48).
    SparseShellEdgesWork(n: Integer): WorkBudget
        => BrepModel.ShellTablesModelOfSize(n).Check_EveryEdgeUsedTwiceInClosedShellSparseCounted.Work;

    // The sparse edge-use check visits each coedge of a closed shell (Insertions) at most twice:
    // once to place it in its edge's row, once more at most for the cell of that edge, since a
    // cited cell has at least one coedge. The dense check visits S x E cells and rebuilds the
    // shell's C coedge sites at each: 12 x 24 = 288 on the box, above 2 x 24.
    Witness_SparseShellEdgesWork(_: WorkClaim): WorkClaim
        => WorkClaim("Check_EveryEdgeUsedTwiceInClosedShellSparse: coedge placements and cells visited per coedge", Insertions(2), [24, 48], n => SparseShellEdgesWork(n));

    //==
    // # Uncited cells

    // Every cell a sparse check skips holds by its law's own guard: a (shell, edge) cell with no
    // use passes the three edge-use laws, a (face, edge) cell with no use in the face passes
    // Law_SeamUsesRunOpposite, a (shell, vertex) cell with no corner passes both vertex-link laws,
    // and a (shell, vertex) cell no coedge of the shell touches passes
    // Law_VertexLoopVertexIsIsolated. Dense on purpose: it is the reference.
    UncitedCellsHoldOn(m: BrepModel): Boolean
    {
        var edges = m.Shells.Count.Range.All(s => m.Edges.Count.Range.All(e =>
            m.UseCount(ShellIndex(s), BrepEdgeIndex(e)) == 0
                ? (Law_EveryEdgeUsedTwiceInClosedShell(m, ShellIndex(s), BrepEdgeIndex(e))
                    && Law_OpenShellEdgesUsedAtMostTwice(m, ShellIndex(s), BrepEdgeIndex(e))
                    && Law_EdgeUsesHaveOppositeOrientation(m, ShellIndex(s), BrepEdgeIndex(e)))
                : true));
        var seams = m.Faces.Count.Range.All(f => m.Edges.Count.Range.All(e =>
            m.CoedgeSitesOfEdgeInFace(BrepFaceIndex(f), BrepEdgeIndex(e)).Count == 0
                ? Law_SeamUsesRunOpposite(m, BrepFaceIndex(f), BrepEdgeIndex(e))
                : true));
        var links = m.Shells.Count.Range.All(s => m.Vertices.Count.Range.All(v =>
            m.CornersAtVertex(ShellIndex(s), BrepVertexIndex(v)).Count == 0
                ? (Law_VertexLinkIsOneCycle(m, ShellIndex(s), BrepVertexIndex(v))
                    && Law_OpenShellVertexLinkIsCycleOrPath(m, ShellIndex(s), BrepVertexIndex(v)))
                : true));
        var isolated = m.Shells.Count.Range.All(s => m.Vertices.Count.Range.All(v =>
            m.CoedgeSitesOfShell(ShellIndex(s)).Any(x => m.CoedgeTouchesVertex(m.CoedgeAt(x), BrepVertexIndex(v)))
                ? true
                : Law_VertexLoopVertexIsIsolated(m, ShellIndex(s), BrepVertexIndex(v))));
        return edges && seams && links && isolated;
    }

    // Every uncited cell holds, on every witness model. Exact.
    Law_UncitedCellsHold(m: BrepModel): Boolean
        => m.UncitedCellsHoldOn;

    //==
    // # Agreement

    // The seven dense checks, written out as validation-checks-topology.library.plato writes them.
    DenseTopologyChecks(m: BrepModel): Array<Check>
        => [
            m.CheckShellEdges("Law_EveryEdgeUsedTwiceInClosedShell", (s, e) => Law_EveryEdgeUsedTwiceInClosedShell(m, s, e)),
            m.CheckShellEdges("Law_OpenShellEdgesUsedAtMostTwice", (s, e) => Law_OpenShellEdgesUsedAtMostTwice(m, s, e)),
            m.CheckShellEdges("Law_EdgeUsesHaveOppositeOrientation", (s, e) => Law_EdgeUsesHaveOppositeOrientation(m, s, e)),
            m.CheckFaceEdges("Law_SeamUsesRunOpposite", (f, e) => Law_SeamUsesRunOpposite(m, f, e)),
            m.CheckShellVertices("Law_VertexLinkIsOneCycle", (s, v) => Law_VertexLinkIsOneCycle(m, s, v)),
            m.CheckShellVertices("Law_OpenShellVertexLinkIsCycleOrPath", (s, v) => Law_OpenShellVertexLinkIsCycleOrPath(m, s, v)),
            m.CheckShellVertices("Law_VertexLoopVertexIsIsolated", (s, v) => Law_VertexLoopVertexIsIsolated(m, s, v))
        ];

    // The seven sparse checks, in the same order.
    SparseTopologyChecks(m: BrepModel): Array<Check>
        => [
            m.Check_EveryEdgeUsedTwiceInClosedShellSparse,
            m.Check_OpenShellEdgesUsedAtMostTwiceSparse,
            m.Check_EdgeUsesHaveOppositeOrientationSparse,
            m.Check_SeamUsesRunOppositeSparse,
            m.Check_VertexLinkIsOneCycleSparse,
            m.Check_OpenShellVertexLinkIsCycleOrPathSparse,
            m.Check_VertexLoopVertexIsIsolatedSparse
        ];

    // Each sparse check is its dense check, field for field.
    SparseChecksAgreeOn(m: BrepModel): Boolean
        => m.DenseTopologyChecks.Corresponds(m.SparseTopologyChecks, (a, b) => a.Identical(b));

    // The sparse checks agree with the dense ones on every witness model. Exact.
    Law_SparseChecksAgree(m: BrepModel): Boolean
        => m.SparseChecksAgreeOn;

    // The sparse checks agree on the negative witnesses and E1's odd models, and the failures
    // they must find occur: the sphere with redundant pole loops fails
    // Law_VertexLoopVertexIsIsolated, the two boxes sharing a corner fail
    // Law_VertexLinkIsOneCycle, and the stray box, whose edge 4 has three uses and whose loop 1
    // cites edge 99, fails Law_EveryEdgeUsedTwiceInClosedShell at edge 4. Every uncited cell of
    // these models holds too.
    Law_SparseChecksAgreeOnOddModels(_: Integer): Boolean
    {
        var poles = BrepModel.Witness_SphereWithRedundantPoleLoops(1.0);
        var corner = BrepModel.Witness_TwoBoxesSharingCorner;
        var flipped = BrepModel.Witness_BoxWithFlippedFace;
        var digon = BrepModel.TablesDigonBox;
        var stray = BrepModel.TablesStrayBox;
        var agree = poles.SparseChecksAgreeOn && corner.SparseChecksAgreeOn && flipped.SparseChecksAgreeOn
            && digon.SparseChecksAgreeOn && stray.SparseChecksAgreeOn;
        var uncited = poles.UncitedCellsHoldOn && corner.UncitedCellsHoldOn && flipped.UncitedCellsHoldOn
            && digon.UncitedCellsHoldOn && stray.UncitedCellsHoldOn;
        var found = poles.Check_VertexLoopVertexIsIsolatedSparse.Holds.Not
            && corner.Check_VertexLinkIsOneCycleSparse.Holds.Not
            && stray.Check_EveryEdgeUsedTwiceInClosedShellSparse.Where == AtEdge(4);
        return agree && uncited && found;
    }
}

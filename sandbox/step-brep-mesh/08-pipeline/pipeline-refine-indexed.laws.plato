//==
// # Refinement with indexed requests and a raise heap: laws (complexity sweep, chunk R6)
//
// Two count witnesses (parameters copied by RaisedToCountHeapCounted, requests and entries
// scanned by RefineIndexedCounted), the exact laws behind them (the heap's moves stay within
// two levels of the heap per raise; the scans are 2 E + R), and the laws that every new form
// returns its reference's value bit for bit: RaisedToCount on parameter lists and on the
// witness models' discretizations, Refine, the request lookups, RaisedFloors and the
// per-segment test. Layer 8: the laws use layer 7's witnesses and layer 8's helpers
// (CatalogEdgeCriteria, SameTables, Coarsened, RaisedFloors).
//
// Sections, in order:
//  - Raising
//  - Requests and refinement
//  - The per-segment test

library EdgeRefineIndexedLaws
{
    //==
    // # Raising

    // Two parameter lists are the same, entry for entry, bit for bit.
    SameParameters(a: Array<Number>, b: Array<Number>): Boolean
        => a.Count == b.Count ? a.Count.Range.All(i => a[i] == b[i]) : false;

    // Parameter lists that exercise the tie-break and the floating-point midpoints: one segment,
    // uneven widths, equal widths, zero widths, a decreasing list, all equal, two near values,
    // a negative start.
    RaiseLists(_: Integer): Array<Array<Number>>
        => [
            [0.0, 1.0],
            [0.0, 0.1, 0.5, 0.55, 1.0],
            [0.0, 1.0, 2.0, 3.0],
            [0.0, 0.0, 1.0, 1.0, 3.0],
            [3.0, 2.0, 1.0, 0.0],
            [1.0, 1.0, 1.0],
            [0.0, 0.3, 0.30000001, 2.0],
            [-1.0, 0.25, 0.3]];

    // The segment counts the lists are raised to: none, below, at and above the list's own.
    RaiseCounts(_: Integer): Array<Integer>
        => [0, 1, 2, 5, 17, 40, 64];

    // The parameters RaisedToCountHeapCounted copies raising the unit interval to n segments.
    RaisedHeapWork(n: Integer): WorkBudget
        => Insertions(BrepModel.Witness_UnitBox.RaisedToCountHeapCounted([0.0, 1.0], n).Work.Insertions);

    // RaisedToCount copies each parameter of its result once: at most two per segment asked for
    // (n + 1 for n segments), at 8 and 64 segments. The reference copied the whole array once
    // per raise, n (n + 1) / 2 in all from one segment. The heap's own moves grow as n log n,
    // which a slope cannot state; Law_RaisedToCountHeapMovesWithinLog bounds them.
    Witness_RaisedToCountHeapWork(_: WorkClaim): WorkClaim
        => WorkClaim("RaisedToCount: parameters copied per segment asked", Insertions(2), [8, 64], n => RaisedHeapWork(n));

    // Exact: raising n input segments by k copies n + k + 1 parameters, and moves heap entries
    // at most n (1 + L) + k (2 + 2 L) times, L = floor(log2(n + k)): per raise, a root
    // replacement and a push, each sifting at most L levels. No raise, no work.
    Law_RaisedToCountHeapMovesWithinLog(_: Integer): Boolean
        => Integer.RaiseLists.All(ps => Integer.RaiseCounts.All(least =>
            HeapWorkHolds(ps, least, BrepModel.Witness_UnitBox.RaisedToCountHeapCounted(ps, least))));

    // The exact claim of Law_RaisedToCountHeapMovesWithinLog for one list and count.
    HeapWorkHolds(ps: Array<Number>, least: Integer, c: Counted<Array<Number>>): Boolean
    {
        var n = ps.Count - 1;
        var k = (least - n).Max(0);
        var levels = FloorLog2(n + k);
        return k == 0
            ? c.Work.Insertions == 0 && c.Work.Flips == 0 && c.Value.Count == ps.Count
            : c.Value.Count == n + k + 1
                && c.Work.Insertions == n + k + 1
                && c.Work.Flips <= n * (1 + levels) + k * (2 + 2 * levels);
    }

    // RaisedToCountHeap is RaisedToCount, bit for bit, on every list and count. The reference is
    // W0's RaisedToCountCounted, the old loop with its raises counted (its value is RaisedToCount's,
    // Law_RaisedToCountCountedAgrees), so the law still compares two algorithms once RaisedToCount
    // is wired to the heap.
    Law_RaisedToCountHeapAgrees(_: Integer): Boolean
        => Integer.RaiseLists.All(ps => Integer.RaiseCounts.All(least =>
            SameParameters(
                BrepModel.Witness_UnitBox.RaisedToCountHeap(ps, least),
                BrepModel.Witness_UnitBox.RaisedToCountCounted(ps, least).Value)));

    // On every discretized entry of m under the catalog criteria, raised to 5 more segments and
    // to three times as many and one: RaisedToCountHeap is RaisedToCount (the old loop, as
    // above), bit for bit.
    RaisedAgreesOn(m: BrepModel): Boolean
    {
        var d = m.DiscretizeAll(DiscretizationCriteria.CatalogEdgeCriteria, SegmentFloors.NoFloors);
        return d.ByEdge.All(x => x.IsDiscretized
            ? [x.SegmentCount + 5, 3 * x.SegmentCount + 1].All(least =>
                SameParameters(m.RaisedToCountHeap(x.Parameters, least), m.RaisedToCountCounted(x.Parameters, least).Value))
            : true);
    }

    // RaisedToCountHeap agrees on the unit box, the cylinder and the block with a through hole.
    Law_RaisedToCountHeapAgreesOnModels(_: Integer): Boolean
        => RaisedAgreesOn(BrepModel.Witness_UnitBox)
            && RaisedAgreesOn(BrepModel.Witness_Cylinder)
            && RaisedAgreesOn(BrepModel.Witness_BlockWithThroughHole);

    //==
    // # Requests and refinement

    // Requests on edges 0 to 2 of any model: a tighter chordal bound on edge 0; on edge 2 a count
    // of 23 and a second, weaker count with a tighter bound; a count of 40 on edge 1; and one on
    // edge 99, outside every witness model, which every form ignores.
    RefineRequests(c: DiscretizationCriteria): Array<EdgeRefinementRequest>
        => [
            EdgeRefinementRequest(BrepEdgeIndex(0), RefinementReason.TooCoarseInParameterSpace, c.Chordal * 0.25, 0),
            EdgeRefinementRequest(BrepEdgeIndex(2), RefinementReason.QuadCountMismatch, c.Chordal, 23),
            EdgeRefinementRequest(BrepEdgeIndex(2), RefinementReason.TooCoarseInParameterSpace, c.Chordal * 0.5, 7),
            EdgeRefinementRequest(BrepEdgeIndex(1), RefinementReason.QuadCountMismatch, c.Chordal, 40),
            EdgeRefinementRequest(BrepEdgeIndex(99), RefinementReason.QuadCountMismatch, c.Chordal * 0.1, 50)];

    // On m under the catalog criteria: the index answers every lookup as the request scans do,
    // and RefineIndexed is Refine, bit for bit, where Refine's precondition IsRefinable holds.
    RefineAgreesOn(m: BrepModel): Boolean
    {
        var c = DiscretizationCriteria.CatalogEdgeCriteria;
        var d = m.DiscretizeAll(c, SegmentFloors.NoFloors);
        var requests = RefineRequests(c);
        var ix = RequestIndexCounted(requests, d.ByEdge.Count).Value;
        return d.ByEdge.Count.Range.All(i =>
                ix.IsRequestedIn(BrepEdgeIndex(i)) == requests.IsRequested(BrepEdgeIndex(i))
                && ix.RequestedChordalIn(BrepEdgeIndex(i), c.Chordal) == requests.RequestedChordal(BrepEdgeIndex(i), c.Chordal)
                && ix.RequestedSegmentsIn(BrepEdgeIndex(i)) == requests.RequestedSegments(BrepEdgeIndex(i)))
            && (m.IsRefinable(d, requests, c) ? SameTables(m.RefineIndexed(d, requests, c), m.Refine(d, requests, c)) : true);
    }

    // Two count arrays are the same, entry for entry.
    SameCounts(a: Array<Integer>, b: Array<Integer>): Boolean
        => a.Count == b.Count ? a.Count.Range.All(i => a[i] == b[i]) : false;

    // r count requests over the unit box's twelve edges, edge k mod 12 raised to 2 + k mod 3.
    CountRequests(_: Integer, r: Integer): Array<EdgeRefinementRequest>
        => r.MapRange(k => EdgeRefinementRequest(BrepEdgeIndex(k % 12), RefinementReason.QuadCountMismatch, DiscretizationCriteria.CatalogEdgeCriteria.Chordal, 2 + k % 3));

    // The requests and entries RefineIndexedCounted scans on the unit box (12 edges) with n - 12
    // requests.
    RefineScanWork(n: Integer): WorkBudget
    {
        var m = BrepModel.Witness_UnitBox;
        var c = DiscretizationCriteria.CatalogEdgeCriteria;
        return m.RefineIndexedCounted(m.DiscretizeAll(c, SegmentFloors.NoFloors), Integer.CountRequests(n - 12), c).Work;
    }

    // Refine scans each request and each entry a bounded number of times: at most two
    // Insertions per unit of E + R, on the unit box with 4 and 12 requests (sizes 16 and 24).
    // The reference scanned every request three times per requested entry and once per entry,
    // E R + 3 R (requested entries).
    Witness_RefineIndexedWork(_: WorkClaim): WorkClaim
        => WorkClaim("Refine: requests and entries scanned per edge and request", Insertions(2), [16, 24], n => RefineScanWork(n));

    // Exact: 2 E + R, an index slot and a lookup per entry and a visit per request, at both
    // witness sizes, with nothing else counted.
    Law_RefineIndexedScansOnce(_: Integer): Boolean
        => [16, 24].All(n => RefineScanWork(n).Insertions == 2 * 12 + (n - 12)
            && RefineScanWork(n).Evaluations == 0 && RefineScanWork(n).Flips == 0 && RefineScanWork(n).Projections == 0);

    //==
    // # The per-segment test

    // On every discretized entry of m under the catalog criteria, and on each entry coarsened to
    // one segment: the test from deviations computed once is SegmentMeetsCriteriaGiven at every
    // segment.
    SegmentTestAgreesOn(m: BrepModel): Boolean
    {
        var c = DiscretizationCriteria.CatalogEdgeCriteria;
        var d = m.DiscretizeAll(c, SegmentFloors.NoFloors);
        return d.ByEdge.All(x => SegmentTestAgreesAt(m, x, c) && SegmentTestAgreesAt(m, m.Coarsened(x), c));
    }

    // SegmentMeetsCriteriaFrom is SegmentMeetsCriteriaGiven at every segment of d over the
    // edge's usable images.
    SegmentTestAgreesAt(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria): Boolean
    {
        if (m.IsEdgeEvaluable(d.Edge).Not)
        {
            return true;
        }
        var evaluable = d.IsEvaluableGiven(m.EdgeDomain(d.Edge).Range);
        var images = m.EdgeImages(d.Edge);
        var deviations = evaluable
            ? m.ImageDeviationsOf(d, images, SamplePlan.DiscretizationPlan)
            : 0.MapRange(j => 0.MapRange(i => 0.0));
        return d.SegmentCount.Range.All(i =>
            m.SegmentMeetsCriteriaFrom(d, c, i, deviations, evaluable) == m.SegmentMeetsCriteriaGiven(d, c, i, images, evaluable));
    }

    // The per-segment test agrees on the unit box, the cylinder (whose coarsened circles fail)
    // and the cube with an off-surface edge.
    Law_SegmentMeetsCriteriaFromAgrees(_: Integer): Boolean
        => SegmentTestAgreesOn(BrepModel.Witness_UnitBox)
            && SegmentTestAgreesOn(BrepModel.Witness_Cylinder)
            && SegmentTestAgreesOn(BrepModel.TermOffSurfaceCube(1));
}

//==
// # The constrained Delaunay seed on corpus faces: laws (track v1-edges, chunk E4, TKT-468)
//
// The seed's facts (V1EdgesCdtSeedLaws) on faces extracted from the corpus with
// step-corpus-harness extract, meshed there at the host's chordal bound (1.0000000474974513):
// CEL/LARA.STEP faces 742 (101 loops) and 504 (25 loops), whose ear-clipped seeds have 546 of
// 602 and 118 of 154 triangles; SHO/NORA-B100.step face 2745 (118 loops, pads of different
// holes exactly on one line); and POS/RCB-F9T(AP214).STEP face 874 (12 loops), where today's
// triangulation emits a triangle with three collinear corners (TKT-462). The supervisor's
// single-loop witness, SHO/ELLA-W1.STEP face 304, is not one: its region is not simple (two
// crossings), and the host reports it so and never triangulates it. Every single-loop face whose
// ear clipping falls short in the corpus is such a region (ANN-MB2's five, c211's three, ODIN-W260
// 2613, NINA-B222 677 before refinement); the synthetic subdivided rectangles stand for one loop. Each region is built as the host builds it: every edge
// discretized at the host's criteria, the face's region oriented, its points in the face's chart.
//
// Sections, in order:
//  - Regions of witness faces
//  - Laws

library V1EdgesCdtSeedWitnessLaws
{
    //==
    // # Regions of witness faces

    // The host's options at the chordal bound the witnesses were extracted at.
    WitnessHostOptions(_: Integer): MeshingOptions
        => 1.0000000474974513.HostMeshingOptions;

    // Face k of model m's region, built as MeshFace builds it at the host's options.
    WitnessFaceRegion(m: BrepModel, k: Integer): UvRegion
    {
        var c = 0.WitnessHostOptions.Face;
        var d = m.DiscretizeAllRanged(c.Discretization, SegmentFloors.NoFloors);
        var f = BrepFaceIndex(k);
        return m.OrientRegion(f, m.UnorientedRegionOfIn(f, m.SurfaceDomainOf(f), d, c));
    }

    // Face k's boundary points in its chart.
    WitnessFacePoints(m: BrepModel, k: Integer, r: UvRegion): Array<Point2D>
    {
        var chart = m.ChartOf(BrepFaceIndex(k), r);
        return r.BoundaryPoints.Map(uv => chart.ChartPoint(uv));
    }

    // The four facts of V1EdgesCdtSeedLaws.SeedFactsHold on face k of m in its chart.
    WitnessSeedFactsHold(m: BrepModel, k: Integer): Boolean
    {
        var r = m.WitnessFaceRegion(k);
        var points = m.WitnessFacePoints(k, r);
        var next = r.NextBoundaryTable;
        var tris = points.CdtSeedOverCopies(next);
        var area = r.RegionArea(points);
        return tris.Count == points.Count + 2 * r.WideHoles - 2
            && next.Count.Range.All(a => next[a] < 0 ? true : tris.HasSideOnce(a, next[a]))
            && (tris.TrianglesArea(points) - area).Abs <= 1e-9 * area.Abs
            && tris.All(t => t.IsAboveAreaFloor(points));
    }

    // Whether today's ear-clipped seed of face k is short of n + 2h - 2.
    WitnessEarClippingShort(m: BrepModel, k: Integer): Boolean
    {
        var r = m.WitnessFaceRegion(k);
        var points = m.WitnessFacePoints(k, r);
        return r.CdtSeedIndexedCounted(points).Value.Count < points.Count + 2 * r.WideHoles - 2;
    }

    //==
    // # Laws

    // CEL/LARA faces 742 and 504 (witness faces 1 and 0): the seed holds its facts, and today's
    // seed is short on both.
    Law_V1Edges_SeedOnLaraPads(_: Integer): Boolean
    {
        var m = BrepModel.Witness_LaraPadFaces;
        return m.WitnessSeedFactsHold(0) && m.WitnessSeedFactsHold(1)
            && m.WitnessEarClippingShort(0) && m.WitnessEarClippingShort(1);
    }

    // SHO/NORA-B100 face 2745 (118 loops, pads of different holes exactly on one line): the
    // seed holds its facts, no triangle below the floor (before the sliver pass it kept 15 flat
    // triangles of collinear pads), and today's seed is short.
    Law_V1Edges_SeedOnNoraPlane(_: Integer): Boolean
        => BrepModel.Witness_NoraPlane2745.WitnessSeedFactsHold(0) && BrepModel.Witness_NoraPlane2745.WitnessEarClippingShort(0);

    // POS/RCB-F9T face 874: the seed holds its facts, every triangle above the area floor
    // (TKT-462's triangle with corners 186, 187 and 169 on one line is not made).
    Law_V1Edges_SeedOnRcbPlane(_: Integer): Boolean
        => BrepModel.Witness_RcbPlane874.WitnessSeedFactsHold(0);
}

//==
// # The host's meshing options and its refinement step (TKT-436, TKT-454)
//
// One definition of the options the host (StepPlatoMesher) meshes with, beside layer 8's
// DefaultMeshingOptions: the defaults with quad grids preferred (owner decision of 2026-10-21,
// TKT-405). The witness, gate, poles, grid, lift and catalog laws built the same options in five
// places; each is now a call of HostMeshingOptions and the With functions below. And the step the host's loop runs: layer 8's Step with only the
// blocking requests left pending, since the host answers what keeps a face from meshing and leaves
// advisory requests (a coarse segment, a quad count) unanswered.

library PipelineHostOptions
{
    //==
    // # Options

    // The options the host meshes with at an absolute chordal bound in model units: layer 8's
    // defaults with quad grids preferred.
    HostMeshingOptions(chordal: Number): MeshingOptions
        => DefaultMeshingOptions(chordal).WithQuads(true);

    // The options with quad grids preferred or not; every other field kept.
    WithQuads(o: MeshingOptions, quads: Boolean): MeshingOptions
        => MeshingOptions(
            FaceMeshingCriteria(o.Face.Discretization, o.Face.SurfaceChordal, o.Face.SurfaceAngular, quads),
            o.Level, o.MaxRefinementRounds, o.Decode, o.Quality);

    // The options validated at another conformance level; every other field kept.
    WithLevel(o: MeshingOptions, level: ConformanceLevel): MeshingOptions
        => MeshingOptions(o.Face, level, o.MaxRefinementRounds, o.Decode, o.Quality);

    // The options with another round limit; every other field kept.
    WithRounds(o: MeshingOptions, rounds: Integer): MeshingOptions
        => MeshingOptions(o.Face, o.Level, rounds, o.Decode, o.Quality);

    //==
    // # The host's step

    // The requests among rs that keep a face from meshing (RefinementReason.IsBlocking).
    BlockingRequests(rs: Array<EdgeRefinementRequest>): Array<EdgeRefinementRequest>
        => rs.FlatMap(q => q.Reason.IsBlocking ? [q] : EdgeRefinementRequest.NoRequests);

    // The state before refinement for discretizations d and face outcomes made by the caller (the
    // host meshes its first pass on every core): round 0, no floors, the blocking requests of every
    // chosen face pending.
    BlockingStateOf(d: EdgeDiscretizations, outcomes: Array<FaceMeshOutcome>, chosen: Array<Boolean>): PipelineState
        => PipelineState(0, d, SegmentFloors.NoFloors, outcomes, BlockingRequests(outcomes.RequestsOf(chosen)));

    //==
    // # Step in parts
    //
    // Layer 8's Step split so a caller can mesh the faces between the parts on every core: the
    // host runs StepRefined, StepRemeshed, the per-face FaceOutcomeInRange on each remeshed face,
    // then StepNext. Step (pipeline.library.plato) calls StepByParts, so the host and the laws run
    // one definition.

    // The pending requests of s answered: layer 4's Refine under the options' edge criteria.
    StepRefined(m: BrepModel, o: MeshingOptions, s: PipelineState): EdgeDiscretizations
        => m.Refine(s.Discretizations, s.Pending, o.Face.Discretization);

    // The chosen faces Step meshes again: those citing an edge whose discretization d changed.
    StepRemeshed(m: BrepModel, chosen: Array<Boolean>, s: PipelineState, d: EdgeDiscretizations): Array<Boolean>
        => m.FacesTouching(chosen, d.ChangedEdges(s.Discretizations));

    // The state after a step, given its refined discretizations d, the faces it meshed again and
    // the outcomes of every face (the remeshed ones new, the rest s's): round up by one, floors
    // raised to the answered counts, the requests of the remeshed faces pending.
    StepNext(m: BrepModel, s: PipelineState, d: EdgeDiscretizations, remeshed: Array<Boolean>, outcomes: Array<FaceMeshOutcome>): PipelineState
        => PipelineState(s.Round + 1, d, m.RaisedFloors(s.Floors, s.Pending), outcomes, outcomes.RequestsOf(remeshed));

    // Layer 8's Step from its parts, the faces meshed in sequence.
    StepByParts(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>, s: PipelineState): PipelineState
    {
        var d = m.StepRefined(o, s);
        var remeshed = m.StepRemeshed(chosen, s, d);
        var arenaOk = m.Geometry.IsEveryIndexInRange;
        var outcomes = m.Faces.Count.MapRange(k =>
            remeshed[k] ? m.FaceOutcomeInRange(BrepFaceIndex(k), d, o, chosen, arenaOk) : s.Outcomes[k]);
        return m.StepNext(s, d, remeshed, outcomes);
    }

    // s with only its blocking requests pending: what the host's loop keeps after each step.
    BlockingOnly(s: PipelineState): PipelineState
        => PipelineState(s.Round, s.Discretizations, s.Floors, s.Outcomes, BlockingRequests(s.Pending));

    // Layer 8's Step with only the blocking requests of the faces it meshed again left pending.
    StepAnsweringBlocking(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>, s: PipelineState): PipelineState
        => m.Step(o, chosen, s).BlockingOnly;

    // The loop the host runs: StepAnsweringBlocking from s until nothing is pending or the round
    // limit is reached (layer 8's IsTerminal).
    FinalStateAnsweringBlocking(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>, s0: PipelineState): PipelineState
    {
        var s = s0;
        while (!s.IsTerminal(o))
        {
            s = m.StepAnsweringBlocking(o, chosen, s);
        }
        return s;
    }

    //==
    // # The five copies' one definition (each copy's body is the call)

    // PolesLaws.PolesOptionsAt(chordal, quads).
    PolesOptionsAtHost(chordal: Number, quads: Boolean): MeshingOptions
        => HostMeshingOptions(chordal).WithQuads(quads);

    // GridChordalLaws.GridCaseCriteria(_): the host's face criteria at 0.01.
    GridCaseCriteriaHost(_: FaceMeshingCriteria): FaceMeshingCriteria
        => HostMeshingOptions(0.01).Face;

    // PipelineProofsMesh's CatalogQuadCriteria(c): the witness options' face criteria with quads
    // and surface chordal c.
    CatalogQuadCriteriaHost(c: Number): FaceMeshingCriteria
    {
        var f = MeshingOptions.WitnessOptions.WithQuads(true).Face;
        return FaceMeshingCriteria(f.Discretization, c, f.SurfaceAngular, f.PreferQuads);
    }

    // FaceMeshingLiftIndexedLaws.LiftCaseCriteria(quads): with quads, the surface chordal bound is
    // one model unit (the lift cases test collapsed quads, not the bound).
    LiftCaseCriteriaHost(quads: Boolean): FaceMeshingCriteria
    {
        var f = MeshingOptions.WitnessOptions.WithQuads(quads).Face;
        return FaceMeshingCriteria(f.Discretization, quads ? 1.0 : f.SurfaceChordal, f.SurfaceAngular, quads);
    }

    // StructuralWitnessOptions(_), declared twice with one body (pipeline-run.laws.plato and
    // tooling-law-runner.laws.plato): the witness options at the Structural level.
    StructuralWitnessOptionsHost(_: MeshingOptions): MeshingOptions
        => MeshingOptions.WitnessOptions.WithLevel(ConformanceLevel.Structural);
}

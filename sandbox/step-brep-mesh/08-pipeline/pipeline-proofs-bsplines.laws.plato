//==
// # Laws of the B-spline proofs (layer 1)
//
// Two laws per B-spline proof type of 01-geometry/geometry-proofs.types.plato,
// over this layer's five curve fixtures (CurveFixture) and a sixth with a
// negative weight, which is why they are layer 8's. The frame laws are layer
// 1's (geometry-proofs.laws.plato). The closure laws of layer 3's
// EndsClosure (TKT-348) are here for the same reason: they run over the
// curve fixtures plus layer 3's five closure splines.
//
// Sections, in order:
//  - B-splines
//  - Closure from clamped ends

library StepToMeshProofsBSplinesLaws
{
    //==
    // # B-splines

    // Curve k modulo 6: 0 to 4 the curve fixtures (CurveFixture; 3 is the
    // unclamped one), 5 fixture 0 with its first weight negative.
    CatalogCurveAt(k: Integer): BSplineCurveData
    {
        var i = k.FixtureIndex(6);
        var d = CurveFixture(0);
        return i < 5
            ? CurveFixture(i)
            : BSplineCurveData(d.Basis, d.ControlPoints, d.Weights.Count.MapRange(j => j == 0 ? 0.0 - d.Weights[j] : d.Weights[j]));
    }

    // CheckWellFormedBSpline succeeds exactly when the record keeps every
    // shape rule.
    Law_WellFormedBSplineIffWellShaped(k: Integer): Boolean
        => CheckWellFormedBSpline(CatalogCurveAt(k)).IsDecided == CatalogCurveAt(k).IsWellShaped;

    // A WellFormedBSpline keeps its record's counts.
    Law_WellFormedBSplineKeepsRecord(k: Integer): Boolean
        => CatalogWellFormedKeeps(CatalogCurveAt(k), CheckWellFormedBSpline(CatalogCurveAt(k)));

    // The claim of Law_WellFormedBSplineKeepsRecord for the result
    // w of checking record d.
    CatalogWellFormedKeeps(d: BSplineCurveData, w: DecidedWellFormedBSpline): Boolean
        => match (w) {
            Decided(p) => p.Data.ControlPoints.Count == d.ControlPoints.Count && p.Data.Basis == d.Basis;
            Undecided(r) => true;
        };

    // Of the well-formed fixtures, CheckClampedBSpline accepts exactly the
    // ones layer 8's fixture notes call clamped: every one but fixture 3.
    Law_ClampedBSplineIffFixtureClamped(k: Integer): Boolean
        => CatalogClampedIff(k.FixtureIndex(Integer.CurveFixtureCount) != 3, CheckWellFormedBSpline(CurveFixture(k)));

    // The claim of Law_ClampedBSplineIffFixtureClamped for the
    // result w of the well-formedness check.
    CatalogClampedIff(clamped: Boolean, w: DecidedWellFormedBSpline): Boolean
        => match (w) {
            Decided(p) => CheckClampedBSpline(p).IsDecided == clamped;
            Undecided(r) => true;
        };

    // A ClampedBSpline starts at its first control point and ends at its
    // last, within the rounding allowance of its control points' size.
    Law_ClampedBSplineInterpolatesEnds(k: Integer): Boolean
        => CatalogClampedEnds(CheckWellFormedBSpline(CatalogCurveAt(k)));

    // The claim of Law_ClampedBSplineInterpolatesEnds for the
    // result w of the well-formedness check.
    CatalogClampedEnds(w: DecidedWellFormedBSpline): Boolean
        => match (w) {
            Decided(p) => CatalogClampedEndsOf(CheckClampedBSpline(p));
            Undecided(r) => true;
        };

    // The claim of Law_ClampedBSplineInterpolatesEnds for the
    // result c of the clamping check.
    CatalogClampedEndsOf(c: DecidedClampedBSpline): Boolean
        => match (c) {
            Decided(p) => p.Data.BSplinePoint(p.Data.Basis.SplineDomain.Start).Distance(p.Data.ControlPoints.First)
                    <= ResolutionAt(4.0 * p.Data.ControlPoints.Reduce(0.0, (m, q) => m.Max(q.PositionVector.Length))).Value
                && p.Data.BSplinePoint(p.Data.Basis.SplineDomain.End).Distance(p.Data.ControlPoints.Last)
                    <= ResolutionAt(4.0 * p.Data.ControlPoints.Reduce(0.0, (m, q) => m.Max(q.PositionVector.Length))).Value;
            Undecided(r) => true;
        };

    //==
    // # Closure from clamped ends

    // A clamped B-spline's closure is decided, from its first and last
    // control points: Closed exactly when they coincide within tol; an
    // unclamped one is Undecided. Over the curve fixtures (all clamped) and
    // layer 3's closure splines.
    Law_ClampedSplineClosureIsItsEndControlPoints(k: Integer, tol: LengthTolerance): Boolean
    {
        var d = k.ClosureSplineFixture;
        var decision = d.EndsClosure(tol);
        return d.Basis.HasClampedEnds
            ? decision.IsDecided && decision.IsClosed == d.ControlPoints.First.Coincident(d.ControlPoints.Last, tol)
            : !decision.IsDecided;
    }

    // For a clamped B-spline that can be evaluated, the ends decision agrees
    // with evaluation at the domain's ends (ISO 10303-42 4.5.34: a clamped
    // spline interpolates its end control points).
    Law_ClampedSplineEndsAreTheEvaluatedEnds(k: Integer, tol: LengthTolerance): Boolean
    {
        var d = k.FixtureIndex(Integer.CurveFixtureCount + 2).ClosureSplineFixture;
        var dom = d.Basis.SplineDomain;
        return d.Basis.HasClampedEnds
            ? d.EndsClosure(tol).IsClosed == d.BSplinePoint(dom.Start).Coincident(d.BSplinePoint(dom.End), tol)
            : true;
    }

    // The spline fixtures of the closure laws: the CurveFixtureCount curve
    // fixtures, then layer 3's ClampedOpenSpline, ClampedClosedSpline,
    // UnclampedSpline, UnevaluableClampedSpline and UnevaluableClosedSpline,
    // by k modulo.
    ClosureSplineFixture(k: Integer): BSplineCurveData
    {
        var n = Integer.CurveFixtureCount;
        var i = k.FixtureIndex(n + 5);
        return i < n
            ? i.CurveFixture
            : (i == n
                ? BSplineCurveData.ClampedOpenSpline
                : (i == n + 1
                    ? BSplineCurveData.ClampedClosedSpline
                    : (i == n + 2
                        ? BSplineCurveData.UnclampedSpline
                        : (i == n + 3 ? BSplineCurveData.UnevaluableClampedSpline : BSplineCurveData.UnevaluableClosedSpline))));
    }
}

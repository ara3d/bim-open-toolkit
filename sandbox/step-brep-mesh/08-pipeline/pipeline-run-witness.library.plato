//==
// # Loop run witnesses: the values (complexity sweep, chunk L2)
//
// The Witness_* values of LoopRunWitness and CostlyLoopRunWitness
// (pipeline-run-witness.types.plato), each model's loop run once per sweep under the witness
// options. No witness here is validated: the bump patch solid's validation did not finish in
// minutes on the compiled backend at any level (TRACK.md, "Findings"), and the laws over these
// witnesses read the loop and the mesh, not the report of the validation; the laws over a
// validated outcome take chunk L1's MeshedWitness.
//
// Sections, in order:
//  - Building a witness
//  - Models that mesh within a law's budget
//  - Models that do not

library StepToMeshLoopRunWitnesses
{
    //==
    // # Building a witness

    // Every state of m's refinement loop under o over the chosen faces, from InitialState to the
    // terminal state, each the Step of the one before: StateAfter's loop at the round limit,
    // keeping each state.
    LoopStates(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>): Array<PipelineState>
    {
        var s = m.InitialState(o, chosen);
        var states = [s];
        while (s.Round < o.MaxRefinementRounds ? !s.IsTerminal(o) : false)
        {
            s = m.Step(o, chosen, s);
            states = states.Append(s);
        }
        return states;
    }

    // Model m named name, its loop run under the witness options over every face, and the mesh
    // its last state assembles.
    LoopRunWitnessOf(m: BrepModel, name: String): LoopRunWitness
    {
        var states = m.LoopStates(MeshingOptions.WitnessOptions, m.AllFaces);
        return LoopRunWitness(name, m, states, m.AssembledMesh(states[states.Count - 1]));
    }

    //==
    // # Models that mesh within a law's budget
    //
    // Meshing each takes milliseconds compiled without validation, so a law may mesh it again.

    // The unit box: 8 vertices, 12 triangles, no refinement round.
    Witness_UnitBoxLoopRun(_: LoopRunWitness): LoopRunWitness
        => BrepModel.Witness_UnitBox.LoopRunWitnessOf("UnitBox");

    // The block 3 x 3 x 1 with a 1 x 1 square through hole: genus 1.
    Witness_BlockWithThroughHoleLoopRun(_: LoopRunWitness): LoopRunWitness
        => BrepModel.Witness_BlockWithThroughHole.LoopRunWitnessOf("BlockWithThroughHole");

    // The hollow box 2 x 2 x 2 around a void 1 x 1 x 1: two shells.
    Witness_HollowBoxLoopRun(_: LoopRunWitness): LoopRunWitness
        => BrepModel.Witness_HollowBox.LoopRunWitnessOf("HollowBox");

    // The crescent sheet (bspline-witnesses.library.plato): one face whose first loop crosses
    // itself in the parameter plane, resolved in one refinement round; the one witness here whose
    // loop takes a step.
    Witness_CrescentLoopRun(_: LoopRunWitness): LoopRunWitness
        => BrepModel.Witness_BsplineCrescentSheet.LoopRunWitnessOf("Crescent");

    //==
    // # Models that do not

    // Layer 7's B-spline patch solid with bump 1/2: a closed solid whose top is a Bezier patch, no
    // refinement round. Its loop takes 7.7 s compiled (TRACK.md).
    Witness_BumpSolidLoopRun(_: CostlyLoopRunWitness): CostlyLoopRunWitness
        => CostlyLoopRunWitness(BrepModel.Witness_BSplinePatchSolid(0.5).LoopRunWitnessOf("BumpSolid"));
}

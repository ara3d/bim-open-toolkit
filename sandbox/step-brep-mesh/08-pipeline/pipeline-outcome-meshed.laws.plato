//==
// # StepToMeshLaws over meshed witnesses: the validated outcome (complexity sweep, chunk L2)
//
// The laws of pipeline.laws.plato that read a model's whole report, validation included, restated
// over chunk L1's MeshedWitness (08 pipeline-meshed-witness.types.plato): each reads the outcome
// the runner built once per sweep and never calls MeshModel. A law the original swept by an
// Integer index (a finding, an edge) checks every index in one case. The laws that read the loop
// or the mesh take LoopRunWitness (pipeline-run.laws.plato). At merge each Law_<X> replaces
// Law_<X> of StepToMeshLaws (TRACK.md).

library StepToMeshOutcomeMeshedLaws
{
    // Witness w's outcome is Ok exactly when its report is clean at the requested level.
    Law_OkExactlyWhenClean(w: MeshedWitness): Boolean
        => w.Outcome.Ok == w.Outcome.Report.IsClean;

    // Every diagnostic of witness w's outcome is located: its provenance is not Nowhere.
    Law_EveryDiagnosticIsLocated(w: MeshedWitness): Boolean
        => w.Outcome.Report.Diagnostics.All(d => !(d.Where == Provenance.Nowhere));

    // Every edge of witness w's model that cannot be discretized has an error located at the
    // edge.
    Law_UndiscretizableEdgeIsDiagnosed(w: MeshedWitness): Boolean
    {
        var m = w.Model;
        var c = MeshingOptions.WitnessOptions.Face.Discretization;
        return m.IsRunnable(MeshingOptions.WitnessOptions)
            ? m.Edges.Count.Range.All(e =>
                m.CanDiscretize(BrepEdgeIndex(e), c)
                    ? true
                    : w.Outcome.Report.Diagnostics.Any(d => d.Severity.IsError && d.Where == Provenance.KernelEdge(BrepEdgeIndex(e))))
            : true;
    }
}

// The ODIN-W160 fillet witness's law (TKT-460). Its model, Witness_OdinW160Face3364And3398
// (pipeline-corpus-witness-odin-w160-fillet.library.plato) was
// written by `step-corpus-harness extract ODIN-W160.STEP 3364,3398 <out> --ring 1` on a regeneration of 4a30959f,
// the library before V1G-15, so the face counts in its header are the defect's: 6 triangles on each of faces 3364
// and 3398.
library V1GateCorpusWitnessLaws
{
    // SHO/ODIN-W160.STEP's quarter-cylinder fillets 3364 and 3398 (radius about 0.2 mm) with their five neighbours,
    // among them fillets 3414 and 3431. Under chordal-only refinement (V1G-4) each fillet kept triangles whose three
    // corners lie on one model edge: one-edge flaps filling the plane of an end arc that two mitred faces share,
    // so two faces covered one patch, giving 8 non-manifold and 16 misoriented edges in the corpus run of
    // 2026-10-22. The contract asks for no non-manifold edge and a consistent orientation; the witness is an open
    // shell, so it is not asked to be closed. The measure counts the non-manifold edges.
    Law_V1Gate_OdinW160FilletIsManifoldAndOriented(_: Integer): Boolean
    {
        var t = BrepModel.Witness_OdinW160Face3364And3398.MeshModel(HostMeshingOptions(1.0)).Mesh.EdgeTableOf;
        return t.CountNonManifoldEdges == 0 && t.CountMisorientedEdges == 0;
    }

    Measure_V1Gate_OdinW160FilletIsManifoldAndOriented(_: Integer): Integer
        => BrepModel.Witness_OdinW160Face3364And3398.MeshModel(HostMeshingOptions(1.0)).Mesh.EdgeTableOf.CountNonManifoldEdges;
}

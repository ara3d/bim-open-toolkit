//==
// # Laws of the scaled length floor (TKT-454)
//
// They read layer 8's DiscretizedWitness, so they live in layer 8 beside the library function's
// layer 4.

library DiscretizationRequestedChordalLaws
{
    // A positive requested bound below the criteria's keeps the ratio of floor to bound.
    Law_V1Proof_RequestedChordalKeepsFloorRatio(c: DiscretizationCriteria, k: Integer): Boolean
    {
        var chordal = c.Chordal * (0.5).Pow((1 + k.FixtureIndex(4)).ToNumber);
        var r = c.WithRequestedChordal(chordal);
        return c.Chordal > 0.0
            ? (r.Chordal == chordal && (r.MinLength / r.Chordal - c.MinLength / c.Chordal).Abs <= 1e-12 * (c.MinLength / c.Chordal).Abs.Max(1.0)
                && r.Angular == c.Angular && r.MinSegments == c.MinSegments)
            : true;
    }

    // A zero requested bound keeps the floor: no curved edge is bisected to the tolerance.
    Law_V1Proof_ZeroRequestKeepsFloor(c: DiscretizationCriteria): Boolean
        => c.WithRequestedChordal(0.0).MinLength == c.MinLength;

    // An edge no request names comes out of Refine as it went in.
    Law_V1Proof_RefineKeepsUnrequestedEdges(w: DiscretizedWitness, e: Integer): Boolean
    {
        var rs = w.RefinementRequestsOf;
        var requests = rs.Count > 0 ? [rs[0]] : rs;
        var d = w.Discretizations;
        var i = e.FixtureIndex(d.ByEdge.Count.Max(1));
        return (d.ByEdge.IsValidIndex(i) && w.Model.IsRefinable(d, requests, w.Criteria) && !requests.IsRequested(BrepEdgeIndex(i)))
            ? w.Model.Refine(d, requests, w.Criteria).ByEdge[i].SameDiscretization(d.ByEdge[i])
            : true;
    }

    // The CAM case on a witness: the cylinder's edges discretized with a floor as long as the
    // whole circle (so no segment may split), then every edge asked for a hundredth of the bound.
    // Refine lowers the floor with the bound and splits the curved ones (the lines meet any
    // chordal bound already); before TKT-454 it kept every requested edge as it was. Staged as
    // Law_V1Proof_RefineScaledSplitsWhereRefineCannot, which also stated the before half.
    Law_V1Proof_RefineSplitsUnderARequestedBound(_: Integer): Boolean
    {
        var m = BrepModel.Witness_Cylinder;
        var base = DefaultCriteria(0.5);
        var c = DiscretizationCriteria(base.Chordal, base.Angular, base.MaxLength, 8.0, 1);
        var d = m.DiscretizeAll(c, SegmentFloors.NoFloors);
        var requests = d.ByEdge.FlatMap(x => x.IsDiscretized
            ? [EdgeRefinementRequest(x.Edge, RefinementReason.LoopSelfIntersects, 0.01 * c.Chordal, 0)]
            : EdgeRefinementRequest.NoRequests);
        var after = m.Refine(d, requests, c);
        return requests.Count > 0
            && requests.Any(q => after.ByEdge[q.Edge].Parameters.Count > d.ByEdge[q.Edge].Parameters.Count);
    }
}

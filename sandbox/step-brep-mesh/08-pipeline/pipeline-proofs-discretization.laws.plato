//==
// # Laws of the discretization proofs (layer 4)
//
// Two laws per proof type of 04-discretization/discretization-proofs.types.plato,
// as in 07-validation/validation-proofs-kernel.laws.plato, over the witnesses'
// tables under this layer's witness criteria (DiscretizeAll with no floors,
// MeshingOptions.WitnessOptions, which is why they are layer 8's), and over
// the same tables with one entry knocked out.
//
// Sections, in order:
//  - Tables
//  - Whole tables
//  - One edge

library StepToMeshProofsDiscretizationLaws
{
    //==
    // # Tables

    // The edge criteria the pipeline's witness laws mesh with.
    CatalogEdgeCriteria(_: DiscretizationCriteria): DiscretizationCriteria
        => MeshingOptions.WitnessOptions.Face.Discretization;

    // The table DiscretizeAll makes for model m under the witness criteria.
    CatalogTableOf(m: BrepModel): EdgeDiscretizations
        => m.DiscretizeAll(DiscretizationCriteria.CatalogEdgeCriteria, SegmentFloors.NoFloors);

    // The table with entry j, when there is one, replaced by Undiscretized.
    CatalogWithUndiscretized(d: EdgeDiscretizations, j: Integer): EdgeDiscretizations
        => EdgeDiscretizations(d.ByEdge.Count.MapRange(i => i == j ? Undiscretized(d.ByEdge[i].Edge) : d.ByEdge[i]));

    // Witness k's table, with entry j knocked out when j is a valid entry.
    CatalogTableAt(k: Integer, j: Integer): EdgeDiscretizations
        => CatalogProofModelAt(k).CatalogTableOf.CatalogWithUndiscretized(j);

    // Witness k's entry for edge e, reversed when r is odd. Precondition:
    // e names an edge of witness k.
    CatalogEntryAt(k: Integer, e: Integer, r: Integer): EdgeDiscretization
        => ((r % 2) + 2) % 2 == 0
            ? CatalogProofModelAt(k).CatalogTableOf.ByEdge[e]
            : CatalogProofModelAt(k).CatalogTableOf.ByEdge[e].Reversed;

    //==
    // # Whole tables

    // The claim of Law_CompleteDiscretizationKeepsTable for the
    // result c of checking table d.
    CatalogCompleteKeeps(d: EdgeDiscretizations, c: DecidedCompleteDiscretization): Boolean
        => match (c) {
            Decided(p) => p.ByEdge.Count == d.ByEdge.Count
                ? p.ByEdge.Count.Range.All(i => p.ByEdge[i].SameDiscretization(d.ByEdge[i]))
                : false;
            Undecided(r) => true;
        };

    // The claim of Law_PartialDiscretizationListsFailures for the
    // result c of checking table d.
    CatalogPartialLists(d: EdgeDiscretizations, c: DecidedPartialDiscretization): Boolean
        => match (c) {
            Decided(p) => p.Failed.Count == d.ByEdge.Reduce(0, (n, x) => x.IsDiscretized ? n : n + 1)
                && p.Failed.All(e => d.ByEdge.IsValidIndex(e.Value) ? d.ByEdge[e.Value].IsDiscretized.Not : false);
            Undecided(r) => true;
        };

    //==
    // # One edge

    // The claim of Law_CanonicalDiscretizationKeepsPolyline for the
    // result c of checking polyline d.
    CatalogCanonicalKeeps(d: EdgeDiscretization, c: DecidedCanonicalDiscretization): Boolean
        => match (c) {
            Decided(p) => p.Discretization.SameDiscretization(d) && p.Where == Provenance.KernelEdge(d.Edge);
            Undecided(r) => true;
        };

    // Same for an even s, Opposite for an odd one.
    CatalogSenseOf(s: Integer): Sense
        => ((s % 2) + 2) % 2 == 0 ? Sense.Same : Sense.Opposite;

    // The claim of Law_DirectedAlongReversesOnlyWhenOpposite for
    // the result c of a canonical check.
    CatalogDirectedAlong(s: Sense, c: DecidedCanonicalDiscretization): Boolean
        => match (c) {
            Decided(p) => DirectedAlong(p, s).Sense == s
                && DirectedAlong(p, s).Discretization.SameDiscretization(
                    s == Sense.Same ? p.Discretization : p.Discretization.Reversed);
            Undecided(r) => true;
        };

    // The claim of Law_MeetsCriteriaProofRecordsWorst for the
    // result c of checking polyline d of model m. Exact by construction:
    // the same Sagitta calls on the same parameters.
    CatalogMeetsRecords(m: BrepModel, d: EdgeDiscretization, c: DecidedMeetsCriteriaProof): Boolean
        => match (c) {
            Decided(p) => p.Edge == d.Edge
                && p.Criteria == DiscretizationCriteria.CatalogEdgeCriteria
                && p.Worst.Value == d.SegmentCount.Range.Reduce(0.0, (w, i) => w.Max(m.Sagitta(d.Edge, d.Parameters[i], d.Parameters[i + 1])))
                && p.Where == Provenance.KernelEdge(d.Edge);
            Undecided(r) => true;
        };
}

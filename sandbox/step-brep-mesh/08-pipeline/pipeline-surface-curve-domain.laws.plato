//==
// # Surface curves parameterized by a pcurve: laws (TKT-414)
//
// The NINA-B222 edges in miniature: a circle of radius 0.3 at height 0.5 on a cylinder of radius
// 0.3, written as a surface curve whose master is its pcurve, a 2D line along u. With the pcurve's
// ClosestParameter and the repeating domain, an edge on it gets its arc's range: a quarter turn
// from pi / 2 to pi, a quarter turn across u = 0, and the same quarter turn on a line of speed 2
// in u, whose parameter is half the angle. Every positive witness's edge ranges are tractable;
// an absurd range on a line is not. The laws read layer 7's witnesses, so they live in layer 8.
//
// Sections, in order:
//  - The surface-curve edge
//  - Laws

library SurfaceCurveDomainLaws
{
    //==
    // # The surface-curve edge

    // A model of one edge from the circle's point at angle a to its point at angle b, on curve 1:
    // the surface curve over curve 0 (the circle of radius 0.3 about the z axis at z = 0.5) whose
    // master is pcurve 0, the 2D line (0, 0.5) + t (speed, 0) on the cylinder of radius 0.3 about
    // the z axis. No loop, face, shell or body: EdgeDomain reads the edge, its vertices and the
    // arena.
    SurfaceCurveEdge(_: BrepModel, a: Number, b: Number, speed: Number): BrepModel
        => BrepModel(
            GeometrySet(
                [BrepCurve.Circle(WorldFrameAt(Point3D(0.0, 0.0, 0.5)), 0.3),
                 BrepCurve.OnSurface(CurveIndex(0), [CurveSupport.Parametric(PcurveIndex(0))], PreferredRepresentation.FirstPcurve)],
                [BrepCurve2D.Line(UvCoordinate(0.0, 0.5), Vector2D(speed, 0.0))],
                [Pcurve(SurfaceIndex(0), Curve2DIndex(0))],
                [BrepSurface.Cylinder(WorldFrameAt(Point3D(0.0, 0.0, 0.0)), 0.3)],
                []),
            [BrepVertex(Point3D(0.3 * a.Cos, 0.3 * a.Sin, 0.5)), BrepVertex(Point3D(0.3 * b.Cos, 0.3 * b.Sin, 0.5))],
            [BrepEdge(BrepVertexIndex(0), BrepVertexIndex(1), CurveIndex(1), true)],
            [], [], [], [],
            Tolerances.Witness_Tolerances,
            LengthUnit.Metre);

    // Whether the edge's range under EdgeDomain is [start, end] to 1e-9, and tractable.
    HasRange(m: BrepModel, start: Number, end: Number): Boolean
    {
        var e = BrepEdgeIndex(0);
        var r = m.EdgeDomain(e).Range;
        return (r.Start - start).Abs <= 1e-9 && (r.End - end).Abs <= 1e-9
            && m.IsTractableRange(e, DefaultCriteria(0.001), r);
    }

    //==
    // # Laws

    // The surface-curve edge's range is its arc's: [pi / 2, pi]; across u = 0, from 7 pi / 4 to
    // 9 pi / 4; on the line of speed 2, [pi / 4, pi / 2].
    Law_V1Edges_SurfaceCurveEdgeHasArcRange(_: Integer): Boolean
    {
        var pi = Number.Pi;
        return BrepModel.SurfaceCurveEdge(pi / 2.0, pi, 1.0).HasRange(pi / 2.0, pi)
            && BrepModel.SurfaceCurveEdge(0.0 - pi / 4.0, pi / 4.0, 1.0).HasRange(7.0 * pi / 4.0, 9.0 * pi / 4.0)
            && BrepModel.SurfaceCurveEdge(pi / 2.0, pi, 2.0).HasRange(pi / 4.0, pi / 2.0);
    }

    // The surface curve's domain is one turn of the line, periodic: [0, 2 pi) at speed 1,
    // [0, pi) at speed 2.
    Law_V1Edges_SurfaceCurveDomainRepeats(_: Integer): Boolean
    {
        var one = BrepModel.SurfaceCurveEdge(0.0, 1.0, 1.0).Geometry.Domain(CurveIndex(1));
        var two = BrepModel.SurfaceCurveEdge(0.0, 1.0, 2.0).Geometry.Domain(CurveIndex(1));
        return one.Range.Start == 0.0 && (one.Range.End - Number.Tau).Abs <= 1e-12 && one.Periodicity.IsPeriodic
            && two.Range.Start == 0.0 && (two.Range.End - Number.Pi).Abs <= 1e-12 && two.Periodicity.IsPeriodic;
    }

    // On every positive witness, every intact edge's range under EdgeDomain is tractable at
    // DefaultCriteria(0.001). (Staged as Law_V1Edges_WitnessEdgeRangesKept, which also compared
    // EdgeDomainV1 with EdgeDomain; after the merge that half compared EdgeDomain with itself.)
    Law_V1Edges_WitnessEdgeRangesTractable(_: Integer): Boolean
        => BrepModel.WitnessCount.Range.All(k =>
            BrepModel.WitnessAt(k).IsEveryIndexInRange
                ? BrepModel.WitnessAt(k).Edges.Count.Range.All(i =>
                    BrepModel.WitnessAt(k).IsTractableRange(BrepEdgeIndex(i), DefaultCriteria(0.001),
                        BrepModel.WitnessAt(k).EdgeDomain(BrepEdgeIndex(i)).Range))
                : true);

    // On the unit box, an edge's line over the range [-1e29, 1e29] is not tractable, nor over a
    // range that does not increase.
    Law_V1Edges_AbsurdRangeRefused(_: Integer): Boolean
    {
        var m = BrepModel.Witness_UnitBox;
        var c = DefaultCriteria(0.001);
        return m.IsTractableRange(BrepEdgeIndex(0), c, NumberInterval(0.0 - 1e29, 1e29)).Not
            && m.IsTractableRange(BrepEdgeIndex(0), c, NumberInterval(1.0, 1.0)).Not
            && m.IsTractableRange(BrepEdgeIndex(0), c, m.EdgeDomain(BrepEdgeIndex(0)).Range);
    }
}

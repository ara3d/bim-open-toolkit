// Laws for cause A of TKT-465 (01-geometry/geometry-closed-wrap.library.plato). They read layer 1's index-level
// entry points, which evaluate at EvaluatedAt, and compare against the record-level functions, which evaluate as
// given.
library V1ReliabilityClosedWrapLaws
{
    // Nine parameters inside surface s's domain, at a quarter, a half and three quarters of each bounded direction's
    // range; an unbounded direction (a plane's, a cylinder's v) takes 0, 0.5 and 1.
    ClosedWrapSamples(g: GeometrySet, s: SurfaceIndex): Array<UvCoordinate>
        => 9.Range.Map(n => UvCoordinate(g.DomainOnce(s).U.SampleAt(n / 3), g.DomainOnce(s).V.SampleAt(n % 3)));

    // Sample i of 3 along a direction: a quarter, a half or three quarters of its range when the range is finite.
    SampleAt(d: CurveDomain, i: Integer): Number
        => (d.Range.Start.IsFinite && d.Range.End.IsFinite)
            ? d.Range.Start + (d.Range.End - d.Range.Start) * (i.ToNumber + 1.0) * 0.25
            : i.ToNumber * 0.5;

    // uv moved by n periods along its closed directions.
    ShiftedByPeriods(d: SurfaceDomain, uv: UvCoordinate, n: Number): UvCoordinate
        => UvCoordinate(uv.U + n * d.U.ClosedPeriod, uv.V + n * d.V.ClosedPeriod);

    // True when surface s has a closed direction.
    HasClosedDirection(g: GeometrySet, s: SurfaceIndex): Boolean
        => g.DomainOnce(s).U.IsClosedDirection || g.DomainOnce(s).V.IsClosedDirection;

    // At uv moved n periods, surface s's point, partials and normal are those at uv, within tol (the wrap's
    // rounding).
    SameAfterShift(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, n: Number, tol: Number): Boolean
    {
        var moved = g.DomainOnce(s).ShiftedByPeriods(uv, n);
        return (g.Eval(s, moved) - g.Eval(s, uv)).Length <= tol
            && (g.PartialU(s, moved) - g.PartialU(s, uv)).Length <= tol * (1.0 + g.PartialU(s, uv).Length)
            && (g.PartialV(s, moved) - g.PartialV(s, uv)).Length <= tol * (1.0 + g.PartialV(s, uv).Length)
            && (g.LimitNormal(s, moved).Vector - g.LimitNormal(s, uv).Vector).Length <= tol;
    }

    // Surface s, when it has a closed direction, evaluates periodically at every sample, one period either way.
    PeriodicAt(g: GeometrySet, s: SurfaceIndex, tol: Number): Boolean
        => !g.HasClosedDirection(s)
            || g.ClosedWrapSamples(s).All(uv => g.SameAfterShift(s, uv, -1.0, tol) && g.SameAfterShift(s, uv, 1.0, tol));

    // The JODY witness's surfaces, among them the closed B-splines of faces 322, 444 and 584, evaluate periodically
    // along their closed directions. On Eval before TKT-465 this failed: 0.054 mm at v = -0.5 on face 322.
    Law_V1Reliability_ClosedDirectionIsPeriodic(_: Integer): Boolean
    {
        var g = BrepModel.Witness_JodyW5W6Faces322And444And584.Geometry;
        return g.Surfaces.Count.Range.All(k => g.PeriodicAt(SurfaceIndex(k), 1e-6));
    }

    // At uv in the range, the index-level entry points of surface s give exactly what its record gives.
    UnchangedAt(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): Boolean
        => g.Eval(s, uv) == g.SurfaceAt(s).Eval(g, uv)
            && g.PartialU(s, uv) == g.SurfaceAt(s).PartialU(g, uv)
            && g.PartialV(s, uv) == g.SurfaceAt(s).PartialV(g, uv);

    InRangeUnchanged(g: GeometrySet): Boolean
        => g.Surfaces.Count.Range.All(k => g.ClosedWrapSamples(SurfaceIndex(k)).All(uv => g.UnchangedAt(SurfaceIndex(k), uv)));

    // No evaluation that was right changes: in the range the index-level entry points equal the record bit for bit, on
    // every positive witness (analytic surfaces, the B-spline patch solid) and on the JODY witness.
    Law_V1Reliability_InRangeEvaluationUnchanged(k: Integer): Boolean
        => BrepModel.WitnessAt(k).Geometry.InRangeUnchanged
            && BrepModel.Witness_JodyW5W6Faces322And444And584.Geometry.InRangeUnchanged;

    // Every corner of face f of the meshed state lies within bound of its surface at its parameters, read through
    // Eval.
    CornersOnSurface(m: BrepModel, state: PipelineState, f: Integer, bound: Number): Boolean
        => state.Outcomes[BrepFaceIndex(f)].Mesh.UvPoints.Count.Range.All(i =>
            (state.Outcomes[BrepFaceIndex(f)].Mesh.Positions[state.Outcomes[BrepFaceIndex(f)].Mesh.LocalVertex[i].Value]
                - m.Geometry.Eval(m.SurfaceOf(BrepFaceIndex(f)), state.Outcomes[BrepFaceIndex(f)].Mesh.UvPoints[i])).Length <= bound);

    // The corners of the JODY witness's faces 2, 4 and 5 (corpus faces 322, 444, 584), meshed the host's way, lie
    // within 1e-4 mm of their surface at their parameters. Before the fix the corners on the circle edge sat 0.45 to
    // 0.5 mm away.
    Law_V1Reliability_JodyCornersOnSurface(_: Integer): Boolean
    {
        var m = BrepModel.Witness_JodyW5W6Faces322And444And584;
        var state = m.FinalState(HostMeshingOptions(1.0), m.AllFaces);
        return m.CornersOnSurface(state, 2, 1e-4) && m.CornersOnSurface(state, 4, 1e-4) && m.CornersOnSurface(state, 5, 1e-4);
    }
}

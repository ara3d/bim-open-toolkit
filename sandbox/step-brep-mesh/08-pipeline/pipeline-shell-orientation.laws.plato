//==
// # Shell connectivity, orientation and the fold: laws (complexity sweep, chunk V8)
//
// The two count witnesses, and the laws that each replacement returns what its reference
// returns, exactly: ShellComponentCountByVertex is ShellComponentCount, OrientationFlipsByAdjacency
// is OrientationFlips face for face, IsOrientableByAdjacency is IsOrientable,
// WithFacesReversedMarked is WithFacesReversed (layer 7's SameModel), and FoldParity marks the
// faces FoldedFaces lists. Layer 8: the laws use layer 7's witnesses and SameModel, layer 3's raw
// witnesses, and V4's ShellTablesModelOfSize.
//
// Sections, in order:
//  - Witnesses
//  - Connectivity
//  - Orientation
//  - Reversing faces and the fold

library ShellOrientationLaws
{
    //==
    // # Witnesses

    // The work ShellComponentCountByVertexCounted counts on shell 0 of V4's model of size n (the
    // unit box, 24 coedges, up to 24; the block with a through hole, 48, above).
    ShellComponentCountWork(n: Integer): WorkBudget
        => BrepModel.ShellTablesModelOfSize(n).ShellComponentCountByVertexCounted(ShellIndex(0)).Work;

    // ShellComponentCountByVertex visits each face once and each vertex reference twice (two per
    // coedge), so at most 6 per coedge with the faces counted generously. The reference tests
    // every pair of faces and rebuilds both vertex lists per pair: 15 pairs x 8 x 8 = 960 vertex
    // comparisons on the box alone, above 6 x 24.
    Witness_ShellComponentCountWork(_: WorkClaim): WorkClaim
        => WorkClaim("ShellComponentCountByVertex: face and corner visits per coedge of the shell", Insertions(6), [24, 48], n => ShellComponentCountWork(n));

    // The work OrientationFlipsByAdjacencyCounted counts on shell 0 of V4's model of size n.
    OrientationFlipsWork(n: Integer): WorkBudget
    {
        var m = BrepModel.ShellTablesModelOfSize(n);
        return m.OrientationFlipsByAdjacencyCounted(ShellIndex(0), m.EdgeUseTable(ShellIndex(0))).Work;
    }

    // OrientationFlipsByAdjacency visits each face a bounded number of times, each use once and
    // each adjacency entry (two per link, a link per edge, an edge per two coedges) twice: at most
    // 4 per coedge. The reference scans every link per dequeued face: 6 x 12 = 72 link visits on
    // the box besides a PositionOf per use, and F_s E_s grows quadratically.
    Witness_OrientationFlipsWork(_: WorkClaim): WorkClaim
        => WorkClaim("OrientationFlipsByAdjacency: face, use and adjacency visits per coedge of the shell", Insertions(4), [24, 48], n => OrientationFlipsWork(n));

    //==
    // # Connectivity

    // The model with one more shell, open, holding every face of the model: two separate solids
    // give a shell of two components.
    WithEveryFaceInOneShell(m: BrepModel): BrepModel
        => BrepModel(m.Geometry, m.Vertices, m.Edges, m.Loops, m.Faces,
            m.Shells.Concatenate([BrepShell(m.Faces.Count.MapRange(k => BrepFaceIndex(k)), false)]),
            m.Bodies, m.Tolerances, m.Unit);

    // Witness_BoxWithPolyLoopSheet with two more triangles on poly loops: face 7 shares the point
    // (1, 0, 3) with face 6 and no vertex index, face 8 touches nothing. All nine faces in one
    // shell are three components: the box, faces 6 and 7, face 8.
    PolyTrianglesBesideBox(_: BrepModel): BrepModel
    {
        var m = BrepModel.Witness_BoxWithPolyLoopSheet;
        return BrepModel(m.Geometry, m.Vertices, m.Edges,
            m.Loops.Concatenate([
                BrepLoop.PolyLoop([Point3D(1.0, 0.0, 3.0), Point3D(2.0, 0.0, 3.0), Point3D(1.0, 1.0, 3.0)]),
                BrepLoop.PolyLoop([Point3D(5.0, 5.0, 3.0), Point3D(6.0, 5.0, 3.0), Point3D(5.0, 6.0, 3.0)])]),
            m.Faces.Concatenate([SingleLoopFace(6, 7, true), SingleLoopFace(6, 8, true)]),
            m.Shells, m.Bodies, m.Tolerances, m.Unit).WithEveryFaceInOneShell;
    }

    // ShellComponentCountByVertex is ShellComponentCount on every shell, where the laws that
    // read it look (every index in range).
    ComponentCountsAgree(m: BrepModel): Boolean
        => m.IsEveryIndexInRange
            ? m.Shells.Count.Range.All(s => m.ShellComponentCountByVertex(ShellIndex(s)) == m.ShellComponentCount(ShellIndex(s)))
            : true;

    // The counts agree where faces touch only through coinciding poly-loop points, and the cases
    // occur: two separate unit cubes in one shell are two components, the box beside three poly
    // triangles three.
    Law_ShellComponentCountAgreesOnPolyLoops(_: Integer): Boolean
    {
        var poly = BrepModel.PolyTrianglesBesideBox;
        var last = ShellIndex(poly.Shells.Count - 1);
        var cubes = BrepModel.Witness_TwoUnitCubesMillimetres.WithEveryFaceInOneShell;
        var both = ShellIndex(cubes.Shells.Count - 1);
        return poly.ComponentCountsAgree && cubes.ComponentCountsAgree
            && poly.ShellComponentCountByVertex(last) == 3
            && cubes.ShellComponentCountByVertex(both) == 2;
    }

    //==
    // # Orientation

    // The same faces in the same order.
    SameFaces(a: Array<BrepFaceIndex>, b: Array<BrepFaceIndex>): Boolean
        => a.Count == b.Count ? a.Count.Range.All(k => a[k] == b[k]) : false;

    // On every shell of m: the flips by adjacency are OrientationFlips' face for face, and
    // IsOrientableByAdjacency is IsOrientable. Precondition: m.IsEveryIndexInRange.
    OrientationAgreesOn(m: BrepModel): Boolean
        => m.Shells.Count.Range.All(s =>
            SameFaces(m.OrientationFlipsByAdjacency(ShellIndex(s), m.EdgeUseTable(ShellIndex(s))), m.OrientationFlips(ShellIndex(s)))
            && m.IsOrientableByAdjacency(ShellIndex(s)) == m.IsOrientable(ShellIndex(s)));

    // The search finds flips: on the unit box with faces 1 and 3 reversed it names those two
    // faces; on Witness_BoxWithFlippedFace, whose flipped sense leaves every edge's uses opposite,
    // none. Both are orientable.
    Law_OrientationFlipsAreFound(_: Integer): Boolean
    {
        var box = BrepModel.Witness_UnitBox.WithFacesReversed([BrepFaceIndex(1), BrepFaceIndex(3)]);
        var flipped = BrepModel.Witness_BoxWithFlippedFace;
        var s = ShellIndex(0);
        var a = box.OrientationFlipsByAdjacency(s, box.EdgeUseTable(s));
        var b = flipped.OrientationFlipsByAdjacency(s, flipped.EdgeUseTable(s));
        return SameFaces(a, [BrepFaceIndex(1), BrepFaceIndex(3)]) && b.Count == 0
            && box.IsOrientableByAdjacency(s) && flipped.IsOrientableByAdjacency(s);
    }

    //==
    // # Reversing faces and the fold

    // A fold record naming face k.
    FoldOn(k: Integer): FoldRecord
        => FoldRecord(BrepFaceIndex(k), FoldCause.OrientedFace, StepSource(StepOccurrenceIndex(0), StepInstanceId(k)));

    // FoldParity marks exactly the faces FoldedFaces lists: mark k is true iff k is listed.
    MarksTheFoldedFaces(folds: Array<FoldRecord>, faceCount: Integer): Boolean
    {
        var marks = FoldParity(folds, faceCount);
        var listed = folds.FoldedFaces(faceCount);
        return marks.Count == faceCount
            && SameFaces(faceCount.Range.FlatMap(k => marks[k] ? [BrepFaceIndex(k)] : listed.Take(0)), listed);
    }

    // On records naming faces 3 three times, 1 twice, 5, 0, 99 and -1 over six faces, FoldParity
    // marks faces 0, 3 and 5, as FoldedFaces lists them; no records mark nothing; and the unit
    // box reversed by the marks is the box reversed by the list. Exact.
    Law_FoldParityMarksFoldedFaces(_: Integer): Boolean
    {
        var folds = [3, 1, 3, 5, 3, 0, 99, -1, 1].Map(k => FoldOn(k));
        var box = BrepModel.Witness_UnitBox;
        var marks = FoldParity(folds, 6);
        return MarksTheFoldedFaces(folds, 6)
            && MarksTheFoldedFaces(folds, 0)
            && MarksTheFoldedFaces(folds.Take(0), 6)
            && marks[0] && marks[3] && marks[5] && !marks[1] && !marks[2] && !marks[4]
            && box.WithFacesReversedMarked(marks).SameModel(box.WithFacesReversed(folds.FoldedFaces(6)));
    }

    // On every raw witness, the fold PrepareModelWith applies (the decoder's records and the
    // mirror records) reverses the same faces through FoldParity as through FoldedFaces, and so
    // does the refold of the prepared model's recorded folds. Exact (SameModel).
    Law_FoldParityAgreesOnRawWitnesses(raw: RawDecodedModel): Boolean
    {
        var folds = raw.Folds.Concatenate(raw.MirrorFolds);
        var m = raw.Model;
        var d = raw.PrepareModel;
        var n = d.Model.Faces.Count;
        return MarksTheFoldedFaces(folds, m.Faces.Count)
            && m.WithFacesReversedMarked(FoldParity(folds, m.Faces.Count)).SameModel(m.WithFacesReversed(folds.FoldedFaces(m.Faces.Count)))
            && d.Model.WithFacesReversedMarked(FoldParity(d.Map.Folds, n)).SameModel(d.Model.WithFacesReversed(d.Map.Folds.FoldedFaces(n)));
    }
}

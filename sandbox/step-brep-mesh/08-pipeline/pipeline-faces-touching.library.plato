//==
// # Faces touching changed edges, by coedges (complexity sweep chunk F1, TKT-360)
//
// FacesTouchingByCoedges is layer 08's FacesTouching with the same marks. FacesTouching builds
// FaceEdges per face (O(C^2) for C coedges) only to ask Any over it; Any does not care that an
// edge appears twice, so the face's coedges serve directly (O(C)).

library PipelineIndexed
{
    // Per face, true when the face is chosen and one of its coedges cites an edge marked in
    // changed: FacesTouching's marks.
    FacesTouchingByCoedges(m: BrepModel, chosen: Array<Boolean>, changed: Array<Boolean>): Array<Boolean>
        => m.Faces.Count.MapRange(k =>
            chosen.IsChosen(BrepFaceIndex(k))
                ? m.FaceCoedges(BrepFaceIndex(k)).Any(c => changed.IsValidIndex(c.Edge) ? changed[c.Edge] : false)
                : false);
}

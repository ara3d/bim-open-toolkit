//==
// # Meshed witnesses for the face-mask laws (complexity sweep, chunk M3)
//
// A model and its mesh under the witness options, built once per sweep by the law runner and
// shared by the laws over this type (testing strategy, part a). Chunk L1's MeshedWitness holds
// the same pair inside a MeshOutcome; once it merges, these laws read w.Outcome.Mesh instead.

// A model and the mesh MeshModel made of it under the witness options.
type MaskMeshWitness
{
    Name: String;
    Model: BrepModel;
    Mesh: ModelMesh;
}

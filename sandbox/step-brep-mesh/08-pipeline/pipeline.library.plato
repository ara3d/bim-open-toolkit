//==
// # STEP to mesh
//
// Layer 8 of the STEP B-rep to mesh design (README.md beside this file). The
// stages composed into total functions. MeshStepText parses (ParseStep),
// decodes (DecodeBrepWith), and meshes the model. MeshModel discretizes every
// edge once (layer 4), meshes every face (layer 5), runs the bounded loop that
// refines the edges face meshing asks for and meshes their faces again,
// assembles the face meshes by numbering (layer 6), and validates the result
// at the requested conformance level (layer 7). Every body here is the
// definition; nothing is deferred (the model transforms the metamorphic
// laws need are layer 2's).
//
// Sections, in order:
//  - Options
//  - Findings of the pipeline
//  - Edges
//  - Faces
//  - The refinement loop
//  - Assembly, validation, outcomes
//  - Entry points

library StepToMesh
{
    //==
    // # Options

    // The recommended options for an absolute chordal bound in model units
    // (research/MESHING-REQUIREMENTS.md 2.5 and section 8): layer 4's
    // DefaultCriteria on edges (15 degrees, no length limit, a minimum length
    // of a tenth of the chordal bound, 3 segments per closed edge); the same
    // chordal bound on faces (OpenCascade); a normal turn of at most 15 degrees
    // along an element edge (ACIS's default for that quantity); triangles only;
    // validation at Geometric, which checks every promise the options make;
    // 5 refinement rounds (OpenCascade's bound); the standard decode policy;
    // Cubit's "acceptable" quality thresholds (layer 6).
    DefaultMeshingOptions(chordal: Number): MeshingOptions
        => MeshingOptions(
            FaceMeshingCriteria(DefaultCriteria(chordal), chordal, 15.0.Degrees, false),
            ConformanceLevel.Geometric,
            5,
            DecodePolicy.StandardPolicy,
            MeshQualityThresholds.CubitAcceptable);

    // The recommended options with the chordal bound a fraction of model m's
    // size (layer 2's ModelSize, the diagonal of its bounding box), resolved
    // once per model: research/MESHING-REQUIREMENTS.md 2.5 recommends 0.001.
    // A model with no point has size 0, so its chordal bound is 0 and a run
    // refuses the options (PIPELINE-OPTIONS-ILL-FORMED) rather than guess.
    // A caller meshing a text decodes it first and passes the decoded model.
    RelativeMeshingOptions(m: BrepModel, fraction: Number): MeshingOptions
        => DefaultMeshingOptions(fraction * m.ModelSize);

    // True when a run can honour the options: well-formed face criteria (layer
    // 5's IsWellFormed, which includes the edge criteria) and a round limit
    // that is not negative.
    IsWellFormed(o: MeshingOptions): Boolean
        => o.Face.IsWellFormed && o.MaxRefinementRounds >= 0;

    // The options with the chordal bound of edges and of faces both set to
    // chordal; every other field kept.
    WithChordal(o: MeshingOptions, chordal: Number): MeshingOptions
        => MeshingOptions(
            FaceMeshingCriteria(o.Face.Discretization.WithChordal(chordal), chordal, o.Face.SurfaceAngular, o.Face.PreferQuads),
            o.Level,
            o.MaxRefinementRounds,
            o.Decode,
            o.Quality);

    // The largest chordal bound the options apply on a model with tolerances
    // t, on edges (never below the length tolerance, layer 4's
    // EffectiveChordal) or on faces.
    ChordalBound(o: MeshingOptions, t: Tolerances): Number
        => o.Face.Discretization.EffectiveChordal(t).Max(o.Face.SurfaceChordal);

    // The options with every length multiplied by factor: both chordal bounds,
    // the length limit, and the minimum length. Angles, counts, the level, the
    // round limit, the decode policy (whose lengths are relative to the
    // model or in metres), and the quality thresholds (ratios) are kept.
    ScaledBy(o: MeshingOptions, factor: Number): MeshingOptions
        => MeshingOptions(o.Face.ScaledBy(factor), o.Level, o.MaxRefinementRounds, o.Decode, o.Quality);

    //==
    // # Findings of the pipeline
    //
    // Each finding the pipeline itself makes, with its code, severity, and
    // fixed message in one place. Codes start with PIPELINE-. A finding about
    // the input as a whole is located at layer 0's Provenance.WholeInput, and
    // layer 0's Located puts every finding a lower layer left at Nowhere
    // there too.

    // The options cannot be honoured: a criterion is not well formed or the
    // round limit is negative. Measure: the round limit.
    UnusableOptions(o: MeshingOptions): Diagnostic
        => Diagnostic(Severity.Error, "PIPELINE-OPTIONS-ILL-FORMED",
            "The meshing options cannot be honoured (a criterion is not positive, the angles are out of range, or the round limit is negative); nothing was meshed.",
            Provenance.WholeInput, o.MaxRefinementRounds.ToNumber);

    // The model has an index out of range, so no edge can be discretized
    // (layer 4's CanDiscretize requires Law_IndicesInRange). Measure: the
    // face count.
    UnindexedModel(m: BrepModel): Diagnostic
        => Diagnostic(Severity.Error, "PIPELINE-MODEL-NOT-INDEXED",
            "The model holds an index out of range; nothing was meshed. The model's own validation below names the indices.",
            Provenance.WholeInput, m.Faces.Count.ToNumber);

    // The model has no face, so the mesh has no element.
    NoFacesFound(m: BrepModel): Diagnostic
        => Diagnostic(Severity.Error, "PIPELINE-NO-FACES",
            "The model has no face; the mesh is empty.",
            Provenance.WholeInput, 0.0);

    // Edge e cannot be discretized: its curve cannot be evaluated or its
    // domain is empty. Every face that cites it is left unmeshed.
    UndiscretizedEdge(e: BrepEdgeIndex): Diagnostic
        => Diagnostic(Severity.Error, "PIPELINE-EDGE-UNDISCRETIZED",
            "This edge cannot be discretized (its curve cannot be evaluated or its domain is empty); no face that cites it is meshed.",
            Provenance.KernelEdge(e), Number.Unmeasured);

    // Face f still holds a blocking request when the loop stops: its loops
    // cross in parameter space after every refinement the loop could make.
    // Measure: the rounds taken.
    UnresolvedFace(f: BrepFaceIndex, rounds: Integer): Diagnostic
        => Diagnostic(Severity.Error, "PIPELINE-FACE-UNRESOLVED",
            "The loops of this face still cross in parameter space after the refinement rounds; the face has no mesh. Measure is the rounds taken.",
            Provenance.KernelFace(f), rounds.ToNumber);

    // Face f has no mesh and its outcome locates no error at it.
    EmptyFace(f: BrepFaceIndex): Diagnostic
        => Diagnostic(Severity.Error, "PIPELINE-FACE-EMPTY",
            "This face has no mesh, and face meshing gave no finding at the face.",
            Provenance.KernelFace(f), 0.0);

    // The findings about the model as a whole: no face, and every edge that
    // cannot be discretized under the options.
    ModelDiagnostics(m: BrepModel, o: MeshingOptions): Array<Diagnostic>
        => (m.Faces.Count == 0 ? [m.NoFacesFound] : Diagnostic.NoDiagnostics)
            .Concatenate(m.EdgeDiagnostics(o));

    // Why a run is refused: options that are not well formed, a model with an
    // index out of range, or both.
    RefusalDiagnostics(m: BrepModel, o: MeshingOptions): Array<Diagnostic>
        => (o.IsWellFormed ? Diagnostic.NoDiagnostics : [o.UnusableOptions])
            .Concatenate(m.Law_IndicesInRange ? Diagnostic.NoDiagnostics : [m.UnindexedModel]);

    //==
    // # Edges

    // Every edge Undiscretized (layer 4's empty entry): the table of a
    // refused run.
    NoDiscretizations(m: BrepModel): EdgeDiscretizations
        => EdgeDiscretizations(m.Edges.Count.MapRange(i => Undiscretized(BrepEdgeIndex(i))));

    // An error for every edge that cannot be discretized under the options.
    EdgeDiagnostics(m: BrepModel, o: MeshingOptions): Array<Diagnostic>
        => m.Edges.Count.Range.FlatMap(i =>
            m.CanDiscretize(BrepEdgeIndex(i), o.Face.Discretization)
                ? Diagnostic.NoDiagnostics
                : [UndiscretizedEdge(BrepEdgeIndex(i))]);

    // Per edge, true when after differs from before: the edges a refinement
    // step actually changed. A requested edge whose segments are all at the
    // length floor comes out of Refine unchanged and is not marked.
    ChangedEdges(after: EdgeDiscretizations, before: EdgeDiscretizations): Array<Boolean>
        => after.ByEdge.Count.MapRange(i =>
            before.ByEdge.IsValidIndex(i)
                ? !after.ByEdge[i].SameDiscretization(before.ByEdge[i])
                : true);

    // The floors raised to every segment count the requests ask for, one
    // entry per edge: the record of the count requests answered so far.
    RaisedFloors(m: BrepModel, floors: SegmentFloors, requests: Array<EdgeRefinementRequest>): SegmentFloors
        => SegmentFloors(m.Edges.Count.MapRange(i =>
            floors.FloorOf(BrepEdgeIndex(i)).Max(requests.RequestedSegments(BrepEdgeIndex(i)))));

    //==
    // # Faces

    // Every face of the model chosen: what MeshModel meshes.
    AllFaces(m: BrepModel): Array<Boolean>
        => m.Faces.Count.MapRange(k => true);

    // The choice with face f left out: "the run without f" of the failure
    // isolation law.
    Excluding(chosen: Array<Boolean>, f: BrepFaceIndex): Array<Boolean>
        => chosen.Count.MapRange(k => k == f.Value ? false : chosen[k]);

    // True when the run meshes face f. A face past the end of the choice is
    // not chosen.
    IsChosen(chosen: Array<Boolean>, f: BrepFaceIndex): Boolean
        => chosen.IsValidIndex(f) ? chosen[f] : false;

    // Face f's outcome under discretizations d: layer 5's MeshFace when f is
    // chosen and every edge it cites is discretized (MeshFace's
    // precondition); otherwise an empty mesh with an error at the face
    // (layer 5's UnmeshedOutcome).
    FaceOutcome(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, o: MeshingOptions, chosen: Array<Boolean>): FaceMeshOutcome
        => !chosen.IsChosen(f)
            ? f.UnmeshedOutcome("PIPELINE-FACE-EXCLUDED",
                "This face was left out of the run; it has no mesh.")
            : (m.IsDiscretizedFace(f, d)
                ? m.MeshFace(f, d, o.Face)
                : f.UnmeshedOutcome("PIPELINE-FACE-UNDISCRETIZED",
                    "This face is not intact or cites an edge that has no discretization; it is not meshed."));

    // Per face, true when the face is chosen and cites an edge marked in
    // changed: the faces a refinement step meshes again.
    FacesTouching(m: BrepModel, chosen: Array<Boolean>, changed: Array<Boolean>): Array<Boolean>
        => m.Faces.Count.MapRange(k =>
            chosen.IsChosen(BrepFaceIndex(k))
                ? m.FaceEdges(BrepFaceIndex(k)).Any(e => changed.IsValidIndex(e) ? changed[e] : false)
                : false);

    // The requests of the outcomes whose faces are marked in meshed, in face
    // order: what the faces meshed in one round ask for.
    RequestsOf(outcomes: Array<FaceMeshOutcome>, meshed: Array<Boolean>): Array<EdgeRefinementRequest>
        => outcomes.Count.Range.FlatMap(k =>
            meshed.IsValidIndex(k)
                ? (meshed[k] ? outcomes[k].Requests : EdgeRefinementRequest.NoRequests)
                : EdgeRefinementRequest.NoRequests);

    // True when the outcome withholds its mesh for a request (layer 5's
    // IsBlocking: a loop that is not simple in parameter space).
    HasBlockingRequest(x: FaceMeshOutcome): Boolean
        => x.Requests.Any(q => q.Reason.IsBlocking);

    // True when the outcome holds an error located at face f.
    HasErrorAt(x: FaceMeshOutcome, f: BrepFaceIndex): Boolean
        => x.Diagnostics.Any(d => d.Severity.IsError && d.Where == Provenance.KernelFace(f));

    // The pipeline's own finding for face f when its final outcome has no
    // mesh: unresolved when a blocking request is still unanswered (face
    // meshing locates those findings at the edges), empty when the outcome
    // locates no error at the face; nothing otherwise. So every face without
    // a mesh has an error at the face (Law_EmptyFaceIsDiagnosed).
    FailureDiagnostics(x: FaceMeshOutcome, f: BrepFaceIndex, rounds: Integer): Array<Diagnostic>
        => !x.Mesh.IsEmptyFaceMesh
            ? Diagnostic.NoDiagnostics
            : (x.HasBlockingRequest
                ? [f.UnresolvedFace(rounds)]
                : (x.HasErrorAt(f) ? Diagnostic.NoDiagnostics : [f.EmptyFace]));

    //==
    // # The refinement loop
    //
    // A fixed-point iteration over PipelineState. InitialState discretizes
    // every usable edge once and meshes every chosen face; Step answers the
    // pending requests with layer 4's Refine (which takes the smallest
    // requested chordal bound and the largest requested count per edge, and
    // only ever adds points), meshes again exactly the chosen faces that cite
    // an edge Refine changed, and makes their requests pending. The loop stops
    // when nothing is pending or Round reaches MaxRefinementRounds; the
    // measure MaxRefinementRounds - Round falls by one per step.

    // The state before any refinement: every usable edge discretized once
    // with no floors, every face given its outcome, and the requests of the
    // chosen faces pending.
    InitialState(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>): PipelineState
    {
        var d = m.DiscretizeAll(o.Face.Discretization, SegmentFloors.NoFloors);
        var outcomes = m.Faces.Count.MapRange(k => m.FaceOutcome(BrepFaceIndex(k), d, o, chosen));
        return PipelineState(0, d, SegmentFloors.NoFloors, outcomes, outcomes.RequestsOf(chosen));
    }

    // True when the loop stops: nothing is pending, or the round limit is
    // reached.
    IsTerminal(s: PipelineState, o: MeshingOptions): Boolean
        => s.Pending.Count == 0 || s.Round >= o.MaxRefinementRounds;

    // One refinement step: the pending requests answered by Refine, the floors
    // raised to their counts, the chosen faces that cite a changed edge meshed
    // again and every other outcome kept as it is, and the requests of the
    // faces meshed in this step made pending. Round goes up by one.
    Step(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>, s: PipelineState): PipelineState
    {
        var d = m.Refine(s.Discretizations, s.Pending, o.Face.Discretization);
        var remeshed = m.FacesTouching(chosen, d.ChangedEdges(s.Discretizations));
        var outcomes = m.Faces.Count.MapRange(k =>
            remeshed[k] ? m.FaceOutcome(BrepFaceIndex(k), d, o, chosen) : s.Outcomes[k]);
        return PipelineState(s.Round + 1, d, m.RaisedFloors(s.Floors, s.Pending), outcomes, outcomes.RequestsOf(remeshed));
    }

    // The state after k steps from InitialState, or the terminal state when
    // the loop stops sooner. A k of 0 or less gives the initial state.
    StateAfter(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>, k: Integer): PipelineState
    {
        var s = m.InitialState(o, chosen);
        while (s.Round < k ? !s.IsTerminal(o) : false)
        {
            s = m.Step(o, chosen, s);
        }
        return s;
    }

    // The terminal state of the loop: StateAfter the round limit, since the
    // loop stops there at the latest.
    FinalState(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>): PipelineState
        => m.StateAfter(o, chosen, o.MaxRefinementRounds);

    //==
    // # Assembly, validation, outcomes

    // The face meshes of a state, indexed by face.
    FaceMeshesOf(s: PipelineState): Array<FaceMesh>
        => s.Outcomes.Map(x => x.Mesh);

    // The state's face meshes numbered and assembled (layer 6): shared
    // boundary vertices are one vertex because they cite one site, never
    // because their positions are close.
    AssembledMesh(m: BrepModel, s: PipelineState): ModelMesh
        => m.AssembleModelMesh(s.FaceMeshesOf, m.NumberMeshVertices(s.Discretizations, s.FaceMeshesOf));

    // The validation of a mesh of m under the options (layer 7), every part
    // at o.Level: the model; the mesh against the model's tolerances and the
    // options' quality thresholds; and the two against each other with the
    // criteria the mesh was made for, so that an Oracle run checks the face
    // areas and solid volumes within the envelopes the criteria imply.
    Validated(m: BrepModel, mesh: ModelMesh, o: MeshingOptions): Report
        => m.ValidateBrep(o.Level)
            .Merge(mesh.ValidateModelMesh(m.Tolerances, o.Quality, o.Level))
            .Merge(m.CrossCheck(mesh, o.Level, o.Face));

    // The findings of a finished loop: the model's (no face, undiscretized
    // edges), every final face outcome's, and the pipeline's own finding for
    // each chosen face left without a mesh, and the discretization's (an edge off its face's
    // surface, a refinement stopped at the length floor).
    LoopReport(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>, s: PipelineState): Report
        => ReportOf(m.ModelDiagnostics(o))
            .Merge(ReportOf(s.Outcomes.FlatMap(x => x.Diagnostics)))
            .Merge(ReportOf(m.DiscretizationFindings(s.Discretizations, o.Face.Discretization)))
            .Merge(ReportOf(m.Faces.Count.Range.FlatMap(k =>
                chosen.IsChosen(BrepFaceIndex(k))
                    ? s.Outcomes[k].FailureDiagnostics(BrepFaceIndex(k), s.Round)
                    : Diagnostic.NoDiagnostics)));

    // The outcome of a mesh, a report, and a round count. The one place Ok is
    // set, so Ok is exactly Report.IsClean.
    MeshOutcomeOf(mesh: ModelMesh, report: Report, rounds: Integer): MeshOutcome
        => MeshOutcome(report.IsClean, mesh, report, rounds);

    // True when a run of the loop is defined: the model's indices are in range
    // (layer 2) and the options are well formed. Outside, the run is refused.
    IsRunnable(m: BrepModel, o: MeshingOptions): Boolean
        => m.Law_IndicesInRange && o.IsWellFormed;

    // The outcome of a refused run: every face mesh empty, so the mesh holds
    // the model's vertices and no element; the refusal's findings and the
    // model's validation at o.Level; no round.
    RefusedOutcome(m: BrepModel, o: MeshingOptions): MeshOutcome
    {
        var empties = m.Faces.Count.MapRange(k => EmptyFaceMesh(BrepFaceIndex(k)));
        var mesh = m.AssembleModelMesh(empties, m.NumberMeshVertices(m.NoDiscretizations, empties));
        var report = ReportOf(m.RefusalDiagnostics(o)).Merge(m.ValidateBrep(o.Level));
        return MeshOutcomeOf(mesh, report.Located(Provenance.WholeInput), 0);
    }

    // The outcome of the loop run to its end over the chosen faces: the
    // assembled mesh, the loop's findings and the validation at the options'
    // level, every finding located, and the rounds taken.
    RunOutcome(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>): MeshOutcome
    {
        var s = m.FinalState(o, chosen);
        var mesh = m.AssembledMesh(s);
        var report = m.LoopReport(o, chosen, s).Merge(m.Validated(mesh, o));
        return MeshOutcomeOf(mesh, report.Located(Provenance.WholeInput), s.Round);
    }

    //==
    // # Entry points

    // Meshes the chosen faces of m under o; every face left out gets an empty
    // mesh and an error. Total: a model with an index out of range, or
    // options that are not well formed, give a refused outcome. MeshModel
    // chooses every face; the failure isolation law compares two choices.
    MeshChosenFaces(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>): MeshOutcome
        => m.IsRunnable(o) ? m.RunOutcome(o, chosen) : m.RefusedOutcome(o);

    // Meshes every face of m under o: discretize every edge once, mesh every
    // face, refine what face meshing asks for at most MaxRefinementRounds
    // times, assemble by numbering, validate at o.Level. Total.
    MeshModel(m: BrepModel, o: MeshingOptions): MeshOutcome
        => m.MeshChosenFaces(o, m.AllFaces);

    // Parses a STEP text, decodes it under o.Decode, and meshes the model,
    // keeping the decode for tracing. The parse and decode diagnostics come
    // first in the report, located; decoding goes on whatever the parse
    // found (layer 3: warn, never block), and an Error in either makes Ok
    // false. Total.
    MeshStepTextTraced(text: String, o: MeshingOptions): StepMeshOutcome
    {
        var parsed = text.ParseStep;
        var decoded = parsed.File.DecodeBrepWith(o.Decode);
        var meshed = decoded.Model.MeshModel(o);
        var report = ReportOf(parsed.Diagnostics).Merge(ReportOf(decoded.Diagnostics)).Located(Provenance.WholeInput).Merge(meshed.Report);
        return StepMeshOutcome(decoded, MeshOutcomeOf(meshed.Mesh, report, meshed.Rounds));
    }

    // Parses, decodes, and meshes a STEP text: MeshStepTextTraced without the
    // decode.
    MeshStepText(text: String, o: MeshingOptions): MeshOutcome
        => text.MeshStepTextTraced(o).Meshed;
}

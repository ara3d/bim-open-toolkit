//==
// # Face outcomes with the arena checked once per model (complexity sweep, chunk G2)
//
// FaceOutcome asks IsDiscretizedFace per face, and that scanned the geometry arena once per
// bound. FaceOutcomeInRange takes the scan's answer; FaceOutcomes (and InitialState and Step in
// pipeline.library.plato) scan once per pass and hand it to every face. FaceOutcomesCounted counts the arena
// scans its pass makes, as Flips, for the count witness in pipeline-guards.laws.plato.
//
// Sections, in order:
//  - One face
//  - Every face
//  - The refinement loop

library PipelineGuards
{
    //==
    // # One face

    // FaceOutcome with the arena check's answer given (arenaOk must be
    // m.Geometry.IsEveryIndexInRange): MeshFace when f is chosen and discretized, otherwise the
    // same unmeshed outcomes as FaceOutcome.
    FaceOutcomeInRange(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, o: MeshingOptions, chosen: Array<Boolean>, arenaOk: Boolean): FaceMeshOutcome
        => !chosen.IsChosen(f)
            ? f.UnmeshedOutcome("PIPELINE-FACE-EXCLUDED",
                "This face was left out of the run; it has no mesh.")
            : (m.IsDiscretizedFaceIn(f, d, arenaOk)
                ? m.MeshFace(f, d, o.Face)
                : f.UnmeshedOutcome("PIPELINE-FACE-UNDISCRETIZED",
                    "This face is not intact or cites an edge that has no discretization; it is not meshed."));

    //==
    // # Every face

    // Every face's outcome under d, in face order, with the arena scanned once.
    FaceOutcomes(m: BrepModel, d: EdgeDiscretizations, o: MeshingOptions, chosen: Array<Boolean>): Array<FaceMeshOutcome>
        => m.FaceOutcomesCounted(d, o, chosen).Value;

    // FaceOutcomes with its arena scans counted as Flips: exactly one, whatever the face count.
    FaceOutcomesCounted(m: BrepModel, d: EdgeDiscretizations, o: MeshingOptions, chosen: Array<Boolean>): Counted<Array<FaceMeshOutcome>>
    {
        var arenaOk = m.Geometry.IsEveryIndexInRange;
        var outcomes = m.Faces.Count.MapRange(k => m.FaceOutcomeInRange(BrepFaceIndex(k), d, o, chosen, arenaOk));
        return Counted(outcomes, Flips(1));
    }

    //==
    // # The refinement loop
}

//==
// # Laws of the face-mesh and model-mesh proofs (layer 6, and CheckedMesh)
//
// Two laws per proof type of 06-mesh/mesh-proofs.types.plato, as in
// 07-validation/validation-proofs-kernel.laws.plato. Face outcomes are the
// unit box's faces meshed by MeshFace under this layer's witness criteria,
// one of them knocked out; model meshes are layer 6's literal tetrahedron,
// its reversal, the tetrahedron with one face removed, and the unit box's
// pipeline mesh (WitnessMesh), which is why these laws are layer 8's; quads
// are one-quad face meshes built from the runner's Numbers.
//
// Sections, in order:
//  - Witnesses
//  - Face outcomes
//  - The model mesh
//  - Quads

library StepToMeshProofsMeshLaws
{
    //==
    // # Witnesses

    // The unit box, the model every mesh witness below is checked against.
    CatalogBox(_: BrepModel): BrepModel
        => BrepModel.WitnessAt(0);

    // The outcome MeshFace gives face f of the unit box under the witness
    // criteria.
    CatalogBoxOutcome(f: Integer): FaceMeshOutcome
        => BrepModel.CatalogBox.MeshFace(BrepFaceIndex(f), BrepModel.CatalogBox.CatalogTableOf, MeshingOptions.WitnessOptions.Face);

    // The unit box's face outcomes in face order, face j's replaced by an
    // unmeshed outcome when j names a face.
    CatalogBoxOutcomes(j: Integer): Array<FaceMeshOutcome>
        => BrepModel.CatalogBox.Faces.Count.MapRange(f => f == j
            ? UnmeshedOutcome(BrepFaceIndex(f), "CATALOG-KNOCKED-OUT", "This face's outcome was replaced by an unmeshed one.")
            : CatalogBoxOutcome(f));

    // Mesh k modulo 4: 0 the unit tetrahedron, 1 its reversal, 2 the
    // tetrahedron without its fourth face (open), 3 the unit box's
    // pipeline mesh.
    CatalogMeshAt(k: Integer): ModelMesh
    {
        var i = ((k % 4) + 4) % 4;
        return i == 0 ? ModelMesh.Witness_UnitTetrahedron
            : (i == 1 ? ModelMesh.Witness_UnitTetrahedron.Reversed
            : (i == 2 ? ModelMesh.Witness_UnitTetrahedron.RestrictedToFaces([BrepFaceIndex(0), BrepFaceIndex(1), BrepFaceIndex(2)])
            : BrepModel.CatalogBox.WitnessMesh));
    }

    // A face mesh of one quad on face 0, corners (0, 0, 0), (1, 0, 0),
    // (cx, cy, z), (0, 1, 0): planar when z is 0, convex when the third
    // corner keeps the turn at every corner positive.
    CatalogQuadMesh(cx: Number, cy: Number, z: Number): FaceMesh
    {
        var f = BrepFaceIndex(0);
        var up = Direction3D(Vector3D(0.0, 0.0, 1.0));
        var uvs = [UvCoordinate(0.0, 0.0), UvCoordinate(1.0, 0.0), UvCoordinate(cx, cy), UvCoordinate(0.0, 1.0)];
        return FaceMesh(f, uvs,
            [UvPointSource.Interior, UvPointSource.Interior, UvPointSource.Interior, UvPointSource.Interior],
            [VertexIndex(0), VertexIndex(1), VertexIndex(2), VertexIndex(3)],
            [Point3D(0.0, 0.0, 0.0), Point3D(1.0, 0.0, 0.0), Point3D(cx, cy, z), Point3D(0.0, 1.0, 0.0)],
            [up, up, up, up],
            [TriangleFace(VertexIndex(0), VertexIndex(1), VertexIndex(2))].Take(0),
            [QuadFace(VertexIndex(0), VertexIndex(1), VertexIndex(2), VertexIndex(3))],
            uvs.Map(uv => MeshVertexProvenance.OnFace(f, uv)));
    }

    // Face-meshing criteria with surface chordal c, from the witness ones.
    CatalogQuadCriteria(c: Number): FaceMeshingCriteria
        => CatalogQuadCriteriaHost(c);

    //==
    // # Face outcomes

    // The claim of Law_FullyMeshedModelKeepsOutcomes for the result
    // d of checking outcomes o.
    CatalogFullyMeshedKeeps(o: Array<FaceMeshOutcome>, d: DecidedFullyMeshedModel): Boolean
        => match (d) {
            Decided(p) => p.Outcomes.Count == o.Count && p.Model.Faces.Count == o.Count;
            Undecided(r) => true;
        };

    // The claim of Law_MeshedFaceSetPairsFaces for one result.
    CatalogMeshedFaceSetPairs(d: DecidedMeshedFaceSet): Boolean
        => match (d) {
            Decided(p) => p.Faces.Count == p.Outcomes.Count
                ? p.Faces.Count.Range.All(i => p.Outcomes[i].Mesh.Face == p.Faces[i])
                : false;
            Undecided(r) => true;
        };

    //==
    // # The model mesh

    // The claim of Law_WatertightMeshKeepsMesh for the result d of
    // checking mesh.
    CatalogWatertightKeeps(mesh: ModelMesh, d: DecidedWatertightMesh): Boolean
        => match (d) {
            Decided(p) => p.Mesh.ElementCount == mesh.ElementCount && p.Mesh.Positions.Count == mesh.Positions.Count;
            Undecided(r) => true;
        };

    // The claim of Law_CheckedMeshRecordsCounts for the result d of
    // checking mesh.
    CatalogCheckedMeshRecords(mesh: ModelMesh, d: DecidedCheckedMesh): Boolean
    {
        var expected = mesh.ComponentCountsOf(mesh.EdgeTableOf, mesh.ComponentsOf);
        return match (d) {
            Decided(p) => (p.Counts.Count == expected.Count && p.Counts.Count == mesh.ComponentsOf.ComponentCount)
                ? p.Counts.Count.Range.All(i => p.Counts[i] == expected[i])
                : false;
            Undecided(r) => true;
        };
    }

    // The claim of Law_QualityGradedMeshRecordsQualities at
    // triangle and quad j. Exact by construction: the same metric of the
    // same corners.
    CatalogQualityRecords(mesh: ModelMesh, j: Integer, d: DecidedQualityGradedMesh): Boolean
        => match (d) {
            Decided(p) => p.Triangles.Count == mesh.Triangles.Count
                && p.Quads.Count == mesh.Quads.Count
                && (p.Triangles.IsValidIndex(j) ? p.Triangles[j] == mesh.TriangleQualityAt(ElementIndex(j)) : true)
                && (p.Quads.IsValidIndex(j) ? p.Quads[j] == mesh.QuadQualityAt(ElementIndex(mesh.Triangles.Count + j)) : true);
            Undecided(r) => true;
        };

    //==
    // # Quads

    // CheckPlanarQuad succeeds exactly when the quad is measurable and its
    // warp is within the surface chordal.
    Law_PlanarQuadIffWarpWithinChordal(cx: Number, cy: Number, z: Number, c: Number): Boolean
        => CheckPlanarQuad(CatalogQuadMesh(cx, cy, z), FaceIndex(0), CatalogQuadCriteria(c)).IsDecided
            == (CatalogQuadMesh(cx, cy, z).IsMeasurableQuad(FaceIndex(0))
                ? CatalogQuadMesh(cx, cy, z).QuadWarp(FaceIndex(0)) <= c
                : false);

    // The unit square is planar under any positive chordal.
    Law_UnitSquareQuadIsPlanar(c: Number): Boolean
        => c > 0.0 ? CheckPlanarQuad(CatalogQuadMesh(1.0, 1.0, 0.0), FaceIndex(0), CatalogQuadCriteria(c)).IsDecided : true;

    // A PlanarQuad records the quad and its warp as its Deviation.
    Law_PlanarQuadRecordsWarp(cx: Number, cy: Number, z: Number, c: Number): Boolean
        => CatalogPlanarRecords(CatalogQuadMesh(cx, cy, z),
            CheckPlanarQuad(CatalogQuadMesh(cx, cy, z), FaceIndex(0), CatalogQuadCriteria(c)));

    // The claim of Law_PlanarQuadRecordsWarp for the result d of
    // checking quad 0 of fm.
    CatalogPlanarRecords(fm: FaceMesh, d: DecidedPlanarQuad): Boolean
        => match (d) {
            Decided(p) => p.Quad == fm.Quads[0] && p.Deviation.Value == fm.QuadWarp(FaceIndex(0));   // exact by construction
            Undecided(r) => true;
        };

    // CheckConvexQuad succeeds exactly when the quad is measurable and
    // strictly convex.
    Law_ConvexQuadIffConvex(cx: Number, cy: Number, z: Number): Boolean
        => CheckConvexQuad(CatalogQuadMesh(cx, cy, z), FaceIndex(0)).IsDecided
            == (CatalogQuadMesh(cx, cy, z).IsMeasurableQuad(FaceIndex(0))
                ? CatalogQuadMesh(cx, cy, z).IsConvexQuad(FaceIndex(0))
                : false);

    // A ConvexQuad records the quad it checked.
    Law_ConvexQuadRecordsQuad(cx: Number, cy: Number, z: Number): Boolean
        => CatalogConvexRecords(CatalogQuadMesh(cx, cy, z), CheckConvexQuad(CatalogQuadMesh(cx, cy, z), FaceIndex(0)));

    // The claim of Law_ConvexQuadRecordsQuad for the result d of
    // checking quad 0 of fm.
    CatalogConvexRecords(fm: FaceMesh, d: DecidedConvexQuad): Boolean
        => match (d) {
            Decided(p) => p.Quad == fm.Quads[0];
            Undecided(r) => true;
        };
}

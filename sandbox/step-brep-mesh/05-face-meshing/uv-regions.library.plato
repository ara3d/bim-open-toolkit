//==
// # Parameter-space regions
//
// The first half of layer 05: from a face's bounds to its oriented region in the surface's
// natural parameters, with the chart it is judged in. A body is given where the body is the
// definition (sample bookkeeping, the choice rules, signed areas, windings, distances, the
// requests); the algorithms (unwrapping, completing seams and poles, mean speeds, finding four
// sides) are deferred, with contracts in face-meshing.spec.plato.
//
// Sections, in order:
//  - Typed empty arrays
//  - Sources
//  - Samples of a coedge
//  - The projection-versus-pcurve rule
//  - Loops into parameter space
//  - The chart, tolerances, and signed areas
//  - Orientation and the region
//  - Periodic directions
//  - Seam uses and the left rule
//  - Collapsed lines
//  - Boundary segments, simplicity, containment
//  - Seam cuts
//  - Discretization segments
//  - Requests from the region
//  - Four-sided regions

library UvRegions
{
    //==
    // # Typed empty arrays
    //
    // `MapRange` over zero never evaluates its body; the body only fixes the element type (the
    // stdlib's `NoFaces` idiom).

    // No samples.
    NoSamples(_: UvSample): Array<UvSample>
        => 0.MapRange(i => UvSample(UvCoordinate(0.0, 0.0), UvPointSource.Interior));

    // No edges.
    NoEdges(_: BrepEdgeIndex): Array<BrepEdgeIndex>
        => 0.MapRange(i => BrepEdgeIndex(i));

    // No refinement requests.
    NoRequests(_: EdgeRefinementRequest): Array<EdgeRefinementRequest>
        => 0.MapRange(i => EdgeRefinementRequest(BrepEdgeIndex(i), RefinementReason.LoopSelfIntersects, 0.0, 0));

    //==
    // # Sources

    // True when s is the model vertex v.
    IsVertexSource(s: UvPointSource, v: BrepVertexIndex): Boolean
        => match (s) {
            FromVertex(w) => w == v;
            FromEdge(e, k) => false;
            SeamCut(side, k) => false;
            Pole(side, k) => false;
            Interior => false;
        };

    // True when s is sample k of edge e.
    IsEdgeSample(s: UvPointSource, e: BrepEdgeIndex, k: Integer): Boolean
        => match (s) {
            FromVertex(w) => false;
            FromEdge(e2, k2) => e2 == e && k2 == k;
            SeamCut(side, j) => false;
            Pole(side, j) => false;
            Interior => false;
        };

    // True when s is some interior sample of edge e.
    IsSampleOfEdge(s: UvPointSource, e: BrepEdgeIndex): Boolean
        => match (s) {
            FromVertex(w) => false;
            FromEdge(e2, k) => e2 == e;
            SeamCut(side, k) => false;
            Pole(side, k) => false;
            Interior => false;
        };

    // The discretization index of an edge sample; -1 for every other source.
    SampleIndex(s: UvPointSource): Integer
        => match (s) {
            FromVertex(w) => -1;
            FromEdge(e, k) => k;
            SeamCut(side, k) => -1;
            Pole(side, k) => -1;
            Interior => -1;
        };

    // True when s is point k of a copy of the seam cut across the same direction as `side`:
    // UMin and UMax are the two copies of one cut, VMin and VMax of another.
    IsSeamCutPoint(s: UvPointSource, side: DomainSide, k: Integer): Boolean
        => match (s) {
            FromVertex(w) => false;
            FromEdge(e, j) => false;
            SeamCut(side2, k2) => k2 == k && side2.IsUSide == side.IsUSide;
            Pole(side2, j) => false;
            Interior => false;
        };

    // True when s is a point of the pole segment along `side`.
    IsPoleOn(s: UvPointSource, side: DomainSide): Boolean
        => match (s) {
            FromVertex(w) => false;
            FromEdge(e, k) => false;
            SeamCut(side2, k) => false;
            Pole(side2, k) => side2 == side;
            Interior => false;
        };

    // True when s is a point of a pole segment at a pole that is not a model vertex.
    IsPolePoint(s: UvPointSource): Boolean
        => match (s) {
            FromVertex(w) => false;
            FromEdge(e, k) => false;
            SeamCut(side, k) => false;
            Pole(side, k) => true;
            Interior => false;
        };

    // True when two parameter-space points with sources a and b are one 3D vertex: the same model
    // vertex; the same edge sample (the two copies of a seam-edge sample); the same index on the
    // two copies of one synthetic seam cut; or two points of one pole segment at a pole that is
    // not a model vertex. An interior point is identified with no other point.
    IdentifiedSources(a: UvPointSource, b: UvPointSource): Boolean
        => match (a) {
            FromVertex(v) => b.IsVertexSource(v);
            FromEdge(e, k) => b.IsEdgeSample(e, k);
            SeamCut(side, k) => b.IsSeamCutPoint(side, k);
            Pole(side, k) => b.IsPoleOn(side);
            Interior => false;
        };

    //==
    // # Samples of a coedge
    //
    // A coedge's samples are its edge's discretization points, visited forwards when the coedge
    // runs forward on its curve (layer 02's composed sense) and backwards otherwise. A coedge
    // contributes its start vertex and its interior samples; its end vertex is the next coedge's
    // start. A coedge whose discretization has n points therefore contributes exactly n - 1.

    // Face f's surface.
    SurfaceOf(m: BrepModel, f: BrepFaceIndex): SurfaceIndex
        => m.Faces[f].Surface;

    // Face f's surface domain.
    SurfaceDomainOf(m: BrepModel, f: BrepFaceIndex): SurfaceDomain
        => m.Geometry.Domain(m.SurfaceOf(f));

    // The coedges of an edge loop in the order the face traverses them: as stored when the
    // bound's Orientation is true, reversed otherwise.
    TraversedCoedges(coedges: Array<Coedge>, b: FaceBound): Array<Coedge>
        => b.Orientation ? coedges : coedges.Count.MapRange(i => coedges[coedges.Count - 1 - i]);

    // The discretization sample visited at step j (0 <= j < n) of a coedge over n samples.
    SampleAtStep(forward: Boolean, n: Integer, j: Integer): Integer
        => forward ? j : n - 1 - j;

    // The source of sample k of edge e, whose discretization has n samples: the vertex at either
    // end (discretizations run in increasing curve parameter, so sample 0 is the vertex met first
    // along the curve), the edge sample between.
    SampleSource(m: BrepModel, e: BrepEdgeIndex, n: Integer, k: Integer): UvPointSource
        => k == 0
            ? UvPointSource.FromVertex(m.FirstVertexAlongCurve(e))
            : (k == n - 1 ? UvPointSource.FromVertex(m.LastVertexAlongCurve(e)) : UvPointSource.FromEdge(e, k));

    // The samples coedge c contributes to bound b of face f, in traversal order: n - 1 of them
    // for a discretization of n points. Precondition: n >= 2.
    CoedgeSamples(m: BrepModel, f: BrepFaceIndex, b: FaceBound, c: Coedge, d: EdgeDiscretizations): Array<UvSample>
    {
        var points = d.ByEdge[c.Edge].Points;
        var n = points.Count;
        var forward = m.CoedgeRunsForwardOnCurve(b, c);
        var uvs = m.ImagePoints(d.ByEdge[c.Edge], m.ImageInFace(f, c.Edge));
        return (n - 1).MapRange(j => UvSample(
            uvs[SampleAtStep(forward, n, j)],
            m.SampleSource(c.Edge, n, SampleAtStep(forward, n, j))));
    }

    //==
    // # The projection-versus-pcurve rule
    //
    // Most STEP files carry no pcurves (research/STEP-BREP-MODEL.md section 6.4), so projection is
    // the main path. A pcurve is used only when it is unambiguous: the edge's curve carries
    // exactly one pcurve on the face's surface (layer 02's PcurvesOnFace), and the edge is not a
    // seam of the face. A seam's two pcurves lie on one surface and the file does not say which
    // use takes which; the seam is projected, and Unwrap assigns its two uses to the two copies
    // by the left rule (section "Seam uses and the left rule").
    // The points themselves come from layer 04's ImagePoints, the one image function: the image
    // layer 04 certifies (its image-chord criterion) is then the polygon this layer triangulates
    // (review C5). On a pcurve image ImagePoints takes the pcurve's own nearest parameter (layer
    // 01's ClosestParameter on the pcurve lifted through its surface), robust where surface
    // projection is not; otherwise it projects. Law_PcurveAgreesWithProjection checks a pcurve
    // against the projection wherever the rule reads the pcurve.

    // The image of edge e that face f draws its loops with: its one pcurve on f's surface when
    // the edge's curve carries exactly one and e is not a seam of f; otherwise the projection
    // image (Pcurve none).
    ImageInFace(m: BrepModel, f: BrepFaceIndex, e: BrepEdgeIndex): EdgeImage
    {
        var onFace = m.PcurvesOnFace(e, f);
        return EdgeImage(f, (onFace.Count == 1 && m.IsSeamEdgeOf(f, e).Not) ? onFace[0] : PcurveIndex(-1));
    }

    //==
    // # Loops into parameter space

    // The bound's loop in face f's natural parameters, before unwrapping. An edge loop gives its
    // coedges' samples in traversal order; a vertex loop gives its vertex, projected; a poly loop
    // gives nothing (version 1 does not mesh poly loops, and MeshFace diagnoses them).
    LoopToUv(m: BrepModel, f: BrepFaceIndex, b: FaceBound, d: EdgeDiscretizations): UvLoop
        => m.SamplesOfLoop(f, b, d, m.Loops[b.Loop]).ToUvLoop;

    // The samples of `loop`, which is bound b's loop.
    SamplesOfLoop(m: BrepModel, f: BrepFaceIndex, b: FaceBound, d: EdgeDiscretizations, loop: BrepLoop): Array<UvSample>
        => match (loop) {
            EdgeLoop(coedges) => coedges.TraversedCoedges(b).FlatMap(c => m.CoedgeSamples(f, b, c, d));
            VertexLoop(v) => [UvSample(m.Geometry.Project(m.SurfaceOf(f), m.Vertices[v].Point), UvPointSource.FromVertex(v))];
            PolyLoop(points) => UvSample.NoSamples;
        };

    // The loop made of the samples, in order.
    ToUvLoop(samples: Array<UvSample>): UvLoop
        => UvLoop(samples.Map(s => s.Point), samples.Map(s => s.Source));

    // The number of points LoopToUv gives for bound b: over the coedges of an edge loop, the sum
    // of each edge's discretization count minus one; one for a vertex loop; none for a poly loop.
    ExpectedLoopPointCount(m: BrepModel, b: FaceBound, d: EdgeDiscretizations): Integer
        => m.LoopCoedges(b.Loop).Reduce(m.Loops[b.Loop].VertexLoopVertexOf.Count,
            (total, c) => total + d.ByEdge[c.Edge].Points.Count - 1);

    // True when some bound of face f is a poly loop.
    HasPolyLoop(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.Faces[f].Bounds.Any(b => m.Loops[b.Loop].IsPolyLoop);

    // The coedges of face f's edge loops, in bound order.
    FaceCoedges(m: BrepModel, f: BrepFaceIndex): Array<Coedge>
        => m.Faces[f].Bounds.FlatMap(b => m.LoopCoedges(b.Loop));

    // The edges face f cites, each once, in order of first citation.
    FaceEdges(m: BrepModel, f: BrepFaceIndex): Array<BrepEdgeIndex>
    {
        var cs = m.FaceCoedges(f);
        return cs.Count.Range.FlatMap(i =>
            cs.Take(i).Any(c => c.Edge == cs[i].Edge) ? BrepEdgeIndex.NoEdges : [cs[i].Edge]);
    }

    // Chunk A body, from the contract Unwrap and its deferred note: one scan.
    // The first point is wrapped into the domain's window (layer 0's Wrap). A
    // point that starts a step of a seam use whose twin step is already
    // placed takes the copy of the twin's end, a whole period away, for which
    // that twin copy lies to the left of the step (FollowsLeftRule's test);
    // every other point takes its copy nearest its predecessor
    // (NearestUnwrapped). A point on a collapsed line takes the free
    // parameter from its predecessor, or from its successor when it is first.
    Unwrap(m: BrepModel, f: BrepFaceIndex, l: UvLoop): UvLoop
    {
        var dom = m.SurfaceDomainOf(f);
        var n = l.Points.Count;
        var placed = new List<UvCoordinate>();
        var i = 0;
        while (i < n)
        {
            var raw = m.WithPoleFreeParameter(f, l, i);
            var continued = i == 0 ? dom.Wrap(raw) : dom.NearestUnwrapped(raw, placed.At(i - 1));
            var twin = i == 0 ? -1 : m.PlacedTwinStep(f, l, i);
            var point = twin < 0 ? continued : m.LeftRuleCopy(f, dom, l, i, placed.At(twin + 1), continued);
            placed = placed.Add(point);
            i = i + 1;
        }
        return UvLoop(placed.Freeze(), l.Sources);
    }

    // Point i of loop l, with its free parameter taken from its predecessor
    // (its successor for the first point) when it lies on a collapsed line of
    // face f's surface: the parameter along the line, which Project leaves
    // arbitrary there. Unchanged otherwise.
    WithPoleFreeParameter(m: BrepModel, f: BrepFaceIndex, l: UvLoop, i: Integer): UvCoordinate
    {
        var uv = l.Points[i];
        var neighbour = l.Points.AtModulo(i == 0 ? 1 : i - 1);
        var onU = m.IsOnCollapsedLineAlong(f, uv, SurfaceParameter.ParameterU);
        var onV = m.IsOnCollapsedLineAlong(f, uv, SurfaceParameter.ParameterV);
        return onV ? UvCoordinate(neighbour.U, uv.V) : (onU ? UvCoordinate(uv.U, neighbour.V) : uv);
    }

    // The step j < i - 1 of loop l that is the twin of step i (AreTwinSteps
    // along a seam of face f): its two ends are already placed. -1 when there
    // is none.
    PlacedTwinStep(m: BrepModel, f: BrepFaceIndex, l: UvLoop, i: Integer): Integer
        => (i - 1).Range.Reduce(-1, (found, j) =>
            found >= 0 ? found : (m.FaceEdges(f).Any(e => m.AreTwinSteps(f, e, l, i, j)) ? j : -1));

    // The copy of point i under the left rule: among the copies of the twin
    // end a whole period away in each periodic direction, the first that has
    // the twin end strictly to the left of the step to its successor (that
    // successor unwrapped next to the copy); the continued copy when none
    // has, or when either lies on a collapsed line (the rule's exemption).
    LeftRuleCopy(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, l: UvLoop, i: Integer, twinEnd: UvCoordinate, continued: UvCoordinate): UvCoordinate
    {
        var pu = dom.U.Periodicity.PeriodOr(0.0);
        var pv = dom.V.Periodicity.PeriodOr(0.0);
        var alongU = pu > 0.0 ? [UvCoordinate(twinEnd.U + pu, twinEnd.V), UvCoordinate(twinEnd.U - pu, twinEnd.V)] : [twinEnd].Take(0);
        var alongV = pv > 0.0 ? [UvCoordinate(twinEnd.U, twinEnd.V + pv), UvCoordinate(twinEnd.U, twinEnd.V - pv)] : [twinEnd].Take(0);
        var candidates = alongU.Concatenate(alongV);
        var exempt = m.IsOnCollapsedLine(f, twinEnd) || m.IsOnCollapsedLine(f, continued);
        var good = candidates.FlatMap(c =>
            m.IsLeftOfStep(f, c, dom.NearestUnwrapped(l.Points.AtModulo(i + 1), c), twinEnd) ? [c] : candidates.Take(0));
        return (exempt || good.Count == 0) ? continued : good[0];
    }

    // Chunk A body, from the contract AddMissingSeamsAndPoles, for a face
    // whose surface has no periodic or closed direction and no collapsed line
    // (planes; the unbounded directions of extrusions): there is no seam to
    // cut and no pole to expand, so the region is the loops as they are, the
    // outer chosen by containment whatever the file marks (OuterByContainment).
    // Every other face goes to CompletePeriodicRegion, which keeps the rest of
    // the deferred algorithm (chunks B and C).
    AddMissingSeamsAndPoles(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): UvRegion
        => m.IsPlainSurfaceOf(f)
            ? loops.OuterByContainment
            : m.CompletePeriodicRegion(f, loops, c);

    // Whether face f's surface has no direction with a seam (Periodic or
    // Closed) and no collapsed line.
    IsPlainSurfaceOf(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.SurfaceDomainOf(f).U.HasSeam.Not
            && m.SurfaceDomainOf(f).V.HasSeam.Not
            && m.HasCollapsedLine(f).Not;

    // Whether face f's surface collapses some iso-line to a point (a pole or an apex).
    HasCollapsedLine(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.CollapsedLines(f, SurfaceParameter.ParameterU).Count > 0
            || m.CollapsedLines(f, SurfaceParameter.ParameterV).Count > 0;

    // The region of the loops with the first loop that contains every other
    // loop's first point (even-odd) as the outer, the rest as holes in their
    // order; the first loop when none contains the others. An empty region
    // for no loops.
    OuterByContainment(loops: Array<UvLoop>): UvRegion
    {
        var outer = loops.Count.Range.Reduce(-1, (found, k) =>
            found >= 0 ? found : (loops.ContainsOtherLoops(k) ? k : -1));
        var chosen = outer < 0 ? 0 : outer;
        return loops.Count == 0
            ? UvRegion(UvLoop([], []), [])
            : UvRegion(loops[chosen], loops.Count.Range.FlatMap(k => k == chosen ? loops.Take(0) : [loops[k]]));
    }

    // Whether loop k contains the first point of every other non-empty loop.
    ContainsOtherLoops(loops: Array<UvLoop>, k: Integer): Boolean
        => loops.Count.Range.All(j => (j == k ? true : loops[j].Points.Count == 0)
            ? true
            : loops[k].LoopContains(loops[j].Points[0]));

    // Chunk B body, from the contract AddMissingSeamsAndPoles beyond the
    // plain case, for a face whose surface has a seam or a collapsed line, in
    // three steps: every pole expanded into its segment (WithPoleSegments,
    // chunk C); the two loops that wind the opposite way round one periodic
    // direction joined by a synthetic seam cut (WithSeamCut: a cylinder band
    // between two circles); the loop of largest area taken as the outer and
    // every other loop moved by whole periods inside it (OuterByArea). A loop
    // that closes in the plane, such as a seamed cylinder's, passes through
    // the first two steps unchanged.
    CompletePeriodicRegion(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): UvRegion
        => m.OuterByArea(f, m.WithSeamCut(f, m.WithPoleSegments(f, loops, c), c));

    // The loops with every pole expanded into its pole segment: unchanged on a
    // surface that collapses no iso-line.
    WithPoleSegments(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): Array<UvLoop>
        => m.HasCollapsedLine(f) ? m.ExpandedPoles(f, loops, c) : loops;

    // deferred (chunk C): the pole segments of the contract: a loop point on a
    // collapsed line replaced by the segment of that line from the free
    // parameter where the loop arrives to the one where it leaves, its points
    // Pole sources (or the pole vertex's) sampled under the criteria; a face
    // with no edges at a pole given the whole segment.
    ExpandedPoles(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): Array<UvLoop>;

    // How far one traversal of loop l moves it in face f's parameter plane:
    // its winding times the period, in each direction.
    LoopDisplacement(m: BrepModel, f: BrepFaceIndex, l: UvLoop): UvCoordinate
        => UvCoordinate(
            m.UWinding(f, l).ToNumber * m.SurfaceDomainOf(f).U.Periodicity.PeriodOr(0.0),
            m.VWinding(f, l).ToNumber * m.SurfaceDomainOf(f).V.Periodicity.PeriodOr(0.0));

    // Whether loop l winds round some periodic direction of face f.
    IsWindingLoop(m: BrepModel, f: BrepFaceIndex, l: UvLoop): Boolean
        => m.UWinding(f, l) != 0 || m.VWinding(f, l) != 0;

    // The parameters uv moved by `by`.
    ShiftedBy(uv: UvCoordinate, by: UvCoordinate): UvCoordinate
        => UvCoordinate(uv.U + by.U, uv.V + by.V);

    // Loop l moved by `by`, sources unchanged.
    ShiftedLoop(l: UvLoop, by: UvCoordinate): UvLoop
        => UvLoop(l.Points.Map(p => p.ShiftedBy(by)), l.Sources);

    // Loop l traversed from position i, continued past its last point by the
    // displacement d of one traversal, so the result runs as continuously as
    // l and ends one closing step before l.Points[i] moved by d.
    RotatedFrom(l: UvLoop, i: Integer, d: UvCoordinate): UvLoop
        => UvLoop(
            l.Points.Count.MapRange(t => i + t < l.Points.Count ? l.Points[i + t] : l.Points[i + t - l.Points.Count].ShiftedBy(d)),
            l.Sources.Count.MapRange(t => l.Sources[(i + t) % l.Sources.Count]));

    // The positions in `loops` of the loops that wind.
    WindingLoops(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>): Array<Integer>
        => loops.Count.Range.FlatMap(k => m.IsWindingLoop(f, loops[k]) ? [k] : loops.Count.Range.Take(0));

    // Whether exactly two loops wind, once each round one direction and the
    // opposite way: the two boundary circles of a band.
    IsBandPair(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, winding: Array<Integer>): Boolean
        => winding.Count == 2
            && m.UWinding(f, loops[winding[0]]).Abs + m.VWinding(f, loops[winding[0]]).Abs == 1
            && m.UWinding(f, loops[winding[0]]) + m.UWinding(f, loops[winding[1]]) == 0
            && m.VWinding(f, loops[winding[0]]) + m.VWinding(f, loops[winding[1]]) == 0;

    // The loops with the band pair, when there is one, replaced by one loop
    // joined along a synthetic seam cut (JoinedByCut), first; unchanged when
    // no loop winds. Every other arrangement of winding loops (a whole torus,
    // several bands) goes to CutWholePeriods.
    WithSeamCut(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): Array<UvLoop>
    {
        var winding = m.WindingLoops(f, loops);
        var others = loops.Count.Range.FlatMap(k => winding.Any(w => w == k) ? loops.Take(0) : [loops[k]]);
        return winding.Count == 0
            ? loops
            : (m.IsBandPair(f, loops, winding)
                ? [m.JoinedByCut(f, loops[winding[0]], loops[winding[1]], c)].Concatenate(others)
                : m.CutWholePeriods(f, loops, c));
    }

    // deferred (chunk C): the synthetic cuts of the other arrangements of
    // winding loops: a whole-period region with no loop (a whole torus, two
    // cuts), and loops that wind round both directions.
    CutWholePeriods(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): Array<UvLoop>;

    // The pair of positions (i in a, j in b), coded i * b.Count + j, whose
    // surface points are nearest in 3D: where the cut between the two loops
    // is shortest.
    NearestPair(m: BrepModel, f: BrepFaceIndex, a: UvLoop, b: UvLoop): Integer
    {
        var s = m.SurfaceOf(f);
        var pa = a.Points.Map(uv => m.Geometry.Eval(s, uv));
        var pb = b.Points.Map(uv => m.Geometry.Eval(s, uv));
        var nb = b.Points.Count;
        return (a.Points.Count * nb).Range.Reduce(0, (best, k) =>
            pa[k / nb].Distance(pb[k % nb]) < pa[best / nb].Distance(pb[best % nb]) ? k : best);
    }

    // The two winding loops a and b of a band pair as one loop that closes in
    // the plane. The cut runs straight in parameters from a's point `start`
    // to the copy `end` of b's point nearest it (NearestPair); its interior
    // points split it into CutSegmentCount equal steps. The loop is: a from
    // start round to its continued copy start + D (D = a's displacement);
    // the far copy of the cut, its points SeamCut(far side, k) for k up; b
    // from end + D round to end; the near copy of the cut back to start, its
    // points SeamCut(near side, k) for k down. The two copies of the cut are
    // one period apart and run in opposite orders, start and its copy share
    // a's source, end and its copy b's, so Lift identifies each pair. The far
    // side is the domain side the displacement points to.
    JoinedByCut(m: BrepModel, f: BrepFaceIndex, a: UvLoop, b: UvLoop, c: FaceMeshingCriteria): UvLoop
    {
        var pair = m.NearestPair(f, a, b);
        var i = pair / b.Points.Count;
        var j = pair % b.Points.Count;
        var d = m.LoopDisplacement(f, a);
        var start = a.Points[i];
        var end = m.SurfaceDomainOf(f).NearestUnwrapped(b.Points[j], start);
        var n = m.CutSegmentCount(f, start, end, c);
        var far = d.U != 0.0 ? (d.U > 0.0 ? DomainSide.UMax : DomainSide.UMin) : (d.V > 0.0 ? DomainSide.VMax : DomainSide.VMin);
        var cut = (n - 1).MapRange(k => start.CutPoint(end, n, k + 1));
        var ra = a.RotatedFrom(i, d);
        var rb = b.RotatedFrom(j, m.LoopDisplacement(f, b)).ShiftedLoop(UvCoordinate(end.U + d.U - b.Points[j].U, end.V + d.V - b.Points[j].V));
        return UvLoop(
            ra.Points
                .Concatenate([start.ShiftedBy(d)])
                .Concatenate(cut.Map(p => p.ShiftedBy(d)))
                .Concatenate(rb.Points)
                .Concatenate([end])
                .Concatenate((n - 1).MapRange(k => cut[n - 2 - k])),
            ra.Sources
                .Concatenate([a.Sources[i]])
                .Concatenate((n - 1).MapRange(k => UvPointSource.SeamCut(far, k + 1)))
                .Concatenate(rb.Sources)
                .Concatenate([b.Sources[j]])
                .Concatenate((n - 1).MapRange(k => UvPointSource.SeamCut(far.OppositeSide, n - 1 - k))));
    }

    // Point k of n equal steps from a to b in parameters.
    CutPoint(a: UvCoordinate, b: UvCoordinate, n: Integer, k: Integer): UvCoordinate
        => UvCoordinate(a.U + (b.U - a.U) * k.ToNumber / n.ToNumber, a.V + (b.V - a.V) * k.ToNumber / n.ToNumber);

    // The number of equal parameter steps a synthetic cut from a to b on face
    // f is sampled with, under the criteria: the least n (at most 64) for
    // which every step meets CutStepMeetsCriteria, or the last n whose
    // shortest step is at least the effective minimum length. Cut points are
    // boundary points, so refinement can add none later: this is their one
    // sampling (the reason RegionOf takes the criteria).
    CutSegmentCount(m: BrepModel, f: BrepFaceIndex, a: UvCoordinate, b: UvCoordinate, c: FaceMeshingCriteria): Integer
    {
        var n = 1;
        while (n < 64 && m.CutStepsMeetCriteria(f, a, b, n, c).Not && m.ShortestCutStep(f, a, b, n + 1) >= c.Discretization.EffectiveMinLength(m.Tolerances))
        {
            n = n + 1;
        }
        return n;
    }

    // Whether every one of the n equal steps from a to b meets the criteria.
    CutStepsMeetCriteria(m: BrepModel, f: BrepFaceIndex, a: UvCoordinate, b: UvCoordinate, n: Integer, c: FaceMeshingCriteria): Boolean
        => n.Range.All(k => m.CutStepMeetsCriteria(f, a.CutPoint(b, n, k), a.CutPoint(b, n, k + 1), c));

    // Whether the cut step from p to q meets what a model edge's segment
    // would: its parameter midpoint's surface point within SurfaceChordal of
    // its 3D chord's midpoint, the face normal turning by at most
    // SurfaceAngular along it, and its chord within the length limit.
    CutStepMeetsCriteria(m: BrepModel, f: BrepFaceIndex, p: UvCoordinate, q: UvCoordinate, c: FaceMeshingCriteria): Boolean
    {
        var s = m.SurfaceOf(f);
        var a = m.Geometry.Eval(s, p);
        var b = m.Geometry.Eval(s, q);
        var middle = m.Geometry.Eval(s, p.UvMidpoint(q));
        var turn = m.FaceNormalAt(f, p, Vector3D.UnitZ).AngleBetween(m.FaceNormalAt(f, q, Vector3D.UnitZ));
        return middle.Distance(a.HalfwayPoint(b)) <= c.SurfaceChordal
            && turn.Radians <= c.SurfaceAngular.Radians
            && a.Distance(b).IsWithinLimit(c.Discretization.MaxLength);
    }

    // The shortest 3D chord of the n equal steps from a to b.
    ShortestCutStep(m: BrepModel, f: BrepFaceIndex, a: UvCoordinate, b: UvCoordinate, n: Integer): Number
        => n.Range.Reduce(Number.MaxValue, (shortest, k) => shortest.Min(
            m.Geometry.Eval(m.SurfaceOf(f), a.CutPoint(b, n, k)).Distance(m.Geometry.Eval(m.SurfaceOf(f), a.CutPoint(b, n, k + 1)))));

    // The region of the loops: the loop of largest absolute area in natural
    // parameters is the outer, every other a hole moved by whole periods so
    // that it lies inside the outer (ShiftedInside). An empty region for no
    // loops.
    OuterByArea(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>): UvRegion
    {
        var areas = loops.Map(l => l.Points.Map(p => p.ToPoint2D).ShoelaceArea.Abs);
        var outer = loops.Count.Range.Reduce(0, (best, k) => areas[k] > areas[best] ? k : best);
        return loops.Count == 0
            ? UvRegion(UvLoop([], []), [])
            : UvRegion(loops[outer], loops.Count.Range.FlatMap(k =>
                k == outer ? loops.Take(0) : [m.ShiftedInside(f, loops[outer], loops[k])]));
    }

    // Hole h moved by the first whole-period shift (none, then one period
    // either way in u, in v, and in both) that puts its first point inside
    // the outer loop; unchanged when none does.
    ShiftedInside(m: BrepModel, f: BrepFaceIndex, outer: UvLoop, h: UvLoop): UvLoop
    {
        var pu = m.SurfaceDomainOf(f).U.Periodicity.PeriodOr(0.0);
        var pv = m.SurfaceDomainOf(f).V.Periodicity.PeriodOr(0.0);
        var shifts = 9.MapRange(k => UvCoordinate(pu * ((k % 3 + 1) % 3 - 1).ToNumber, pv * ((k / 3 + 1) % 3 - 1).ToNumber));
        var fits = h.Points.Count == 0 ? shifts.Take(0) : shifts.FlatMap(s => outer.LoopContains(h.Points[0].ShiftedBy(s)) ? [s] : shifts.Take(0));
        return fits.Count == 0 ? h : h.ShiftedLoop(fits[0]);
    }

    //==
    // # The chart, tolerances, and signed areas
    //
    // Orientation is decided in the chart (u, v) -> (s u, v), s = layer 02's FaceNormalSign: the
    // sign of the face normal against PartialU x PartialV (SameSense composed with the surface's
    // NormalAgreesWithParameterization). So a triangle counter-clockwise in this chart lifts to
    // one counter-clockwise about the face normal. Anisotropy is met by the chart's scales, the
    // face's mean surface speeds: chart lengths approximate lengths on the surface, so the
    // triangulator's Delaunay decisions and the region's tolerance are made in near-3D units.

    // True when face f's chart negates u: exactly when the face normal points against
    // PartialU x PartialV.
    IsChartMirrored(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.FaceNormalSign(f) < 0;

    // Face f's chart for region r: mirrored by FaceNormalSign, scaled by the mean speeds.
    ChartOf(m: BrepModel, f: BrepFaceIndex, r: UvRegion): FaceChart
        => FaceChart(m.IsChartMirrored(f), m.MeanSpeed(f, r, SurfaceParameter.ParameterU), m.MeanSpeed(f, r, SurfaceParameter.ParameterV));

    // Chunk A body, from the contract MeanSpeed: the mean of |PartialU|
    // (ParameterU) or |PartialV| at twenty-one points along each of three
    // iso-lines across the region's parameter box (its quarter, half and
    // three-quarter lines in the other parameter), samples on a collapsed
    // line skipped, never below the length tolerance over the box's extent in
    // that parameter (so a box of zero extent gives a finite positive speed).
    MeanSpeed(m: BrepModel, f: BrepFaceIndex, r: UvRegion, which: SurfaceParameter): Number
    {
        var points = r.BoundaryPoints;
        var lo = points.Reduce(UvCoordinate(Number.MaxValue, Number.MaxValue), (a, p) => UvCoordinate(a.U.Min(p.U), a.V.Min(p.V)));
        var hi = points.Reduce(UvCoordinate(0.0 - Number.MaxValue, 0.0 - Number.MaxValue), (a, p) => UvCoordinate(a.U.Max(p.U), a.V.Max(p.V)));
        var s = m.SurfaceOf(f);
        var samples = 63.MapRange(k => UvCoordinate(
            lo.U + (hi.U - lo.U) * which.Along((k % 21).ToNumber / 20.0, (k / 21 + 1).ToNumber * 0.25),
            lo.V + (hi.V - lo.V) * which.Along((k / 21 + 1).ToNumber * 0.25, (k % 21).ToNumber / 20.0)));
        var kept = samples.FlatMap(uv => m.IsOnCollapsedLine(f, uv) ? samples.Take(0) : [uv]);
        var speeds = kept.Map(uv => which.Along(m.Geometry.PartialU(s, uv).Length, m.Geometry.PartialV(s, uv).Length));
        var extent = which.Along(hi.U - lo.U, hi.V - lo.V);
        var floor = points.Count == 0 ? 1.0 : (extent > 0.0 ? m.Tolerances.Length.Value / extent : 1.0);
        var mean = speeds.Count == 0 ? 0.0 : speeds.SumOf / speeds.Count.ToNumber;
        return mean.IsFinite ? mean.Max(floor) : floor;
    }

    // The parameter tolerance of face f's region: layer 00's UvToleranceAt at the chart's mean
    // speeds, so a boundary displacement within it moves the surface point by about the length
    // tolerance, never below the floor of each direction's kind (layer 01's UvFloorOf: the angle
    // floor for an angle parameter, the length floor otherwise).
    RegionTolerance(m: BrepModel, f: BrepFaceIndex, chart: FaceChart): UvTolerance
        => m.Tolerances.UvToleranceAt(m.Geometry.UvFloorOf(m.SurfaceOf(f), m.Tolerances),
            chart.ScaleU, chart.ScaleV, m.SurfaceDomainOf(f));

    // The parameter tolerance at the point uv of face f's surface (layer 01's UvToleranceAt).
    PointTolerance(m: BrepModel, f: BrepFaceIndex, uv: UvCoordinate): UvTolerance
        => m.Geometry.UvToleranceAt(m.SurfaceOf(f), uv, m.Tolerances);

    // The natural parameters as a stdlib plane point, coordinates unchanged.
    ToPoint2D(uv: UvCoordinate): Point2D
        => Point2D(uv.U, uv.V);

    // The parameters measured in tolerance units: each divided by its direction's tolerance, so
    // a distance of one is the tolerance.
    InToleranceUnits(uv: UvCoordinate, tol: UvTolerance): Point2D
        => Point2D(uv.U / tol.U.Value, uv.V / tol.V.Value);

    // The parameters in the orientation of the chart: u negated when the chart is mirrored.
    OrientedPoint(uv: UvCoordinate, mirrored: Boolean): Point2D
        => mirrored ? Point2D(-uv.U, uv.V) : Point2D(uv.U, uv.V);

    // The parameters in a face chart, scales included: where the triangulator works.
    ChartPoint(chart: FaceChart, uv: UvCoordinate): Point2D
        => Point2D((chart.Mirrored ? -chart.ScaleU : chart.ScaleU) * uv.U, chart.ScaleV * uv.V);

    // The midpoint of two parameter points.
    UvMidpoint(a: UvCoordinate, b: UvCoordinate): UvCoordinate
        => UvCoordinate((a.U + b.U) * 0.5, (a.V + b.V) * 0.5);

    // The signed area of the closed loop in the oriented chart, in natural units: positive when
    // the loop runs counter-clockwise there.
    ChartSignedArea(l: UvLoop, mirrored: Boolean): Number
        => l.Points.Map(p => p.OrientedPoint(mirrored)).ShoelaceArea;

    // The signed area of the region in the oriented chart: the outer loop's plus every hole's.
    ChartSignedArea(r: UvRegion, mirrored: Boolean): Number
        => r.Outer.ChartSignedArea(mirrored) + SumOf(r.Holes.Map(h => h.ChartSignedArea(mirrored)));

    // The most the loop's signed area can change when each of its points moves within the
    // tolerance: a segment (du, dv) whose ends move by at most (tu, tv) sweeps at most
    // |du| tv + |dv| tu.
    AreaTolerance(l: UvLoop, tol: UvTolerance): Number
        => SumOf(l.Points.Count.MapRange(i =>
            (l.Points.AtModulo(i + 1).U - l.Points[i].U).Abs * tol.V.Value
            + (l.Points.AtModulo(i + 1).V - l.Points[i].V).Abs * tol.U.Value));

    // The most the region's signed area can change when its boundary points move within the
    // tolerance: the loops' area tolerances added.
    AreaTolerance(r: UvRegion, tol: UvTolerance): Number
        => r.Outer.AreaTolerance(tol) + SumOf(r.Holes.Map(h => h.AreaTolerance(tol)));

    //==
    // # Orientation and the region

    // The loop traversed so that its signed area in the chart has the wanted sign: reversed when
    // it has the other sign, kept when it is zero (a point hole).
    WithChartSign(l: UvLoop, mirrored: Boolean, positive: Boolean): UvLoop
        => (positive ? l.ChartSignedArea(mirrored) < 0.0 : l.ChartSignedArea(mirrored) > 0.0)
            ? l.ReversedLoop
            : l;

    // The loop traversed the other way round.
    ReversedLoop(l: UvLoop): UvLoop
        => UvLoop(
            l.Points.Count.MapRange(i => l.Points[l.Points.Count - 1 - i]),
            l.Sources.Count.MapRange(i => l.Sources[l.Sources.Count - 1 - i]));

    // The region with its outer loop counter-clockwise and every hole clockwise in face f's
    // chart. The point set does not change, only the traversal. On a valid file the loops
    // already run this way (layer 02's WindingAgreesWithNormal), so a reversal marks a defect,
    // which MeshFace reports.
    OrientRegion(m: BrepModel, f: BrepFaceIndex, r: UvRegion): UvRegion
        => UvRegion(
            r.Outer.WithChartSign(m.IsChartMirrored(f), true),
            r.Holes.Map(h => h.WithChartSign(m.IsChartMirrored(f), false)));

    // The bounds of face f the region is built from: layer 02's KeptBounds, every bound except
    // the redundant vertex loops, in the file's order. A redundant vertex loop's point is already
    // a boundary point of the region, and expanding it at a pole would lay a second pole segment
    // over the one the other bound gives (sphere B of research/VALIDATION-MATH.md 1.5), so the
    // region would never be simple.
    MeshedBounds(m: BrepModel, f: BrepFaceIndex): Array<FaceBound>
        => m.KeptBounds(f).Map(k => m.Faces[f].Bounds[k]);

    // Face f's meshed bounds mapped to parameter space, unwrapped, and completed with synthetic
    // seams and poles, in the traversal the file gives.
    UnorientedRegionOf(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): UvRegion
        => m.AddMissingSeamsAndPoles(f, m.MeshedBounds(f).Map(b => m.Unwrap(f, m.LoopToUv(f, b, d))), c);

    // Face f's region: UnorientedRegionOf, oriented.
    RegionOf(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): UvRegion
        => m.OrientRegion(f, m.UnorientedRegionOf(f, d, c));

    //==
    // # Periodic directions
    //
    // In this layer a periodic direction is one whose Periodicity is Periodic or Closed (layer
    // 00): a closed direction (a clamped B-spline surface whose first and last rows coincide, as
    // CAD systems write a wrapped cylinder) has a seam at its range's ends exactly as a periodic
    // one does, so unwrapping, windings, seam uses, and synthetic cuts treat the two alike. Only
    // evaluation differs, and layer 01's Eval moves a closed direction's parameter into its range
    // first, so an unwrapped copy evaluates to the same point.

    // True when the step from a to b is shorter than half the period along a periodic or closed
    // direction; always true along an aperiodic one.
    StepBelowHalfPeriod(dom: CurveDomain, a: Number, b: Number): Boolean
        => match (dom.Periodicity) {
            Aperiodic => true;
            Periodic(period) => (b - a).Abs < 0.5 * period;
            Closed(period) => (b - a).Abs < 0.5 * period;
        };

    // True when the step from a to b is shorter than half a period in every periodic direction.
    StepBelowHalfPeriod(dom: SurfaceDomain, a: UvCoordinate, b: UvCoordinate): Boolean
        => dom.U.StepBelowHalfPeriod(a.U, b.U) && dom.V.StepBelowHalfPeriod(a.V, b.V);

    // True when the step from point i to point i + 1 of loop l (on face f) is below half a period
    // in every periodic direction, or touches a collapsed line, where the free parameter may jump
    // from the arriving seam copy to the leaving one; true when there is no such step.
    IsUnwrappedStep(m: BrepModel, f: BrepFaceIndex, l: UvLoop, i: Integer): Boolean
        => (i >= 0 && i + 1 < l.Points.Count)
            ? ((m.IsOnCollapsedLine(f, l.Points[i]) || m.IsOnCollapsedLine(f, l.Points[i + 1]))
                ? true
                : m.SurfaceDomainOf(f).StepBelowHalfPeriod(l.Points[i], l.Points[i + 1]))
            : true;

    // The whole number of periods a closed loop winds along one direction, from its first and
    // last parameter values. The loop's total displacement is (last - first) plus a closing step
    // shorter than half a period, and equals the winding times the period, so rounding
    // (last - first) / period gives the winding. Zero along an aperiodic direction; a closed
    // direction winds like a periodic one, so a band between two closed B-spline edges gets its
    // synthetic cut. Exact when every step of the loop is below half a period.
    Winding(dom: CurveDomain, first: Number, last: Number): Integer
        => match (dom.Periodicity) {
            Aperiodic => 0;
            Periodic(period) => ((last - first) / period + 0.5).Floor.ToInteger;
            Closed(period) => ((last - first) / period + 0.5).Floor.ToInteger;
        };

    // How many periods loop l winds in u, in face f's surface domain.
    UWinding(m: BrepModel, f: BrepFaceIndex, l: UvLoop): Integer
        => l.Points.IsEmpty ? 0 : m.SurfaceDomainOf(f).U.Winding(l.Points.First.U, l.Points.Last.U);

    // How many periods loop l winds in v, in face f's surface domain.
    VWinding(m: BrepModel, f: BrepFaceIndex, l: UvLoop): Integer
        => l.Points.IsEmpty ? 0 : m.SurfaceDomainOf(f).V.Winding(l.Points.First.V, l.Points.Last.V);

    //==
    // # Seam uses and the left rule
    //
    // A model seam is an edge that face f uses twice, once in each direction (layer 02's
    // IsSeamEdgeOf). Its two uses are the two banks of one cut, one period apart, and the file
    // does not record which use lies on which copy. research/STEP-BREP-MODEL.md section 4.3
    // settles it: in the chart (s u, v), s = FaceNormalSign, the face lies to the left of every
    // coedge as traversed, so the other bank of a seam use lies to its left. A use traversed with
    // increasing v sits on the copy at the larger chart u, and a use traversed with decreasing v
    // on the smaller; for a seam along u (a torus's second seam), a use traversed with increasing
    // chart u sits on the smaller v copy. Continuity decides this only when something between the
    // two uses winds around the period (the circles of a cylinder); at a pole or an apex nothing
    // does, so the rule is applied to every seam use. Sources alone identify a seam step, so the
    // rule needs no discretization.

    // True when the points with sources a and b are neighbours along seam e of face f: two
    // samples of e with indices one apart, a sample of e next to one of e's end vertices, or e's
    // two end vertices (a seam drawn as one segment). In a loop that is not malformed this is
    // exactly a segment of e's discretization.
    AreSeamNeighbours(m: BrepModel, f: BrepFaceIndex, e: BrepEdgeIndex, a: UvPointSource, b: UvPointSource): Boolean
        => m.IsSeamEdgeOf(f, e)
            ? ((a.IsSampleOfEdge(e) && b.IsSampleOfEdge(e))
                ? (a.SampleIndex - b.SampleIndex).Abs == 1
                : ((a.IsSampleOfEdge(e) || b.IsSampleOfEdge(e))
                    ? (m.IsEndVertexSource(e, a) || m.IsEndVertexSource(e, b))
                    : m.JoinsEndsOf(e, a, b)))
            : false;

    // True when s is one of edge e's two end vertices.
    IsEndVertexSource(m: BrepModel, e: BrepEdgeIndex, s: UvPointSource): Boolean
        => s.IsVertexSource(m.Edges[e].Start) || s.IsVertexSource(m.Edges[e].End);

    // True when steps i and j of loop l run along one segment of seam e of face f in opposite
    // directions: the two uses of that segment. Precondition: i and j are positions of l, which
    // has as many sources as points.
    AreTwinSteps(m: BrepModel, f: BrepFaceIndex, e: BrepEdgeIndex, l: UvLoop, i: Integer, j: Integer): Boolean
        => i != j
            && m.AreSeamNeighbours(f, e, l.Sources[i], l.Sources.AtModulo(i + 1))
            && l.Sources[i] == l.Sources.AtModulo(j + 1)
            && l.Sources.AtModulo(i + 1) == l.Sources[j];

    // True when b is a copy of a one whole period away: the same surface parameters modulo the
    // periods, within the parameter tolerance at a, and exactly one period apart in exactly one
    // periodic direction.
    IsOnePeriodAway(m: BrepModel, f: BrepFaceIndex, a: UvCoordinate, b: UvCoordinate): Boolean
        => m.SurfaceDomainOf(f).SameParameter(a, b, m.PointTolerance(f, a))
            && m.SurfaceDomainOf(f).U.Winding(a.U, b.U).Abs + m.SurfaceDomainOf(f).V.Winding(a.V, b.V).Abs == 1;

    // True when c lies strictly to the left of the step from a to b in face f's oriented chart:
    // the triangle (a, b, c) runs counter-clockwise there. An exact sign test; the chart's scales
    // are positive and do not change it.
    IsLeftOfStep(m: BrepModel, f: BrepFaceIndex, a: UvCoordinate, b: UvCoordinate, c: UvCoordinate): Boolean
        => [a, b, c].Map(p => p.OrientedPoint(m.IsChartMirrored(f))).ShoelaceArea > 0.0;

    // The left rule at the start of step i of loop l, whose twin step is j: the twin copy of
    // point i (the end of step j) lies one period away and to the left of step i. Exempt when
    // either copy lies on a collapsed line, whose free parameter belongs to the pole segment.
    // Precondition: i and j are positions of l.
    FollowsLeftRule(m: BrepModel, f: BrepFaceIndex, l: UvLoop, i: Integer, j: Integer): Boolean
        => (m.IsOnCollapsedLine(f, l.Points[i]) || m.IsOnCollapsedLine(f, l.Points.AtModulo(j + 1)))
            ? true
            : m.IsOnePeriodAway(f, l.Points[i], l.Points.AtModulo(j + 1))
                && m.IsLeftOfStep(f, l.Points[i], l.Points.AtModulo(i + 1), l.Points.AtModulo(j + 1));

    //==
    // # Collapsed lines
    //
    // A pole or an apex is an iso-line that the surface collapses to one point (layer 01's
    // CollapsedAt): v = +-pi/2 on a sphere, a side of the domain; v = -R / tan(a) on a cone,
    // inside the domain, where it bounds the face's region. In parameter space it is a segment,
    // not a point, and all of its points are one 3D vertex.

    // True when uv lies on the iso-line where parameter `which` equals c, within the parameter
    // tolerance at uv in that direction, measured around the circle when it is periodic.
    IsOnLine(m: BrepModel, f: BrepFaceIndex, uv: UvCoordinate, which: SurfaceParameter, c: Number): Boolean
        => m.SurfaceDomainOf(f).DomainAlong(which)
            .SameParameter(uv.Coordinate(which), c, which.Along(m.PointTolerance(f, uv).U, m.PointTolerance(f, uv).V));

    // The values of parameter `which` at which face f's surface collapses an iso-line.
    CollapsedLines(m: BrepModel, f: BrepFaceIndex, which: SurfaceParameter): Array<Number>
        => m.Geometry.CollapsedAt(m.SurfaceOf(f), which, m.Tolerances);

    // True when uv lies on a collapsed line of face f's surface along parameter `which`.
    IsOnCollapsedLineAlong(m: BrepModel, f: BrepFaceIndex, uv: UvCoordinate, which: SurfaceParameter): Boolean
        => m.CollapsedLines(f, which).Any(c => m.IsOnLine(f, uv, which, c));

    // True when uv lies on a collapsed line of face f's surface.
    IsOnCollapsedLine(m: BrepModel, f: BrepFaceIndex, uv: UvCoordinate): Boolean
        => m.IsOnCollapsedLineAlong(f, uv, SurfaceParameter.ParameterU)
            || m.IsOnCollapsedLineAlong(f, uv, SurfaceParameter.ParameterV);

    //==
    // # Boundary segments, simplicity, containment
    //
    // Loop k of a region is its outer loop for k = 0 and hole k - 1 for k >= 1. Segment i of a
    // loop runs from point i to point i + 1, the last one back to the first. Distances are
    // measured in tolerance units (InToleranceUnits), so "farther than the tolerance" is
    // "farther than one".

    // The number of loops: the outer loop and the holes.
    NumberOfLoops(r: UvRegion): Integer
        => r.Holes.Count + 1;

    // Loop k of the region. Precondition: 0 <= k < NumberOfLoops.
    LoopAt(r: UvRegion, k: Integer): UvLoop
        => k == 0 ? r.Outer : r.Holes[k - 1];

    // True when loop k exists and has a segment i.
    HasSegment(r: UvRegion, k: Integer, i: Integer): Boolean
        => (k >= 0 && k < r.NumberOfLoops) ? r.LoopAt(k).Points.IsValidIndex(i) : false;

    // The start of segment i of loop k.
    SegmentStart(r: UvRegion, k: Integer, i: Integer): UvCoordinate
        => r.LoopAt(k).Points[i];

    // The end of segment i of loop k.
    SegmentEnd(r: UvRegion, k: Integer, i: Integer): UvCoordinate
        => r.LoopAt(k).Points.AtModulo(i + 1);

    // The distance, in tolerance units, from p to the segment [a, b].
    PointSegmentGap(p: UvCoordinate, a: UvCoordinate, b: UvCoordinate, tol: UvTolerance): Number
        => DistanceToSegment(a.InToleranceUnits(tol), b.InToleranceUnits(tol), p.InToleranceUnits(tol));

    // The distance, in tolerance units, between the segments [a, b] and [c, d]: zero when they
    // meet, else the least distance from an end of one to the other.
    SegmentGap(a: UvCoordinate, b: UvCoordinate, c: UvCoordinate, d: UvCoordinate, tol: UvTolerance): Number
        => SegmentsIntersect(a.ToPoint2D, b.ToPoint2D, c.ToPoint2D, d.ToPoint2D)
            ? 0.0
            : a.PointSegmentGap(c, d, tol).Min(b.PointSegmentGap(c, d, tol))
                .Min(c.PointSegmentGap(a, b, tol)).Min(d.PointSegmentGap(a, b, tol));

    // True when segment j of loop k directly follows segment i.
    Follows(r: UvRegion, k: Integer, i: Integer, j: Integer): Boolean
        => (i + 1) % r.LoopAt(k).Points.Count == j;

    // True when segment j, which directly follows segment i on loop k, does not fold back onto
    // it: the start of i is farther than the tolerance from j, and the end of j from i.
    DoesNotFold(r: UvRegion, tol: UvTolerance, k: Integer, i: Integer, j: Integer): Boolean
        => r.SegmentStart(k, i).PointSegmentGap(r.SegmentStart(k, j), r.SegmentEnd(k, j), tol) > 1.0
            && r.SegmentEnd(k, j).PointSegmentGap(r.SegmentStart(k, i), r.SegmentEnd(k, i), tol) > 1.0;

    // True when segments (k, i) and (q, j) are as far apart as a simple region needs: a segment
    // and itself always are; consecutive segments of one loop when neither folds back onto the
    // other; any other pair when they are farther apart than the tolerance.
    // Precondition: both segments exist.
    SegmentsSeparated(r: UvRegion, tol: UvTolerance, k: Integer, i: Integer, q: Integer, j: Integer): Boolean
        => (k == q && i == j)
            ? true
            : ((k == q && r.Follows(k, i, j))
                ? r.DoesNotFold(tol, k, i, j)
                : ((k == q && r.Follows(k, j, i))
                    ? r.DoesNotFold(tol, k, j, i)
                    : SegmentGap(r.SegmentStart(k, i), r.SegmentEnd(k, i),
                        r.SegmentStart(q, j), r.SegmentEnd(q, j), tol) > 1.0));

    // True when segment i of loop k comes too close to some other boundary segment.
    SegmentCollides(r: UvRegion, tol: UvTolerance, k: Integer, i: Integer): Boolean
        => r.NumberOfLoops.Range.Any(q => r.LoopAt(q).Points.Count.Range.Any(j =>
            r.SegmentsSeparated(tol, k, i, q, j).Not));

    // True when every loop is simple and no two loops meet: no boundary segment collides. O(n^2)
    // as written; a sweep is the implementation.
    IsSimpleRegion(r: UvRegion, tol: UvTolerance): Boolean
        => r.NumberOfLoops.Range.All(k => r.LoopAt(k).Points.Count.Range.All(i =>
            r.SegmentCollides(tol, k, i).Not));

    // True when uv is inside the closed loop by the even-odd rule; false for fewer than three
    // points.
    LoopContains(l: UvLoop, uv: UvCoordinate): Boolean
        => l.Points.Count < 3 ? false : l.Points.Map(p => p.ToPoint2D).PolygonContainsPoint(uv.ToPoint2D);

    // The distance, in tolerance units, from uv to the nearest segment of loop l (to its point,
    // for a point hole).
    GapToLoop(l: UvLoop, uv: UvCoordinate, tol: UvTolerance): Number
        => l.Points.Count.Range.Reduce(Number.MaxValue, (best, i) =>
            best.Min(uv.PointSegmentGap(l.Points[i], l.Points.AtModulo(i + 1), tol)));

    // True when uv is strictly inside the region: inside the outer loop, outside every hole, and
    // farther than the tolerance from every boundary segment.
    IsStrictlyInside(r: UvRegion, uv: UvCoordinate, tol: UvTolerance): Boolean
        => r.Outer.LoopContains(uv)
            && r.Holes.All(h => h.LoopContains(uv).Not)
            && r.NumberOfLoops.Range.All(k => r.LoopAt(k).GapToLoop(uv, tol) > 1.0);

    // True when hole h's first point lies inside the outer loop. Given separated segments no loop
    // crosses another, so one point decides the whole hole. Precondition: the hole has a point.
    HoleInsideOuter(r: UvRegion, h: Integer): Boolean
        => r.Outer.LoopContains(r.Holes[h].Points.First);

    // True when every loop has as many sources as points.
    IsIndexedRegion(r: UvRegion): Boolean
        => r.NumberOfLoops.Range.All(k => r.LoopAt(k).Points.Count == r.LoopAt(k).Sources.Count);

    // The region's boundary points in triangulation order: the outer loop, then each hole.
    BoundaryPoints(r: UvRegion): Array<UvCoordinate>
        => r.Outer.Points.Concatenate(r.Holes.FlatMap(h => h.Points));

    // The sources of the boundary points, in the same order.
    BoundarySources(r: UvRegion): Array<UvPointSource>
        => r.Outer.Sources.Concatenate(r.Holes.FlatMap(h => h.Sources));

    // The number of boundary points.
    BoundaryCount(r: UvRegion): Integer
        => r.BoundaryPoints.Count;

    // The position in BoundaryPoints of loop k's first point: the point counts of the loops
    // before it added. Precondition: 0 <= k <= NumberOfLoops.
    LoopOffset(r: UvRegion, k: Integer): Integer
        => k.Range.Reduce(0, (n, q) => n + r.LoopAt(q).Points.Count);

    // The loop that boundary point a belongs to, or -1 when a is not a boundary point.
    LoopOfBoundaryPoint(r: UvRegion, a: Integer): Integer
        => r.NumberOfLoops.Range.Reduce(-1, (found, q) =>
            found >= 0 ? found : ((a >= r.LoopOffset(q) && a < r.LoopOffset(q + 1)) ? q : -1));

    // The boundary point that follows boundary point a along its loop, or -1 when a is not a
    // boundary point.
    NextBoundaryPoint(r: UvRegion, a: Integer): Integer
    {
        var k = r.LoopOfBoundaryPoint(a);
        return k < 0 ? -1 : r.LoopOffset(k) + (a - r.LoopOffset(k) + 1) % r.LoopAt(k).Points.Count;
    }

    // True when the points with indices a and b in BoundaryPoints order form a boundary segment
    // traversed from a to b, on a loop of at least three points (a point hole has no segment).
    IsBoundarySegment(r: UvRegion, a: Integer, b: Integer): Boolean
        => r.LoopOfBoundaryPoint(a) < 0
            ? false
            : (r.LoopAt(r.LoopOfBoundaryPoint(a)).Points.Count >= 3 && r.NextBoundaryPoint(a) == b);

    //==
    // # Seam cuts

    // The first position of source s in loop l, or -1 when it does not occur.
    PositionOfSource(l: UvLoop, s: UvPointSource): Integer
        => l.Sources.Count.Range.Reduce(-1, (found, i) => found >= 0 ? found : (l.Sources[i] == s ? i : -1));

    // True when sources a and b both occur in loop l and b directly follows a.
    AreConsecutive(l: UvLoop, a: UvPointSource, b: UvPointSource): Boolean
        => (l.PositionOfSource(a) >= 0 && l.PositionOfSource(b) >= 0)
            ? (l.PositionOfSource(a) + 1) % l.Sources.Count == l.PositionOfSource(b)
            : false;

    // True unless the step from outer position i to i + 1 runs along one copy of a seam cut
    // (SeamCut points of one side, indices k then j) while the other copy fails to visit the same
    // indices in the opposite order (j then k). Precondition: i is a valid position.
    SeamCutStepIsMirrored(r: UvRegion, i: Integer): Boolean
        => r.SeamCutStepAt(i, r.Outer.Sources[i]);

    // SeamCutStepIsMirrored, given the source `here` at position i.
    SeamCutStepAt(r: UvRegion, i: Integer, here: UvPointSource): Boolean
        => match (here) {
            FromVertex(v) => true;
            FromEdge(e, k) => true;
            SeamCut(side, k) => r.SeamCutStepTo(side, k, r.Outer.Sources.AtModulo(i + 1));
            Pole(side, k) => true;
            Interior => true;
        };

    // The case of SeamCutStepIsMirrored where the step runs from SeamCut(side, k) to `next`.
    SeamCutStepTo(r: UvRegion, side: DomainSide, k: Integer, next: UvPointSource): Boolean
        => match (next) {
            FromVertex(v) => true;
            FromEdge(e, j) => true;
            SeamCut(nextSide, j) => nextSide == side
                ? r.Outer.AreConsecutive(
                    UvPointSource.SeamCut(side.OppositeSide, j),
                    UvPointSource.SeamCut(side.OppositeSide, k))
                : true;
            Pole(s, j) => true;
            Interior => true;
        };

    //==
    // # Discretization segments
    //
    // A segment of a model edge's discretization is a pair of consecutive samples of that edge.
    // In a loop such pairs are boundary segments; in an element they are element edges that
    // layer 04's criteria bound, so the surface criteria do not measure them.

    // True when a and b are the two end vertices of edge e, in either order.
    JoinsEndsOf(m: BrepModel, e: BrepEdgeIndex, a: UvPointSource, b: UvPointSource): Boolean
        => (a.IsVertexSource(m.Edges[e].Start) && b.IsVertexSource(m.Edges[e].End))
            || (a.IsVertexSource(m.Edges[e].End) && b.IsVertexSource(m.Edges[e].Start));

    // True when edge sample k of edge e and the source v are consecutive samples: k is the second
    // sample and v the vertex at the first, or k the second-to-last and v the vertex at the last.
    IsEndStep(m: BrepModel, d: EdgeDiscretizations, e: BrepEdgeIndex, k: Integer, v: UvPointSource): Boolean
        => (k == 1 && v.IsVertexSource(m.FirstVertexAlongCurve(e)))
            || (k == d.ByEdge[e].Points.Count - 2 && v.IsVertexSource(m.LastVertexAlongCurve(e)));

    // True when the points with sources a and b are consecutive samples of edge e's
    // discretization, in either order. Precondition: e indexes m.Edges and d.ByEdge.
    IsDiscretizationSegment(m: BrepModel, d: EdgeDiscretizations, e: BrepEdgeIndex, a: UvPointSource, b: UvPointSource): Boolean
        => (a.IsSampleOfEdge(e) && b.IsSampleOfEdge(e))
            ? (a.SampleIndex - b.SampleIndex).Abs == 1
            : (a.IsSampleOfEdge(e)
                ? m.IsEndStep(d, e, a.SampleIndex, b)
                : (b.IsSampleOfEdge(e)
                    ? m.IsEndStep(d, e, b.SampleIndex, a)
                    : (d.ByEdge[e].Points.Count == 2 && m.JoinsEndsOf(e, a, b))));

    // True when the points with sources a and b are consecutive samples of some edge face f cites.
    IsModelEdgeSegment(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, a: UvPointSource, b: UvPointSource): Boolean
        => m.FaceEdges(f).Any(e => m.IsDiscretizationSegment(d, e, a, b));

    //==
    // # Requests from the region
    //
    // A refinement request asks layer 04 for a finer polyline on one edge. Its Chordal is a third
    // of the largest sagitta of the edge's current segments (OpenCascade divides by three), so
    // each round asks for strictly finer than the last; for a straight edge it is zero, which
    // layer 04's MinLength floor turns into "as fine as allowed". Its Segments is zero: these
    // requests are not about counts.

    // The largest sagitta among the segments of a discretization.
    LargestSagitta(m: BrepModel, de: EdgeDiscretization): Number
        => (de.Parameters.Count - 1).MapRange(i => m.Sagitta(de.Edge, de.Parameters[i], de.Parameters[i + 1]))
            .Reduce(0.0, (worst, s) => worst.Max(s));

    // The chordal a request for edge e asks for: a third of its current largest sagitta.
    TighterChordal(m: BrepModel, d: EdgeDiscretizations, e: BrepEdgeIndex): Number
        => m.LargestSagitta(d.ByEdge[e]) / 3.0;

    // True when segment i of loop k is a segment of edge e's discretization.
    IsSegmentOn(r: UvRegion, m: BrepModel, d: EdgeDiscretizations, e: BrepEdgeIndex, k: Integer, i: Integer): Boolean
        => m.IsDiscretizationSegment(d, e, r.LoopAt(k).Sources[i], r.LoopAt(k).Sources.AtModulo(i + 1));

    // True when some boundary segment on edge e collides with another boundary segment.
    EdgeCollides(m: BrepModel, d: EdgeDiscretizations, r: UvRegion, tol: UvTolerance, e: BrepEdgeIndex): Boolean
        => r.NumberOfLoops.Range.Any(k => r.LoopAt(k).Points.Count.Range.Any(i =>
            r.IsSegmentOn(m, d, e, k, i) && r.SegmentCollides(tol, k, i)));

    // The blocking requests for face f's region: a LoopSelfIntersects request for every edge with
    // a colliding segment. Empty for a simple region; empty also for a region that is not simple
    // only because synthetic segments collide, which MeshFace diagnoses as an error.
    SelfIntersectionRequests(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, tol: UvTolerance): Array<EdgeRefinementRequest>
        => m.FaceEdges(f).FlatMap(e => m.EdgeCollides(d, r, tol, e)
            ? [EdgeRefinementRequest(e, RefinementReason.LoopSelfIntersects, m.TighterChordal(d, e), 0)]
            : EdgeRefinementRequest.NoRequests);

    // How far the surface, along the straight parameter segment of boundary segment i of loop k,
    // strays from the 3D chord between the segment's shared end points: layer 04's
    // UvChordDeviation with its own sample plan, repeated here as a backstop.
    SegmentUvDeviation(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, k: Integer, i: Integer): Number
        => m.UvChordDeviation(m.SurfaceOf(f),
            m.SharedPosition(d, r.LoopAt(k).Sources[i], m.Geometry.Eval(m.SurfaceOf(f), r.SegmentStart(k, i))),
            m.SharedPosition(d, r.LoopAt(k).Sources.AtModulo(i + 1), m.Geometry.Eval(m.SurfaceOf(f), r.SegmentEnd(k, i))),
            r.SegmentStart(k, i), r.SegmentEnd(k, i), SamplePlan.DiscretizationPlan);

    // True when some boundary segment on edge e strays from its 3D chord in face f by more than
    // the edge chordal criterion plus the length tolerance.
    EdgeTooCoarseInFace(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, c: FaceMeshingCriteria, e: BrepEdgeIndex): Boolean
        => r.NumberOfLoops.Range.Any(k => r.LoopAt(k).Points.Count.Range.Any(i =>
            r.IsSegmentOn(m, d, e, k, i)
                ? m.SegmentUvDeviation(f, d, r, k, i) > c.Discretization.Chordal + m.Tolerances.Length.Value
                : false));

    // The advisory requests for face f's region: a TooCoarseInParameterSpace request for every
    // edge with a segment that strays from its 3D chord in parameter space.
    CoarseSegmentRequests(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, c: FaceMeshingCriteria): Array<EdgeRefinementRequest>
        => m.FaceEdges(f).FlatMap(e => m.EdgeTooCoarseInFace(f, d, r, c, e)
            ? [EdgeRefinementRequest(e, RefinementReason.TooCoarseInParameterSpace, m.TighterChordal(d, e), 0)]
            : EdgeRefinementRequest.NoRequests);

    //==
    // # Four-sided regions

    // Chunk B body, from the contract QuadSidesOf and its deferred note: one
    // walk of the outer loop of a region without holes. Each step is classed
    // as a run along u (v constant within the region's tolerance), along v,
    // or neither (StepClass); a corner is a point where the class of the step
    // arriving differs from the class of the step leaving. Four-sided when
    // every step runs along u or v, there are exactly four corners, and each
    // side is one carrier (SideIsOneCarrier): one coedge, seam use, seam cut
    // or pole segment.
    QuadSidesOf(m: BrepModel, f: BrepFaceIndex, r: UvRegion): QuadSides
    {
        var tol = m.RegionTolerance(f, m.ChartOf(f, r));
        var n = r.Outer.Points.Count;
        var classes = n.MapRange(i => r.Outer.Points[i].StepClass(r.Outer.Points.AtModulo(i + 1), tol));
        var corners = n.Range.FlatMap(i => classes[i] != classes[(i + n - 1) % n] ? [VertexIndex(i)] : [VertexIndex(i)].Take(0));
        return (r.Holes.IsEmpty && n >= 4 && classes.All(x => x != 0) && corners.Count == 4)
            ? (4.Range.All(k => r.SideIsOneCarrier(corners, k)) ? QuadSides.FourSided(corners) : QuadSides.NotFourSided)
            : QuadSides.NotFourSided;
    }

    // The class of the step from a to b: 1 when it runs along u (v constant within the
    // tolerance), 2 along v, 0 neither (or a step shorter than the tolerance both ways).
    StepClass(a: UvCoordinate, b: UvCoordinate, tol: UvTolerance): Integer
    {
        var alongU = (b.V - a.V).Abs <= tol.V.Value;
        var alongV = (b.U - a.U).Abs <= tol.U.Value;
        return alongU == alongV ? 0 : (alongU ? 1 : 2);
    }

    // Whether side k of the four-sided outer loop is one carrier: every point strictly between
    // its two corners is a sample of one edge, a point of one seam-cut copy, or a point of one
    // pole segment. A side of one segment has no such point and is one coedge or one cut step.
    SideIsOneCarrier(r: UvRegion, corners: Array<VertexIndex>, k: Integer): Boolean
    {
        var start = corners[k % 4].Value;
        var count = r.SideSegmentCount(corners, k);
        var inner = (count - 1).MapRange(i => r.Outer.Sources.AtModulo(start + 1 + i));
        return inner.Count == 0 ? true : inner.All(s => s.SameCarrier(inner[0]));
    }

    // Whether two sources lie on one carrier: samples of one edge, points of one seam-cut copy,
    // or points of one pole segment. A vertex or an interior point is no carrier's.
    SameCarrier(a: UvPointSource, b: UvPointSource): Boolean
        => match (a) {
            FromVertex(v) => false;
            FromEdge(e, k) => b.IsSampleOfEdge(e);
            SeamCut(side, k) => b.IsSeamCutOn(side);
            Pole(side, k) => b.IsPoleOn(side);
            Interior => false;
        };

    // True when s is a point of the seam-cut copy along `side`.
    IsSeamCutOn(s: UvPointSource, side: DomainSide): Boolean
        => match (s) {
            FromVertex(w) => false;
            FromEdge(e, k) => false;
            SeamCut(side2, k) => side2 == side;
            Pole(side2, k) => false;
            Interior => false;
        };

    // The number of corners a classification names: four for a four-sided region, none otherwise.
    CornerCount(q: QuadSides): Integer
        => match (q) {
            NotFourSided => 0;
            FourSided(corners) => corners.Count;
        };

    // The number of segments on side k (0 to 3) of a four-sided outer loop.
    SideSegmentCount(r: UvRegion, corners: Array<VertexIndex>, k: Integer): Integer
        => (corners[(k + 1) % 4].Value - corners[k % 4].Value + r.Outer.Points.Count) % r.Outer.Points.Count;

    // True when opposite sides have equal segment counts, as a structured grid needs.
    OppositeCountsMatch(r: UvRegion, corners: Array<VertexIndex>): Boolean
        => r.SideSegmentCount(corners, 0) == r.SideSegmentCount(corners, 2)
            && r.SideSegmentCount(corners, 1) == r.SideSegmentCount(corners, 3);
}

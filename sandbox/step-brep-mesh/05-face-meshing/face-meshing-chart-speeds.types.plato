//==
// # Both mean speeds of a face (complexity sweep chunk R7, TKT-389)
//
// Layer 05. The two scales of a face chart, computed together by MeanSpeedBoth
// (chart-speeds.library.plato).

// Face f's mean surface speeds over a region: SpeedU is MeanSpeed(f, r, ParameterU), the mean
// of |PartialU| on its sample set, and SpeedV is MeanSpeed(f, r, ParameterV).
type MeanSpeeds
    implements IValue
{
    SpeedU: Number;
    SpeedV: Number;
}

//==
// # Specs of the parameter-space proofs
//
// One spec per proof type of face-meshing-proofs.types.plato: the invariant
// its value keeps and the single function permitted to build it. The laws
// named beside them take faces of layer 7's witnesses, so they are in
// 07-validation/validation-proofs-regions.laws.plato. m is the model the
// constructor was given. Not compiled; the runner skips this file.
//
// Sections, in order:
//  - Loops and regions

//==
// # Loops and regions

spec SimpleUvLoop
{
    invariant self.Loop.AsRegion.IsSimpleRegion(self.Tolerance);   // Law_SimpleUvLoopIffSimpleRegion
    constructor CheckSimpleUvLoop;
}

spec ClosedUvLoop
{
    invariant m.IsFaceIntact(self.Face);
    invariant m.UWinding(self.Face, self.Loop) == 0 && m.VWinding(self.Face, self.Loop) == 0;   // Law_ClosedUvLoopIffUnwound
    constructor CheckClosedUvLoop;
}

spec OrientedUvRegion
{
    invariant m.IsFaceIntact(self.Face);
    invariant m.UvRegionWindingPositive(self.Face, self.Region);
    invariant forall (h: Integer) in self.Region.Holes.Count.Range :
        Law_UvHoleWindingNegative(m, self.Face, self.Region, h);   // Law_OrientedUvRegionIffWindings
    constructor CheckOrientedUvRegion;
}

//==
// # Version 1: pinched and zero-width plane regions (TKT-412)
//
// A weakly simple loop touches itself only at exact shared vertices: it passes through one vertex
// twice (a keyhole, a hole joined to the outer boundary at a point, as in CEL/LENA-R8.STEP face
// 1349). SegmentsSeparated rejects it, because two non-consecutive segments that end at the shared
// vertex are zero tolerance units apart. SegmentsSeparatedV1 accepts such a pair of one loop when
// the segments share exactly one endpoint, with identical coordinates, and each one's other end
// lies farther than one tolerance unit from the other segment, so they meet only at that point.
// Two loops that touch (a hole touching the outer loop or another hole) stay not simple: the
// library's collision laws pin that (PerfCollideShapes, shape 12), and the triangulator's hole
// bridging does not cover such a region. A pair that shares a point and runs on within
// the tolerance (a fold, an overlap) is still not separated, and so is every pair that meets
// anywhere else: a region that crosses itself (the MAYA planes, TKT-419) stays not simple.
//
// A pinch is accepted only as a keyhole: at a vertex a loop passes twice, the smaller of the two
// sub-loops the pinch cuts the loop into winds opposite to the larger and lies inside it, so it is
// a hole joined to the boundary at a point. A pinched sub-loop wound the same way, or outside
// (SHO/MAYA-W260_REVC.step face 1599, a 5-gon pinched to a disc outside it), is malformed, and the
// face keeps its not-simple outcome.
//
// A zero-width region (every point within the tolerance of a boundary it does not belong to, so
// its area is within the area its boundary can sweep inside the tolerance) has nothing to cover.
// The contract forbids an inverted or degenerate element, so such a face gets no mesh and a
// located diagnostic of its own, without edge requests, which no refinement could satisfy.
//
// Sections, in order:
//  - Separated segments
//  - Keyhole pinches
//  - Zero-width regions
//  - Meshing a region

library V1Pinch
{
    //==
    // # Separated segments

    // True when a and b are the same parameters exactly.
    IsSameUv(a: UvCoordinate, b: UvCoordinate): Boolean
        => a.U == b.U && a.V == b.V;   // exact: a shared vertex is copied, not recomputed

    // True when chart point x is one of the corners a, b, c exactly: a pinch vertex's second copy,
    // which lies on an ear's corner and must not block it (the clippers' blocker test).
    IsCornerOf(x: Point2D, a: Point2D, b: Point2D, c: Point2D): Boolean
        => (x.X == a.X && x.Y == a.Y) || (x.X == b.X && x.Y == b.Y) || (x.X == c.X && x.Y == c.Y);   // exact: copied points

    // The number of endpoint pairs, one of [a0, a1] and one of [b0, b1], with identical
    // coordinates.
    SharedEnds(a0: UvCoordinate, a1: UvCoordinate, b0: UvCoordinate, b1: UvCoordinate): Integer
        => (a0.IsSameUv(b0) ? 1 : 0) + (a0.IsSameUv(b1) ? 1 : 0) + (a1.IsSameUv(b0) ? 1 : 0) + (a1.IsSameUv(b1) ? 1 : 0);

    // The end of [a0, a1] that is not shared with [b0, b1]. Precondition: SharedEnds is 1.
    FarEnd(a0: UvCoordinate, a1: UvCoordinate, b0: UvCoordinate, b1: UvCoordinate): UvCoordinate
        => (a0.IsSameUv(b0) || a0.IsSameUv(b1)) ? a1 : a0;

    // True when segments [a0, a1] and [b0, b1], sharing exactly one end, meet only there: each
    // one's far end is farther than one tolerance unit from the other segment.
    MeetOnlyAtSharedEnd(a0: UvCoordinate, a1: UvCoordinate, b0: UvCoordinate, b1: UvCoordinate, tol: UvTolerance): Boolean
        => FarEnd(a0, a1, b0, b1).PointSegmentGap(b0, b1, tol) > 1.0
            && FarEnd(b0, b1, a0, a1).PointSegmentGap(a0, a1, tol) > 1.0;

    // SegmentsSeparated, except that two non-consecutive segments of one loop sharing exactly one
    // end, with identical coordinates, are separated when they meet only there (a pinch vertex).
    SegmentsSeparatedV1(r: UvRegion, tol: UvTolerance, k: Integer, i: Integer, q: Integer, j: Integer): Boolean
    {
        var a0 = r.SegmentStart(k, i);
        var a1 = r.SegmentEnd(k, i);
        var b0 = r.SegmentStart(q, j);
        var b1 = r.SegmentEnd(q, j);
        return (k == q && i == j)
            ? true
            : ((k == q && r.Follows(k, i, j))
                ? r.DoesNotFold(tol, k, i, j)
                : ((k == q && r.Follows(k, j, i))
                    ? r.DoesNotFold(tol, k, j, i)
                    : ((k == q && SharedEnds(a0, a1, b0, b1) == 1)
                        ? MeetOnlyAtSharedEnd(a0, a1, b0, b1, tol)
                        : SegmentGap(a0, a1, b0, b1, tol) > 1.0)));
    }

    // True when every pair of boundary segments of r is separated under SegmentsSeparatedV1,
    // every pair tested (n^2; the library's grid calls SegmentsSeparated once the wiring points
    // it here).
    IsSimpleRegionV1(r: UvRegion, tol: UvTolerance): Boolean
        => r.NumberOfLoops.Range.All(k => r.LoopAt(k).Points.Count.Range.All(i =>
            r.NumberOfLoops.Range.All(q => r.LoopAt(q).Points.Count.Range.All(j => r.SegmentsSeparatedV1(tol, k, i, q, j)))));

    //==
    // # Keyhole pinches

    // The points of loop l from position a up to, not including, position b (a < b).
    LoopSpan(l: UvLoop, a: Integer, b: Integer): Array<UvCoordinate>
        => (b - a).MapRange(i => l.Points[a + i]);

    // The points of loop l outside the span from a to b: from b to the end, then from the start up
    // to a.
    LoopRest(l: UvLoop, a: Integer, b: Integer): Array<UvCoordinate>
        => (l.Points.Count - b + a).MapRange(i => l.Points[(b + i) % l.Points.Count]);

    // The shoelace area of the closed polygon ps in natural units.
    PolygonArea(ps: Array<UvCoordinate>): Number
        => ps.Map(p => p.ToPoint2D).ShoelaceArea;

    // True when the pinch of loop l at positions a < b (the same point twice) is a keyhole: the
    // sub-loop with the smaller area winds opposite to the other and the midpoint of its second
    // segment lies inside the other.
    IsKeyholePinch(l: UvLoop, a: Integer, b: Integer): Boolean
    {
        var span = l.LoopSpan(a, b);
        var rest = l.LoopRest(a, b);
        var spanArea = span.PolygonArea;
        var restArea = rest.PolygonArea;
        var small = spanArea.Abs <= restArea.Abs ? span : rest;
        var large = spanArea.Abs <= restArea.Abs ? rest : span;
        var smallArea = spanArea.Abs <= restArea.Abs ? spanArea : restArea;
        var largeArea = spanArea.Abs <= restArea.Abs ? restArea : spanArea;
        var probe = small.Count >= 3 ? small[1].UvMidpoint(small[2]) : small[0];
        return (smallArea * largeArea < 0.0)
            ? UvLoop(large, large.Map(x => UvPointSource.Interior)).LoopContains(probe)
            : false;
    }

    // True when every pinch of loop l (two positions, not neighbours, holding the same point
    // exactly) is a keyhole. n^2 in the loop's points.
    PinchesAreKeyholes(l: UvLoop): Boolean
    {
        var n = l.Points.Count;
        return n.Range.All(a => n.Range.All(b =>
            (b > a + 1 && (a > 0 || b < n - 1) && l.Points[a].IsSameUv(l.Points[b])) ? l.IsKeyholePinch(a, b) : true));
    }

    // True when every pinch of every loop of r is a keyhole.
    RegionPinchesAreKeyholes(r: UvRegion): Boolean
        => r.NumberOfLoops.Range.All(k => r.LoopAt(k).PinchesAreKeyholes);

    // The outcome for a face whose loop is pinched other than as a keyhole: no mesh and the
    // not-simple diagnostic.
    MalformedPinchOutcome(f: BrepFaceIndex): FaceMeshOutcome
        => f.UnmeshedOutcome("FACE-LOOP-NOT-SIMPLE",
            "A loop of this face passes through one point twice and the part it cuts off would be covered twice or wound backwards; the face is not meshed.");

    //==
    // # Zero-width regions

    // True when region r has no width to cover: its chart area is within the area its boundary
    // can sweep inside the tolerance (AreaTolerance), so every triangle of a cover would be
    // thinner than the tolerance.
    IsZeroWidthRegion(r: UvRegion, tol: UvTolerance): Boolean
        => r.ChartSignedArea(false).Abs <= r.AreaTolerance(tol);

    // The outcome for a face whose region has no width and that ZeroWidthMeshedOutcome (V1ZeroWidth)
    // cannot mesh, one with holes: no mesh, no request, and one error that says why.
    ZeroWidthOutcome(f: BrepFaceIndex): FaceMeshOutcome
        => f.UnmeshedOutcome("FACE-ZERO-WIDTH",
            "This face's boundary encloses no area wider than the model's tolerance (a sliver or a strip); it is not meshed, and refining its edges would not change that.");
}

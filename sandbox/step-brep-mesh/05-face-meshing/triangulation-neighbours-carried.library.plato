//==
// # The neighbour table carried through refinement (complexity sweep, TKT-408)
//
// Layer 05-face-meshing. TriangulationBuiltIndexed's passes and refinement, and
// RefinementTestCached's surface test, with the neighbour table read from the triangulation
// they are given (PositionedTriangulationWithNeighbours) instead of sorted again, and the
// passes returning the table they kept current through their insertions (WithNeighbours). The
// table is built once per refinement, before the first round (WithNeighbourTable), where the
// library built it three times per round on a curved face and twice on a plane. A pass sets
// triangles in place or appends them (WithTriangles) and never removes or reorders one, so a
// slot index means the same side after the pass. Every table read is the one NeighbourSlots
// would give (Law_CarriedTableIsNeighbourSlots), so the insertions are the same, in the
// same order.
//
// Sections, in order:
//  - The carried table
//  - The surface test
//  - The passes
//  - Refinement

library NeighboursCarried
{
    //==
    // # The carried table

    // pt with its neighbour table built from scratch.
    WithNeighbourTable(pt: PositionedTriangulation): PositionedTriangulationWithNeighbours
        => PositionedTriangulationWithNeighbours(pt, NeighbourSlots(pt.Triangulation.Triangles, pt.Triangulation.Points.Count));

    //==
    // # The surface test

    // RefinementTestCached's NeedsRefinementCachedCounted with t's carried table in place of
    // NeighbourSlots: the same Boolean per triangle and the same work.
    NeedsRefinementCarriedCounted(m: BrepModel, f: BrepFaceIndex, r: UvRegion, t: PositionedTriangulationWithNeighbours, known: Array<Boolean>, c: FaceMeshingCriteria): Counted<Array<Boolean>>
    {
        var pt = t.Positioned;
        var u = pt.Triangulation;
        var tris = u.Triangles;
        var tested = tris.Count.MapRange(k => (k < known.Count ? known[k] : false).Not);
        var marks = new List<Boolean>().AddRange(u.Points.Map(x => false));
        var i = 0;
        while (i < tris.Count)
        {
            if (tested[i])
            {
                marks = marks.Set(tris[i].A.Value, true).Set(tris[i].B.Value, true).Set(tris[i].C.Value, true);
            }
            i = i + 1;
        }
        var corners = marks.Freeze();
        var pn = m.PointNormalsOf(f, u, corners);
        var first = tris.Count.MapRange(k => tested[k] ? m.TriangleCentroidTest(f, r, pt, pn, k, c) : CentroidTest(false, 0));
        var pending = tris.Count.MapRange(k => tested[k] ? first[k].Fails.Not : false);
        var nb = t.Neighbours;
        var sources = (3 * tris.Count).MapRange(s => SampleSlot(tris, nb, pending, s));
        var sampled = (3 * tris.Count).MapRange(s => r.IsSampled(tris, pending, sources, s));
        var samples = (3 * tris.Count).MapRange(s => sampled[s]
            ? m.SideSampleOf(f, pt, tris[s / 3], s % 3)
            : SideSample(0.0, Point3D(0.0, 0.0, 0.0)));
        var value = tris.Count.MapRange(k => tested[k] ? r.TriangleNeedsRefinementCached(pt, first[k], samples, sources, k, c) : false);
        var work = corners.TrueCount + first.Reduce(0, (n, x) => n + x.Evaluations) + 3 * sampled.TrueCount;
        return Counted(value, Evaluations(work));
    }

    // NeedsRefinementCarriedCounted's marks.
    NeedsRefinementCarried(m: BrepModel, f: BrepFaceIndex, r: UvRegion, t: PositionedTriangulationWithNeighbours, known: Array<Boolean>, c: FaceMeshingCriteria): Array<Boolean>
        => m.NeedsRefinementCarriedCounted(f, r, t, known, c).Value;

    //==
    // # The passes

    // TriangulationBuiltIndexed's SurfacePassIndexedCounted starting from t's carried table, and
    // returning the table its insertions kept current; the same work counted.
    SurfacePassCarriedCounted(m: BrepModel, f: BrepFaceIndex, x: BoundaryIndex, chart: FaceChart, least: Number, t: PositionedTriangulationWithNeighbours, surface: Array<Boolean>): Counted<PositionedTriangulationWithNeighbours>
    {
        var u0 = t.Positioned.Triangulation;
        var pts = new List<UvCoordinate>().AddRange(u0.Points);
        var points = new List<Point2D>().AddRange(u0.Points.Map(z => chart.ChartPoint(z)));
        var pos = new List<Point3D>().AddRange(t.Positioned.Positions);
        var tris = new List<TriangleFace>().AddRange(u0.Triangles);
        var nb = new List<Integer>().AddRange(t.Neighbours);
        var evaluations = 0;
        var written = 0;
        var k = 0;
        while (k < u0.Triangles.Count)
        {
            if (surface[k] ? tris.At(k) == u0.Triangles[k] : false)
            {
                var centre = chart.Circumcentre(ChartCornersIn(tris.At(k), points), TriangleOf(0, 1, 2));
                var first = m.TryInsertionIndexed(f, x, chart, least, false, k, centre, points, pos, tris, nb);
                var uv = first.Kept ? centre : x.Next.SurfaceFallbackIndexed(k, pts, points, tris, nb);
                var next = first.Kept ? first : m.TryInsertionIndexed(f, x, chart, least, false, k, uv, points, pos, tris, nb);
                evaluations = evaluations + first.Evaluations + (first.Kept ? 0 : next.Evaluations);
                if (next.Kept)
                {
                    pts = pts.Add(next.Point);
                    points = points.Add(next.Chart);
                    pos = pos.Add(next.Position);
                    tris = next.WithTriangles(tris);
                    nb = next.WithNeighbours(nb);
                    written = written + next.Written;
                }
            }
            k = k + 1;
        }
        var added = pts.Count - u0.Points.Count;
        var value = PositionedTriangulationWithNeighbours(
            PositionedTriangulation(
                UvTriangulation(pts.Freeze(), u0.Sources.Concatenate(added.MapRange(i => UvPointSource.Interior)), tris.Freeze(), u0.Quads),
                pos.Freeze()),
            nb.Freeze());
        return Counted(value, Evaluations(evaluations).Add(Insertions(written)));
    }

    // SurfacePassCarriedCounted's triangulation and table.
    SurfacePassCarried(m: BrepModel, f: BrepFaceIndex, x: BoundaryIndex, chart: FaceChart, least: Number, t: PositionedTriangulationWithNeighbours, surface: Array<Boolean>): PositionedTriangulationWithNeighbours
        => m.SurfacePassCarriedCounted(f, x, chart, least, t, surface).Value;

    // TriangulationBuiltIndexed's AnglePassIndexedCounted starting from t's carried table, and
    // returning the table its insertions kept current; the same work counted.
    AnglePassCarriedCounted(m: BrepModel, f: BrepFaceIndex, x: BoundaryIndex, chart: FaceChart, least: Number, t: PositionedTriangulationWithNeighbours, bad: Array<Integer>): Counted<PositionedTriangulationWithNeighbours>
    {
        var u0 = t.Positioned.Triangulation;
        var pts = new List<UvCoordinate>().AddRange(u0.Points);
        var points = new List<Point2D>().AddRange(u0.Points.Map(z => chart.ChartPoint(z)));
        var pos = new List<Point3D>().AddRange(t.Positioned.Positions);
        var tris = new List<TriangleFace>().AddRange(u0.Triangles);
        var nb = new List<Integer>().AddRange(t.Neighbours);
        var evaluations = 0;
        var written = 0;
        var i = 0;
        while (i < bad.Count)
        {
            var k = bad[i];
            if (tris.At(k) == u0.Triangles[k])
            {
                var tri = tris.At(k);
                var candidates = chart.AngleCandidates(ChartCornersIn(tri, points), UvCornersIn(tri, pts), TriangleOf(0, 1, 2));
                var n = 0;
                while (n < candidates.Count)
                {
                    var next = m.TryInsertionIndexed(f, x, chart, least, true, k, candidates[n], points, pos, tris, nb);
                    evaluations = evaluations + next.Evaluations;
                    if (next.Kept)
                    {
                        pts = pts.Add(next.Point);
                        points = points.Add(next.Chart);
                        pos = pos.Add(next.Position);
                        tris = next.WithTriangles(tris);
                        nb = next.WithNeighbours(nb);
                        written = written + next.Written;
                        n = candidates.Count;
                    }
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        var added = pts.Count - u0.Points.Count;
        var value = PositionedTriangulationWithNeighbours(
            PositionedTriangulation(
                UvTriangulation(pts.Freeze(), u0.Sources.Concatenate(added.MapRange(j => UvPointSource.Interior)), tris.Freeze(), u0.Quads),
                pos.Freeze()),
            nb.Freeze());
        return Counted(value, Evaluations(evaluations).Add(Insertions(written)));
    }

    // AnglePassCarriedCounted's triangulation and table.
    AnglePassCarried(m: BrepModel, f: BrepFaceIndex, x: BoundaryIndex, chart: FaceChart, least: Number, t: PositionedTriangulationWithNeighbours, bad: Array<Integer>): PositionedTriangulationWithNeighbours
        => m.AnglePassCarriedCounted(f, x, chart, least, t, bad).Value;

    //==
    // # Refinement

    // The state before the first round of refining t on face f: t positioned, its table built
    // once, nothing marked.
    CarriedRefinementOf(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation): CarriedRefinement
    {
        var start = m.Positioned(f, t).WithNeighbourTable;
        var none = t.Triangles.Map(z => false);
        return CarriedRefinement(start, start, none, none, none, true, 0);
    }

    // One round of RefineToSurfaceByInsertionIndexed from state s, over the indexed boundary x
    // of region r: the surface test (none on a plane), the surface pass, the angle test and the
    // angle pass, each reading the table the step before it returned; the marks carried as the
    // library carries them.
    RefinementRoundCarried(m: BrepModel, f: BrepFaceIndex, r: UvRegion, x: BoundaryIndex, chart: FaceChart, least: Number, planar: Boolean, c: FaceMeshingCriteria, s: CarriedRefinement): CarriedRefinement
    {
        var none = [0].Take(0);
        var now = s.Current.Positioned.Triangulation;
        var surface = planar ? now.Triangles.Map(z => false) : m.NeedsRefinementCarried(f, r, s.Current, s.Known, c);
        var mid = m.SurfacePassCarried(f, x, chart, least, s.Current, surface);
        var midT = mid.Positioned.Triangulation;
        var carried = now.Triangles.CarriedMarks(s.Refused, none, midT.Triangles);
        var goodMid = now.Triangles.CarriedMarks(s.Good, none, midT.Triangles);
        var bad = m.BelowAngleKnown(f, midT, carried, goodMid);
        var next = m.AnglePassCarried(f, x, chart, least, mid, bad);
        var nextT = next.Positioned.Triangulation;
        return CarriedRefinement(next, mid,
            KnownGood(now, surface, nextT),
            midT.Triangles.CarriedMarks(carried, bad, nextT.Triangles),
            midT.Triangles.CarriedMarks(midT.AngleGoodMarks(carried, bad), none, nextT.Triangles),
            nextT.Points.Count > now.Points.Count,
            s.Rounds + 1);
    }

    // TriangulationBuiltIndexed's RefineToSurfaceByInsertionIndexed with the neighbour table
    // built once and carried through the rounds: the same rounds, marks, stopping rule and
    // insertions. Insertions counts the table slots built from scratch (3 per triangle of t,
    // once); the passes' own work is theirs.
    RefineToSurfaceByInsertionCarriedCounted(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, t: UvTriangulation, c: FaceMeshingCriteria): Counted<UvTriangulation>
    {
        var planar = m.Geometry.SurfaceAt(m.SurfaceOf(f)).IsPlanarRecord;
        var x = r.BoundaryIndexOf(m.RegionTolerance(f, chart));
        var least = c.Discretization.EffectiveMinLength(m.Tolerances);
        var s = m.CarriedRefinementOf(f, t);
        var built = s.Current.Neighbours.Count;
        while (s.Rounds < 40 && s.Changed)
        {
            s = m.RefinementRoundCarried(f, r, x, chart, least, planar, c, s);
        }
        return Counted(s.Current.Positioned.Triangulation, Insertions(built));
    }

    // RefineToSurfaceByInsertionCarriedCounted's triangulation.
    RefineToSurfaceByInsertionCarried(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, t: UvTriangulation, c: FaceMeshingCriteria): UvTriangulation
        => m.RefineToSurfaceByInsertionCarriedCounted(f, r, chart, t, c).Value;
}

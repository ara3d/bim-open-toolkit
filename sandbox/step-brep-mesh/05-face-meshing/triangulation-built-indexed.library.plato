//==
// # Refinement passes over an indexed boundary (complexity sweep, chunk R3, TKT-385)
//
// Layer 05-face-meshing. TriangulationBuilt's trial, passes and refinement with the region's
// boundary indexed once per refinement (BoundaryIndexOf, uv-boundary-index.library.plato): every
// boundary-segment question reads the NextBoundaryTable (IsConstrainedIn, two table reads,
// instead of IsConstrained's O(L^2) loop search), the strictly-inside test of a candidate asks the
// segment grid (IsStrictlyInsideIndexed, instead of a scan of every boundary segment), and the
// flips around a new point use the in-circle test without allocation (InCircleOfFourSorted). Each
// answer is the original's, so the insertions are the same, in the same order.
//
// The functions differ from TriangulationBuilt's only in the region argument: a BoundaryIndex
// (which carries the region's tolerance) or its NextBoundaryTable in place of the region and the
// tolerance. Builders come after a concrete first parameter (PLATO-PRIMER.md A.6).
//
// Sections, in order:
//  - Split sides and flips
//  - A trial
//  - The passes
//  - Refinement

library TriangulationBuiltIndexed
{
    //==
    // # Split sides and flips

    // TriangulationBuilt's SurfaceFallbackIn with the region's NextBoundaryTable: the parameter
    // midpoint of triangle k's split side, or its parameter centroid when every side is a
    // boundary segment.
    SurfaceFallbackIndexed(next: Array<Integer>, k: Integer, pts: List<UvCoordinate>, points: List<Point2D>, tris: List<TriangleFace>, nb: List<Integer>): UvCoordinate
    {
        var tri = tris.At(k);
        var uvs = UvCornersIn(tri, pts);
        var j = next.SplitSideSlotOfIndexed(tri, ChartCornersIn(tri, points), [nb.At(3 * k), nb.At(3 * k + 1), nb.At(3 * k + 2)]);
        return j < 0
            ? UvCoordinate((uvs[0].U + uvs[1].U + uvs[2].U) / 3.0, (uvs[0].V + uvs[1].V + uvs[2].V) / 3.0)
            : uvs[j].UvMidpoint(uvs[(j + 1) % 3]);
    }

    // TriangulationBuilt's IsFlippableFour with the region's NextBoundaryTable and the in-circle
    // test without allocation.
    IsFlippableFourIndexed(next: Array<Integer>, a: Integer, b: Integer, c: Integer, d: Integer, pa: Point2D, pb: Point2D, pc: Point2D, pd: Point2D): Boolean
        => next.IsConstrainedIn(a, b)
            ? false
            : (TwiceSignedArea(pa, pd, pc) > 0.0
                && TwiceSignedArea(pd, pb, pc) > 0.0
                && InCircleOfFourSorted(a, b, c, d, pa, pb, pc, pd) > 0.0);

    // TriangulationBuilt's FlipCavity with the region's NextBoundaryTable: the same split and the
    // same flips, in the same order, as writes over the pass's triangles.
    FlipCavityIndexed(next: Array<Integer>, q: Integer, u: Integer, a: Integer, b: Integer, e: Integer, d: Integer, p: Point2D, points: List<Point2D>, tris: List<TriangleFace>, nb: List<Integer>): TriangleWrites
    {
        var n0 = tris.Count;
        var pi = points.Count;
        var ids = new List<Integer>();
        var vals = new List<TriangleFace>();
        if (d < 0)
        {
            ids = ids.Add(q).Add(n0).Add(n0 + 1);
            vals = vals.Add(TriangleOf(a, b, pi)).Add(TriangleOf(b, e, pi)).Add(TriangleOf(e, a, pi));
        }
        else
        {
            ids = ids.Add(q).Add(n0).Add(u).Add(n0 + 1);
            vals = vals.Add(TriangleOf(a, pi, e)).Add(TriangleOf(pi, b, e)).Add(TriangleOf(b, pi, d)).Add(TriangleOf(pi, a, d));
        }
        var sq = tris.At(q).SideSlot(a, b);
        var sides = d < 0
            ? [a, b, q, nb.At(3 * q + sq), b, e, n0, nb.At(3 * q + (sq + 1) % 3), e, a, n0 + 1, nb.At(3 * q + (sq + 2) % 3)]
            : [e, a, q, nb.At(3 * q + (sq + 2) % 3), b, e, n0, nb.At(3 * q + (sq + 1) % 3),
                d, b, u, nb.At(3 * u + tris.At(u).SideSlot(d, b)), a, d, n0 + 1, nb.At(3 * u + tris.At(u).SideSlot(a, d))];
        var queue = new List<Integer>().AddRange(sides);
        var i = 0;
        var flips = 0;
        while (i + 3 < queue.Count && flips < 4 * (n0 + 2))
        {
            var sa = queue.At(i);
            var sb = queue.At(i + 1);
            var t = queue.At(i + 2);
            var o = queue.At(i + 3);
            var w = o < 0 ? TriangleOf(sa, sb, pi) : o.TriangleIn(ids, vals, tris);
            var live = o < 0 ? false
                : (t.TriangleIn(ids, vals, tris).SideSlot(sa, sb) >= 0 && w.SideSlot(sb, sa) >= 0 && w.HasCorner(pi).Not);
            var od = live ? w.OppositeCorner(sa, sb) : -1;
            if (od < 0 ? false : next.IsFlippableFourIndexed(sa, sb, pi, od, points.At(sa), points.At(sb), p, points.At(od)))
            {
                var o1 = nb.At(3 * o + w.SideSlot(sa, od));
                var o2 = nb.At(3 * o + w.SideSlot(od, sb));
                vals = vals.Set(t.PositionIn(ids), TriangleOf(sa, od, pi));
                var oi = o.PositionIn(ids);
                if (oi < 0)
                {
                    ids = ids.Add(o);
                    vals = vals.Add(TriangleOf(od, sb, pi));
                }
                else
                {
                    vals = vals.Set(oi, TriangleOf(od, sb, pi));
                }
                queue = queue.Add(sa).Add(od).Add(t).Add(o1).Add(od).Add(sb).Add(o).Add(o2);
                flips = flips + 1;
            }
            i = i + 4;
        }
        return TriangleWrites(ids.Freeze(), vals.Freeze());
    }

    //==
    // # A trial

    // TriangulationBuilt's TryInsertionInto over the indexed boundary x (its region and
    // tolerance): the same verdict and the same writes, with the side's boundary test read from
    // x.Next and the strictly-inside test asked of x's segment grid.
    TryInsertionIndexed(m: BrepModel, f: BrepFaceIndex, x: BoundaryIndex, chart: FaceChart, least: Number, guarded: Boolean, k: Integer, uv: UvCoordinate, points: List<Point2D>, pos: List<Point3D>, tris: List<TriangleFace>, nb: List<Integer>): TrialInsertion
    {
        var p = chart.ChartPoint(uv);
        var q = p.WalkToIn(k, points, tris, nb);
        var tri = tris.At(q.Max(0));
        var j = q < 0 ? 3 : ChartCornersIn(tri, points).PlaceInTriangle(TriangleOf(0, 1, 2), p);
        var a = tri.Corner(j.Max(0));
        var b = tri.Corner(j.Max(0) + 1);
        var e = tri.Corner(j.Max(0) + 2);
        var u = (j >= 0 && j < 3) ? nb.At(3 * q + j) : -1;
        var d = u < 0 ? -1 : tris.At(u).OppositeCorner(a, b);
        var free = j == 3 ? false : (j < 0 ? true : (u >= 0 ? x.Next.IsConstrainedIn(a, b).Not : false));
        var corners = d < 0 ? [points.At(a), points.At(b), points.At(e)] : [points.At(a), points.At(b), points.At(e), points.At(d)];
        var positive = free ? corners.SplitIsPositive(0, 1, 2, d < 0 ? -1 : 3, p) : false;
        var inside = positive ? x.IsStrictlyInsideIndexed(uv) : false;
        var at = inside ? m.Geometry.Eval(m.SurfaceOf(f), uv) : Point3D(0.0, 0.0, 0.0);
        var ring = d < 0 ? [pos.At(a), pos.At(b), pos.At(e)] : [pos.At(a), pos.At(d), pos.At(b), pos.At(e)];
        var good = inside ? ring.All(z => z.Distance(at) >= least) : false;
        var cavity = good ? x.Next.FlipCavityIndexed(q, u, a, b, e, d, p, points, tris, nb) : NoTriangleWrites(0);
        var fan = good ? q.FanOf(tris.Count, cavity, nb) : [0].Take(0);
        var angles = (good && guarded) ? fan.CavityAngles(cavity, points.Count, at, pos, tris) : [1.0, 0.0];
        var kept = good ? angles[0] > angles[1] : false;
        return TrialInsertion(kept, uv, p, at,
            kept ? cavity : NoTriangleWrites(0),
            kept ? 2 : 0,
            kept ? fan.CavityNeighbours(cavity, points.Count, nb, tris) : SlotWrites([0].Take(0), [0].Take(0)),
            inside ? 1 : 0);
    }

    //==
    // # The passes

    // TriangulationBuilt's SurfacePassBuiltCounted over the indexed boundary x, with the same
    // work counted: Evaluations for the trials' surface evaluations, Insertions for the builder
    // elements the kept trials write.
    SurfacePassIndexedCounted(m: BrepModel, f: BrepFaceIndex, x: BoundaryIndex, chart: FaceChart, least: Number, t: PositionedTriangulation, surface: Array<Boolean>): Counted<PositionedTriangulation>
    {
        var u0 = t.Triangulation;
        var pts = new List<UvCoordinate>().AddRange(u0.Points);
        var points = new List<Point2D>().AddRange(u0.Points.Map(z => chart.ChartPoint(z)));
        var pos = new List<Point3D>().AddRange(t.Positions);
        var tris = new List<TriangleFace>().AddRange(u0.Triangles);
        var nb = new List<Integer>().AddRange(NeighbourSlots(u0.Triangles, u0.Points.Count));
        var evaluations = 0;
        var written = 0;
        var k = 0;
        while (k < u0.Triangles.Count)
        {
            if (surface[k] ? tris.At(k) == u0.Triangles[k] : false)
            {
                var centre = chart.Circumcentre(ChartCornersIn(tris.At(k), points), TriangleOf(0, 1, 2));
                var first = m.TryInsertionIndexed(f, x, chart, least, false, k, centre, points, pos, tris, nb);
                var uv = first.Kept ? centre : x.Next.SurfaceFallbackIndexed(k, pts, points, tris, nb);
                var next = first.Kept ? first : m.TryInsertionIndexed(f, x, chart, least, false, k, uv, points, pos, tris, nb);
                evaluations = evaluations + first.Evaluations + (first.Kept ? 0 : next.Evaluations);
                if (next.Kept)
                {
                    pts = pts.Add(next.Point);
                    points = points.Add(next.Chart);
                    pos = pos.Add(next.Position);
                    tris = next.WithTriangles(tris);
                    nb = next.WithNeighbours(nb);
                    written = written + next.Written;
                }
            }
            k = k + 1;
        }
        var added = pts.Count - u0.Points.Count;
        var value = PositionedTriangulation(
            UvTriangulation(pts.Freeze(), u0.Sources.Concatenate(added.MapRange(i => UvPointSource.Interior)), tris.Freeze(), u0.Quads),
            pos.Freeze());
        return Counted(value, Evaluations(evaluations).Add(Insertions(written)));
    }

    // SurfacePassIndexedCounted's triangulation.
    SurfacePassIndexed(m: BrepModel, f: BrepFaceIndex, x: BoundaryIndex, chart: FaceChart, least: Number, t: PositionedTriangulation, surface: Array<Boolean>): PositionedTriangulation
        => m.SurfacePassIndexedCounted(f, x, chart, least, t, surface).Value;

    // TriangulationBuilt's AnglePassBuiltCounted over the indexed boundary x, with the same work
    // counted.
    AnglePassIndexedCounted(m: BrepModel, f: BrepFaceIndex, x: BoundaryIndex, chart: FaceChart, least: Number, t: PositionedTriangulation, bad: Array<Integer>): Counted<PositionedTriangulation>
    {
        var u0 = t.Triangulation;
        var pts = new List<UvCoordinate>().AddRange(u0.Points);
        var points = new List<Point2D>().AddRange(u0.Points.Map(z => chart.ChartPoint(z)));
        var pos = new List<Point3D>().AddRange(t.Positions);
        var tris = new List<TriangleFace>().AddRange(u0.Triangles);
        var nb = new List<Integer>().AddRange(NeighbourSlots(u0.Triangles, u0.Points.Count));
        var evaluations = 0;
        var written = 0;
        var i = 0;
        while (i < bad.Count)
        {
            var k = bad[i];
            if (tris.At(k) == u0.Triangles[k])
            {
                var tri = tris.At(k);
                var candidates = chart.AngleCandidates(ChartCornersIn(tri, points), UvCornersIn(tri, pts), TriangleOf(0, 1, 2));
                var n = 0;
                while (n < candidates.Count)
                {
                    var next = m.TryInsertionIndexed(f, x, chart, least, true, k, candidates[n], points, pos, tris, nb);
                    evaluations = evaluations + next.Evaluations;
                    if (next.Kept)
                    {
                        pts = pts.Add(next.Point);
                        points = points.Add(next.Chart);
                        pos = pos.Add(next.Position);
                        tris = next.WithTriangles(tris);
                        nb = next.WithNeighbours(nb);
                        written = written + next.Written;
                        n = candidates.Count;
                    }
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        var added = pts.Count - u0.Points.Count;
        var value = PositionedTriangulation(
            UvTriangulation(pts.Freeze(), u0.Sources.Concatenate(added.MapRange(j => UvPointSource.Interior)), tris.Freeze(), u0.Quads),
            pos.Freeze());
        return Counted(value, Evaluations(evaluations).Add(Insertions(written)));
    }

    // AnglePassIndexedCounted's triangulation.
    AnglePassIndexed(m: BrepModel, f: BrepFaceIndex, x: BoundaryIndex, chart: FaceChart, least: Number, t: PositionedTriangulation, bad: Array<Integer>): PositionedTriangulation
        => m.AnglePassIndexedCounted(f, x, chart, least, t, bad).Value;

    //==
    // # Refinement

    // TriangulationBuilt's RefineToSurfaceByInsertionBuilt with the region's boundary indexed
    // once (BoundaryIndexOf under the region tolerance) and the passes over the index: the same
    // rounds, marks, stopping rule and insertions.
    RefineToSurfaceByInsertionIndexed(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, t: UvTriangulation, c: FaceMeshingCriteria): UvTriangulation
    {
        var planar = m.Geometry.SurfaceAt(m.SurfaceOf(f)).IsPlanarRecord;
        var x = r.BoundaryIndexOf(m.RegionTolerance(f, chart));
        var least = c.Discretization.EffectiveMinLength(m.Tolerances);
        var none = [0].Take(0);
        var current = m.Positioned(f, t);
        var known = t.Triangles.Map(z => false);
        var refused = t.Triangles.Map(z => false);
        var good = t.Triangles.Map(z => false);
        var pass = 0;
        var changed = true;
        while (pass < 40 && changed)
        {
            var now = current.Triangulation;
            var surface = planar ? now.Triangles.Map(z => false) : m.NeedsRefinementCached(f, r, current, known, c);
            var mid = m.SurfacePassIndexed(f, x, chart, least, current, surface);
            var carried = now.Triangles.CarriedMarks(refused, none, mid.Triangulation.Triangles);
            var goodMid = now.Triangles.CarriedMarks(good, none, mid.Triangulation.Triangles);
            var bad = m.BelowAngleKnown(f, mid.Triangulation, carried, goodMid);
            var next = m.AnglePassIndexed(f, x, chart, least, mid, bad);
            refused = mid.Triangulation.Triangles.CarriedMarks(carried, bad, next.Triangulation.Triangles);
            good = mid.Triangulation.Triangles.CarriedMarks(mid.Triangulation.AngleGoodMarks(carried, bad), none, next.Triangulation.Triangles);
            known = KnownGood(now, surface, next.Triangulation);
            changed = next.Triangulation.Points.Count > now.Points.Count;
            current = next;
            pass = pass + 1;
        }
        return current.Triangulation;
    }
}

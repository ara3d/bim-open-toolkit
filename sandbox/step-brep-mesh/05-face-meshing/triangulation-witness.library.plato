//==
// # Triangulated witnesses: building them, and the claims the laws state on them (chunk L4)
//
// TriangulatedAt builds one face's witness, binding the region, chart and constrained
// triangulation once and refining that triangulation once. The claims take the built values
// (a region, its chart, a triangulation, a face mesh) and bind any value they read more than
// once, such as the region's tolerance, before quantifying over points or elements. Each claim
// states exactly what the original law of TriangulationLaws or FaceMeshingLaws states on one face,
// unless its comment says otherwise. CanTriangulateFaceRegionOnce is CanTriangulateFace with the
// region built once instead of twice.
//
// Sections, in order:
//  - Building a witness
//  - The constrained triangulation
//  - Refinement
//  - Triangulations and lifting
//  - Face meshes

library TriangulatedWitnesses
{
    //==
    // # Building a witness

    // Face `face` of sample model `sample` (TriSampleModel), triangulated and meshed once under
    // the sample criteria, named `name`. Precondition: the face is triangulable
    // (CanTriangulateFace; Law_Perf_TriangulatedWitnessesCoverTheSamples).
    TriangulatedAt(sample: Integer, name: String, face: Integer): TriangulatedWitness
    {
        var m = TriSampleModel(sample);
        var d = m.TriDiscretizations;
        var c = TriCriteria(0);
        var f = BrepFaceIndex(face);
        var r = m.RegionOf(f, d, c);
        var chart = m.ChartOf(f, r);
        var cdt = r.TriangulateRegionCdt(chart);
        return TriangulatedWitness(name, sample, m, f, d, r, chart, cdt,
            m.RefineToSurfaceByInsertion(f, r, chart, cdt, c), m.MeshFace(f, d, c));
    }

    // The number of faces of sample model k, in TriSampleModel's order: the unit box, the
    // cylinder, the block with a through hole, the hollow box, the quarter sector, the
    // 2 x 3 x 4 box. The witness list has one TriangulatedWitness per face.
    TriSampleFaceCount(k: Integer): Integer
        => [6, 3, 10, 12, 5, 6][((k % 6) + 6) % 6];

    // Whether region r of face f is simple under its own tolerance: the second half of
    // CanTriangulateFace, given the region.
    IsSimpleUnderItsTolerance(m: BrepModel, f: BrepFaceIndex, r: UvRegion): Boolean
        => r.IsSimpleRegion(m.RegionTolerance(f, m.ChartOf(f, r)));

    // CanTriangulateFace with face f's region built once: RegionOf's precondition, and a region
    // simple under its tolerance. Removes: the second RegionOf call CanTriangulateFace makes for
    // the chart (face-meshing.library.plato, CanTriangulateFace).
    CanTriangulateFaceRegionOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Boolean
        => m.CanRegion(f, d, c) ? m.IsSimpleUnderItsTolerance(f, m.RegionOf(f, d, c)) : false;

    //==
    // # The constrained triangulation

    // Law_CdtKeepsBoundary's claim on triangulation t of region r: the boundary points kept with
    // their sources, in order, and no point added.
    CdtKeepsBoundaryOn(r: UvRegion, t: UvTriangulation): Boolean
        => t.Points.Count == r.BoundaryCount
            && r.BoundaryCount.Range.All(i => Law_TriangulationKeepsBoundary(r, t, i));

    // Law_CdtKeepsEverySegment's claim: every boundary segment of r is a side of exactly one
    // triangle of t, in the boundary's direction.
    KeepsEverySegmentOn(r: UvRegion, t: UvTriangulation): Boolean
        => r.NumberOfLoops.Range.All(q => r.LoopAt(q).Points.Count.Range.All(i =>
            Law_BoundarySegmentIsElementSide(r, t, q, i)));

    // Law_CdtIsConforming's claim: no quads, every side that is not a boundary segment shared by
    // exactly two triangles run opposite ways, and every point a corner. The sides are checked by
    // the neighbour table (SidesSharedByNeighbours, as MeetsRefineContract does) in place of a
    // SideCount scan per side: equivalent on interior sides, and it also forbids a boundary
    // side run twice the same way, which Law_CdtKeepsEverySegment forbids already.
    CdtIsConformingOn(r: UvRegion, t: UvTriangulation): Boolean
        => t.Quads.Count == 0
            && ((t.CornersInRange && r.IsIndexedRegion) ? r.SidesSharedByNeighbours(t) : true)
            && t.Points.Count.Range.All(i => EveryPointIsACorner(t, i));

    // Law_CdtPositiveOrientation's claim: every triangle of t positive in chart.
    CdtPositiveOn(r: UvRegion, chart: FaceChart, t: UvTriangulation): Boolean
        => t.Triangles.All(x => TwiceSignedArea(chart.ChartPoint(r.BoundaryPoints[x.A]),
            chart.ChartPoint(r.BoundaryPoints[x.B]), chart.ChartPoint(r.BoundaryPoints[x.C])) > 0.0);

    //==
    // # Refinement

    // Law_TriangulationAddsOnlyInteriorPoints at point i, given the region's tolerance and
    // whether the face is intact, which the law recomputes per point.
    AddsOnlyInteriorPointAt(r: UvRegion, t: UvTriangulation, tol: UvTolerance, intact: Boolean, i: Integer): Boolean
        => (intact && i >= r.BoundaryCount && t.Points.IsValidIndex(i) && t.Sources.IsValidIndex(i))
            ? t.Sources[i] == UvPointSource.Interior && r.IsStrictlyInside(t.Points[i], tol)
            : true;

    // Law_ElementAreasSumToRegionArea, given the region's tolerance.
    AreasSumOn(m: BrepModel, f: BrepFaceIndex, r: UvRegion, t: UvTriangulation, tol: UvTolerance): Boolean
        => (m.IsFaceIntact(f) && t.CornersInRange)
            ? (t.TotalChartArea(m.IsChartMirrored(f)) - r.ChartSignedArea(m.IsChartMirrored(f))).Abs <= r.AreaTolerance(tol)
            : true;

    // MeetsRefineContract (TriangulationLaws) with the region's tolerance computed once from the
    // chart, instead of once per point and once more for the areas (RegionToleranceOf builds the
    // chart again each time).
    MeetsRefineContractOn(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, t: UvTriangulation): Boolean
    {
        var tol = m.RegionTolerance(f, chart);
        var intact = m.IsFaceIntact(f);
        return r.BoundaryCount.Range.All(i => Law_TriangulationKeepsBoundary(r, t, i))
            && t.Points.Count.Range.All(i => AddsOnlyInteriorPointAt(r, t, tol, intact, i))
            && t.ElementCount.Range.All(e => m.Law_ElementPositiveInChart(f, t, ElementIndex(e))
                && m.Law_ElementSpansBelowHalfPeriod(f, t, ElementIndex(e))
                && m.Law_ElementLiftsFacingFaceNormal(f, t, ElementIndex(e)))
            && r.KeepsEverySegmentOn(t)
            && r.SidesSharedByNeighbours(t)
            && m.AreasSumOn(f, r, t, tol)
            && t.Quads.Count == 0;
    }

    //==
    // # Triangulations and lifting

    // Law_TriangulationCornersInRange at every element of t, and at the first index past them.
    CornersInRangeOn(t: UvTriangulation): Boolean
        => (t.ElementCount + 1).Range.All(k => TriangulationCornersInRange(t, ElementIndex(k)));

    // Law_EveryPointIsACorner at every point of t.
    EveryPointIsACornerOn(t: UvTriangulation): Boolean
        => t.Points.Count.Range.All(i => EveryPointIsACorner(t, i));

    // Law_LiftKeepsPoints at every point of t, fm being t lifted.
    LiftKeepsPointsOn(t: UvTriangulation, fm: FaceMesh): Boolean
        => t.Points.Count.Range.All(i => t.LiftKeepsPoints(fm, i));

    //==
    // # Face meshes

    // Law_LocalVertexInRange at every point of fm.
    LocalVertexInRangeOn(fm: FaceMesh): Boolean
        => fm.LocalVertex.Count.Range.All(i => fm.LocalVertexInRange(VertexIndex(i)));

    // Law_LocalVertexSurjective at every local vertex of fm.
    LocalVertexSurjectiveOn(fm: FaceMesh): Boolean
        => fm.Positions.Count.Range.All(v => fm.LocalVertexSurjective(VertexIndex(v)));

    // Law_ProvenanceMatchesSource at every point of fm.
    ProvenanceMatchesSourceOn(d: EdgeDiscretizations, fm: FaceMesh): Boolean
        => fm.LocalVertex.Count.Range.All(i => d.ProvenanceMatchesSource(fm, VertexIndex(i)));

    // Law_RequestsNameFaceEdges at every request of outcome o of face f.
    RequestsNameFaceEdgesOn(m: BrepModel, f: BrepFaceIndex, o: FaceMeshOutcome): Boolean
        => o.Requests.Count.Range.All(q => m.RequestNamesFaceEdge(f, o, q));
}

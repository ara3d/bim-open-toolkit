//==
// # The quad grid kept within the chordal bound (TKT-415, the keep half)
//
// The merged F1 law Law_V1Faces_GridRefusedWhereCurvedBothWays states the refusal half: no grid
// on a face curved both ways. This states the other half on the grid cases of
// grid-chordal.laws.plato whose four-sided faces are planes, a flat B-spline patch, cylinders
// and a cone: each cell of their grid is within SurfaceChordal (a cell of a face curved one way
// deviates by the sagitta its boundary arcs already meet), so QuadGridOnSides keeps the grid.
//
// Sections, in order:
//  - The keep half

library FaceMeshingGridKeepLaws
{
    //==
    // # The keep half

    // Whether case w's four-sided faces are flat or curved one way only: the unit box, the flat
    // B-spline patch solid, the cylinders and the cone.
    IsCurvedAtMostOneWay(w: GridCase): Boolean
        => w.Name == "UnitBox" || w.Name == "BSplinePatchSolid(0)" || w.Name == "Cylinder"
            || w.Name == "QuarterCylinder" || w.Name == "Cone";

    // On a case curved at most one way, every four-sided face keeps its quad grid, and that grid
    // is within the chordal bound (FaceMeshWithinChordal on the lifted grid).
    Law_V1Faces_GridKeptWhereCurvedAtMostOneWay(w: GridCase): Boolean
        => w.IsCurvedAtMostOneWay
            ? w.FourSidedFaces.All(f => w.GridKeptOn(f, w.Model.RegionOf(f, w.Discretizations, w.Criteria)))
            : true;

    // Law_V1Faces_GridKeptWhereCurvedAtMostOneWay on face f of case w, its region r.
    GridKeptOn(w: GridCase, f: BrepFaceIndex, r: UvRegion): Boolean
        => w.KeptGridWithin(f, w.Model.QuadGridOnSides(f, w.Discretizations, r, w.Criteria, w.Model.QuadSidesOf(f, r)));

    // Whether grid outcome g is a grid whose lifted mesh is within the chordal bound.
    KeptGridWithin(w: GridCase, f: BrepFaceIndex, g: QuadGridOutcome): Boolean
        => match (g) {
            NoGrid => false;
            CountsDiffer(floors) => false;
            Grid(mesh) => w.FaceMeshWithinChordal(w.Model.Lift(f, w.Discretizations, mesh));
        };
}

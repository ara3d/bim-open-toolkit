//==
// # Constrained Delaunay triangulation by the in-circle determinant (TKT-343)
//
// Layer 05-face-meshing. Replaces UvDelaunay's flip test, which compared an Atan2 angle sum with
// pi + 1e-9, by the in-circle determinant in Number (no exact predicates, owner decision
// 2026-10-18), and flips only on a strictly positive determinant. The determinant of four points
// is evaluated in the order of their indices and its sign corrected by the parity of the
// permutation (InCircleOf), so the test on an edge and the test on the edge a flip puts in its
// place are exact negatives of one rounded number: cocircular points, and points whose
// determinant is rounding noise, never flip back and forth.
//
// TriangulateRegionCdt seeds with the library's ear clipping and hole bridging (any
// triangulation that keeps the boundary segments will do) and flips to the constrained Delaunay
// triangulation of the boundary points in the chart (Lawson 1977; de Berg et al., Computational
// Geometry, 9.1 and 9.6). Flips change no point and keep every triangle positive, because a flip
// happens only on a strictly convex quadrilateral.
//
// Sections, in order:
//  - The in-circle determinant
//  - The flip test
//  - The triangulation

library TriangulationCdt
{
    //==
    // # The in-circle determinant

    // The in-circle determinant of d against the triangle (a, b, c): positive when d lies inside
    // the circle through a, b and c taken counter-clockwise, zero on it, negative outside; the
    // sign flips with the triangle's orientation. The 3 x 3 determinant of the rows
    // (x - d.x, y - d.y, (x - d.x)^2 + (y - d.y)^2) for a, b and c.
    InCircle(a: Point2D, b: Point2D, c: Point2D, d: Point2D): Number
    {
        var adx = a.X - d.X;
        var ady = a.Y - d.Y;
        var bdx = b.X - d.X;
        var bdy = b.Y - d.Y;
        var cdx = c.X - d.X;
        var cdy = c.Y - d.Y;
        var ad = adx * adx + ady * ady;
        var bd = bdx * bdx + bdy * bdy;
        var cd = cdx * cdx + cdy * cdy;
        return adx * (bdy * cd - bd * cdy) - ady * (bdx * cd - bd * cdx) + ad * (bdx * cdy - bdy * cdx);
    }

    // The sum of the absolute values of InCircle's terms: the magnitude its rounding error is
    // proportional to.
    InCircleScale(a: Point2D, b: Point2D, c: Point2D, d: Point2D): Number
    {
        var adx = (a.X - d.X).Abs;
        var ady = (a.Y - d.Y).Abs;
        var bdx = (b.X - d.X).Abs;
        var bdy = (b.Y - d.Y).Abs;
        var cdx = (c.X - d.X).Abs;
        var cdy = (c.Y - d.Y).Abs;
        var ad = adx * adx + ady * ady;
        var bd = bdx * bdx + bdy * bdy;
        var cd = cdx * cdx + cdy * cdy;
        return adx * (bdy * cd + bd * cdy) + ady * (bdx * cd + bd * cdx) + ad * (bdx * cdy + bdy * cdx);
    }

    // InCircle of points a, b, c, d (indices into points), evaluated with the four in increasing
    // index order and multiplied by the sign of the permutation from (a, b, c, d) to that order.
    // In exact arithmetic it equals InCircle in the given order (the determinant alternates); in
    // Number every ordering of the same four indices gives the same magnitude.
    InCircleOf(points: Array<Point2D>, a: Integer, b: Integer, c: Integer, d: Integer): Number
    {
        var ids = [a, b, c, d];
        var inversions = 4.Range.Reduce(0, (n, i) => 4.Range.Reduce(n, (m, j) => (i < j && ids[i] > ids[j]) ? m + 1 : m));
        var s = ids.Sort((x, y) => x <= y);
        var det = InCircle(points[s[0]], points[s[1]], points[s[2]], points[s[3]]);
        return inversions % 2 == 0 ? det : 0.0 - det;
    }

    //==
    // # The flip test

    // Whether edge j of triangle t (from a to b, c opposite), shared with triangle u (d
    // opposite), is flipped to the edge from c to d: not a boundary segment, the quadrilateral
    // (a, d, b, c) strictly convex in the chart, and d strictly inside the circle through a, b
    // and c (InCircleOf strictly positive).
    IsFlippableCdt(r: UvRegion, points: Array<Point2D>, t: TriangleFace, j: Integer, u: TriangleFace): Boolean
    {
        var a = t.Corner(j);
        var b = t.Corner(j + 1);
        var c = t.Corner(j + 2);
        var d = u.OppositeCorner(a, b);
        return (d < 0 || r.IsConstrained(a, b))
            ? false
            : (TwiceSignedArea(points[a], points[d], points[c]) > 0.0
                && TwiceSignedArea(points[d], points[b], points[c]) > 0.0
                && InCircleOf(points, a, b, c, d) > 0.0);
    }

    //==
    // # The triangulation

    // The constrained Delaunay triangulation of region r in its chart, for the contract
    // TriangulateRegion: the library's ear-clipped seed (holes bridged, point holes inserted
    // after) flipped by UvDelaunay's Delaunayed. Every boundary point kept in BoundaryPoints order, every
    // triangle positive in the chart, every boundary segment a side, no point added, no quads.
    TriangulateRegionCdt(r: UvRegion, chart: FaceChart): UvTriangulation
    {
        var points = r.BoundaryPoints.Map(uv => chart.ChartPoint(uv));
        var outer = r.Outer.Points.Count.Range;
        var holes = r.Holes.Count.Range.FlatMap(h =>
            r.Holes[h].Points.Count >= 3 ? [h] : r.Holes.Count.Range.Take(0));
        var bySide = holes.Sort((a, b) => r.HoleRightmost(points, a) >= r.HoleRightmost(points, b));
        var ring = bySide.Reduce(outer, (current, h) => current.HoleBridged(r.HoleRing(h), points, r.AllRingSegments(points)));
        var clipped = ring.EarClipped(points);
        var pointHoles = r.Holes.Count.Range.FlatMap(h =>
            r.Holes[h].Points.Count < 3 ? r.HoleRing(h) : r.Holes.Count.Range.Take(0));
        var triangles = r.Delaunayed(points, pointHoles.Reduce(clipped, (ts, p) => ts.WithPointInserted(p, points)));
        return UvTriangulation(r.BoundaryPoints, r.BoundarySources, triangles, [QuadFace(VertexIndex(0), VertexIndex(0), VertexIndex(0), VertexIndex(0))].Take(0));
    }
}

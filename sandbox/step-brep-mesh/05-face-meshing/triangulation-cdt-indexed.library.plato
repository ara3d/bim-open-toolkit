//==
// # The constrained Delaunay seed without quadratic scans (complexity sweep, chunk R4)
//
// TriangulateRegionCdt (triangulation-cdt.library.plato) seeds its flips with ear clipping
// after hole bridging, and both stages scan more than they need. It rebuilt AllRingSegments for
// every hole, its Sort comparator recomputed HoleRightmost on every comparison, HoleBridged
// asked BridgeIsClear (every boundary segment) of every ring position, O(H B^2) for H holes and
// B boundary points, and EarClipped restarted its ear search at position 0 every round and
// copied the ring for every ear, each IsEar scanning the whole ring: O(B^2) typical, O(B^3)
// worst.
//
// TriangulateRegionCdtIndexed gives the same triangles in the same order:
//  - the segments, a grid of them, and each hole's rightmost x are computed once;
//  - a bridge tests ring positions nearest first (a stable sort by distance) and stops at the
//    first clear one, which is the position HoleBridged's fold picks (least distance, earliest
//    position among equal distances); a test asks BridgeIsClear itself, of only the segments
//    the grid lists near the bridge;
//  - ear clipping runs on a linked ring (prev and next slots) and finds the ear EarClipped
//    finds, the first ear by position. A frontier slot moves forward once over the ring; every
//    slot behind it is a known non-ear unless it is pending in a min-heap. A slot stops being a
//    known non-ear only when its triangle changes (it was beside the clipped ear) or when the
//    point that blocked it leaves the ring (it is then woken from that point's watch list), so
//    each round tests the heap's pending slots below the frontier, least first, then the
//    frontier. An ear test asks IsEar's predicate of only the points the grid lists near the
//    triangle, skipping points no longer in the ring.
//
// The grids list every item within one cell of a query box, so an item a test skips is at
// least a cell away from the bridge or the triangle, where neither predicate can hold.
//
// Sections, in order:
//  - The grid
//  - Bridging the holes
//  - Ear clipping on a linked ring
//  - The triangulation

library TriangulationCdtIndexed
{
    //==
    // # The grid

    // The most cells an item's box may cover and still be entered in the grid; a wider item is
    // listed in Everywhere instead, so one long segment cannot fill the grid.
    ChartGridWideCells(_: ChartGrid): Integer
        => 16;

    // The cell, along an axis of count cells from origin with side h, that holds coordinate x,
    // moved by shift cells and clamped to the grid.
    GridCellClamped(x: Number, origin: Number, h: Number, count: Integer, shift: Integer): Integer
        => (GridCellNumber(x, origin, h) + shift.ToNumber).Max(0.0).Min((count - 1).ToNumber).ToInteger;

    // True when both corners of a box are finite.
    IsFiniteBox(low: Point2D, high: Point2D): Boolean
        => low.X.IsFinite && low.Y.IsFinite && high.X.IsFinite && high.Y.IsFinite;

    // The low corner of the box around a and b.
    LowCorner(a: Point2D, b: Point2D): Point2D
        => Point2D(a.X.Min(b.X), a.Y.Min(b.Y));

    // The high corner of the box around a and b.
    HighCorner(a: Point2D, b: Point2D): Point2D
        => Point2D(a.X.Max(b.X), a.Y.Max(b.Y));

    // The grid of the items with boxes from lows[i] to highs[i]: about one cell per item over
    // the finite boxes' extent, the side the extent over the ceiling of the square root of the
    // item count. With no finite box, or an extent that overflows, every item is in Everywhere.
    ChartGridOf(lows: Array<Point2D>, highs: Array<Point2D>): ChartGrid
    {
        var n = lows.Count;
        var finite = n.MapRange(i => IsFiniteBox(lows[i], highs[i]));
        var placed = n.Range.FlatMap(i => finite[i] ? [i] : [i].Take(0));
        var o = Point2D(placed.Reduce(Number.MaxValue, (v, i) => v.Min(lows[i].X)), placed.Reduce(Number.MaxValue, (v, i) => v.Min(lows[i].Y)));
        var top = Point2D(placed.Reduce(0.0 - Number.MaxValue, (v, i) => v.Max(highs[i].X)), placed.Reduce(0.0 - Number.MaxValue, (v, i) => v.Max(highs[i].Y)));
        var extent = (top.X - o.X).Max(top.Y - o.Y);
        var usable = placed.Count > 0 ? extent.IsFinite : false;
        var side = usable ? extent / n.ToNumber.Sqrt.Ceiling : 1.0;
        var h = side > 0.0 ? side : 1.0;
        var columns = usable ? GridCellNumber(top.X, o.X, h).ToInteger + 1 : 1;
        var rows = usable ? GridCellNumber(top.Y, o.Y, h).ToInteger + 1 : 1;
        var c0 = n.MapRange(i => finite[i] ? GridCellClamped(lows[i].X, o.X, h, columns, 0) : 0);
        var c1 = n.MapRange(i => finite[i] ? GridCellClamped(highs[i].X, o.X, h, columns, 0) : 0);
        var r0 = n.MapRange(i => finite[i] ? GridCellClamped(lows[i].Y, o.Y, h, rows, 0) : 0);
        var r1 = n.MapRange(i => finite[i] ? GridCellClamped(highs[i].Y, o.Y, h, rows, 0) : 0);
        var widest = ChartGrid.ChartGridWideCells;
        var wide = n.MapRange(i => (usable && finite[i]) ? (c1[i] - c0[i] + 1) * (r1[i] - r0[i] + 1) > widest : true);
        var cells = columns * rows;
        var starts = new Buffer<Integer>(cells + 1);
        var cell = 0;
        while (cell <= cells)
        {
            starts = starts.Set(cell, 0);
            cell = cell + 1;
        }
        var item = 0;
        while (item < n)
        {
            if (wide[item].Not)
            {
                var row = r0[item];
                while (row <= r1[item])
                {
                    var column = c0[item];
                    while (column <= c1[item])
                    {
                        var counted = row * columns + column + 1;
                        starts = starts.Set(counted, starts.At(counted) + 1);
                        column = column + 1;
                    }
                    row = row + 1;
                }
            }
            item = item + 1;
        }
        cell = 1;
        while (cell <= cells)
        {
            starts = starts.Set(cell, starts.At(cell) + starts.At(cell - 1));
            cell = cell + 1;
        }
        var fill = new Buffer<Integer>(cells);
        cell = 0;
        while (cell < cells)
        {
            fill = fill.Set(cell, starts.At(cell));
            cell = cell + 1;
        }
        var items = new Buffer<Integer>(starts.At(cells));
        item = 0;
        while (item < n)
        {
            if (wide[item].Not)
            {
                var y = r0[item];
                while (y <= r1[item])
                {
                    var x = c0[item];
                    while (x <= c1[item])
                    {
                        var at = y * columns + x;
                        items = items.Set(fill.At(at), item);
                        fill = fill.Set(at, fill.At(at) + 1);
                        x = x + 1;
                    }
                    y = y + 1;
                }
            }
            item = item + 1;
        }
        return ChartGrid(o, h, columns, rows, starts.Freeze(), items.Freeze(), n.Range.FlatMap(i => wide[i] ? [i] : [i].Take(0)), n);
    }

    // The items of one cell.
    CellItems(g: ChartGrid, cell: Integer): Array<Integer>
        => g.Items.Slice(g.Starts[cell], g.Starts[cell + 1]);

    // The items listed in the cells that meet the box from low to high grown by one cell on
    // every side, then Everywhere; every item when the box is not finite. An item covering
    // several of the cells is listed once per cell.
    ItemsNear(g: ChartGrid, low: Point2D, high: Point2D): Array<Integer>
        => IsFiniteBox(low, high) ? g.ItemsInCells(low, high).Concatenate(g.Everywhere) : g.ItemCount.Range;

    // The items listed in the cells that meet the finite box from low to high grown by one cell
    // on every side.
    ItemsInCells(g: ChartGrid, low: Point2D, high: Point2D): Array<Integer>
    {
        var c0 = GridCellClamped(low.X, g.Origin.X, g.Side, g.Columns, -1);
        var c1 = GridCellClamped(high.X, g.Origin.X, g.Side, g.Columns, 1);
        var r0 = GridCellClamped(low.Y, g.Origin.Y, g.Side, g.Rows, -1);
        var r1 = GridCellClamped(high.Y, g.Origin.Y, g.Side, g.Rows, 1);
        var width = c1 - c0 + 1;
        return ((r1 - r0 + 1) * width).Range.FlatMap(k => g.CellItems((r0 + k / width) * g.Columns + c0 + k % width));
    }

    //==
    // # Bridging the holes

    // The grid of the segments AllRingSegments codes (a * N + b, N the point count), each
    // entered by the box of its two ends.
    SegmentGridOf(segments: Array<Integer>, points: Array<Point2D>): ChartGrid
        => ChartGridOf(segments.Map(code => LowCorner(points[code / points.Count], points[code % points.Count])),
            segments.Map(code => HighCorner(points[code / points.Count], points[code % points.Count])));

    // BridgeIsClear of the bridge from v to m, asked of only the segments grid lists near it.
    BridgeIsClearOnGrid(v: Integer, m: Integer, points: Array<Point2D>, segments: Array<Integer>, grid: ChartGrid): Boolean
        => v.BridgeIsClear(m, points, grid.ItemsNear(LowCorner(points[v], points[m]), HighCorner(points[v], points[m])).Map(s => segments[s]));

    // HoleBridged's ring, with the bridges tested counted as Insertions. The ring positions are
    // tested nearest to M first, ties in position order, and the first clear one is V: the
    // position HoleBridged's fold keeps. When a distance is not finite the stable sort's order
    // is not the fold's, so every position is tested and the fold picks, as HoleBridged does.
    HoleBridgedIndexedCounted(ring: Array<Integer>, hole: Array<Integer>, points: Array<Point2D>, segments: Array<Integer>, grid: ChartGrid): Counted<Array<Integer>>
    {
        var start = hole.Count.Range.Reduce(0, (best, i) => points[hole[i]].X > points[hole[best]].X ? i : best);
        var m = hole[start];
        var d = ring.Map(x => points[x].Distance(points[m]));
        var at = -1;
        var tests = 0;
        if (d.All(x => x.IsFinite))
        {
            var order = ring.Count.Range.Sort((a, b) => d[a] <= d[b]);
            var k = 0;
            while (k < order.Count && at < 0)
            {
                tests = tests + 1;
                if (ring[order[k]].BridgeIsClearOnGrid(m, points, segments, grid))
                {
                    at = order[k];
                }
                k = k + 1;
            }
        }
        else
        {
            var visible = ring.Count.Range.FlatMap(j => ring[j].BridgeIsClearOnGrid(m, points, segments, grid) ? [j] : ring.Take(0));
            tests = ring.Count;
            at = visible.Reduce(-1, (best, j) => best < 0 ? j : (d[j] < d[best] ? j : best));
        }
        var loop = (hole.Count + 1).MapRange(i => hole[(start + i) % hole.Count]);
        return Counted(at < 0
            ? ring
            : ring.Take(at + 1).Concatenate(loop).Concatenate([ring[at]]).Concatenate(ring.Skip(at + 1)),
            Insertions(tests));
    }

    // The holes of three or more points, rightmost first, bridged into the outer loop in turn:
    // TriangulateRegionCdt's ring, with the bridges tested counted as Insertions. The segments,
    // their grid and each hole's rightmost x are computed once.
    CdtRingIndexedCounted(r: UvRegion, points: Array<Point2D>): Counted<Array<Integer>>
    {
        var holes = r.Holes.Count.Range.FlatMap(h => r.Holes[h].Points.Count >= 3 ? [h] : [h].Take(0));
        var keys = r.Holes.Count.MapRange(h => r.Holes[h].Points.Count >= 3 ? r.HoleRightmost(points, h) : 0.0);
        var bySide = holes.Sort((a, b) => keys[a] >= keys[b]);
        var segments = r.AllRingSegments(points);
        var grid = segments.SegmentGridOf(points);
        var ring = r.Outer.Points.Count.Range;
        var work = Insertions(0);
        var k = 0;
        while (k < bySide.Count)
        {
            var bridged = ring.HoleBridgedIndexedCounted(r.HoleRing(bySide[k]), points, segments, grid);
            ring = bridged.Value;
            work = work.Add(bridged.Work);
            k = k + 1;
        }
        return Counted(ring, work);
    }

    //==
    // # Ear clipping on a linked ring

    // The grid of the points, each entered at its own position.
    PointGridOf(points: Array<Point2D>): ChartGrid
        => ChartGridOf(points, points);

    // EarClipped's triangles, in its order, with the ear tests counted as Insertions. Slot i
    // holds ring[i] for good; prev and next link the slots still in the ring, and the ring's
    // position order is the slots' order. Precondition: grid is PointGridOf(points).
    EarClippedIndexedCounted(ring: Array<Integer>, points: Array<Point2D>, grid: ChartGrid): Counted<Array<TriangleFace>>
    {
        var n = ring.Count;
        var next = new Buffer<Integer>(n);
        var prev = new Buffer<Integer>(n);
        var version = new Buffer<Integer>(n);
        var pending = new Buffer<Boolean>(n);
        var dead = new Buffer<Boolean>(n);
        var i = 0;
        while (i < n)
        {
            next = next.Set(i, (i + 1) % n);
            prev = prev.Set(i, (i + n - 1) % n);
            version = version.Set(i, 0);
            pending = pending.Set(i, false);
            dead = dead.Set(i, false);
            i = i + 1;
        }
        // copies[x]: the slots in the ring holding point x. watchHead[x]: the last watch entry
        // of a slot point x blocked, chained through watchNext.
        var copies = new Buffer<Integer>(points.Count);
        var watchHead = new Buffer<Integer>(points.Count);
        var x = 0;
        while (x < points.Count)
        {
            copies = copies.Set(x, 0);
            watchHead = watchHead.Set(x, -1);
            x = x + 1;
        }
        i = 0;
        while (i < n)
        {
            copies = copies.Set(ring[i], copies.At(ring[i]) + 1);
            i = i + 1;
        }
        var watchSlot = new List<Integer>();
        var watchVersion = new List<Integer>();
        var watchNext = new List<Integer>();
        var heap = new List<Integer>();
        var heapCount = 0;
        var triangles = new List<TriangleFace>();
        var head = 0;
        var live = n;
        var front = 0;
        var tests = 0;
        var stuck = false;
        while (live > 3 && stuck.Not)
        {
            // Find the first ear by position: pending slots below the frontier, least first,
            // then the frontier, which moves on past each slot it tests.
            var ear = -1;
            var searching = true;
            while (searching)
            {
                var slot = -1;
                var fromHeap = heapCount > 0 ? heap.At(0) < front : false;
                if (fromHeap)
                {
                    var popped = heap.At(0);
                    heapCount = heapCount - 1;
                    heap = heap.Set(0, heap.At(heapCount));
                    var down = 0;
                    var sifting = true;
                    while (sifting)
                    {
                        var left = 2 * down + 1;
                        var least = down;
                        if (left < heapCount)
                        {
                            if (heap.At(left) < heap.At(least))
                            {
                                least = left;
                            }
                        }
                        if (left + 1 < heapCount)
                        {
                            if (heap.At(left + 1) < heap.At(least))
                            {
                                least = left + 1;
                            }
                        }
                        if (least == down)
                        {
                            sifting = false;
                        }
                        else
                        {
                            var swapped = heap.At(down);
                            heap = heap.Set(down, heap.At(least));
                            heap = heap.Set(least, swapped);
                            down = least;
                        }
                    }
                    slot = (dead.At(popped) || pending.At(popped).Not) ? -1 : popped;
                }
                else if (front < n)
                {
                    slot = front;
                    front = next.At(front) > front ? next.At(front) : n;
                }
                else
                {
                    searching = false;
                }
                if (slot >= 0)
                {
                    // IsEar at the slot: -2 not positive, -1 an ear, else the blocking point.
                    pending = pending.Set(slot, false);
                    tests = tests + 1;
                    var p = ring[prev.At(slot)];
                    var q = ring[slot];
                    var s = ring[next.At(slot)];
                    var blocker = -2;
                    if (TwiceSignedArea(points[p], points[q], points[s]) > 0.0)
                    {
                        blocker = -1;
                        var near = grid.ItemsNear(LowCorner(LowCorner(points[p], points[q]), points[s]), HighCorner(HighCorner(points[p], points[q]), points[s]));
                        var k = 0;
                        while (k < near.Count && blocker < 0)
                        {
                            var y = near[k];
                            if (copies.At(y) > 0 && y != p && y != q && y != s)
                            {
                                if (InClosedTriangle(points[y], points[p], points[q], points[s]))
                                {
                                    blocker = y;
                                }
                            }
                            k = k + 1;
                        }
                    }
                    if (blocker == -1)
                    {
                        ear = slot;
                        searching = false;
                    }
                    if (blocker >= 0)
                    {
                        watchSlot = watchSlot.Add(slot);
                        watchVersion = watchVersion.Add(version.At(slot));
                        watchNext = watchNext.Add(watchHead.At(blocker));
                        watchHead = watchHead.Set(blocker, watchSlot.Count - 1);
                    }
                }
            }
            if (ear < 0)
            {
                stuck = true;
            }
            else
            {
                var a = prev.At(ear);
                var b = next.At(ear);
                triangles = triangles.Add(TriangleFace(VertexIndex(ring[a]), VertexIndex(ring[ear]), VertexIndex(ring[b])));
                next = next.Set(a, b);
                prev = prev.Set(b, a);
                dead = dead.Set(ear, true);
                live = live - 1;
                head = head == ear ? b : head;
                version = version.Set(a, version.At(a) + 1);
                version = version.Set(b, version.At(b) + 1);
                copies = copies.Set(ring[ear], copies.At(ring[ear]) - 1);
                // The slots whose status may have changed: the ear's two neighbours, and the
                // slots the ear's point blocked, when it has left the ring.
                var woken = new List<Integer>();
                woken = woken.Add(a);
                woken = woken.Add(b);
                if (copies.At(ring[ear]) == 0)
                {
                    var w = watchHead.At(ring[ear]);
                    while (w >= 0)
                    {
                        if (watchVersion.At(w) == version.At(watchSlot.At(w)))
                        {
                            woken = woken.Add(watchSlot.At(w));
                        }
                        w = watchNext.At(w);
                    }
                }
                var wake = woken.Freeze();
                var j = 0;
                while (j < wake.Count)
                {
                    var u = wake[j];
                    if (dead.At(u).Not && u < front && pending.At(u).Not)
                    {
                        pending = pending.Set(u, true);
                        if (heapCount < heap.Count)
                        {
                            heap = heap.Set(heapCount, u);
                        }
                        else
                        {
                            heap = heap.Add(u);
                        }
                        var up = heapCount;
                        heapCount = heapCount + 1;
                        var rising = true;
                        while (rising)
                        {
                            if (up == 0)
                            {
                                rising = false;
                            }
                            else
                            {
                                var parent = (up - 1) / 2;
                                if (heap.At(parent) > heap.At(up))
                                {
                                    var lifted = heap.At(up);
                                    heap = heap.Set(up, heap.At(parent));
                                    heap = heap.Set(parent, lifted);
                                    up = parent;
                                }
                                else
                                {
                                    rising = false;
                                }
                            }
                        }
                    }
                    j = j + 1;
                }
            }
        }
        if (live == 3)
        {
            var first = ring[head];
            var second = ring[next.At(head)];
            var third = ring[next.At(next.At(head))];
            if (TwiceSignedArea(points[first], points[second], points[third]) > 0.0)
            {
                triangles = triangles.Add(TriangleFace(VertexIndex(first), VertexIndex(second), VertexIndex(third)));
            }
        }
        return Counted(triangles.Freeze(), Insertions(tests));
    }

    //==
    // # The triangulation

    // TriangulateRegionCdt's ear-clipped seed of region r in chart points, with the bridge tests
    // and the ear tests counted as Insertions.
    CdtSeedIndexedCounted(r: UvRegion, points: Array<Point2D>): Counted<Array<TriangleFace>>
    {
        var ring = r.CdtRingIndexedCounted(points);
        var clipped = ring.Value.EarClippedIndexedCounted(points, points.PointGridOf);
        return Counted(clipped.Value, ring.Work.Add(clipped.Work));
    }

    // TriangulateRegionCdt, triangle for triangle, with the bridge tests and the ear tests
    // counted as Insertions.
    TriangulateRegionCdtIndexedCounted(r: UvRegion, chart: FaceChart): Counted<UvTriangulation>
    {
        var points = r.BoundaryPoints.Map(uv => chart.ChartPoint(uv));
        var seed = r.CdtSeedIndexedCounted(points);
        var pointHoles = r.Holes.Count.Range.FlatMap(h =>
            r.Holes[h].Points.Count < 3 ? r.HoleRing(h) : [h].Take(0));
        var triangles = r.Delaunayed(points, pointHoles.Reduce(seed.Value, (ts, p) => ts.WithPointInserted(p, points)));
        return Counted(UvTriangulation(r.BoundaryPoints, r.BoundarySources, triangles, [QuadFace(VertexIndex(0), VertexIndex(0), VertexIndex(0), VertexIndex(0))].Take(0)), seed.Work);
    }

    // TriangulateRegionCdt without its quadratic scans: the same triangles in the same order.
    TriangulateRegionCdtIndexed(r: UvRegion, chart: FaceChart): UvTriangulation
        => r.TriangulateRegionCdtIndexedCounted(chart).Value;
}

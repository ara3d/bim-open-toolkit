//==
// # Version 1: a band's seam cut goes to the side the face lies on (TKT-429)
//
// JoinedByCut joins the two circles of a band (two loops winding opposite ways round one periodic
// direction) by a synthetic cut from a point of the first circle to the nearest copy of the second
// circle's nearest point. On a cylinder the cross direction is not periodic and there is one copy.
// On a torus band between two v-circles the cross direction is periodic, and the second circle
// has a copy on each side; when the circles are half a turn apart (the tube's top and bottom, as
// in STEP Tools' moon_buggy_asm.stp face #34380) both are equally near, and the nearest copy picks
// a side by arithmetic, not by the face: the mesher meshed the inner half of the tube where the
// file bounds the outer. The face lies to the left of each of its loops, so the cut must leave the
// first circle to its left: BandEndCopy takes, among the copies of the second circle's point one
// period apart in the cross direction, the nearest one strictly to the left of the first circle's
// step at the cut's start. The torus band witnesses are layer 7's (Witness_TorusBand).
//
// Sections, in order:
//  - The cut's far end

library V1Band
{
    //==
    // # The cut's far end

    // The copy of loop b's point j that the band cut from loop a's point i ends at, on face f:
    // NearestUnwrapped's copy when the direction across the band (the one a does not wind round)
    // has no period; otherwise, of that copy and its copies one period either way across, the
    // nearest to a's point among those strictly left of a's step from point i to point i + 1, or
    // NearestUnwrapped's copy when none is.
    BandEndCopy(m: BrepModel, f: BrepFaceIndex, a: UvLoop, i: Integer, b: UvLoop, j: Integer): UvCoordinate
    {
        var dom = m.SurfaceDomainOf(f);
        var start = a.Points[i];
        var next = a.Points.AtModulo(i + 1);
        var base = dom.NearestUnwrapped(b.Points[j], start);
        var acrossV = m.LoopDisplacement(f, a).U != 0.0;
        var period = acrossV ? dom.V.Periodicity.PeriodOr(0.0) : dom.U.Periodicity.PeriodOr(0.0);
        var copies = period > 0.0
            ? (acrossV
                ? [base, UvCoordinate(base.U, base.V - period), UvCoordinate(base.U, base.V + period)]
                : [base, UvCoordinate(base.U - period, base.V), UvCoordinate(base.U + period, base.V)])
            : [base];
        var left = copies.FlatMap(p => m.IsLeftOfStep(f, start, next, p) ? [p] : copies.Take(0));
        return left.Count == 0
            ? base
            : left.Reduce(left[0], (best, p) => p.UvDistance(start) < best.UvDistance(start) ? p : best);
    }

    // The distance between two parameter points in natural units.
    UvDistance(a: UvCoordinate, b: UvCoordinate): Number
        => ((a.U - b.U) * (a.U - b.U) + (a.V - b.V) * (a.V - b.V)).Sqrt;
}

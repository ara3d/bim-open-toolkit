//==
// # Face meshing charts: laws (TYPE-CATALOG.md section 8)
//
// Laws over chart points and deviations take the runner's random scalars; laws over triangle
// lists, seam pairs, and constraints take Integer selectors and build their witnesses inside.
//
// Sections, in order:
//  - Witnesses
//  - Orientation
//  - Neighbours and certificates
//  - Constraints
//  - Deviations
//  - Seams and lifting
//  - Four-sided regions

library FaceMeshingChartsLaws
{
    //==
    // # Witnesses

    // The triangles of a grid of cols by rows cells, points numbered row by row, each cell split
    // along its diagonal into two counter-clockwise triangles.
    MeshingGridTriangles(cols: Integer, rows: Integer): Array<TriangleFace>
        => (2 * cols * rows).Range.Map(k => MeshingGridTriangle(k, cols));

    // Triangle k of the grid of MeshingGridTriangles with cols columns.
    MeshingGridTriangle(k: Integer, cols: Integer): TriangleFace
    {
        var cell = k / 2;
        var a = (cell / cols) * (cols + 1) + cell % cols;
        var b = a + 1;
        var d = a + cols + 1;
        var c = d + 1;
        return k % 2 == 0
            ? TriangleFace(VertexIndex(a), VertexIndex(b), VertexIndex(c))
            : TriangleFace(VertexIndex(a), VertexIndex(c), VertexIndex(d));
    }

    // A triangle list chosen by k: the closed unit tetrahedron, a 3 by 2 grid, one triangle.
    MeshingTrianglesAt(k: Integer): Array<TriangleFace>
        => MeshingWrap(k, 3) == 0
            ? ModelMesh.Witness_UnitTetrahedron.Triangles
            : (MeshingWrap(k, 3) == 1 ? MeshingGridTriangles(3, 2) : MeshingGridTriangles(1, 1).Take(1));

    // The seam copy chosen by k.
    MeshingCopyAt(k: Integer): SeamCopy
        => MeshingWrap(k, 2) == 0 ? SeamCopy.NearMin : SeamCopy.NearMax;

    // n mod 9 + 4 parameter points.
    MeshingPointCount(n: Integer): Integer
        => MeshingWrap(n, 9) + 4;

    // Seam pairs over points 0 to count - 1: point i with point count - 1 - i, for the first
    // k mod (count / 2) points, leaving the middle two points free.
    MeshingSeamPairs(k: Integer, count: Integer): Array<SeamPair>
        => MeshingWrap(k, count / 2).Range
            .Map(i => SeamPair(UvPointIndex(i), UvPointIndex(count - 1 - i)));

    // One pole run over the two middle points of count.
    MeshingPoleRuns(count: Integer): Array<PoleRun>
        => [PoleRun(DomainSide.UMin, [UvPointIndex(count / 2 - 1), UvPointIndex(count / 2)])];

    // The two triangles of the unit square (0, 1, 2, 3) split on 0-2, with its four sides as
    // loop constraints.
    MeshingSquare(_: ConstrainedTriangulation): ConstrainedTriangulation
        => ConstrainedTriangulation(
            [UvPoint(0.0, 0.0), UvPoint(1.0, 0.0), UvPoint(1.0, 1.0), UvPoint(0.0, 1.0)],
            [TriangleFace(VertexIndex(0), VertexIndex(1), VertexIndex(2)), TriangleFace(VertexIndex(0), VertexIndex(2), VertexIndex(3))],
            4.Range.Map(i => Constraint(UvPointIndex(i), UvPointIndex((i + 1) % 4), ConstraintSource.LoopSegment(BoundSlot(0), i))));

    //==
    // # Orientation

    // A non-zero orientation agrees with the sign of the library's TwiceSignedArea.
    Law_OrientationOfAgreesWithLibrarySign(a: ChartPoint, b: ChartPoint, c: ChartPoint): Boolean
    {
        var o = OrientationOf(a, b, c);
        var area = TwiceSignedArea(a.ToPoint2D, b.ToPoint2D, c.ToPoint2D);
        return (o == Sign.Positive ? area > 0.0 : true) && (o == Sign.Negative ? area < 0.0 : true);
    }

    // With the exact resolution, the orientation is the library's sign itself.
    Law_ExactOrientationIsLibrarySign(a: ChartPoint, b: ChartPoint, c: ChartPoint): Boolean
    {
        var area = TwiceSignedArea(a.ToPoint2D, b.ToPoint2D, c.ToPoint2D);
        return OrientationWithin(a, b, c, Resolution.Exact)
            == (area > 0.0 ? Sign.Positive : (area < 0.0 ? Sign.Negative : Sign.Zero));
    }

    // Swapping two corners negates the orientation.
    Law_OrientationIsAntisymmetric(a: ChartPoint, b: ChartPoint, c: ChartPoint): Boolean
        => OrientationOf(a, c, b) == OrientationOf(a, b, c).Negative;

    // An element's area has the sign of its orientation when the orientation is not Zero.
    Law_ElementInChartAreaHasItsOrientation(a: ChartPoint, b: ChartPoint, c: ChartPoint): Boolean
    {
        var e = ElementInChartOf(a, b, c);
        return (e.Orientation == Sign.Positive ? e.Area > 0.0 : true) && (e.Orientation == Sign.Negative ? e.Area < 0.0 : true);
    }

    //==
    // # Neighbours and certificates

    // The side across the side across s is s, for every side with an opposite.
    Law_NeighbourTableIsInvolution(k: Integer): Boolean
    {
        var t = NeighbourTableOf(MeshingTrianglesAt(k));
        return t.Across.Count.Range.All(i => t.Across[i].Element.IsNone ? true : AcrossOf(t, t.Across[i]) == SideAtSlot(i));
    }

    // Every side of the closed tetrahedron has an opposite, and every side of one triangle has
    // none.
    Law_NeighbourTableSeesClosure(k: Integer): Boolean
        => NeighbourTableOf(MeshingTrianglesAt(0)).Across.All(s => s.Element.IsPresent)
            && NeighbourTableOf(MeshingTrianglesAt(2)).Across.All(s => s.Element.IsNone);

    // A Delaunay certificate is consistent.
    Law_DelaunayCertificateIsConsistent(checked: Integer, violations: Integer): Boolean
        => DelaunayCertificate(checked, violations).IsDelaunay ? DelaunayCertificate(checked, violations).IsConsistent : true;

    //==
    // # Constraints

    // The square's loop constraints are sides of its triangles.
    Law_LoopConstraintsAreSides(k: Integer): Boolean
        => ConstrainedTriangulation.MeshingSquare.ConstraintsAreSides;

    // The other diagonal of the square is not a side: the check can fail.
    Law_OtherDiagonalIsNotASide(k: Integer): Boolean
        => IsElementSide(ConstrainedTriangulation.MeshingSquare, Constraint(UvPointIndex(1), UvPointIndex(3), ConstraintSource.SeamCut)).Not;

    //==
    // # Deviations

    // The worse of two deviations bounds both.
    Law_WorseBoundsBoth(a: ElementDeviation, b: ElementDeviation): Boolean
    {
        var w = Worse(a, b);
        return w.Chordal.Value >= a.Chordal.Value && w.Chordal.Value >= b.Chordal.Value
            && w.NormalTurn.Radians >= a.NormalTurn.Radians && w.NormalTurn.Radians >= b.NormalTurn.Radians
            && w.NormalMismatch.Radians >= a.NormalMismatch.Radians && w.NormalMismatch.Radians >= b.NormalMismatch.Radians;
    }

    //==
    // # Seams and lifting

    // The other copy of the other copy is the copy.
    Law_OtherCopyIsInvolution(k: Integer): Boolean
        => MeshingCopyAt(k).OtherCopy.OtherCopy == MeshingCopyAt(k);

    // The two copies of a pair are its two ends.
    Law_CopiesAreTheEnds(min: Integer, max: Integer, k: Integer): Boolean
        => SeamPair(UvPointIndex(min), UvPointIndex(max)).CopyOf(MeshingCopyAt(k))
            != SeamPair(UvPointIndex(min), UvPointIndex(max)).CopyOf(MeshingCopyAt(k).OtherCopy)
            || min == max;

    // Both copies of every seam pair lift to one local vertex, and so do a pole run's points.
    Law_LiftTableJoinsSeamPairsAndPoles(k: Integer, n: Integer): Boolean
    {
        var count = MeshingPointCount(n);
        var pairs = MeshingSeamPairs(k, count);
        var runs = MeshingPoleRuns(count);
        var t = LiftTableOf(count, pairs, runs);
        return pairs.All(p => t.LocalVertexAt(p.Min) == t.LocalVertexAt(p.Max))
            && runs.All(r => r.Points.All(q => t.LocalVertexAt(q) == t.LocalVertexAt(r.Points[0])));
    }

    // The lift table joins nothing else: one local vertex per point, less one per pair and one
    // per extra pole point, numbered from 0 with none skipped.
    Law_LiftTableJoinsNothingElse(k: Integer, n: Integer): Boolean
    {
        var count = MeshingPointCount(n);
        var pairs = MeshingSeamPairs(k, count);
        var runs = MeshingPoleRuns(count);
        var t = LiftTableOf(count, pairs, runs);
        return t.LocalVertexOf.Count == count
            && t.LocalVertexCount == count - pairs.Count - 1
            && t.LocalVertexCount.Range.All(v => t.LocalVertexOf.Any(x => x.Value == v));
    }

    //==
    // # Four-sided regions

    // The sides of a grid are structured and give back the grid's counts.
    Law_QuadGridSidesRoundTrip(across: Integer, along: Integer): Boolean
    {
        var counts = GridCounts(SegmentCountOf(across), SegmentCountOf(along));
        var sides = QuadGridSidesOf(counts);
        return sides.IsStructured && GridCountsOf(sides) == counts;
    }
}

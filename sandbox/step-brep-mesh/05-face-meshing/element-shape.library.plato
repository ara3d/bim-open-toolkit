//==
// # Elements by arity, quad splits, and the grid's chordal decision (v1-types, chunk T1)
//
// ElementShape and QuadSplits (element-shape.types.plato) in use: the grid keep rule decides on
// the triangles a renderer may draw, both diagonal splits of every quad, which is the version 1
// contract's rule and the gate's (QuadSplitsWithin), instead of the nearer triangle on the
// diagonal from corner 0. GridUnlessFoldedOrCoarse (grid-chordal.library.plato) calls
// DecideGridChordal. Every test is guarded by a conditional, not `&&`: Plato's `&&` evaluates
// both sides, so F1's first rule (GridElementWithinChordal, deleted at this merge), which
// ordered "the surface-point tests first", saved nothing.
//
// Sections, in order:
//  - Shapes
//  - Splits
//  - Flat distance
//  - The grid decision

library V1TypesElements
{
    //==
    // # Shapes

    // Element k of triangulation t by arity: a total function, NoElement when k is out of range.
    ShapeOf(t: UvTriangulation, k: ElementIndex): ElementShape
        => k.Value < 0
            ? ElementShape.NoElement(k)
            : (k.Value < t.Triangles.Count
                ? ElementShape.TriangleShape(t.Triangles[k.Value])
                : (k.Value < t.Triangles.Count + t.Quads.Count
                    ? ElementShape.QuadShape(t.Quads[k.Value - t.Triangles.Count])
                    : ElementShape.NoElement(k)));

    // Element k of face mesh fm by arity: a total function, NoElement when k is out of range.
    ShapeOf(fm: FaceMesh, k: ElementIndex): ElementShape
        => k.Value < 0
            ? ElementShape.NoElement(k)
            : (k.Value < fm.Triangles.Count
                ? ElementShape.TriangleShape(fm.Triangles[k.Value])
                : (k.Value < fm.Triangles.Count + fm.Quads.Count
                    ? ElementShape.QuadShape(fm.Quads[k.Value - fm.Triangles.Count])
                    : ElementShape.NoElement(k)));

    // The corners of element e in winding order; none for NoElement.
    ShapeCorners(e: ElementShape): Array<VertexIndex>
        => match (e) {
            TriangleShape(t) => t.Vertices;
            QuadShape(q) => q.Vertices;
            NoElement(k) => 0.MapRange(i => VertexIndex(i));
        };

    // Whether e is an element.
    IsElementShape(e: ElementShape): Boolean
        => match (e) {
            TriangleShape(t) => true;
            QuadShape(q) => true;
            NoElement(k) => false;
        };

    //==
    // # Splits

    // Both diagonal splits of quad q, each triangle in the quad's winding.
    SplitsOf(q: QuadFace): QuadSplits
        => QuadSplits(
            QuadSplit(TriangleFace(q.A, q.B, q.C), TriangleFace(q.A, q.C, q.D)),
            QuadSplit(TriangleFace(q.B, q.C, q.D), TriangleFace(q.B, q.D, q.A)));

    // The four triangles of both splits: on A C, then on B D.
    SplitTriangles(s: QuadSplits): Array<TriangleFace>
        => [s.OnAC.First, s.OnAC.Second, s.OnBD.First, s.OnBD.Second];

    // The triangles element e may be drawn as: a triangle itself, a quad either split. The
    // contract's chordal and orientation claims on e are claims on each of these.
    RenderTriangles(e: ElementShape): Array<TriangleFace>
        => match (e) {
            TriangleShape(t) => [t];
            QuadShape(q) => q.SplitsOf.SplitTriangles;
            NoElement(k) => 0.MapRange(i => TriangleFace(VertexIndex(i), VertexIndex(i), VertexIndex(i)));
        };

    //==
    // # Flat distance

    // The distance from p to the flat triangle t over corner positions ps.
    TriangleDistance(ps: Array<Point3D>, t: TriangleFace, p: Point3D): Number
        => UnsignedDistanceToTriangle(p, ps[t.A], ps[t.B], ps[t.C]);

    // The distance from p to split s drawn flat over corner positions ps: the nearer of its two
    // triangles.
    SplitDistance(ps: Array<Point3D>, s: QuadSplit, p: Point3D): Number
        => ps.TriangleDistance(s.First, p).Min(ps.TriangleDistance(s.Second, p));

    // The distance from p to the quad on the four corner positions ps (winding order) drawn
    // flat, under whichever split a renderer takes: the farther of the two splits.
    QuadDistanceBothSplits(ps: Array<Point3D>, p: Point3D): Number
    {
        var s = QuadFace(VertexIndex(0), VertexIndex(1), VertexIndex(2), VertexIndex(3)).SplitsOf;
        return ps.SplitDistance(s.OnAC, p).Max(ps.SplitDistance(s.OnBD, p));
    }

    // The distance from p to element k drawn flat, under whichever split a renderer takes.
    // FlatElementDistance takes the split on the diagonal from corner 0 alone, so it is never
    // larger (Law_V1Types_BothSplitsNotNearer); a gap bound on this distance holds for either
    // split. Number.MaxValue for NoElement, so no bound holds.
    FlatElementDistanceBothSplits(fm: FaceMesh, k: ElementIndex, p: Point3D): Number
        => match (fm.ShapeOf(k)) {
            TriangleShape(t) => UnsignedDistanceToTriangle(p, fm.PositionOf(t.A), fm.PositionOf(t.B), fm.PositionOf(t.C));
            QuadShape(q) => q.Vertices.Map(v => fm.PositionOf(v)).QuadDistanceBothSplits(p);
            NoElement(i) => Number.MaxValue;
        };

    //==
    // # The grid decision

    // Whether triangle tri of grid g on region r of face f is within `bound` of the surface at
    // refinement's samples (TriangleNeedsRefinement): the surface point at its parameter
    // centroid and at the parameter midpoint of each side that is not a boundary segment against
    // the flat triangle, and its corner mean and those sides' chord midpoints against the
    // surface. A split's diagonal is never a boundary segment, so it is always sampled. Each
    // test runs only when the ones before it passed.
    GridTriangleWithinChordal(m: BrepModel, f: BrepFaceIndex, r: UvRegion, g: UvTriangulation, tri: TriangleFace, bound: Number): Boolean
    {
        var s = m.SurfaceOf(f);
        var cs = tri.Vertices;
        var uvs = cs.Map(v => g.Points[v]);
        var ps = uvs.Map(uv => m.Geometry.Eval(s, uv));
        var mean = uvs.Map(uv => uv.ToPoint2D).AverageOfPoints;
        var inner = 3.Range.FlatMap(j => r.IsConstrained(cs[j].Value, cs[(j + 1) % 3].Value) ? [j].Take(0) : [j]);
        return UnsignedDistanceToTriangle(m.Geometry.Eval(s, UvCoordinate(mean.X, mean.Y)), ps[0], ps[1], ps[2]) > bound
            ? false
            : (inner.Any(j => UnsignedDistanceToTriangle(m.Geometry.Eval(s, uvs[j].UvMidpoint(uvs[(j + 1) % 3])), ps[0], ps[1], ps[2]) > bound)
                ? false
                : (m.SurfaceDistance(f, ps.AverageOfPoints) > bound
                    ? false
                    : inner.All(j => m.SurfaceDistance(f, ps[j].HalfwayPoint(ps[(j + 1) % 3])) <= bound)));
    }

    // Whether the lifted triangle tri of grid g winds counter-clockwise about face f's normal at
    // its parameter centroid (LiftsFacingFaceNormal's exact sign, on one triangle).
    GridTriangleFacesFaceNormal(m: BrepModel, f: BrepFaceIndex, g: UvTriangulation, tri: TriangleFace): Boolean
    {
        var s = m.SurfaceOf(f);
        var uvs = tri.Vertices.Map(v => g.Points[v]);
        var area = uvs.Map(uv => m.Geometry.Eval(s, uv)).VectorArea;
        var mean = uvs.Map(uv => uv.ToPoint2D).AverageOfPoints;
        return area.Dot(m.FaceNormalAt(f, UvCoordinate(mean.X, mean.Y), area)) > 0.0;
    }

    // Whether element k of grid g is kept: it collapses at a pole (Lift drops or reduces it), or
    // every triangle it may be drawn as faces the face normal and is within `bound`. An element
    // out of range is not kept.
    GridElementKept(m: BrepModel, f: BrepFaceIndex, r: UvRegion, g: UvTriangulation, k: ElementIndex, bound: Number): Boolean
    {
        var shape = g.ShapeOf(k);
        return shape.IsElementShape.Not
            ? false
            : (g.IsCollapsedElement(k)
                ? true
                : shape.RenderTriangles.All(tri =>
                    m.GridTriangleFacesFaceNormal(f, g, tri) ? m.GridTriangleWithinChordal(f, r, g, tri, bound) : false));
    }

    // The chordal decision on grid g of region r of face f: the first element not kept, or the
    // grid with its bound (SurfaceChordal widened by the length tolerance, as
    // GridUnlessFoldedOrCoarse widens it). Stops at the first element not kept; All would visit
    // every element.
    DecideGridChordal(m: BrepModel, f: BrepFaceIndex, r: UvRegion, g: UvTriangulation, c: FaceMeshingCriteria): GridChordalDecision
    {
        var bound = c.SurfaceChordal + m.Tolerances.Length.Value;
        var n = g.Triangles.Count + g.Quads.Count;
        var k = 0;
        var first = n;
        while (k < n)
        {
            if (m.GridElementKept(f, r, g, ElementIndex(k), bound))
            {
                k = k + 1;
            }
            else
            {
                first = k;
                k = n;
            }
        }
        return first < n
            ? GridChordalDecision.GridExceedsAt(ElementIndex(first))
            : GridChordalDecision.GridWithinChordal(g, bound);
    }

    // The quad grid outcome a decision gives.
    GridOutcomeOf(d: GridChordalDecision): QuadGridOutcome
        => match (d) {
            GridWithinChordal(g, bound) => QuadGridOutcome.Grid(g);
            GridExceedsAt(k) => QuadGridOutcome.NoGrid;
        };
}

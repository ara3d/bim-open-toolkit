//==
// # Face meshing: invariants, contracts, theorems
//
// The status of layer 05's laws (SPEC-DSL.md section 3): which are invariants of a type, which a
// caller owes, which a function promises, and which follow as theorems. Every claim here is also
// a Law_ in face-meshing.laws.plato or an expression over the libraries' bodies. Not compiled.
//
// Sections, in order:
//  - Type invariants
//  - Contracts: loops and regions
//  - Contracts: triangulation, grid, lifting
//  - Contracts: the face
//  - Theorems and conjectures

//==
// # Type invariants

// A loop pairs every point with its source.
spec UvLoop
{
    invariant self.Points.Count == self.Sources.Count;
    constructor LoopToUv;
    constructor Unwrap;
    constructor ToUvLoop;
    constructor ReversedLoop;
    constructor WithChartSign;
}

// A region's loops are indexed and non-empty, its outer loop a polygon, each hole a polygon or a
// point hole. The face-relative invariants (loops close, outer positive and holes negative in
// the chart, the shared-point law) are RegionOf's ensures, because they need the face.
spec UvRegion
{
    invariant self.IsIndexedRegion;
    invariant self.Outer.Points.Count >= 3;
    invariant forall (h: Integer) in self.Holes.Count.Range:
        self.Holes[h].Points.Count == 1 || self.Holes[h].Points.Count >= 3;
    invariant forall (k: Integer) in self.NumberOfLoops.Range:
        forall (i: Integer) in self.LoopAt(k).Sources.Count.Range:
            self.LoopAt(k).Sources[i] != UvPointSource.Interior;
    constructor AddMissingSeamsAndPoles;
    constructor OrientRegion;
    constructor RegionOf;
    constructor UnorientedRegionOf;
}

// A chart's scales are positive and finite; its mirroring is the face's normal sign.
spec FaceChart
{
    invariant self.ScaleU > 0.0 && self.ScaleU.IsFinite;
    invariant self.ScaleV > 0.0 && self.ScaleV.IsFinite;
    constructor ChartOf;
}

// The criteria a validator checks (plain data: no constructor list).
spec FaceMeshingCriteria
{
    invariant self.IsWellFormed;
}

// A triangulation pairs every point with its source, every corner names a point, and every
// point is a corner.
spec UvTriangulation
{
    invariant self.Points.Count == self.Sources.Count;
    invariant forall (k: Integer) in self.ElementCount.Range: TriangulationCornersInRange(self, ElementIndex(k));
    invariant forall (i: Integer) in self.Points.Count.Range: EveryPointIsACorner(self, i);
    constructor TriangulateRegion;
    constructor RefineToSurface;
    constructor RefinedTriangulation;
    constructor QuadGrid;
    constructor GridOrTriangles;
}

// A face mesh: per-point arrays agree in length, per-vertex arrays agree in length, LocalVertex
// is onto the local vertices with exactly the seam and pole identifications as fibres, every
// element names parameter-space points, and every quad is convex.
spec FaceMesh
{
    invariant self.UvPoints.Count == self.Sources.Count;
    invariant self.UvPoints.Count == self.LocalVertex.Count;
    invariant self.UvPoints.Count == self.Normals.Count;
    invariant self.Positions.Count == self.Provenance.Count;
    invariant forall (i: Integer) in self.LocalVertex.Count.Range: LocalVertexInRange(self, VertexIndex(i));
    invariant forall (v: Integer) in self.Positions.Count.Range: LocalVertexSurjective(self, VertexIndex(v));
    invariant forall (i: Integer) in self.UvPoints.Count.Range:
        forall (j: Integer) in self.UvPoints.Count.Range:
            Law_LocalVertexFibresAreIdentifications(self, VertexIndex(i), VertexIndex(j));
    invariant forall (k: Integer) in self.ElementCount.Range:
        self.ElementCorners(ElementIndex(k)).All(i => self.UvPoints.IsValidIndex(i));
    invariant forall (q: Integer) in self.Quads.Count.Range: Law_QuadConvex(self, FaceIndex(q));
    constructor Lift;
    constructor EmptyFaceMesh;
}

// An outcome withholds the mesh exactly for blocking requests, explains every request and every
// empty mesh.
spec FaceMeshOutcome
{
    invariant BlockingRequestMeansEmptyMesh(self);
    invariant RequestHasDiagnostic(self);
    invariant Law_EmptyMeshIsExplained(self);
    constructor MeshFace;
    constructor MeshRegion;
    constructor MeshedOutcome;
    constructor UnmeshedOutcome;
}

//==
// # Contracts: loops and regions

spec LoopToUv(m: BrepModel, f: BrepFaceIndex, b: FaceBound, d: EdgeDiscretizations): UvLoop
{
    requires m.IsFaceIntact(f);
    requires m.IsDiscretizedBound(b, d);
    ensures Law_LoopToUvCountMatchesDiscretization(m, f, b, d);
    ensures forall (i: Integer) in result.Points.Count.Range: Law_LoopPointLiftsToSharedPoint(m, f, d, result, i);
    ensures forall (c: Coedge) in m.LoopCoedges(b.Loop):
        forall (k: Integer) in d.ByEdge[c.Edge].Points.Count.Range: Law_PcurveAgreesWithProjection(m, f, d, c.Edge, k);
    measure m.ExpectedLoopPointCount(b, d);
}

spec Unwrap(m: BrepModel, f: BrepFaceIndex, l: UvLoop): UvLoop
{
    requires m.IsFaceIntact(f);
    requires l.Points.Count == l.Sources.Count;
    ensures result.Points.Count == l.Points.Count;
    ensures forall (i: Integer) in l.Points.Count.Range: Law_UnwrapKeepsSources(m, f, l, i);
    ensures forall (i: Integer) in l.Points.Count.Range: Law_UnwrapMovesByWholePeriods(m, f, l, i);
    ensures forall (i: Integer) in l.Points.Count.Range: Law_UnwrappedStepBelowHalfPeriod(m, f, l, i);
    ensures forall (e: BrepEdgeIndex) in m.FaceEdges(f):
        forall (i: Integer) in l.Points.Count.Range:
            forall (j: Integer) in l.Points.Count.Range: Law_SeamUsesOnOppositeCopies(m, f, result, e, i, j);
    measure l.Points.Count;
    deferred "one scan: a seam use whose twin is placed takes its copy by the left rule; every other point its periodic copy nearest its predecessor; free parameter on a collapsed line from the neighbour";
}

spec AddMissingSeamsAndPoles(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): UvRegion
{
    requires m.IsFaceIntact(f);
    requires c.IsWellFormed;
    requires loops.Count == m.MeshedBounds(f).Count;
    requires forall (k: Integer) in loops.Count.Range:
        forall (i: Integer) in loops[k].Points.Count.Range: m.IsUnwrappedStep(f, loops[k], i);
    requires forall (k: Integer) in loops.Count.Range:
        forall (e: BrepEdgeIndex) in m.FaceEdges(f):
            forall (i: Integer) in loops[k].Points.Count.Range:
                forall (j: Integer) in loops[k].Points.Count.Range: Law_SeamUsesOnOppositeCopies(m, f, loops[k], e, i, j);
    ensures result.IsIndexedRegion;
    ensures forall (k: Integer) in result.NumberOfLoops.Range: Law_RegionLoopClosesInPlane(m, f, result, k);
    ensures forall (i: Integer) in result.Outer.Points.Count.Range: Law_SeamCutCopiesRunOpposite(result, i);
    ensures forall (k: Integer) in result.NumberOfLoops.Range:
        forall (i: Integer) in result.LoopAt(k).Points.Count.Range:
            result.LoopAt(k).Sources[i] != UvPointSource.Interior;
    ensures forall (k: Integer) in result.NumberOfLoops.Range:
        forall (i: Integer) in result.LoopAt(k).Points.Count.Range:
            result.LoopAt(k).Sources[i].IsPolePoint ? m.IsOnCollapsedLine(f, result.LoopAt(k).Points[i]) : true;
    ensures forall (k: Integer) in result.NumberOfLoops.Range:
        forall (e: BrepEdgeIndex) in m.FaceEdges(f):
            forall (i: Integer) in result.LoopAt(k).Points.Count.Range:
                forall (j: Integer) in result.LoopAt(k).Points.Count.Range: Law_SeamUsesOnOppositeCopies(m, f, result.LoopAt(k), e, i, j);
    measure SumOf(loops.Map(l => l.Points.Count.ToNumber));
    deferred "whole-loop period shifts, pole-segment insertion from the arriving to the leaving free parameter, synthetic seam cut between winding loops, outer loop by containment";
}

// The pole half of AddMissingSeamsAndPoles (chunk C): on a surface that collapses an iso-line,
// every loop point on a collapsed line becomes that line's segment from the free parameter where
// the loop arrives to the one where it leaves; a face with no edge at a pole gets the whole
// segment. Loops keep their sources and gain Pole points (or the pole vertex's) on the line.
spec ExpandedPoles(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): Array<UvLoop>
{
    requires m.IsFaceIntact(f);
    requires c.IsWellFormed;
    requires m.HasCollapsedLine(f);
    ensures result.Count == loops.Count;
    ensures forall (k: Integer) in result.Count.Range:
        forall (i: Integer) in result[k].Points.Count.Range:
            result[k].Sources[i].IsPolePoint ? m.IsOnCollapsedLine(f, result[k].Points[i]) : true;
    measure SumOf(loops.Map(l => l.Points.Count.ToNumber));
    deferred "per loop point on a collapsed line, the pole segment from the arriving to the leaving free parameter, sampled under the criteria";
}

// The synthetic cuts of the arrangements of winding loops WithSeamCut does not join (chunk C): a
// whole-period region (a whole torus, with no loop, two cuts) and loops winding round both
// directions. Every loop of the result closes in the plane.
spec CutWholePeriods(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): Array<UvLoop>
{
    requires m.IsFaceIntact(f);
    requires c.IsWellFormed;
    ensures forall (k: Integer) in result.Count.Range: m.IsWindingLoop(f, result[k]) == false;
    measure SumOf(loops.Map(l => l.Points.Count.ToNumber));
    deferred "one straight cut per periodic direction the region wraps, joining the winding loops into loops that close";
}

spec OrientRegion(m: BrepModel, f: BrepFaceIndex, r: UvRegion): UvRegion
{
    requires m.IsFaceIntact(f);
    requires r.IsIndexedRegion;
    ensures result.NumberOfLoops == r.NumberOfLoops;
    ensures r.Outer.ChartSignedArea(m.IsChartMirrored(f)) != 0.0 ? UvRegionWindingPositive(m, f, result) : true;
    ensures forall (h: Integer) in result.Holes.Count.Range: Law_UvHoleWindingNegative(m, f, result, h);
    measure r.BoundaryCount;
}

spec RegionOf(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): UvRegion
{
    requires m.IsDiscretizedFace(f, d);
    requires c.IsWellFormed;
    requires m.HasPolyLoop(f) == false;
    ensures result.IsIndexedRegion;
    ensures forall (k: Integer) in result.NumberOfLoops.Range: Law_RegionLoopClosesInPlane(m, f, result, k);
    ensures UvRegionWindingPositive(m, f, result);
    ensures forall (h: Integer) in result.Holes.Count.Range: Law_UvHoleWindingNegative(m, f, result, h);
    ensures forall (k: Integer) in result.NumberOfLoops.Range:
        forall (i: Integer) in result.LoopAt(k).Points.Count.Range:
            Law_LoopPointLiftsToSharedPoint(m, f, d, result.LoopAt(k), i);
    ensures forall (i: Integer) in result.Outer.Points.Count.Range: Law_SeamCutCopiesRunOpposite(result, i);
    measure result.BoundaryCount;
}

spec MeanSpeed(m: BrepModel, f: BrepFaceIndex, r: UvRegion, which: SurfaceParameter): Number
{
    requires m.IsFaceIntact(f);
    requires r.IsIndexedRegion;
    ensures result > 0.0;
    ensures result.IsFinite;
    measure 60;
    deferred "mean of |PartialU| or |PartialV| over three iso-lines of twenty steps across the region's box";
}

spec QuadSidesOf(m: BrepModel, f: BrepFaceIndex, r: UvRegion): QuadSides
{
    requires m.IsFaceIntact(f);
    requires r.IsIndexedRegion;
    ensures result.CornerCount == 0 || result.CornerCount == 4;
    ensures result.CornerCount == 4 ? r.Holes.IsEmpty : true;
    measure r.Outer.Points.Count;
    deferred "one walk of the outer loop: corners where a constant-u run meets a constant-v run";
}

//==
// # Contracts: triangulation, grid, lifting

spec TriangulateRegion(r: UvRegion, chart: FaceChart): UvTriangulation
{
    requires r.IsIndexedRegion;
    requires exists (tol: UvTolerance): r.IsSimpleRegion(tol);
    ensures result.Points.Count == r.BoundaryCount;
    ensures forall (i: Integer) in r.BoundaryCount.Range: Law_TriangulationKeepsBoundary(r, result, i);
    ensures forall (k: Integer) in result.ElementCount.Range: result.ElementChartArea(ElementIndex(k), chart.Mirrored) > 0.0;
    ensures forall (i: Integer) in result.Points.Count.Range: EveryPointIsACorner(result, i);
    ensures forall (k: Integer) in r.NumberOfLoops.Range:
        forall (i: Integer) in r.LoopAt(k).Points.Count.Range: Law_BoundarySegmentIsElementSide(r, result, k, i);
    ensures forall (k: Integer) in result.ElementCount.Range:
        forall (j: Integer) in 4.Range: Law_InteriorSideIsShared(r, result, ElementIndex(k), j);
    ensures result.Quads.Count == 0;
    measure r.BoundaryCount;
    deferred "constrained Delaunay triangulation in the chart (CDT, Triangle -p), even-odd hole removal; given as ear clipping then Lawson flips on the in-circle determinant in Number (TriangulateRegionCdt), not exact predicates";
}

spec RefineToSurface(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, t: UvTriangulation, c: FaceMeshingCriteria): UvTriangulation
{
    requires m.IsFaceIntact(f);
    requires c.IsWellFormed;
    requires chart == m.ChartOf(f, r);
    requires forall (i: Integer) in r.BoundaryCount.Range: Law_TriangulationKeepsBoundary(r, t, i);
    requires forall (k: Integer) in t.ElementCount.Range: Law_ElementPositiveInChart(m, f, t, ElementIndex(k));
    ensures forall (i: Integer) in r.BoundaryCount.Range: Law_TriangulationKeepsBoundary(r, result, i);
    ensures forall (i: Integer) in result.Points.Count.Range: Law_TriangulationAddsOnlyInteriorPoints(m, f, r, result, i);
    ensures forall (k: Integer) in result.ElementCount.Range: Law_ElementPositiveInChart(m, f, result, ElementIndex(k));
    ensures forall (k: Integer) in result.ElementCount.Range: Law_ElementSpansBelowHalfPeriod(m, f, result, ElementIndex(k));
    ensures forall (k: Integer) in result.ElementCount.Range: Law_ElementLiftsFacingFaceNormal(m, f, result, ElementIndex(k));
    ensures forall (k: Integer) in r.NumberOfLoops.Range:
        forall (i: Integer) in r.LoopAt(k).Points.Count.Range: Law_BoundarySegmentIsElementSide(r, result, k, i);
    ensures forall (k: Integer) in result.ElementCount.Range:
        forall (j: Integer) in 4.Range: Law_InteriorSideIsShared(r, result, ElementIndex(k), j);
    ensures Law_ElementAreasSumToRegionArea(m, f, r, result);
    ensures result.Quads.Count == t.Quads.Count;
    measure result.Points.Count;
    deferred "Delaunay refinement with the boundary locked: insert the worst surface sample point of an element exceeding SurfaceChordal or SurfaceAngular or folding when lifted, stop at MinLength; given as circumcentre or midpoint insertion for the surface criteria, then off-centres for a 30 degree smallest angle, each pass ending with Lawson flips on the in-circle determinant (RefineToSurfaceByInsertion)";
}

spec QuadGrid(m: BrepModel, f: BrepFaceIndex, r: UvRegion, corners: Array<VertexIndex>, c: FaceMeshingCriteria): UvTriangulation
{
    requires m.IsFaceIntact(f);
    requires r.Holes.IsEmpty;
    requires corners.Count == 4;
    requires r.OppositeCountsMatch(corners);
    ensures forall (i: Integer) in r.BoundaryCount.Range: Law_TriangulationKeepsBoundary(r, result, i);
    ensures forall (i: Integer) in result.Points.Count.Range: Law_TriangulationAddsOnlyInteriorPoints(m, f, r, result, i);
    ensures forall (k: Integer) in result.ElementCount.Range: Law_ElementPositiveInChart(m, f, result, ElementIndex(k));
    ensures forall (i: Integer) in r.Outer.Points.Count.Range: Law_BoundarySegmentIsElementSide(r, result, 0, i);
    ensures forall (k: Integer) in result.ElementCount.Range:
        forall (j: Integer) in 4.Range: Law_InteriorSideIsShared(r, result, ElementIndex(k), j);
    ensures Law_ElementAreasSumToRegionArea(m, f, r, result);
    measure r.SideSegmentCount(corners, 0) * r.SideSegmentCount(corners, 1);
    deferred "transfinite (Coons) interpolation between the four side polylines; split quads failing warp or convexity after lifting";
}

spec MatchingFloors(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, corners: Array<VertexIndex>): SegmentFloors
{
    requires m.IsDiscretizedFace(f, d);
    requires corners.Count == 4;
    ensures result.ByEdge.Count == m.Edges.Count;
    ensures forall (i: Integer) in result.ByEdge.Count.Range:
        result.ByEdge[i] == 0 || m.FaceEdges(f).Any(e => e.Value == i);
    measure r.Outer.Points.Count;
    deferred "per pair of opposite sides with unequal counts, the longer count on the shorter side's edge";
}

spec Lift(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, t: UvTriangulation): FaceMesh
{
    requires m.IsDiscretizedFace(f, d);
    requires t.CornersInRange;
    requires t.Points.Count == t.Sources.Count;
    ensures result.Face == f;
    ensures result.UvPoints.Count == t.Points.Count;
    ensures forall (i: Integer) in t.Points.Count.Range: LiftKeepsPoints(t, result, i);
    ensures forall (i: Integer) in result.UvPoints.Count.Range: Law_SharedPositionIsCopied(m, d, result, VertexIndex(i));
    ensures forall (i: Integer) in result.UvPoints.Count.Range: ProvenanceMatchesSource(d, result, VertexIndex(i));
    ensures forall (i: Integer) in result.UvPoints.Count.Range: Law_PointNormalIsFaceNormal(m, result, VertexIndex(i));
    ensures Law_DroppedElementsArePoleCollapsed(m, f, t, result);
    ensures Law_CollapsedQuadsBecomeTriangles(m, f, t, result);
    measure t.Points.Count + t.ElementCount;
    deferred "identification classes by IdentifiedSources (union-find); copy shared positions, evaluate the rest; drop pole-collapsed triangles";
}

//==
// # Contracts: the face

// MeshFace promises the structural laws outright and the surface criteria unless refinement
// stopped at MinLength: refinement inserts no point within MinLength of an existing one, so an
// element it could not improve has an edge shorter than twice MinLength.
spec MeshFace(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): FaceMeshOutcome
{
    requires m.IsDiscretizedFace(f, d);
    requires c.IsWellFormed;
    ensures result.Mesh.Face == f;
    ensures BlockingRequestMeansEmptyMesh(result);
    ensures RequestHasDiagnostic(result);
    ensures Law_EmptyMeshIsExplained(result);
    ensures Law_MeshedFaceHasSimpleRegion(m, f, d, c);
    ensures Law_NoQuadsUnlessPreferred(m, f, d, c);
    ensures forall (q: Integer) in result.Requests.Count.Range: Law_RequestsNameFaceEdges(m, f, d, c, q);
    ensures forall (d2: EdgeDiscretizations): Law_MeshFaceReadsOnlyFaceEdges(m, f, d, d2, c);
    ensures forall (k: Integer) in result.Mesh.ElementCount.Range: Law_ElementFacesFaceNormal(m, result.Mesh, ElementIndex(k));
    ensures forall (k: Integer) in result.Mesh.ElementCount.Range:
        Law_ElementDeviationWithinSurfaceChordal(m, d, result.Mesh, c, ElementIndex(k))
        || result.Mesh.ShortestEdgeLength(ElementIndex(k)) < 2.0 * c.Discretization.MinLength;
    ensures forall (k: Integer) in result.Mesh.ElementCount.Range:
        Law_SurfaceWithinSurfaceChordalOfElement(m, d, result.Mesh, c, ElementIndex(k))
        || result.Mesh.ShortestEdgeLength(ElementIndex(k)) < 2.0 * c.Discretization.MinLength;
    ensures forall (k: Integer) in result.Mesh.ElementCount.Range:
        forall (j: Integer) in 4.Range:
            Law_SurfaceEdgeNormalTurnWithinSurfaceAngular(m, d, result.Mesh, c, ElementIndex(k), j)
            || result.Mesh.ShortestEdgeLength(ElementIndex(k)) < 2.0 * c.Discretization.MinLength;
    ensures forall (k: Integer) in result.Mesh.ElementCount.Range:
        Law_ElementNormalAgreesWithSurface(m, result.Mesh, c, ElementIndex(k))
        || result.Mesh.ShortestEdgeLength(ElementIndex(k)) < 2.0 * c.Discretization.MinLength;
    ensures forall (q: Integer) in result.Mesh.Quads.Count.Range: Law_QuadPlanarWithinSurfaceChordal(result.Mesh, c, FaceIndex(q));
    ensures forall (q: Integer) in result.Mesh.Quads.Count.Range: Law_QuadConvex(result.Mesh, FaceIndex(q));
    measure result.Mesh.UvPoints.Count + result.Mesh.ElementCount;
}

//==
// # Theorems and conjectures

// The former theorem ChartWindingIsFaceWinding (a triangle positive in the chart lifts facing
// the face normal) is dropped as false (review H5): the O(h^3) term of
// (S(b) - S(a)) x (S(c) - S(a)) = A_uv (PartialU x PartialV) + O(h^3) dominates on a sliver. On
// the unit sphere the parameter triangle (0, 0.5), (0.2, 0.5), (0.1, 0.5001) has chart area
// +1e-5, spans 0.2 rad, and touches no pole, yet its flat normal is 2.05 rad (117 degrees) from
// the face normal: its height (1e-4) is below the sagitta of its long edge (3.8e-3). The
// conclusion is now a postcondition: RefineToSurface splits folded elements
// (Law_ElementLiftsFacingFaceNormal), QuadGridIfRectangular drops a grid with one
// (GridUnlessFolded), and MeshFace ensures Law_ElementFacesFaceNormal.

// Both faces of an edge hold bitwise the same boundary positions, so the assembled mesh is
// watertight along model edges with no welding.
theorem SharedEdgePositionsAgree
{
    given m: BrepModel, d: EdgeDiscretizations, a: FaceMesh, b: FaceMesh, i: VertexIndex, j: VertexIndex;
    assume Law_SharedPositionIsCopied(m, d, a, i);
    assume Law_SharedPositionIsCopied(m, d, b, j);
    assume a.IsLiftedPoint(i) && b.IsLiftedPoint(j);
    assume IdentifiedSources(a.Sources[i], b.Sources[j]);
    assume a.Sources[i] != UvPointSource.Interior;
    conclude a.PositionOf(i).X == b.PositionOf(j).X && a.PositionOf(i).Y == b.PositionOf(j).Y && a.PositionOf(i).Z == b.PositionOf(j).Z;
    because "Identified FromVertex and FromEdge sources name one vertex point or one discretization point, and both positions are copies of it (Law_SharedPositionIsCopied), so they are the same Number triple. Seam-cut and pole sources are face-internal and never shared by two faces.";
    tested by Law_SharedPositionIsCopied;
}

// The dropped triangles are exactly one per pole segment.
theorem DroppedTrianglesArePoleSegments
{
    given m: BrepModel, f: BrepFaceIndex, r: UvRegion, t: UvTriangulation, fm: FaceMesh;
    assume forall (i: Integer) in r.BoundaryCount.Range: Law_TriangulationKeepsBoundary(r, t, i);
    assume forall (k: Integer) in t.ElementCount.Range: Law_ElementPositiveInChart(m, f, t, ElementIndex(k));
    assume forall (k: Integer) in r.NumberOfLoops.Range:
        forall (i: Integer) in r.LoopAt(k).Points.Count.Range: Law_BoundarySegmentIsElementSide(r, t, k, i);
    assume Law_DroppedElementsArePoleCollapsed(m, f, t, fm);
    assume t.Quads.Count == 0;
    conclude t.ElementCount - fm.ElementCount ==
        r.NumberOfLoops.Range.Reduce(0, (n, k) => n + r.LoopAt(k).Points.Count.Range.Reduce(0, (s, i) =>
            s + (IdentifiedSources(r.LoopAt(k).Sources[i], r.LoopAt(k).Sources.AtModulo(i + 1)) ? 1 : 0)));
    because "A dropped triangle has two corners with identified sources (IsCollapsedElement). Within a region, identified points that are not a period apart are points of one pole segment, which lies on a collapsed line that bounds the region, so the side between the two corners lies along the pole segment and is a boundary segment whose ends are identified (an interior chord along a boundary line would overlap boundary segments, which a positively oriented triangulation forbids). Each boundary segment is a side of exactly one triangle (Law_BoundarySegmentIsElementSide, now an assumption rather than a silent one). A positive triangle cannot have three collinear corners, so no triangle has two such segments.";
    tested by Law_DroppedElementsArePoleCollapsed;
}

// The parameter-space elements tile the region: every point strictly inside it lies in an
// element. A theorem once the sides are conforming (review H6); without
// Law_BoundarySegmentIsElementSide it is false (the unit square triangulated by ABC and ABD).
theorem ElementsTileRegion
{
    given m: BrepModel, f: BrepFaceIndex, r: UvRegion, t: UvTriangulation, uv: UvCoordinate;
    assume r.IsSimpleRegion(m.RegionTolerance(f, m.ChartOf(f, r)));
    assume forall (i: Integer) in r.BoundaryCount.Range: Law_TriangulationKeepsBoundary(r, t, i);
    assume forall (k: Integer) in t.ElementCount.Range: Law_ElementPositiveInChart(m, f, t, ElementIndex(k));
    assume forall (k: Integer) in r.NumberOfLoops.Range:
        forall (i: Integer) in r.LoopAt(k).Points.Count.Range: Law_BoundarySegmentIsElementSide(r, t, k, i);
    assume forall (k: Integer) in t.ElementCount.Range:
        forall (j: Integer) in 4.Range: Law_InteriorSideIsShared(r, t, ElementIndex(k), j);
    assume r.IsStrictlyInside(uv, m.RegionTolerance(f, m.ChartOf(f, r)));
    conclude exists (k: Integer) in t.ElementCount.Range:
        t.ElementCorners(ElementIndex(k)).Map(v => t.Points[v].ToPoint2D).PolygonContainsPoint(uv.ToPoint2D);
    because "Take the elements, each positively oriented in the chart, as a 2-chain c = sum of the elements with coefficient 1. Its boundary is the sum of the elements' directed sides. Each interior side appears once in each direction (Law_InteriorSideIsShared) and cancels; each boundary segment of the region appears exactly once, in the boundary's direction, and never reversed (Law_BoundarySegmentIsElementSide). So the boundary of c is the region's boundary cycle dP (outer loop counter-clockwise, holes clockwise in the chart, by RegionOf's ensures; point holes contribute nothing). The number of elements over a point not on any side is the winding number of the boundary of c about it, which is the winding number of dP: 1 inside the simple region, 0 outside. A point strictly inside the region lies on no boundary segment; if it lies on an interior side, it lies in the closed element on either side. Hence some element contains uv, and in fact exactly one does away from the sides.";
    tested by Law_BoundarySegmentIsElementSide, Law_InteriorSideIsShared, Law_ElementAreasSumToRegionArea, Law_ElementPositiveInChart;
}

// The former conjecture NormalTurnBoundsCentroidDeviation (an element whose surface edges turn by
// at most SurfaceAngular has its flat normal within SurfaceAngular of the face normal at its
// parameter centroid) is dropped as false (review H7). Counterexample: on the unit sphere the
// parameter triangle (0, 0.5), (0.2, 0.5), (0.1, 0.5001) turns by 0.175, 0.088 and 0.088 rad
// along its edges, yet its flat normal is 2.05 rad from the face normal at its centroid, and its
// largest distance from the sphere is 3.8e-3. The flat normal of a sliver does not lie in the cone
// of its corner normals. Law_ElementNormalAgreesWithSurface is therefore its own criterion, which
// RefineToSurface enforces.

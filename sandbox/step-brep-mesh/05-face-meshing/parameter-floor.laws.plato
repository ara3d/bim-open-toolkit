//==
// # A B-spline surface parameter's floor: laws (TKT-459)
//
// The strip witness is c211's shape: a planar B-spline patch whose parameters move 10 mm (u) and
// 24 mm (v) per unit, and a face on it 10 mm long and 0.2 mm wide, under a length tolerance of
// 0.01 mm. The floor laws run over layer 7's ten witness models.
//
// Sections, in order:
//  - The strip
//  - Laws

library GeometryParameterFloorLaws
{
    //==
    // # The strip

    // The tolerances of a model of extent 30 mm with a length tolerance of 0.01 mm, as the decoder
    // builds them (FixtureTolerances in 03-step/step-raw-witnesses.library.plato).
    StripTolerances(_: Tolerances): Tolerances
    {
        var length = LengthTolerance(0.01);
        return Tolerances(length, AngleTolerance(Angle(1e-9)), length.LengthParameterFloor(30.0), length.AngleParameterFloor(30.0, 30.0));
    }

    // A sheet on the bilinear B-spline patch P(u, v) = (10 u, 24 v, 0): the face between y = 12 and
    // y = 12 + w, x from 0 to 10, bounded by four lines, its normal +z.
    Witness_BSplineStrip(_: BrepModel, w: Number): BrepModel
        => BrepModel(
            GeometrySet(
                [LineBetween(Point3D(0.0, 12.0, 0.0), Point3D(10.0, 12.0, 0.0)),
                 LineBetween(Point3D(10.0, 12.0, 0.0), Point3D(10.0, 12.0 + w, 0.0)),
                 LineBetween(Point3D(10.0, 12.0 + w, 0.0), Point3D(0.0, 12.0 + w, 0.0)),
                 LineBetween(Point3D(0.0, 12.0 + w, 0.0), Point3D(0.0, 12.0, 0.0))],
                [],
                [],
                [BrepSurface.BSpline(BSplineSurfaceData(
                    SplineBasis(1, KnotVector([0.0, 0.0, 1.0, 1.0])),
                    SplineBasis(1, KnotVector([0.0, 0.0, 1.0, 1.0])),
                    MakeArray2D(2, 2, (i, j) => Point3D(10.0 * i.ToNumber, 24.0 * j.ToNumber, 0.0)),
                    MakeArray2D(2, 2, (i, j) => 1.0)))], []),
            [BrepVertex(Point3D(0.0, 12.0, 0.0)), BrepVertex(Point3D(10.0, 12.0, 0.0)),
             BrepVertex(Point3D(10.0, 12.0 + w, 0.0)), BrepVertex(Point3D(0.0, 12.0 + w, 0.0))],
            4.MapRange(k => BrepEdge(BrepVertexIndex(k), BrepVertexIndex((k + 1) % 4), CurveIndex(k), true)),
            [BrepLoop.EdgeLoop(4.MapRange(k => CoedgeOf(k, true)))],
            [SingleLoopFace(0, 0, true)],
            [BrepShell([BrepFaceIndex(0)], false)],
            [BrepBody.ShellSet([ShellIndex(0)])],
            Tolerances.StripTolerances,
            LengthUnit.Millimetre);

    Witness_StripCase(_: StripCase): StripCase
        => StripCase(0.2);

    // Whether case w is the witness's width. The law runner also draws widths at random; the
    // others hold vacuously.
    IsStripCase(w: StripCase): Boolean
        => w.Width == 0.2;

    //==
    // # Laws

    // The 0.2 mm strip meshes at chordal 0.05 mm: some element and no FACE-ZERO-WIDTH diagnostic.
    // Fails before TKT-459 (the v floor, 0.01, is 0.24 mm on this patch).
    Law_V1Faces_BSplineStripMeshes(w: StripCase): Boolean
        => w.IsStripCase ? w.StripMeshes(BrepModel.Witness_BSplineStrip(w.Width)) : true;

    // Law_V1Faces_BSplineStripMeshes on model m.
    StripMeshes(w: StripCase, m: BrepModel): Boolean
    {
        var c = DefaultMeshingOptions(0.05).Face;
        var o = m.MeshFace(BrepFaceIndex(0), m.DiscretizeAll(c.Discretization, SegmentFloors.NoFloors), c);
        return o.Mesh.ElementCount > 0 && o.Diagnostics.All(d => d.Code != "FACE-ZERO-WIDTH");
    }

    // On every face of layer 7's ten witness models, each parameter that is not a B-spline's keeps
    // exactly the floor ParameterFloorAlong gave it before TKT-459 (UnitSpeedFloor), and a
    // B-spline's is no coarser.
    Law_V1Faces_FloorKeptOffSplines(k: Integer): Boolean
        => k < 0 || k > 9 ? true : BrepModel.WitnessAt(k).FloorsKept;

    // Law_V1Faces_FloorKeptOffSplines on model m.
    FloorsKept(m: BrepModel): Boolean
        => m.Faces.Count.Range.All(i => [SurfaceParameter.ParameterU, SurfaceParameter.ParameterV].All(which =>
            m.Geometry.IsSplineParameter(m.Faces[i].Surface, which)
                ? m.Geometry.ParameterFloorAlong(m.Faces[i].Surface, which, m.Tolerances).Value
                    <= m.Geometry.UnitSpeedFloor(m.Faces[i].Surface, which, m.Tolerances).Value
                : m.Geometry.ParameterFloorAlong(m.Faces[i].Surface, which, m.Tolerances).Value
                    == m.Geometry.UnitSpeedFloor(m.Faces[i].Surface, which, m.Tolerances).Value));

    // The reference: ParameterFloorAlong before TKT-459, the angle floor for an angle and the
    // length floor for every other parameter.
    UnitSpeedFloor(g: GeometrySet, s: SurfaceIndex, which: SurfaceParameter, tol: Tolerances): ParameterTolerance
        => g.IsAngleParameter(s, which) ? tol.AngleParameter : tol.LengthParameter;
}

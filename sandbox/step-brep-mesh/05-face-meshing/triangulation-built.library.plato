//==
// # Refinement passes over builders (complexity sweep, chunk R1, TKT-383)
//
// TriangulationFast's SurfacePassLocal and AnglePassLocal copied the whole triangulation for
// every candidate point: TryInsertion appended the point to copies of the points (twice) and
// InsertedLocally and FlippedAround copied the triangles (twice), the region tolerance was
// recomputed, the corners the point joins were evaluated on the surface again, and the walk ran
// a second time for the neighbour update. A pass here keeps the parameter points, chart points,
// surface positions, triangles and neighbour table as List builders. A trial reads them and
// returns the writes that would keep its point (TrialInsertion), so a refused point copies
// nothing; Lawson's flips run on a small overlay of the triangles they touch. Each point's surface
// position is evaluated once, when it is tried, and read from the positions after; the region
// tolerance and the minimum length are computed once per refinement. The insertions are the
// same, in the same order, as the library's passes make.
//
// A builder cannot be a function's first parameter, be stored in a record or be captured by a
// lambda (PLATO-PRIMER.md A.6), so the builders come after a concrete first parameter and the
// passes inline their loops.
//
// Sections, in order:
//  - Reading builders
//  - The flip test on four points
//  - A trial
//  - Applying a trial
//  - The passes
//  - Refinement

library TriangulationBuilt
{
    //==
    // # Reading builders

    // The chart points of triangle tri's three corners, in corner order: with TriangleOf(0, 1, 2)
    // they serve the library's array functions (PlaceInTriangle, Circumcentre, AngleCandidates),
    // which read points only through the triangle's corners.
    ChartCornersIn(tri: TriangleFace, points: List<Point2D>): Array<Point2D>
        => [points.At(tri.Corner(0)), points.At(tri.Corner(1)), points.At(tri.Corner(2))];

    // The parameter points of triangle tri's three corners, in corner order.
    UvCornersIn(tri: TriangleFace, pts: List<UvCoordinate>): Array<UvCoordinate>
        => [pts.At(tri.Corner(0)), pts.At(tri.Corner(1)), pts.At(tri.Corner(2))];

    // The surface point of point v: `at` for the point being tried (index pi), else its position.
    PositionAt(v: Integer, pi: Integer, at: Point3D, pos: List<Point3D>): Point3D
        => v == pi ? at : pos.At(v);

    // The position of x in xs; -1 when xs does not hold it.
    PositionIn(x: Integer, xs: List<Integer>): Integer
    {
        var i = 0;
        var found = -1;
        while (found < 0 && i < xs.Count)
        {
            if (xs.At(i) == x)
            {
                found = i;
            }
            i = i + 1;
        }
        return found;
    }

    // Triangle x as a trial sees it: its value in the overlay (ids, vals) when the trial has
    // written it, else the pass's.
    TriangleIn(x: Integer, ids: List<Integer>, vals: List<TriangleFace>, tris: List<TriangleFace>): TriangleFace
    {
        var at = x.PositionIn(ids);
        return at >= 0 ? vals.At(at) : tris.At(x);
    }

    // The triangle c writes at slot x; c must write it.
    WrittenAt(c: TriangleWrites, x: Integer): TriangleFace
        => c.Triangles[c.SlotPosition(x)];

    // The position of slot x among c's writes; -1 when c does not write it.
    SlotPosition(c: TriangleWrites, x: Integer): Integer
        => c.Slots.Count.Range.Reduce(-1, (found, i) => found >= 0 ? found : (c.Slots[i] == x ? i : -1));

    // Whether c writes slot x.
    Writes(c: TriangleWrites, x: Integer): Boolean
        => c.SlotPosition(x) >= 0;

    // TriangulationFast's WalkTo over builders: the triangle holding chart point p, walking from
    // triangle `from`; -1 when the walk leaves the region or takes more steps than there are
    // triangles.
    WalkToIn(p: Point2D, from: Integer, points: List<Point2D>, tris: List<TriangleFace>, nb: List<Integer>): Integer
    {
        var t = from;
        var steps = 0;
        var found = -1;
        while (found < 0 && t >= 0 && steps <= tris.Count)
        {
            var x = tris.At(t);
            var j = TwiceSignedArea(points.At(x.A.Value), points.At(x.B.Value), p) < 0.0 ? 0
                : (TwiceSignedArea(points.At(x.B.Value), points.At(x.C.Value), p) < 0.0 ? 1
                    : (TwiceSignedArea(points.At(x.C.Value), points.At(x.A.Value), p) < 0.0 ? 2 : -1));
            if (j < 0)
            {
                found = t;
            }
            else
            {
                t = nb.At(3 * t + j);
            }
            steps = steps + 1;
        }
        return found;
    }

    // UvDelaunay's SplitSideSlot for triangle tri given its corners' chart points and the
    // triangles across its three sides: the longest side in the chart that is not a boundary
    // segment and has a neighbour; -1 when none has.
    SplitSideSlotOf(r: UvRegion, tri: TriangleFace, corners: Array<Point2D>, across: Array<Integer>): Integer
        => 3.Range.Reduce(-1, (best, j) =>
            (r.IsConstrained(tri.Corner(j), tri.Corner(j + 1)) || across[j] < 0)
                ? best
                : (best < 0 ? j : (corners[j].Distance(corners[(j + 1) % 3])
                    > corners[best].Distance(corners[(best + 1) % 3]) ? j : best)));

    // TriangulationFast's SurfaceFallback over builders: the parameter midpoint of triangle k's
    // SplitSideSlot, or its parameter centroid when every side is a boundary segment.
    SurfaceFallbackIn(r: UvRegion, k: Integer, pts: List<UvCoordinate>, points: List<Point2D>, tris: List<TriangleFace>, nb: List<Integer>): UvCoordinate
    {
        var tri = tris.At(k);
        var uvs = UvCornersIn(tri, pts);
        var j = r.SplitSideSlotOf(tri, ChartCornersIn(tri, points), [nb.At(3 * k), nb.At(3 * k + 1), nb.At(3 * k + 2)]);
        return j < 0
            ? UvCoordinate((uvs[0].U + uvs[1].U + uvs[2].U) / 3.0, (uvs[0].V + uvs[1].V + uvs[2].V) / 3.0)
            : uvs[j].UvMidpoint(uvs[(j + 1) % 3]);
    }

    //==
    // # The flip test on four points

    // TriangulationCdt's InCircleOf for the points with indices a, b, c, d given as pa, pb, pc,
    // pd: the determinant of the four in increasing index order, signed by the permutation's
    // parity. The same value as InCircleOf on an array holding them.
    InCircleOfFour(a: Integer, b: Integer, c: Integer, d: Integer, pa: Point2D, pb: Point2D, pc: Point2D, pd: Point2D): Number
    {
        var ids = [a, b, c, d];
        var ps = [pa, pb, pc, pd];
        var ranks = 4.MapRange(i => 4.Range.Reduce(0, (n, j) => (ids[j] < ids[i] || (ids[j] == ids[i] && j < i)) ? n + 1 : n));
        var s = 4.MapRange(k => 4.Range.Reduce(0, (found, i) => ranks[i] == k ? i : found));
        var inversions = 4.Range.Reduce(0, (n, i) => 4.Range.Reduce(n, (m, j) => (i < j && ids[i] > ids[j]) ? m + 1 : m));
        var det = InCircle(ps[s[0]], ps[s[1]], ps[s[2]], ps[s[3]]);
        return inversions % 2 == 0 ? det : 0.0 - det;
    }

    // TriangulationCdt's IsFlippableCdt for the side from a to b of triangle (a, b, c), with d
    // opposite it across the side, given the four chart points: not a boundary segment, the
    // quadrilateral (a, d, b, c) strictly convex, d strictly inside the circle through a, b, c.
    IsFlippableFour(r: UvRegion, a: Integer, b: Integer, c: Integer, d: Integer, pa: Point2D, pb: Point2D, pc: Point2D, pd: Point2D): Boolean
        => r.IsConstrained(a, b)
            ? false
            : (TwiceSignedArea(pa, pd, pc) > 0.0
                && TwiceSignedArea(pd, pb, pc) > 0.0
                && InCircleOfFour(a, b, c, d, pa, pb, pc, pd) > 0.0);

    // The smallest corner angle, in radians, of the triangle with surface points p0, p1, p2:
    // TriangulationRefine's LiftedAngleOf with the corners already evaluated.
    AngleOfCorners(p0: Point3D, p1: Point3D, p2: Point3D): Number
        => CornerAngle(p0, p1, p2).Min(CornerAngle(p1, p2, p0)).Min(CornerAngle(p2, p0, p1));

    // LiftedAngleOf of triangle x, its corners' surface points read from pos (and `at` for the
    // point pi being tried).
    LiftedAngleIn(x: TriangleFace, pi: Integer, at: Point3D, pos: List<Point3D>): Number
        => AngleOfCorners(x.Corner(0).PositionAt(pi, at, pos), x.Corner(1).PositionAt(pi, at, pos), x.Corner(2).PositionAt(pi, at, pos));

    //==
    // # A trial

    // The triangles point pi (chart point p) splits and flips, as writes over the pass's
    // triangles: SplitAt (inside triangle q = (a, b, e), or with d >= 0 on its side from a to b
    // with triangle u = (b, a, d)), then TriangulationFast's FlippedAround on an overlay of the
    // triangles written, read through TriangleIn, with its queue, its order and its guard of four
    // flips per triangle. nb is the table of the triangles before the split.
    FlipCavity(r: UvRegion, q: Integer, u: Integer, a: Integer, b: Integer, e: Integer, d: Integer, p: Point2D, points: List<Point2D>, tris: List<TriangleFace>, nb: List<Integer>): TriangleWrites
    {
        var n0 = tris.Count;
        var pi = points.Count;
        var ids = new List<Integer>();
        var vals = new List<TriangleFace>();
        if (d < 0)
        {
            ids = ids.Add(q).Add(n0).Add(n0 + 1);
            vals = vals.Add(TriangleOf(a, b, pi)).Add(TriangleOf(b, e, pi)).Add(TriangleOf(e, a, pi));
        }
        else
        {
            ids = ids.Add(q).Add(n0).Add(u).Add(n0 + 1);
            vals = vals.Add(TriangleOf(a, pi, e)).Add(TriangleOf(pi, b, e)).Add(TriangleOf(b, pi, d)).Add(TriangleOf(pi, a, d));
        }
        var sq = tris.At(q).SideSlot(a, b);
        var sides = d < 0
            ? [a, b, q, nb.At(3 * q + sq), b, e, n0, nb.At(3 * q + (sq + 1) % 3), e, a, n0 + 1, nb.At(3 * q + (sq + 2) % 3)]
            : [e, a, q, nb.At(3 * q + (sq + 2) % 3), b, e, n0, nb.At(3 * q + (sq + 1) % 3),
                d, b, u, nb.At(3 * u + tris.At(u).SideSlot(d, b)), a, d, n0 + 1, nb.At(3 * u + tris.At(u).SideSlot(a, d))];
        var queue = new List<Integer>().AddRange(sides);
        var i = 0;
        var flips = 0;
        while (i + 3 < queue.Count && flips < 4 * (n0 + 2))
        {
            var sa = queue.At(i);
            var sb = queue.At(i + 1);
            var t = queue.At(i + 2);
            var o = queue.At(i + 3);
            var w = o < 0 ? TriangleOf(sa, sb, pi) : o.TriangleIn(ids, vals, tris);
            var live = o < 0 ? false
                : (t.TriangleIn(ids, vals, tris).SideSlot(sa, sb) >= 0 && w.SideSlot(sb, sa) >= 0 && w.HasCorner(pi).Not);
            var od = live ? w.OppositeCorner(sa, sb) : -1;
            if (od < 0 ? false : r.IsFlippableFour(sa, sb, pi, od, points.At(sa), points.At(sb), p, points.At(od)))
            {
                var o1 = nb.At(3 * o + w.SideSlot(sa, od));
                var o2 = nb.At(3 * o + w.SideSlot(od, sb));
                vals = vals.Set(t.PositionIn(ids), TriangleOf(sa, od, pi));
                var oi = o.PositionIn(ids);
                if (oi < 0)
                {
                    ids = ids.Add(o);
                    vals = vals.Add(TriangleOf(od, sb, pi));
                }
                else
                {
                    vals = vals.Set(oi, TriangleOf(od, sb, pi));
                }
                queue = queue.Add(sa).Add(od).Add(t).Add(o1).Add(od).Add(sb).Add(o).Add(o2);
                flips = flips + 1;
            }
            i = i + 4;
        }
        return TriangleWrites(ids.Freeze(), vals.Freeze());
    }

    // TriangulationFast's ChangedNear for a trial's writes c from triangle q: the old triangles c
    // rewrote, in the order a search from q across the table nb of the triangles before reaches
    // them, then the two appended (n0 and n0 + 1). A triangle rewritten by an insertion holds the
    // new point and none before it did, so "written" and "changed" are the same set.
    FanOf(q: Integer, n0: Integer, c: TriangleWrites, nb: List<Integer>): Array<Integer>
    {
        var seen = new List<Integer>().Add(q);
        var i = 0;
        while (i < seen.Count)
        {
            var t = seen.At(i);
            var s = 0;
            while (s < 3)
            {
                var o = nb.At(3 * t + s);
                if ((o >= 0 ? (o < n0 ? c.Writes(o) : false) : false) ? seen.Holds(o).Not : false)
                {
                    seen = seen.Add(o);
                }
                s = s + 1;
            }
            i = i + 1;
        }
        return seen.Add(n0).Add(n0 + 1).Freeze();
    }

    // TriangulationFast's ChangedAnglesAt over a trial: the smallest lifted angle of the triangles
    // c writes, in fan order, and of the triangles they replace (fan entries below n0, read from
    // tris); pi for none. Positions come from pos and `at`, never from the surface.
    CavityAngles(fan: Array<Integer>, c: TriangleWrites, pi: Integer, at: Point3D, pos: List<Point3D>, tris: List<TriangleFace>): Array<Number>
    {
        var n0 = tris.Count;
        var after = Number.Pi;
        var before = Number.Pi;
        var w = 0;
        while (w < fan.Count)
        {
            after = after.Min(c.WrittenAt(fan[w]).LiftedAngleIn(pi, at, pos));
            w = w + 1;
        }
        w = 0;
        while (w < fan.Count)
        {
            if (fan[w] < n0)
            {
                before = before.Min(tris.At(fan[w]).LiftedAngleIn(pi, at, pos));
            }
            w = w + 1;
        }
        return [after, before];
    }

    // TriangulationFast's UpdatedNeighbours as writes: for each triangle of the fan, in order,
    // each side through point pi gets the first fan triangle with the reverse side, and each side
    // opposite pi gets the triangle that bordered it before (read from nb through the first old
    // fan triangle that had the side), whose own entry is pointed back.
    CavityNeighbours(fan: Array<Integer>, c: TriangleWrites, pi: Integer, nb: List<Integer>, tris: List<TriangleFace>): SlotWrites
    {
        var n0 = tris.Count;
        var slots = new List<Integer>();
        var values = new List<Integer>();
        var w = 0;
        while (w < fan.Count)
        {
            var i = fan[w];
            var x = c.WrittenAt(i);
            var s = 0;
            while (s < 3)
            {
                var a = x.Corner(s);
                var b = x.Corner(s + 1);
                if (a == pi || b == pi)
                {
                    slots = slots.Add(3 * i + s);
                    values = values.Add(fan.Reduce(-1, (found, g) => found >= 0 ? found : (c.WrittenAt(g).SideSlot(b, a) >= 0 ? g : -1)));
                }
                else
                {
                    var owner = -1;
                    var g = 0;
                    while (owner < 0 && g < fan.Count)
                    {
                        if (fan[g] < n0 ? tris.At(fan[g]).SideSlot(a, b) >= 0 : false)
                        {
                            owner = fan[g];
                        }
                        g = g + 1;
                    }
                    var o = owner < 0 ? -1 : nb.At(3 * owner + tris.At(owner).SideSlot(a, b));
                    slots = slots.Add(3 * i + s);
                    values = values.Add(o);
                    if (o >= 0)
                    {
                        slots = slots.Add(3 * o + tris.At(o).SideSlot(b, a));
                        values = values.Add(i);
                    }
                }
                s = s + 1;
            }
            w = w + 1;
        }
        return SlotWrites(slots.Freeze(), values.Freeze());
    }

    // No writes.
    NoTriangleWrites(_: Integer): TriangleWrites
        => TriangleWrites([0].Take(0), [TriangleOf(0, 0, 0)].Take(0));

    // TriangulationFast's TryInsertion over a pass's builders, as the writes that keep parameter
    // point uv for triangle k: refused (Kept false) when the walk from k does not reach it, it is
    // near a corner or on a boundary segment, the split leaves a non-positive triangle, it is not
    // strictly inside the region by tol, its surface point is within `least` of a corner it
    // joins, or, when `guarded`, the smallest lifted angle of the triangles it changes is not
    // larger than that of the triangles it replaces. The point would be points.Count. The
    // surface is evaluated once, at uv, and only for a point strictly inside; the corners'
    // positions are read from pos. The tests run cheapest first; TryInsertion's verdict does not
    // depend on their order.
    TryInsertionInto(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, tol: UvTolerance, least: Number, guarded: Boolean, k: Integer, uv: UvCoordinate, points: List<Point2D>, pos: List<Point3D>, tris: List<TriangleFace>, nb: List<Integer>): TrialInsertion
    {
        var p = chart.ChartPoint(uv);
        var q = p.WalkToIn(k, points, tris, nb);
        var tri = tris.At(q.Max(0));
        var j = q < 0 ? 3 : ChartCornersIn(tri, points).PlaceInTriangle(TriangleOf(0, 1, 2), p);
        var a = tri.Corner(j.Max(0));
        var b = tri.Corner(j.Max(0) + 1);
        var e = tri.Corner(j.Max(0) + 2);
        var u = (j >= 0 && j < 3) ? nb.At(3 * q + j) : -1;
        var d = u < 0 ? -1 : tris.At(u).OppositeCorner(a, b);
        var free = j == 3 ? false : (j < 0 ? true : (u >= 0 ? r.IsConstrained(a, b).Not : false));
        var corners = d < 0 ? [points.At(a), points.At(b), points.At(e)] : [points.At(a), points.At(b), points.At(e), points.At(d)];
        var positive = free ? corners.SplitIsPositive(0, 1, 2, d < 0 ? -1 : 3, p) : false;
        var inside = positive ? r.IsStrictlyInside(uv, tol) : false;
        var at = inside ? m.Geometry.Eval(m.SurfaceOf(f), uv) : Point3D(0.0, 0.0, 0.0);
        var ring = d < 0 ? [pos.At(a), pos.At(b), pos.At(e)] : [pos.At(a), pos.At(d), pos.At(b), pos.At(e)];
        var good = inside ? ring.All(x => x.Distance(at) >= least) : false;
        var cavity = good ? r.FlipCavity(q, u, a, b, e, d, p, points, tris, nb) : NoTriangleWrites(0);
        var fan = good ? q.FanOf(tris.Count, cavity, nb) : [0].Take(0);
        var angles = (good && guarded) ? fan.CavityAngles(cavity, points.Count, at, pos, tris) : [1.0, 0.0];
        var kept = good ? (angles[0] > angles[1] && m.CavityIsThick(cavity, points.Count, at, pos, tris)) : false;
        return TrialInsertion(kept, uv, p, at,
            kept ? cavity : NoTriangleWrites(0),
            kept ? 2 : 0,
            kept ? fan.CavityNeighbours(cavity, points.Count, nb, tris) : SlotWrites([0].Take(0), [0].Take(0)),
            inside ? 1 : 0);
    }

    //==
    // # Applying a trial

    // tris with trial x's triangle writes made: a slot below the count is set, the next one
    // appended.
    WithTriangles(x: TrialInsertion, tris: List<TriangleFace>): List<TriangleFace>
    {
        var result = tris;
        var i = 0;
        while (i < x.Triangles.Slots.Count)
        {
            var s = x.Triangles.Slots[i];
            if (s < result.Count)
            {
                result = result.Set(s, x.Triangles.Triangles[i]);
            }
            else
            {
                result = result.Add(x.Triangles.Triangles[i]);
            }
            i = i + 1;
        }
        return result;
    }

    // nb with trial x's neighbour writes made, after a slot of -1 for each side of each appended
    // triangle.
    WithNeighbours(x: TrialInsertion, nb: List<Integer>): List<Integer>
    {
        var result = nb;
        var i = 0;
        while (i < 3 * x.Appended)
        {
            result = result.Add(-1);
            i = i + 1;
        }
        i = 0;
        while (i < x.Neighbours.Slots.Count)
        {
            result = result.Set(x.Neighbours.Slots[i], x.Neighbours.Values[i]);
            i = i + 1;
        }
        return result;
    }

    // The builder elements a kept trial writes: the point's three entries (parameters, chart
    // point, surface point), its triangle writes, and its neighbour writes with the appended
    // triangles' slots.
    Written(x: TrialInsertion): Integer
        => 3 + x.Triangles.Slots.Count + 3 * x.Appended + x.Neighbours.Slots.Count;

    //==
    // # The passes

    // SurfacePassLocal over builders, with its work: every triangle of t that exceeds a surface
    // criterion (surface[k]) and is still at index k when its turn comes gets its circumcentre,
    // or failing that its SurfaceFallbackIn, through TryInsertionInto without the guard. The new
    // points are Interior and come after every existing point, with their surface positions.
    // Evaluations counts the surface evaluations of the trials (at most one per candidate),
    // Insertions the builder elements the kept trials write (Written); the pass's setup (one
    // copy of t into the builders and one NeighbourSlots) is not counted.
    SurfacePassBuiltCounted(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, tol: UvTolerance, least: Number, t: PositionedTriangulation, surface: Array<Boolean>): Counted<PositionedTriangulation>
    {
        var u0 = t.Triangulation;
        var pts = new List<UvCoordinate>().AddRange(u0.Points);
        var points = new List<Point2D>().AddRange(u0.Points.Map(x => chart.ChartPoint(x)));
        var pos = new List<Point3D>().AddRange(t.Positions);
        var tris = new List<TriangleFace>().AddRange(u0.Triangles);
        var nb = new List<Integer>().AddRange(NeighbourSlots(u0.Triangles, u0.Points.Count));
        var evaluations = 0;
        var written = 0;
        var k = 0;
        while (k < u0.Triangles.Count)
        {
            if (surface[k] ? tris.At(k) == u0.Triangles[k] : false)
            {
                var centre = chart.Circumcentre(ChartCornersIn(tris.At(k), points), TriangleOf(0, 1, 2));
                var first = m.TryInsertionInto(f, r, chart, tol, least, false, k, centre, points, pos, tris, nb);
                var uv = first.Kept ? centre : r.SurfaceFallbackIn(k, pts, points, tris, nb);
                var next = first.Kept ? first : m.TryInsertionInto(f, r, chart, tol, least, false, k, uv, points, pos, tris, nb);
                evaluations = evaluations + first.Evaluations + (first.Kept ? 0 : next.Evaluations);
                if (next.Kept)
                {
                    pts = pts.Add(next.Point);
                    points = points.Add(next.Chart);
                    pos = pos.Add(next.Position);
                    tris = next.WithTriangles(tris);
                    nb = next.WithNeighbours(nb);
                    written = written + next.Written;
                }
            }
            k = k + 1;
        }
        var added = pts.Count - u0.Points.Count;
        var value = PositionedTriangulation(
            UvTriangulation(pts.Freeze(), u0.Sources.Concatenate(added.MapRange(i => UvPointSource.Interior)), tris.Freeze(), u0.Quads),
            pos.Freeze());
        return Counted(value, Evaluations(evaluations).Add(Insertions(written)));
    }

    // SurfacePassBuiltCounted's triangulation.
    SurfacePassBuilt(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, tol: UvTolerance, least: Number, t: PositionedTriangulation, surface: Array<Boolean>): PositionedTriangulation
        => m.SurfacePassBuiltCounted(f, r, chart, tol, least, t, surface).Value;

    // AnglePassLocal over builders, with its work counted as SurfacePassBuiltCounted counts it:
    // every triangle of `bad`, while it is still at its index, gets the first of its
    // AngleCandidates that TryInsertionInto keeps under the guard; each candidate is tried once.
    AnglePassBuiltCounted(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, tol: UvTolerance, least: Number, t: PositionedTriangulation, bad: Array<Integer>): Counted<PositionedTriangulation>
    {
        var u0 = t.Triangulation;
        var pts = new List<UvCoordinate>().AddRange(u0.Points);
        var points = new List<Point2D>().AddRange(u0.Points.Map(x => chart.ChartPoint(x)));
        var pos = new List<Point3D>().AddRange(t.Positions);
        var tris = new List<TriangleFace>().AddRange(u0.Triangles);
        var nb = new List<Integer>().AddRange(NeighbourSlots(u0.Triangles, u0.Points.Count));
        var evaluations = 0;
        var written = 0;
        var i = 0;
        while (i < bad.Count)
        {
            var k = bad[i];
            if (tris.At(k) == u0.Triangles[k])
            {
                var tri = tris.At(k);
                var candidates = chart.AngleCandidates(ChartCornersIn(tri, points), UvCornersIn(tri, pts), TriangleOf(0, 1, 2));
                var n = 0;
                while (n < candidates.Count)
                {
                    var next = m.TryInsertionInto(f, r, chart, tol, least, true, k, candidates[n], points, pos, tris, nb);
                    evaluations = evaluations + next.Evaluations;
                    if (next.Kept)
                    {
                        pts = pts.Add(next.Point);
                        points = points.Add(next.Chart);
                        pos = pos.Add(next.Position);
                        tris = next.WithTriangles(tris);
                        nb = next.WithNeighbours(nb);
                        written = written + next.Written;
                        n = candidates.Count;
                    }
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        var added = pts.Count - u0.Points.Count;
        var value = PositionedTriangulation(
            UvTriangulation(pts.Freeze(), u0.Sources.Concatenate(added.MapRange(j => UvPointSource.Interior)), tris.Freeze(), u0.Quads),
            pos.Freeze());
        return Counted(value, Evaluations(evaluations).Add(Insertions(written)));
    }

    // AnglePassBuiltCounted's triangulation.
    AnglePassBuilt(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, tol: UvTolerance, least: Number, t: PositionedTriangulation, bad: Array<Integer>): PositionedTriangulation
        => m.AnglePassBuiltCounted(f, r, chart, tol, least, t, bad).Value;

    //==
    // # Refinement

    // Triangulation t with the surface point of each of its points on face f.
    Positioned(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation): PositionedTriangulation
        => PositionedTriangulation(t, t.Points.Map(uv => m.Geometry.Eval(m.SurfaceOf(f), uv)));

    // TriangulationFast's RefineToSurfaceByInsertion with SurfacePassBuilt and AnglePassBuilt: the
    // same rounds, marks and stopping rule, the region tolerance and minimum length computed
    // once, and the points' surface positions evaluated once and carried between passes.
    RefineToSurfaceByInsertionBuilt(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, t: UvTriangulation, c: FaceMeshingCriteria): UvTriangulation
    {
        var planar = m.Geometry.SurfaceAt(m.SurfaceOf(f)).IsPlanarRecord;
        var tol = m.RegionTolerance(f, chart);
        var least = c.Discretization.EffectiveMinLength(m.Tolerances);
        var none = [0].Take(0);
        var current = m.Positioned(f, t);
        var known = t.Triangles.Map(x => false);
        var refused = t.Triangles.Map(x => false);
        var good = t.Triangles.Map(x => false);
        var pass = 0;
        var changed = true;
        while (pass < 40 && changed)
        {
            var now = current.Triangulation;
            var surface = planar ? now.Triangles.Map(x => false) : m.NeedsRefinementCached(f, r, current, known, c);
            var mid = m.SurfacePassBuilt(f, r, chart, tol, least, current, surface);
            var carried = now.Triangles.CarriedMarks(refused, none, mid.Triangulation.Triangles);
            var goodMid = now.Triangles.CarriedMarks(good, none, mid.Triangulation.Triangles);
            var bad = m.BelowAngleKnown(f, mid.Triangulation, carried, goodMid);
            var next = m.AnglePassBuilt(f, r, chart, tol, least, mid, bad);
            refused = mid.Triangulation.Triangles.CarriedMarks(carried, bad, next.Triangulation.Triangles);
            good = mid.Triangulation.Triangles.CarriedMarks(mid.Triangulation.AngleGoodMarks(carried, bad), none, next.Triangulation.Triangles);
            known = KnownGood(now, surface, next.Triangulation);
            changed = next.Triangulation.Points.Count > now.Points.Count;
            current = next;
            pass = pass + 1;
        }
        return current.Triangulation;
    }
}

//==
// # The constrained Delaunay seed by insertion (track v1-edges, chunk E4, TKT-468)
//
// Layer 05-face-meshing. TriangulateRegionCdt seeded its flips with ear clipping over one ring
// that bridges every hole to the outer loop. With many holes the bridges meet at shared vertices
// and run along pad sides, the ring is only weakly simple, and ear clipping accepts an ear whose
// new side crosses a side leaving another copy of a shared vertex. The rest is no longer simple,
// clipping stops, and the face misses triangles: 3,221 in 72 faces of 36 corpus files (CEL/LARA
// F742 has 546 of its 602). No bridge is needed here:
//  - every boundary point is inserted into a triangle that holds them all, in an order that keeps
//    the point location walk short (a counting sort by grid column, rows alternating), each
//    insertion splitting the triangle it lands in and flipping until the triangles about the new
//    point are Delaunay again (Lawson);
//  - each boundary segment that is not yet a side is made one by flipping the sides it crosses,
//    taken in queue order, a side whose quadrilateral is not strictly convex going to the back
//    (Sloan 1993);
//  - triangles below the area floor (a point inserted exactly on a side leaves a flat one) are
//    flipped across their longest side, after the insertions and again after the recovery;
//  - the triangles on the left of the directed boundary segments (the region lies on the left of
//    its loops in the chart), and every triangle reached from them without crossing a boundary
//    segment, are kept.
// The flips use the library's tests: TwiceSignedArea for orientation and InCircleOfSorted, the
// in-circle determinant evaluated in index order (TKT-343), for Delaunay. DelaunayedIndexed still
// runs after the seed, so the seed need only be a valid triangulation; its insertion flips make
// it close to Delaunay already.
//
// The state is one List<Integer> laid out in blocks, capacity cap triangles (a triangulation of
// m points in a triangle has at most 2 m - 5): entry 0 the triangle count; 1 + 3 t + j the corner
// j of triangle t, counter-clockwise; 1 + 3 cap + 3 t + j the triangle across side j (corner j to
// corner j + 1) or -1; 1 + 6 cap + v a triangle that has point v as a corner.
//
// Sections, in order:
//  - The state
//  - Splits and flips
//  - Locating, inserting
//  - Recovering the boundary segments
//  - Removing slivers
//  - Keeping the region
//  - The seed

library V1EdgesCdtSeed
{
    //==
    // # The state

    // Corner j (modulo three) of triangle t.
    SeedCorner(s: List<Integer>, t: Integer, j: Integer): Integer
        => s.At(1 + 3 * t + j % 3);

    // The triangle across side j (modulo three) of triangle t, or -1.
    SeedAcross(s: List<Integer>, cap: Integer, t: Integer, j: Integer): Integer
        => s.At(1 + 3 * cap + 3 * t + j % 3);

    // A triangle with point v as a corner.
    SeedAt(s: List<Integer>, cap: Integer, v: Integer): Integer
        => s.At(1 + 6 * cap + v);

    // The state with triangle t given corners (a, b, c) and the triangles across its sides
    // (x for a-b, y for b-c, z for c-a), and each corner pointed at t.
    WithSeedTriangle(s: List<Integer>, cap: Integer, t: Integer, a: Integer, b: Integer, c: Integer, x: Integer, y: Integer, z: Integer): List<Integer>
        => s.Set(1 + 3 * t, a).Set(2 + 3 * t, b).Set(3 + 3 * t, c)
            .Set(1 + 3 * cap + 3 * t, x).Set(2 + 3 * cap + 3 * t, y).Set(3 + 3 * cap + 3 * t, z)
            .Set(1 + 6 * cap + a, t).Set(1 + 6 * cap + b, t).Set(1 + 6 * cap + c, t);

    // The slot j of triangle t whose side runs from a to b; -1 when none does.
    SeedSide(s: List<Integer>, t: Integer, a: Integer, b: Integer): Integer
        => s.SeedCorner(t, 0) == a && s.SeedCorner(t, 1) == b ? 0
            : (s.SeedCorner(t, 1) == a && s.SeedCorner(t, 2) == b ? 1
            : (s.SeedCorner(t, 2) == a && s.SeedCorner(t, 0) == b ? 2 : -1));

    // The state with the side of triangle o that runs from b to a facing triangle t; unchanged
    // when o is -1.
    SeedPointedBack(s: List<Integer>, cap: Integer, o: Integer, a: Integer, b: Integer, t: Integer): List<Integer>
        => o < 0 ? s : s.Set(1 + 3 * cap + 3 * o + s.SeedSide(o, b, a), t);

    // The empty state for m points: capacity cap, no triangle.
    EmptySeedState(m: Integer, cap: Integer): List<Integer>
    {
        var s = new List<Integer>();
        var k = 0;
        while (k < 1 + 6 * cap + m)
        {
            s = s.Add(k == 0 ? 0 : -1);
            k = k + 1;
        }
        return s;
    }

    // The stack with v at position top: written over an entry left by a pop, or added.
    Pushed(stack: List<Integer>, top: Integer, v: Integer): List<Integer>
        => top < stack.Count ? stack.Set(top, v) : stack.Add(v);

    //==
    // # Splits and flips

    // The state with side j of triangle t flipped: t = (a, b, c) and u = (b, a, d) across it
    // become (a, d, c) and (d, b, c). Precondition: side j has a triangle across it.
    SeedFlipped(s: List<Integer>, cap: Integer, t: Integer, j: Integer): List<Integer>
    {
        var u = s.SeedAcross(cap, t, j);
        var a = s.SeedCorner(t, j);
        var b = s.SeedCorner(t, j + 1);
        var c = s.SeedCorner(t, j + 2);
        var k = s.SeedSide(u, b, a);
        var d = s.SeedCorner(u, k + 2);
        var tbc = s.SeedAcross(cap, t, j + 1);
        var tca = s.SeedAcross(cap, t, j + 2);
        var uad = s.SeedAcross(cap, u, k + 1);
        var udb = s.SeedAcross(cap, u, k + 2);
        var r = s.WithSeedTriangle(cap, t, a, d, c, uad, u, tca).WithSeedTriangle(cap, u, d, b, c, udb, tbc, t);
        return r.SeedPointedBack(cap, uad, a, d, t).SeedPointedBack(cap, tca, c, a, t)
            .SeedPointedBack(cap, udb, d, b, u).SeedPointedBack(cap, tbc, b, c, u);
    }

    // Whether side j of triangle t should flip while restoring Delaunay after an insertion: it
    // has a triangle across it, and either the point d across lies inside the circle of t by
    // more than 1e-12 of the determinant's scale (InCircleScale), or t is flat (a point inserted
    // on a side leaves one) and the quadrilateral is strictly convex, so the flip removes it.
    // The margin keeps cocircular points (the corners of every rectangle of a pad array, the
    // points of a subdivided rectangle) from flipping in a cycle on rounding noise: with the
    // strict test a rectangle with 60 points a side flipped more than 2 million times.
    SeedSideIllegal(s: List<Integer>, cap: Integer, points: Array<Point2D>, t: Integer, j: Integer): Boolean
    {
        var u = s.SeedAcross(cap, t, j);
        var a = s.SeedCorner(t, j);
        var b = s.SeedCorner(t, j + 1);
        var c = s.SeedCorner(t, j + 2);
        var d = u < 0 ? a : s.SeedCorner(u, s.SeedSide(u, b, a) + 2);
        return u < 0 ? false
            : (points.InCircleOfSorted(a, b, c, d) > 1e-12 * InCircleScale(points[a], points[b], points[c], points[d])
                || (TwiceSignedArea(points[a], points[b], points[c]) <= 0.0
                    && TwiceSignedArea(points[a], points[d], points[c]) > 0.0
                    && TwiceSignedArea(points[d], points[b], points[c]) > 0.0));
    }

    // The state with point p inserted in triangle t = (a, b, c): t becomes (a, b, p), two new
    // triangles (b, c, p) and (c, a, p), then sides opposite p flipped while illegal, the flips
    // queued on a stack of (triangle, slot) pairs coded 3 t + j.
    SeedInserted(s0: List<Integer>, cap: Integer, points: Array<Point2D>, t: Integer, p: Integer): List<Integer>
    {
        var a = s0.SeedCorner(t, 0);
        var b = s0.SeedCorner(t, 1);
        var c = s0.SeedCorner(t, 2);
        var nab = s0.SeedAcross(cap, t, 0);
        var nbc = s0.SeedAcross(cap, t, 1);
        var nca = s0.SeedAcross(cap, t, 2);
        var t1 = s0.At(0);
        var t2 = t1 + 1;
        var s = s0.Set(0, t1 + 2)
            .WithSeedTriangle(cap, t, a, b, p, nab, t1, t2)
            .WithSeedTriangle(cap, t1, b, c, p, nbc, t2, t)
            .WithSeedTriangle(cap, t2, c, a, p, nca, t, t1);
        s = s.SeedPointedBack(cap, nbc, b, c, t1).SeedPointedBack(cap, nca, c, a, t2);
        var stack = new List<Integer>().Add(3 * t).Add(3 * t1).Add(3 * t2);
        var top = 3;
        var guard = 0;
        while (top > 0 && guard < 64 * cap)
        {
            top = top - 1;
            var code = stack.At(top);
            var x = code / 3;
            var j = code % 3;
            if (s.SeedSideIllegal(cap, points, x, j))
            {
                var u = s.SeedAcross(cap, x, j);
                s = s.SeedFlipped(cap, x, j);
                stack = stack.Pushed(top, 3 * x);
                top = top + 1;
                stack = stack.Pushed(top, 3 * u);
                top = top + 1;
            }
            guard = guard + 1;
        }
        return s;
    }

    //==
    // # Locating, inserting

    // Whether point p lies outside the side from a to b by more than rounding: its orientation
    // below -1e-12 times |ab| |ap|. A point on a side shared by two triangles can come out a
    // rounding error outside both (-3.7e-32 on M2-ZED-F9T-25B-00's face 1619), and a strict test
    // then finds no triangle for it; with the margin both hold it, the first is split, and the
    // flat triangle left is flipped away.
    SeedOutsideSide(points: Array<Point2D>, a: Integer, b: Integer, p: Integer): Boolean
        => TwiceSignedArea(points[a], points[b], points[p]) < -1e-12 * points[a].Distance(points[b]) * points[a].Distance(points[p]);

    // A triangle of the state holding point p (on or inside its sides), found by walking from
    // triangle start across a side p lies strictly outside of, at most 4 cap + 10 steps; then a
    // scan of every triangle; -1 when none holds p.
    SeedLocate(s: List<Integer>, cap: Integer, points: Array<Point2D>, start: Integer, p: Integer): Integer
    {
        var t = start;
        var steps = 0;
        var moving = true;
        while (moving && steps < 4 * cap + 10)
        {
            moving = false;
            var j = 0;
            while (j < 3 && moving.Not)
            {
                var a = s.SeedCorner(t, j);
                var b = s.SeedCorner(t, j + 1);
                if (SeedOutsideSide(points, a, b, p) && s.SeedAcross(cap, t, j) >= 0)
                {
                    t = s.SeedAcross(cap, t, j);
                    moving = true;
                }
                j = j + 1;
            }
            steps = steps + 1;
        }
        return moving.Not ? t : s.SeedScan(points, p);
    }

    // The first triangle of the state holding point p, by a scan; -1 when none does.
    SeedScan(s: List<Integer>, points: Array<Point2D>, p: Integer): Integer
    {
        var found = -1;
        var t = 0;
        while (t < s.At(0) && found < 0)
        {
            if (SeedOutsideSide(points, s.SeedCorner(t, 0), s.SeedCorner(t, 1), p).Not
                && SeedOutsideSide(points, s.SeedCorner(t, 1), s.SeedCorner(t, 2), p).Not
                && SeedOutsideSide(points, s.SeedCorner(t, 2), s.SeedCorner(t, 0), p).Not)
            {
                found = t;
            }
            t = t + 1;
        }
        return found;
    }

    // The order the n boundary points are inserted in: by grid column of side (extent / 16),
    // rows alternating up and down the columns, so consecutive points are near each other and
    // each location walk is short. A counting sort on the cell, no comparator.
    SeedInsertionOrder(points: Array<Point2D>, n: Integer): Array<Integer>
    {
        var lowX = n.Range.Reduce(Number.MaxValue, (m, i) => m.Min(points[i].X));
        var lowY = n.Range.Reduce(Number.MaxValue, (m, i) => m.Min(points[i].Y));
        var highX = n.Range.Reduce(0.0 - Number.MaxValue, (m, i) => m.Max(points[i].X));
        var highY = n.Range.Reduce(0.0 - Number.MaxValue, (m, i) => m.Max(points[i].Y));
        var side = ((highX - lowX).Max(highY - lowY) / 16.0).Max(Number.SmallestNormal);
        var columns = ((highX - lowX) / side).Floor.ToInteger + 1;
        var rows = ((highY - lowY) / side).Floor.ToInteger + 1;
        var keys = n.MapRange(i => SeedCellKey(((points[i].X - lowX) / side).Floor.ToInteger.Min(columns - 1),
            ((points[i].Y - lowY) / side).Floor.ToInteger.Min(rows - 1), rows));
        return n.Range.CountingSortBy(keys, columns * rows);
    }

    // The serpentine cell key of column x, row y among rows rows.
    SeedCellKey(x: Integer, y: Integer, rows: Integer): Integer
        => x * rows + (x % 2 == 0 ? y : rows - 1 - y);

    //==
    // # Recovering the boundary segments

    // Whether the state has a side between points a and b, by turning about a: from the triangle
    // the state points a at, across the side entering a each time, until back at the start or a
    // side with nothing across.
    SeedHasSide(s: List<Integer>, cap: Integer, a: Integer, b: Integer): Boolean
        => s.SeedSideAbout(cap, a, b) >= 0;

    // A triangle about point a with a side a to b or b to a, by turning about a both ways from
    // the triangle the state points a at; -1 when none has.
    SeedSideAbout(s: List<Integer>, cap: Integer, a: Integer, b: Integer): Integer
    {
        var start = s.SeedAt(cap, a);
        var found = -1;
        var t = start;
        var going = start >= 0;
        var steps = 0;
        while (going && found < 0 && steps < cap)
        {
            var j = s.SeedCornerSlot(t, a);
            if (s.SeedCorner(t, j + 1) == b || s.SeedCorner(t, j + 2) == b)
            {
                found = t;
            }
            t = s.SeedAcross(cap, t, j + 2);
            going = t >= 0 && t != start;
            steps = steps + 1;
        }
        return found;
    }

    // The slot of point v among the corners of triangle t; -1 when v is not a corner.
    SeedCornerSlot(s: List<Integer>, t: Integer, v: Integer): Integer
        => s.SeedCorner(t, 0) == v ? 0 : (s.SeedCorner(t, 1) == v ? 1 : (s.SeedCorner(t, 2) == v ? 2 : -1));

    // Whether segments (a, b) and (u, v) cross at a point inside both.
    SeedProperlyCross(points: Array<Point2D>, a: Integer, b: Integer, u: Integer, v: Integer): Boolean
    {
        var d1 = TwiceSignedArea(points[a], points[b], points[u]);
        var d2 = TwiceSignedArea(points[a], points[b], points[v]);
        var d3 = TwiceSignedArea(points[u], points[v], points[a]);
        var d4 = TwiceSignedArea(points[u], points[v], points[b]);
        return ((d1 > 0.0 && d2 < 0.0) || (d1 < 0.0 && d2 > 0.0)) && ((d3 > 0.0 && d4 < 0.0) || (d3 < 0.0 && d4 > 0.0));
    }

    // The sides of the state that segment a-b properly crosses, each once, coded u m + v with
    // u < v (m the point count): a scan of every triangle. Boundary segments are left out (in a
    // simple region no boundary segment crosses another).
    SeedCrossedSides(s: List<Integer>, cap: Integer, points: Array<Point2D>, next: Array<Integer>, a: Integer, b: Integer): List<Integer>
    {
        var m = points.Count;
        var crossed = new List<Integer>();
        var t = 0;
        while (t < s.At(0))
        {
            var j = 0;
            while (j < 3)
            {
                var u = s.SeedCorner(t, j);
                var v = s.SeedCorner(t, j + 1);
                if (u < v && s.SeedAcross(cap, t, j) >= 0)
                {
                    if (SeedProperlyCross(points, a, b, u, v) && next.IsConstrainedIn(u, v).Not)
                    {
                        crossed = crossed.Add(u * m + v);
                    }
                }
                j = j + 1;
            }
            t = t + 1;
        }
        return crossed;
    }

    // The state with segment a-b made a side (Sloan 1993): the sides it crosses in a queue; the
    // side at the front flips when its quadrilateral is strictly convex, and the new side goes to
    // the back when it still crosses a-b; a side that cannot flip yet goes to the back. Taking
    // the sides in queue order is what makes the method end: flipping the first convex crossing
    // side found by a scan, again and again, cycled on SHO/SAM_AP203 face 49 (over 1,000 flips
    // without recovering the segment). Stops after 50 cap steps.
    SeedWithSegment(s0: List<Integer>, cap: Integer, points: Array<Point2D>, next: Array<Integer>, a: Integer, b: Integer): List<Integer>
    {
        if (s0.SeedHasSide(cap, a, b))
        {
            return s0;
        }
        var s = s0;
        var m = points.Count;
        var queue = s.SeedCrossedSides(cap, points, next, a, b);
        var head = 0;
        var steps = 0;
        while (head < queue.Count && steps < 50 * cap)
        {
            var code = queue.At(head);
            head = head + 1;
            var u = code / m;
            var v = code % m;
            var t = s.SeedSideAbout(cap, u, v);
            if (t >= 0)
            {
                var j = s.SeedSide(t, u, v) >= 0 ? s.SeedSide(t, u, v) : s.SeedSide(t, v, u);
                var uu = s.SeedCorner(t, j);
                var vv = s.SeedCorner(t, j + 1);
                var w = s.SeedAcross(cap, t, j);
                var c = s.SeedCorner(t, j + 2);
                var x = w < 0 ? c : s.SeedCorner(w, s.SeedSide(w, vv, uu) + 2);
                if (w >= 0 && TwiceSignedArea(points[c], points[x], points[vv]) > 0.0 && TwiceSignedArea(points[x], points[c], points[uu]) > 0.0)
                {
                    s = s.SeedFlipped(cap, t, j);
                    if (SeedProperlyCross(points, a, b, c, x))
                    {
                        queue = queue.Add(c.Min(x) * m + c.Max(x));
                    }
                }
                else
                {
                    queue = queue.Add(code);
                }
            }
            steps = steps + 1;
        }
        return s;
    }

    //==
    // # Removing slivers

    // Whether triangle t is below the area floor: 2 area under 1e-9 times its longest side
    // squared (TKT-462's bound).
    SeedIsSliver(s: List<Integer>, points: Array<Point2D>, t: Integer): Boolean
    {
        var a = points[s.SeedCorner(t, 0)];
        var b = points[s.SeedCorner(t, 1)];
        var c = points[s.SeedCorner(t, 2)];
        var longest = a.Distance(b).Max(b.Distance(c)).Max(c.Distance(a));
        return TwiceSignedArea(a, b, c) < 1e-9 * longest * longest;
    }

    // The slot of triangle t's longest side.
    SeedLongestSide(s: List<Integer>, points: Array<Point2D>, t: Integer): Integer
    {
        var d0 = points[s.SeedCorner(t, 0)].Distance(points[s.SeedCorner(t, 1)]);
        var d1 = points[s.SeedCorner(t, 1)].Distance(points[s.SeedCorner(t, 2)]);
        var d2 = points[s.SeedCorner(t, 2)].Distance(points[s.SeedCorner(t, 0)]);
        return d0 >= d1 && d0 >= d2 ? 0 : (d1 >= d2 ? 1 : 2);
    }

    // The state with every triangle below the area floor flipped across its longest side (the
    // side opposite its middle corner) when both triangles the flip makes are positive and, when
    // protect is set, that side is not a boundary segment; passes over every triangle until one
    // changes nothing, at most 8 n passes. A point inserted exactly on a side leaves a flat
    // triangle whose middle point is the older point, which the insertion's flips never test:
    // NORA-B100's big plane kept 15 of them, pads of different holes on one line (x = -2.7).
    SeedWithoutSlivers(s0: List<Integer>, cap: Integer, points: Array<Point2D>, next: Array<Integer>, protect: Boolean, n: Integer): List<Integer>
    {
        var s = s0;
        var changed = true;
        var passes = 0;
        while (changed && passes < 8 * n)
        {
            changed = false;
            var t = 0;
            while (t < s.At(0))
            {
                if (s.SeedIsSliver(points, t))
                {
                    var j = s.SeedLongestSide(points, t);
                    var u = s.SeedAcross(cap, t, j);
                    var a = s.SeedCorner(t, j);
                    var b = s.SeedCorner(t, j + 1);
                    var c = s.SeedCorner(t, j + 2);
                    var free = protect ? next.IsConstrainedIn(a, b).Not : true;
                    if (u >= 0 && free)
                    {
                        var d = s.SeedCorner(u, s.SeedSide(u, b, a) + 2);
                        if (TwiceSignedArea(points[a], points[d], points[c]) > 0.0 && TwiceSignedArea(points[d], points[b], points[c]) > 0.0)
                        {
                            s = s.SeedFlipped(cap, t, j);
                            changed = true;
                        }
                    }
                }
                t = t + 1;
            }
            passes = passes + 1;
        }
        return s;
    }

    //==
    // # Keeping the region

    // Whether the side from a to b, in either direction, is a boundary segment.
    SeedIsSegment(next: Array<Integer>, a: Integer, b: Integer): Boolean
        => next.IsConstrainedIn(a, b);

    // Per triangle of the state, whether it lies in the region: the triangles with a side running
    // a to next[a] (the region is on the left of its loops), then every triangle reached from
    // them across a side that is not a boundary segment.
    SeedInside(s: List<Integer>, cap: Integer, next: Array<Integer>): Array<Boolean>
    {
        var count = s.At(0);
        var inside = new Buffer<Boolean>(count);
        var t = 0;
        while (t < count)
        {
            inside = inside.Set(t, false);
            t = t + 1;
        }
        var stack = new List<Integer>();
        t = 0;
        while (t < count)
        {
            var j = 0;
            while (j < 3)
            {
                var a = s.SeedCorner(t, j);
                if (a < next.Count && inside.At(t).Not)
                {
                    if (next[a] >= 0 && next[a] == s.SeedCorner(t, j + 1))
                    {
                        inside = inside.Set(t, true);
                        stack = stack.Add(t);
                    }
                }
                j = j + 1;
            }
            t = t + 1;
        }
        var top = stack.Count;
        while (top > 0)
        {
            top = top - 1;
            var x = stack.At(top);
            var k = 0;
            while (k < 3)
            {
                var u = s.SeedAcross(cap, x, k);
                if (u >= 0)
                {
                    if (inside.At(u).Not && SeedIsSegment(next, s.SeedCorner(x, k), s.SeedCorner(x, k + 1)).Not)
                    {
                        inside = inside.Set(u, true);
                        stack = stack.Pushed(top, u);
                        top = top + 1;
                    }
                }
                k = k + 1;
            }
        }
        return inside.Freeze();
    }

    //==
    // # The seed

    // The constrained Delaunay seed of the region whose boundary points are points (in the
    // chart) and whose boundary segments are next (NextBoundaryTable: next[a] follows a on its
    // loop, -1 for a point of a point hole or a two-point loop). Points that coincide with an
    // earlier one are not inserted and their segments are not recovered. Every boundary point is
    // a corner otherwise; every boundary segment of three-point loops or longer a side; the
    // region covered exactly. Triangles over the point indices 0 to n - 1, counter-clockwise.
    CdtSeedByInsertion(points: Array<Point2D>, next: Array<Integer>): Array<TriangleFace>
    {
        var n = points.Count;
        var cap = 2 * (n + 3);
        var lowX = n.Range.Reduce(Number.MaxValue, (m, i) => m.Min(points[i].X));
        var lowY = n.Range.Reduce(Number.MaxValue, (m, i) => m.Min(points[i].Y));
        var highX = n.Range.Reduce(0.0 - Number.MaxValue, (m, i) => m.Max(points[i].X));
        var highY = n.Range.Reduce(0.0 - Number.MaxValue, (m, i) => m.Max(points[i].Y));
        var size = (highX - lowX).Max(highY - lowY).Max(Number.SmallestNormal);
        var cx = (lowX + highX) * 0.5;
        var cy = (lowY + highY) * 0.5;
        var big = 64.0 * size;
        var all = points.Concatenate([Point2D(cx - 2.0 * big, cy - big), Point2D(cx + 2.0 * big, cy - big), Point2D(cx, cy + 2.0 * big)]);
        var s = EmptySeedState(n + 3, cap).Set(0, 1).WithSeedTriangle(cap, 0, n, n + 1, n + 2, -1, -1, -1);
        var placed = new Buffer<Integer>(n);
        var k = 0;
        while (k < n)
        {
            placed = placed.Set(k, -1);
            k = k + 1;
        }
        var order = all.SeedInsertionOrder(n);
        var last = 0;
        k = 0;
        while (k < n)
        {
            var p = order[k];
            var t = s.SeedLocate(cap, all, last, p);
            var same = t < 0 ? -1 : s.SeedCoincidentCorner(all, t, p);
            if (t >= 0 && same < 0)
            {
                s = s.SeedInserted(cap, all, t, p);
                placed = placed.Set(p, p);
                last = s.SeedAt(cap, p);
            }
            else
            {
                placed = placed.Set(p, same);
            }
            k = k + 1;
        }
        s = s.SeedWithoutSlivers(cap, all, next, false, n);
        var a = 0;
        while (a < n)
        {
            if (next[a] >= 0)
            {
                // Nested: the generated code evaluates both operands of &&, and next[a] is -1 on
                // a point hole.
                if (placed.At(a) == a && placed.At(next[a]) == next[a])
                {
                    s = s.SeedWithSegment(cap, all, next, a, next[a]);
                }
            }
            a = a + 1;
        }
        s = s.SeedWithoutSlivers(cap, all, next, true, n);
        var inside = s.SeedInside(cap, next);
        return s.At(0).Range.FlatMap(t =>
            (inside[t] && s.SeedCorner(t, 0) < n && s.SeedCorner(t, 1) < n && s.SeedCorner(t, 2) < n)
                ? [TriangleOf(s.SeedCorner(t, 0), s.SeedCorner(t, 1), s.SeedCorner(t, 2))]
                : [TriangleOf(0, 0, 0)].Take(0));
    }

    // The corner of triangle t at point p's position exactly; -1 when no corner is.
    SeedCoincidentCorner(s: List<Integer>, points: Array<Point2D>, t: Integer, p: Integer): Integer
    {
        var a = s.SeedCorner(t, 0);
        var b = s.SeedCorner(t, 1);
        var c = s.SeedCorner(t, 2);
        return points[a].X == points[p].X && points[a].Y == points[p].Y ? a
            : (points[b].X == points[p].X && points[b].Y == points[p].Y ? b
            : (points[c].X == points[p].X && points[c].Y == points[p].Y ? c : -1));
    }

    // The number of triangles a complete seed of r has: n + 2 h - 2 over its n boundary points
    // and its h loops of three or more points besides the outer one, plus one for each point on
    // no boundary segment (a point hole's or a two-point loop's, each inside two more triangles
    // and counted once in n).
    SeedCompleteCount(r: UvRegion): Integer
    {
        var next = r.NextBoundaryTable;
        var wide = r.Holes.Reduce(0, (h, l) => l.Points.Count >= 3 ? h + 1 : h);
        return next.Count + 2 * wide - 2 + next.Reduce(0, (k, b) => b < 0 ? k + 1 : k);
    }
}

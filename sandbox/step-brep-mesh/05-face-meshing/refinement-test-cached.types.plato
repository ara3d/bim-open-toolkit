//==
// # The surface refinement test from cached values: types (complexity sweep, chunk R2, TKT-384)
//
// The values NeedsRefinementCached computes once per pass and the per-triangle test reads: the
// face normal at every point that is a corner of a tested triangle, the outcome of a triangle's
// tests at its corners and centroid, and the surface samples of a side, taken once and read by
// both triangles that share it.
//
// Sections, in order:
//  - Points
//  - Triangles and sides

//==
// # Points

// The face normal (FaceNormalAt with the fallback Vector3D.UnitZ) and whether the point lies on
// a collapsed line (IsOnCollapsedLine), for each point of a triangulation. Filled only at points
// that are a corner of a tested triangle; Vector3D.Zero and false elsewhere.
// Removes: the three corner normals and three collapsed-line tests TriangleNeedsRefinement made
// per triangle, each corner shared by about six triangles.
type PointNormals
{
    Normals: Array<Vector3D>;
    OnCollapsedLine: Array<Boolean>;
}

//==
// # Triangles and sides

// The outcome of a triangle's tests that read its corners and centroid: Fails when some test
// already finds it wanting (the side normals turn, it folds, its normal leaves the surface's,
// or its centroid is off), and the surface evaluations, normals and projections made to decide
// it (Evaluations, 0 to 4).
type CentroidTest
{
    Fails: Boolean;
    Evaluations: Integer;
}

// The surface samples of one triangle side: the surface distance of its chord midpoint
// (SurfaceDistance of HalfwayPoint) and the surface point at its parameter midpoint
// (UvMidpoint). Both are symmetric in the side's ends, so the two triangles of a side read one
// sample.
type SideSample
{
    ChordDistance: Number;
    Midpoint: Point3D;
}

//==
// # Coarse-segment requests by one walk of the region (complexity sweep chunk F1, TKT-360)
//
// CoarseSegmentRequestsByEdge is layer 05's CoarseSegmentRequests with the same requests in the
// same order. The original tests, for every face edge, every boundary segment of the region
// (O(E B)), and evaluates the surface at both ends of every segment it measures even when the
// ends are model vertices or edge samples, whose shared positions ignore that evaluation. Here
// the region's segments are walked once: each segment's candidate edges come from its sources
// (the edge of an edge-sample end, or the face edges joining its two vertex ends, by binary
// search in a table sorted by end vertices), the segment is measured once when it lies on one,
// and the edges of segments that stray too far are marked. The surface is evaluated only at a
// synthetic end (SegmentUvDeviationLazy).
//
// Sections, in order:
//  - Sorted lookups
//  - Candidate edges of a segment
//  - Requests

library UvRegionsRequestsIndexed
{
    //==
    // # Sorted lookups

    // True when the increasing array xs holds x (layer 05's LowerBound).
    ContainsSorted(xs: Array<Integer>, x: Integer): Boolean
        => xs.LowerBound(x) < xs.Count ? xs[xs.LowerBound(x)] == x : false;

    // The smaller end vertex of edge e.
    LowEnd(m: BrepModel, e: BrepEdgeIndex): Integer
        => m.Edges[e].Start.Value.Min(m.Edges[e].End.Value);

    // The larger end vertex of edge e.
    HighEnd(m: BrepModel, e: BrepEdgeIndex): Integer
        => m.Edges[e].Start.Value.Max(m.Edges[e].End.Value);

    // How edge e's end vertices, smaller first, compare with the pair (lo, hi).
    CompareEnds(m: BrepModel, e: BrepEdgeIndex, lo: Integer, hi: Integer): Integer
        => CompareThen(CompareIntegers(m.LowEnd(e), lo), CompareIntegers(m.HighEnd(e), hi));

    // The positions of `edges` sorted by their end vertices, smaller first.
    EdgesByEnds(m: BrepModel, edges: Array<BrepEdgeIndex>): Array<Integer>
        => edges.Count.Range.Sort((x, y) => m.CompareEnds(edges[x], m.LowEnd(edges[y]), m.HighEnd(edges[y])) <= 0);

    // The edges among `edges` (byEnds is EdgesByEnds of them) whose end vertices are v and w.
    EdgesJoining(m: BrepModel, edges: Array<BrepEdgeIndex>, byEnds: Array<Integer>, v: Integer, w: Integer): Array<BrepEdgeIndex>
    {
        var lo = v.Min(w);
        var hi = v.Max(w);
        var a = 0;
        var b = byEnds.Count;
        while (a < b)
        {
            var mid = (a + b) / 2;
            if (m.CompareEnds(edges[byEnds[mid]], lo, hi) < 0)
            {
                a = mid + 1;
            }
            else
            {
                b = mid;
            }
        }
        var end = a;
        while (end < byEnds.Count ? m.CompareEnds(edges[byEnds[end]], lo, hi) == 0 : false)
        {
            end = end + 1;
        }
        return (end - a).MapRange(k => edges[byEnds[a + k]]);
    }

    //==
    // # Candidate edges of a segment

    // The edge of an edge sample; -1 for every other source.
    SourceEdgeValue(s: UvPointSource): Integer
        => match (s) {
            FromVertex(v) => -1;
            FromEdge(e, k) => e.Value;
            SeamCut(side, k) => -1;
            Pole(side, k) => -1;
            Interior => -1;
        };

    // The vertex of a vertex source; -1 for every other source.
    SourceVertexValue(s: UvPointSource): Integer
        => match (s) {
            FromVertex(v) => v.Value;
            FromEdge(e, k) => -1;
            SeamCut(side, k) => -1;
            Pole(side, k) => -1;
            Interior => -1;
        };

    // The face edges the segment from a to b can be a discretization segment of
    // (IsDiscretizationSegment holds only for these): the face edges joining a and b when both
    // are vertices, else the edges of its edge-sample ends that are face edges. sortedValues is
    // the face edges' values in increasing order, byEnds is EdgesByEnds of edges.
    CandidateEdges(m: BrepModel, edges: Array<BrepEdgeIndex>, sortedValues: Array<Integer>, byEnds: Array<Integer>, a: UvPointSource, b: UvPointSource): Array<BrepEdgeIndex>
        => (a.SourceVertexValue >= 0 && b.SourceVertexValue >= 0)
            ? m.EdgesJoining(edges, byEnds, a.SourceVertexValue, b.SourceVertexValue)
            : [a.SourceEdgeValue, b.SourceEdgeValue].FlatMap(x =>
                (x >= 0 ? sortedValues.ContainsSorted(x) : false) ? [BrepEdgeIndex(x)] : BrepEdgeIndex.NoEdges);

    //==
    // # Requests

    // Point s of a boundary segment in 3D: the model's position for a vertex or an edge sample
    // (as SharedPosition), the surface at uv otherwise. The surface is evaluated only then.
    SharedPositionAt(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, s: UvPointSource, uv: UvCoordinate): Point3D
        => match (s) {
            FromVertex(v) => m.Vertices[v].Point;
            FromEdge(e, k) => d.ByEdge[e].Points[k];
            SeamCut(side, k) => m.Geometry.Eval(m.SurfaceOf(f), uv);
            Pole(side, k) => m.Geometry.Eval(m.SurfaceOf(f), uv);
            Interior => m.Geometry.Eval(m.SurfaceOf(f), uv);
        };

    // SegmentUvDeviation, the same value, with the surface evaluated at an end only when that
    // end is synthetic.
    SegmentUvDeviationLazy(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, k: Integer, i: Integer): Number
        => m.UvChordDeviation(m.SurfaceOf(f),
            m.SharedPositionAt(f, d, r.LoopAt(k).Sources[i], r.SegmentStart(k, i)),
            m.SharedPositionAt(f, d, r.LoopAt(k).Sources.AtModulo(i + 1), r.SegmentEnd(k, i)),
            r.SegmentStart(k, i), r.SegmentEnd(k, i), SamplePlan.DiscretizationPlan);

    // The face edges boundary segment i of loop k lies on (IsSegmentOn) when it strays from its
    // 3D chord by more than the edge chordal criterion plus the length tolerance; none
    // otherwise. The segment is measured once, and only when it lies on some face edge.
    CoarseEdgesOfSegment(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, c: FaceMeshingCriteria, edges: Array<BrepEdgeIndex>, sortedValues: Array<Integer>, byEnds: Array<Integer>, k: Integer, i: Integer): Array<BrepEdgeIndex>
    {
        var a = r.LoopAt(k).Sources[i];
        var b = r.LoopAt(k).Sources.AtModulo(i + 1);
        var on = m.CandidateEdges(edges, sortedValues, byEnds, a, b).FlatMap(e =>
            m.IsDiscretizationSegment(d, e, a, b) ? [e] : BrepEdgeIndex.NoEdges);
        return on.IsEmpty
            ? on
            : (m.SegmentUvDeviationLazy(f, d, r, k, i) > c.Discretization.Chordal + m.Tolerances.Length.Value ? on : BrepEdgeIndex.NoEdges);
    }

    // CoarseSegmentRequests by one walk of region r: the TooCoarseInParameterSpace request of
    // every face edge (in order of first citation) that some coarse segment lies on.
    CoarseSegmentRequestsByEdge(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, c: FaceMeshingCriteria): Array<EdgeRefinementRequest>
    {
        var edges = m.FaceEdgesOnce(f);
        var sortedValues = edges.Map(e => e.Value).Sort((x, y) => x <= y);
        var byEnds = m.EdgesByEnds(edges);
        var marked = r.NumberOfLoops.Range.FlatMap(k => r.LoopAt(k).Points.Count.Range.FlatMap(i =>
            m.CoarseEdgesOfSegment(f, d, r, c, edges, sortedValues, byEnds, k, i).Map(e => e.Value))).Sort((x, y) => x <= y);
        return edges.FlatMap(e => marked.ContainsSorted(e.Value)
            ? [EdgeRefinementRequest(e, RefinementReason.TooCoarseInParameterSpace, m.TighterChordal(d, e), 0)]
            : EdgeRefinementRequest.NoRequests);
    }
}

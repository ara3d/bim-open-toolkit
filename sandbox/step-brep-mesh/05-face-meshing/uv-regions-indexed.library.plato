//==
// # Unwrap with indexed twin lookups (complexity sweep chunk F1, TKT-360)
//
// UnwrapIndexed is layer 05's Unwrap with the same result, bit for bit, at O(B log B + C log C)
// for B loop points and C face coedges instead of O(B^2 (C^2 + E C)). Unwrap asks, at every
// point i, PlacedTwinStep, which tries every j < i - 1 and, for each, rebuilds FaceEdges (itself
// O(C^2)) and tests every face edge for being a seam (O(C) each). Here the face's edges and its
// seam edges are found once per face from one sort of its coedges (FaceEdgeUses), the loop's
// steps are sorted once by their two sources, and the twin of step i is the first sorted step
// whose sources are step i's reversed: a binary search. A face with no seam edge has no twin
// step, so neither the sort nor any search is made.
//
// Sections, in order:
//  - Face edges once
//  - Sources in order
//  - Twins by sorted step key
//  - Unwrap

library UvRegionsIndexed
{
    //==
    // # Face edges once

    // The edges face f cites, each once, in order of first citation, with where each is first
    // cited and how often: the face's coedges sorted by edge (ties by position), cut into runs
    // of one edge, the runs then sorted by first citation.
    FaceEdgeUses(m: BrepModel, f: BrepFaceIndex): Array<FaceEdgeUse>
    {
        var cs = m.FaceCoedges(f);
        var order = cs.Count.Range.Sort((a, b) => cs[a].Edge.Value < cs[b].Edge.Value
            ? true
            : (cs[a].Edge.Value == cs[b].Edge.Value ? a <= b : false));
        var starts = order.Count.Range.FlatMap(k => k == 0
            ? [k]
            : (cs[order[k]].Edge == cs[order[k - 1]].Edge ? [k].Take(0) : [k]));
        var runs = starts.Count.MapRange(s => FaceEdgeUse(cs[order[starts[s]]].Edge, order[starts[s]],
            (s + 1 < starts.Count ? starts[s + 1] : order.Count) - starts[s]));
        return runs.Count.Range.Sort((x, y) => runs[x].First <= runs[y].First).Map(x => runs[x]);
    }

    // FaceEdges from one sort: the edges face f cites, each once, in order of first citation.
    FaceEdgesOnce(m: BrepModel, f: BrepFaceIndex): Array<BrepEdgeIndex>
        => m.FaceEdgeUses(f).Map(u => u.Edge);

    // The seam edges of face f (IsSeamEdgeOf: cited exactly twice by its coedges), in order of
    // first citation. Precondition: f is in range, so its coedges are CoedgeSitesOfFace's.
    SeamEdgesOnce(m: BrepModel, f: BrepFaceIndex): Array<BrepEdgeIndex>
        => m.FaceEdgeUses(f).FlatMap(u => u.Uses == 2 ? [u.Edge] : BrepEdgeIndex.NoEdges);

    //==
    // # Sources in order
    //
    // A total order on point sources: by case, then by the case's two fields. Two sources
    // compare equal exactly when they are equal.

    // -1, 0 or 1 as x is below, equal to, or above y.
    CompareIntegers(x: Integer, y: Integer): Integer
        => x < y ? -1 : (x > y ? 1 : 0);

    // The first comparison, or the second when the first is a tie.
    CompareThen(first: Integer, second: Integer): Integer
        => first != 0 ? first : second;

    // The position of a domain side in UMin, UMax, VMin, VMax.
    SideOrdinal(s: DomainSide): Integer
        => match (s)
        {
            UMin => 0;
            UMax => 1;
            VMin => 2;
            VMax => 3;
        };

    // The position of the case of s in FromVertex, FromEdge, SeamCut, Pole, Interior.
    SourceKind(s: UvPointSource): Integer
        => match (s) {
            FromVertex(v) => 0;
            FromEdge(e, k) => 1;
            SeamCut(side, k) => 2;
            Pole(side, k) => 3;
            Interior => 4;
        };

    // The first field of s as an Integer: the vertex, the edge, or the side; 0 for Interior.
    SourceFirst(s: UvPointSource): Integer
        => match (s) {
            FromVertex(v) => v.Value;
            FromEdge(e, k) => e.Value;
            SeamCut(side, k) => side.SideOrdinal;
            Pole(side, k) => side.SideOrdinal;
            Interior => 0;
        };

    // The second field of s as an Integer: the sample or point index; 0 for a vertex and Interior.
    SourceSecond(s: UvPointSource): Integer
        => match (s) {
            FromVertex(v) => 0;
            FromEdge(e, k) => k.Value;
            SeamCut(side, k) => k;
            Pole(side, k) => k;
            Interior => 0;
        };

    // -1, 0 or 1 as a sorts before, with, or after b.
    CompareSources(a: UvPointSource, b: UvPointSource): Integer
        => CompareThen(CompareIntegers(a.SourceKind, b.SourceKind),
            CompareThen(CompareIntegers(a.SourceFirst, b.SourceFirst), CompareIntegers(a.SourceSecond, b.SourceSecond)));

    //==
    // # Twins by sorted step key

    // How step j of loop l, from source j to source j + 1, compares with the step from a to b.
    // Precondition: j + 1 is a position of l.Sources.
    CompareStep(l: UvLoop, j: Integer, a: UvPointSource, b: UvPointSource): Integer
        => CompareThen(CompareSources(l.Sources[j], a), CompareSources(l.Sources[j + 1], b));

    // The steps j of loop l that do not close it (j + 1 < Sources.Count), sorted by their two
    // sources and then by j, so the first of equal steps is the least j.
    SortedSteps(l: UvLoop): Array<Integer>
        => (l.Sources.Count - 1).Max(0).Range.Sort((x, y) =>
            CompareThen(l.CompareStep(x, l.Sources[y], l.Sources[y + 1]), CompareIntegers(x, y)) <= 0);

    // The first position of `steps` (SortedSteps of l) whose step does not sort before the step
    // from a to b, steps.Count when none; its work is the probes made, as Insertions.
    LowerStep(l: UvLoop, steps: Array<Integer>, a: UvPointSource, b: UvPointSource): Counted<Integer>
    {
        var lo = 0;
        var hi = steps.Count;
        var probes = 0;
        while (lo < hi)
        {
            var mid = (lo + hi) / 2;
            if (l.CompareStep(steps[mid], a, b) < 0)
            {
                lo = mid + 1;
            }
            else
            {
                hi = mid;
            }
            probes = probes + 1;
        }
        return Counted(lo, Insertions(probes));
    }

    // AreSeamNeighbours without its IsSeamEdgeOf test, for an edge already known to be a seam
    // of the face: the points with sources a and b are neighbours along e.
    AreNeighboursAlongSeam(m: BrepModel, e: BrepEdgeIndex, a: UvPointSource, b: UvPointSource): Boolean
        => (a.IsSampleOfEdge(e) && b.IsSampleOfEdge(e))
            ? (a.SampleIndex - b.SampleIndex).Abs == 1
            : ((a.IsSampleOfEdge(e) || b.IsSampleOfEdge(e))
                ? (m.IsEndVertexSource(e, a) || m.IsEndVertexSource(e, b))
                : m.JoinsEndsOf(e, a, b));

    // PlacedTwinStep by the sorted steps: the least j < i - 1 whose step runs from source i + 1
    // to source i, when step i runs between neighbours along one of the seam edges `seams` of
    // face f; -1 otherwise. Its work is the binary search's probes. Precondition: steps is
    // SortedSteps of l, seams is SeamEdgesOnce of f, and 1 <= i < l.Sources.Count.
    PlacedTwinStepIndexed(m: BrepModel, f: BrepFaceIndex, seams: Array<BrepEdgeIndex>, l: UvLoop, steps: Array<Integer>, i: Integer): Counted<Integer>
    {
        var a = l.Sources.AtModulo(i + 1);
        var b = l.Sources[i];
        var at = l.LowerStep(steps, a, b);
        var j = at.Value < steps.Count ? steps[at.Value] : -1;
        var reversed = j >= 0 ? (j < i - 1 ? l.CompareStep(j, a, b) == 0 : false) : false;
        var twin = reversed ? (seams.Any(e => m.AreNeighboursAlongSeam(e, b, a)) ? j : -1) : -1;
        return Counted(twin, at.Work);
    }

    //==
    // # Unwrap

    // Unwrap with the same points, bit for bit.
    UnwrapIndexed(m: BrepModel, f: BrepFaceIndex, l: UvLoop): UvLoop
        => m.UnwrapCounted(f, l).Value;

    // Unwrap's scan with its twin lookups indexed: the seam edges found once, the loop's steps
    // sorted once (only when there is a seam edge), and each twin a binary search. Its work, as
    // Insertions, is the steps visited: one per loop point, one per sorted step, and one per
    // binary search probe. On a face with no seam edge that is exactly one per point.
    UnwrapCounted(m: BrepModel, f: BrepFaceIndex, l: UvLoop): Counted<UvLoop>
    {
        var dom = m.SurfaceDomainOf(f);
        var n = l.Points.Count;
        var seams = m.SeamEdgesOnce(f);
        var steps = seams.IsEmpty ? 0.MapRange(k => k) : l.SortedSteps;
        var placed = new List<UvCoordinate>();
        var probes = 0;
        var i = 0;
        while (i < n)
        {
            var raw = m.WithPoleFreeParameter(f, l, i);
            var continued = i == 0 ? dom.Wrap(raw) : dom.NearestUnwrapped(raw, placed.At(i - 1));
            var twin = (i == 0 || seams.IsEmpty) ? Counted(-1, Insertions(0)) : m.PlacedTwinStepIndexed(f, seams, l, steps, i);
            var point = twin.Value < 0 ? continued : m.LeftRuleCopy(f, dom, l, i, placed.At(twin.Value + 1), continued);
            placed = placed.Add(point);
            probes = probes + twin.Work.Insertions;
            i = i + 1;
        }
        return Counted(m.ClosedAtPole(f, dom, UvLoop(placed.Freeze(), l.Sources)), Insertions(n + steps.Count + probes));
    }
}

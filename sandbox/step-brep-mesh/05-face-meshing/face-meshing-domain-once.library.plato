//==
// # The surface domain and the region tolerance once per face (complexity sweep chunk I5, TKT-382)
//
// Layer 05. SurfaceDomainOf builds face f's surface domain (two closure-mark lookups and the
// record's natural domain, twice), and UnwrapIndexed's per-point helpers asked for it again at
// every point: IsOnLine took it once and PointTolerance twice (layer 01's UvToleranceAt takes
// the domain too), for each collapsed line, in WithPoleFreeParameter and LeftRuleCopy.
// MeshRegionOnce builds the domain once per face and the region tolerance once from it, and
// passes both down: the domain into the unwrap, the tolerance into the collision test and the
// insertion pass (chunk R1's RefineToSurfaceByInsertionBuilt takes it as tol: UvTolerance once
// R1 merges; TRACK.md). Each function here is the library function of the same name without
// "In" (or MeshRegionBody), with the domain or the tolerance passed instead of rebuilt: the same
// values, bit for bit.
//
// Sections, in order:
//  - Tolerances from a given domain
//  - Collapsed lines with a given domain
//  - Unwrap with a given domain
//  - Meshing a region with the domain and the tolerance once

library FaceMeshingDomainOnce
{
    //==
    // # Tolerances from a given domain

    // PointTolerance with face f's surface domain given: layer 01's UvToleranceAt at uv, its
    // domain argument dom. Precondition: dom is m.SurfaceDomainOf(f).
    PointToleranceIn(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, uv: UvCoordinate): UvTolerance
        => m.Tolerances.UvToleranceAt(m.Geometry.UvFloorOf(m.SurfaceOf(f), m.Tolerances),
            m.Geometry.PartialU(m.SurfaceOf(f), uv).Length, m.Geometry.PartialV(m.SurfaceOf(f), uv).Length, dom);

    // RegionTolerance with face f's surface domain given. Precondition: dom is
    // m.SurfaceDomainOf(f).
    RegionToleranceIn(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, chart: FaceChart): UvTolerance
        => m.Tolerances.UvToleranceAt(m.Geometry.UvFloorOf(m.SurfaceOf(f), m.Tolerances),
            chart.ScaleU, chart.ScaleV, dom);

    //==
    // # Collapsed lines with a given domain

    // IsOnLine with face f's surface domain given, and the point tolerance at uv taken once.
    IsOnLineIn(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, uv: UvCoordinate, which: SurfaceParameter, c: Number): Boolean
    {
        var t = m.PointToleranceIn(f, dom, uv);
        return dom.DomainAlong(which).SameParameter(uv.Coordinate(which), c, which.Along(t.U, t.V));
    }

    // IsOnCollapsedLineAlong with face f's surface domain given.
    IsOnCollapsedLineAlongIn(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, uv: UvCoordinate, which: SurfaceParameter): Boolean
        => m.CollapsedLines(f, which).Any(c => m.IsOnLineIn(f, dom, uv, which, c));

    // IsOnCollapsedLine with face f's surface domain given.
    IsOnCollapsedLineIn(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, uv: UvCoordinate): Boolean
        => m.IsOnCollapsedLineAlongIn(f, dom, uv, SurfaceParameter.ParameterU)
            || m.IsOnCollapsedLineAlongIn(f, dom, uv, SurfaceParameter.ParameterV);

    //==
    // # Unwrap with a given domain

    // WithPoleFreeParameter with face f's surface domain given.
    WithPoleFreeParameterIn(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, l: UvLoop, i: Integer): UvCoordinate
    {
        var uv = l.Points[i];
        var neighbour = l.Points.AtModulo(i == 0 ? 1 : i - 1);
        var onU = m.IsOnCollapsedLineAlongIn(f, dom, uv, SurfaceParameter.ParameterU);
        var onV = m.IsOnCollapsedLineAlongIn(f, dom, uv, SurfaceParameter.ParameterV);
        return onV ? UvCoordinate(neighbour.U, uv.V) : (onU ? UvCoordinate(uv.U, neighbour.V) : uv);
    }

    // LeftRuleCopy with its collapsed-line tests reading the domain it is given.
    LeftRuleCopyIn(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, l: UvLoop, i: Integer, twinEnd: UvCoordinate, continued: UvCoordinate): UvCoordinate
    {
        var pu = dom.U.Periodicity.PeriodOr(0.0);
        var pv = dom.V.Periodicity.PeriodOr(0.0);
        var alongU = pu > 0.0 ? [UvCoordinate(twinEnd.U + pu, twinEnd.V), UvCoordinate(twinEnd.U - pu, twinEnd.V)] : [twinEnd].Take(0);
        var alongV = pv > 0.0 ? [UvCoordinate(twinEnd.U, twinEnd.V + pv), UvCoordinate(twinEnd.U, twinEnd.V - pv)] : [twinEnd].Take(0);
        var candidates = alongU.Concatenate(alongV);
        var exempt = m.IsOnCollapsedLineIn(f, dom, twinEnd) || m.IsOnCollapsedLineIn(f, dom, continued);
        var good = candidates.FlatMap(c =>
            m.IsLeftOfStep(f, c, dom.NearestUnwrapped(l.Points.AtModulo(i + 1), c), twinEnd) ? [c] : candidates.Take(0));
        return (exempt || good.Count == 0) ? continued : good[0];
    }

    // UnwrapCounted with face f's surface domain given: the same loop, bit for bit. Its work is
    // UnwrapCounted's Insertions and, as Projections, the surface domains it builds: none.
    // Precondition: dom is m.SurfaceDomainOf(f).
    UnwrapCountedIn(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, l: UvLoop): Counted<UvLoop>
    {
        var n = l.Points.Count;
        var seams = m.SeamEdgesOnce(f);
        var steps = seams.IsEmpty ? 0.MapRange(k => k) : l.SortedSteps;
        var placed = new List<UvCoordinate>();
        var probes = 0;
        var i = 0;
        while (i < n)
        {
            var raw = m.WithPoleFreeParameterIn(f, dom, l, i);
            var continued = i == 0 ? dom.Wrap(raw) : dom.NearestUnwrapped(raw, placed.At(i - 1));
            var twin = (i == 0 || seams.IsEmpty) ? Counted(-1, Insertions(0)) : m.PlacedTwinStepIndexed(f, seams, l, steps, i);
            var point = twin.Value < 0 ? continued : m.LeftRuleCopyIn(f, dom, l, i, placed.At(twin.Value + 1), continued);
            placed = placed.Add(point);
            probes = probes + twin.Work.Insertions;
            i = i + 1;
        }
        return Counted(UvLoop(placed.Freeze(), l.Sources), Insertions(n + steps.Count + probes));
    }

    // UnwrapIndexed with face f's surface domain given.
    UnwrapIndexedIn(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, l: UvLoop): UvLoop
        => m.UnwrapCountedIn(f, dom, l).Value;

    // Every loop of face f unwrapped with the face's surface domain built once: its work is
    // that one domain, as Projections, and each loop's UnwrapCountedIn work.
    UnwrapLoopsCounted(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>): Counted<Array<UvLoop>>
    {
        var dom = m.SurfaceDomainOf(f);
        var unwrapped = loops.Map(l => m.UnwrapCountedIn(f, dom, l));
        return Counted(unwrapped.Map(u => u.Value),
            unwrapped.Reduce(Projections(1), (w, u) => w.Add(u.Work)));
    }

    //==
    // # Meshing a region with the domain and the tolerance once

    // UnorientedRegionOf with face f's surface domain given to the unwrap.
    UnorientedRegionOfIn(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, d: EdgeDiscretizations, c: FaceMeshingCriteria): UvRegion
        => m.AddMissingSeamsAndPoles(f, m.MeshedBounds(f).Map(b => m.UnwrapIndexedIn(f, dom, m.LoopToUv(f, b, d))), c);

    // RefinedTriangulation with the region tolerance given. The library's insertion pass still
    // builds its own; chunk R1's RefineToSurfaceByInsertionBuilt takes this tol once it merges
    // (TRACK.md, merge instructions).
    RefinedTriangulationIn(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, tol: UvTolerance, c: FaceMeshingCriteria): UvTriangulation
        => m.RefineToSurface(f, r, chart, r.TriangulateRegion(chart), c);

    // GridOrTriangles with the region tolerance given to the refinement.
    GridOrTrianglesIn(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, tol: UvTolerance, grid: QuadGridOutcome, c: FaceMeshingCriteria): UvTriangulation
        => match (grid) {
            NoGrid => m.RefinedTriangulationIn(f, r, chart, tol, c);
            CountsDiffer(floors) => m.RefinedTriangulationIn(f, r, chart, tol, c);
            Grid(mesh) => mesh;
        };

    // MeshedOutcome with the region tolerance given to the refinement.
    MeshedOutcomeIn(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, raw: UvRegion, r: UvRegion, chart: FaceChart, tol: UvTolerance, c: FaceMeshingCriteria): FaceMeshOutcome
    {
        var grid = m.FaceQuadGridIn(f, d, r, tol, c);
        var t = m.GridOrTrianglesIn(f, r, chart, tol, grid, c);
        var advisory = m.CoarseSegmentRequests(f, d, r, c).Concatenate(m.QuadCountRequests(d, grid, c));
        return FaceMeshOutcome(m.Lift(f, d, t), advisory,
            advisory.Map(q => q.RequestDiagnostic).Concatenate(m.ReversalDiagnostics(f, raw)));
    }

    // MeshRegionBody with face f's surface domain built once, the region tolerance built once
    // from it, and both passed down: the same outcome, bit for bit.
    MeshRegionOnce(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): FaceMeshOutcome
    {
        var dom = m.SurfaceDomainOf(f);
        var raw = m.UnorientedRegionOfIn(f, dom, d, c);
        var r = m.OrientRegion(f, raw);
        var chart = m.ChartOf(f, r);
        var tol = m.RegionToleranceIn(f, dom, chart);
        var flags = r.CollidingSegments(tol);
        return flags.Any(x => x)
            ? f.NotSimpleOutcome(m.SelfIntersectionRequestsFrom(f, d, r, flags))
            : m.MeshedOutcomeIn(f, d, raw, r, chart, tol, c);
    }
}

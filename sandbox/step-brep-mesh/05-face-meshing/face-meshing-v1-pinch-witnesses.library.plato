//==
// # Version 1: pinched plane regions, witnesses (TKT-412)
//
// The oriented parameter-space region layer 5 builds for CEL/LENA-R8.STEP face 1349, copied from
// the polystrata spike's dump (sandbox/step-mesh-staging/polystrata-spike/regions, taken from the
// compiled library at bim-open-data 5571854): 1 loops of 66 points,
// the two holes each sharing one vertex with the outer loop, under the face's region tolerance of
// 0.01 in u and v with unit chart scales. Sources are Interior throughout: the laws over it read only
// coordinates and boundary order. Then the synthetic cases of the pinch laws.

library V1PinchWitnesses
{
    // LENA-R8 face 1349's region.
    LenaR8Face1349Region(_: Integer): UvRegion
        => UvRegion(UvLoop([UvCoordinate(8.317962247364, -1.344812155754), UvCoordinate(7.931228747298, -1.344812155754), UvCoordinate(7.931228747298, -0.6277155304997), UvCoordinate(7.195550138269, -0.6277155304997), UvCoordinate(7.195550138269, -1.001852900198), UvCoordinate(7.563335613167, -1.001852900198), UvCoordinate(7.563335613167, -1.718971057299), UvCoordinate(7.937451451018, -1.718971057299), UvCoordinate(7.937451451018, -2.099309598871), UvCoordinate(7.195550138269, -2.099309598871), UvCoordinate(7.195550138269, -1.725150697326), UvCoordinate(6.441074227, -1.725150697326), UvCoordinate(6.441074227, -1.344812155754), UvCoordinate(7.195550138269, -1.344812155754), UvCoordinate(7.195550138269, -1.001852900198), UvCoordinate(6.441074227, -1.001852900198), UvCoordinate(6.441074227, -0.6215143586263), UvCoordinate(6.81506087377, -0.6215143586263), UvCoordinate(6.81506087377, -0.2466879698311), UvCoordinate(6.442796774742, -0.2466879698311), UvCoordinate(6.442796774742, 1.627443974145), UvCoordinate(7.186958931403, 1.627443974145), UvCoordinate(7.186958931403, 1.980221751834), UvCoordinate(6.817623163537, 1.980221751834), UvCoordinate(6.817624415388, 3.099193258452), UvCoordinate(6.431750937343, 3.099188765444), UvCoordinate(6.431750937343, 3.468481469616), UvCoordinate(6.067970385947, 3.468481469616), UvCoordinate(6.067970385947, -2.457061233167), UvCoordinate(12.03765337463, -2.457061233167), UvCoordinate(12.03765337463, -2.093086895151), UvCoordinate(11.64764703386, -2.093086895151), UvCoordinate(11.64764712227, -1.731352413918), UvCoordinate(11.26733002413, -1.7313518692), UvCoordinate(11.26733002413, -2.099309598871), UvCoordinate(10.91192536114, -2.099309598871), UvCoordinate(10.91192536114, -1.718971057299), UvCoordinate(10.15729872694, -1.718971057299), UvCoordinate(10.15729872694, -2.099309598871), UvCoordinate(9.789534783888, -2.099309598871), UvCoordinate(9.789534783888, -1.718971057299), UvCoordinate(9.059842028265, -1.718971057299), UvCoordinate(9.059842028265, -1.357236031348), UvCoordinate(9.409196242317, -1.357236031348), UvCoordinate(9.409196242317, 0.5008762186213), UvCoordinate(9.783139825394, 0.5008762186213), UvCoordinate(9.783139825394, 0.8667453591549), UvCoordinate(9.419359273998, 0.8667453591549), UvCoordinate(9.419359273998, 1.247105432573), UvCoordinate(9.783139825394, 1.247105432573), UvCoordinate(9.783139825394, 1.632956126921), UvCoordinate(9.413868653068, 1.632956126921), UvCoordinate(9.413868653068, 1.969175914435), UvCoordinate(9.061090875379, 1.969175914435), UvCoordinate(9.061090875379, 0.872279043778), UvCoordinate(8.686264486584, 0.872279043778), UvCoordinate(8.686264486584, 0.4974526549829), UvCoordinate(8.317962247364, 0.4974526549829), UvCoordinate(8.317962247364, -0.2473985207749), UvCoordinate(8.685726190414, -0.2473985207749), UvCoordinate(8.685726190414, -0.989450556451), UvCoordinate(8.317962247364, -0.989450556451), UvCoordinate(8.317962247364, -1.344812155754), UvCoordinate(8.692099617062, -1.344812155754), UvCoordinate(8.692099617062, -1.7313518692), UvCoordinate(8.317962247364, -1.7313518692)],
            66.MapRange(i => UvPointSource.Interior)),
            []);

    // LENA-R8 face 1349's region tolerance.
    LenaR8Face1349Tolerance(_: Integer): UvTolerance
        => UvTolerance(ParameterTolerance(0.01), ParameterTolerance(0.01));

    // A 3 x 3 square whose triangular hole touches the outer loop's bottom side at (1.5, 0), a
    // vertex of both loops: the two-loop form of a pinch.
    PinchedHoleRegion(_: Integer): UvRegion
        => UvRegion(
            UvLoop([UvCoordinate(0.0, 0.0), UvCoordinate(1.5, 0.0), UvCoordinate(3.0, 0.0), UvCoordinate(3.0, 3.0), UvCoordinate(0.0, 3.0)],
                5.MapRange(i => UvPointSource.Interior)),
            [UvLoop([UvCoordinate(1.5, 0.0), UvCoordinate(1.0, 1.0), UvCoordinate(2.0, 1.0)], 3.MapRange(i => UvPointSource.Interior))]);

    // A keyhole loop whose triangle returns to (1.5, 0) along the square's bottom side within the
    // tolerance: its last point before the pinch is (2.0, 0.005), half a tolerance unit above the
    // side the loop then runs along.
    FoldAtPinchRegion(_: Integer): UvRegion
        => UvRegion(
            UvLoop([UvCoordinate(0.0, 0.0), UvCoordinate(1.5, 0.0), UvCoordinate(1.0, 1.0), UvCoordinate(2.0, 0.005), UvCoordinate(1.5, 0.0),
                    UvCoordinate(3.0, 0.0), UvCoordinate(3.0, 3.0), UvCoordinate(0.0, 3.0)],
                8.MapRange(i => UvPointSource.Interior)),
            [UvLoop([UvCoordinate(0.0, 0.0)], [UvPointSource.Interior])].Take(0));

    // A 2 x w rectangle, counter-clockwise.
    RectangleRegion(w: Number): UvRegion
        => UvRegion(UvLoop([UvCoordinate(0.0, 0.0), UvCoordinate(2.0, 0.0), UvCoordinate(2.0, w), UvCoordinate(0.0, w)],
                4.MapRange(i => UvPointSource.Interior)),
            [UvLoop([UvCoordinate(0.0, 0.0)], [UvPointSource.Interior])].Take(0));

    // PinchedHoleRegion's keyhole written as one loop: the outer square passes through (1.5, 0),
    // around the triangle clockwise and through (1.5, 0) again.
    KeyholeLoopRegion(_: Integer): UvRegion
        => UvRegion(
            UvLoop([UvCoordinate(0.0, 0.0), UvCoordinate(1.5, 0.0), UvCoordinate(1.0, 1.0), UvCoordinate(2.0, 1.0), UvCoordinate(1.5, 0.0),
                    UvCoordinate(3.0, 0.0), UvCoordinate(3.0, 3.0), UvCoordinate(0.0, 3.0)],
                8.MapRange(i => UvPointSource.Interior)),
            [UvLoop([UvCoordinate(0.0, 0.0)], [UvPointSource.Interior])].Take(0));

    // The tolerance of the synthetic pinch cases: 0.01 in u and v.
    PinchTolerance(_: Integer): UvTolerance
        => UvTolerance(ParameterTolerance(0.01), ParameterTolerance(0.01));

    // A unit square pinched at (1, 0) to a triangle below it, wound the same way (both
    // counter-clockwise): one loop through (1, 0) twice, the triangle outside the square.
    OutsidePinchRegion(_: Integer): UvRegion
        => UvRegion(UvLoop([UvCoordinate(0.0, 0.0), UvCoordinate(1.0, 0.0), UvCoordinate(1.5, -1.0), UvCoordinate(2.0, -0.5), UvCoordinate(1.0, 0.0), UvCoordinate(1.0, 1.0), UvCoordinate(0.0, 1.0)],
                7.MapRange(i => UvPointSource.Interior)),
            [UvLoop([UvCoordinate(0.0, 0.0)], [UvPointSource.Interior])].Take(0));
}

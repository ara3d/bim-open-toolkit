//==
// # The quad grid within the chordal bound: laws (TKT-415)
//
// The cases are the witness models whose faces reach the grid branch (bump solids, the unit
// box, cylinders, the sphere, the cone, the torus), meshed under the default criteria at a
// chordal bound of 0.01 with quads preferred, as the host meshes them (TKT-405). The bump solid
// of bump 0.5 is left out: its top's refinement at this bound exceeds a law's budget (TKT-351).
// The first law is TKT-415's criterion on the library's meshes; the last states which grids the
// test refuses.
//
// Sections, in order:
//  - Cases
//  - The library's meshes
//  - The grid test

library FaceMeshingGridChordalLaws
{
    //==
    // # Cases

    // The default criteria at chordal 0.01 with quad grids preferred.
    GridCaseCriteria(x: FaceMeshingCriteria): FaceMeshingCriteria
        => GridCaseCriteriaHost(x);

    // Model m as a grid case, its edges discretized under the case criteria.
    GridCaseOf(name: String, m: BrepModel, bump: Number): GridCase
    {
        var c = FaceMeshingCriteria.GridCaseCriteria;
        return GridCase(name, m, bump, c, m.DiscretizeAll(c.Discretization, SegmentFloors.NoFloors));
    }

    Witness_BumpSolid03(_: GridCase): GridCase
        => GridCaseOf("BSplinePatchSolid(0.3)", BrepModel.Witness_BSplinePatchSolid(0.3), 0.3);
    Witness_FlatPatchSolid(_: GridCase): GridCase
        => GridCaseOf("BSplinePatchSolid(0)", BrepModel.Witness_BSplinePatchSolid(0.0), 0.0);
    Witness_UnitBoxGrid(_: GridCase): GridCase
        => GridCaseOf("UnitBox", BrepModel.WitnessAt(0), 0.0);
    Witness_CylinderGrid(_: GridCase): GridCase
        => GridCaseOf("Cylinder", BrepModel.WitnessAt(1), 0.0);
    Witness_SphereGrid(_: GridCase): GridCase
        => GridCaseOf("Sphere", BrepModel.WitnessAt(2), 0.0);
    Witness_TorusGrid(_: GridCase): GridCase
        => GridCaseOf("Torus", BrepModel.WitnessAt(3), 0.0);
    Witness_ConeGrid(_: GridCase): GridCase
        => GridCaseOf("Cone", BrepModel.WitnessAt(4), 0.0);
    Witness_QuarterCylinderGrid(_: GridCase): GridCase
        => GridCaseOf("QuarterCylinder", BrepModel.WitnessAt(8), 0.0);

    // The faces of case w the layer can region and whose region is four-sided: the faces that
    // reach the grid branch.
    FourSidedFaces(w: GridCase): Array<BrepFaceIndex>
        => w.Model.Faces.Count.MapRange(i => BrepFaceIndex(i)).FlatMap(f =>
            w.Model.CanRegion(f, w.Discretizations, w.Criteria)
                ? (w.Model.QuadSidesOf(f, w.Model.RegionOf(f, w.Discretizations, w.Criteria)).IsFourSidedSides ? [f] : [f].Take(0))
                : [f].Take(0));

    // Whether a four-sided classification found four sides.
    IsFourSidedSides(s: QuadSides): Boolean
        => match (s) {
            NotFourSided => false;
            FourSided(corners) => true;
        };

    // Whether a grid outcome holds a grid.
    IsGridOutcome(g: QuadGridOutcome): Boolean
        => match (g) {
            NoGrid => false;
            CountsDiffer(floors) => false;
            Grid(mesh) => true;
        };

    //==
    // # The library's meshes

    // Every element of the mesh MeshFace gives a four-sided face is within SurfaceChordal of the
    // surface, both ways (ElementChordalDeviation and ElementCoverageGap), widened by the length
    // tolerance. Fails before TKT-415: the bump solid's top is one flat quad. The torus is left
    // out: with its grid refused, the refinement of the whole torus at this bound exceeds a law's
    // budget (TRACK.md, findings).
    Law_V1Faces_FourSidedMeshWithinChordal(w: GridCase): Boolean
        => w.Name == "Torus" ? true : w.FourSidedFaces.All(f => w.FaceMeshWithinChordal(w.Model.MeshFace(f, w.Discretizations, w.Criteria).Mesh));

    // Whether every element of face mesh fm of case w is within SurfaceChordal of the surface,
    // both ways, widened by the length tolerance.
    FaceMeshWithinChordal(w: GridCase, fm: FaceMesh): Boolean
    {
        var bound = w.Criteria.SurfaceChordal + w.Model.Tolerances.Length.Value;
        return fm.ElementCount.Range.All(k =>
            w.Model.ElementCoverageGap(w.Discretizations, fm, ElementIndex(k)) <= bound
                && w.Model.ElementChordalDeviation(w.Discretizations, fm, ElementIndex(k)) <= bound);
    }

    // A bump solid's top (face 1) meshes with some interior point, so its mesh is not the unit
    // box's. Fails before TKT-415.
    Law_V1Faces_BumpTopHasInteriorPoint(w: GridCase): Boolean
        => w.Bump <= 0.0
            ? true
            : w.Model.MeshFace(BrepFaceIndex(1), w.Discretizations, w.Criteria).Mesh.Sources.Any(s => s.IsInteriorSource);

    // Whether a parameter-space point's source is Interior.
    IsInteriorSource(s: UvPointSource): Boolean
        => match (s) {
            FromVertex(v) => false;
            FromEdge(e, k) => false;
            SeamCut(side, k) => false;
            Pole(side, k) => false;
            Interior => true;
        };

    //==
    // # The grid test

    // The grid test (GridUnlessFoldedOrCoarse) drops a grid where a cell is curved both ways:
    // each bump solid's top and every torus face get none (a cell deviates by about the sum of
    // its two sagittas, and the boundary bounds each alone).
    Law_V1Faces_GridRefusedWhereCurvedBothWays(w: GridCase): Boolean
        => w.FourSidedFaces.All(f => w.GridDecisionHolds(f, w.Model.RegionOf(f, w.Discretizations, w.Criteria)));

    // Law_V1Faces_GridRefusedWhereCurvedBothWays on face f of case w, its region r.
    GridDecisionHolds(w: GridCase, f: BrepFaceIndex, r: UvRegion): Boolean
    {
        var m = w.Model;
        var grid = m.QuadGridOnSides(f, w.Discretizations, r, w.Criteria, m.QuadSidesOf(f, r)).IsGridOutcome;
        return ((w.Bump > 0.0 && f == BrepFaceIndex(1)) || w.Name == "Torus") ? grid.Not : true;
    }
}

//==
// # Proofs about a face's loops and region in parameter space (types)
//
// TYPE-CATALOG.md section 4, layer 5. Built only by the Check* constructors
// of face-meshing-proofs.library.plato, as face-meshing-proofs.spec.plato
// states; each Decided* sum is its constructor's result, in layer 0's
// pattern.
//
// Sections, in order:
//  - Loops and regions

//==
// # Loops and regions

// A parameter-space loop with no self-intersection under Tolerance: as a
// region with no holes it is simple (IsSimpleRegion). Decided once.
// Removes: a triangulation attempted on a loop that was never checked
// simple (LoopSelfIntersects is a blocking request today).
type SimpleUvLoop
{
    Loop: UvLoop;
    Tolerance: UvTolerance;
}

// A loop of face Face that closes in the plane: it winds zero times in u and
// in v (UWinding, VWinding, Law_RegionLoopClosesInPlane), as every loop does
// after AddMissingSeamsAndPoles. Removes: a loop that still wraps a period
// handed to the triangulator.
type ClosedUvLoop
{
    Face: BrepFaceIndex;
    Loop: UvLoop;
}

// A region of face Face whose outer loop runs counter-clockwise and whose
// holes run clockwise in the face's chart (UvRegionWindingPositive,
// Law_UvHoleWindingNegative). Removes: the orientation re-decided inside the
// triangulator with a different tolerance.
type OrientedUvRegion
{
    Face: BrepFaceIndex;
    Region: UvRegion;
}

// A SimpleUvLoop, or why the loop is not simple.
type DecidedSimpleUvLoop
    = Decided(Value: SimpleUvLoop)
    | Undecided(Reason: UndecidedReason);

// A ClosedUvLoop, or why the loop does not close in the plane.
type DecidedClosedUvLoop
    = Decided(Value: ClosedUvLoop)
    | Undecided(Reason: UndecidedReason);

// An OrientedUvRegion, or why the region is not oriented.
type DecidedOrientedUvRegion
    = Decided(Value: OrientedUvRegion)
    | Undecided(Reason: UndecidedReason);

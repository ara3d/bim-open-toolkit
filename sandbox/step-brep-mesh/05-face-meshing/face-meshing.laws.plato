//==
// # Face meshing laws
//
// The laws of layer 05, one statement each. Every law is total: lookups are guarded with the
// conditional, so a law over a missing face, an out-of-range index, or an undiscretized edge is
// vacuously true. Laws whose parameters hold arrays or sums run over witnesses
// (PLATO-PRIMER.md B.2); the index parameters (i, k, h, j, q) are the sample points a Check_
// walks. Every approximate comparison names its tolerance: the model's Tolerances (Length,
// Angle, Parameter) or the criteria (SurfaceChordal, SurfaceAngular). Severities are in
// README.md, "Laws".
//
// Sections, in order:
//  - Guards
//  - Loops into parameter space
//  - The region
//  - Triangulations
//  - Lifting and identification
//  - Geometry of the face mesh
//  - Quads
//  - Outcomes

library FaceMeshingLaws
{
    //==
    // # Guards

    // True when loop l has a point and a source at position i.
    HasLoopPoint(l: UvLoop, i: Integer): Boolean
        => l.Points.IsValidIndex(i) && l.Sources.IsValidIndex(i);

    // The parameter tolerance of region r of face f, from the face's chart.
    RegionToleranceOf(m: BrepModel, f: BrepFaceIndex, r: UvRegion): UvTolerance
        => m.RegionTolerance(f, m.ChartOf(f, r));

    // True when a and b hold identical parameters; used only where one is a copy of the other.
    SameParameters(a: UvCoordinate, b: UvCoordinate): Boolean
        => a.U == b.U && a.V == b.V;   // exact by construction

    // True when a and b have identical coordinates; used only where one is a copy of the other.
    SameCoordinates(a: Point3D, b: Point3D): Boolean
        => a.X == b.X && a.Y == b.Y && a.Z == b.Z;   // exact by construction

    //==
    // # Loops into parameter space

    // Every point of a loop of face f whose source is a model vertex or an edge sample lifts,
    // through the face's surface, to within the length tolerance of that vertex's point or that
    // sample's point: the shared discretization.
    Law_LoopPointLiftsToSharedPoint(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, l: UvLoop, i: Integer): Boolean
        => (m.IsFaceIntact(f) && l.HasLoopPoint(i))
            ? m.LiftsToSharedPoint(f, d, l.Points[i], l.Sources[i])
            : true;

    // The claim of Law_LoopPointLiftsToSharedPoint for one point; synthetic and interior points
    // have no shared point.
    LiftsToSharedPoint(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, uv: UvCoordinate, s: UvPointSource): Boolean
        => match (s) {
            FromVertex(v) => m.IsVertexInRange(v) ? m.LiftsNear(f, uv, m.Vertices[v].Point) : true;
            FromEdge(e, k) => d.HasSample(e, k) ? m.LiftsNear(f, uv, d.ByEdge[e].Points[k]) : true;
            SeamCut(side, k) => true;
            Pole(side, k) => true;
            Interior => true;
        };

    // True when the surface point at uv is within the length tolerance of p.
    LiftsNear(m: BrepModel, f: BrepFaceIndex, uv: UvCoordinate, p: Point3D): Boolean
        => m.Geometry.Eval(m.SurfaceOf(f), uv).Distance(p) <= m.Tolerances.Length.Value;

    // LoopToUv gives exactly ExpectedLoopPointCount points for a bound of face f: over the
    // coedges of an edge loop, each edge's discretization count minus one (a coedge's end vertex
    // is the next coedge's start); one for a vertex loop.
    Law_LoopToUvCountMatchesDiscretization(m: BrepModel, f: BrepFaceIndex, b: FaceBound, d: EdgeDiscretizations): Boolean
        => (m.IsFaceIntact(f) && m.IsDiscretizedBound(b, d))
            ? m.LoopToUv(f, b, d).Points.Count == m.ExpectedLoopPointCount(b, d)
            : true;

    // Where the rule reads edge e's samples in face f from a pcurve, the pcurve's point for 3D
    // sample k and the projection of that sample are the same parameters up to whole periods,
    // within the parameter tolerance at that point. On a collapsed line, where one parameter is
    // free, nothing is claimed.
    Law_PcurveAgreesWithProjection(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, e: BrepEdgeIndex, k: Integer): Boolean
        => (m.IsFaceIntact(f) && m.IsEdgeIntact(e) && m.Geometry.IsEveryIndexInRange && d.HasSample(e, k))
            ? m.ImageAgreesWithProjection(f, m.ImageInFace(f, e), d.ByEdge[e], k)
            : true;

    // The claim of Law_PcurveAgreesWithProjection for sample k of discretization de drawn in
    // image img: nothing to check for a projection image or off the image's points.
    ImageAgreesWithProjection(m: BrepModel, f: BrepFaceIndex, img: EdgeImage, de: EdgeDiscretization, k: Integer): Boolean
        => (img.Pcurve.IsNone || m.ImagePoints(de, img).IsValidIndex(k).Not)
            ? true
            : (m.IsOnCollapsedLine(f, m.Geometry.Project(m.SurfaceOf(f), de.Points[k]))
                ? true
                : m.SurfaceDomainOf(f).SameParameter(m.ImagePoints(de, img)[k],
                    m.Geometry.Project(m.SurfaceOf(f), de.Points[k]),
                    m.PointTolerance(f, m.Geometry.Project(m.SurfaceOf(f), de.Points[k]))));

    // Unwrap keeps every point's source, in order.
    Law_UnwrapKeepsSources(m: BrepModel, f: BrepFaceIndex, l: UvLoop, i: Integer): Boolean
        => (m.IsFaceIntact(f) && l.HasLoopPoint(i))
            ? m.Unwrap(f, l).SourceAtIs(i, l.Sources[i])
            : true;

    // True when loop l has source s at position i.
    SourceAtIs(l: UvLoop, i: Integer, s: UvPointSource): Boolean
        => l.Sources.IsValidIndex(i) ? l.Sources[i] == s : false;

    // Unwrap moves every point that is not on a collapsed line by whole periods only, within the
    // parameter tolerance at that point: the unwrapped loop lifts to the same 3D points.
    Law_UnwrapMovesByWholePeriods(m: BrepModel, f: BrepFaceIndex, l: UvLoop, i: Integer): Boolean
        => (m.IsFaceIntact(f) && l.Points.Count == l.Sources.Count && l.HasLoopPoint(i))
            ? (m.IsOnCollapsedLine(f, l.Points[i]) ? true : m.MovedByWholePeriods(f, l.Points[i], m.Unwrap(f, l), i))
            : true;

    // The claim of Law_UnwrapMovesByWholePeriods at position i, before being the point there.
    MovedByWholePeriods(m: BrepModel, f: BrepFaceIndex, before: UvCoordinate, after: UvLoop, i: Integer): Boolean
        => after.Points.IsValidIndex(i)
            ? m.SurfaceDomainOf(f).SameParameter(before, after.Points[i], m.PointTolerance(f, before))
            : false;

    // After Unwrap, consecutive points of a loop are closer than half a period in every periodic
    // direction of face f's surface, except across a step that touches a collapsed line, where
    // the free parameter passes from the arriving seam copy to the leaving one. The closing step
    // from the last point to the first is not claimed: for a loop that winds it is a whole number
    // of periods off.
    Law_UnwrappedStepBelowHalfPeriod(m: BrepModel, f: BrepFaceIndex, l: UvLoop, i: Integer): Boolean
        => (m.IsFaceIntact(f) && l.Points.Count == l.Sources.Count) ? m.IsUnwrappedStep(f, m.Unwrap(f, l), i) : true;

    // The two uses of a model seam lie on opposite copies of the period, by the left rule of
    // research/STEP-BREP-MODEL.md section 4.3: where steps i and j of a loop of face f run along
    // one segment of seam e in opposite directions, the twin copy of the start of step i (the end
    // of step j) lies one period away and to the left of step i in the face's chart. Points on a
    // collapsed line are exempt. The law holds for Unwrap's loops and the region's.
    Law_SeamUsesOnOppositeCopies(m: BrepModel, f: BrepFaceIndex, l: UvLoop, e: BrepEdgeIndex, i: Integer, j: Integer): Boolean
        => (m.IsFaceIntact(f) && m.IsEdgeIntact(e) && l.Points.Count == l.Sources.Count
            && l.Points.IsValidIndex(i) && l.Points.IsValidIndex(j))
            ? (m.AreTwinSteps(f, e, l, i, j) ? m.FollowsLeftRule(f, l, i, j) : true)
            : true;

    //==
    // # The region

    // Every loop of face f's region closes in the plane: it winds zero times in u and in v.
    Law_RegionLoopClosesInPlane(m: BrepModel, f: BrepFaceIndex, r: UvRegion, k: Integer): Boolean
        => (m.IsFaceIntact(f) && k >= 0 && k < r.NumberOfLoops)
            ? m.UWinding(f, r.LoopAt(k)) == 0 && m.VWinding(f, r.LoopAt(k)) == 0
            : true;

    // The outer loop of face f's region has positive signed area in the face's chart: it runs
    // counter-clockwise about the face normal.
    UvRegionWindingPositive(m: BrepModel, f: BrepFaceIndex, r: UvRegion): Boolean
        => m.IsFaceIntact(f) ? r.Outer.ChartSignedArea(m.IsChartMirrored(f)) > 0.0 : true;

    // UvRegionWindingPositive on RegionOf's result, under RegionOf's precondition. Laws over a
    // value only one function produces take its inputs (decision F-54, reviews/FINDINGS.md); the
    // claim keeps the name without Law_ for the contracts and layer 7's checks.
    Law_UvRegionWindingPositive(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Boolean
        => m.CanRegion(f, d, c) ? m.UvRegionWindingPositive(f, m.RegionOf(f, d, c)) : true;

    // Every hole of face f's region that is not a point hole has negative signed area in the
    // face's chart.
    Law_UvHoleWindingNegative(m: BrepModel, f: BrepFaceIndex, r: UvRegion, h: Integer): Boolean
        => (m.IsFaceIntact(f) && r.Holes.IsValidIndex(h))
            ? (r.Holes[h].Points.Count < 3 ? true : r.Holes[h].ChartSignedArea(m.IsChartMirrored(f)) < 0.0)
            : true;

    // Any two boundary segments of face f's region are farther apart than the region's parameter
    // tolerance, and consecutive ones do not fold back onto each other: every loop is simple and
    // no two loops meet.
    Law_RegionSegmentsSeparated(m: BrepModel, f: BrepFaceIndex, r: UvRegion, k: Integer, i: Integer, q: Integer, j: Integer): Boolean
        => (m.IsFaceIntact(f) && r.HasSegment(k, i) && r.HasSegment(q, j))
            ? r.SegmentsSeparated(m.RegionToleranceOf(f, r), k, i, q, j)
            : true;

    // HoleInsideOuter at hole h of RegionOf's result, under RegionOf's precondition (F-54).
    Law_HoleInsideOuter(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria, h: Integer): Boolean
        => m.CanRegion(f, d, c) ? m.HoleInsideOuter(f, m.RegionOf(f, d, c), h) : true;

    // Every hole of a simple region of face f lies inside its outer loop.
    HoleInsideOuter(m: BrepModel, f: BrepFaceIndex, r: UvRegion, h: Integer): Boolean
        => (m.IsFaceIntact(f) && r.Holes.IsValidIndex(h))
            ? (r.Holes[h].Points.IsEmpty
                ? true
                : (r.IsSimpleRegion(m.RegionToleranceOf(f, r)) ? r.HoleInsideOuter(h) : true))
            : true;

    // The two copies of a seam cut run in opposite directions along the outer loop: where the
    // loop steps from SeamCut(side, k) to SeamCut(side, j), it also steps from
    // SeamCut(opposite side, j) to SeamCut(opposite side, k).
    Law_SeamCutCopiesRunOpposite(r: UvRegion, i: Integer): Boolean
        => r.Outer.Sources.IsValidIndex(i) ? r.SeamCutStepIsMirrored(i) : true;

    // A face that MeshFace meshes (a non-empty mesh) has a simple region; a face whose region is
    // not simple gets requests or an error and no mesh.
    Law_MeshedFaceHasSimpleRegion(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Boolean
        => (m.IsDiscretizedFace(f, d) && c.IsWellFormed)
            ? (m.MeshFace(f, d, c).Mesh.IsEmptyFaceMesh ? true : m.IsSimpleFaceRegion(f, m.RegionOf(f, d, c)))
            : true;

    // True when region r of face f is simple under its own tolerance.
    IsSimpleFaceRegion(m: BrepModel, f: BrepFaceIndex, r: UvRegion): Boolean
        => r.IsSimpleRegion(m.RegionToleranceOf(f, r));

    //==
    // # Triangulations

    // Every corner of every element of a triangulation names one of its points.
    TriangulationCornersInRange(t: UvTriangulation, k: ElementIndex): Boolean
        => t.HasElement(k) ? t.ElementCornersInRange(k) : true;

    // TriangulationCornersInRange at element k of face f's triangulation (FaceTriangulation),
    // under its precondition (CanTriangulateFace). F-54.
    Law_TriangulationCornersInRange(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria, k: ElementIndex): Boolean
        => m.CanTriangulateFace(f, d, c) ? m.FaceTriangulation(f, d, c).TriangulationCornersInRange(k) : true;

    // The first BoundaryCount(r) points of a triangulation of region r are the region's boundary
    // points with their sources, unchanged: no boundary point is added, moved, or removed.
    Law_TriangulationKeepsBoundary(r: UvRegion, t: UvTriangulation, i: Integer): Boolean
        => (r.IsIndexedRegion && i >= 0 && i < r.BoundaryCount)
            ? ((t.Points.IsValidIndex(i) && t.Sources.IsValidIndex(i))
                ? r.BoundaryPoints[i].SameParameters(t.Points[i]) && r.BoundarySources[i] == t.Sources[i]
                : false)
            : true;

    // Every point of a triangulation of region r of face f after the boundary points has source
    // Interior and lies strictly inside r, farther than the region's parameter tolerance from its
    // boundary.
    Law_TriangulationAddsOnlyInteriorPoints(m: BrepModel, f: BrepFaceIndex, r: UvRegion, t: UvTriangulation, i: Integer): Boolean
        => (m.IsFaceIntact(f) && i >= r.BoundaryCount && t.Points.IsValidIndex(i) && t.Sources.IsValidIndex(i))
            ? t.Sources[i] == UvPointSource.Interior && r.IsStrictlyInside(t.Points[i], m.RegionToleranceOf(f, r))
            : true;

    // EveryPointIsACorner at point i of face f's triangulation, under its precondition. F-54.
    Law_EveryPointIsACorner(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria, i: Integer): Boolean
        => m.CanTriangulateFace(f, d, c) ? m.FaceTriangulation(f, d, c).EveryPointIsACorner(i) : true;

    // Every point of a triangulation is a corner of some element, point holes included.
    EveryPointIsACorner(t: UvTriangulation, i: Integer): Boolean
        => t.Points.IsValidIndex(i)
            ? t.Triangles.Any(e => e.HasVertex(VertexIndex(i))) || t.Quads.Any(e => e.HasVertex(VertexIndex(i)))
            : true;

    // Every element of a triangulation of face f has positive signed area in the face's chart
    // (an exact sign test).
    Law_ElementPositiveInChart(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, k: ElementIndex): Boolean
        => (m.IsFaceIntact(f) && t.HasElement(k))
            ? (t.ElementCornersInRange(k) ? t.ElementChartArea(k, m.IsChartMirrored(f)) > 0.0 : true)
            : true;

    // The elements of a triangulation of region r of face f tile it: their chart areas sum to the
    // region's chart area within the area its boundary can sweep inside the region's parameter
    // tolerance (AreaTolerance).
    Law_ElementAreasSumToRegionArea(m: BrepModel, f: BrepFaceIndex, r: UvRegion, t: UvTriangulation): Boolean
        => (m.IsFaceIntact(f) && t.CornersInRange)
            ? (t.TotalChartArea(m.IsChartMirrored(f)) - r.ChartSignedArea(m.IsChartMirrored(f))).Abs
                <= r.AreaTolerance(m.RegionToleranceOf(f, r))
            : true;

    // Every element of a triangulation of face f that does not collapse at a pole, lifted through
    // the surface, winds counter-clockwise about the face normal at its parameter centroid (an
    // exact sign). Positive chart area does not imply it: on the unit sphere the parameter
    // triangle (0, 0.5), (0.2, 0.5), (0.1, 0.5001) has chart area +1e-5 and touches no pole, yet
    // its flat normal is 2.05 rad from the face normal, because its height (1e-4) is below the
    // sagitta of its long edge (3.8e-3). So refinement enforces the sign (review H5).
    Law_ElementLiftsFacingFaceNormal(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, k: ElementIndex): Boolean
        => (m.IsFaceIntact(f) && t.HasElement(k))
            ? (t.ElementCornersInRange(k)
                ? (t.IsCollapsedElement(k) ? true : m.LiftsFacingFaceNormal(f, t, k))
                : true)
            : true;

    // Boundary segment i of loop k of region r is a side of exactly one element of triangulation
    // t, traversed in the boundary's direction, and no element runs along it the other way
    // (review M5). Keeping the boundary points is not enough: a unit square triangulated by ABC
    // and ABD keeps every corner, has two positive triangles whose areas sum to 1, and leaves
    // (0.2, 0.9) uncovered, because the side CD is no element's side.
    Law_BoundarySegmentIsElementSide(r: UvRegion, t: UvTriangulation, k: Integer, i: Integer): Boolean
        => r.HasSegment(k, i)
            ? ((r.LoopAt(k).Points.Count >= 3 && r.IsIndexedRegion && t.CornersInRange)
                ? t.SideCount(VertexIndex(r.LoopOffset(k) + i), VertexIndex(r.NextBoundaryPoint(r.LoopOffset(k) + i))) == 1
                    && t.SideCount(VertexIndex(r.NextBoundaryPoint(r.LoopOffset(k) + i)), VertexIndex(r.LoopOffset(k) + i)) == 0
                : true)
            : true;

    // Every side of an element of triangulation t that is not a boundary segment of region r is a
    // side of exactly two elements, traversed opposite ways: side j of element k runs from a to b,
    // no other element runs from a to b, and exactly one runs from b to a.
    Law_InteriorSideIsShared(r: UvRegion, t: UvTriangulation, k: ElementIndex, j: Integer): Boolean
        => (t.HasElement(k) && t.CornersInRange && r.IsIndexedRegion)
            ? ((j >= 0 && j < t.ElementCorners(k).Count)
                ? t.InteriorSideIsShared(r, t.ElementCorners(k)[j], t.ElementCorners(k).AtModulo(j + 1))
                : true)
            : true;

    // The claim of Law_InteriorSideIsShared for the side from a to b.
    InteriorSideIsShared(t: UvTriangulation, r: UvRegion, a: VertexIndex, b: VertexIndex): Boolean
        => r.IsBoundarySegment(a.Value, b.Value) ? true : (t.SideCount(a, b) == 1 && t.SideCount(b, a) == 1);

    // No element of a triangulation of face f spans half a period or more in a periodic
    // direction, so none wraps around the surface or folds across a seam.
    Law_ElementSpansBelowHalfPeriod(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, k: ElementIndex): Boolean
        => (m.IsFaceIntact(f) && t.HasElement(k))
            ? (t.ElementCornersInRange(k) ? m.SpansBelowHalfPeriod(f, t, k) : true)
            : true;

    //==
    // # Lifting and identification

    // LiftKeepsPoints at point i, for face f's triangulation and its Lift, under the
    // triangulation's precondition. F-54.
    Law_LiftKeepsPoints(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria, i: Integer): Boolean
        => m.CanTriangulateFace(f, d, c)
            ? m.FaceTriangulation(f, d, c).LiftKeepsPoints(m.Lift(f, d, m.FaceTriangulation(f, d, c)), i)
            : true;

    // Lift keeps the triangulation's parameter-space points and their sources, in order.
    LiftKeepsPoints(t: UvTriangulation, fm: FaceMesh, i: Integer): Boolean
        => (t.Points.IsValidIndex(i) && t.Sources.IsValidIndex(i))
            ? ((fm.UvPoints.IsValidIndex(i) && fm.Sources.IsValidIndex(i))
                ? fm.UvPoints[i].SameParameters(t.Points[i]) && fm.Sources[i] == t.Sources[i]
                : false)
            : true;

    // The local vertex of every parameter-space point exists.
    LocalVertexInRange(fm: FaceMesh, i: VertexIndex): Boolean
        => fm.LocalVertex.IsValidIndex(i) ? fm.Positions.IsValidIndex(fm.LocalVertex[i]) : true;

    // LocalVertexInRange at point i of MeshFace's mesh, under MeshFace's precondition. F-54.
    Law_LocalVertexInRange(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria, i: VertexIndex): Boolean
        => m.CanMeshFace(f, d, c) ? m.MeshFace(f, d, c).Mesh.LocalVertexInRange(i) : true;

    // Every local 3D vertex is the local vertex of some parameter-space point.
    LocalVertexSurjective(fm: FaceMesh, v: VertexIndex): Boolean
        => fm.Positions.IsValidIndex(v) ? fm.LocalVertex.Any(w => w == v) : true;

    // LocalVertexSurjective at local vertex v of MeshFace's mesh, under MeshFace's
    // precondition. F-54.
    Law_LocalVertexSurjective(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria, v: VertexIndex): Boolean
        => m.CanMeshFace(f, d, c) ? m.MeshFace(f, d, c).Mesh.LocalVertexSurjective(v) : true;

    // Two distinct parameter-space points share a local 3D vertex exactly when their sources are
    // identified: the seam and pole identifications, and nothing else.
    Law_LocalVertexFibresAreIdentifications(fm: FaceMesh, i: VertexIndex, j: VertexIndex): Boolean
        => (fm.LocalVertex.IsValidIndex(i) && fm.LocalVertex.IsValidIndex(j)
            && fm.Sources.IsValidIndex(i) && fm.Sources.IsValidIndex(j) && i != j)
            ? (fm.LocalVertex[i] == fm.LocalVertex[j]) == IdentifiedSources(fm.Sources[i], fm.Sources[j])
            : true;

    // A point whose source is a model vertex or an edge sample sits exactly at that vertex's
    // point or that sample's point, copied, so both faces of an edge hold the same positions.
    Law_SharedPositionIsCopied(m: BrepModel, d: EdgeDiscretizations, fm: FaceMesh, i: VertexIndex): Boolean
        => fm.IsLiftedPoint(i) ? m.PositionIsCopied(d, fm.Sources[i], fm.PositionOf(i)) : true;

    // The claim of Law_SharedPositionIsCopied for one point.
    PositionIsCopied(m: BrepModel, d: EdgeDiscretizations, s: UvPointSource, p: Point3D): Boolean
        => match (s) {
            FromVertex(v) => m.IsVertexInRange(v) ? p.SameCoordinates(m.Vertices[v].Point) : true;
            FromEdge(e, k) => d.HasSample(e, k) ? p.SameCoordinates(d.ByEdge[e].Points[k]) : true;
            SeamCut(side, k) => true;
            Pole(side, k) => true;
            Interior => true;
        };

    // ProvenanceMatchesSource at point i of MeshFace's mesh, under MeshFace's precondition.
    // F-54.
    Law_ProvenanceMatchesSource(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria, i: VertexIndex): Boolean
        => m.CanMeshFace(f, d, c) ? d.ProvenanceMatchesSource(m.MeshFace(f, d, c).Mesh, i) : true;

    // The provenance of the local vertex of every point agrees with the point's source: the model
    // vertex; the edge with the sample's curve parameter, copied; or the face itself.
    ProvenanceMatchesSource(d: EdgeDiscretizations, fm: FaceMesh, i: VertexIndex): Boolean
        => fm.IsLiftedPoint(i)
            ? d.ProvenanceAgrees(fm.Face, fm.Sources[i], fm.Provenance[fm.LocalVertex[i]])
            : true;

    // The claim of Law_ProvenanceMatchesSource for one point.
    ProvenanceAgrees(d: EdgeDiscretizations, f: BrepFaceIndex, s: UvPointSource, p: MeshVertexProvenance): Boolean
        => match (s) {
            FromVertex(v) => p == MeshVertexProvenance.OnVertex(v);
            FromEdge(e, k) => d.HasSample(e, k)
                ? p == MeshVertexProvenance.OnEdge(e, d.ByEdge[e].Parameters[k])   // exact by construction
                : true;
            SeamCut(side, k) => p.IsOnFace(f);
            Pole(side, k) => p.IsOnFace(f);
            Interior => p.IsOnFace(f);
        };

    // The normal stored for a parameter-space point off the collapsed lines is the face normal
    // there, up to rounding. Both sides are this library's own computation, so the bound is the
    // arithmetic resolution of a unit vector (layer 00's ResolutionAt(1)), not the file's angle
    // tolerance, and the angle is layer 00's AngleBetweenDirections (atan2), which gives exactly
    // zero for identical directions; the arc cosine cannot resolve angles below about 1.5e-8 rad,
    // and a third of random unit vectors compared with themselves exceed the 1e-9 rad tolerance
    // under it (review F7).
    Law_PointNormalIsFaceNormal(m: BrepModel, fm: FaceMesh, i: VertexIndex): Boolean
        => (m.IsFaceIntact(fm.Face) && fm.IsLiftedPoint(i))
            ? (m.IsOnCollapsedLine(fm.Face, fm.UvPoints[i])
                ? true
                : fm.Normals[i].AngleBetweenDirections(
                    Direction3D(m.FaceNormalAt(fm.Face, fm.UvPoints[i], fm.Normals[i].Vector))).Radians
                    <= ResolutionAt(1.0))
            : true;

    // Lift drops exactly the triangles with two corners that are one local vertex (identified
    // sources, the points of one pole segment): the face mesh has that many fewer elements than
    // the triangulation it was lifted from.
    Law_DroppedElementsArePoleCollapsed(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, fm: FaceMesh): Boolean
        => (m.IsFaceIntact(f) && t.CornersInRange)
            ? t.ElementCount - fm.ElementCount == t.CollapsedTriangleCount
            : true;

    // Lift turns exactly the quads with two corners that are one local vertex into triangles.
    Law_CollapsedQuadsBecomeTriangles(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, fm: FaceMesh): Boolean
        => (m.IsFaceIntact(f) && t.CornersInRange)
            ? t.Quads.Count - fm.Quads.Count == t.CollapsedQuadCount
            : true;

    //==
    // # Geometry of the face mesh

    // Every element turns counter-clockwise about the face normal: its vector area points to the
    // side of the face normal at its parameter centroid (an exact sign; zero or negative is a
    // fold). Elements keep their corner order from the chart, which is mirrored exactly when
    // FaceNormalSign is -1; refinement splits the elements that fold when lifted
    // (Law_ElementLiftsFacingFaceNormal), since a positive chart area alone does not prevent it.
    Law_ElementFacesFaceNormal(m: BrepModel, fm: FaceMesh, k: ElementIndex): Boolean
        => m.CanMeasure(fm, k) ? m.FacesFaceNormal(fm, k) : true;

    // Every element that touches no collapsed line has its normal within SurfaceAngular of the
    // face normal at its parameter centroid.
    Law_ElementNormalAgreesWithSurface(m: BrepModel, fm: FaceMesh, c: FaceMeshingCriteria, k: ElementIndex): Boolean
        => m.CanMeasure(fm, k)
            ? (m.TouchesCollapsedLine(fm, k) ? true : m.ElementNormalDeviation(fm, k) <= c.SurfaceAngular)
            : true;

    // The face normal turns by at most SurfaceAngular along every surface edge of every element
    // (edge j of element k): the definition of SurfaceAngular.
    Law_SurfaceEdgeNormalTurnWithinSurfaceAngular(m: BrepModel, d: EdgeDiscretizations, fm: FaceMesh, c: FaceMeshingCriteria, k: ElementIndex, j: Integer): Boolean
        => (m.CanMeasure(fm, k) && m.IsDiscretizedFace(fm.Face, d))
            ? ((j >= 0 && j < fm.ElementCorners(k).Count)
                ? (m.IsSurfaceEdge(d, fm, fm.ElementCorners(k)[j], fm.ElementCorners(k).AtModulo(j + 1))
                    ? fm.EdgeNormalTurn(k, j) <= c.SurfaceAngular
                    : true)
                : true)
            : true;

    // Every element's deviation from the surface, over the midpoints of its surface edges and the
    // mean of its corners, is at most SurfaceChordal plus the length tolerance (the corners
    // themselves may lie that far from the surface).
    Law_ElementDeviationWithinSurfaceChordal(m: BrepModel, d: EdgeDiscretizations, fm: FaceMesh, c: FaceMeshingCriteria, k: ElementIndex): Boolean
        => (m.CanMeasure(fm, k) && m.IsDiscretizedFace(fm.Face, d))
            ? m.ElementDeviation(d, fm, k) <= c.SurfaceChordal + m.Tolerances.Length.Value
            : true;

    // The surface under every element lies within SurfaceChordal plus the length tolerance of
    // the flat element, at the surface points of its parameter centroid and of its surface edges'
    // parameter midpoints: coverage from the surface to the mesh, which ElementDeviation (mesh to
    // surface) does not measure (review M6).
    Law_SurfaceWithinSurfaceChordalOfElement(m: BrepModel, d: EdgeDiscretizations, fm: FaceMesh, c: FaceMeshingCriteria, k: ElementIndex): Boolean
        => (m.CanMeasure(fm, k) && m.IsDiscretizedFace(fm.Face, d))
            ? m.ElementCoverageGap(d, fm, k) <= c.SurfaceChordal + m.Tolerances.Length.Value
            : true;

    //==
    // # Quads

    // Every quad of a face mesh is planar within SurfaceChordal: no corner lies farther than that
    // from its mid-plane.
    Law_QuadPlanarWithinSurfaceChordal(fm: FaceMesh, c: FaceMeshingCriteria, q: FaceIndex): Boolean
        => fm.IsMeasurableQuad(q) ? fm.QuadWarp(q) <= c.SurfaceChordal : true;

    // Every quad of a face mesh is strictly convex.
    Law_QuadConvex(fm: FaceMesh, q: FaceIndex): Boolean
        => fm.IsMeasurableQuad(q) ? fm.IsConvexQuad(q) : true;

    //==
    // # Outcomes

    // MeshFace with PreferQuads false produces no quads.
    Law_NoQuadsUnlessPreferred(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Boolean
        => c.PreferQuads
            ? true
            : (m.IsDiscretizedFace(f, d) ? m.MeshFace(f, d, c).Mesh.Quads.Count == 0 : true);

    // Every request in MeshFace's outcome for face f names an edge f cites, so a face reaches
    // other faces only through the edges it shares with them (layer 08's refinement loop relies
    // on it).
    Law_RequestsNameFaceEdges(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria, q: Integer): Boolean
        => (m.IsDiscretizedFace(f, d) && c.IsWellFormed)
            ? m.RequestNamesFaceEdge(f, m.MeshFace(f, d, c), q)
            : true;

    // The claim of Law_RequestsNameFaceEdges for request q of outcome o.
    RequestNamesFaceEdge(m: BrepModel, f: BrepFaceIndex, o: FaceMeshOutcome, q: Integer): Boolean
        => o.Requests.IsValidIndex(q) ? m.FaceEdges(f).Any(e => e == o.Requests[q].Edge) : true;

    // MeshFace reads only the discretizations of the edges face f cites: two discretization sets
    // that agree on those edges give the same outcome, bit for bit (layer 08's loop rests on it
    // to keep an outcome current while other edges change).
    Law_MeshFaceReadsOnlyFaceEdges(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, d2: EdgeDiscretizations, c: FaceMeshingCriteria): Boolean
        => (m.IsDiscretizedFace(f, d) && c.IsWellFormed)
            ? (m.AgreeOnFaceEdges(f, d, d2) ? m.MeshFace(f, d, c).SameFaceMeshOutcome(m.MeshFace(f, d2, c)) : true)
            : true;

    // An outcome with a blocking request has an empty mesh.
    BlockingRequestMeansEmptyMesh(o: FaceMeshOutcome): Boolean
        => o.Requests.Any(q => q.Reason.IsBlocking) ? o.Mesh.IsEmptyFaceMesh : true;

    // BlockingRequestMeansEmptyMesh on MeshFace's outcome, under its precondition. F-54.
    Law_BlockingRequestMeansEmptyMesh(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Boolean
        => m.CanMeshFace(f, d, c) ? m.MeshFace(f, d, c).BlockingRequestMeansEmptyMesh : true;

    // An outcome with a request has at least one diagnostic.
    RequestHasDiagnostic(o: FaceMeshOutcome): Boolean
        => o.Requests.IsEmpty ? true : o.Diagnostics.Count > 0;

    // RequestHasDiagnostic on MeshFace's outcome, under its precondition. F-54.
    Law_RequestHasDiagnostic(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Boolean
        => m.CanMeshFace(f, d, c) ? m.MeshFace(f, d, c).RequestHasDiagnostic : true;

    // An outcome with an empty mesh and no request carries an error diagnostic: a face is never
    // left unmeshed without a word.
    Law_EmptyMeshIsExplained(o: FaceMeshOutcome): Boolean
        => (o.Mesh.IsEmptyFaceMesh && o.Requests.IsEmpty)
            ? o.Diagnostics.Any(x => x.Severity == Severity.Error)
            : true;
}

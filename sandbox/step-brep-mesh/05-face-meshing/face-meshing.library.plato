//==
// # Face meshing
//
// The second half of layer 05: from a face's oriented region to its mesh in space. Triangulate
// the region in its chart with the boundary fixed, refine against the surface with the boundary
// locked, or lay a structured quad grid when the region is four-sided; then lift through the
// surface map, identifying seam copies and collapsing poles. MeshFace composes the stages and is
// the layer's entry point. Bodies define the measures the laws use; the algorithms are deferred,
// with contracts in face-meshing.spec.plato.
//
// Sections, in order:
//  - Typed empty arrays
//  - Criteria
//  - Triangulation and refinement
//  - Elements of a triangulation
//  - Lifting
//  - Elements in space
//  - Surface measures
//  - Quads
//  - Outcomes
//  - Meshing one face

library FaceMeshing
{
    //==
    // # Typed empty arrays

    // No diagnostics.
    NoDiagnostics(_: Diagnostic): Array<Diagnostic>
        => 0.MapRange(i => Diagnostic(Severity.Info, "", "", Provenance.Nowhere, 0.0));

    //==
    // # Criteria

    // True when the face criteria can be met: well-formed edge criteria (layer 04), a positive
    // surface chordal, and a surface angular strictly between zero and a right angle.
    IsWellFormed(c: FaceMeshingCriteria): Boolean
        => c.Discretization.IsWellFormed
            && c.SurfaceChordal > 0.0 && c.SurfaceAngular.Radians > 0.0 && c.SurfaceAngular.Radians < Number.HalfPi;

    //==
    // # Triangulation and refinement

    // deferred: constrained Delaunay triangulation, in the chart (ChartPoint), of the region's
    // boundary points in BoundaryPoints order; every boundary segment a constraint; holes removed
    // by even-odd flood fill; point holes inserted as isolated vertices; exact orientation and
    // in-circle predicates; no point added.
    TriangulateRegion(r: UvRegion, chart: FaceChart): UvTriangulation;

    // deferred: seed interior points by surface kind (none on planes and cylinders, rows and
    // columns at the closed-form step on spheres and tori, knot lines on B-splines), then insert,
    // by Delaunay insertion in the chart, the parameters of the sample point (Project of an
    // interior edge midpoint or of the corner mean) of the element that most exceeds
    // SurfaceChordal or SurfaceAngular (the turn along a surface edge, or the element normal
    // against the face normal at its centroid), or that folds when lifted (LiftsFacingFaceNormal),
    // until none does or the new point would lie closer than MinLength in 3D to an existing one.
    // Boundary points are never added, moved or removed.
    RefineToSurface(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, t: UvTriangulation, c: FaceMeshingCriteria): UvTriangulation;

    // The region's constrained triangulation, refined against the surface.
    RefinedTriangulation(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, c: FaceMeshingCriteria): UvTriangulation
        => m.RefineToSurface(f, r, chart, r.TriangulateRegion(chart), c);

    //==
    // # Elements of a triangulation
    //
    // Element k is triangle k for k below the triangle count and quad k - TriangleCount after
    // it: the numbering ElementIndex fixes, here local to one face.

    // The number of elements.
    ElementCount(t: UvTriangulation): Integer
        => t.Triangles.Count + t.Quads.Count;

    // True when element k exists.
    HasElement(t: UvTriangulation, k: ElementIndex): Boolean
        => k.Value >= 0 && k.Value < t.ElementCount;

    // The corners of element k in winding order. Precondition: HasElement.
    ElementCorners(t: UvTriangulation, k: ElementIndex): Array<VertexIndex>
        => k.Value < t.Triangles.Count
            ? t.Triangles[k.Value].Vertices
            : t.Quads[k.Value - t.Triangles.Count].Vertices;

    // True when every corner of element k names a point. Precondition: HasElement.
    ElementCornersInRange(t: UvTriangulation, k: ElementIndex): Boolean
        => t.ElementCorners(k).All(v => t.Points.IsValidIndex(v) && t.Sources.IsValidIndex(v));

    // True when every corner of every element names a point.
    CornersInRange(t: UvTriangulation): Boolean
        => t.ElementCount.Range.All(k => t.ElementCornersInRange(ElementIndex(k)));

    // The signed area of element k in the oriented chart. Precondition: corners in range.
    ElementChartArea(t: UvTriangulation, k: ElementIndex, mirrored: Boolean): Number
        => t.ElementCorners(k).Map(v => t.Points[v].OrientedPoint(mirrored)).ShoelaceArea;

    // The sum of the elements' signed areas in the oriented chart.
    TotalChartArea(t: UvTriangulation, mirrored: Boolean): Number
        => SumOf(t.ElementCount.MapRange(k => t.ElementChartArea(ElementIndex(k), mirrored)));

    // True when every pair of element k's corners is closer than half a period in each periodic
    // direction of face f's surface, so the element neither wraps nor folds.
    SpansBelowHalfPeriod(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, k: ElementIndex): Boolean
    {
        var cs = t.ElementCorners(k);
        return cs.Count.Range.All(i => cs.Count.Range.All(j =>
            m.SurfaceDomainOf(f).StepBelowHalfPeriod(t.Points[cs[i]], t.Points[cs[j]])));
    }

    // True when two corners of element k lie on one collapsed line of face f's surface, so the
    // element loses a corner in 3D. Precondition: corners in range.
    IsPoleCollapsed(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, k: ElementIndex): Boolean
    {
        var cs = t.ElementCorners(k);
        return cs.Count.Range.Any(i => cs.Count.Range.Any(j =>
            j > i ? m.ShareCollapsedLine(f, t.Points[cs[i]], t.Points[cs[j]]) : false));
    }

    // The mean of element k's corner parameters: its parameter centroid. Precondition: corners
    // in range.
    ElementUvCentroid(t: UvTriangulation, k: ElementIndex): UvCoordinate
    {
        var mean = t.ElementCorners(k).Map(v => t.Points[v].ToPoint2D).AverageOfPoints;
        return UvCoordinate(mean.X, mean.Y);
    }

    // The vector area (Newell) of element k of t lifted through face f's surface: its corners
    // evaluated on the surface. Precondition: corners in range.
    LiftedVectorArea(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, k: ElementIndex): Vector3D
        => t.ElementCorners(k).Map(v => m.Geometry.Eval(m.SurfaceOf(f), t.Points[v])).VectorArea;

    // True when element k of t, lifted through face f's surface, winds counter-clockwise about
    // the face normal at its parameter centroid: an exact sign. A positive chart area does not
    // imply it (a sliver whose height is below the sagitta of its long edge folds; see
    // Law_ElementLiftsFacingFaceNormal), so refinement enforces it. Precondition: corners in
    // range.
    LiftsFacingFaceNormal(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, k: ElementIndex): Boolean
        => m.LiftedVectorArea(f, t, k).Dot(
            m.FaceNormalAt(f, t.ElementUvCentroid(k), m.LiftedVectorArea(f, t, k))) > 0.0;

    // How many triangles collapse at a pole: the triangles Lift drops.
    PoleCollapsedTriangleCount(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation): Integer
        => t.Triangles.Count.Range.Reduce(0, (n, k) => n + (m.IsPoleCollapsed(f, t, ElementIndex(k)) ? 1 : 0));

    // How many quads collapse at a pole: the quads Lift turns into triangles.
    PoleCollapsedQuadCount(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation): Integer
        => t.Quads.Count.Range.Reduce(0, (n, q) =>
            n + (m.IsPoleCollapsed(f, t, ElementIndex(t.Triangles.Count + q)) ? 1 : 0));

    //==
    // # Lifting

    // deferred: number the local 3D vertices by identification class (IdentifiedSources) in order
    // of first appearance; position each class by SharedPosition, falling back to the surface
    // point of its first member; Normals by FaceNormalAt, or on a collapsed line by layer 01's
    // LimitNormal at the point's own parameters (one normal per meridian at a cone apex) times
    // the face's sense; Provenance by ProvenanceOfSource of the class's first member; drop
    // triangles with two corners on one collapsed line, and turn such quads into the triangle of
    // their other three corners.
    Lift(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, t: UvTriangulation): FaceMesh;

    // The position of the local vertex of a point with source s: the model vertex's point or the
    // edge sample's point, copied so both faces of an edge hold the same position; the given
    // surface point for synthetic and interior points.
    SharedPosition(m: BrepModel, d: EdgeDiscretizations, s: UvPointSource, surfacePoint: Point3D): Point3D
        => match (s) {
            FromVertex(v) => m.Vertices[v].Point;
            FromEdge(e, k) => d.ByEdge[e].Points[k];
            SeamCut(side, k) => surfacePoint;
            Pole(side, k) => surfacePoint;
            Interior => surfacePoint;
        };

    // The provenance of the local vertex a point with source s and parameters uv lifts to: the
    // model vertex; the edge with the sample's curve parameter; or face f with the parameters,
    // for synthetic and interior points (a 3D point of the face's interior).
    ProvenanceOfSource(d: EdgeDiscretizations, f: BrepFaceIndex, s: UvPointSource, uv: UvCoordinate): MeshVertexProvenance
        => match (s) {
            FromVertex(v) => MeshVertexProvenance.OnVertex(v);
            FromEdge(e, k) => MeshVertexProvenance.OnEdge(e, d.ByEdge[e].Parameters[k]);
            SeamCut(side, k) => MeshVertexProvenance.OnFace(f, uv);
            Pole(side, k) => MeshVertexProvenance.OnFace(f, uv);
            Interior => MeshVertexProvenance.OnFace(f, uv);
        };

    // +1 when face f's normal is its surface's normal as ISO 10303-42 states it (layer 01's
    // NormalOr), -1 when it is the opposite: the face's SameSense.
    FaceSenseSign(m: BrepModel, f: BrepFaceIndex): Number
        => m.Faces[f].SameSense ? 1.0 : -1.0;

    // The face normal at uv: the surface normal times the face's sense. Where the surface normal
    // is undefined, the fallback (given in face terms) is returned.
    FaceNormalAt(m: BrepModel, f: BrepFaceIndex, uv: UvCoordinate, fallback: Vector3D): Vector3D
        => m.Geometry.NormalOr(m.SurfaceOf(f), uv, Direction3D(fallback * m.FaceSenseSign(f))).Vector
            * m.FaceSenseSign(f);

    //==
    // # Elements in space

    // The number of elements.
    ElementCount(fm: FaceMesh): Integer
        => fm.Triangles.Count + fm.Quads.Count;

    // True when element k exists.
    HasElement(fm: FaceMesh, k: ElementIndex): Boolean
        => k.Value >= 0 && k.Value < fm.ElementCount;

    // The corners of element k in winding order. Precondition: HasElement.
    ElementCorners(fm: FaceMesh, k: ElementIndex): Array<VertexIndex>
        => k.Value < fm.Triangles.Count
            ? fm.Triangles[k.Value].Vertices
            : fm.Quads[k.Value - fm.Triangles.Count].Vertices;

    // True when parameter-space point i and the local vertex it lifts to exist in every array
    // that holds them.
    IsLiftedPoint(fm: FaceMesh, i: VertexIndex): Boolean
        => (fm.UvPoints.IsValidIndex(i) && fm.Sources.IsValidIndex(i) && fm.Normals.IsValidIndex(i)
            && fm.LocalVertex.IsValidIndex(i))
            ? (fm.Positions.IsValidIndex(fm.LocalVertex[i]) && fm.Provenance.IsValidIndex(fm.LocalVertex[i]))
            : false;

    // True when face f exists and element k and everything its corners reference exist, so a
    // law may measure the element.
    CanMeasure(m: BrepModel, fm: FaceMesh, k: ElementIndex): Boolean
        => (m.IsFaceIntact(fm.Face) && fm.HasElement(k))
            ? fm.ElementCorners(k).All(i => fm.IsLiftedPoint(i))
            : false;

    // The 3D position of parameter-space point i.
    PositionOf(fm: FaceMesh, i: VertexIndex): Point3D
        => fm.Positions[fm.LocalVertex[i]];

    // The corner positions of element k.
    ElementPositions(fm: FaceMesh, k: ElementIndex): Array<Point3D>
        => fm.ElementCorners(k).Map(i => fm.PositionOf(i));

    // The vector area of element k (Newell): its magnitude is the area and its direction the
    // element normal by the right-hand rule over the corner order.
    ElementVectorArea(fm: FaceMesh, k: ElementIndex): Vector3D
        => fm.ElementPositions(k).VectorArea;

    // The mean of element k's corner parameters: its parameter centroid.
    ElementUvCentroid(fm: FaceMesh, k: ElementIndex): UvCoordinate
    {
        var mean = fm.ElementCorners(k).Map(i => fm.UvPoints[i].ToPoint2D).AverageOfPoints;
        return UvCoordinate(mean.X, mean.Y);
    }

    // True when some corner of element k lies on a collapsed line.
    TouchesCollapsedLine(m: BrepModel, fm: FaceMesh, k: ElementIndex): Boolean
        => fm.ElementCorners(k).Any(i => m.IsOnCollapsedLine(fm.Face, fm.UvPoints[i]));

    // The angle between element k's normal and the face normal at its parameter centroid.
    ElementNormalDeviation(m: BrepModel, fm: FaceMesh, k: ElementIndex): Angle
        => fm.ElementVectorArea(k).AngleBetween(
            m.FaceNormalAt(fm.Face, fm.ElementUvCentroid(k), fm.ElementVectorArea(k)));

    // The winding sign of element k: +1 when its vector area points to the side of the face
    // normal at its parameter centroid (counter-clockwise about the face normal), -1 when it
    // points away (a fold), 0 when they are perpendicular or the element has no area.
    WindingSign(m: BrepModel, fm: FaceMesh, k: ElementIndex): Integer
        => fm.ElementVectorArea(k).Dot(m.FaceNormalAt(fm.Face, fm.ElementUvCentroid(k), fm.ElementVectorArea(k))).Sign;

    // True when element k winds counter-clockwise about the face normal.
    FacesFaceNormal(m: BrepModel, fm: FaceMesh, k: ElementIndex): Boolean
        => m.WindingSign(fm, k) == 1;

    //==
    // # Surface measures
    //
    // SurfaceChordal and SurfaceAngular apply to "surface edges": element edges that are not a
    // segment of a model edge's discretization (layer 04's chordal and angular criteria bound
    // those, and the boundary is locked) and that do not lie along one collapsed line (they have
    // no length in 3D). SurfaceAngular is defined as kernels define the normal tolerance, the turn
    // of the surface normal along an element edge: the angle between the face normals at its two
    // ends (OpenCascade AngleInterior, ACIS SPANORMALTOL). For a small element whose surface
    // edges turn by at most a, the flat normal need not stay within a of the face normal: on a
    // sliver it can fold over (the counterexample in face-meshing.spec.plato), so the centroid
    // test is a separate criterion with the same tolerance, which refinement enforces too.
    // Converted to the corner test of research/MESHING-REQUIREMENTS.md
    // section 2.3 (element normal against surface normal at a corner), a is about sqrt(3) times
    // that angle for equilateral triangles on a sphere and 2 times it for a cylinder strip.

    // The point halfway between a and b.
    HalfwayPoint(a: Point3D, b: Point3D): Point3D
        => Point3D((a.X + b.X) * 0.5, (a.Y + b.Y) * 0.5, (a.Z + b.Z) * 0.5);

    // True when the element edge from point a to point b is a surface edge of face mesh fm, its
    // edges discretized as d.
    IsSurfaceEdge(m: BrepModel, d: EdgeDiscretizations, fm: FaceMesh, a: VertexIndex, b: VertexIndex): Boolean
        => m.IsModelEdgeSegment(fm.Face, d, fm.Sources[a], fm.Sources[b]).Not
            && m.ShareCollapsedLine(fm.Face, fm.UvPoints[a], fm.UvPoints[b]).Not;

    // The distance from p to face f's surface, measured to the surface point inverse evaluation
    // returns. Never below the true distance, so a bound on it bounds the truth.
    SurfaceDistance(m: BrepModel, f: BrepFaceIndex, p: Point3D): Number
        => p.Distance(m.Geometry.Eval(m.SurfaceOf(f), m.Geometry.Project(m.SurfaceOf(f), p)));

    // Element k's deviation from the surface: the largest surface distance over its sample
    // points, which are the midpoints of its surface edges and the mean of its corner positions.
    ElementDeviation(m: BrepModel, d: EdgeDiscretizations, fm: FaceMesh, k: ElementIndex): Number
    {
        var cs = fm.ElementCorners(k);
        var ps = fm.ElementPositions(k);
        return cs.Count.Range.Reduce(m.SurfaceDistance(fm.Face, ps.AverageOfPoints), (worst, j) =>
            m.IsSurfaceEdge(d, fm, cs[j], cs.AtModulo(j + 1))
                ? worst.Max(m.SurfaceDistance(fm.Face, ps[j].HalfwayPoint(ps.AtModulo(j + 1))))
                : worst);
    }

    // The turn of the face normal along element k's edge from corner j to corner j + 1: the angle
    // between the normals stored at its two ends.
    EdgeNormalTurn(fm: FaceMesh, k: ElementIndex, j: Integer): Angle
        => fm.Normals[fm.ElementCorners(k).AtModulo(j)].Vector
            .AngleBetween(fm.Normals[fm.ElementCorners(k).AtModulo(j + 1)].Vector);

    // The length of element k's shortest edge in 3D: what MinLength compares against when
    // refinement stops short of the criteria.
    ShortestEdgeLength(fm: FaceMesh, k: ElementIndex): Number
    {
        var ps = fm.ElementPositions(k);
        return ps.Count.Range.Reduce(Number.MaxValue, (shortest, j) => shortest.Min(ps[j].Distance(ps.AtModulo(j + 1))));
    }

    //==
    // # Quads
    //
    // A quad is kept only when it is planar within SurfaceChordal and strictly convex; otherwise
    // the grid splits it along the diagonal whose triangles have the larger minimum angle. Quads
    // come only from a structured grid on a four-sided region whose opposite sides have equal
    // segment counts (research/MESHING-REQUIREMENTS.md section 5); everything else is triangles.

    // True when quad q and everything its corners reference exist.
    IsMeasurableQuad(fm: FaceMesh, q: FaceIndex): Boolean
        => fm.Quads.IsValidIndex(q) ? fm.Quads[q].Vertices.All(i => fm.IsLiftedPoint(i)) : false;

    // The corner positions of quad q.
    QuadPositions(fm: FaceMesh, q: FaceIndex): Array<Point3D>
        => fm.Quads[q].Vertices.Map(i => fm.PositionOf(i));

    // The largest distance from quad q's corners to its mid-plane: the plane through the mean of
    // its corners whose normal is its Newell normal. Zero for a planar quad.
    QuadWarp(fm: FaceMesh, q: FaceIndex): Number
    {
        var ps = fm.QuadPositions(q);
        var n = ps.VectorArea.Normalize;
        var centre = ps.AverageOfPoints;
        return ps.Reduce(0.0, (worst, p) => worst.Max((p - centre).Dot(n).Abs));
    }

    // True when quad q is strictly convex: the turn at every corner points along its Newell
    // normal.
    IsConvexQuad(fm: FaceMesh, q: FaceIndex): Boolean
    {
        var ps = fm.QuadPositions(q);
        var n = ps.VectorArea;
        return 4.Range.All(j => (ps[j] - ps.AtModulo(j + 3)).Cross(ps.AtModulo(j + 1) - ps[j]).Dot(n) > 0.0);
    }

    // What a quad grid on region r of face f gives: nothing unless the region is four-sided; the
    // segment floors that would match opposite sides when their counts differ; else the grid.
    QuadGridIfRectangular(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, c: FaceMeshingCriteria): QuadGridOutcome
        => m.QuadGridOnSides(f, d, r, c, m.QuadSidesOf(f, r));

    // QuadGridIfRectangular, given the region's four-sided classification.
    QuadGridOnSides(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, c: FaceMeshingCriteria, sides: QuadSides): QuadGridOutcome
        => match (sides) {
            NotFourSided => QuadGridOutcome.NoGrid;
            FourSided(corners) => r.OppositeCountsMatch(corners)
                ? m.GridUnlessFolded(f, m.QuadGrid(f, r, corners, c))
                : QuadGridOutcome.CountsDiffer(m.MatchingFloors(f, d, r, corners));
        };

    // The grid, unless some element of it that does not collapse at a pole folds when lifted
    // (LiftsFacingFaceNormal false); then no grid, and the face gets the refined triangulation,
    // which splits folds.
    GridUnlessFolded(m: BrepModel, f: BrepFaceIndex, g: UvTriangulation): QuadGridOutcome
        => g.ElementCount.Range.All(k =>
            m.IsPoleCollapsed(f, g, ElementIndex(k)) ? true : m.LiftsFacingFaceNormal(f, g, ElementIndex(k)))
            ? QuadGridOutcome.Grid(g)
            : QuadGridOutcome.NoGrid;

    // deferred: transfinite (Coons) interpolation in parameter space between the four sides,
    // whose points are the region's boundary points unchanged (the boundary prefix); rows that
    // touch a pole segment end in triangles; a quad that after lifting fails QuadWarp <=
    // SurfaceChordal or IsConvexQuad is split along the diagonal whose triangles have the larger
    // minimum angle.
    QuadGrid(m: BrepModel, f: BrepFaceIndex, r: UvRegion, corners: Array<VertexIndex>, c: FaceMeshingCriteria): UvTriangulation;

    // deferred: for each pair of opposite sides with different segment counts, the floor of the
    // shorter side's edge is the longer side's count; a side that is a seam use, a seam cut or a
    // pole segment has no edge to floor. Indexed by BrepEdgeIndex, zero elsewhere.
    MatchingFloors(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, corners: Array<VertexIndex>): SegmentFloors;

    // The QuadCountMismatch request for edge e under the floors, when its floor exceeds its
    // current segment count: the count in Segments, the criteria's chordal unchanged.
    FloorRequest(m: BrepModel, d: EdgeDiscretizations, floors: SegmentFloors, c: FaceMeshingCriteria, e: BrepEdgeIndex): Array<EdgeRefinementRequest>
        => floors.ByEdge[e] > d.ByEdge[e].Points.Count - 1
            ? [EdgeRefinementRequest(e, RefinementReason.QuadCountMismatch, c.Discretization.Chordal, floors.ByEdge[e])]
            : EdgeRefinementRequest.NoRequests;

    // The advisory QuadCountMismatch requests of a quad grid outcome.
    QuadCountRequests(m: BrepModel, d: EdgeDiscretizations, grid: QuadGridOutcome, c: FaceMeshingCriteria): Array<EdgeRefinementRequest>
        => match (grid) {
            NoGrid => EdgeRefinementRequest.NoRequests;
            CountsDiffer(floors) => floors.ByEdge.Count.Range.FlatMap(i => m.FloorRequest(d, floors, c, BrepEdgeIndex(i)));
            Grid(mesh) => EdgeRefinementRequest.NoRequests;
        };

    //==
    // # Outcomes

    // True when a request withholds the face's mesh: only a loop that is not simple in parameter
    // space makes every triangulation invalid. A segment too coarse in parameter space, or a
    // quad count mismatch, still leaves a valid triangle mesh, which is kept.
    IsBlocking(reason: RefinementReason): Boolean
        => match (reason) {
            LoopSelfIntersects => true;
            TooCoarseInParameterSpace => false;
            QuadCountMismatch => false;
        };

    // A face mesh with no points, vertices, or elements.
    EmptyFaceMesh(f: BrepFaceIndex): FaceMesh
        => FaceMesh(f, [], [], [], [], [], [], [], []);

    // True when the face mesh has no points, vertices, or elements.
    IsEmptyFaceMesh(fm: FaceMesh): Boolean
        => fm.UvPoints.Count == 0 && fm.Positions.Count == 0 && fm.ElementCount == 0;

    // The diagnostic that accompanies a request, located at the edge, measuring the chordal asked
    // for: an error for a blocking request, a warning for a segment too coarse in parameter
    // space, information for a quad count mismatch.
    RequestDiagnostic(q: EdgeRefinementRequest): Diagnostic
        => match (q.Reason) {
            LoopSelfIntersects => Diagnostic(Severity.Error, "FACE-LOOP-NOT-SIMPLE",
                "Segments on this edge come closer than the parameter tolerance to another boundary segment of a face; that face is not meshed until the edge is refined.",
                Provenance.KernelEdge(q.Edge), q.Chordal);
            TooCoarseInParameterSpace => Diagnostic(Severity.Warning, "FACE-EDGE-COARSE-IN-UV",
                "A segment of this edge, drawn straight in a face's parameters, strays from its 3D chord by more than the edge chordal; the face is meshed and the edge is asked to refine.",
                Provenance.KernelEdge(q.Edge), q.Chordal);
            QuadCountMismatch => Diagnostic(Severity.Info, "FACE-QUAD-COUNT-MISMATCH",
                "This edge has fewer segments than the opposite side of a four-sided face; the face is meshed with triangles this round.",
                Provenance.KernelEdge(q.Edge), q.Chordal);
        };

    // A diagnostic located at face f.
    FaceDiagnostic(f: BrepFaceIndex, severity: Severity, code: String, message: String): Diagnostic
        => Diagnostic(severity, code, message, Provenance.KernelFace(f), 0.0);

    // A warning for each loop of the unoriented region whose traversal OrientRegion reverses:
    // the file's loop runs against the face's sense.
    ReversalDiagnostics(m: BrepModel, f: BrepFaceIndex, raw: UvRegion): Array<Diagnostic>
        => raw.NumberOfLoops.Range.FlatMap(k =>
            (k == 0 ? raw.LoopAt(k).ChartSignedArea(m.IsChartMirrored(f)) < 0.0
                    : raw.LoopAt(k).ChartSignedArea(m.IsChartMirrored(f)) > 0.0)
                ? [f.FaceDiagnostic(Severity.Warning, "FACE-LOOP-REVERSED",
                    "A loop of this face runs against the face's sense in parameter space; it was reversed.")]
                : Diagnostic.NoDiagnostics);

    // The outcome for a face that is not meshed and asks for nothing: an empty mesh and one error.
    UnmeshedOutcome(f: BrepFaceIndex, code: String, message: String): FaceMeshOutcome
        => FaceMeshOutcome(EmptyFaceMesh(f), EdgeRefinementRequest.NoRequests,
            [f.FaceDiagnostic(Severity.Error, code, message)]);

    //==
    // # Meshing one face

    // The triangulation to lift: the quad grid when one was built, else the refined constrained
    // triangulation.
    GridOrTriangles(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, grid: QuadGridOutcome, c: FaceMeshingCriteria): UvTriangulation
        => match (grid) {
            NoGrid => m.RefinedTriangulation(f, r, chart, c);
            CountsDiffer(floors) => m.RefinedTriangulation(f, r, chart, c);
            Grid(mesh) => mesh;
        };

    // A simple region of face f meshed: grid or refined triangulation, lifted, with the advisory
    // requests and their diagnostics, and a warning for each loop the file gave reversed.
    MeshedOutcome(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, raw: UvRegion, r: UvRegion, chart: FaceChart, c: FaceMeshingCriteria): FaceMeshOutcome
    {
        var grid = c.PreferQuads ? m.QuadGridIfRectangular(f, d, r, c) : QuadGridOutcome.NoGrid;
        var t = m.GridOrTriangles(f, r, chart, grid, c);
        var advisory = m.CoarseSegmentRequests(f, d, r, c).Concatenate(m.QuadCountRequests(d, grid, c));
        return FaceMeshOutcome(m.Lift(f, d, t), advisory,
            advisory.Map(q => q.RequestDiagnostic).Concatenate(m.ReversalDiagnostics(f, raw)));
    }

    // Face f's region meshed, or refused: a region that is not simple gets an empty mesh and the
    // blocking requests with their diagnostics, or one face error when no model edge is to blame.
    MeshRegion(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): FaceMeshOutcome
    {
        var raw = m.UnorientedRegionOf(f, d, c);
        var r = m.OrientRegion(f, raw);
        var chart = m.ChartOf(f, r);
        var blocking = m.SelfIntersectionRequests(f, d, r, m.RegionTolerance(f, chart));
        return r.IsSimpleRegion(m.RegionTolerance(f, chart))
            ? m.MeshedOutcome(f, d, raw, r, chart, c)
            : (blocking.Count > 0
                ? FaceMeshOutcome(EmptyFaceMesh(f), blocking, blocking.Map(q => q.RequestDiagnostic))
                : f.UnmeshedOutcome("FACE-REGION-NOT-SIMPLE",
                    "Synthetic seam or pole segments of this face collide in parameter space; the face is not meshed."));
    }

    // Face f meshed under criteria c, its edges discretized as d: the layer's entry point. A face
    // with a poly loop is not meshed (version 1); otherwise MeshRegion.
    MeshFace(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): FaceMeshOutcome
        => m.HasPolyLoop(f)
            ? f.UnmeshedOutcome("FACE-POLY-LOOP",
                "This face is bounded by a poly loop, which version 1 does not mesh; the decoder should give it edges.")
            : m.MeshRegion(f, d, c);
}

//==
// # A loop through a pole closes in the plane: types (TKT-411)

// A polar lune of the unit sphere witness's face 0 as the loop LoopToUv would give it, parameters
// wrapped into the domain: a meridian at u = Start from latitude Rim down to the south pole, the
// pole, a meridian at u = Start + Width back up to Rim, and the parallel at Rim back to Start.
type PoleLune
{
    Start: Number;
    Width: Number;
    Rim: Number;
}

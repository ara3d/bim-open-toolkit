// Laws of ThinBoundOf (insertion-clearance.library.plato, TKT-464): the c211 face 339 witness
// (08-pipeline/pipeline-corpus-witness-c211-339.library.plato, extracted with
// `step-corpus-harness extract c211_case_with_odin_v1.step 339 <out> --ring 0`) meshes within its chordal bound, and
// the per-triangle thickness bound never admits a degenerate triangle.
library V1ThickLaws
{
    // The deviation of triangle k of mesh from its face's surface: the largest surface distance of its
    // corner mean and its three chord midpoints, as ElementChordalDeviation samples an element.
    TriangleDeviation(m: BrepModel, mesh: ModelMesh, k: Integer): Number
    {
        var t = mesh.Triangles[k];
        var f = mesh.ElementFace[k];
        var ps = [mesh.Positions[t.A.Value], mesh.Positions[t.B.Value], mesh.Positions[t.C.Value]];
        return 3.Range.Reduce(m.SurfaceDistance(f, ps.AverageOfPoints), (worst, j) =>
            worst.Max(m.SurfaceDistance(f, ps[j].HalfwayPoint(ps[(j + 1) % 3]))));
    }

    // The largest TriangleDeviation over the triangles of c211 face 339's witness, meshed by the host's options at a
    // 1 mm bound.
    C211Face339Deviation(_: Integer): Number
    {
        var m = BrepModel.Witness_C211CaseWithOdinV1Face339;
        var mesh = m.MeshModel(HostMeshingOptions(1.0)).Mesh;
        return mesh.Triangles.Count.Range.Reduce(0.0, (worst, k) => worst.Max(m.TriangleDeviation(mesh, k)));
    }

    // u-blox SHO/c211_case_with_odin_v1.step face 339, a quarter cylinder of radius 6 with a 0.05 mm boundary
    // segment, meshes within the chordal bound plus the length tolerance. Before TKT-464 every insertion that would
    // split its 1.3 rad fans is refused by CavityIsThick and the worst triangle is 1.324 from the surface.
    Law_V1Gate_C211Face339WithinChordal(_: Integer): Boolean
        => C211Face339Deviation(0) <= 1.0 + BrepModel.Witness_C211CaseWithOdinV1Face339.Tolerances.Length.Value;

    Measure_V1Gate_C211Face339WithinChordal(_: Integer): Number
        => C211Face339Deviation(0);

    // A triangle that meets ThinBoundOf is not degenerate: its bound is above one length tolerance (the altitude
    // ElementIsNotDegenerate rejects) and never above ThinBound, so F2's bump top keeps its bound.
    Law_V1Gate_ThinBoundOfIsBetweenTheToleranceAndThinBound(a: Point3D, b: Point3D, c: Point3D): Boolean
    {
        var m = BrepModel.Witness_C211CaseWithOdinV1Face339;
        var bound = m.ThinBoundOf(a, b, c);
        return bound > m.Tolerances.Length.Value && bound <= m.ThinBound.Max(2.0 * m.Tolerances.Length.Value);
    }
}

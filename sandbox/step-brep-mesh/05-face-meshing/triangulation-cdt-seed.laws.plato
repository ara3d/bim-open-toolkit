//==
// # The constrained Delaunay seed by insertion: laws (track v1-edges, chunk E4, TKT-468)
//
// The seed (triangulation-cdt-seed.library.plato) on regions built here: pad arrays (an outer rectangle whose
// bottom side holds a point at every unit, and a grid of square holes in aligned rows, the shape
// that breaks ear clipping over bridged rings) and a rectangle with every side subdivided (one
// loop, straight angles everywhere). On each: n + 2h - 2 triangles when every point is a boundary
// point, every boundary segment a side of exactly one triangle, the triangles' area the region's,
// and no triangle below the area floor (2 area >= 1e-9 longest side^2, TKT-462). Where today's
// ear-clipped seed is complete, the new seed has its count and its area.
//
// Sections, in order:
//  - Regions
//  - Facts of a seed
//  - Laws

library V1EdgesCdtSeedLaws
{
    //==
    // # Regions

    // The loop through the points, every point an interior source (the seed reads only points).
    PlainLoop(points: Array<UvCoordinate>): UvLoop
        => UvLoop(points, points.Map(p => UvPointSource.Interior));

    // The square hole with lower corner (x, y) and side 1, clockwise (the region lies outside it).
    SquareHole(x: Number, y: Number): UvLoop
        => PlainLoop([UvCoordinate(x, y), UvCoordinate(x, y + 1.0), UvCoordinate(x + 1.0, y + 1.0), UvCoordinate(x + 1.0, y)]);

    // The pad array: the rectangle [0, 3 cols + 1] x [0, 3 rows + 1], counter-clockwise, its bottom
    // side through every integer x, and cols x rows unit square holes at (3 i + 1, 3 j + 1).
    PadArray(cols: Integer, rows: Integer): UvRegion
    {
        var w = (3 * cols + 1).ToNumber;
        var h = (3 * rows + 1).ToNumber;
        var bottom = (3 * cols + 1).MapRange(i => UvCoordinate(i.ToNumber, 0.0));
        var outer = bottom.Concatenate([UvCoordinate(w, 0.0), UvCoordinate(w, h), UvCoordinate(0.0, h)]);
        return UvRegion(PlainLoop(outer), (cols * rows).MapRange(k =>
            SquareHole((3 * (k % cols) + 1).ToNumber, (3 * (k / cols) + 1).ToNumber)));
    }

    // The rectangle [0, w] x [0, h] with k points on each side (corners included), one loop.
    SubdividedRectangle(w: Number, h: Number, k: Integer): UvRegion
    {
        var s = k - 1;
        var bottom = s.MapRange(i => UvCoordinate(w * i.ToNumber / s.ToNumber, 0.0));
        var right = s.MapRange(i => UvCoordinate(w, h * i.ToNumber / s.ToNumber));
        var top = s.MapRange(i => UvCoordinate(w - w * i.ToNumber / s.ToNumber, h));
        var left = s.MapRange(i => UvCoordinate(0.0, h - h * i.ToNumber / s.ToNumber));
        return UvRegion(PlainLoop(bottom.Concatenate(right).Concatenate(top).Concatenate(left)), [PlainLoop(bottom)].Take(0));
    }

    // The region's boundary points as chart points with the identity chart.
    PlainPoints(r: UvRegion): Array<Point2D>
        => r.BoundaryPoints.Map(uv => Point2D(uv.U, uv.V));

    //==
    // # Facts of a seed

    // The number of holes of three or more points.
    WideHoles(r: UvRegion): Integer
        => r.Holes.Reduce(0, (n, l) => l.Points.Count >= 3 ? n + 1 : n);

    // The region's area: the outer loop's signed area plus the holes' (negative).
    RegionArea(r: UvRegion, points: Array<Point2D>): Number
    {
        var next = r.NextBoundaryTable;
        return next.Count.Range.Reduce(0.0, (sum, a) => next[a] < 0 ? sum
            : sum + 0.5 * (points[a].X * points[next[a]].Y - points[next[a]].X * points[a].Y));
    }

    // The triangles' total area.
    TrianglesArea(tris: Array<TriangleFace>, points: Array<Point2D>): Number
        => tris.Reduce(0.0, (sum, t) => sum + 0.5 * TwiceSignedArea(points[t.A.Value], points[t.B.Value], points[t.C.Value]));

    // Whether triangle t has 2 area at least 1e-9 times its longest side squared.
    IsAboveAreaFloor(t: TriangleFace, points: Array<Point2D>): Boolean
    {
        var a = points[t.A.Value];
        var b = points[t.B.Value];
        var c = points[t.C.Value];
        var longest = a.Distance(b).Max(b.Distance(c)).Max(c.Distance(a));
        return TwiceSignedArea(a, b, c) >= 1e-9 * longest * longest;
    }

    // Whether exactly one triangle has the directed side a to b.
    HasSideOnce(tris: Array<TriangleFace>, a: Integer, b: Integer): Boolean
        => tris.Reduce(0, (n, t) => n + (t.SideSlot(a, b) >= 0 ? 1 : 0)) == 1;

    // The four facts of the seed of r: SeedCompleteCount triangles (n + 2h - 2, plus one per
    // point on no segment), every boundary segment a side once,
    // the region's area, every triangle above the floor.
    SeedFactsHold(r: UvRegion): Boolean
    {
        var points = r.PlainPoints;
        var next = r.NextBoundaryTable;
        var tris = points.CdtSeedOverCopies(next);
        var area = r.RegionArea(points);
        return tris.Count == r.SeedCompleteCount
            && next.Count.Range.All(a => next[a] < 0 ? true : tris.HasSideOnce(a, next[a]))
            && (tris.TrianglesArea(points) - area).Abs <= 1e-9 * area.Abs
            && tris.All(t => t.IsAboveAreaFloor(points));
    }

    //==
    // # Laws

    // The seed holds its facts on pad arrays of 1 x 1, 3 x 2 and 10 x 10 pads (100 holes, 431
    // boundary points, aligned rows) and on rectangles with 5 and 60 points a side.
    Law_V1Edges_SeedFactsOnSynthetic(_: Integer): Boolean
        => PadArray(1, 1).SeedFactsHold && PadArray(3, 2).SeedFactsHold && PadArray(10, 10).SeedFactsHold
            && SubdividedRectangle(3.0, 1.0, 5).SeedFactsHold && SubdividedRectangle(40.0, 0.5, 60).SeedFactsHold;

    // Where today's ear-clipped seed (CdtSeedIndexedCounted) is complete, the new seed has its
    // triangle count and its area: the 1 x 1 pad array and the 5-point rectangle. On the 10 x 10
    // pad array today's seed is short (the defect), which the law also states, so the witness
    // stays a witness.
    Law_V1Edges_SeedAgreesWhereEarClippingIsComplete(_: Integer): Boolean
    {
        var small = PadArray(1, 1);
        var rect = SubdividedRectangle(3.0, 1.0, 5);
        var big = PadArray(10, 10);
        return small.SeedAgrees && rect.SeedAgrees
            && big.CdtSeedIndexedCounted(big.PlainPoints).Value.Count < big.PlainPoints.Count + 2 * big.WideHoles - 2;
    }

    // On star cases 1 and 3 (shipped laws' StarCase: a star with holes and a point hole at
    // (0, 1.3)) the seed is complete, SeedCompleteCount triangles (the point hole inside two
    // more), and the mesher's seed (CdtSeedOfRegionOverCopies, E5a) has that count. A failure here once was an index of -1: the
    // generated code evaluates both operands of &&.
    Law_V1Edges_SeedHoldsPointHoles(_: Integer): Boolean
        => StarCase(1).CdtSeedOfRegionOverCopies(StarCase(1).PlainPoints).Count == StarCase(1).SeedCompleteCount
            && StarCase(3).CdtSeedOfRegionOverCopies(StarCase(3).PlainPoints).Count == StarCase(3).SeedCompleteCount;

    // The new seed and today's have the same count and area on r.
    SeedAgrees(r: UvRegion): Boolean
    {
        var points = r.PlainPoints;
        var old = r.CdtSeedIndexedCounted(points).Value;
        var seed = points.CdtSeedOverCopies(r.NextBoundaryTable);
        return old.Count == points.Count + 2 * r.WideHoles - 2 && seed.Count == old.Count
            && (seed.TrianglesArea(points) - old.TrianglesArea(points)).Abs <= 1e-9 * old.TrianglesArea(points).Abs;
    }
}

//==
// # The pole-loop sphere meshes (TKT-411)
//
// v1-gate found that Witness_SphereByPoleLoops(1.0), meshed at chordal 0.05 or 0.01 with the
// angular surface bound off (SurfaceAngular 180 degrees, version 1's chordal-only refinement),
// throws ArgumentOutOfRangeException in face meshing: a small witness of TKT-411's index error.
//
// Sections, in order:
//  - Cases
//  - Meshing

library FaceMeshingPoleWitnessLaws
{
    //==
    // # Cases

    Witness_PoleLoopsCoarse(_: PoleLoopCase): PoleLoopCase
        => PoleLoopCase(0.05);
    Witness_PoleLoopsFine(_: PoleLoopCase): PoleLoopCase
        => PoleLoopCase(0.01);

    // Whether case w's chordal bound is one the witness is meshed at: between 0.005 and 0.2. The
    // law runner also draws bounds at random; the others hold vacuously.
    IsPoleLoopChordal(w: PoleLoopCase): Boolean
        => w.Chordal >= 0.005 && w.Chordal <= 0.2;

    // The default criteria at case w's chordal bound with the angular surface bound off.
    PoleLoopCriteria(w: PoleLoopCase): FaceMeshingCriteria
    {
        var o = DefaultMeshingOptions(w.Chordal).Face;
        return FaceMeshingCriteria(o.Discretization, o.SurfaceChordal, 180.0.Degrees, o.PreferQuads);
    }

    //==
    // # Meshing

    // Every face of the pole-loop sphere meshes to some element under the case's criteria (before
    // TKT-411 the run throws).
    Law_V1Faces_SphereByPoleLoopsMeshes(w: PoleLoopCase): Boolean
        => w.IsPoleLoopChordal ? w.PoleLoopFacesMesh(BrepModel.Witness_SphereByPoleLoops(1.0)) : true;

    // Law_V1Faces_SphereByPoleLoopsMeshes on model m.
    PoleLoopFacesMesh(w: PoleLoopCase, m: BrepModel): Boolean
    {
        var c = w.PoleLoopCriteria;
        var d = m.DiscretizeAll(c.Discretization, SegmentFloors.NoFloors);
        return m.Faces.Count.Range.All(i => m.MeshFace(BrepFaceIndex(i), d, c).Mesh.ElementCount > 0);
    }
}

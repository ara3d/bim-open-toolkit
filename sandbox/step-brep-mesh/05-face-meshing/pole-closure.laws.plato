//==
// # A loop through a pole closes in the plane: laws (TKT-411)
//
// The lunes have the shape of CEL/LENA-R8.STEP face 202 (half a turn, starting on the seam's far
// side), and widths of a quarter and three quarters of a turn, their raw loops built on the unit
// sphere witness's face 0.
//
// Sections, in order:
//  - Lunes
//  - The region of a lune

library FaceMeshingPoleClosureLaws
{
    //==
    // # Lunes

    Witness_LuneHalfTurn(_: PoleLune): PoleLune
        => PoleLune(Number.Pi, Number.Pi, -0.7126566280125592);
    Witness_LuneQuarterTurn(_: PoleLune): PoleLune
        => PoleLune(0.5, Number.HalfPi, -0.7);
    Witness_LuneThreeQuarterTurn(_: PoleLune): PoleLune
        => PoleLune(1.0, 3.0 * Number.HalfPi, -0.3);

    // Whether lune k is one: narrower than a turn, its rim strictly between the poles, and wider
    // than half a radian, so that ExpandedPoint expands its pole (a narrower lune's two meridians
    // can lie within the point tolerance along u at the pole, which is wide there, and its pole
    // stays one point). The law runner also draws lunes at random; the others hold vacuously.
    IsLune(k: PoleLune): Boolean
        => k.Width > 0.5 && k.Width < 2.0 * Number.Pi - 0.1 && k.Rim > 0.1 - Number.HalfPi && k.Rim < Number.HalfPi - 0.1;

    // The model the lunes are drawn on: the unit sphere, its one face.
    LuneModel(k: PoleLune): BrepModel
        => BrepModel.Witness_Sphere(1.0);

    // Lune k's raw loop: three points down the first meridian, the pole (u 0, as projection leaves
    // it), three up the second, and seven back along the parallel, every u wrapped into the domain.
    LuneLoop(k: PoleLune): UvLoop
    {
        var dom = k.LuneModel.SurfaceDomainOf(BrepFaceIndex(0));
        var south = 0.0 - Number.HalfPi;
        var b = k.Start + k.Width;
        var down = 3.MapRange(j => UvCoordinate(k.Start, k.Rim + (south - k.Rim) * j.ToNumber / 3.0));
        var up = 3.MapRange(j => UvCoordinate(b, south + (k.Rim - south) * (j + 1).ToNumber / 3.0));
        var back = 7.MapRange(j => UvCoordinate(b - k.Width * (j + 1).ToNumber / 8.0, k.Rim));
        var points = down.Concatenate([UvCoordinate(0.0, south)]).Concatenate(up).Concatenate(back).Map(uv => dom.Wrap(uv));
        return UvLoop(points, points.Map(uv => UvPointSource.Interior));
    }

    // The criteria the lunes are expanded under (the grid cases' criteria).
    LuneCriteria(k: PoleLune): FaceMeshingCriteria
        => FaceMeshingCriteria.GridCaseCriteria;

    // Whether region r is lune k: no hole, and the outer loop's parameter area is Width times the
    // rim's height above the pole.
    IsLuneRegion(k: PoleLune, r: UvRegion): Boolean
        => r.Holes.IsEmpty
            && (r.Outer.Points.Map(p => p.ToPoint2D).ShoelaceArea.Abs - k.Width * (k.Rim + Number.HalfPi)).Abs <= 1e-9;

    //==
    // # The region of a lune

    // Unwrapped and closed at its pole, a lune's loop does not wind round u once its pole is
    // expanded, and its region is the lune.
    Law_V1Faces_LuneClosesAtPole(k: PoleLune): Boolean
        => k.IsLune ? k.LuneClosesAtPole : true;

    // Law_V1Faces_LuneClosesAtPole on a lune.
    LuneClosesAtPole(k: PoleLune): Boolean
    {
        var m = k.LuneModel;
        var f = BrepFaceIndex(0);
        var dom = m.SurfaceDomainOf(f);
        var closed = m.ClosedAtPole(f, dom, m.UnwrapIndexedIn(f, dom, k.LuneLoop));
        return m.UWinding(f, m.ExpandedPoles(f, [closed], k.LuneCriteria)[0]) == 0
            && k.IsLuneRegion(m.AddMissingSeamsAndPoles(f, [closed], k.LuneCriteria));
    }

    // A loop that winds alone, not a band, is no band pair: the parallel at lune k's rim, one loop
    // winding once round u, has one winding loop and IsBandPair is false, where before TKT-411
    // IsBandPair read a second winding entry and threw. (Staged on the half-turn lune's unwrapped
    // loop; since the merge Unwrap closes that loop at its pole, so it no longer winds.)
    Law_V1Faces_SingleWindingLoopIsNoBandPair(k: PoleLune): Boolean
    {
        if (k.IsLune.Not)
        {
            return true;
        }
        var m = k.LuneModel;
        var f = BrepFaceIndex(0);
        var dom = m.SurfaceDomainOf(f);
        var points = 8.MapRange(j => dom.Wrap(UvCoordinate(2.0 * Number.Pi * j.ToNumber / 8.0, k.Rim)));
        var loops = [m.UnwrapIndexedIn(f, dom, UvLoop(points, points.Map(uv => UvPointSource.Interior)))];
        var winding = m.WindingLoops(f, loops);
        return winding.Count == 1 && m.IsBandPair(f, loops, winding).Not;
    }
}

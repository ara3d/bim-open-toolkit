//==
// # The angle test with carried marks (complexity sweep, chunk F4)
//
// BelowAngleKnown, the angle test of the refinement loop in triangulation-fast.library.plato,
// with its counted form and the angle-good mark the loop carries between passes, so an
// unchanged triangle at or above RefinementMinAngle is not lifted (three surface evaluations)
// again every pass. Merged 2026-10-21 from sandbox/step-mesh-staging/perf-refine-flat.
//
// Sections, in order:
//  - The angle test

library TriangulationFastMarks
{
    //==
    // # The angle test

    // BelowAngleKnown with its work: Evaluations counts the surface evaluations of the triangles
    // it lifts (three each), Insertions the indices it adds to the result. A triangle is lifted
    // unless refused[k] or good[k] marks it (a missing mark is false).
    BelowAngleCounted(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, refused: Array<Boolean>, good: Array<Boolean>): Counted<Array<Integer>>
    {
        var limit = RefinementMinAngle(0);
        var bad = new List<Integer>();
        var lifted = 0;
        var k = 0;
        while (k < t.Triangles.Count)
        {
            var skip = (k < refused.Count ? refused[k] : false) || (k < good.Count ? good[k] : false);
            if (skip.Not)
            {
                lifted = lifted + 1;
                if (m.SmallestCornerAngle(f, t, t.Triangles[k]) < limit)
                {
                    bad = bad.Add(k);
                }
            }
            k = k + 1;
        }
        var value = bad.Freeze();
        return Counted(value, Evaluations(3 * lifted).Add(Insertions(value.Count)));
    }

    // The indices, in order, of the triangles of t below RefinementMinAngle that neither
    // refused[k] nor good[k] (known to be at or above it) marks.
    BelowAngleKnown(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, refused: Array<Boolean>, good: Array<Boolean>): Array<Integer>
        => m.BelowAngleCounted(f, t, refused, good).Value;

    // A mark per triangle of t: true where the angle test that gave `bad` (with `refused`
    // marking the triangles it skipped) found the triangle at or above RefinementMinAngle, or it
    // was skipped as known good.
    AngleGoodMarks(t: UvTriangulation, refused: Array<Boolean>, bad: Array<Integer>): Array<Boolean>
        => t.Triangles.CarriedMarks(refused, bad, t.Triangles).Map(x => x.Not);
}

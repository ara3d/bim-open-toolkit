//==
// # The angle test with carried marks: laws (complexity sweep, chunk F4)
//
// The count witness of BelowAngleCounted (read by layer 00's Law_WorkIsWithinSlope) and the
// exact count of the triangles it lifts. Merged 2026-10-21 from
// sandbox/step-mesh-staging/perf-refine-flat; the agreement of every flat replacement with the
// body it replaced was shown before wiring, point for point and triangle for triangle on every
// triangulable sample face (Law_Perf_RefineKnownAgrees and four more).
//
// Sections, in order:
//  - The count witness

library TriangulationFastMarksLaws
{
    //==
    // # The count witness

    // A strip of n triangles (n rounded up to even, at least 2) over parameters of the unit box's
    // face 0, a plane: k = n / 2 columns between the rows v = 0 and v = 1, each column split
    // into two triangles, counter-clockwise. Columns narrower than their height make every
    // triangle below 30 degrees once k > 1, so the angle test keeps them all: its worst case.
    PlaneStrip(n: Integer): UvTriangulation
    {
        var k = ((n + 1) / 2).Max(1);
        var pts = (2 * (k + 1)).MapRange(i => i <= k
            ? UvCoordinate(i.ToNumber / k.ToNumber, 0.0)
            : UvCoordinate((i - k - 1).ToNumber / k.ToNumber, 1.0));
        var tris = (2 * k).MapRange(j => j % 2 == 0
            ? TriangleFace(VertexIndex(j / 2), VertexIndex(j / 2 + 1), VertexIndex(k + 1 + j / 2))
            : TriangleFace(VertexIndex(j / 2 + 1), VertexIndex(k + 2 + j / 2), VertexIndex(k + 1 + j / 2)));
        return UvTriangulation(pts, pts.Map(x => UvPointSource.Interior), tris,
            [QuadFace(VertexIndex(0), VertexIndex(0), VertexIndex(0), VertexIndex(0))].Take(0));
    }

    // The work of the angle test on the n-triangle plane strip with no triangle marked.
    BelowAngleWork(n: Integer): WorkBudget
        => BrepModel.Witness_UnitBox.BelowAngleCounted(BrepFaceIndex(0), PlaneStrip(n), [false].Take(0), [false].Take(0)).Work;

    // The angle test lifts each triangle at most once (three surface evaluations, counted as
    // Evaluations) and adds at most one index per triangle (Insertions), at 32 and 128 triangles.
    // The library's BelowAngle allocated a T-element range per triangle, T^2 Insertions.
    Witness_BelowAngleWork(_: WorkClaim): WorkClaim
        => WorkClaim("BelowAngle: lifts and indices per triangle", Insertions(1).Add(Evaluations(3)), [32, 128], n => BelowAngleWork(n));
}

//==
// # Face meshing preconditions with the arena check passed in (complexity sweep, chunk G2)
//
// IsDiscretizedBound scans the whole geometry arena (Geometry.IsEveryIndexInRange) once per
// bound, and layer 08 asks it for every bound of every face: O(faces x bounds x arena). These
// forms take the scan's answer as arenaOk, so a caller scans once per model and each bound
// costs only its own loop. At merge IsDiscretizedBound and IsDiscretizedFace become these with
// m.Geometry.IsEveryIndexInRange passed in, which gives the same Boolean (the old body
// evaluated both operands of && too).
//
// Sections, in order:
//  - Preconditions

library FaceMeshingGuards
{
    //==
    // # Preconditions

    // IsDiscretizedBound with the arena check's answer given: true when bound b's loop is intact,
    // arenaOk holds, and every edge the loop cites is intact with a discretization of at least
    // two points. arenaOk must be m.Geometry.IsEveryIndexInRange.
    IsDiscretizedBoundIn(m: BrepModel, b: FaceBound, d: EdgeDiscretizations, arenaOk: Boolean): Boolean
        => (m.IsLoopIntact(b.Loop) && arenaOk)
            ? m.LoopCoedges(b.Loop).All(c => m.IsEdgeIntact(c.Edge) && d.HasSample(c.Edge, 1))
            : false;

    // IsDiscretizedFace with the arena check's answer given: true when face f is intact and every
    // bound of it is discretized. arenaOk must be m.Geometry.IsEveryIndexInRange.
    IsDiscretizedFaceIn(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, arenaOk: Boolean): Boolean
        => m.IsFaceIntact(f) ? m.Faces[f].Bounds.All(b => m.IsDiscretizedBoundIn(b, d, arenaOk)) : false;
}

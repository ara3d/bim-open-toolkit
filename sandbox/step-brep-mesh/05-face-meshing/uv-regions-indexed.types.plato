//==
// # Face edges with their use counts (complexity sweep chunk F1, TKT-360)
//
// What one sort of a face's coedges by edge gives: each edge the face cites, where it is first
// cited and how often. Two citations make it a seam of the face (layer 02's IsSeamEdgeOf).

// Edge Edge of a face, first cited by the face's coedge at position First (bound order, as
// FaceCoedges lists them), and cited Uses times in all.
// Removes: rebuilding FaceEdges, and rescanning the face's coedges per edge for IsSeamEdgeOf.
type FaceEdgeUse
    implements IValue
{
    Edge: BrepEdgeIndex;
    First: Integer;
    Uses: Integer;
}

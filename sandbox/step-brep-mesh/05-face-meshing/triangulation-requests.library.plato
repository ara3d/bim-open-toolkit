//==
// # Edge requests for triangle quality (TKT-343, not wired yet)
//
// Layer 05-face-meshing. With its boundary fixed, a face cannot always reach a smallest angle:
// a 2 x 4 face with only its corners cannot reach 30 degrees with any interior points
// (TRACK.md, Findings). QualitySegmentRequestsCdt asks layer 8's loop for more segments on the
// edges where it fails. It waits for a later option (a MeshingOptions.QualityAngle, contract
// request in TRACK.md) and is not added to MeshedOutcome's advisory requests: the owner keeps a
// flat rectangle as two triangles (supervisor, 2026-10-18), and step A's boxes keep 8 vertices
// and 12 triangles.

library TriangulationRequests
{
    // The triangles of t with the directed side from point a to point b.
    TrianglesOnSide(t: UvTriangulation, a: Integer, b: Integer): Array<TriangleFace>
        => t.Triangles.FlatMap(x => 3.Range.Any(j => x.Corner(j) == a && x.Corner(j + 1) == b) ? [x] : t.Triangles.Take(0));

    // Whether the triangle of t on boundary segment i of loop k of region r has a lifted corner
    // angle below `angle`.
    SegmentTriangleBelowAngle(m: BrepModel, f: BrepFaceIndex, r: UvRegion, t: UvTriangulation, k: Integer, i: Integer, angle: Angle): Boolean
        => t.TrianglesOnSide(r.LoopOffset(k) + i, r.NextBoundaryPoint(r.LoopOffset(k) + i))
            .Any(x => m.SmallestCornerAngle(f, t, x) < angle.Radians);

    // For triangulation t of region r of face f, one request per edge of f that has a boundary
    // segment whose triangle has a lifted corner angle below `angle`: twice the edge's present
    // segment count, at the present chordal bound (a request about counts only, reason
    // TooCoarseInParameterSpace until a quality reason exists).
    QualitySegmentRequestsCdt(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, t: UvTriangulation, c: FaceMeshingCriteria, angle: Angle): Array<EdgeRefinementRequest>
        => m.FaceEdges(f).FlatMap(e =>
            r.NumberOfLoops.Range.Any(k => r.LoopAt(k).Points.Count.Range.Any(i =>
                r.IsSegmentOn(m, d, e, k, i) ? m.SegmentTriangleBelowAngle(f, r, t, k, i, angle) : false))
                ? [EdgeRefinementRequest(e, RefinementReason.TooCoarseInParameterSpace, c.Discretization.Chordal,
                    2 * (d.ByEdge[e].Points.Count - 1))]
                : EdgeRefinementRequest.NoRequests);
}

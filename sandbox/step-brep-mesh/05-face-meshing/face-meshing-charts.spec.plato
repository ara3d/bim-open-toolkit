//==
// # Face meshing charts: specification
//
// Invariants and constructors of TYPE-CATALOG.md section 8 (SPEC-DSL.md section 3).
// Not compiled. Each invariant names the Law_ that checks it, or says it is an
// obligation of a deferred function.
//
// Sections, in order:
//  - Face meshing

//==
// # Face meshing

spec ConstrainedTriangulation
{
    invariant ConstraintsAreSides(self);   // Law_LoopConstraintsAreSides; Law_OtherDiagonalIsNotASide shows the check can fail
    invariant forall t in self.Triangles: t.A.Value < self.Points.Count && t.B.Value < self.Points.Count && t.C.Value < self.Points.Count;
}

spec Cavity
{
    invariant self.Boundary.Count >= 3 || self.Removed.IsEmpty;   // obligation of the deferred insertion body
}

spec NeighbourTable
{
    invariant forall i in 0..self.Across.Count: self.Across[i].Element.IsPresent
        ? AcrossOf(self, self.Across[i]) == SideAtSlot(i) : true;   // Law_NeighbourTableIsInvolution, Law_NeighbourTableSeesClosure
    constructor NeighbourTableOf;
}

spec DelaunayCertificate
{
    invariant IsConsistent(self);   // Law_DelaunayCertificateIsConsistent
}

spec OrientationOf(a: ChartPoint, b: ChartPoint, c: ChartPoint): Sign
{
    ensures result == Sign.Positive ? TwiceSignedArea(a.ToPoint2D, b.ToPoint2D, c.ToPoint2D) > 0.0 : true;   // Law_OrientationOfAgreesWithLibrarySign
    ensures result == Sign.Negative ? TwiceSignedArea(a.ToPoint2D, b.ToPoint2D, c.ToPoint2D) < 0.0 : true;
    ensures OrientationOf(a, c, b) == result.Negated;                                                        // Law_OrientationIsAntisymmetric
}

spec ElementInChart
{
    invariant self.Orientation == OrientationOf(self.A, self.B, self.C);
    invariant self.Orientation == Sign.Positive ? self.Area > 0.0 : true;   // Law_ElementInChartAreaHasItsOrientation
    constructor ElementInChartOf;
}

spec ElementDeviation
{
    invariant self.Chordal.Value >= 0.0 && self.NormalTurn.Radians >= 0.0 && self.NormalMismatch.Radians >= 0.0;
}

spec Worse(a: ElementDeviation, b: ElementDeviation): ElementDeviation
{
    ensures result.Chordal.Value >= a.Chordal.Value && result.Chordal.Value >= b.Chordal.Value;   // Law_WorseBoundsBoth
}

spec SeamPair { invariant self.Min != self.Max; }   // Law_CopiesAreTheEnds

spec PoleRun { invariant self.Points.Count >= 1; }

spec LiftTable
{
    invariant forall v in 0..LocalVertexCount(self): exists x in self.LocalVertexOf: x.Value == v;   // Law_LiftTableJoinsNothingElse
    constructor LiftTableOf;
}

spec LiftTableOf(pointCount: Integer, pairs: Array<SeamPair>, runs: Array<PoleRun>): LiftTable
{
    requires the pairs and runs are pairwise disjoint;
    ensures forall p in pairs: LocalVertexAt(result, p.Min) == LocalVertexAt(result, p.Max);   // Law_LiftTableJoinsSeamPairsAndPoles
    ensures forall r in runs: forall q in r.Points: LocalVertexAt(result, q) == LocalVertexAt(result, r.Points[0]);
    ensures LocalVertexCount(result) == pointCount - pairs.Count - SumOf(runs, r => r.Points.Count - 1);   // Law_LiftTableJoinsNothingElse
}

spec QuadGridSides
{
    invariant IsStructured(self);   // Law_QuadGridSidesRoundTrip
    constructor QuadGridSidesOf;
}

spec GridCounts { constructor GridCountsOf; }


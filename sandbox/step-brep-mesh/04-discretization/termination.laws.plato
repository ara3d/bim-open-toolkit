//==
// # TermLaws
//
// Track "termination" (TKT-346). Discretize and RefineEdge return
// on every input, within SegmentBound, and an edge off its face's surface
// is reported instead of hanging. A law cannot state termination by
// itself; the runner's --budget does: a law over a call that does not
// return is an error at the budget.
//
// The model selector k of TermOffSurfaceCube: 0 sphere, 1 cylinder, 2 torus
// in place of plane #118; every other k is the consistent unit box.
//
// Sections, in order:
//  - Termination on the repro
//  - The segment bound
//  - Findings
//  - Nothing changes on consistent models
//  - The whole mesh

library TermLaws
{
    //==
    // # Termination on the repro

    // Layer 4's Discretize returns on edge 3 of the repro, within the
    // segment bound. Before the bounded versions (TKT-346): no answer
    // within the budget (the hang of the C# finding).
    Law_DiscretizeReturnsOnOffSurfaceEdge(k: Integer): Boolean
    {
        if (k < 0 || k > 2)
        {
            return true;
        }
        var m = BrepModel.TermOffSurfaceCube(k);
        var c = DiscretizationCriteria.TermFindingCriteria;
        var d = m.Discretize(BrepEdgeIndex(3), c, SegmentFloors.NoFloors);
        return m.IsEvaluable(d) && d.SegmentCount <= m.SegmentBound(d, c, m.MinimumSegmentCount(BrepEdgeIndex(3), c, SegmentFloors.NoFloors));
    }

    // DiscretizeBounded returns on edge 3 of the repro: the edge lies on its
    // bottom face, so one segment of a line meets every test there, and the
    // off-surface face is left out.
    Law_BoundedDiscretizeReturnsOnOffSurfaceEdge(k: Integer): Boolean
    {
        if (k < 0 || k > 2)
        {
            return true;
        }
        var m = BrepModel.TermOffSurfaceCube(k);
        var c = DiscretizationCriteria.TermFindingCriteria;
        var d = m.DiscretizeBounded(BrepEdgeIndex(3), c, SegmentFloors.NoFloors);
        return m.IsEvaluable(d) && d.SegmentCount == 1;
    }

    // Layer 4's RefineEdge returns on edge 3 of the repro asked for 8
    // segments, within the bound. The unbounded form bisected for the image
    // it can never meet down to the length floor.
    Law_RefineEdgeReturnsOnOffSurfaceEdge(k: Integer): Boolean
    {
        if (k < 0 || k > 2)
        {
            return true;
        }
        var m = BrepModel.TermOffSurfaceCube(k);
        var c = DiscretizationCriteria.TermFindingCriteria;
        var start = m.DiscretizeBounded(BrepEdgeIndex(3), c, SegmentFloors.NoFloors);
        var d = m.RefineEdge(start, c, 8);
        return m.IsEvaluable(d) && d.SegmentCount <= m.SegmentBound(d, c, 8);
    }

    // RefineEdgeBounded returns on edge 3 of the repro asked for 8 segments:
    // exactly 8, since nothing it tests fails.
    Law_BoundedRefineReturnsOnOffSurfaceEdge(k: Integer): Boolean
    {
        if (k < 0 || k > 2)
        {
            return true;
        }
        var m = BrepModel.TermOffSurfaceCube(k);
        var c = DiscretizationCriteria.TermFindingCriteria;
        var d = m.RefineEdgeBounded(m.DiscretizeBounded(BrepEdgeIndex(3), c, SegmentFloors.NoFloors), c, 8);
        return m.IsEvaluable(d) && d.SegmentCount == 8;
    }

    // With the off-surface image kept in the test, the raise cannot pass:
    // the searched raise ends at the cap the minimum length gives (1000 for
    // the 1 mm line at DefaultCriteria(0.01)), within the bound, and the
    // edge is reported DISCRETIZE-NOT-CONVERGED. Layer 4's linear raise
    // would make 1000 uniform splits of up to 1000 segments each.
    Law_RaiseSearchEndsAtCap(k: Integer): Boolean
    {
        if (k < 0 || k > 2)
        {
            return true;
        }
        var m = BrepModel.TermOffSurfaceCube(k);
        var e = BrepEdgeIndex(3);
        var c = DefaultCriteria(0.01);
        var all = m.EdgeImages(e);
        var d = m.DiscretizeBoundedOn(e, c, SegmentFloors.NoFloors, all);
        var least = m.MinimumSegmentCount(e, c, SegmentFloors.NoFloors);
        return m.IsEvaluable(d)
            && d.SegmentCount == m.ConicSegmentCap(e, c, least)
            && d.SegmentCount <= m.SegmentBound(d, c, least)
            && m.EdgeFindingsOn(d, c, all).Any(x => x.Code == "DISCRETIZE-NOT-CONVERGED" && x.Where == Provenance.KernelEdge(e));
    }

    //==
    // # The segment bound

    // Every edge of every repro cube and of the consistent box discretizes,
    // bounded, within SegmentBound. e out of range: vacuous.
    Law_BoundedDiscretizeWithinSegmentBound(k: Integer, e: Integer): Boolean
    {
        var m = BrepModel.TermOffSurfaceCube(k.Max(0).Min(3));
        if (e < 0 || e >= m.Edges.Count || k < 0 || k > 3)
        {
            return true;
        }
        var c = DiscretizationCriteria.TermFindingCriteria;
        var d = m.DiscretizeBounded(BrepEdgeIndex(e), c, SegmentFloors.NoFloors);
        return m.IsEvaluable(d) && d.SegmentCount <= m.SegmentBound(d, c, m.MinimumSegmentCount(BrepEdgeIndex(e), c, SegmentFloors.NoFloors));
    }

    //==
    // # Findings

    // The repro's table reports edge 3 off the surface, and every finding
    // it makes is an off-surface finding at one of face 5's four edges (3,
    // 7, 8, 11); the consistent box gives none.
    Law_OffSurfaceEdgeIsDiagnosed(k: Integer): Boolean
    {
        if (k < 0 || k > 3)
        {
            return true;
        }
        var m = BrepModel.TermOffSurfaceCube(k);
        var c = DiscretizationCriteria.TermFindingCriteria;
        var findings = m.DiscretizationFindings(m.DiscretizeAllBounded(c, SegmentFloors.NoFloors), c);
        return k == 3
            ? findings.Count == 0
            : findings.Any(x => x.Code == "DISCRETIZE-EDGE-OFF-SURFACE" && x.Where == Provenance.KernelEdge(BrepEdgeIndex(3)))
                && findings.All(x => x.Code == "DISCRETIZE-EDGE-OFF-SURFACE"
                    && (x.Where == Provenance.KernelEdge(BrepEdgeIndex(3)) || x.Where == Provenance.KernelEdge(BrepEdgeIndex(7))
                        || x.Where == Provenance.KernelEdge(BrepEdgeIndex(8)) || x.Where == Provenance.KernelEdge(BrepEdgeIndex(11))));
    }

    //==
    // # Nothing changes on consistent models

    // On models whose edges lie on their faces, DiscretizeBounded gives
    // layer 4's Discretize bit for bit: k 0 the 1 mm unit box at the
    // finding's criteria, k 1 layer 7's cylinder (radius 1 m, height 1 m,
    // seam and two circles) at DefaultCriteria(0.001). e out of range:
    // vacuous.
    Law_BoundedAgreesOnConsistentModels(k: Integer, e: Integer): Boolean
    {
        if (k < 0 || k > 1)
        {
            return true;
        }
        var m = k == 0 ? BrepModel.TermOffSurfaceCube(3) : BrepModel.Witness_Cylinder;
        var c = k == 0 ? DiscretizationCriteria.TermFindingCriteria : DefaultCriteria(0.001);
        if (e < 0 || e >= m.Edges.Count)
        {
            return true;
        }
        var edge = BrepEdgeIndex(e);
        return m.CanDiscretize(edge, c)
            ? m.DiscretizeBounded(edge, c, SegmentFloors.NoFloors).SameDiscretization(m.Discretize(edge, c, SegmentFloors.NoFloors))
            : true;
    }

    //==
    // # The whole mesh

    // The cylinder repro meshes and reports edge 3 off its surface instead
    // of hanging. Holds through Discretize, RefineEdge and layer 8's
    // LoopReport; the unbounded loop gave no answer within the budget. The cylinder is chosen because its face has
    // no pole, so the check does not wait on track C. Only k = 1 meshes;
    // every other k is vacuous, so the runner meshes once.
    Law_OffSurfaceCubeMeshReports(k: Integer): Boolean
    {
        if (k != 1)
        {
            return true;
        }
        var outcome = BrepModel.TermOffSurfaceCube(1).MeshModel(DefaultMeshingOptions(0.001));
        return outcome.Report.Diagnostics.Any(x => x.Code == "DISCRETIZE-EDGE-OFF-SURFACE" && x.Where == Provenance.KernelEdge(BrepEdgeIndex(3)));
    }
}

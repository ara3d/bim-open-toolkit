//==
// # Discretization requests: laws (TYPE-CATALOG.md section 7)
//
// The runner cannot build an array, so laws over request lists take Integer selectors and build
// the list inside the body (MeshingRequestsAt): up to eight requests over three edges, with
// repeated edges, ties, and every reason.
//
// Sections, in order:
//  - Helpers
//  - Chords and criteria
//  - Density
//  - Requests and deltas

library EdgeDiscretizingRequestsLaws
{
    //==
    // # Helpers

    // k reduced into 0 to n - 1, for any Integer k and n > 0.
    MeshingWrap(k: Integer, n: Integer): Integer
        => ((k % n) + n) % n;

    // The reason chosen by k.
    MeshingReasonAt(k: Integer): RefinementReason
        => MeshingWrap(k, 3) == 0
            ? RefinementReason.LoopSelfIntersects
            : (MeshingWrap(k, 3) == 1 ? RefinementReason.TooCoarseInParameterSpace : RefinementReason.QuadCountMismatch);

    // A list of n mod 9 requests over edges 0 to 2, varied by k.
    MeshingRequestsAt(k: Integer, n: Integer): Array<EdgeRefinementRequest>
        => MeshingWrap(n, 9).Range.Map(i => EdgeRefinementRequest(
            BrepEdgeIndex(MeshingWrap(i * k + i / 2, 3)),
            MeshingReasonAt(i + k),
            (MeshingWrap(i * 5 + k, 7) + 1).ToNumber * 0.125,
            MeshingWrap(i * 3 + k, 5)));

    // Whether a and b are the same request: equal edges, reasons, and counts, and chordal bounds
    // equal to rounding.
    MeshingSameRequest(a: EdgeRefinementRequest, b: EdgeRefinementRequest): Boolean
        => a.Edge == b.Edge && a.Reason == b.Reason && a.Segments == b.Segments
            && CatalogAgreesToRounding(a.Chordal, b.Chordal);

    // Whether two request lists are the same, element by element.
    MeshingSameRequests(a: Array<EdgeRefinementRequest>, b: Array<EdgeRefinementRequest>): Boolean
        => a.Count == b.Count ? a.Count.Range.All(i => MeshingSameRequest(a[i], b[i])) : false;

    //==
    // # Chords and criteria

    // The chords of n segments are n consecutive chords of a polyline of n + 1 samples.
    Law_ChordsOfAreConsecutive(n: Integer): Boolean
        => ChordsOf(SegmentCountOf(n)).Count == SegmentCountOf(n).Value
            && ChordsOf(SegmentCountOf(n)).All(c => IsChordOf(c, SegmentCountOf(n).Value + 1));

    // A length verdict holds exactly when the worst length is no larger than the bound.
    Law_VerdictHoldsIffWithin(worst: Number, bound: Number): Boolean
        => VerdictOf(CriterionName.ChordalCriterion, ModelLength(worst).ToMeasure, ModelLength(bound).ToMeasure).Holds == (worst <= bound);

    // A length is never judged against an angle bound.
    Law_VerdictAcrossKindsFails(worst: Number, bound: Number): Boolean
        => VerdictOf(CriterionName.AngularCriterion, ModelLength(worst).ToMeasure, Angle(bound).ToMeasure).Holds.Not;

    //==
    // # Density

    // A density asks for at least one segment.
    Law_SegmentsForIsAtLeastOne(rate: Number, length: Number): Boolean
        => SegmentsFor(SegmentDensity(rate), ModelLength(length)).Value >= 1;

    // A positive density covers the length: segments at least rate times length.
    Law_SegmentsForCoversLength(rate: Number, length: Number): Boolean
        => (rate > 0.0 && length > 0.0)
            ? SegmentsFor(SegmentDensity(rate), ModelLength(length)).Value.ToNumber >= rate * length
            : true;

    //==
    // # Requests and deltas

    // Merging a merged set changes nothing.
    Law_MergeRequestsIsIdempotent(k: Integer, n: Integer): Boolean
        => MeshingSameRequests(
            MergeRequests(MergeRequests(MeshingRequestsAt(k, n)).ByEdge).ByEdge,
            MergeRequests(MeshingRequestsAt(k, n)).ByEdge);

    // The merged set holds one request per requested edge, sorted by edge.
    Law_MergeRequestsIsOnePerEdge(k: Integer, n: Integer): Boolean
    {
        var s = MergeRequests(MeshingRequestsAt(k, n)).ByEdge;
        return s.Count == RequestedEdges(MeshingRequestsAt(k, n)).Count
            && s.Count.Range.All(i => i == 0 ? true : s[i - 1].Edge.Value < s[i].Edge.Value);
    }

    // For every request, the merged request on its edge is at least as strong: no larger
    // Chordal, no smaller Segments.
    Law_MergeRequestsKeepsStrongest(k: Integer, n: Integer): Boolean
    {
        var xs = MeshingRequestsAt(k, n);
        var s = MergeRequests(xs);
        return xs.All(r => RequestFor(s, r.Edge).Count == 1
            ? RequestFor(s, r.Edge)[0].Chordal <= r.Chordal && RequestFor(s, r.Edge)[0].Segments >= r.Segments
            : false);
    }

    // The merged request on an edge takes its Chordal and its Segments from requests on that
    // edge: merging invents no bound.
    Law_MergeRequestsInventsNothing(k: Integer, n: Integer): Boolean
    {
        var xs = MeshingRequestsAt(k, n);
        return MergeRequests(xs).ByEdge.All(m =>
            RequestsOn(xs, m.Edge).Any(r => CatalogAgreesToRounding(r.Chordal, m.Chordal))
            && RequestsOn(xs, m.Edge).Any(r => r.Segments == m.Segments));
    }

    // The delta of a merged set names every requested edge.
    Law_DeltaNamesEveryRequestedEdge(k: Integer, n: Integer): Boolean
    {
        var xs = MeshingRequestsAt(k, n);
        var d = DeltaOf(MergeRequests(xs));
        return xs.All(r => d.IsChanged(r.Edge)) && d.Changed.Count == RequestedEdges(xs).Count;
    }
}

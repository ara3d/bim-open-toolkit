//==
// # Counted forms of edge discretization (complexity sweep)
//
// The first counted form of the testing strategy (docs/plans/step-mesher-complexity.md,
// part b): a function returns its value beside the work it counted. RaisedToCountCounted
// counts its raises (as Flips: one per inserted midpoint), which is linear in the segments
// asked for; chunk R6 replaces its body with a heap and counts the elements it copies as
// Insertions. The plain RaisedToCount is unchanged until then.
//
// Sections, in order:
//  - Raising a parameter list

library EdgeDiscretizingWork
{
    //==
    // # Raising a parameter list

    // RaisedToCount with its raises counted: the same parameters, and Flips equal
    // to the number of midpoints inserted (least - (parameters.Count - 1), or zero).
    RaisedToCountCounted(m: BrepModel, parameters: Array<Number>, least: Integer): Counted<Array<Number>>
    {
        var ts = parameters;
        var raises = 0;
        while (ts.Count - 1 < least)
        {
            var widest = (ts.Count - 1).Range.Reduce(0, (w, i) => ts[i + 1] - ts[i] > ts[w + 1] - ts[w] ? i : w);
            ts = ts.Take(widest + 1).Concatenate([(ts[widest] + ts[widest + 1]) * 0.5]).Concatenate(ts.Skip(widest + 1));
            raises = raises + 1;
        }
        return Counted(ts, Flips(raises));
    }
}

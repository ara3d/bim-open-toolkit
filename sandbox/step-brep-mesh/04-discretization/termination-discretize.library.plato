//==
// # TermDiscretize
//
// Track "termination" (TKT-346). Layer 4's Discretize and
// RefineEdge, bounded. Two defects made an edge that does not lie on a face
// it bounds (an inconsistent file) hang the mesher:
//
// 1. RaisedForImages raised a line's or a conic's uniform count one segment
//    at a time, testing every image chord of every count, up to the cap the
//    minimum length allows (the edge's length over it). When no count can
//    meet the image test, that is cap(cap + 1) / 2 segment tests: 5 x 10^7
//    for a 1 mm line at DefaultCriteria(0.001).
// 2. Nothing noticed that the image test cannot be met. A segment's image
//    chord deviation is measured at its interior samples, which approach
//    the segment's end points as it shrinks, so the deviation tends to the
//    gap between a polyline point and the surface at its image parameters.
//    Where that gap exceeds the image bound, no refinement passes, and
//    bisection or the raise went on to the length floor everywhere.
//
// The bounded versions: the raise doubles the count and then bisects
// between the last failing and the first passing count, at most
// 2 log2(cap) + 2 tests of at most cap segments each; an image the edge
// does not lie on (IsOffSurface) is left out of every refinement test and
// reported (DISCRETIZE-EDGE-OFF-SURFACE); a segment stopped by the length
// floor with a criterion still failing is reported
// (DISCRETIZE-NOT-CONVERGED). Every result keeps SegmentBound: at most one
// segment per seed span, plus the requested count, plus the polyline's
// length over the effective minimum length, because every segment that a
// split made has a chord at least that long.
//
// Sections, in order:
//  - Images the edge lies on
//  - Tests over a set of images
//  - Discretize, bounded
//  - RefineEdge, bounded
//  - The bound
//  - The table and its findings

library TermDiscretize
{
    //==
    // # Images the edge lies on

    // The image bound of Law_ImageChordWithinChordal: the effective chordal
    // bound widened by twice the length tolerance.
    ImageBound(m: BrepModel, c: DiscretizationCriteria): Number
        => c.EffectiveChordal(m.Tolerances) + 2.0 * m.Tolerances.Length.Value;

    // The largest distance from a polyline point of d to the surface of
    // image img at that point's image parameters (clamped into the
    // surface's domain, as UvChordDeviation evaluates): at most about the
    // length tolerance for an edge on the face's surface, through its
    // pcurve or by Project. 0 when the image has not one point per polyline
    // point.
    ImageGap(m: BrepModel, d: EdgeDiscretization, img: EdgeImage): Number
    {
        var uvs = m.ImagePoints(d, img);
        var s = m.ImageSurface(img);
        var dom = m.Geometry.Domain(s);
        return uvs.Count == d.Points.Count
            ? d.Points.Count.Range.Reduce(0.0, (worst, i) => worst.Max(d.Points[i].Distance(m.Geometry.Eval(s, dom.ClampToDomain(uvs[i])))))
            : 0.0;
    }

    // The three-point polyline of edge e at the start, the middle and the
    // end of its domain: what IsOffSurface probes, the same for every
    // criteria, so the decision does not depend on how far refinement went.
    GapProbe(m: BrepModel, e: BrepEdgeIndex): EdgeDiscretization
        => m.DiscretizationAt(e, m.EdgeDomain(e).Range.Samples(3));

    // True when edge e does not lie on the surface of image img: a probe
    // point is farther from it than the image bound, so no segment beside
    // that point can meet the image test however short it is.
    IsOffSurface(m: BrepModel, e: BrepEdgeIndex, img: EdgeImage, c: DiscretizationCriteria): Boolean
        => m.IsImageEvaluable(img) ? m.ImageGap(m.GapProbe(e), img) > m.ImageBound(c) : false;

    // The images of edge e that refinement tests: the evaluable ones the
    // edge lies on.
    UsableImages(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria): Array<EdgeImage>
    {
        var all = m.EdgeImages(e);
        return all.FlatMap(img => (m.IsImageEvaluable(img) ? m.IsOffSurface(e, img, c).Not : false) ? [img] : all.Take(0));
    }

    //==
    // # Tests over a set of images
    //
    // Layer 4's tests with the images they read as a parameter. Layer 4's
    // own forms read every image of the edge (EdgeImages).

    // Whether some image chord of d, on one of the images, exceeds the image
    // bound. Non-evaluable images are skipped.
    ImagesExceedChordalOn(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, images: Array<EdgeImage>): Boolean
        => images.Any(img => m.IsImageEvaluable(img)
            ? m.ImageChordDeviations(d, img, SamplePlan.DiscretizationPlan).Any(x => x > m.ImageBound(c))
            : false);

    // Layer 4's SegmentFails with the image test over the given images.
    SegmentFailsOn(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, a: Number, b: Number, images: Array<EdgeImage>): Boolean
    {
        var piece = m.PieceOf(e, a, b);
        return m.Sagitta(e, a, b) > c.EffectiveChordal(m.Tolerances)
            || m.TangentDeviation(piece, SamplePlan.DiscretizationPlan, 0) > c.EffectiveAngular * 0.5
            || piece.SegmentLength(0).IsWithinLimit(c.MaxLength).Not
            || m.ImagesExceedChordalOn(piece, c, images);
    }

    // Layer 4's SegmentMeetsCriteria with the image law over the given
    // images: each criterion widened as in its law or escaped at the length
    // floor.
    SegmentMeetsCriteriaOn(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, i: Integer, images: Array<EdgeImage>): Boolean
        => m.Law_CertifiedSagittaWithinChordal(d, c, i)
            && m.Law_TangentDeviationWithinHalfAngular(d, c, SamplePlan.DiscretizationPlan, i)
            && m.Law_SegmentWithinMaxLength(d, c, i)
            && images.All(img => m.Law_ImageChordWithinChordal(d, c, img, SamplePlan.DiscretizationPlan, i));

    //==
    // # Discretize, bounded

    // Discretize with the images the edge lies on: what layer 4's
    // Discretize is.
    DiscretizeBounded(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors): EdgeDiscretization
        => m.DiscretizeBoundedOn(e, c, floors, m.UsableImages(e, c));

    // Layer 4's Discretize with its image tests over the given images and
    // the raise searched (RaisedForImagesBounded): a degenerate edge gets its
    // two domain ends; a line, circle or ellipse its closed-form count raised
    // while an image chord fails, up to the cap; every other curve is
    // bisected seed span by seed span, then raised to MinimumSegmentCount.
    DiscretizeBoundedOn(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors, images: Array<EdgeImage>): EdgeDiscretization
    {
        var range = m.EdgeDomain(e).Range;
        var least = m.MinimumSegmentCount(e, c, floors);
        var conic = m.ConicSegmentCount(e, c, least);
        var parameters = m.IsDegenerateEdge(e)
            ? [range.Start, range.End]
            : (conic > 0
                ? range.Samples(m.RaisedForImagesBounded(e, c, conic, m.ConicSegmentCap(e, c, least), images) + 1)
                : m.RaisedToCount(m.BisectedParametersOn(e, c, images), least));
        return m.DiscretizationAt(e, parameters);
    }

    // Whether some image chord of the uniform split of edge e into count
    // segments exceeds the image bound, on the given images.
    UniformExceeds(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, count: Integer, images: Array<EdgeImage>): Boolean
        => m.ImagesExceedChordalOn(m.DiscretizationAt(e, m.EdgeDomain(e).Range.Samples(count + 1)), c, images);

    // The uniform count, from n up to cap, that the image test asks for:
    // n when n passes; otherwise the count doubles (never past cap) while it
    // fails, and then bisection between the last failing and the first
    // passing count finds a passing count at most one above a failing one.
    // cap when no count up to cap passes. When the test is monotone in the
    // count (it is for one image chord that shrinks as the segments do),
    // this is the least passing count, layer 4's linear answer; it takes at
    // most 2 log2(cap / n) + 2 tests instead of cap - n.
    RaisedForImagesBounded(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, n: Integer, cap: Integer, images: Array<EdgeImage>): Integer
    {
        if (n >= cap || m.UniformExceeds(e, c, n, images).Not)
        {
            return n;
        }
        var failing = n;
        var trial = (2 * n).Min(cap);
        var passes = m.UniformExceeds(e, c, trial, images).Not;
        while (passes.Not && trial < cap)
        {
            failing = trial;
            trial = (2 * trial).Min(cap);
            passes = m.UniformExceeds(e, c, trial, images).Not;
        }
        if (passes.Not)
        {
            return cap;
        }
        var passing = trial;
        while (passing - failing > 1)
        {
            var middle = (failing + passing) / 2;
            if (m.UniformExceeds(e, c, middle, images))
            {
                failing = middle;
            }
            else
            {
                passing = middle;
            }
        }
        return passing;
    }

    // Layer 4's BisectedParameters with the image test over the given
    // images.
    BisectedParametersOn(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, images: Array<EdgeImage>): Array<Number>
    {
        var seeds = m.EdgeSeeds(e);
        return [seeds[0]].Concatenate((seeds.Count - 1).Range.FlatMap(k =>
            m.SplitSpanOn(e, c, seeds[k], seeds[k + 1], 0, images).Concatenate([seeds[k + 1]])));
    }

    // Layer 4's SplitSpan with the image test over the given images: the
    // midpoint and both halves' own while the segment fails and both halves
    // keep the effective minimum length, to depth 40.
    SplitSpanOn(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, a: Number, b: Number, depth: Integer, images: Array<EdgeImage>): Array<Number>
        => (depth < 40 ? (m.SegmentFailsOn(e, c, a, b, images) ? m.HalvesKeepMinLength(e, c, a, b) : false) : false)
            ? m.SplitSpanOn(e, c, a, (a + b) * 0.5, depth + 1, images)
                .Concatenate([(a + b) * 0.5])
                .Concatenate(m.SplitSpanOn(e, c, (a + b) * 0.5, b, depth + 1, images))
            : [a].Take(0);

    //==
    // # RefineEdge, bounded

    // RefineEdge with the images the edge lies on: what layer 4's
    // RefineEdge is.
    RefineEdgeBounded(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, segments: Integer): EdgeDiscretization
        => m.RefineEdgeBoundedOn(d, c, segments, m.UsableImages(d.Edge, c));

    // Layer 4's RefineEdge with its test over the given images: every
    // failing segment bisected while its pieces fail (the floor is inside
    // the test), then raised to segments.
    RefineEdgeBoundedOn(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, segments: Integer, images: Array<EdgeImage>): EdgeDiscretization
        => m.IsDegenerateEdge(d.Edge)
            ? d
            : m.DiscretizationAt(d.Edge, m.RaisedToCount(m.RefinedParametersOn(d, c, images), segments));

    // Layer 4's RefinedParameters over the given images.
    RefinedParametersOn(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, images: Array<EdgeImage>): Array<Number>
        => [d.Parameters[0]].Concatenate(d.SegmentCount.Range.FlatMap(i =>
            (m.SegmentMeetsCriteriaOn(d, c, i, images)
                ? [d.Parameters[i]].Take(0)
                : m.RefinedSpanOn(d.Edge, c, d.Parameters[i], d.Parameters[i + 1], 0, images))
            .Concatenate([d.Parameters[i + 1]])));

    // Layer 4's RefinedSpan over the given images.
    RefinedSpanOn(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, a: Number, b: Number, depth: Integer, images: Array<EdgeImage>): Array<Number>
        => depth < 40
            ? m.RefinedHalfOn(e, c, a, (a + b) * 0.5, depth + 1, images)
                .Concatenate([(a + b) * 0.5])
                .Concatenate(m.RefinedHalfOn(e, c, (a + b) * 0.5, b, depth + 1, images))
            : [a].Take(0);

    // Layer 4's RefinedHalf over the given images.
    RefinedHalfOn(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, a: Number, b: Number, depth: Integer, images: Array<EdgeImage>): Array<Number>
        => m.SegmentMeetsCriteriaOn(m.PieceOf(e, a, b), c, 0, images) ? [a].Take(0) : m.RefinedSpanOn(e, c, a, b, depth, images);

    //==
    // # The bound

    // The length of d's polyline: the sum of its chords.
    PolylineLength(d: EdgeDiscretization): Number
        => d.SegmentCount.Range.Reduce(0.0, (total, i) => total + d.SegmentLength(i));

    // The most segments a bounded discretization of d's edge can have, with
    // least the count asked for (MinimumSegmentCount, a floor, a request):
    // one per seed span that was never split, plus least, plus the
    // polyline's length over the effective minimum length, since a segment
    // a split made has a chord at least that long (the split needs both
    // halves so) and a uniform count never exceeds the cap the minimum
    // length gives. Derived from the tolerance (through the minimum length)
    // and the edge's length only.
    SegmentBound(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, least: Integer): Integer
        => (m.EdgeSeeds(d.Edge).Count - 1) + least + (d.PolylineLength / c.EffectiveMinLength(m.Tolerances)).Ceiling.ToInteger;

    //==
    // # The table and its findings

    // Layer 4's DiscretizeAll with DiscretizeBounded: the table the pipeline
    // builds once the library's Discretize is wired to it.
    DiscretizeAllBounded(m: BrepModel, c: DiscretizationCriteria, floors: SegmentFloors): EdgeDiscretizations
        => EdgeDiscretizations(m.Edges.Count.MapRange(i =>
            m.CanDiscretize(BrepEdgeIndex(i), c) ? m.DiscretizeBounded(BrepEdgeIndex(i), c, floors) : Undiscretized(BrepEdgeIndex(i))));

    // Edge e does not lie on the surface of a face that uses it. Measure:
    // the largest probe gap.
    OffSurfaceEdge(e: BrepEdgeIndex, gap: Number): Diagnostic
        => Diagnostic(Severity.Warning, "DISCRETIZE-EDGE-OFF-SURFACE",
            "This edge does not lie on the surface of a face that uses it: a point of the edge is farther from that surface than the chordal bound, so no refinement can meet the parameter-space chord test there. That face's image is left out of the edge's refinement, and the face's mesh may not meet the edge. Measure is the largest distance found.",
            Provenance.KernelEdge(e), gap);

    // Refinement of edge e stopped at the length floor with a criterion
    // still failing. Measure: the failing segments.
    NotConvergedEdge(e: BrepEdgeIndex, failing: Integer): Diagnostic
        => Diagnostic(Severity.Warning, "DISCRETIZE-NOT-CONVERGED",
            "Refinement of this edge stopped at the minimum segment length with a criterion still failing; the polyline is kept as made. Measure is the number of segments that fail.",
            Provenance.KernelEdge(e), failing.ToNumber);

    // The findings of one canonical discretization: one off-surface finding
    // per image of its edge the edge does not lie on, then one
    // not-converged finding when some segment at the length floor still
    // fails a criterion on the given images. None for an Undiscretized
    // entry, which layer 8's PIPELINE-EDGE-UNDISCRETIZED reports.
    EdgeFindingsOn(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, images: Array<EdgeImage>): Array<Diagnostic>
    {
        if (m.IsEvaluable(d).Not)
        {
            return Diagnostic.NoDiagnostics;
        }
        var probe = m.GapProbe(d.Edge);
        var offSurface = m.EdgeImages(d.Edge).FlatMap(img => m.IsOffSurface(d.Edge, img, c)
            ? [OffSurfaceEdge(d.Edge, m.ImageGap(probe, img))]
            : Diagnostic.NoDiagnostics);
        var failing = d.SegmentCount.Range.Reduce(0, (n, i) =>
            (m.IsAtLengthFloor(d, c, i) ? m.SegmentFailsOn(d.Edge, c, d.Parameters[i], d.Parameters[i + 1], images) : false) ? n + 1 : n);
        return failing > 0 ? offSurface.Concatenate([NotConvergedEdge(d.Edge, failing)]) : offSurface;
    }

    // The findings of every entry of the table, over the images each edge
    // lies on: what layer 8 adds to its report.
    DiscretizationFindings(m: BrepModel, ds: EdgeDiscretizations, c: DiscretizationCriteria): Array<Diagnostic>
        => ds.ByEdge.FlatMap(d => m.EdgeFindingsOn(d, c, m.UsableImages(d.Edge, c)));
}

//==
// # Discretization requests: constructors and predicates (TYPE-CATALOG.md section 7)
//
// Sections, in order:
//  - Chords and arcs
//  - Criteria
//  - Density
//  - Requests and deltas

library EdgeDiscretizingRequests
{
    //==
    // # Chords and arcs

    // The chord leaving sample k: from k to k + 1.
    ChordOf(k: EdgeSampleIndex): Chord
        => Chord(k, EdgeSampleIndex(k.Value + 1));

    // The n chords of a polyline of n segments, in order.
    ChordsOf(n: SegmentCount): Array<Chord>
        => n.Value.MapRange(k => ChordOf(EdgeSampleIndex(k)));

    // Whether c joins two consecutive samples of a polyline with sampleCount samples.
    IsChordOf(c: Chord, sampleCount: Integer): Boolean
        => c.From.Value >= 0 && c.To.Value == c.From.Value + 1 && c.To.Value < sampleCount;

    // The arc chord c replaces, in d's curve parameter. Requires IsChordOf(c, d.Parameters.Count);
    // outside it, the empty range at 0.
    ArcOf(d: EdgeDiscretization, c: Chord): Arc
        => IsChordOf(c, d.Parameters.Count)
            ? Arc(RangeOf(d.Parameters[c.From.Value], d.Parameters[c.To.Value]))
            : Arc(RangeOf(0.0, 0.0));

    //==
    // # Criteria

    // The verdict of criterion c: Holds exactly when worst is within bound (same kind, no larger).
    VerdictOf(c: CriterionName, worst: Measure, bound: Measure): CriterionVerdict
        => CriterionVerdict(c, worst, bound, IsWithin(worst, bound));

    // The chordal verdict of one chord's measures under a chordal bound.
    ChordalVerdict(m: ChordMeasures, bound: ModelLength): CriterionVerdict
        => VerdictOf(CriterionName.ChordalCriterion, m.Sagitta.ToMeasure, bound.ToMeasure);

    // The angular verdict of one chord's measures: its turn against the angular bound.
    AngularVerdict(m: ChordMeasures, bound: Angle): CriterionVerdict
        => VerdictOf(CriterionName.AngularCriterion, m.Turn.ToMeasure, bound.ToMeasure);

    //==
    // # Density

    // The segment count density d asks for over a length: the ceiling of rate times length, at
    // least one.
    SegmentsFor(d: SegmentDensity, length: ModelLength): SegmentCount
        => SegmentCountOf((d.SegmentsPerUnitLength * length.Value).Ceiling.ToInteger);

    // The density f asks for on edge e, or fallback when f has no entry for e.
    DensityAt(f: DensityField, e: BrepEdgeIndex, fallback: SegmentDensity): SegmentDensity
        => f.ByEdge.IsValidIndex(e) ? f.ByEdge[e] : fallback;

    //==
    // # Requests and deltas

    // The name of a refinement reason, for diffs and laws that match on the case.
    ReasonName(r: RefinementReason): String
        => match (r) {
            LoopSelfIntersects => "LoopSelfIntersects";
            TooCoarseInParameterSpace => "TooCoarseInParameterSpace";
            QuadCountMismatch => "QuadCountMismatch";
            NoInteriorPointMeetsChordal(c) => "NoInteriorPointMeetsChordal";
            PoleAdjacency => "PoleAdjacency";
            NeighbourDensity => "NeighbourDensity";
        };

    // The stronger union of two requests on one edge: the smaller Chordal with its Reason (a on a
    // tie), the larger Segments.
    Strongest(a: EdgeRefinementRequest, b: EdgeRefinementRequest): EdgeRefinementRequest
        => EdgeRefinementRequest(
            a.Edge,
            b.Chordal < a.Chordal ? b.Reason : a.Reason,
            a.Chordal.Min(b.Chordal),
            a.Segments.Max(b.Segments));

    // The requests of xs on edge e.
    RequestsOn(xs: Array<EdgeRefinementRequest>, e: BrepEdgeIndex): Array<EdgeRefinementRequest>
        => xs.FlatMap(r => r.Edge == e ? [r] : xs.Take(0));

    // The edges xs requests, sorted, without repeats.
    RequestedEdges(xs: Array<EdgeRefinementRequest>): Array<BrepEdgeIndex>
    {
        var sorted = xs.Map(r => r.Edge).Sort((a, b) => a.Value <= b.Value);
        return sorted.Count.MapRange(k => k)
            .FlatMap(k => (k == 0 ? true : sorted[k - 1] != sorted[k]) ? [sorted[k]] : sorted.Take(0));
    }

    // One request per requested edge, sorted by edge, each the Strongest fold of that edge's
    // requests in input order.
    MergeRequests(xs: Array<EdgeRefinementRequest>): RequestSet
        => RequestSet(RequestedEdges(xs).Map(e => MergedOn(RequestsOn(xs, e))));

    // The Strongest fold of a non-empty array of requests on one edge, in order.
    MergedOn(on: Array<EdgeRefinementRequest>): EdgeRefinementRequest
        => on.Skip(1).Reduce(on[0], (acc, r) => Strongest(acc, r));

    // The request s holds for edge e, if any, as a one-element or empty array.
    RequestFor(s: RequestSet, e: BrepEdgeIndex): Array<EdgeRefinementRequest>
        => RequestsOn(s.ByEdge, e);

    // The edges a refinement under s changes.
    DeltaOf(s: RequestSet): DiscretizationDelta
        => DiscretizationDelta(s.ByEdge.Map(r => r.Edge));

    // Whether d names edge e.
    IsChanged(d: DiscretizationDelta, e: BrepEdgeIndex): Boolean
        => d.Changed.Any(x => x == e);
}

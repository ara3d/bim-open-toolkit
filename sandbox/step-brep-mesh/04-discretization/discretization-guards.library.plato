//==
// # Edge guards without the whole-model check (complexity sweep, chunk G1)
//
// Ranked candidate 3 of docs/plans/step-mesher-complexity.md: CanDiscretize asks
// Law_IndicesInRange, a scan of every table of the model, and DiscretizeAll and layer 8's
// EdgeDiagnostics ask CanDiscretize once per edge, so E edges over M model rows cost O(E M).
// Here the per-edge guard assumes the indices are in range, and the two whole-model passes ask
// Law_IndicesInRange once and pass the answer down: O(M + E).
//
// Sections, in order:
//  - The per-edge guard
//  - Every edge

library EdgeGuards
{
    //==
    // # The per-edge guard

    // CanDiscretize without its whole-model conjunct: the criteria are well formed and the edge
    // is evaluable with a domain of positive extent. Precondition: m.Law_IndicesInRange, which
    // the caller checks once per model. CanDiscretize(m, e, c) is
    // m.Law_IndicesInRange ? m.CanDiscretizeInRange(e, c) : false.
    CanDiscretizeInRange(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria): Boolean
        => (c.IsWellFormed && m.IsEdgeEvaluable(e))
            ? m.EdgeDomain(e).Range.Start < m.EdgeDomain(e).Range.End
            : false;

    //==
    // # Every edge

    // DiscretizeAll with Law_IndicesInRange asked once for the model, its whole-model scans
    // counted as Flips: one. A model with an index out of range gets every entry Undiscretized,
    // as CanDiscretize rejects every edge of it. The entries are DiscretizeAll's, bit for bit.
    DiscretizeAllCounted(m: BrepModel, c: DiscretizationCriteria, floors: SegmentFloors): Counted<EdgeDiscretizations>
    {
        var inRange = m.Law_IndicesInRange;
        var table = EdgeDiscretizations(m.Edges.Count.MapRange(i =>
            (inRange ? m.CanDiscretizeInRange(BrepEdgeIndex(i), c) : false)
                ? m.Discretize(BrepEdgeIndex(i), c, floors)
                : Undiscretized(BrepEdgeIndex(i))));
        return Counted(table, Flips(1));
    }

    // DiscretizeAll, and termination's DiscretizeAllBounded (the same table, since Discretize is
    // DiscretizeBounded), with one whole-model scan.
    DiscretizeAllIndexed(m: BrepModel, c: DiscretizationCriteria, floors: SegmentFloors): EdgeDiscretizations
        => m.DiscretizeAllCounted(c, floors).Value;
}

//==
// # Edge discretization
//
// Sections, in order:
//  - Criteria
//  - Edge facts
//  - Segment-count floors
//  - Circular arcs in closed form
//  - Segment measures
//  - Parameter-space images
//  - Discretizing and orienting
//  - Refinement

library EdgeDiscretizing
{
    //==
    // # Criteria
    //
    // The criteria record is model-independent. The model's own tolerances enter here, once: a
    // chordal bound or a minimum length below the file's `LengthTolerance` is meaningless, and an
    // angular bound above a third of a turn would let one chord span a third of a periodic face.

    // The recommended criteria for a chordal bound (research/MESHING-REQUIREMENTS.md 2.5): 15
    // degrees, no length limit, a minimum length of a tenth of the chordal bound, and 3 segments
    // per closed edge.
    DefaultCriteria(chordal: Number): DiscretizationCriteria
        => (chordal, 15.0.Degrees, Limit.Unlimited, 0.1 * chordal, 3);

    // The criteria can be met by some discretization: positive bounds, at least one segment per
    // closed edge, and room to halve a segment at the length limit without going under the
    // minimum length.
    IsWellFormed(c: DiscretizationCriteria): Boolean
        => c.Chordal > 0.0
            && c.Angular.Radians > 0.0
            && c.MinLength > 0.0
            && c.MinSegments >= 1
            && c.MaxLength.IsAtLeastTwice(c.MinLength);

    // True when `x` respects the limit.
    IsWithinLimit(x: Number, l: Limit): Boolean
        => match (l)
        {
            Unlimited => true;
            AtMost(v) => x <= v;
        };

    // True when the limit is at least twice `x`, so a chord at the limit can be halved into
    // pieces no shorter than `x`.
    IsAtLeastTwice(l: Limit, x: Number): Boolean
        => match (l)
        {
            Unlimited => true;
            AtMost(v) => v >= 2.0 * x;
        };

    // The same criteria with another chordal bound.
    WithChordal(c: DiscretizationCriteria, chordal: Number): DiscretizationCriteria
        => (chordal, c.Angular, c.MaxLength, c.MinLength, c.MinSegments);

    // The chordal bound actually applied: never below the model's length tolerance.
    EffectiveChordal(c: DiscretizationCriteria, t: Tolerances): Number
        => c.Chordal.Max(t.Length.Value);

    // The refinement floor actually applied: never below the model's length tolerance, so no
    // refinement makes two polyline points coincide.
    EffectiveMinLength(c: DiscretizationCriteria, t: Tolerances): Number
        => c.MinLength.Max(t.Length.Value);

    // The angular bound actually applied: never above a third of a turn, so no segment of a
    // closed curve turns through more than a third of it.
    EffectiveAngular(c: DiscretizationCriteria): Angle
        => c.Angular.Radians <= Number.Tau / 3.0 ? c.Angular : Angle(Number.Tau / 3.0);

    // The least segment count of a closed edge: `MinSegments`, and never below 3, since a closed
    // polyline of one or two segments encloses no area.
    ClosedEdgeMinimum(c: DiscretizationCriteria): Integer
        => c.MinSegments.Max(3);

    // The edge criteria with every length multiplied by factor: the chordal
    // bound, the length limit, the minimum length. The angle and the segment
    // count are kept.
    ScaledBy(c: DiscretizationCriteria, factor: Number): DiscretizationCriteria
        => DiscretizationCriteria(c.Chordal * factor, c.Angular, c.MaxLength.ScaledBy(factor), c.MinLength * factor, c.MinSegments);

    // The limit multiplied by factor; Unlimited stays Unlimited.
    ScaledBy(l: Limit, factor: Number): Limit
        => match (l)
        {
            Unlimited => Limit.Unlimited;
            AtMost(v) => Limit.AtMost(v * factor);
        };

    //==
    // # Edge facts
    //
    // Small compositions over the model that the laws and the algorithm share. The canonical
    // direction is the edge curve's increasing parameter, whatever the edge's `SameSense`.

    // The edge, its two vertices, and its curve are all in range, so the edge can be evaluated.
    IsEdgeEvaluable(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.IsEdgeInRange(e)
            ? (m.IsVertexInRange(m.Edges[e].Start)
                && m.IsVertexInRange(m.Edges[e].End)
                && m.Geometry.Curves.IsValidIndex(m.Edges[e].Curve))
            : false;

    // The discretization can be evaluated against the model: its edge is evaluable, its arrays
    // have one entry per sample and at least two, and every parameter lies in the edge domain.
    IsEvaluable(m: BrepModel, d: EdgeDiscretization): Boolean
        => m.IsEdgeEvaluable(d.Edge)
            ? (d.Parameters.Count == d.Points.Count
                && d.Parameters.Count >= 2
                && d.Parameters.All(t => m.EdgeDomain(d.Edge).Range.Contains(t)))
            : false;

    // The point of the edge's curve at parameter t. t is first moved into the curve's range by
    // whole periods (layer 0's `Wrap`): an edge on a `Closed` curve may cross the join, and a
    // closed curve's formula is evaluated only inside its range. The identity when aperiodic.
    PointOnEdge(m: BrepModel, e: BrepEdgeIndex, t: Number): Point3D
        => m.Geometry.Eval(m.Edges[e].Curve, m.Geometry.Domain(m.Edges[e].Curve).Wrap(t));

    // The derivative of the edge's curve at parameter t, pointing towards increasing t, after
    // the same wrap.
    TangentOnEdge(m: BrepModel, e: BrepEdgeIndex, t: Number): Vector3D
        => m.Geometry.Derivative(m.Edges[e].Curve, m.Geometry.Domain(m.Edges[e].Curve).Wrap(t));

    // The vertex at the start of the edge domain in the curve's parameter: the edge's `Start`
    // when the edge runs with its curve, its `End` otherwise.
    DomainStartVertex(m: BrepModel, e: BrepEdgeIndex): BrepVertexIndex
        => m.Edges[e].SameSense ? m.Edges[e].Start : m.Edges[e].End;

    // The vertex at the end of the edge domain in the curve's parameter.
    DomainEndVertex(m: BrepModel, e: BrepEdgeIndex): BrepVertexIndex
        => m.Edges[e].SameSense ? m.Edges[e].End : m.Edges[e].Start;

    // Chunk A body, from the contract EdgeSeeds: the domain's two ends, and
    // strictly inside the domain every copy of a curve breakpoint (layer 1's
    // Breakpoints: polyline vertices, composite joints, spline knots of full
    // multiplicity) and on a Closed curve every copy of the join, sorted; an
    // interior candidate within the curve's parameter tolerance at it
    // (ParameterToleranceAt) of the last kept seed or of the domain end is
    // dropped. The ends are copied from EdgeDomain, never recomputed.
    EdgeSeeds(m: BrepModel, e: BrepEdgeIndex): Array<Number>
    {
        var range = m.EdgeDomain(e).Range;
        var candidates = m.SeedCandidates(e).Sort((a, b) => a <= b);
        var seeds = new List<Number>().Add(range.Start);
        var last = range.Start;
        var k = 0;
        while (k < candidates.Count)
        {
            var t = candidates[k];
            var tol = m.SeedTolerance(e, t);
            if (t - last > tol)
            {
                if (range.End - t > tol)
                {
                    seeds = seeds.Add(t);
                    last = t;
                }
            }
            k = k + 1;
        }
        return seeds.Add(range.End).Freeze();
    }

    // The interior seed candidates of edge e, unsorted: every copy of a
    // breakpoint of its curve inside the edge domain, and on a Closed curve
    // every copy of the curve range's start (the join). Precondition: the
    // edge is evaluable.
    SeedCandidates(m: BrepModel, e: BrepEdgeIndex): Array<Number>
    {
        var curveDomain = m.Geometry.Domain(m.Edges[e].Curve);
        var range = m.EdgeDomain(e).Range;
        var joins = curveDomain.Periodicity.IsClosedDirection ? [curveDomain.Range.Start] : [0.0].Take(0);
        return m.Geometry.Breakpoints(m.Edges[e].Curve).Concatenate(joins)
            .FlatMap(b => curveDomain.CopiesInside(b, range));
    }

    // Whether a periodicity is Closed: a seam whose formula does not wrap.
    IsClosedDirection(p: Periodicity): Boolean
        => match (p)
        {
            Aperiodic => false;
            Periodic(period) => false;
            Closed(period) => true;
        };

    // The curve's parameter tolerance at seed t of edge e, t first wrapped
    // into the curve's domain (layer 1's ParameterToleranceAt).
    SeedTolerance(m: BrepModel, e: BrepEdgeIndex, t: Number): Number
        => m.Geometry.ParameterToleranceAt(m.Edges[e].Curve, m.Geometry.Domain(m.Edges[e].Curve).Wrap(t), m.Tolerances).Value;

    // True when t is one of the edge's seeds. Exact equality: a seed is copied into the
    // discretization, never recomputed.
    IsSeedParameter(m: BrepModel, e: BrepEdgeIndex, t: Number): Boolean
        => m.EdgeSeeds(e).Any(s => s == t);

    // Chunk A body, from the contract TotalTurning: zero for a line, the swept
    // angle (the edge domain's length) for a circle, and for every other curve
    // the sum of the angles between consecutive tangents sampled at 65 points
    // of each seed span, the ends pulled a millionth of the span inside so a
    // corner at a seed is crossed between spans, never inside one: the
    // tangent jumps at the seeds included (a quadrature of the contract's
    // integral of curvature, with steps a small fraction of a turn).
    TotalTurning(m: BrepModel, e: BrepEdgeIndex): Angle
        => m.Geometry.CurveAt(m.Edges[e].Curve).ClosedFormTurning(m.EdgeDomain(e).Range).Radians >= 0.0
            ? m.Geometry.CurveAt(m.Edges[e].Curve).ClosedFormTurning(m.EdgeDomain(e).Range)
            : m.SampledTurning(e);

    // The total turning over r in closed form: 0 for a line, r's length for a
    // circle; a negative angle for every other case, which has none.
    ClosedFormTurning(curve: BrepCurve, r: NumberInterval): Angle
        => match (curve)
        {
            Line(origin, velocity) => Angle(0.0);
            Circle(placement, radius) => Angle(r.End - r.Start);
            Ellipse(placement, semiAxis1, semiAxis2) => Angle(-1.0);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => Angle(-1.0);
            Parabola(placement, focalDistance) => Angle(-1.0);
            Polyline(points) => Angle(-1.0);
            BSpline(data) => Angle(-1.0);
            Trimmed(basis, range, sameSense) => Angle(-1.0);
            Composite(segments) => Angle(-1.0);
            Offset(basis, distance, reference) => Angle(-1.0);
            OnSurface(spaceCurve, supports, master) => Angle(-1.0);
        };

    // The sampled total turning of edge e: the sum of the angles between
    // consecutive sampled tangents, seed span by seed span.
    SampledTurning(m: BrepModel, e: BrepEdgeIndex): Angle
    {
        var seeds = m.EdgeSeeds(e);
        var tangents = (seeds.Count - 1).Range.FlatMap(k => m.SpanTangents(e, seeds[k], seeds[k + 1]));
        return Angle((tangents.Count - 1).Max(0).MapRange(i => tangents[i].AngleOrZero(tangents[i + 1]).Radians).SumOf);
    }

    // The curve's tangents at 65 equally spaced parameters of [a, b], the two
    // ends a millionth of the span inside.
    SpanTangents(m: BrepModel, e: BrepEdgeIndex, a: Number, b: Number): Array<Vector3D>
    {
        var inset = (b - a) * 0.000001;
        return NumberInterval(a + inset, b - inset).Samples(65).Map(t => m.TangentOnEdge(e, t));
    }

    // A closed edge that is not degenerate: one vertex at both ends (layer 2's `IsClosedEdge`)
    // and a curve that does not collapse to that vertex (layer 2's `IsDegenerateEdge`). Its domain
    // spans the curve's full period, and it needs the closed-edge minimum count; a degenerate
    // closed edge (a pole) keeps one segment.
    IsClosedRegularEdge(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.IsClosedEdge(e) ? !m.IsDegenerateEdge(e) : false;

    // True when the edge is used by an edge loop of exactly two coedges. Two single-segment
    // edges would make that loop a digon of zero area, so each such edge gets two segments.
    IsInTwoEdgeLoop(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.Loops.Any(l => l.CoedgeCount == 2 && l.CitesEdge(e));

    //==
    // # Segment-count floors
    //
    // Counts the criteria cannot lower and `MinLength` cannot override: what the caller asks for,
    // what a closed edge needs, what a two-edge loop needs, and a third of a turn per segment.

    // No floors: the default.
    NoFloors(_: SegmentFloors): SegmentFloors
        => SegmentFloors(0.MapRange(i => 0));

    // The caller's floor for one edge; 0 when the array does not reach it.
    FloorOf(floors: SegmentFloors, e: BrepEdgeIndex): Integer
        => floors.ByEdge.IsValidIndex(e) ? floors.ByEdge[e] : 0;

    // Enough segments that none spans more than a third of the curve's total turning
    // (research/MESHING-REQUIREMENTS.md 3.6): an element of a periodic face then never spans half
    // a period, where it could fold.
    TurnFloor(m: BrepModel, e: BrepEdgeIndex): Integer
        => (m.TotalTurning(e).Radians / (Number.Tau / 3.0)).Ceiling.ToInteger.Max(1);

    // The least segment count of the edge: exactly 1 for a degenerate edge, otherwise the largest
    // of the caller's floor, the closed-edge minimum, 2 inside a two-edge loop, and the turn floor.
    MinimumSegmentCount(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors): Integer
        => m.IsDegenerateEdge(e)
            ? 1
            : floors.FloorOf(e)
                .Max(m.IsClosedRegularEdge(e) ? c.ClosedEdgeMinimum : 1)
                .Max(m.IsInTwoEdgeLoop(e) ? 2 : 1)
                .Max(m.TurnFloor(e));

    //==
    // # Circular arcs in closed form
    //
    // On a circle of radius R a chord spanning central angle theta has sagitta R (1 - cos(theta/2))
    // and length 2 R sin(theta/2); each of the three criteria is monotone in theta, so the uniform
    // count is a ceiling of the sweep over the smallest admissible angle (research/
    // MESHING-REQUIREMENTS.md 3.1). The same counts size the columns of analytic face grids.

    // The sagitta of a chord of a circle of the given radius spanning the given central angle.
    ArcSagitta(radius: Number, theta: Angle): Number
        => radius * (1.0 - (theta * 0.5).Cos);

    // The largest central angle whose chord has sagitta at most `chordal`: 2 acos(1 - d/R), or a
    // full turn when `chordal` reaches the diameter.
    ChordalArcAngle(radius: Number, chordal: Number): Angle
        => chordal < 2.0 * radius ? (1.0 - chordal / radius).Acos * 2.0 : Angle(Number.Tau);

    // The central angle whose chord has the given length: 2 asin(L / 2R), a half turn when the
    // length reaches the diameter.
    LengthArcAngle(radius: Number, length: Number): Angle
        => (length / (2.0 * radius)).Min(1.0).Asin * 2.0;

    // The largest central angle whose chord respects the limit.
    LimitArcAngle(radius: Number, l: Limit): Angle
        => match (l)
        {
            Unlimited => Angle(Number.Tau);
            AtMost(v) => radius.LengthArcAngle(v);
        };

    // The uniform segment count the criteria ask for on an arc of the given sweep.
    ArcCriteriaCount(radius: Number, sweep: Angle, c: DiscretizationCriteria, t: Tolerances): Integer
    {
        var step = radius.ChordalArcAngle(c.EffectiveChordal(t)).Radians
            .Min(c.EffectiveAngular.Radians)
            .Min(radius.LimitArcAngle(c.MaxLength).Radians);
        return (sweep.Radians / step).Ceiling.ToInteger.Max(1);
    }

    // The largest uniform segment count whose chords are no shorter than the effective minimum
    // length; 1 when even one chord would be shorter.
    ArcLengthCap(radius: Number, sweep: Angle, c: DiscretizationCriteria, t: Tolerances): Integer
    {
        var shortest = c.EffectiveMinLength(t);
        return shortest < 2.0 * radius
            ? (sweep.Radians / radius.LengthArcAngle(shortest).Radians).Floor.ToInteger.Max(1)
            : 1;
    }

    // The segment count of a circular arc: what the criteria ask for, capped by the minimum
    // length, and never below `least` (the edge's `MinimumSegmentCount`).
    ArcSegmentCount(radius: Number, sweep: Angle, c: DiscretizationCriteria, t: Tolerances, least: Integer): Integer
        => least.Max(radius.ArcCriteriaCount(sweep, c, t).Min(radius.ArcLengthCap(sweep, c, t)));

    //==
    // # Segment measures
    //
    // Segment i joins Points[i] to Points[i + 1]. Each measure is defined for either direction of
    // the arrays. The sampled measures use the plan's interior samples only, so they never
    // evaluate a tangent at a seed, where the curve may have a corner.

    // The number of segments.
    SegmentCount(d: EdgeDiscretization): Integer
        => d.Parameters.Count - 1;

    // The length of segment i's chord.
    SegmentLength(d: EdgeDiscretization, i: Integer): Number
        => d.Points[i].Distance(d.Points[i + 1]);

    // The plan's sample positions strictly inside a segment. `SamplePlan.Count` counts both ends
    // (layer 0), so a plan of n gives the fractions j / (n - 1) for j = 1 .. n - 2; a plan below 3
    // is read as 3, so there is always the midpoint. Symmetric about one half; a plan of 5 gives
    // the quarter points and the midpoint (research/MESHING-REQUIREMENTS.md 3.5). The ends are
    // left out, so a tangent is never sampled at a seed.
    InteriorFractions(plan: SamplePlan): Array<Number>
        => (plan.Count.Max(3) - 2).MapRange(j => (j + 1).ToNumber / (plan.Count.Max(3) - 1).ToNumber);

    // The plan the discretizer tests every candidate segment with: five samples counting both
    // ends, so three interior ones (the quarter points and the midpoint).
    DiscretizationPlan(_: SamplePlan): SamplePlan
        => SamplePlan(5);

    // Chunk A body, the closed forms of the contract Sagitta: 0 for a line; R
    // (1 - cos(dt / 2)) for a circle, which holds for an arc of any sweep (the
    // chord's line lies R cos(dt / 2) from the centre); the distance of the
    // parametric midpoint from the chord for an ellipse arc of less than half
    // a turn (an affine image of the circle case). Every other curve, and an
    // ellipse arc of half a turn or more, goes to SagittaByHullBound, the
    // control-hull certificate, still deferred (chunk F).
    Sagitta(m: BrepModel, e: BrepEdgeIndex, t0: Number, t1: Number): Number
        => m.Geometry.CurveAt(m.Edges[e].Curve).ClosedFormSagitta(t0, t1) >= 0.0
            ? m.Geometry.CurveAt(m.Edges[e].Curve).ClosedFormSagitta(t0, t1)
            : m.SagittaByHullBound(e, t0, t1);

    // The sagitta of the arc over [t0, t1] in closed form, or -1 when the
    // case has none.
    ClosedFormSagitta(curve: BrepCurve, t0: Number, t1: Number): Number
        => match (curve)
        {
            Line(origin, velocity) => 0.0;
            Circle(placement, radius) => radius.ArcSagitta(Angle((t1 - t0).Abs));
            Ellipse(placement, semiAxis1, semiAxis2) => (t1 - t0).Abs < Number.Pi
                ? DistanceToSegment(
                    placement.FramePoint(semiAxis1 * t0.Cos, semiAxis2 * t0.Sin, 0.0),
                    placement.FramePoint(semiAxis1 * t1.Cos, semiAxis2 * t1.Sin, 0.0),
                    placement.FramePoint(semiAxis1 * ((t0 + t1) * 0.5).Cos, semiAxis2 * ((t0 + t1) * 0.5).Sin, 0.0))
                : -1.0;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => -1.0;
            Parabola(placement, focalDistance) => -1.0;
            Polyline(points) => -1.0;
            BSpline(data) => -1.0;
            Trimmed(basis, range, sameSense) => -1.0;
            Composite(segments) => -1.0;
            Offset(basis, distance, reference) => -1.0;
            OnSurface(spaceCurve, supports, master) => -1.0;
        };

    // The sagitta of edge e's arc over [t0, t1] by the control-hull bound of
    // the contract Sagitta: per Bezier span, polynomial or rational with
    // positive weights, the largest distance of a control point from the
    // chord, spans subdivided until within the length tolerance of the
    // sampled maximum.
    // deferred: control-hull certificate with Bezier extraction and subdivision (chunk F).
    SagittaByHullBound(m: BrepModel, e: BrepEdgeIndex, t0: Number, t1: Number): Number;

    // The largest distance from the curve, at the plan's interior samples of segment i, to the
    // segment's chord. A lower bound on the segment's sagitta, exact on circles at the midpoint.
    SampledSagitta(m: BrepModel, d: EdgeDiscretization, plan: SamplePlan, i: Integer): Number
    {
        var t0 = d.Parameters[i];
        var t1 = d.Parameters[i + 1];
        return plan.InteriorFractions.Reduce(0.0, (worst, f) =>
            worst.Max(DistanceToSegment(d.Points[i], d.Points[i + 1], m.PointOnEdge(d.Edge, t0 + (t1 - t0) * f))));
    }

    // The angle between two vectors in [0, pi], 0 when either is zero: atan2(|u x v|, u . v),
    // which keeps its relative precision for small angles, where the arc cosine of the dot
    // product cannot resolve less than about 1.5e-8 rad and reads up to 3e-8 for parallel
    // vectors (review F7; layer 0's `AngleBetweenDirections` is the same formula).
    AngleOrZero(u: Vector3D, v: Vector3D): Angle
        => u.LengthSquared * v.LengthSquared > 0.0 ? u.Cross(v).Length.Atan2(u.Dot(v)) : Angle(0.0);

    // The largest angle between segment i's chord and the curve's tangent at the plan's interior
    // samples, the tangent oriented with the segment. On a circle it tends to half the central
    // angle as the plan grows.
    TangentDeviation(m: BrepModel, d: EdgeDiscretization, plan: SamplePlan, i: Integer): Angle
    {
        var t0 = d.Parameters[i];
        var t1 = d.Parameters[i + 1];
        var chord = d.Points[i + 1] - d.Points[i];
        return Angle(plan.InteriorFractions.Reduce(0.0, (worst, f) =>
            worst.Max(chord.AngleOrZero(m.TangentOnEdge(d.Edge, t0 + (t1 - t0) * f) * (t1 - t0)).Radians)));
    }

    // The turning angle at interior point i (1 <= i <= count - 2): the angle between the chords of
    // segments i - 1 and i. Equal to the central angle per segment on a uniformly split circle.
    TurningAngle(d: EdgeDiscretization, i: Integer): Angle
        => (d.Points[i] - d.Points[i - 1]).AngleOrZero(d.Points[i + 1] - d.Points[i]);

    // True when halving segment i at its parameter midpoint would leave a piece shorter than the
    // effective minimum length: the refinement floor has stopped this segment.
    IsAtLengthFloor(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, i: Integer): Boolean
    {
        var middle = m.PointOnEdge(d.Edge, (d.Parameters[i] + d.Parameters[i + 1]) * 0.5);
        var shortest = c.EffectiveMinLength(m.Tolerances);
        return d.Points[i].Distance(middle) < shortest || middle.Distance(d.Points[i + 1]) < shortest;
    }

    // True when both ends of segment i are seeds: the segment is a whole seed span.
    IsSeedSegment(m: BrepModel, d: EdgeDiscretization, i: Integer): Boolean
        => m.IsSeedParameter(d.Edge, d.Parameters[i]) && m.IsSeedParameter(d.Edge, d.Parameters[i + 1]);

    //==
    // # Parameter-space images
    //
    // A face joins consecutive boundary samples by straight segments in its parameter space. The
    // 3D chord is the same for both faces, so watertightness does not depend on the image; the
    // validity of each face's parameter-space polygon does. So the criteria are also met on the
    // image: the straight image segment, mapped onto the surface, stays within the chordal bound of
    // the 3D chord (the test of research/MESHING-REQUIREMENTS.md 3.7).

    // The parameter spaces the edge is drawn in: for every face that uses it, one image per
    // pcurve of the edge on that face's surface, or one image through `Project` when there is none.
    EdgeImages(m: BrepModel, e: BrepEdgeIndex): Array<EdgeImage>
        => m.FacesOfEdge(e).FlatMap(f => m.ImagesOnFace(e, f));

    // The images of the edge on one face.
    ImagesOnFace(m: BrepModel, e: BrepEdgeIndex, f: BrepFaceIndex): Array<EdgeImage>
    {
        var s = m.Faces[f].Surface;
        var pcurves = m.Geometry.PcurvesOf(m.Edges[e].Curve)
            .FlatMap(p => Repeat(m.Geometry.Pcurves[p].Surface == s ? 1 : 0, p));
        return pcurves.Count == 0
            ? [EdgeImage(f, PcurveIndex(-1))]
            : pcurves.Map(p => EdgeImage(f, p));
    }

    // The surface an image lives on: its face's surface.
    ImageSurface(m: BrepModel, img: EdgeImage): SurfaceIndex
        => m.Faces[img.Face].Surface;

    // The image's face, surface, and pcurve (when present) are in range.
    IsImageEvaluable(m: BrepModel, img: EdgeImage): Boolean
        => m.IsFaceInRange(img.Face)
            ? (m.Geometry.Surfaces.IsValidIndex(m.Faces[img.Face].Surface)
                ? (img.Pcurve.IsNone
                    ? true
                    : (m.Geometry.Pcurves.IsValidIndex(img.Pcurve)
                        ? m.Geometry.Curves2D.IsValidIndex(m.Geometry.Pcurves[img.Pcurve].Curve)
                        : false))
                : false)
            : false;

    // Chunk A body, from the contract ImagePoints, computed over the canonical
    // (increasing-parameter) order and reversed with d. With a pcurve: the 2D
    // curve at the pcurve's parameter nearest each point (layer 1's
    // ClosestParameter on the pcurve). Without: Project onto the face's
    // surface, a point on a degenerate side given its neighbour's free
    // coordinate. Then every point unwrapped to the copy nearest its
    // predecessor (layer 0's NearestUnwrapped on the surface domain).
    ImagePoints(m: BrepModel, d: EdgeDiscretization, img: EdgeImage): Array<UvCoordinate>
    {
        var forward = d.RunsAlongCurve;
        var canonical = forward ? d : d.Reversed;
        var image = m.CanonicalImagePoints(canonical, img);
        return forward ? image : image.Count.MapRange(i => image[image.Count - 1 - i]);
    }

    // ImagePoints over a discretization in the canonical order.
    CanonicalImagePoints(m: BrepModel, d: EdgeDiscretization, img: EdgeImage): Array<UvCoordinate>
    {
        var s = m.ImageSurface(img);
        var raw = img.Pcurve.IsNone
            ? m.PolesFilled(s, d.Points.Map(p => m.Geometry.Project(s, p)))
            : d.Points.Map(p => m.Geometry.Eval(m.Geometry.Pcurves[img.Pcurve].Curve, m.Geometry.ClosestParameter(img.Pcurve, p)));
        return m.Geometry.Domain(s).UnwrappedByContinuity(raw);
    }

    // The points with each one unwrapped to the copy nearest its predecessor,
    // the first kept.
    UnwrappedByContinuity(dom: SurfaceDomain, raw: Array<UvCoordinate>): Array<UvCoordinate>
    {
        var lifted = new List<UvCoordinate>();
        var i = 0;
        while (i < raw.Count)
        {
            lifted = lifted.Add(i == 0 ? raw[0] : dom.NearestUnwrapped(raw[i], lifted.At(i - 1)));
            i = i + 1;
        }
        return lifted.Freeze();
    }

    // The projected points with every point on a degenerate side of surface s
    // (a pole, where Project leaves the free coordinate arbitrary) given the
    // free coordinate of its predecessor, or of its successor for the first.
    PolesFilled(m: BrepModel, s: SurfaceIndex, raw: Array<UvCoordinate>): Array<UvCoordinate>
    {
        var dom = m.Geometry.Domain(s);
        var sides = m.Geometry.DegenerateSides(s, m.Tolerances);
        var filled = new List<UvCoordinate>();
        var i = 0;
        while (i < raw.Count)
        {
            var uv = raw[i];
            var neighbour = i > 0 ? filled.At(i - 1) : (raw.Count > 1 ? raw[1] : uv);
            var onSides = sides.FlatMap(side =>
                m.IsOffSide(dom, side, uv, m.Geometry.UvToleranceAt(s, uv, m.Tolerances)) ? sides.Take(0) : [side]);
            var fixedUv = onSides.Count == 0
                ? uv
                : (onSides[0].IsUSide ? UvCoordinate(uv.U, neighbour.V) : UvCoordinate(neighbour.U, uv.V));
            filled = filled.Add(fixedUv);
            i = i + 1;
        }
        return filled.Freeze();
    }

    // True when the step from a to b is unwrapped: in each periodic direction it is at most half
    // a period long.
    IsUnwrappedStep(dom: SurfaceDomain, a: UvCoordinate, b: UvCoordinate): Boolean
        => (b.U - a.U).IsUnwrappedIn(dom.U.Periodicity) && (b.V - a.V).IsUnwrappedIn(dom.V.Periodicity);

    // True when a parameter difference is at most half a period long, or the direction has no
    // seam. A `Closed` direction has a seam like a periodic one.
    IsUnwrappedIn(x: Number, p: Periodicity): Boolean
        => match (p)
        {
            Aperiodic => true;
            Periodic(period) => 2.0 * x.Abs <= period;
            Closed(period) => 2.0 * x.Abs <= period;
        };

    // A parameter brought into a domain direction for evaluation: clamped into an aperiodic one,
    // unchanged in a periodic one (the formula wraps), and wrapped into the range by whole
    // periods in a `Closed` one (the point set wraps, the formula does not).
    ClampInto(cd: CurveDomain, x: Number): Number
        => match (cd.Periodicity)
        {
            Aperiodic => cd.Range.Clamp(x);
            Periodic(period) => x;
            Closed(period) => cd.Wrap(x);
        };

    // A parameter-space point clamped into the surface's domain, so a law never evaluates the
    // surface outside it.
    ClampToDomain(dom: SurfaceDomain, uv: UvCoordinate): UvCoordinate
        => UvCoordinate(dom.U.ClampInto(uv.U), dom.V.ClampInto(uv.V));

    // The largest distance from the 3D chord [a, b] to the surface evaluated along the straight
    // parameter-space segment [ua, ub], at the plan's interior samples.
    UvChordDeviation(m: BrepModel, s: SurfaceIndex, a: Point3D, b: Point3D, ua: UvCoordinate, ub: UvCoordinate, plan: SamplePlan): Number
    {
        var dom = m.Geometry.Domain(s);
        return plan.InteriorFractions.Reduce(0.0, (worst, f) =>
            worst.Max(DistanceToSegment(a, b, m.Geometry.Eval(s, dom.ClampToDomain(ua.Lerp(ub, f))))));
    }

    // `UvChordDeviation` for every segment of the polyline in one image; empty when the image
    // does not have one point per polyline point.
    ImageChordDeviations(m: BrepModel, d: EdgeDiscretization, img: EdgeImage, plan: SamplePlan): Array<Number>
    {
        var uvs = m.ImagePoints(d, img);
        var s = m.ImageSurface(img);
        return uvs.Count == d.Points.Count
            ? d.SegmentCount.MapRange(i => m.UvChordDeviation(s, d.Points[i], d.Points[i + 1], uvs[i], uvs[i + 1], plan))
            : 0.MapRange(i => 0.0);
    }

    //==
    // # Discretizing and orienting
    //
    // Discretization always runs in the canonical direction, the curve's increasing parameter; a
    // face gets the other direction only by `Reversed`, never by recomputing. That is the whole
    // symmetry argument: an edge and its reversal have the same curve, domain, seeds, floors, and
    // images, so they get the same arrays bit for bit.

    // The preconditions of `Discretize`: the model's indices are in range, the criteria are well
    // formed, and the edge is evaluable with a domain of positive extent.
    CanDiscretize(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria): Boolean
        => (m.Law_IndicesInRange && c.IsWellFormed && m.IsEdgeEvaluable(e))
            ? m.EdgeDomain(e).Range.Start < m.EdgeDomain(e).Range.End
            : false;

    // Chunk A body, from the contract Discretize: DiscretizeBounded (the "bounded" functions in
    // termination-discretize.library.plato). A degenerate edge gets its two domain ends and its two
    // vertex points. A line, circle or ellipse is split uniformly into its closed-form count,
    // raised while an image chord of an image the edge lies on exceeds the chordal bound, found by
    // search up to the cap the minimum length gives. Every other curve is bisected at parameter
    // midpoints, seed span by seed span, while a criterion fails and both halves keep the effective
    // minimum length; then the segment longest in parameter is halved until the count reaches
    // MinimumSegmentCount. An image the edge does not lie on is left out of the tests and
    // reported (DISCRETIZE-EDGE-OFF-SURFACE).
    Discretize(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors): EdgeDiscretization
        => m.DiscretizeBounded(e, c, floors);

    // The discretization of edge e at the given increasing parameters: the
    // domain-start and domain-end vertex points at the two ends, copied, and
    // the curve's points between.
    DiscretizationAt(m: BrepModel, e: BrepEdgeIndex, parameters: Array<Number>): EdgeDiscretization
        => EdgeDiscretization(e, parameters, parameters.Count.MapRange(i =>
            i == 0
                ? m.Vertices[m.DomainStartVertex(e)].Point
                : (i == parameters.Count - 1 ? m.Vertices[m.DomainEndVertex(e)].Point : m.PointOnEdge(e, parameters[i]))));

    // The closed-form uniform segment count of a line, circle or ellipse edge,
    // never below least; 0 for every other curve, which is bisected.
    ConicSegmentCount(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, least: Integer): Integer
        => m.Geometry.CurveAt(m.Edges[e].Curve).ConicCount(m.EdgeDomain(e).Range, c, m.Tolerances, least, false);

    // The largest uniform count the minimum length allows on a line, circle or
    // ellipse edge, never below least; 0 for every other curve.
    ConicSegmentCap(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, least: Integer): Integer
        => m.Geometry.CurveAt(m.Edges[e].Curve).ConicCount(m.EdgeDomain(e).Range, c, m.Tolerances, least, true);

    // The uniform count of a conic record over the range r (cap false), or
    // the largest count its minimum length allows (cap true), never below
    // least. A line: one segment per length limit, the cap its length over
    // the effective minimum length. A circle: layer 4's ArcSegmentCount, the
    // cap ArcLengthCap. An ellipse with semi-axes a >= b: the circle formulas
    // at radius a with the angular bound scaled by b / a, the cap at radius b
    // (README, "Implementation notes"). 0 for every other case.
    ConicCount(curve: BrepCurve, r: NumberInterval, c: DiscretizationCriteria, t: Tolerances, least: Integer, cap: Boolean): Integer
        => match (curve)
        {
            Line(origin, velocity) => cap
                ? least.Max((velocity.Length * (r.End - r.Start) / c.EffectiveMinLength(t)).Floor.ToInteger.Max(1))
                : least.Max(LineCriteriaCount(velocity.Length * (r.End - r.Start), c)
                    .Min((velocity.Length * (r.End - r.Start) / c.EffectiveMinLength(t)).Floor.ToInteger.Max(1)));
            Circle(placement, radius) => cap
                ? least.Max(radius.ArcLengthCap(Angle(r.End - r.Start), c, t))
                : radius.ArcSegmentCount(Angle(r.End - r.Start), c, t, least);
            Ellipse(placement, semiAxis1, semiAxis2) => cap
                ? least.Max(semiAxis1.Min(semiAxis2).ArcLengthCap(Angle(r.End - r.Start), c, t))
                : least.Max(semiAxis1.Max(semiAxis2).ArcCriteriaCount(Angle(r.End - r.Start),
                        DiscretizationCriteria(c.Chordal, c.Angular * (semiAxis1.Min(semiAxis2) / semiAxis1.Max(semiAxis2)), c.MaxLength, c.MinLength, c.MinSegments), t)
                    .Min(semiAxis1.Min(semiAxis2).ArcLengthCap(Angle(r.End - r.Start), c, t)));
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => 0;
            Parabola(placement, focalDistance) => 0;
            Polyline(points) => 0;
            BSpline(data) => 0;
            Trimmed(basis, range, sameSense) => 0;
            Composite(segments) => 0;
            Offset(basis, distance, reference) => 0;
            OnSurface(spaceCurve, supports, master) => 0;
        };

    // The segment count a straight chord of the given length needs under the
    // length limit: 1 when unlimited.
    LineCriteriaCount(length: Number, c: DiscretizationCriteria): Integer
        => match (c.MaxLength)
        {
            Unlimited => 1;
            AtMost(v) => (length / v).Ceiling.ToInteger.Max(1);
        };

    // Whether some image chord of the discretization exceeds the effective
    // chordal bound widened by twice the length tolerance.
    ImagesExceedChordal(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria): Boolean
        => m.ImagesExceedChordalOn(d, c, m.EdgeImages(d.Edge));

    // The one-segment piece of edge e over [a, b], points on the curve.
    PieceOf(m: BrepModel, e: BrepEdgeIndex, a: Number, b: Number): EdgeDiscretization
        => EdgeDiscretization(e, [a, b], [m.PointOnEdge(e, a), m.PointOnEdge(e, b)]);

    // Whether the segment [a, b] fails a criterion the bisection tests: the
    // certified sagitta, the tangent deviation at the discretization plan's
    // samples, the length limit, an image chord.
    SegmentFails(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, a: Number, b: Number): Boolean
        => m.SegmentFailsOn(e, c, a, b, m.EdgeImages(e));

    // Whether halving [a, b] at its parameter midpoint leaves both chords at
    // least the effective minimum length.
    HalvesKeepMinLength(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, a: Number, b: Number): Boolean
    {
        var middle = m.PointOnEdge(e, (a + b) * 0.5);
        var shortest = c.EffectiveMinLength(m.Tolerances);
        return m.PointOnEdge(e, a).Distance(middle) >= shortest && middle.Distance(m.PointOnEdge(e, b)) >= shortest;
    }

    // The increasing parameters with the segment longest in parameter halved,
    // one at a time (the first such on a tie), until there are at least
    // `least` segments.
    RaisedToCount(m: BrepModel, parameters: Array<Number>, least: Integer): Array<Number>
    {
        var ts = parameters;
        while (ts.Count - 1 < least)
        {
            var widest = (ts.Count - 1).Range.Reduce(0, (w, i) => ts[i + 1] - ts[i] > ts[w + 1] - ts[w] ? i : w);
            ts = ts.Take(widest + 1).Concatenate([(ts[widest] + ts[widest + 1]) * 0.5]).Concatenate(ts.Skip(widest + 1));
        }
        return ts;
    }

    // The entry of an edge that `CanDiscretize` rejects: no parameters and no points. It keeps the
    // table at one entry per edge; every law is vacuous on it (`IsEvaluable` needs two samples),
    // and no face citing the edge is meshed.
    Undiscretized(e: BrepEdgeIndex): EdgeDiscretization
        => EdgeDiscretization(e, 0.MapRange(i => 0.0), 0.MapRange(i => Point3D(0.0, 0.0, 0.0)));

    // True when the value holds a polyline: at least two samples. False for `Undiscretized`.
    IsDiscretized(d: EdgeDiscretization): Boolean
        => d.Parameters.Count >= 2;

    // The canonical discretization of every edge `CanDiscretize` accepts, and `Undiscretized` for
    // every other, indexed by edge. Total: the usability guard is taken here, once, so no caller
    // repeats it. Each edge is independent of the others, so this is a map and parallel without
    // coordination.
    DiscretizeAll(m: BrepModel, c: DiscretizationCriteria, floors: SegmentFloors): EdgeDiscretizations
        => EdgeDiscretizations(m.Edges.Count.MapRange(i => m.DiscretizedEntry(BrepEdgeIndex(i), c, floors)));

    // The entry DiscretizeAll makes for edge e: its canonical discretization when CanDiscretize
    // accepts it, Undiscretized otherwise. Total.
    DiscretizedEntry(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors): EdgeDiscretization
        => m.CanDiscretize(e, c) ? m.Discretize(e, c, floors) : Undiscretized(e);

    // True when the parameters increase along the arrays: the canonical direction. True for a
    // value with fewer than two parameters, which has no direction.
    RunsAlongCurve(d: EdgeDiscretization): Boolean
        => d.IsDiscretized ? d.Parameters.First < d.Parameters.Last : true;

    // True when t is one of the parameters. Exact equality: for parameters copied from elsewhere
    // (a seed, the partition before a refinement).
    ContainsParameter(d: EdgeDiscretization, t: Number): Boolean
        => d.Parameters.Any(x => x == t);

    // Two discretizations are the same: same edge, same counts, and every parameter and point
    // bit-identical. Exact by design: the laws that use it compare copies, or claim determinism.
    SameDiscretization(a: EdgeDiscretization, b: EdgeDiscretization): Boolean
        => (a.Edge == b.Edge
            && a.Parameters.Count == b.Parameters.Count
            && a.Points.Count == b.Points.Count)
            ? (a.Parameters.Count.MapRange(i => a.Parameters[i] == b.Parameters[i]).All(x => x)
                && a.Points.Count.MapRange(i => a.Points[i] == b.Points[i]).All(x => x))
            : false;

    // The same polyline traversed the other way: both arrays reversed, the edge kept. An
    // involution; copies only, so a reversed point is bit-identical to its original.
    Reversed(d: EdgeDiscretization): EdgeDiscretization
        => EdgeDiscretization(
            d.Edge,
            d.Parameters.Count.MapRange(i => d.Parameters[d.Parameters.Count - 1 - i]),
            d.Points.Count.MapRange(i => d.Points[d.Points.Count - 1 - i]));

    // The polyline a coedge consumes inside a face bound: the discretization in the direction the
    // coedge runs on the curve. The one place the sharing principle is applied: the two uses of an
    // edge read the same arrays, one of them reversed.
    AlongCoedge(m: BrepModel, d: EdgeDiscretization, bound: FaceBound, coedge: Coedge): EdgeDiscretization
        => m.CoedgeRunsForwardOnCurve(bound, coedge) == d.RunsAlongCurve ? d : d.Reversed;

    //==
    // # Refinement
    //
    // Face meshing may find that an edge's polyline is still too coarse for one of its faces (a
    // loop crosses itself in parameter space, a structured grid needs a higher count). It returns
    // requests; the pipeline refines those edges and re-meshes their faces, a bounded number of
    // times. Refinement continues from the existing polyline, so it only ever adds points, and the
    // edge still has exactly one discretization at every moment.

    // True when the canonical discretization already meets the criteria the bisection tests on
    // every segment: the certified sagitta, the tangent deviation, the length limit, and every
    // image chord, each widened as in the laws or at the floor. `RefineEdge` then splits nothing
    // for the criteria, and only the count pass can add points.
    MeetsCriteria(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria): Boolean
        => m.IsEvaluable(d)
            ? d.SegmentCount.MapRange(i => m.SegmentMeetsCriteria(d, c, i)).All(x => x)
            : false;

    // True when segment i meets every criterion the bisection tests, each widened as in its law
    // or escaped at the length floor: the per-segment test of `MeetsCriteria`, and the test by
    // which `RefineEdge` decides to split.
    SegmentMeetsCriteria(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, i: Integer): Boolean
        => m.SegmentMeetsCriteriaOn(d, c, i, m.EdgeImages(d.Edge));

    // True when some request names the edge.
    IsRequested(requests: Array<EdgeRefinementRequest>, e: BrepEdgeIndex): Boolean
        => requests.Any(r => r.Edge == e);

    // The smallest chordal bound requested for the edge, or `current` when none is smaller.
    RequestedChordal(requests: Array<EdgeRefinementRequest>, e: BrepEdgeIndex, current: Number): Number
        => requests.Reduce(current, (x, r) => r.Edge == e ? x.Min(r.Chordal) : x);

    // The largest segment count requested for the edge, 0 when none.
    RequestedSegments(requests: Array<EdgeRefinementRequest>, e: BrepEdgeIndex): Integer
        => requests.Reduce(0, (x, r) => r.Edge == e ? x.Max(r.Segments) : x);

    // The precondition of `Refine`: one entry per edge of the model, entry i for edge i, and every
    // entry a request names discretizable under the criteria, evaluable, and canonical. Entries
    // no request names are never read, so nothing is asked of them: an `Undiscretized` entry may
    // stay as long as no face asks for its edge.
    IsRefinable(m: BrepModel, ds: EdgeDiscretizations, requests: Array<EdgeRefinementRequest>, c: DiscretizationCriteria): Boolean
        => m.DiscretizationsCoverEdges(ds)
            && ds.ByEdge.Count.MapRange(i => ds.DiscretizationsIndexedByEdge(i)).All(x => x)
            && ds.ByEdge.All(x => requests.IsRequested(x.Edge)
                ? (m.CanDiscretize(x.Edge, c) ? (m.IsEvaluable(x) ? x.RunsAlongCurve : false) : false)
                : true);

    // Chunk B body, from the contract RefineEdge and its deferred note. A
    // degenerate edge keeps its one segment. Otherwise every segment of d
    // that fails SegmentMeetsCriteria is bisected at its parameter midpoint,
    // and each half again while it fails the same test on its own piece
    // (depth at most 40, as Discretize); the length floor is inside the test,
    // so no split leaves a piece below the effective minimum length. Then the
    // segment longest in parameter is halved, one at a time, until the count
    // reaches `segments` (RaisedToCount). Every parameter of d is kept, and a
    // d that already meets the criteria gains only the count pass's points.
    RefineEdge(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, segments: Integer): EdgeDiscretization
        => m.RefineEdgeBounded(d, c, segments);

    // The discretizations with every requested edge refined to the smallest requested chordal
    // bound and the largest requested count, and every other edge left as it is.
    Refine(m: BrepModel, d: EdgeDiscretizations, requests: Array<EdgeRefinementRequest>, c: DiscretizationCriteria): EdgeDiscretizations
        => EdgeDiscretizations(d.ByEdge.Map(old =>
            requests.IsRequested(old.Edge)
                ? m.RefineEdge(
                    old,
                    c.WithChordal(requests.RequestedChordal(old.Edge, c.Chordal)),
                    requests.RequestedSegments(old.Edge))
                : old));
}

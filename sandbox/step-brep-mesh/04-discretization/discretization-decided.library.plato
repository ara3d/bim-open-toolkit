//==
// # Decided splits (functions)
//
// The predicate over SplitDecision.
//
// Sections, in order:
//  - Splits

library DiscretizationDecided
{
    //==
    // # Splits

    // True when the step split the segment.
    IsSplit(d: SplitDecision): Boolean
        => match (d) {
            Split(at) => true;
            KeepBecause(reason) => false;
        };
}

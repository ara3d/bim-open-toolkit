//==
// # Edge discretization with the edge domain computed once (complexity sweep, chunk E2)
//
// Ranked candidate 21 of docs/plans/step-mesher-complexity.md. Layer 2's EdgeDomain makes two
// inverse evaluations (ClosestParameter; a 256-sample search on a spline or an ellipse), and
// layer 4 asked it about 12 + 3I + n times per edge (I images, n parameters): the guard twice,
// IsDegenerateEdge up to three times, TotalTurning twice, EdgeSeeds and SeedCandidates, the
// conic count and cap, GapProbe once per image, UniformExceeds once per trial count, and
// IsEvaluable once per parameter, which the refinement test asks once per law per segment. Here
// the whole-table pass computes the range once per edge, and every function below takes it as a
// parameter. The plain forms become `=> ...Given(..., m.EdgeDomain(e).Range)` at merge, so every
// result is the plain form's, bit for bit: the same range value flows everywhere.
//
// Sections, in order:
//  - Evaluability
//  - Seeds and turning
//  - Counts
//  - Images the edge lies on
//  - Discretize
//  - Every edge
//  - The per-segment test
//  - Refinement
//  - Findings

library EdgeRangedDiscretizing
{
    //==
    // # Evaluability

    // Layer 4's IsEvaluable for a discretization of an evaluable edge, the edge domain given:
    // IsEvaluable(m, d) is
    // m.IsEdgeEvaluable(d.Edge) ? d.IsEvaluableGiven(m.EdgeDomain(d.Edge).Range) : false.
    IsEvaluableGiven(d: EdgeDiscretization, range: NumberInterval): Boolean
        => d.Parameters.Count == d.Points.Count
            && d.Parameters.Count >= 2
            && d.Parameters.All(t => range.Contains(t));

    //==
    // # Seeds and turning

    // Layer 4's SeedCandidates with the edge domain given.
    SeedCandidatesGiven(m: BrepModel, e: BrepEdgeIndex, range: NumberInterval): Array<Number>
    {
        var curveDomain = m.Geometry.Domain(m.Edges[e].Curve);
        var joins = curveDomain.Periodicity.IsClosedDirection ? [curveDomain.Range.Start] : [0.0].Take(0);
        return m.Geometry.Breakpoints(m.Edges[e].Curve).Concatenate(joins)
            .FlatMap(b => curveDomain.CopiesInside(b, range));
    }

    // Layer 4's EdgeSeeds with the edge domain given: EdgeSeeds(m, e) is
    // m.EdgeSeedsGiven(e, m.EdgeDomain(e).Range).
    EdgeSeedsGiven(m: BrepModel, e: BrepEdgeIndex, range: NumberInterval): Array<Number>
    {
        var candidates = m.SeedCandidatesGiven(e, range).Sort((a, b) => a <= b);
        var seeds = new List<Number>().Add(range.Start);
        var last = range.Start;
        var k = 0;
        while (k < candidates.Count)
        {
            var t = candidates[k];
            var tol = m.SeedTolerance(e, t);
            if (t - last > tol)
            {
                if (range.End - t > tol)
                {
                    seeds = seeds.Add(t);
                    last = t;
                }
            }
            k = k + 1;
        }
        return seeds.Add(range.End).Freeze();
    }

    // Layer 4's SampledTurning with the edge domain given.
    SampledTurningGiven(m: BrepModel, e: BrepEdgeIndex, range: NumberInterval): Angle
    {
        var seeds = m.EdgeSeedsGiven(e, range);
        var tangents = (seeds.Count - 1).Range.FlatMap(k => m.SpanTangents(e, seeds[k], seeds[k + 1]));
        return Angle((tangents.Count - 1).Max(0).MapRange(i => tangents[i].AngleOrZero(tangents[i + 1]).Radians).SumOf);
    }

    // Layer 4's TotalTurning with the edge domain given, the closed form computed once:
    // TotalTurning(m, e) is m.TotalTurningGiven(e, m.EdgeDomain(e).Range).
    TotalTurningGiven(m: BrepModel, e: BrepEdgeIndex, range: NumberInterval): Angle
    {
        var closed = m.Geometry.CurveAt(m.Edges[e].Curve).ClosedFormTurning(range);
        return closed.Radians >= 0.0 ? closed : m.SampledTurningGiven(e, range);
    }

    //==
    // # Counts

    // Layer 4's TurnFloor with the edge domain given.
    TurnFloorGiven(m: BrepModel, e: BrepEdgeIndex, range: NumberInterval): Integer
        => (m.TotalTurningGiven(e, range).Radians / (Number.Tau / 3.0)).Ceiling.ToInteger.Max(1);

    // Chunk E1's MinimumSegmentCountGiven with the edge domain and the degeneracy given:
    // MinimumSegmentCountGiven(m, e, c, floors, two) is
    // m.MinimumSegmentCountRanged(e, c, floors, two, range, m.IsDegenerateEdgeGiven(e, range))
    // for range = m.EdgeDomain(e).Range.
    MinimumSegmentCountRanged(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors, inTwoEdgeLoop: Boolean, range: NumberInterval, degenerate: Boolean): Integer
        => degenerate
            ? 1
            : floors.FloorOf(e)
                .Max((m.IsClosedEdge(e) ? degenerate.Not : false) ? c.ClosedEdgeMinimum : 1)
                .Max(inTwoEdgeLoop ? 2 : 1)
                .Max(m.TurnFloorGiven(e, range));

    // Layer 4's ConicSegmentCount with the edge domain given.
    ConicCountGiven(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, least: Integer, range: NumberInterval): Integer
        => m.Geometry.CurveAt(m.Edges[e].Curve).ConicCount(range, c, m.Tolerances, least, false);

    // Layer 4's ConicSegmentCap with the edge domain given.
    ConicCapGiven(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, least: Integer, range: NumberInterval): Integer
        => m.Geometry.CurveAt(m.Edges[e].Curve).ConicCount(range, c, m.Tolerances, least, true);

    //==
    // # Images the edge lies on

    // Termination's GapProbe with the edge domain given.
    GapProbeGiven(m: BrepModel, e: BrepEdgeIndex, range: NumberInterval): EdgeDiscretization
        => m.DiscretizationAt(e, range.Samples(3));

    // Termination's IsOffSurface with the edge's probe given: IsOffSurface(m, e, img, c) is
    // m.IsOffSurfaceAt(m.GapProbe(e), img, c).
    IsOffSurfaceAt(m: BrepModel, probe: EdgeDiscretization, img: EdgeImage, c: DiscretizationCriteria): Boolean
        => m.IsImageEvaluable(img) ? m.ImageGap(probe, img) > m.ImageBound(c) : false;

    // Chunk E1's UsableImagesFrom with the edge domain given, the probe built once per edge,
    // not once per image.
    UsableImagesGiven(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, all: Array<EdgeImage>, range: NumberInterval): Array<EdgeImage>
    {
        var probe = m.GapProbeGiven(e, range);
        return all.FlatMap(img => (m.IsImageEvaluable(img) ? m.IsOffSurfaceAt(probe, img, c).Not : false) ? [img] : all.Take(0));
    }

    //==
    // # Discretize

    // Termination's UniformExceeds with the edge domain given.
    UniformExceedsGiven(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, count: Integer, images: Array<EdgeImage>, range: NumberInterval): Boolean
        => m.ImagesExceedChordalOn(m.DiscretizationAt(e, range.Samples(count + 1)), c, images);

    // Termination's RaisedForImagesBounded with the edge domain given: RaisedForImagesBounded(m,
    // e, c, n, cap, images) is m.RaisedForImagesGiven(e, c, n, cap, images, m.EdgeDomain(e).Range).
    RaisedForImagesGiven(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, n: Integer, cap: Integer, images: Array<EdgeImage>, range: NumberInterval): Integer
    {
        if (n >= cap || m.UniformExceedsGiven(e, c, n, images, range).Not)
        {
            return n;
        }
        var failing = n;
        var trial = (2 * n).Min(cap);
        var passes = m.UniformExceedsGiven(e, c, trial, images, range).Not;
        while (passes.Not && trial < cap)
        {
            failing = trial;
            trial = (2 * trial).Min(cap);
            passes = m.UniformExceedsGiven(e, c, trial, images, range).Not;
        }
        if (passes.Not)
        {
            return cap;
        }
        var passing = trial;
        while (passing - failing > 1)
        {
            var middle = (failing + passing) / 2;
            if (m.UniformExceedsGiven(e, c, middle, images, range))
            {
                failing = middle;
            }
            else
            {
                passing = middle;
            }
        }
        return passing;
    }

    // Termination's BisectedParametersOn with the edge domain given.
    BisectedParametersGiven(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, images: Array<EdgeImage>, range: NumberInterval): Array<Number>
        => m.BisectedCachedCounted(e, c, images, range).Value.Parameters;

    // Chunk E1's DiscretizeBoundedOnIndexed with the edge domain and the degeneracy given:
    // DiscretizeBoundedOnIndexed(m, e, c, least, images) is
    // m.DiscretizeBoundedOnRanged(e, c, least, images, range, m.IsDegenerateEdgeGiven(e, range))
    // for range = m.EdgeDomain(e).Range.
    DiscretizeBoundedOnRanged(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, least: Integer, images: Array<EdgeImage>, range: NumberInterval, degenerate: Boolean): EdgeDiscretization
        => m.DiscretizeBoundedOnCached(e, c, least, images, range, degenerate);

    // Chunk E1's DiscretizeTabled with the edge domain given: DiscretizeTabled(m, t, two, e, c,
    // floors) is m.DiscretizeRanged(t, two, e, c, floors, m.EdgeDomain(e).Range). The degeneracy
    // is decided once, where the reference decides it three times.
    DiscretizeRanged(m: BrepModel, t: EdgeFaceTable, twoEdgeLoop: Array<Boolean>, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors, range: NumberInterval): EdgeDiscretization
    {
        var degenerate = m.IsDegenerateEdgeGiven(e, range);
        return m.DiscretizeBoundedOnRanged(
            e,
            c,
            m.MinimumSegmentCountRanged(e, c, floors, twoEdgeLoop[e.Value], range, degenerate),
            m.UsableImagesGiven(e, c, t.EdgeImagesIn(m, e), range),
            range,
            degenerate);
    }

    //==
    // # Every edge

    // The entry DiscretizeAll makes for edge e, given whether the model's indices are in range
    // and the tables built from m, with the edge domain computed once when the edge passes the
    // index checks and never otherwise: Projections counts those computations, 0 or 1. The entry
    // is chunk E1's (CanDiscretizeInRange behind inRange, then DiscretizeTabled, else
    // Undiscretized), bit for bit.
    DiscretizeEdgeRangedCounted(m: BrepModel, t: EdgeFaceTable, twoEdgeLoop: Array<Boolean>, inRange: Boolean, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors): Counted<EdgeDiscretization>
    {
        if ((inRange ? (c.IsWellFormed && m.IsEdgeEvaluable(e)) : false).Not)
        {
            return Counted(Undiscretized(e), Projections(0));
        }
        var range = m.EdgeDomain(e).Range;
        return Counted(range.Start < range.End ? m.DiscretizeRanged(t, twoEdgeLoop, e, c, floors, range) : Undiscretized(e), Projections(1));
    }

    // Chunk E1's DiscretizeAllTabledCounted with each edge's domain computed once: its work
    // (the table passes' Insertions, one Flips for the index scan) plus one Projections per edge
    // domain computed, at most one per edge, where the reference computes about 12 + 3I + n per
    // edge. The entries are DiscretizeAll's, bit for bit.
    DiscretizeAllRangedCounted(m: BrepModel, c: DiscretizationCriteria, floors: SegmentFloors): Counted<EdgeDiscretizations>
    {
        var inRange = m.Law_IndicesInRange;
        var faces = m.EdgeFaceTableCounted;
        var loops = m.TwoEdgeLoopEdgesCounted;
        var t = faces.Value;
        var two = loops.Value;
        var entries = m.Edges.Count.MapRange(i => m.DiscretizeEdgeRangedCounted(t, two, inRange, BrepEdgeIndex(i), c, floors));
        var table = EdgeDiscretizations(entries.Map(x => x.Value));
        var reads = entries.Reduce(0, (n, x) => x.Value.IsDiscretized ? n + t.FaceCountOf(x.Value.Edge) : n);
        var ranges = entries.Reduce(0, (n, x) => n + x.Work.Projections);
        return Counted(table, faces.Work.Add(loops.Work).Add(Insertions(reads)).Add(Flips(1)).Add(Projections(ranges)));
    }

    // DiscretizeAll with the tables built once per model and each edge's domain once per edge.
    DiscretizeAllRanged(m: BrepModel, c: DiscretizationCriteria, floors: SegmentFloors): EdgeDiscretizations
        => m.DiscretizeAllRangedCounted(c, floors).Value;

    //==
    // # The per-segment test
    //
    // The four laws termination's SegmentMeetsCriteriaOn asks each begin with IsEvaluableSegment,
    // which asks IsEvaluable(d): n edge domains per law per segment. Their bodies past that
    // guard are below; at merge each law becomes `m.IsEvaluableSegment(d, i) ? <body> : true`
    // (Law_ImageChordWithinChordal also asks m.IsImageEvaluable(img)), and the test takes the
    // guard once per discretization.

    // Law_CertifiedSagittaWithinChordal past its guard.
    CertifiedSagittaHolds(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, i: Integer): Boolean
        => m.Sagitta(d.Edge, d.Parameters[i].Min(d.Parameters[i + 1]), d.Parameters[i].Max(d.Parameters[i + 1]))
                <= c.EffectiveChordal(m.Tolerances) + m.Tolerances.Length.Value
            || m.IsAtLengthFloor(d, c, i);

    // Law_TangentDeviationWithinHalfAngular past its guard.
    TangentDeviationHolds(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, plan: SamplePlan, i: Integer): Boolean
        => m.TangentDeviation(d, plan, i) <= c.EffectiveAngular * 0.5 + m.Tolerances.Angle.Value
            || m.IsAtLengthFloor(d, c, i);

    // Law_SegmentWithinMaxLength past its guard.
    SegmentMaxLengthHolds(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, i: Integer): Boolean
        => (d.SegmentLength(i) - m.Tolerances.Length.Value).IsWithinLimit(c.MaxLength)
            || m.IsAtLengthFloor(d, c, i);

    // Law_ImageChordWithinChordal past its guard (segment and image evaluable).
    ImageChordHolds(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, img: EdgeImage, plan: SamplePlan, i: Integer): Boolean
    {
        var deviations = m.ImageChordDeviations(d, img, plan);
        return deviations.IsValidIndex(i)
            ? (deviations[i] <= c.EffectiveChordal(m.Tolerances) + 2.0 * m.Tolerances.Length.Value
                || m.IsAtLengthFloor(d, c, i))
            : true;
    }

    // Termination's SegmentMeetsCriteriaOn with IsEvaluable(d) given as evaluable:
    // SegmentMeetsCriteriaOn(m, d, c, i, images) is
    // m.SegmentMeetsCriteriaGiven(d, c, i, images, m.IsEvaluable(d)).
    SegmentMeetsCriteriaGiven(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, i: Integer, images: Array<EdgeImage>, evaluable: Boolean): Boolean
        => (evaluable ? d.IsSegmentIndex(i) : false)
            ? (m.CertifiedSagittaHolds(d, c, i)
                && m.TangentDeviationHolds(d, c, SamplePlan.DiscretizationPlan, i)
                && m.SegmentMaxLengthHolds(d, c, i)
                && images.All(img => m.IsImageEvaluable(img) ? m.ImageChordHolds(d, c, img, SamplePlan.DiscretizationPlan, i) : true))
            : true;

    // Layer 4's MeetsCriteria with the edge domain computed once, not once per law per segment
    // per parameter: MeetsCriteria(m, d, c) is m.MeetsCriteriaRanged(d, c).
    MeetsCriteriaRanged(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria): Boolean
    {
        if (m.IsEdgeEvaluable(d.Edge).Not)
        {
            return false;
        }
        if (d.IsEvaluableGiven(m.EdgeDomain(d.Edge).Range).Not)
        {
            return false;
        }
        var images = m.EdgeImages(d.Edge);
        return d.SegmentCount.MapRange(i => m.SegmentMeetsCriteriaGiven(d, c, i, images, true)).All(x => x);
    }

    //==
    // # Refinement

    // Termination's RefinedHalfOn with the edge domain given.
    RefinedHalfGiven(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, a: Number, b: Number, depth: Integer, images: Array<EdgeImage>, range: NumberInterval): Array<Number>
    {
        var piece = m.PieceOf(e, a, b);
        return m.SegmentMeetsCriteriaGiven(piece, c, 0, images, piece.IsEvaluableGiven(range))
            ? [a].Take(0)
            : m.RefinedSpanGiven(e, c, a, b, depth, images, range);
    }

    // Termination's RefinedSpanOn with the edge domain given.
    RefinedSpanGiven(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, a: Number, b: Number, depth: Integer, images: Array<EdgeImage>, range: NumberInterval): Array<Number>
        => depth < 40
            ? m.RefinedHalfGiven(e, c, a, (a + b) * 0.5, depth + 1, images, range)
                .Concatenate([(a + b) * 0.5])
                .Concatenate(m.RefinedHalfGiven(e, c, (a + b) * 0.5, b, depth + 1, images, range))
            : [a].Take(0);

    // Termination's RefinedParametersOn with the edge domain given, IsEvaluable(d) asked once.
    RefinedParametersGiven(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, images: Array<EdgeImage>, range: NumberInterval): Array<Number>
        => m.RefinedParametersIndexed(d, c, images, range);

    // Termination's RefineEdgeBoundedOn with the edge domain given: RefineEdgeBoundedOn(m, d, c,
    // segments, images) is m.RefineEdgeBoundedRanged(d, c, segments, images,
    // m.EdgeDomain(d.Edge).Range). Precondition: d's edge is evaluable (Refine's IsRefinable).
    RefineEdgeBoundedRanged(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, segments: Integer, images: Array<EdgeImage>, range: NumberInterval): EdgeDiscretization
        => m.IsDegenerateEdgeGiven(d.Edge, range)
            ? d
            : m.DiscretizationAt(d.Edge, m.RaisedToCount(m.RefinedParametersGiven(d, c, images, range), segments));

    // Chunk E1's RefineEdgeIn with the edge domain computed once: RefineEdgeIn(t, m, d, c,
    // segments) is t.RefineEdgeRangedIn(m, d, c, segments). Precondition: d's edge is evaluable.
    RefineEdgeRangedIn(t: EdgeFaceTable, m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, segments: Integer): EdgeDiscretization
    {
        var range = m.EdgeDomain(d.Edge).Range;
        return m.RefineEdgeBoundedRanged(d, c, segments, m.UsableImagesGiven(d.Edge, c, t.EdgeImagesIn(m, d.Edge), range), range);
    }

    // Chunk E1's RefineTabled with each requested edge's domain computed once.
    RefineRanged(m: BrepModel, d: EdgeDiscretizations, requests: Array<EdgeRefinementRequest>, c: DiscretizationCriteria): EdgeDiscretizations
        => m.RefineIndexed(d, requests, c);

    //==
    // # Findings

    // Chunk E1's EdgeFindingsFrom with the edge domain given: the probe built once, not once per
    // image, and IsEvaluable(d) without a domain per parameter. Precondition: d's edge is
    // evaluable.
    EdgeFindingsGiven(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, all: Array<EdgeImage>, images: Array<EdgeImage>, range: NumberInterval): Array<Diagnostic>
    {
        if (d.IsEvaluableGiven(range).Not)
        {
            return Diagnostic.NoDiagnostics;
        }
        var probe = m.GapProbeGiven(d.Edge, range);
        var offSurface = all.FlatMap(img => m.IsOffSurfaceAt(probe, img, c)
            ? [OffSurfaceEdge(d.Edge, m.ImageGap(probe, img))]
            : Diagnostic.NoDiagnostics);
        var failing = d.SegmentCount.Range.Reduce(0, (n, i) =>
            (m.IsAtLengthFloor(d, c, i) ? m.SegmentFailsOn(d.Edge, c, d.Parameters[i], d.Parameters[i + 1], images) : false) ? n + 1 : n);
        return failing > 0 ? offSurface.Concatenate([NotConvergedEdge(d.Edge, failing)]) : offSurface;
    }

    // Chunk E1's EdgeFindingsIn with the edge domain computed once per evaluable edge:
    // EdgeFindingsIn(t, m, d, c) is t.EdgeFindingsRangedIn(m, d, c).
    EdgeFindingsRangedIn(t: EdgeFaceTable, m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria): Array<Diagnostic>
    {
        if (m.IsEdgeEvaluable(d.Edge).Not)
        {
            return Diagnostic.NoDiagnostics;
        }
        var range = m.EdgeDomain(d.Edge).Range;
        var all = t.EdgeImagesIn(m, d.Edge);
        return m.EdgeFindingsGiven(d, c, all, m.UsableImagesGiven(d.Edge, c, all, range), range);
    }

    // Chunk E1's DiscretizationFindingsTabled with each edge's domain computed once.
    DiscretizationFindingsRanged(m: BrepModel, ds: EdgeDiscretizations, c: DiscretizationCriteria): Array<Diagnostic>
    {
        var t = m.EdgeFaceTable;
        return ds.ByEdge.FlatMap(d => t.EdgeFindingsRangedIn(m, d, c));
    }
}

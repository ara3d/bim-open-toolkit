//==
// # Counted forms of edge discretization: laws (complexity sweep)
//
// The first Witness_*Work claim: RaisedToCount's raises are at most one per segment asked
// for, measured at two sizes of one family (a two-parameter list raised to 8 and to 32
// segments). Law_WorkIsWithinSlope (layer 00) reads it. The laws here only tie the counted
// form to the plain one.
//
// Sections, in order:
//  - Witness
//  - Agreement

library EdgeDiscretizingWorkLaws
{
    //==
    // # Witness

    // The work of raising the unit interval to n segments.
    RaisedWork(n: Integer): WorkBudget
        => BrepModel.Witness_UnitBox.RaisedToCountCounted([0.0, 1.0], n).Work;

    // RaisedToCount does at most one raise per segment asked for, at 8 and at 32 segments.
    Witness_RaisedToCountWork(_: WorkClaim): WorkClaim
        => WorkClaim("RaisedToCount: raises per segment", WorkBudgetOf(0, 0, 1, 0), [8, 32], n => RaisedWork(n));

    //==
    // # Agreement

    // The counted form returns the plain form's parameters.
    Law_RaisedToCountCountedAgrees(n: Integer): Boolean
    {
        var least = ((n % 16) + 16) % 16;
        var plain = BrepModel.Witness_UnitBox.RaisedToCount([0.0, 1.0], least);
        var counted = BrepModel.Witness_UnitBox.RaisedToCountCounted([0.0, 1.0], least).Value;
        return plain.Count == counted.Count && plain.Count.Range.All(i => plain[i] == counted[i]);
    }

    // The raises counted are exactly the segments added.
    Law_RaisedToCountCountsItsRaises(n: Integer): Boolean
    {
        var least = ((n % 16) + 16) % 16;
        var c = BrepModel.Witness_UnitBox.RaisedToCountCounted([0.0, 1.0], least);
        return c.Work.Flips == (c.Value.Count - 2).Max(0);
    }
}

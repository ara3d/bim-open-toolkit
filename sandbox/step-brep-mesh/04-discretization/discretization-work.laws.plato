//==
// # Counted forms of edge discretization: laws (complexity sweep)
//
// The counted form of RaisedToCount (W0) stays as the reference the heap form (chunk R6,
// 08-pipeline/pipeline-refine-indexed.laws.plato, which also holds the count witness that
// replaced W0's) is compared against; the laws here tie it to the plain one.
//
// Sections, in order:
//  - Agreement

library EdgeDiscretizingWorkLaws
{
    //==
    // # Agreement

    // The counted form returns the plain form's parameters.
    Law_RaisedToCountCountedAgrees(n: Integer): Boolean
    {
        var least = ((n % 16) + 16) % 16;
        var plain = BrepModel.Witness_UnitBox.RaisedToCount([0.0, 1.0], least);
        var counted = BrepModel.Witness_UnitBox.RaisedToCountCounted([0.0, 1.0], least).Value;
        return plain.Count == counted.Count && plain.Count.Range.All(i => plain[i] == counted[i]);
    }

    // The raises counted are exactly the segments added.
    Law_RaisedToCountCountsItsRaises(n: Integer): Boolean
    {
        var least = ((n % 16) + 16) % 16;
        var c = BrepModel.Witness_UnitBox.RaisedToCountCounted([0.0, 1.0], least);
        return c.Work.Flips == (c.Value.Count - 2).Max(0);
    }
}

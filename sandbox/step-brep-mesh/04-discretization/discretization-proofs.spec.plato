//==
// # Specs of the discretization proofs
//
// One spec per proof type of discretization-proofs.types.plato: the
// invariant its value keeps and the single function permitted to build it.
// The laws named beside them mesh layer 8's witness criteria, so they are
// in 08-pipeline/pipeline-proofs-discretization.laws.plato. m is the model
// the constructor was given. Not compiled; the runner skips this file.
//
// Sections, in order:
//  - Whole tables
//  - One edge

//==
// # Whole tables

spec CompleteDiscretization
{
    invariant self.ByEdge.Count == m.Edges.Count;
    invariant forall (i: Integer) in self.ByEdge.Count.Range : self.ByEdge[i].IsDiscretized;   // Law_CompleteDiscretizationIffAllDiscretized
    constructor CheckCompleteDiscretization;
}

spec PartialDiscretization
{
    invariant self.ByEdge.Count == m.Edges.Count;
    invariant self.Failed.Count > 0;   // Law_PartialDiscretizationIffSomeFailed
    invariant forall (e: BrepEdgeIndex) in self.Failed : self.ByEdge[e.Value].IsDiscretized.Not;   // Law_PartialDiscretizationListsFailures
    constructor CheckPartialDiscretization;
}

//==
// # One edge

spec CanonicalDiscretization
{
    invariant m.IsEvaluable(self.Discretization);
    invariant m.IsCanonical(self.Discretization);   // Law_CanonicalDiscretizationIffCanonical
    constructor CheckCanonicalDiscretization;
}

spec DirectedDiscretization
{
    // c is the canonical polyline the constructor was given.
    invariant self.Sense == Sense.Same
        ? self.Discretization.SameDiscretization(c.Discretization)
        : self.Discretization.SameDiscretization(c.Discretization.Reversed);   // Law_DirectedAlongReversesOnlyWhenOpposite
    constructor DirectedAlong;
}

spec MeetsCriteriaProof
{
    // d is the polyline the constructor was given.
    invariant self.Edge == d.Edge && m.MeetsCriteria(d, self.Criteria);   // Law_MeetsCriteriaProofIffMeetsCriteria
    invariant self.Worst.Value == m.WorstSagitta(d);   // Law_MeetsCriteriaProofRecordsWorst
    constructor CheckMeetsCriteriaProof;
}

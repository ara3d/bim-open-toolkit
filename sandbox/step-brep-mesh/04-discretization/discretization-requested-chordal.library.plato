//==
// # Refine lowers the length floor with the chordal bound (TKT-454)
//
// Layer 4's Refine answers a request by refining the edge under c.WithChordal(requested), which
// keeps c.MinLength. DefaultCriteria sets MinLength to a tenth of the chordal bound, so at a 1 mm
// bound no segment under 0.2 mm is ever split, whatever bound a face asks for (u-blox CAM face 124:
// two one-segment arcs asked for 0.0029 mm came back unchanged). WithRequestedChordal scales
// MinLength by the same factor as the chordal bound, so the ratio the criteria were built with
// holds; a zero requested bound (a face asking about a straight edge) keeps MinLength, so a curved
// edge asked for 0 is never bisected down to the model tolerance. RefineIndexedCounted
// (discretization-refine-indexed.library.plato) refines each requested edge under it.

library DiscretizationRequestedChordal
{
    // c with chordal bound `chordal` and the length floor lowered by the same factor when chordal
    // is positive and below c's bound; c's floor otherwise.
    WithRequestedChordal(c: DiscretizationCriteria, chordal: Number): DiscretizationCriteria
        => (chordal > 0.0 && chordal < c.Chordal)
            ? DiscretizationCriteria(chordal, c.Angular, c.MaxLength, c.MinLength * (chordal / c.Chordal), c.MinSegments)
            : c.WithChordal(chordal);
}

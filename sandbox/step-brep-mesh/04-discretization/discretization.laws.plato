//==
// # Edge discretization: laws
//
// Two kinds, as in research/VALIDATION-MATH.md section 8. Model laws take a discretization as data
// and are what validation checks on any polyline, whoever made it; `Discretize` promises them for
// its results (discretization.spec.plato). Library laws call this layer's functions and hold for
// every input that meets the guards; they are run on witnesses.
//
// Conventions (SPEC-DSL.md section 2): one statement per law; a leading guard written with `? :`
// makes a law vacuously true where its precondition fails, so every law is total; a pointwise law
// takes the segment or sample index as a parameter. Every approximate comparison is against a
// criterion widened by the model's own tolerance of the same dimension (`Tolerances.Length`,
// `Tolerances.Angle`): a criterion exceeded by less than the file's own
// uncertainty is met. Exact `==` on a `Number` or a `Point3D` appears only where the value is
// copied, never computed: end points, seeds, reversal, refinement.
//
// Sections, in order:
//  - Helpers
//  - Shape
//  - Agreement with the model
//  - Criteria
//  - Counts
//  - Parameter-space images
//  - Reversal and sharing
//  - Monotonicity and refinement
//  - Circular arcs

library EdgeDiscretizingLaws
{
    //==
    // # Helpers

    // True when i names a segment of the discretization.
    IsSegmentIndex(d: EdgeDiscretization, i: Integer): Boolean
        => i >= 0 && i + 1 < d.Parameters.Count && i + 1 < d.Points.Count;

    // The guard shared by every law that evaluates the curve on segment i.
    IsEvaluableSegment(m: BrepModel, d: EdgeDiscretization, i: Integer): Boolean
        => m.IsEvaluable(d) && d.IsSegmentIndex(i);

    //==
    // # Shape
    //
    // Invariants of every `EdgeDiscretization` the library makes, in either direction. Exact.
    //
    // Laws over a value that only one function produces take that function's inputs and compute
    // the value inside (decision F-54, reviews/FINDINGS.md): the runner generates arbitrary
    // values of every parameter type, and a discretization nothing made need not have any of
    // these properties. Each claim is also a predicate of the same name without `Law_`, which
    // the contracts and layer 7's checks apply to the values they hold. The laws below take
    // `DiscretizedEntry`'s inputs, the entry `DiscretizeAll` makes for one edge (`Discretize`
    // when `CanDiscretize` accepts the edge, `Undiscretized` otherwise).

    // There is one parameter per point.
    ParameterCountEqualsPointCount(d: EdgeDiscretization): Boolean
        => d.Parameters.Count == d.Points.Count;

    // ParameterCountEqualsPointCount on the entry DiscretizeAll makes for edge e.
    Law_ParameterCountEqualsPointCount(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors): Boolean
        => m.DiscretizedEntry(e, c, floors).ParameterCountEqualsPointCount;

    // There are at least two samples, so at least one segment, or none at all (`Undiscretized`,
    // the entry of an edge `CanDiscretize` rejects).
    EmptyOrAtLeastTwoParameters(d: EdgeDiscretization): Boolean
        => d.Parameters.Count == 0 || d.Parameters.Count >= 2;

    // EmptyOrAtLeastTwoParameters on the entry DiscretizeAll makes for edge e.
    Law_EmptyOrAtLeastTwoParameters(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors): Boolean
        => m.DiscretizedEntry(e, c, floors).EmptyOrAtLeastTwoParameters;

    // Entry i of ds, a result of `DiscretizeAll` under c, is empty exactly when `CanDiscretize`
    // rejects its edge.
    UndiscretizedExactlyWhenUnusable(m: BrepModel, ds: EdgeDiscretizations, c: DiscretizationCriteria, i: Integer): Boolean
        => ds.ByEdge.IsValidIndex(i)
            ? ds.ByEdge[i].IsDiscretized == m.CanDiscretize(BrepEdgeIndex(i), c)
            : true;

    // UndiscretizedExactlyWhenUnusable on DiscretizeAll's result. Structural: exact.
    Law_UndiscretizedExactlyWhenUnusable(m: BrepModel, c: DiscretizationCriteria, floors: SegmentFloors, i: Integer): Boolean
        => m.UndiscretizedExactlyWhenUnusable(m.DiscretizeAll(c, floors), c, i);

    // Consecutive parameters move in the direction of the whole array: strictly increasing in a
    // canonical value, strictly decreasing in a reversed one.
    Law_ParametersStrictlyMonotone(d: EdgeDiscretization, i: Integer): Boolean
        => (i >= 0 && i + 1 < d.Parameters.Count)
            ? (d.RunsAlongCurve
                ? d.Parameters[i] < d.Parameters[i + 1]
                : d.Parameters[i] > d.Parameters[i + 1])
            : true;

    // Consecutive parameters strictly increase: the canonical direction, which every result of
    // `Discretize` and `RefineEdge` and every entry of `EdgeDiscretizations` has.
    ParametersStrictlyIncreasing(d: EdgeDiscretization, i: Integer): Boolean
        => (i >= 0 && i + 1 < d.Parameters.Count)
            ? d.Parameters[i] < d.Parameters[i + 1]
            : true;

    // ParametersStrictlyIncreasing at position i of the entry DiscretizeAll makes for edge e.
    Law_ParametersStrictlyIncreasing(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors, i: Integer): Boolean
        => m.DiscretizedEntry(e, c, floors).ParametersStrictlyIncreasing(i);

    //==
    // # Agreement with the model
    //
    // Stated for either direction: the end whose parameter is the domain start is the domain-start
    // end, wherever it sits in the arrays.

    // The lowest parameter is the edge domain's start, exactly.
    LowestParameterIsDomainStart(m: BrepModel, d: EdgeDiscretization): Boolean
        => (m.IsEdgeEvaluable(d.Edge) && d.Parameters.Count >= 2)
            ? (d.RunsAlongCurve ? d.Parameters.First : d.Parameters.Last) == m.EdgeDomain(d.Edge).Range.Start
            : true;

    // LowestParameterIsDomainStart on the entry DiscretizeAll makes for edge e.
    Law_LowestParameterIsDomainStart(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors): Boolean
        => m.LowestParameterIsDomainStart(m.DiscretizedEntry(e, c, floors));

    // The highest parameter is the edge domain's end, exactly.
    HighestParameterIsDomainEnd(m: BrepModel, d: EdgeDiscretization): Boolean
        => (m.IsEdgeEvaluable(d.Edge) && d.Parameters.Count >= 2)
            ? (d.RunsAlongCurve ? d.Parameters.Last : d.Parameters.First) == m.EdgeDomain(d.Edge).Range.End
            : true;

    // HighestParameterIsDomainEnd on the entry DiscretizeAll makes for edge e.
    Law_HighestParameterIsDomainEnd(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors): Boolean
        => m.HighestParameterIsDomainEnd(m.DiscretizedEntry(e, c, floors));

    // Point i lies on the edge's curve at parameter i, within the model's length tolerance. Exact
    // for interior points, which are evaluations; within the tolerance for the end points, which
    // are vertex points and may sit that far from the curve's ends.
    Law_PointsLieOnCurve(m: BrepModel, d: EdgeDiscretization, i: Integer): Boolean
        => (m.IsEvaluable(d) && d.Points.IsValidIndex(i))
            ? d.Points[i].Distance(m.PointOnEdge(d.Edge, d.Parameters[i])) <= m.Tolerances.Length.Value
            : true;

    // The point at the domain start is the domain-start vertex's point, exactly (copied).
    Law_DomainStartPointIsVertex(m: BrepModel, d: EdgeDiscretization): Boolean
        => m.IsEvaluable(d)
            ? d.Points[d.RunsAlongCurve ? 0 : d.Points.Count - 1] == m.Vertices[m.DomainStartVertex(d.Edge)].Point
            : true;

    // The point at the domain end is the domain-end vertex's point, exactly (copied).
    Law_DomainEndPointIsVertex(m: BrepModel, d: EdgeDiscretization): Boolean
        => m.IsEvaluable(d)
            ? d.Points[d.RunsAlongCurve ? d.Points.Count - 1 : 0] == m.Vertices[m.DomainEndVertex(d.Edge)].Point
            : true;

    // Seed k of the edge (a domain end, a breakpoint, a knot) is one of the parameters, exactly.
    SeedsAreSampled(m: BrepModel, d: EdgeDiscretization, k: Integer): Boolean
        => m.IsEdgeEvaluable(d.Edge)
            ? (m.EdgeSeeds(d.Edge).IsValidIndex(k) ? d.ContainsParameter(m.EdgeSeeds(d.Edge)[k]) : true)
            : true;

    // SeedsAreSampled at seed k of Discretize's result for edge e, which only an edge
    // CanDiscretize accepts has (Undiscretized samples nothing).
    Law_SeedsAreSampled(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors, k: Integer): Boolean
        => m.CanDiscretize(e, c) ? m.SeedsAreSampled(m.Discretize(e, c, floors), k) : true;

    // A degenerate edge has exactly two parameters: one segment over its collapsed curve.
    Law_DegenerateEdgeHasOneSegment(m: BrepModel, d: EdgeDiscretization): Boolean
        => m.IsEdgeEvaluable(d.Edge)
            ? (m.IsDegenerateEdge(d.Edge) ? d.Parameters.Count == 2 : true)
            : true;

    //==
    // # Criteria
    //
    // Geometric: a failure is a Warning below ten times the criterion and an Error above
    // (SPEC-DSL.md section 4). Each holds unless the refinement floor stopped the segment
    // (`IsAtLengthFloor`), which validation reports as Info.

    // The sampled sagitta of segment i is at most the effective chordal bound, widened by the
    // length tolerance (which also covers end points that sit up to that far off the curve).
    Law_SagittaWithinChordal(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, plan: SamplePlan, i: Integer): Boolean
        => m.IsEvaluableSegment(d, i)
            ? (m.SampledSagitta(d, plan, i) <= c.EffectiveChordal(m.Tolerances) + m.Tolerances.Length.Value
                || m.IsAtLengthFloor(d, c, i))
            : true;

    // The certified form: the exact sagitta of segment i's arc (`Sagitta`, from its closed form or
    // a control-hull bound, never from samples) is at most the effective chordal bound, widened
    // by the length tolerance, or the floor stopped the segment. The sampled law above is what
    // validation can measure on any polyline; this one is what `Discretize` promises, and a
    // sampled check can miss a bump between its samples. A library law.
    Law_CertifiedSagittaWithinChordal(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, i: Integer): Boolean
        => m.IsEvaluableSegment(d, i)
            ? (m.Sagitta(d.Edge, d.Parameters[i].Min(d.Parameters[i + 1]), d.Parameters[i].Max(d.Parameters[i + 1]))
                    <= c.EffectiveChordal(m.Tolerances) + m.Tolerances.Length.Value
                || m.IsAtLengthFloor(d, c, i))
            : true;

    // Segment i's chord stays within half the effective angular bound of the curve's tangent at
    // the sampled interior points, widened by the angle tolerance. Covers single-segment edges
    // and end segments, which have no turning angle.
    Law_TangentDeviationWithinHalfAngular(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, plan: SamplePlan, i: Integer): Boolean
        => m.IsEvaluableSegment(d, i)
            ? (m.TangentDeviation(d, plan, i) <= c.EffectiveAngular * 0.5 + m.Tolerances.Angle.Value
                || m.IsAtLengthFloor(d, c, i))
            : true;

    // The turning angle at interior point i is at most the effective angular bound, widened by
    // the angle tolerance, unless point i is a seed (where the curve itself may turn) or a segment
    // beside it was stopped by the refinement floor.
    Law_TurningAngleWithinAngular(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, i: Integer): Boolean
        => (m.IsEvaluable(d) && i >= 1 && i + 1 < d.Points.Count)
            ? (d.TurningAngle(i) <= c.EffectiveAngular + m.Tolerances.Angle.Value
                || m.IsSeedParameter(d.Edge, d.Parameters[i])
                || m.IsAtLengthFloor(d, c, i - 1)
                || m.IsAtLengthFloor(d, c, i))
            : true;

    // Segment i's chord is no longer than the length limit, widened by the length tolerance.
    Law_SegmentWithinMaxLength(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, i: Integer): Boolean
        => m.IsEvaluableSegment(d, i)
            ? ((d.SegmentLength(i) - m.Tolerances.Length.Value).IsWithinLimit(c.MaxLength)
                || m.IsAtLengthFloor(d, c, i))
            : true;

    // A chord shorter than the effective minimum length (less the length tolerance) was forced:
    // the segment is a whole seed span (which covers an edge shorter than the minimum), or the
    // segment count is no more than the edge's floor. Criteria never split below the minimum.
    // Quality: a failure is Info.
    Law_ShortSegmentIsForced(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, floors: SegmentFloors, i: Integer): Boolean
        => m.IsEvaluableSegment(d, i)
            ? (d.SegmentLength(i) >= c.EffectiveMinLength(m.Tolerances) - m.Tolerances.Length.Value
                || m.IsSeedSegment(d, i)
                || d.SegmentCount <= m.MinimumSegmentCount(d.Edge, c, floors))
            : true;

    //==
    // # Counts
    //
    // Structural: exact; a failure is an Error.

    // A closed edge that is not degenerate has at least `MinSegments` segments, and at least 3.
    ClosedEdgeHasMinSegments(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria): Boolean
        => m.IsEdgeEvaluable(d.Edge)
            ? (m.IsClosedRegularEdge(d.Edge) ? d.SegmentCount >= c.ClosedEdgeMinimum : true)
            : true;

    // ClosedEdgeHasMinSegments on Discretize's result for edge e under c, which only an edge
    // CanDiscretize accepts has (an Undiscretized entry has no segment to count).
    Law_ClosedEdgeHasMinSegments(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors): Boolean
        => m.CanDiscretize(e, c) ? m.ClosedEdgeHasMinSegments(m.Discretize(e, c, floors), c) : true;

    // A non-degenerate edge has at least its minimum segment count: the caller's floor, the
    // closed-edge minimum, the two-edge-loop floor, and the turn floor.
    Law_SegmentFloorMet(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, floors: SegmentFloors): Boolean
        => m.IsEdgeEvaluable(d.Edge)
            ? d.SegmentCount >= m.MinimumSegmentCount(d.Edge, c, floors)
            : true;

    //==
    // # Parameter-space images

    // An image has one parameter-space point per polyline point. Exact.
    Law_ImageHasOnePointPerPoint(m: BrepModel, d: EdgeDiscretization, img: EdgeImage): Boolean
        => (m.IsEvaluable(d) && m.IsImageEvaluable(img))
            ? m.ImagePoints(d, img).Count == d.Points.Count
            : true;

    // The surface at image point i is polyline point i, within twice the length tolerance: once
    // for the pcurve's agreement with the curve, once for an end point's distance from the curve.
    // Holds at a pole too, where any parameter maps to the pole.
    Law_ImagePointReevaluates(m: BrepModel, d: EdgeDiscretization, img: EdgeImage, i: Integer): Boolean
    {
        var ok = m.IsEvaluable(d) && m.IsImageEvaluable(img) && d.Points.IsValidIndex(i);
        var uvs = ok ? m.ImagePoints(d, img) : 0.MapRange(j => UvCoordinate(0.0, 0.0));
        var s = ok ? m.ImageSurface(img) : SurfaceIndex(-1);
        return (ok ? uvs.IsValidIndex(i) : false)
            ? m.Geometry.Eval(s, m.Geometry.Domain(s).ClampToDomain(uvs[i])).Distance(d.Points[i])
                <= 2.0 * m.Tolerances.Length.Value
            : true;
    }

    // Consecutive image points are unwrapped: in each periodic direction the step from point i to
    // point i + 1 is at most half a period. Exact.
    Law_ImageStepsAreUnwrapped(m: BrepModel, d: EdgeDiscretization, img: EdgeImage, i: Integer): Boolean
    {
        var ok = m.IsEvaluable(d) && m.IsImageEvaluable(img);
        var uvs = ok ? m.ImagePoints(d, img) : 0.MapRange(j => UvCoordinate(0.0, 0.0));
        return (ok ? (i >= 0 && i + 1 < uvs.Count) : false)
            ? m.Geometry.Domain(m.ImageSurface(img)).IsUnwrappedStep(uvs[i], uvs[i + 1])
            : true;
    }

    // The two-space criterion: the straight image of segment i, mapped onto the surface, stays
    // within the effective chordal bound of the segment's 3D chord, widened by twice the length
    // tolerance (the image's end points map up to that far from the chord's).
    Law_ImageChordWithinChordal(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria, img: EdgeImage, plan: SamplePlan, i: Integer): Boolean
    {
        var ok = m.IsEvaluableSegment(d, i) && m.IsImageEvaluable(img);
        var deviations = ok ? m.ImageChordDeviations(d, img, plan) : 0.MapRange(j => 0.0);
        return (ok ? deviations.IsValidIndex(i) : false)
            ? (deviations[i] <= c.EffectiveChordal(m.Tolerances) + 2.0 * m.Tolerances.Length.Value
                || m.IsAtLengthFloor(d, c, i))
            : true;
    }

    //==
    // # Reversal and sharing
    //
    // Library laws; exact, since reversal only copies.

    // Reversing twice gives back the same discretization.
    Law_ReversedIsInvolution(d: EdgeDiscretization): Boolean
        => d.Reversed.Reversed.SameDiscretization(d);

    // Reversal reverses the parameters: parameter i becomes parameter count - 1 - i.
    Law_ReversedReversesParameters(d: EdgeDiscretization, i: Integer): Boolean
        => d.Parameters.IsValidIndex(i)
            ? d.Reversed.Parameters[d.Parameters.Count - 1 - i] == d.Parameters[i]
            : true;

    // Reversal reverses the points: point i becomes point count - 1 - i.
    Law_ReversedReversesPoints(d: EdgeDiscretization, i: Integer): Boolean
        => d.Points.IsValidIndex(i)
            ? d.Reversed.Points[d.Points.Count - 1 - i] == d.Points[i]
            : true;

    // The sharing principle: two citations of the edge that run in opposite directions on its
    // curve consume the same points in opposite orders, so the two faces' boundaries meet point
    // for point and the mesh is closed along the edge by construction.
    Law_OppositeUsesSeeReversedPoints(m: BrepModel, d: EdgeDiscretization, b1: FaceBound, c1: Coedge, b2: FaceBound, c2: Coedge, k: Integer): Boolean
        => (m.IsEvaluable(d) && c1.Edge == d.Edge && c2.Edge == d.Edge && d.Points.IsValidIndex(k))
            ? (m.CoedgeRunsForwardOnCurve(b1, c1) != m.CoedgeRunsForwardOnCurve(b2, c2)
                ? m.AlongCoedge(d, b1, c1).Points[k] == m.AlongCoedge(d, b2, c2).Points[d.Points.Count - 1 - k]
                : true)
            : true;

    // Symmetry: reversing an edge in the model (ends swapped, sense flipped, citations flipped)
    // leaves its canonical discretization bit-identical, because discretization runs in the
    // curve's parameter and reads nothing the reversal changes.
    Law_EdgeReversalLeavesDiscretization(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors): Boolean
        => m.CanDiscretize(e, c)
            ? m.WithEdgeReversed(e).Discretize(e, c, floors).SameDiscretization(m.Discretize(e, c, floors))
            : true;

    //==
    // # Monotonicity and refinement
    //
    // Library laws.

    // A tighter chordal bound never yields fewer points, the other criteria and the floors fixed.
    Law_TighterChordalNeverFewerPoints(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors, chordal: Number): Boolean
        => (m.CanDiscretize(e, c) && chordal > 0.0 && chordal <= c.Chordal)
            ? m.Discretize(e, c.WithChordal(chordal), floors).Parameters.Count
                >= m.Discretize(e, c, floors).Parameters.Count
            : true;

    // An edge no request names comes out of `Refine` bit-identical.
    Law_RefineKeepsUnrequestedEdges(m: BrepModel, d: EdgeDiscretizations, requests: Array<EdgeRefinementRequest>, c: DiscretizationCriteria, e: BrepEdgeIndex): Boolean
        => (m.Law_IndicesInRange && c.IsWellFormed && m.IsRefinable(d, requests, c) && d.ByEdge.IsValidIndex(e))
            ? (requests.IsRequested(e)
                ? true
                : m.Refine(d, requests, c).ByEdge[e].SameDiscretization(d.ByEdge[e]))
            : true;

    // `Refine` never coarsens: every parameter a requested edge had before is still a parameter
    // after, so the new partition refines the old one.
    Law_RefineNeverCoarsens(m: BrepModel, d: EdgeDiscretizations, requests: Array<EdgeRefinementRequest>, c: DiscretizationCriteria, e: BrepEdgeIndex, k: Integer): Boolean
        => (m.Law_IndicesInRange && c.IsWellFormed && m.IsRefinable(d, requests, c) && d.ByEdge.IsValidIndex(e))
            ? (d.ByEdge[e].Parameters.IsValidIndex(k)
                ? m.Refine(d, requests, c).ByEdge[e].ContainsParameter(d.ByEdge[e].Parameters[k])
                : true)
            : true;

    // A requested count is met on every edge that is not degenerate (a degenerate edge keeps its
    // one segment; face meshing places points on a pole side itself).
    Law_RefineMeetsRequestedSegments(m: BrepModel, d: EdgeDiscretizations, requests: Array<EdgeRefinementRequest>, c: DiscretizationCriteria, e: BrepEdgeIndex): Boolean
        => (m.Law_IndicesInRange && c.IsWellFormed && m.IsRefinable(d, requests, c) && d.ByEdge.IsValidIndex(e) && m.IsEdgeEvaluable(e))
            ? (m.IsDegenerateEdge(e)
                ? true
                : m.Refine(d, requests, c).ByEdge[e].SegmentCount >= requests.RequestedSegments(e))
            : true;

    // Entry i of a set of discretizations is the discretization of edge i. Structural: exact.
    DiscretizationsIndexedByEdge(ds: EdgeDiscretizations, i: Integer): Boolean
        => ds.ByEdge.IsValidIndex(i) ? ds.ByEdge[i].Edge.Value == i : true;

    // DiscretizationsIndexedByEdge at entry i of DiscretizeAll's result.
    Law_DiscretizationsIndexedByEdge(m: BrepModel, c: DiscretizationCriteria, floors: SegmentFloors, i: Integer): Boolean
        => m.DiscretizeAll(c, floors).DiscretizationsIndexedByEdge(i);

    // A set of discretizations has one entry per edge of the model. Structural: exact.
    DiscretizationsCoverEdges(m: BrepModel, ds: EdgeDiscretizations): Boolean
        => ds.ByEdge.Count == m.Edges.Count;

    // DiscretizationsCoverEdges on DiscretizeAll's result.
    Law_DiscretizationsCoverEdges(m: BrepModel, c: DiscretizationCriteria, floors: SegmentFloors): Boolean
        => m.DiscretizationsCoverEdges(m.DiscretizeAll(c, floors));

    //==
    // # Circular arcs
    //
    // Library law over scalars and small records.

    // The closed-form count meets the chordal bound: a circular arc of the given radius and sweep,
    // split uniformly into `ArcCriteriaCount` segments, has a sagitta per segment of at most the
    // effective chordal bound. In the reals the inequality is exact; the slack is the library's
    // own rounding at the radius (`ResolutionAt`), never the file's length tolerance, since the
    // law compares this layer's arithmetic with itself. A rounding law.
    Law_ArcCriteriaCountMeetsChordal(radius: Number, sweep: Angle, c: DiscretizationCriteria, t: Tolerances): Boolean
        => (radius > 0.0 && sweep.Radians > 0.0 && sweep.Radians <= Number.Tau && c.IsWellFormed && t.Length.Value >= 0.0)
            ? radius.ArcSagitta(sweep / radius.ArcCriteriaCount(sweep, c, t).ToNumber)
                <= c.EffectiveChordal(t) + ResolutionAt(radius)
            : true;
}

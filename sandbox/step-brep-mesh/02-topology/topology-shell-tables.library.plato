//==
// # Shell tables: functions (complexity sweep, chunk V4)
//
// Ranked candidate 14 (the tables half) of docs/plans/step-mesher-complexity.md: layer 2's
// UseCount rebuilds the shell's coedge sites per call, and EdgesOfShell calls it for every model
// edge, O(E C) per shell, which ReducedCounts, DegenerateEdgeCount, FreeEdgeCount,
// IndexedBoundaryCycleCount, HasCoherentOrientation and UsesEveryEdgeTwice repeat; VerticesOfShell
// rebuilds the sites and the shell's faces per model vertex, O(V (C + F)); CornersAtVertex scans
// every site per vertex. Here the uses of every edge and the corners at every vertex are built
// for one shell in one pass and a counting sort, O(C + E) and O(C + V), and every reader returns
// what its reference returns, for every index in range.
//
// Sections, in order:
//  - Grouping sites by key
//  - Edge uses
//  - Vertices and corners
//  - Shell measures over the tables

library BrepShellTables
{
    //==
    // # Grouping sites by key

    // The sites grouped by key into rowCount rows, each row in the given order (a stable counting
    // sort), with its work: Insertions is two per site placed, one to count its row and one to
    // copy it. A site whose key is outside [0, rowCount) is in no row. Precondition: keys and
    // sites have the same count.
    CoedgeSiteRowsCounted(rowCount: Integer, keys: Array<Integer>, sites: Array<CoedgeSite>): Counted<CoedgeSiteRows>
    {
        var offsets = new Buffer<Integer>(rowCount + 1);
        var r = 0;
        while (r <= rowCount)
        {
            offsets = offsets.Set(r, 0);
            r = r + 1;
        }
        var placed = 0;
        var p = 0;
        while (p < keys.Count)
        {
            var k = keys[p];
            if (k >= 0 && k < rowCount)
            {
                offsets = offsets.Set(k + 1, offsets.At(k + 1) + 1);
                placed = placed + 1;
            }
            p = p + 1;
        }
        var s = 0;
        while (s < rowCount)
        {
            offsets = offsets.Set(s + 1, offsets.At(s + 1) + offsets.At(s));
            s = s + 1;
        }
        var starts = offsets.Freeze();
        var cursor = new Buffer<Integer>(rowCount.Max(1));
        var j = 0;
        while (j < rowCount)
        {
            cursor = cursor.Set(j, starts[j]);
            j = j + 1;
        }
        var order = new Buffer<Integer>(placed.Max(1));
        var q = 0;
        while (q < keys.Count)
        {
            var key = keys[q];
            if (key >= 0 && key < rowCount)
            {
                order = order.Set(cursor.At(key), q);
                cursor = cursor.Set(key, cursor.At(key) + 1);
            }
            q = q + 1;
        }
        var positions = order.Freeze();
        return Counted(
            CoedgeSiteRows(starts, placed.MapRange(i => sites[positions[i]])),
            Insertions(2 * placed));
    }

    // Whether k names a row.
    HasRow(r: CoedgeSiteRows, k: Integer): Boolean
        => k >= 0 && k < r.Offsets.Count - 1;

    // The number of sites in row k; 0 when k names no row.
    RowSize(r: CoedgeSiteRows, k: Integer): Integer
        => r.HasRow(k) ? r.Offsets[k + 1] - r.Offsets[k] : 0;

    // The sites of row k, in the order they were given; empty when k names no row.
    RowSites(r: CoedgeSiteRows, k: Integer): Array<CoedgeSite>
        => r.RowSize(k).MapRange(i => r.Sites[r.Offsets[k] + i]);

    //==
    // # Edge uses

    // EdgeUseTable with its work counted: Insertions is one per coedge site of the shell read
    // for its edge, plus the counting sort's two per site placed, so at most 3 C for the shell's
    // C coedges.
    EdgeUseTableCounted(m: BrepModel, s: ShellIndex): Counted<EdgeUseTable>
    {
        var sites = m.CoedgeSitesOfShell(s);
        var keys = sites.Map(x => m.CoedgeAt(x).Edge.Value);
        var rows = CoedgeSiteRowsCounted(m.Edges.Count, keys, sites);
        return Counted(EdgeUseTable(rows.Value), Insertions(sites.Count).Add(rows.Work));
    }

    // The uses of every edge in shell s: row e lists the shell's coedge sites citing edge e, in
    // shell order.
    EdgeUseTable(m: BrepModel, s: ShellIndex): EdgeUseTable
        => m.EdgeUseTableCounted(s).Value;

    // How many coedges of the table's shell cite edge e: layer 2's UseCount(m, s, e) for every
    // edge in range. 0 when e names no row (UseCount counts coedges citing an out-of-range e).
    UseCountIn(t: EdgeUseTable, e: BrepEdgeIndex): Integer
        => t.Uses.RowSize(e.Value);

    // The coedge sites of the table's shell citing edge e, in shell order: layer 2's
    // CoedgeSitesOfEdge(m, s, e) for every edge in range; empty when e names no row.
    UsesOfEdgeIn(t: EdgeUseTable, e: BrepEdgeIndex): Array<CoedgeSite>
        => t.Uses.RowSites(e.Value);

    // The distinct edges the table's shell cites, in increasing index order: layer 2's
    // EdgesOfShell(m, s). O(E).
    EdgesOfShellByUse(t: EdgeUseTable): Array<BrepEdgeIndex>
    {
        var edges = new List<BrepEdgeIndex>();
        var e = 0;
        while (e < t.Uses.Offsets.Count - 1)
        {
            if (t.Uses.RowSize(e) > 0)
            {
                edges = edges.Add(BrepEdgeIndex(e));
            }
            e = e + 1;
        }
        return edges.Freeze();
    }

    //==
    // # Vertices and corners

    // The distinct vertices shell s's bounds reference, in increasing index order: layer 2's
    // VerticesOfShell(m, s). One mark per model vertex, set from both ends of every edge the
    // table lists and from the vertex loops of the shell's faces; O(V + E + L_s). Precondition:
    // t is m.EdgeUseTable(s).
    VerticesOfShellByMark(m: BrepModel, s: ShellIndex, t: EdgeUseTable): Array<BrepVertexIndex>
    {
        var vertexCount = m.Vertices.Count;
        var marks = new Buffer<Boolean>(vertexCount.Max(1));
        var i = 0;
        while (i < vertexCount)
        {
            marks = marks.Set(i, false);
            i = i + 1;
        }
        var edges = t.EdgesOfShellByUse;
        var k = 0;
        while (k < edges.Count)
        {
            var a = m.Edges[edges[k]].Start.Value;
            var b = m.Edges[edges[k]].End.Value;
            if (a >= 0 && a < vertexCount)
            {
                marks = marks.Set(a, true);
            }
            if (b >= 0 && b < vertexCount)
            {
                marks = marks.Set(b, true);
            }
            k = k + 1;
        }
        var faces = m.ShellFaces(s);
        var f = 0;
        while (f < faces.Count)
        {
            var bounds = m.Faces[faces[f]].Bounds;
            var j = 0;
            while (j < bounds.Count)
            {
                if (m.IsLoopInRange(bounds[j].Loop))
                {
                    var loopVertices = m.Loops[bounds[j].Loop].VertexLoopVertexOf;
                    var w = 0;
                    while (w < loopVertices.Count)
                    {
                        var v = loopVertices[w].Value;
                        if (v >= 0 && v < vertexCount)
                        {
                            marks = marks.Set(v, true);
                        }
                        w = w + 1;
                    }
                }
                j = j + 1;
            }
            f = f + 1;
        }
        var marked = marks.Freeze();
        var vertices = new List<BrepVertexIndex>();
        var u = 0;
        while (u < vertexCount)
        {
            if (marked[u])
            {
                vertices = vertices.Add(BrepVertexIndex(u));
            }
            u = u + 1;
        }
        return vertices.Freeze();
    }

    // The corners at every vertex in shell s: row v lists the shell's coedge sites whose coedge
    // ends at v, in shell order. O(C + V).
    CornersByVertex(m: BrepModel, s: ShellIndex): VertexCornerTable
    {
        var sites = m.CoedgeSitesOfShell(s);
        var keys = sites.Map(x => m.IsEdgeInRange(m.CoedgeAt(x).Edge) ? m.EndVertex(m.CoedgeAt(x)).Value : -1);
        return VertexCornerTable(CoedgeSiteRowsCounted(m.Vertices.Count, keys, sites).Value);
    }

    // The corners at vertex v: layer 2's CornersAtVertex(m, s, v) for every vertex in range;
    // empty when v names no row.
    CornersAtVertexIn(t: VertexCornerTable, v: BrepVertexIndex): Array<CoedgeSite>
        => t.Corners.RowSites(v.Value);

    //==
    // # Shell measures over the tables
    //
    // Each is its layer 2 namesake without the suffix, with t = m.EdgeUseTable(s) for the shell s
    // the namesake takes, and has the namesake's precondition.

    // UsesEveryEdgeTwice: every counted edge of the shell has zero or two uses.
    UsesEveryEdgeTwiceIndexed(m: BrepModel, t: EdgeUseTable): Boolean
        => t.EdgesOfShellByUse.All(e => m.CountsAsEdge(e) ? t.UseCountIn(e).IsZeroOrTwo : true);

    // FreeEdgeCount: the counted edges of the shell with exactly one use.
    FreeEdgeCountIndexed(m: BrepModel, t: EdgeUseTable): Integer
        => t.EdgesOfShellByUse.Reduce(0, (n, e) => (t.UseCountIn(e) == 1 ? m.CountsAsEdge(e) : false) ? n + 1 : n);

    // HasCoherentOrientation: every edge of the shell with two uses has them running opposite.
    HasCoherentOrientationIndexed(m: BrepModel, t: EdgeUseTable): Boolean
        => t.EdgesOfShellByUse.All(e => m.UsesRunOpposite(t.UsesOfEdgeIn(e)));

    // The class roots of the model's vertices with the two ends of every given edge joined: the
    // contraction of the shell's degenerate edges that ReducedCounts and IndexedBoundaryCycleCount
    // make.
    DegenerateEdgeRoots(m: BrepModel, degenerate: Array<BrepEdgeIndex>): Array<Integer>
        => ClassRoots(m.Vertices.Count,
            degenerate.Map(e => m.Edges[e].Start.Value), degenerate.Map(e => m.Edges[e].End.Value));

    // IndexedBoundaryCycleCount: the classes of the shell's free edges joined where they share a
    // vertex class.
    IndexedBoundaryCycleCountIndexed(m: BrepModel, t: EdgeUseTable): Integer
    {
        var shellEdges = t.EdgesOfShellByUse;
        var degenerate = shellEdges.FlatMap(e => m.IsDegenerateEdge(e) ? [e] : shellEdges.Take(0));
        var roots = m.DegenerateEdgeRoots(degenerate);
        var free = shellEdges.FlatMap(e => (t.UseCountIn(e) == 1 ? m.CountsAsEdge(e) : false) ? [e] : shellEdges.Take(0));
        var n = free.Count;
        var joined = n.Range.FlatMap(i => n.Range.FlatMap(j =>
            (i < j ? m.EdgesShareClass(free[i], free[j], roots) : false) ? [i * n + j] : n.Range.Take(0)));
        return ClassRoots(n, joined.Map(k => k / n), joined.Map(k => k % n)).ClassCount;
    }

    // ReducedCounts: the shell's counts after the reduction of research/VALIDATION-MATH.md 1.4,
    // with the shell's edges and vertices read from the table instead of from a scan per model
    // edge and per model vertex.
    ReducedCountsIndexed(m: BrepModel, s: ShellIndex, t: EdgeUseTable): ShellCounts
        => m.ReducedCountsPolyIndexed(s, t, m.ShellPolyEdgesOf(s));
}

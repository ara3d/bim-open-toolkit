//==
// # B-rep topology elements
//
// Layer 2 of the STEP B-rep to mesh design (README.md beside this file). The
// cells of a boundary representation and the records that bind them. Each is
// one row of a flat table in BrepModel, and every reference is a typed index
// from 00-foundation, never a nested value. These are plain data: a model read
// from a file may break any rule, and the laws in topology.laws.plato say which.
// Orientation flags that STEP keeps on oriented faces, oriented shells, and
// void shells are not represented: the decoder (03-step) folds them into
// BrepFace.SameSense and FaceBound.Orientation.
//
// Sections, in order:
//  - Edge orientation and coedges
//  - Vertices and edges
//  - Loops and face bounds
//  - Faces, shells and bodies

//==
// # Edge orientation and coedges

// The direction a coedge cites its edge with (STEP oriented_edge.orientation):
// Forward walks the edge from its Start vertex to its End vertex, Reversed walks
// it back. Declared identically to the stdlib v1 EdgeOrientation, whose file
// the gate excludes.
type EdgeOrientation
    = Forward
    | Reversed;

// One oriented citation of an edge inside an edge loop (STEP oriented_edge).
// Orientation is the coedge's own flag only: the direction in which a face runs
// along the edge's curve also depends on the edge's SameSense and on the bound's
// Orientation (CoedgeRunsForwardOnCurve). Replaces the stdlib v1 BrepEdgeUse,
// whose Edge is a mesh index. Pcurves are not stored here; they belong to the
// edge's curve in the geometry arena (PcurvesOf, PcurvesOnFace).
type Coedge
    implements IValue
{
    Edge: BrepEdgeIndex;
    Orientation: EdgeOrientation;
}

//==
// # Vertices and edges

// A topological vertex and its position (STEP vertex_point with a
// cartesian_point), in the model's length unit. The point is authoritative:
// curve ends are checked against it, never the other way round.
type BrepVertex
    implements IValue
{
    Point: Point3D;
}

// A topological edge (STEP edge_curve): an open arc of Curve between its two
// vertices. Start and End may be the same vertex, which makes a closed edge (a
// full circle). The curve may be unbounded and may be shared with other edges.
// SameSense is true when the curve's increasing parameter runs from Start to
// End. No parameter range is stored, because the file stores none: EdgeDomain
// derives it from the vertex points.
type BrepEdge
    implements IValue
{
    Start: BrepVertexIndex;
    End: BrepVertexIndex;
    Curve: CurveIndex;
    SameSense: Boolean;
}

//==
// # Loops and face bounds

// A closed boundary curve of a face. EdgeLoop (STEP edge_loop): coedges in
// order, each ending at the vertex the next one starts from, the last wrapping
// to the first (Law_LoopsChainEndToStart); an edge may appear twice with
// opposite orientations, which makes it a seam. VertexLoop (STEP vertex_loop):
// one vertex that bounds the face, a pole or apex puncture, or the only bound of
// a face that covers a whole closed surface. PolyLoop (STEP poly_loop): at least
// three points joined by implicit straight edges, the last back to the first,
// matched across faces by coincidence; used only by faceted B-reps.
type BrepLoop
    = EdgeLoop(Coedges: Array<Coedge>)
    | VertexLoop(Vertex: BrepVertexIndex)
    | PolyLoop(Points: Array<Point3D>);

// One bound of a face (STEP face_bound or face_outer_bound). Orientation false
// means the face uses every coedge of the loop reversed, so it runs the loop
// backwards; the decoder has already folded oriented_face and void-shell flags
// into it. IsOuter records that the file wrote face_outer_bound. It is a hint:
// absent on a sixth of surveyed faces and set on both circles of some cylinder
// bands, so only Law_AtMostOneOuterBound reads it.
type FaceBound
    implements IValue
{
    Loop: BrepLoopIndex;
    Orientation: Boolean;
    IsOuter: Boolean;
}

//==
// # Faces, shells and bodies

// A face (STEP advanced_face or face_surface): the part of Surface that its
// bounds cut out. SameSense is true when the face's topological normal, the
// normal its loops run counter-clockwise about, agrees with the surface normal
// N; after the decoder's folding the topological normal points out of the
// material. At least one bound (Law_AtLeastOneBound).
type BrepFace
{
    Surface: SurfaceIndex;
    SameSense: Boolean;
    Bounds: Array<FaceBound>;
}

// A connected set of faces (STEP closed_shell or open_shell). DeclaredClosed
// records that the file wrote closed_shell. It is a claim the laws check
// (Law_DeclaredClosedIsClosed), never a proof: the survey found 371 declared
// closed shells with free edges. A shell carries no orientation flag.
type BrepShell
{
    Faces: Array<BrepFaceIndex>;
    DeclaredClosed: Boolean;
}

// A body. ManifoldSolid (STEP manifold_solid_brep, faceted_brep): the solid
// inside one closed shell. SolidWithVoids (STEP brep_with_voids): the solid
// inside Outer and outside every void, the void shells stored with every face
// already reversed so their normals point into the void. ShellSet (STEP
// shell_based_surface_model): sheets, open or closed shells that bound no
// solid.
type BrepBody
    = ManifoldSolid(Outer: ShellIndex)
    | SolidWithVoids(Outer: ShellIndex, Voids: Array<ShellIndex>)
    | ShellSet(Shells: Array<ShellIndex>);

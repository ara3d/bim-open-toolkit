//==
// # Shell connectivity and orientation in linear passes (complexity sweep, chunk V8)
//
// Layer 02. Replacements for layer 2 functions that compare every pair of faces or scan every
// link per face:
//  - ShellComponentCountByVertex: ShellComponentCount's classes, joined through a sort of the
//    shell's (vertex, face) references instead of FacesTouch per pair of faces.
//  - OrientationFlipsByAdjacency: OrientationFlips' breadth-first two-colouring over a compressed
//    adjacency (one row per face position) built from V4's edge-use table, instead of a scan of
//    every link per dequeued face and a linear PositionOf per use.
//  - FaceMarks and WithFacesReversedMarked: WithFacesReversed through one mark per face, instead
//    of a search of the face list per face.
//  - IsOrientableByAdjacency: IsOrientable with one edge-use table for both the search and the
//    coherence check.
// Results are identical to the namesakes: the same count, the same flips in the same order, the
// same model (ShellOrientationLaws).
//
// Sections, in order:
//  - Connectivity
//  - Orientation
//  - Reversing faces

library BrepShellOrientation
{
    //==
    // # Connectivity

    // ShellComponentCount(m, s).
    ShellComponentCountByVertex(m: BrepModel, s: ShellIndex): Integer
        => m.ShellComponentCountByVertexCounted(s).Value;

    // The number of connected components of shell s under the rule ShellComponentCount states:
    // two faces touch when their bounds reference a common vertex index (FaceVertices) or a poly
    // loop point of one coincides with one of the other (FacePolyPoints, IsCoincident). The
    // vertex part is one pass: every (vertex, face position) reference is listed, sorted by
    // vertex, and each reference joined to the one before it with the same vertex. The poly part
    // keeps the reference's pairwise test, among faces with poly points only (chunk V9 owns
    // coincidence by grid). Work: Insertions, one per face position visited and two per vertex
    // reference (listed, then walked in sorted order), plus one per pair of poly faces tested;
    // the sort's comparisons are not counted. Precondition: every face of the shell intact.
    ShellComponentCountByVertexCounted(m: BrepModel, s: ShellIndex): Counted<Integer>
        => m.ShellComponentCountByGridCounted(s);

    // Whether a point of p coincides with a point of q at the model's tolerance: FacesTouch's
    // poly-loop test over points already gathered.
    PolyPointsTouch(m: BrepModel, p: Array<Point3D>, q: Array<Point3D>): Boolean
        => p.Any(x => q.Any(y => m.IsCoincident(x, y)));

    //==
    // # Orientation

    // OrientationFlips(m, s), given t = m.EdgeUseTable(s).
    OrientationFlipsByAdjacency(m: BrepModel, s: ShellIndex, t: EdgeUseTable): Array<BrepFaceIndex>
        => m.OrientationFlipsByAdjacencyCounted(s, t).Value;

    // The faces of shell s the parity search colours "flip", as OrientationFlips finds them, with
    // t = m.EdgeUseTable(s). The links are FaceParityLink's, in the same order: one per shell edge
    // (increasing index) whose uses are exactly two, in two different faces, between the first
    // positions of those faces in ShellFaces, parity 0 when the uses run opposite. Each link is
    // placed in the rows of both its faces in link order (a stable counting sort), so a dequeued
    // face reaches its neighbours in the order the reference's scan of every link does, and the
    // colouring, the queue and the result are the reference's. Work: Insertions, one per model
    // face row initialised in the position map, one per face position mapped and per face
    // dequeued, one per use read from the table, and two per adjacency entry (placed, then
    // walked); building t is the caller's. Precondition: m.IsEveryIndexInRange.
    OrientationFlipsByAdjacencyCounted(m: BrepModel, s: ShellIndex, t: EdgeUseTable): Counted<Array<BrepFaceIndex>>
    {
        var faces = m.ShellFaces(s);
        var n = faces.Count;
        var modelFaces = m.Faces.Count;
        var position = new Buffer<Integer>(modelFaces);
        var f = 0;
        while (f < modelFaces)
        {
            position = position.Set(f, -1);
            f = f + 1;
        }
        var p = 0;
        while (p < n)
        {
            if (position.At(faces[p].Value) < 0)
            {
                position = position.Set(faces[p].Value, p);
            }
            p = p + 1;
        }
        var edges = t.EdgesOfShellByUse;
        var endList = new List<Integer>();
        var parityList = new List<Integer>();
        var usesRead = 0;
        var e = 0;
        while (e < edges.Count)
        {
            var sites = t.UsesOfEdgeIn(edges[e]);
            usesRead = usesRead + sites.Count;
            if (sites.Count == 2)
            {
                if (sites[0].Face != sites[1].Face)
                {
                    endList = endList.Add(position.At(sites[0].Face.Value));
                    endList = endList.Add(position.At(sites[1].Face.Value));
                    parityList = parityList.Add(m.UsesRunOpposite(sites) ? 0 : 1);
                }
            }
            e = e + 1;
        }
        var ends = endList.Freeze();
        var parities = parityList.Freeze();
        var offsets = new Buffer<Integer>(n + 1);
        var r = 0;
        while (r <= n)
        {
            offsets = offsets.Set(r, 0);
            r = r + 1;
        }
        var x = 0;
        while (x < ends.Count)
        {
            offsets = offsets.Set(ends[x] + 1, offsets.At(ends[x] + 1) + 1);
            x = x + 1;
        }
        var cursor = new Buffer<Integer>(n);
        var q = 0;
        while (q < n)
        {
            offsets = offsets.Set(q + 1, offsets.At(q + 1) + offsets.At(q));
            cursor = cursor.Set(q, offsets.At(q));
            q = q + 1;
        }
        var neighbour = new Buffer<Integer>(ends.Count);
        var linkParity = new Buffer<Integer>(ends.Count);
        var y = 0;
        while (y < ends.Count)
        {
            var slot = cursor.At(ends[y]);
            neighbour = neighbour.Set(slot, y % 2 == 0 ? ends[y + 1] : ends[y - 1]);
            linkParity = linkParity.Set(slot, parities[y / 2]);
            cursor = cursor.Set(ends[y], slot + 1);
            y = y + 1;
        }
        var colour = new Buffer<Integer>(n);
        var i = 0;
        while (i < n)
        {
            colour = colour.Set(i, -1);
            i = i + 1;
        }
        var walked = 0;
        var root = 0;
        while (root < n)
        {
            if (colour.At(root) < 0)
            {
                colour = colour.Set(root, 0);
                var queue = new List<Integer>().Add(root);
                var head = 0;
                while (head < queue.Count)
                {
                    var face = queue.At(head);
                    var k = offsets.At(face);
                    while (k < offsets.At(face + 1))
                    {
                        var b = neighbour.At(k);
                        if (colour.At(b) < 0)
                        {
                            colour = colour.Set(b, (colour.At(face) + linkParity.At(k)) % 2);
                            queue = queue.Add(b);
                        }
                        walked = walked + 1;
                        k = k + 1;
                    }
                    head = head + 1;
                }
            }
            root = root + 1;
        }
        var colours = colour.Freeze();
        var flips = n.Range.FlatMap(j => colours[j] == 1 ? [faces[j]] : faces.Take(0));
        return Counted(flips, Insertions(modelFaces + 2 * n + usesRead + ends.Count + walked));
    }

    // IsOrientable(m, s) with one edge-use table: reversing faces keeps every loop and every
    // face's bound list, so the reversed model's table is t, and HasCoherentOrientation of the
    // reversed model is HasCoherentOrientationIndexed over t. Precondition: m.IsEveryIndexInRange.
    IsOrientableByAdjacency(m: BrepModel, s: ShellIndex): Boolean
    {
        var t = m.EdgeUseTable(s);
        var flips = m.OrientationFlipsByAdjacency(s, t);
        return m.WithFacesReversedMarked(FaceMarks(flips, m.Faces.Count)).HasCoherentOrientationIndexed(t);
    }

    //==
    // # Reversing faces

    // One mark per face of a model with faceCount faces: true for every face the list names,
    // once or more; indices outside [0, faceCount) are ignored, as WithFacesReversed ignores them.
    FaceMarks(faces: Array<BrepFaceIndex>, faceCount: Integer): Array<Boolean>
    {
        var marks = new Buffer<Boolean>(faceCount);
        var i = 0;
        while (i < faceCount)
        {
            marks = marks.Set(i, false);
            i = i + 1;
        }
        var k = 0;
        while (k < faces.Count)
        {
            if (faces[k].Value >= 0 && faces[k].Value < faceCount)
            {
                marks = marks.Set(faces[k].Value, true);
            }
            k = k + 1;
        }
        return marks.Freeze();
    }

    // The model with face i reversed where flip[i] is true; other rows unchanged. A face past the
    // end of flip is kept. WithFacesReversed(m, faces) is
    // m.WithFacesReversedMarked(FaceMarks(faces, m.Faces.Count)).
    WithFacesReversedMarked(m: BrepModel, flip: Array<Boolean>): BrepModel
        => BrepModel(
            m.Geometry,
            m.Vertices,
            m.Edges,
            m.Loops,
            m.Faces.Count.MapRange(i => (i < flip.Count ? flip[i] : false) ? m.Faces[i].Reversed : m.Faces[i]),
            m.Shells,
            m.Bodies,
            m.Tolerances,
            m.Unit);

    // WithEveryFaceReversed(m): every face marked.
    WithEveryFaceReversedMarked(m: BrepModel): BrepModel
        => m.WithFacesReversedMarked(m.Faces.Count.MapRange(i => true));
}

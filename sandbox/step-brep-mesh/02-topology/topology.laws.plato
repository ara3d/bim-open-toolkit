//==
// # BrepTopologyLaws
//
// The laws of layer 2 (README.md beside this file, "Laws"). Each Law_ returns
// Boolean and states one property for all values of its parameters. A leading
// guard pre ? claim : true makes it vacuously true outside its hypotheses, and
// every lookup sits behind such a guard, so no law indexes out of range. The
// structural laws guard locally, so each reports its own defect even when other
// rows of the model are broken. The laws that evaluate geometry or call a
// deferred function guard with IsEveryIndexInRange, because layer 1's
// evaluators read the arena. Pointwise laws take a sample fraction t, clamped
// into [0, 1] and mapped onto the domain; layer 7's Check_ functions choose t
// with layer 0's SamplePlan. Every law takes a BrepModel, so the pseudorandom
// runner skips it and it runs over witnesses (PLATO-PRIMER.md B.2).
//
// Severity (SPEC-DSL.md section 4): a structural law that fails is an Error. A
// geometric law that fails by less than ten times its tolerance is a Warning,
// by more an Error. Each comment ends with the kind and the tolerance.
//
// Sections, in order:
//  - Indices
//  - Loops and bounds
//  - Edge uses
//  - Vertex links
//  - Euler-Poincare
//  - Connectivity
//  - Orientability
//  - Bodies
//  - Edge domains
//  - Degenerate edges
//  - Geometry coupling
//  - Parameter-space winding

library BrepTopologyLaws
{
    //==
    // # Indices

    // Every index stored in the model names an existing row: edge vertices and
    // curves, coedge edges and vertex-loop vertices, face surfaces and bound
    // loops, shell faces, body shells, and the geometry arena's own indices.
    // Structural, exact.
    Law_IndicesInRange(m: BrepModel): Boolean
        => m.IsEveryIndexInRange;

    //==
    // # Loops and bounds

    // An edge loop is a non-empty closed chain: each coedge ends at the vertex
    // the next one starts from, the last wrapping to the first (STEP edge_loop
    // WR1). Vertex and poly loops close by definition. Structural, exact.
    Law_LoopsChainEndToStart(m: BrepModel, l: BrepLoopIndex): Boolean
        => m.IsLoopIntact(l) ? m.ChainsEndToStart(m.Loops[l]) : true;

    // A face has at most one bound marked outer (STEP face WR2). Structural,
    // exact.
    Law_AtMostOneOuterBound(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.IsFaceInRange(f) ? m.Faces[f].OuterBoundCount <= 1 : true;

    // A face has at least one bound (STEP face bounds SET[1:?]). Structural,
    // exact.
    Law_AtLeastOneBound(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.IsFaceInRange(f) ? m.Faces[f].Bounds.Count >= 1 : true;

    // Distinct bounds of a face share no vertex (STEP face IP2), the redundant
    // vertex loops left out: two edge loops of one face touching at a vertex
    // fail. Structural, exact.
    Law_FaceBoundsShareNoVertex(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.IsFaceIntact(f) ? m.HasDisjointBounds(f) : true;

    // No bound of a face is a redundant vertex loop: a vertex loop on a vertex
    // of another bound of the face, or repeating an earlier vertex loop there
    // (STEP face IP2). The reduction drops such a loop exactly, and face
    // meshing builds its region from KeptBounds, so nothing downstream depends
    // on it: a repaired defect. Structural, exact, Warning (README,
    // "Decisions", 12).
    Law_NoRedundantVertexLoop(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.IsFaceIntact(f)
            ? m.Faces[f].Bounds.Count.Range.All(b => m.IsRedundantVertexLoop(f, b).Not)
            : true;

    // A poly loop has at least three points (STEP poly_loop, LIST [3:?]):
    // fewer bound no area. Structural, exact.
    Law_PolyLoopHasThreePoints(m: BrepModel, l: BrepLoopIndex): Boolean
        => m.IsLoopInRange(l) ? m.Loops[l].HasThreePointsIfPoly : true;

    //==
    // # Edge uses

    // In a shell declared closed, an edge the shell uses is used exactly twice:
    // by two faces, or twice by one face as a seam (STEP closed_shell IP1). A
    // degenerate edge is not a cell of the reduced complex (CountsAsEdge) and
    // is exempt; Law_EdgeHasPositiveExtent reports it. Structural, exact.
    Law_EveryEdgeUsedTwiceInClosedShell(m: BrepModel, s: ShellIndex, e: BrepEdgeIndex): Boolean
        => m.IsShellInRange(s)
            ? (m.Shells[s].DeclaredClosed
                ? (m.IsEdgeInRange(e) ? (m.CountsAsEdge(e) ? m.UseCount(s, e).IsZeroOrTwo : true) : true)
                : true)
            : true;

    // In a shell not declared closed, no edge is used more than twice (STEP
    // open_shell); degenerate edges exempt as above. Structural, exact.
    Law_OpenShellEdgesUsedAtMostTwice(m: BrepModel, s: ShellIndex, e: BrepEdgeIndex): Boolean
        => m.IsShellInRange(s)
            ? (m.Shells[s].DeclaredClosed
                ? true
                : (m.IsEdgeInRange(e) ? (m.CountsAsEdge(e) ? m.UseCount(s, e) <= 2 : true) : true))
            : true;

    // A shell declared closed has no free edge, no edge used exactly once: the
    // file's closed_shell claim is true. Structural, exact.
    Law_DeclaredClosedIsClosed(m: BrepModel, s: ShellIndex): Boolean
        => m.IsShellInRange(s)
            ? (m.Shells[s].DeclaredClosed ? m.FreeEdgeCount(s) == 0 : true)
            : true;

    // When an edge has exactly two uses in a shell, they run in opposite
    // directions along its curve once each use's three sense flags are composed
    // (CoedgeRunsForwardOnCurve): the faces on either side agree in orientation.
    // Structural, exact.
    Law_EdgeUsesHaveOppositeOrientation(m: BrepModel, s: ShellIndex, e: BrepEdgeIndex): Boolean
        => m.IsShellInRange(s)
            ? (m.IsEdgeInRange(e) ? m.UsesRunOpposite(m.CoedgeSitesOfEdge(s, e)) : true)
            : true;

    // The implicit edges of a faceted shell obey the edge-use rules of indexed
    // edges: used exactly twice in opposite directions in a shell declared
    // closed, at most twice and never twice the same way in an open one.
    // Settles the layer's open item 3: the laws see poly loops directly,
    // rather than layer 3 rewriting them into edge loops. Structural, exact
    // after identification within Tolerances.Length.
    Law_PolyLoopEdgesPairUp(m: BrepModel, s: ShellIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsShellInRange(s) ? m.PolyEdgeUseDefects(s) == 0 : true)
            : true;

    // A seam's two uses run opposite: when an edge has exactly two uses in one
    // face, they run in opposite composed directions (STEP edge_loop IP2). A
    // seam used twice the same way glues the face to itself with a twist,
    // which no flag can repair. What the law adds to Law_EdgeUsesHaveOppositeOrientation is its reach:
    // it judges every face, whether or not a shell lists it, and still judges
    // the seam when a third use of the edge elsewhere in the shell makes the
    // shell law vacuous. Structural, exact.
    Law_SeamUsesRunOpposite(m: BrepModel, f: BrepFaceIndex, e: BrepEdgeIndex): Boolean
        => m.IsFaceInRange(f)
            ? (m.IsEdgeInRange(e) ? m.UsesRunOpposite(m.CoedgeSitesOfEdgeInFace(f, e)) : true)
            : true;

    // Reversing an edge (WithEdgeReversed) leaves the composed sense of every
    // coedge that cites it unchanged: SameSense and the coedge's orientation
    // both flip, and the product of signs is the same. Library, exact.
    Law_EdgeReversalKeepsCoedgeSense(m: BrepModel, site: CoedgeSite): Boolean
        => m.IsCoedgeSiteInRange(site)
            ? (m.IsEdgeInRange(m.CoedgeAt(site).Edge)
                ? m.WithEdgeReversed(m.CoedgeAt(site).Edge).CoedgeRunsForwardOnCurve(site) == m.CoedgeRunsForwardOnCurve(site)
                : true)
            : true;

    //==
    // # Vertex links

    // In a shell declared closed, the faces around every vertex the shell's
    // coedges reach form one cycle: the vertex's link has one component, so the
    // shell does not pinch there (two cones apex to apex fail). Structural,
    // exact.
    Law_VertexLinkIsOneCycle(m: BrepModel, s: ShellIndex, v: BrepVertexIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsShellInRange(s)
                ? (m.Shells[s].DeclaredClosed
                    ? (m.CornersAtVertex(s, v).Count == 0 ? true : m.LinkComponentCount(s, v) == 1)
                    : true)
                : true)
            : true;

    // In a shell not declared closed, the link of every vertex with corners
    // has one component, which, with no edge used more than twice
    // (Law_OpenShellEdgesUsedAtMostTwice), makes it one cycle at an interior
    // vertex or one path at a boundary vertex (research/VALIDATION-MATH.md
    // 2.2): two sheets touching at a corner fail. Structural, exact.
    Law_OpenShellVertexLinkIsCycleOrPath(m: BrepModel, s: ShellIndex, v: BrepVertexIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsShellInRange(s)
                ? (m.Shells[s].DeclaredClosed
                    ? true
                    : (m.CornersAtVertex(s, v).Count == 0 ? true : m.LinkComponentCount(s, v) == 1))
                : true)
            : true;

    // A vertex that bounds a face of the shell as a vertex loop is an end of no
    // edge the shell cites: the face surrounds it, so nothing else may touch it.
    // Structural, exact.
    Law_VertexLoopVertexIsIsolated(m: BrepModel, s: ShellIndex, v: BrepVertexIndex): Boolean
        => m.IsShellInRange(s)
            ? (m.IsVertexLoopVertexIn(s, v)
                ? m.CoedgeSitesOfShell(s).All(x => m.CoedgeTouchesVertex(m.CoedgeAt(x), v).Not)
                : true)
            : true;

    //==
    // # Euler-Poincare

    // For a shell declared closed, V - E + 2F - L on reduced counts is even and
    // at most 2 (ISO 10303-42 eq. 9); the genus is then (2 - chi) / 2.
    // Structural, exact.
    Law_EulerPoincareEvenAndBounded(m: BrepModel, s: ShellIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsShellInRange(s)
                ? (m.Shells[s].DeclaredClosed ? m.ShellEulerPoincare(s).IsEvenAndAtMostTwo : true)
                : true)
            : true;

    // For a shell not declared closed, reduced V - E + 2F - L plus the number
    // of boundary cycles B is even and at most 2: a compact orientable surface
    // of genus G with B boundary circles has chi = 2 - 2G - B, and the cells
    // counted include the boundary's (research/VALIDATION-MATH.md 1.4). A
    // single face gives 1 + 1; a cylinder's side face alone gives 0 + 2.
    // Structural, exact.
    Law_OpenShellEulerEvenAndBounded(m: BrepModel, s: ShellIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsShellInRange(s)
                ? (m.Shells[s].DeclaredClosed
                    ? true
                    : (m.ShellEulerPoincare(s) + m.BoundaryCycleCount(s)).IsEvenAndAtMostTwo)
                : true)
            : true;

    //==
    // # Connectivity

    // A shell is connected: its faces form one class under touching at a
    // vertex or a coinciding poly-loop point (ISO 10303-42 connected_face_set,
    // arcwise connected). Necessary, not only diagnostic: a sphere's faces and
    // a torus's faces in one closed shell use every edge twice with opposite
    // senses, have one-cycle links, and give chi = 2 + 0 = 2, so every other
    // law of this layer passes with genus 0; two tori give 0 and pass as one
    // torus. Holds for open and closed shells. Structural, exact.
    Law_ShellIsConnected(m: BrepModel, s: ShellIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsShellInRange(s) ? m.ShellComponentCount(s) <= 1 : true)
            : true;

    //==
    // # Orientability

    // A shell is orientable: reversing the faces the parity search names
    // (OrientationFlips) makes every edge's two uses run opposite. Where
    // Law_EdgeUsesHaveOppositeOrientation fails, this law tells a shell with
    // faces stored inside out (orientable; OrientationFlips is the repair)
    // from a one-sided surface or a twisted seam (not orientable, no repair).
    // Structural, exact.
    Law_ShellIsOrientable(m: BrepModel, s: ShellIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsShellInRange(s) ? m.IsOrientable(s) : true)
            : true;

    // Reversing every face reverses every coedge's composed sense, so it keeps
    // each edge's uses opposite or the same: coherence is unchanged (README,
    // "Sense and orientation, composed", folding is invisible). Library,
    // exact.
    Law_ReversingEveryFaceKeepsCoherence(m: BrepModel, s: ShellIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsShellInRange(s)
                ? m.WithEveryFaceReversed.HasCoherentOrientation(s) == m.HasCoherentOrientation(s)
                : true)
            : true;

    //==
    // # Bodies

    // Every shell of a solid body, outer or void, is declared closed (STEP
    // manifold_solid_brep and brep_with_voids take closed shells). Structural,
    // exact.
    Law_SolidShellsAreDeclaredClosed(m: BrepModel, b: BodyIndex): Boolean
        => m.IsBodyIntact(b) ? m.HasDeclaredClosedShells(m.Bodies[b]) : true;

    // The sign FaceNormalSign takes from the surface, epsilon, is the sign of
    // N . (PartialU x PartialV) at every resolvable point of the face: sampled
    // at the projections of its coedges' curve points. It tests the premise of
    // FaceNormalSign, one epsilon per surface, on the faces of the model, which
    // a mirrored placement or a spindle torus broke before the fix wave
    // (review F2, F3). Library, exact sign.
    Law_ParameterizationSignIsConstantOnFace(m: BrepModel, site: CoedgeSite, t: Number): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsCoedgeSiteInRange(site)
                ? (m.ParameterizationSignAt(site, t) == 0
                    ? true
                    : (m.ParameterizationSignAt(site, t) == 1) == m.Geometry.NormalAgreesWithParameterization(m.Faces[site.Face].Surface))
                : true)
            : true;

    //==
    // # Edge domains

    // The curve evaluated at the end of the edge domain assigned to the edge's
    // Start (atStart) or End vertex reproduces that vertex's point. Geometric,
    // Tolerances.Length.
    Law_EdgeDomainEndsAtVertices(m: BrepModel, e: BrepEdgeIndex, atStart: Boolean): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e) ? m.DomainEndDeviation(e, atStart) <= m.Tolerances.Length.Value : true)
            : true;

    // Reversing an edge leaves its domain unchanged, bit for bit: the vertex
    // met first along the curve is the Start when SameSense and the End
    // otherwise, and the reversal swaps both. Layer 4's theorem
    // EdgeReversalInvariance assumes it. Library, exact.
    Law_EdgeReversalKeepsEdgeDomain(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e)
                ? (m.WithEdgeReversed(e).EdgeDomain(e).Range.Start == m.EdgeDomain(e).Range.Start
                    && m.WithEdgeReversed(e).EdgeDomain(e).Range.End == m.EdgeDomain(e).Range.End)
                : true)
            : true;

    // The edge domain runs forward: its start does not exceed its end. On an
    // aperiodic curve a wrong SameSense inverts it; on a curve that loops it
    // holds by construction. Structural, the parameter tolerance at the range's
    // start (01-geometry's ParameterToleranceAt: the length tolerance over the
    // curve's speed there, between layer 0's floor and cap), not the
    // model-wide floor (review T8).
    Law_EdgeDomainIsForward(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e)
                ? m.EdgeDomain(e).Range.Start
                    <= m.EdgeDomain(e).Range.End
                        + m.Geometry.ParameterToleranceAt(m.Edges[e].Curve, m.EdgeDomain(e).Range.Start, m.Tolerances).Value
                : true)
            : true;

    //==
    // # Degenerate edges

    // Two distinct vertices of an edge coincide only when the edge is
    // degenerate: a closed curve trimmed at one point uses one vertex, not two.
    // Structural, Tolerances.Length.
    Law_CoincidentEndsAreOneVertex(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e)
                ? (m.IsClosedEdge(e)
                    ? true
                    : (m.IsCoincident(m.Vertices[m.Edges[e].Start].Point, m.Vertices[m.Edges[e].End].Point)
                        ? m.IsDegenerateEdge(e)
                        : true))
                : true)
            : true;

    // A degenerate edge's two vertices coincide, so contracting it merges two
    // copies of one point, never two points. Structural, Tolerances.Length.
    Law_DegenerateEdgeHasCoincidentVertices(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e)
                ? (m.IsDegenerateEdge(e)
                    ? m.IsCoincident(m.Vertices[m.Edges[e].Start].Point, m.Vertices[m.Edges[e].End].Point)
                    : true)
                : true)
            : true;

    // Every point of a degenerate edge's curve, at fraction t of its domain,
    // lies at its Start vertex: the pointwise form of IsDegenerateEdge's
    // contract. Geometric, Tolerances.Length.
    Law_DegenerateEdgeStaysAtStart(m: BrepModel, e: BrepEdgeIndex, t: Number): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e)
                ? (m.IsDegenerateEdge(e) ? m.StartVertexDeviationAt(e, t) <= m.Tolerances.Length.Value : true)
                : true)
            : true;

    // No edge is degenerate (STEP edge_curve IP2: finite non-zero extent). The
    // reduction contracts a degenerate edge exactly and the use-count laws
    // exempt it, so this law reports a repaired defect. Structural,
    // Tolerances.Length, Warning (README, "Decisions", 12).
    Law_EdgeHasPositiveExtent(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e) ? m.IsDegenerateEdge(e).Not : true)
            : true;

    //==
    // # Geometry coupling

    // An edge's Start (atStart) or End vertex lies on the edge's curve: the
    // nearest curve point is within the length tolerance (STEP edge_curve IP7).
    // Geometric, Tolerances.Length.
    Law_VertexCoincidesWithCurveEnd(m: BrepModel, e: BrepEdgeIndex, atStart: Boolean): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e) ? m.VertexCurveDeviation(e, atStart) <= m.Tolerances.Length.Value : true)
            : true;

    // The curve point at fraction t of a coedge's edge lies on the surface of
    // the face the coedge belongs to: projecting it with Project and evaluating
    // there returns it (STEP face_surface IP7). Geometric, Tolerances.Length.
    Law_EdgeLiesOnAdjacentSurfaces(m: BrepModel, site: CoedgeSite, t: Number): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsCoedgeSiteInRange(site) ? m.SurfaceDeviationAt(site, t) <= m.Tolerances.Length.Value : true)
            : true;

    // Each pcurve of an edge's curve and the 3D curve agree as point sets over
    // the edge, pcurve to curve: the pcurve's point at fraction t of its edge
    // range, which is bounded (PcurveEdgeDomain), lies on the 3D curve.
    // Geometric, Tolerances.Length.
    Law_PcurveAgreesWithCurve(m: BrepModel, e: BrepEdgeIndex, k: Integer, t: Number): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e)
                ? (m.HasPcurve(e, k) ? m.PcurveDeviationAt(e, k, t) <= m.Tolerances.Length.Value : true)
                : true)
            : true;

    // The reverse direction, curve to pcurve: the curve's point at fraction t
    // of the edge domain lies on the k-th pcurve's image. With the law above,
    // the two agree as point sets over the edge (review M3). Geometric,
    // Tolerances.Length.
    Law_CurveAgreesWithPcurve(m: BrepModel, e: BrepEdgeIndex, k: Integer, t: Number): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e)
                ? (m.HasPcurve(e, k) ? m.CurvePcurveDeviationAt(e, k, t) <= m.Tolerances.Length.Value : true)
                : true)
            : true;

    // A pcurve runs the way its curve does (ISO 10303-42 4.5.49 IP2): their
    // tangents at fraction t of the edge do not point apart. The composed
    // sense CoedgeRunsForwardOnCurve orients the pcurve on this premise.
    // Structural, exact sign beyond the arithmetic resolution.
    Law_PcurveRunsWithCurve(m: BrepModel, e: BrepEdgeIndex, k: Integer, t: Number): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e) ? (m.HasPcurve(e, k) ? m.PcurveRunsWithCurveAt(e, k, t) : true) : true)
            : true;

    // A pcurve lies on the surface of a face whose bounds cite its edge.
    // PcurvesOnFace never returns one that does not, so such a pcurve is
    // ignored, not wrong in any result: Structural, exact, Warning.
    Law_PcurveSurfaceIsAFaceSurface(m: BrepModel, e: BrepEdgeIndex, k: Integer): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsEdgeInRange(e) ? (m.HasPcurve(e, k) ? m.IsPcurveOnAdjacentFace(e, k) : true) : true)
            : true;

    //==
    // # Size and extent

    // The coordinate extent bounds the half-diagonal of the box from the origin
    // side: ModelSize is at most 2 * sqrt(3) times CoordinateExtent, because
    // every defining point lies in the cube of half-width CoordinateExtent
    // about the origin. Library, rounding: ResolutionAt of the size.
    Law_ModelSizeWithinExtent(m: BrepModel): Boolean
        => m.ModelSize <= m.CoordinateExtent * 2.0 * 3.0.Sqrt + ResolutionAt(m.ModelSize);

    // A rigid motion carries every vertex to motion.PointInFrame of it and
    // keeps every topology row, so every coedge's composed sense, and with it
    // every law of this layer that reads only the tables, is unchanged.
    // Library, exact.
    Law_RigidMotionKeepsCoedgeSense(m: BrepModel, motion: Frame3D, site: CoedgeSite): Boolean
        => m.IsCoedgeSiteInRange(site)
            ? (m.IsEdgeInRange(m.CoedgeAt(site).Edge)
                ? m.RigidlyMoved(motion).CoedgeRunsForwardOnCurve(site) == m.CoedgeRunsForwardOnCurve(site)
                : true)
            : true;

    // Scaling the model by a positive factor scales its coordinate extent by
    // the factor, within the rounding of the products: every defining point is
    // scaled, so the largest absolute coordinate is too. Exact for a power of
    // two. Library, ResolutionAt of the scaled extent.
    Law_ScalingScalesExtent(m: BrepModel, factor: Number): Boolean
        => (factor > 0.0 && factor.IsFinite)
            ? (m.ScaledBy(factor).CoordinateExtent - m.CoordinateExtent * factor).Abs
                <= ResolutionAt(m.CoordinateExtent * factor)
            : true;

    //==
    // # Parameter-space winding

    // For a face whose bounds close in its parameter plane without seam or pole
    // handling, the region its bounds enclose, each traversed as the face uses
    // it, has positive signed area exactly when FaceNormalSign is +1: the outer
    // loop runs counter-clockwise in (u, v) when the composed signs say the face
    // normal points along PartialU x PartialV. Structural, exact sign.
    Law_LoopWindingMatchesSameSense(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.IsEveryIndexInRange
            ? (m.IsFaceInRange(f)
                ? (m.IsPlainInParameters(f) ? m.WindingAgreesWithNormal(f) : true)
                : true)
            : true;
}

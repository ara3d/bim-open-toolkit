//==
// # Topology indices: the kernel tables of a model
//
// TYPE-CATALOG.md section 3. One range check over all ten kernel tables of a BrepModel, by
// TableName (00-foundation/foundation-keys.types.plato).
//
// Sections, in order:
//  - Kernel tables

library BrepTopologyIndices
{
    //==
    // # Kernel tables

    // The row count of table t of model m.
    RowCount(m: BrepModel, t: TableName): Integer
        => match (t) {
            VerticesTable => m.Vertices.Count;
            EdgesTable => m.Edges.Count;
            LoopsTable => m.Loops.Count;
            FacesTable => m.Faces.Count;
            ShellsTable => m.Shells.Count;
            BodiesTable => m.Bodies.Count;
            CurvesTable => m.Geometry.Curves.Count;
            Curves2DTable => m.Geometry.Curves2D.Count;
            PcurvesTable => m.Geometry.Pcurves.Count;
            SurfacesTable => m.Geometry.Surfaces.Count;
        };

    // True when row i exists in table t of model m: the range check of every table, once.
    IsRowInRange(m: BrepModel, t: TableName, i: Integer): Boolean
        => i >= 0 && i < m.RowCount(t);

    // The library's own range predicate for table t, applied to the typed index of row i.
    IsInTable(m: BrepModel, t: TableName, i: Integer): Boolean
        => match (t) {
            VerticesTable => m.IsVertexInRange(BrepVertexIndex(i));
            EdgesTable => m.IsEdgeInRange(BrepEdgeIndex(i));
            LoopsTable => m.IsLoopInRange(BrepLoopIndex(i));
            FacesTable => m.IsFaceInRange(BrepFaceIndex(i));
            ShellsTable => m.IsShellInRange(ShellIndex(i));
            BodiesTable => m.IsBodyInRange(BodyIndex(i));
            CurvesTable => m.Geometry.IsCurveInRange(CurveIndex(i));
            Curves2DTable => m.Geometry.IsCurve2DInRange(Curve2DIndex(i));
            PcurvesTable => m.Geometry.IsPcurveInRange(PcurveIndex(i));
            SurfacesTable => m.Geometry.IsSurfaceInRange(SurfaceIndex(i));
        };
}

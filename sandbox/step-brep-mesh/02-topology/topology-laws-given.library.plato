//==
// # Layer 2 laws behind a given whole-model guard (complexity sweep, chunk V2)
//
// The bodies of three 02-topology laws with their m.IsEveryIndexInRange guard
// passed in as ok, so layer 7's checks evaluate the guard once per check, not
// once per sample (docs/plans/step-mesher-complexity.md, ranked candidate 13).
// At merge these move into 02-topology/topology.library.plato and each law
// becomes `=> m.<Name>Given(m.IsEveryIndexInRange, ...)`, so the body is written
// once. Each holds exactly when its law does, given ok == m.IsEveryIndexInRange.
//
// Sections, in order:
//  - Pcurves
//  - Parameterization sign

library BrepTopologyGiven
{
    //==
    // # Pcurves

    // Law_PcurveRunsWithCurve's body, ok its whole-model guard.
    PcurveRunsWithCurveGiven(m: BrepModel, ok: Boolean, e: BrepEdgeIndex, k: Integer, t: Number): Boolean
        => ok
            ? (m.IsEdgeInRange(e) ? (m.HasPcurve(e, k) ? m.PcurveRunsWithCurveAt(e, k, t) : true) : true)
            : true;

    // Law_PcurveSurfaceIsAFaceSurface's body, ok its whole-model guard.
    PcurveSurfaceIsAFaceSurfaceGiven(m: BrepModel, ok: Boolean, e: BrepEdgeIndex, k: Integer): Boolean
        => ok
            ? (m.IsEdgeInRange(e) ? (m.HasPcurve(e, k) ? m.IsPcurveOnAdjacentFace(e, k) : true) : true)
            : true;

    //==
    // # Parameterization sign

    // Law_ParameterizationSignIsConstantOnFace's body, ok its whole-model
    // guard.
    ParameterizationSignIsConstantOnFaceGiven(m: BrepModel, ok: Boolean, site: CoedgeSite, t: Number): Boolean
        => m.ParameterizationSignIsConstantOnFaceGivenOnce(ok, site, t);
}

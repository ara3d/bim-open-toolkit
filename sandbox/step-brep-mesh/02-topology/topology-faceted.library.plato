//==
// # Faceted shells: coincidence by grid and sorted implicit edges (complexity sweep, chunk V9, TKT-377)
//
// Layer 2. The faceted part of the shell laws (docs/plans/step-mesher-complexity.md, candidate 35)
// tested every pair of a shell's poly-loop points (CoincidenceRoots, O(P^2)), did so three times
// per Law_OpenShellEulerEvenAndBounded case (ReducedCounts, ImplicitBoundaryCycleCount and
// ImplicitFreeEdgeKeys), summed the bounds before each one (PolyPointOffset, O(B^2)), and counted
// each implicit edge's uses by a scan of every use (ImplicitFreeEdgeKeys and
// IsDefectiveImplicitEdge, O(K^2)). Here:
//  - CoincidenceRootsByGrid buckets the points by tolerance cell, side 2 tol (V7's
//    CoincidenceCell and its helpers, 06-mesh/mesh-coincident-gridded.library.plato, which the
//    merge moves to layer 0), compares each point with the points of the 27 cells around its
//    own under the same predicate (IsCoincident), and closes the pairs with ClassRoots: the same
//    roots, since a root is the smallest item of its class whatever the join order. Where the
//    grid cannot be exact (a tolerance that is not positive and finite, a point beyond
//    CoincidenceCellBound) CoincidenceRoots runs. A point with a non-finite coordinate coincides
//    with nothing (its distance is NaN or infinite) and is left out of the grid.
//  - ShellPolyEdgesOf builds the roots and the sorted uses once per shell; the counts, the free
//    edges, the boundary cycles and the defects read runs of equal keys in the sorted uses.
//  - PolyPointOffsets is the prefix array of the bounds' point counts.
//  - ShellComponentCountByGridCounted is V8's ShellComponentCountByVertexCounted with its
//    poly-point branch over the grid: each point's face joined to the face of its class root.
// Results are identical to the namesakes (FacetedLaws). ImplicitFreeEdgeKeysSorted lists the
// same keys as ImplicitFreeEdgeKeys in ascending order instead of use order; its callers count
// them or close classes over them, which order does not change.
//
// Sections, in order:
//  - Coincidence by grid
//  - Implicit edges, once per shell
//  - Counts over the sorted uses
//  - Shell measures
//  - Connectivity

library BrepFacetedShells
{
    //==
    // # Coincidence by grid

    // Whether every coordinate of p is finite.
    IsFinitePoint(p: Point3D): Boolean
        => p.X.IsFinite && p.Y.IsFinite && p.Z.IsFinite;

    // CoincidenceRootsPairwise(m, points).
    CoincidenceRootsByGrid(m: BrepModel, points: Array<Point3D>): Array<Integer>
        => m.CoincidenceRootsByGridCounted(points).Value;

    // CoincidenceRootsPairwise(m, points) with its work counted: Insertions is the number of pair tests,
    // one for each point b in the 27 cells around each point a (a itself included), whether or
    // not the pair is then compared. The sort and the 9 binary searches per point are not
    // counted. The pairwise fallback counts P^2.
    CoincidenceRootsByGridCounted(m: BrepModel, points: Array<Point3D>): Counted<Array<Integer>>
    {
        var n = points.Count;
        var side = m.Tolerances.Length.CoincidenceCellSide;
        var candidates = n.Range.FlatMap(k => points[k].IsFinitePoint ? [k] : n.Range.Take(0));
        var cells = points.Map(p => p.CoincidenceCellOf(side));
        var exact = (side > 0.0 && side.IsFinite) ? candidates.All(k => cells[k].IsExactCoincidenceCell) : false;
        return exact
            ? m.GriddedCoincidenceRootsCounted(points, cells, candidates.Sort((a, b) => cells[a].CoincidenceCellAtMost(cells[b])))
            : Counted(m.CoincidenceRootsPairwise(points), Insertions(n * n));
    }

    // The coincidence roots of the points from the candidates in order, each compared with the
    // candidates of the 27 cells around it; counted as CoincidenceRootsByGridCounted states.
    // Precondition: order holds the candidates sorted by CoincidenceCellAtMost on cells, and
    // every one of their cells is exact.
    GriddedCoincidenceRootsCounted(m: BrepModel, points: Array<Point3D>,
        cells: Array<CoincidenceCell>, order: Array<Integer>): Counted<Array<Integer>>
    {
        var first = new List<Integer>();
        var second = new List<Integer>();
        var tests = 0;
        var i = 0;
        while (i < order.Count)
        {
            var a = order[i];
            var home = cells[a];
            var d = 0;
            while (d < 9)
            {
                var x = home.X + (d % 3 - 1).ToNumber;
                var y = home.Y + (d / 3 - 1).ToNumber;
                var last = CoincidenceCell(x, y, home.Z + 1.0);
                var k = order.FirstCellAtLeast(cells, CoincidenceCell(x, y, home.Z - 1.0));
                var going = k < order.Count ? cells[order[k]].CoincidenceCellAtMost(last) : false;
                while (going)
                {
                    var b = order[k];
                    tests = tests + 1;
                    if (a < b)
                    {
                        if (m.IsCoincident(points[a], points[b]))
                        {
                            first = first.Add(a);
                            second = second.Add(b);
                        }
                    }
                    k = k + 1;
                    going = k < order.Count ? cells[order[k]].CoincidenceCellAtMost(last) : false;
                }
                d = d + 1;
            }
            i = i + 1;
        }
        return Counted(ClassRoots(points.Count, first.Freeze(), second.Freeze()), Insertions(tests));
    }

    //==
    // # Implicit edges, once per shell

    // The points of the poly bounds, bound by bound.
    PolyBoundPoints(m: BrepModel, poly: Array<FaceBound>): Array<Point3D>
        => poly.FlatMap(b => m.Loops[b.Loop].PolyLoopPointsOf);

    // The poly-loop points of shell s, bound by bound in ShellPolyBounds order.
    ShellPolyPoints(m: BrepModel, s: ShellIndex): Array<Point3D>
        => m.PolyBoundPoints(m.ShellPolyBounds(s));

    // The position of the first point of every poly bound among the points of all the bounds,
    // then the total: entry k is PolyPointOffset(m, poly, k), for k from 0 to poly.Count.
    PolyPointOffsets(m: BrepModel, poly: Array<FaceBound>): Array<Integer>
    {
        var offsets = new Buffer<Integer>(poly.Count + 1);
        offsets = offsets.Set(0, 0);
        var k = 0;
        while (k < poly.Count)
        {
            offsets = offsets.Set(k + 1, offsets.At(k) + m.Loops[poly[k].Loop].PolyLoopPointsOf.Count);
            k = k + 1;
        }
        return offsets.Freeze();
    }

    // ImplicitEdgeUses(m, poly, pointRoots), each bound's offset read from PolyPointOffsets.
    ImplicitEdgeUsesByOffsets(m: BrepModel, poly: Array<FaceBound>, pointRoots: Array<Integer>): Array<Integer>
    {
        var offsets = m.PolyPointOffsets(poly);
        return poly.Count.Range.FlatMap(k => m.ImplicitEdgeUsesOf(poly[k], offsets[k], pointRoots));
    }

    // Shell s's poly-loop points identified by coincidence, and its implicit edge uses sorted.
    // Precondition: m.IsEveryIndexInRange.
    ShellPolyEdgesOf(m: BrepModel, s: ShellIndex): ShellPolyEdges
    {
        var poly = m.ShellPolyBounds(s);
        var roots = m.CoincidenceRootsByGrid(m.PolyBoundPoints(poly));
        return ShellPolyEdges(roots, m.ImplicitEdgeUsesByOffsets(poly, roots).Sort((a, b) => a <= b));
    }

    //==
    // # Counts over the sorted uses

    // The position after the run of uses starting at i that share its key (u / 2).
    // Precondition: 0 <= i < p.SortedUses.Count.
    UseRunEnd(p: ShellPolyEdges, i: Integer): Integer
    {
        var uses = p.SortedUses;
        var j = i + 1;
        var going = j < uses.Count ? uses[j] / 2 == uses[i] / 2 : false;
        while (going)
        {
            j = j + 1;
            going = j < uses.Count ? uses[j] / 2 == uses[i] / 2 : false;
        }
        return j;
    }

    // The number of distinct implicit edges: ImplicitEdgeKeys(...).DistinctCount.
    ImplicitEdgeCountSorted(p: ShellPolyEdges): Integer
    {
        var count = 0;
        var i = 0;
        while (i < p.SortedUses.Count)
        {
            count = count + 1;
            i = p.UseRunEnd(i);
        }
        return count;
    }

    // The keys of the implicit edges used exactly once, ascending: ImplicitFreeEdgeKeys' keys.
    ImplicitFreeEdgeKeysSorted(p: ShellPolyEdges): Array<Integer>
    {
        var free = new List<Integer>();
        var i = 0;
        while (i < p.SortedUses.Count)
        {
            var j = p.UseRunEnd(i);
            if (j - i == 1)
            {
                free = free.Add(p.SortedUses[i] / 2);
            }
            i = j;
        }
        return free.Freeze();
    }

    // ImplicitBoundaryCycleCount: the classes of the free implicit edges joined at shared point
    // classes.
    ImplicitBoundaryCycleCountSorted(p: ShellPolyEdges): Integer
    {
        var n = p.PointRoots.Count;
        var free = p.ImplicitFreeEdgeKeysSorted;
        var roots = ClassRoots(n, free.Map(k => k / n), free.Map(k => k % n));
        return free.Map(k => roots[k / n]).DistinctCount;
    }

    // IsDefectiveImplicitEdge's rule on an edge's use count and forward use count: declared
    // closed, not exactly two uses in opposite directions; open, more than two uses, or two in
    // the same direction.
    IsDefectiveUseCount(total: Integer, forward: Integer, closed: Boolean): Boolean
    {
        var opposite = total == 2 ? forward == 1 : false;
        return closed ? opposite.Not : (total > 2 || (total == 2 ? opposite.Not : false));
    }

    // PolyEdgeUseDefects for a shell declared closed or open: the implicit edges whose run of
    // uses breaks the rule.
    PolyEdgeUseDefectsSorted(p: ShellPolyEdges, closed: Boolean): Integer
    {
        var uses = p.SortedUses;
        var defects = 0;
        var i = 0;
        while (i < uses.Count)
        {
            var j = p.UseRunEnd(i);
            var forward = 0;
            var k = i;
            while (k < j)
            {
                forward = forward + uses[k] % 2;
                k = k + 1;
            }
            if (IsDefectiveUseCount(j - i, forward, closed))
            {
                defects = defects + 1;
            }
            i = j;
        }
        return defects;
    }

    //==
    // # Shell measures

    // ReducedCountsIndexed(m, s, t) with the faceted part read from p = m.ShellPolyEdgesOf(s).
    ReducedCountsPolyIndexed(m: BrepModel, s: ShellIndex, t: EdgeUseTable, p: ShellPolyEdges): ShellCounts
    {
        var shellEdges = t.EdgesOfShellByUse;
        var degenerate = shellEdges.FlatMap(e => m.IsDegenerateEdge(e) ? [e] : shellEdges.Take(0));
        var roots = m.DegenerateEdgeRoots(degenerate);
        var vertexClasses = m.VerticesOfShellByMark(s, t).Map(v => roots[v.Value]);
        var faces = m.ShellFaces(s);
        var kept = faces.Reduce(0, (n, f) => n + m.KeptReducedBoundCount(f, roots));
        return ShellCounts(
            vertexClasses.DistinctCount + p.PointRoots.ClassCount,
            shellEdges.Count - degenerate.Count + p.ImplicitEdgeCountSorted,
            faces.Count,
            kept);
    }

    // BoundaryCycleCount(m, s), given t = m.EdgeUseTable(s) and p = m.ShellPolyEdgesOf(s).
    BoundaryCycleCountPoly(m: BrepModel, t: EdgeUseTable, p: ShellPolyEdges): Integer
        => m.IndexedBoundaryCycleCountIndexed(t) + p.ImplicitBoundaryCycleCountSorted;

    // ShellEulerPoincare(m, s) + BoundaryCycleCount(m, s), the value
    // Law_OpenShellEulerEvenAndBounded tests, with the shell's edge-use table and poly edges
    // built once. Precondition: m.IsEveryIndexInRange.
    ShellEulerPlusBoundaryCycles(m: BrepModel, s: ShellIndex): Integer
    {
        var t = m.EdgeUseTable(s);
        var p = m.ShellPolyEdgesOf(s);
        return m.ReducedCountsPolyIndexed(s, t, p).EulerPoincare + m.BoundaryCycleCountPoly(t, p);
    }

    //==
    // # Connectivity

    // ShellComponentCount(m, s).
    ShellComponentCountByGrid(m: BrepModel, s: ShellIndex): Integer
        => m.ShellComponentCountByGridCounted(s).Value;

    // ShellComponentCountByVertexCounted with the poly part over the grid: every poly-loop point
    // of every face is listed with its face position, the points' coincidence roots found by
    // CoincidenceRootsByGridCounted, and each point's face joined to its root's face. Points
    // chained by coincidence join faces chained by FacesTouch, and back, so the classes are the
    // same. Work: Insertions, one per face position visited, two per vertex reference and two
    // per poly point (listed, then joined), plus the grid's pair tests; the sorts are not
    // counted. Precondition: every face of the shell intact.
    ShellComponentCountByGridCounted(m: BrepModel, s: ShellIndex): Counted<Integer>
    {
        var faces = m.ShellFaces(s);
        var n = faces.Count;
        var keyList = new List<Integer>();
        var ownerList = new List<Integer>();
        var pointList = new List<Point3D>();
        var pointOwnerList = new List<Integer>();
        var i = 0;
        while (i < n)
        {
            var vs = m.FaceVertices(faces[i]);
            var k = 0;
            while (k < vs.Count)
            {
                keyList = keyList.Add(vs[k].Value);
                ownerList = ownerList.Add(i);
                k = k + 1;
            }
            var ps = m.FacePolyPoints(faces[i]);
            var q = 0;
            while (q < ps.Count)
            {
                pointList = pointList.Add(ps[q]);
                pointOwnerList = pointOwnerList.Add(i);
                q = q + 1;
            }
            i = i + 1;
        }
        var keys = keyList.Freeze();
        var owners = ownerList.Freeze();
        var pointOwners = pointOwnerList.Freeze();
        var order = keys.SortedIndices((a, b) => a <= b);
        var first = new List<Integer>();
        var second = new List<Integer>();
        var j = 1;
        while (j < order.Count)
        {
            if (keys[order[j]] == keys[order[j - 1]])
            {
                first = first.Add(owners[order[j - 1]]);
                second = second.Add(owners[order[j]]);
            }
            j = j + 1;
        }
        var grid = m.CoincidenceRootsByGridCounted(pointList.Freeze());
        var roots = grid.Value;
        var r = 0;
        while (r < roots.Count)
        {
            if (roots[r] != r)
            {
                first = first.Add(pointOwners[roots[r]]);
                second = second.Add(pointOwners[r]);
            }
            r = r + 1;
        }
        var count = ClassRoots(n, first.Freeze(), second.Freeze()).ClassCount;
        return Counted(count, Insertions(n + 2 * keys.Count + 2 * roots.Count).Add(grid.Work));
    }
}

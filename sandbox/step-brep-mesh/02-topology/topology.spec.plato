//==
// # BrepTopology contracts
//
// Layer 2 of the STEP B-rep to mesh design (README.md beside this file). The
// invented constructs of SPEC-DSL.md section 3 for this layer: the invariants
// of a valid model and of its counts, the contract of EdgeDomain, the contracts
// of the deferred functions, and the theorems. Read, not run: the
// gate skips this file. Every invariant and ensures cites a Law_ or a
// predicate of topology.library.plato, so deleting this file loses no rule,
// only the knowledge of which rules are promises.
//
// Sections, in order:
//  - Types
//  - Edge domains
//  - Deferred algorithms
//  - Model transforms
//  - Theorems

//==
// # Types

// The invariants of a valid model. No constructor is listed: a model decoded
// from a file may break any of them, so they are what layer 7's ValidateBrep
// checks, not what construction promises. Quantifiers range over every row,
// every end of an edge, and every sample fraction in [0, 1].
spec BrepModel
{
    invariant Law_IndicesInRange(self);
    invariant forall (l: Integer) in self.Loops.Count.Range : Law_LoopsChainEndToStart(self, BrepLoopIndex(l));
    invariant forall (l: Integer) in self.Loops.Count.Range : Law_PolyLoopHasThreePoints(self, BrepLoopIndex(l));
    invariant forall (s: Integer) in self.Shells.Count.Range : Law_PolyLoopEdgesPairUp(self, ShellIndex(s));
    invariant forall (f: Integer) in self.Faces.Count.Range : Law_AtLeastOneBound(self, BrepFaceIndex(f));
    invariant forall (f: Integer) in self.Faces.Count.Range : Law_AtMostOneOuterBound(self, BrepFaceIndex(f));
    invariant forall (f: Integer) in self.Faces.Count.Range : Law_FaceBoundsShareNoVertex(self, BrepFaceIndex(f));
    invariant forall (f: Integer) in self.Faces.Count.Range : Law_NoRedundantVertexLoop(self, BrepFaceIndex(f));
    invariant forall (f: Integer) in self.Faces.Count.Range :
        forall (e: Integer) in self.Edges.Count.Range : Law_SeamUsesRunOpposite(self, BrepFaceIndex(f), BrepEdgeIndex(e));
    invariant forall (f: Integer) in self.Faces.Count.Range : Law_LoopWindingMatchesSameSense(self, BrepFaceIndex(f));
    invariant forall (s: Integer) in self.Shells.Count.Range :
        forall (e: Integer) in self.Edges.Count.Range : Law_EveryEdgeUsedTwiceInClosedShell(self, ShellIndex(s), BrepEdgeIndex(e));
    invariant forall (s: Integer) in self.Shells.Count.Range :
        forall (e: Integer) in self.Edges.Count.Range : Law_OpenShellEdgesUsedAtMostTwice(self, ShellIndex(s), BrepEdgeIndex(e));
    invariant forall (s: Integer) in self.Shells.Count.Range : Law_DeclaredClosedIsClosed(self, ShellIndex(s));
    invariant forall (s: Integer) in self.Shells.Count.Range :
        forall (e: Integer) in self.Edges.Count.Range : Law_EdgeUsesHaveOppositeOrientation(self, ShellIndex(s), BrepEdgeIndex(e));
    invariant forall (s: Integer) in self.Shells.Count.Range :
        forall (v: Integer) in self.Vertices.Count.Range : Law_VertexLinkIsOneCycle(self, ShellIndex(s), BrepVertexIndex(v));
    invariant forall (s: Integer) in self.Shells.Count.Range :
        forall (v: Integer) in self.Vertices.Count.Range : Law_VertexLoopVertexIsIsolated(self, ShellIndex(s), BrepVertexIndex(v));
    invariant forall (s: Integer) in self.Shells.Count.Range : Law_EulerPoincareEvenAndBounded(self, ShellIndex(s));
    invariant forall (s: Integer) in self.Shells.Count.Range : Law_OpenShellEulerEvenAndBounded(self, ShellIndex(s));
    invariant forall (s: Integer) in self.Shells.Count.Range :
        forall (v: Integer) in self.Vertices.Count.Range : Law_OpenShellVertexLinkIsCycleOrPath(self, ShellIndex(s), BrepVertexIndex(v));
    invariant forall (s: Integer) in self.Shells.Count.Range : Law_ShellIsConnected(self, ShellIndex(s));
    invariant forall (s: Integer) in self.Shells.Count.Range : Law_ShellIsOrientable(self, ShellIndex(s));
    invariant forall (b: Integer) in self.Bodies.Count.Range : Law_SolidShellsAreDeclaredClosed(self, BodyIndex(b));
    invariant forall (e: Integer) in self.Edges.Count.Range : Law_EdgeDomainIsForward(self, BrepEdgeIndex(e));
    invariant forall (e: Integer) in self.Edges.Count.Range :
        forall (atStart: Boolean) : Law_EdgeDomainEndsAtVertices(self, BrepEdgeIndex(e), atStart);
    invariant forall (e: Integer) in self.Edges.Count.Range :
        forall (atStart: Boolean) : Law_VertexCoincidesWithCurveEnd(self, BrepEdgeIndex(e), atStart);
    invariant forall (e: Integer) in self.Edges.Count.Range : Law_CoincidentEndsAreOneVertex(self, BrepEdgeIndex(e));
    invariant forall (e: Integer) in self.Edges.Count.Range : Law_EdgeHasPositiveExtent(self, BrepEdgeIndex(e));
    invariant forall (e: Integer) in self.Edges.Count.Range : Law_DegenerateEdgeHasCoincidentVertices(self, BrepEdgeIndex(e));
    invariant forall (e: Integer) in self.Edges.Count.Range :
        forall (t: Number) in NumberInterval(0.0, 1.0) : Law_DegenerateEdgeStaysAtStart(self, BrepEdgeIndex(e), t);
    invariant forall (f: Integer) in self.Faces.Count.Range :
        forall (site: CoedgeSite) in self.CoedgeSitesOfFace(BrepFaceIndex(f)) :
            forall (t: Number) in NumberInterval(0.0, 1.0) : Law_EdgeLiesOnAdjacentSurfaces(self, site, t);
    invariant forall (e: Integer) in self.Edges.Count.Range :
        forall (k: Integer) :
            forall (t: Number) in NumberInterval(0.0, 1.0) : Law_PcurveAgreesWithCurve(self, BrepEdgeIndex(e), k, t);
    invariant forall (e: Integer) in self.Edges.Count.Range :
        forall (k: Integer) :
            forall (t: Number) in NumberInterval(0.0, 1.0) : Law_CurveAgreesWithPcurve(self, BrepEdgeIndex(e), k, t);
    invariant forall (e: Integer) in self.Edges.Count.Range :
        forall (k: Integer) :
            forall (t: Number) in NumberInterval(0.0, 1.0) : Law_PcurveRunsWithCurve(self, BrepEdgeIndex(e), k, t);
    invariant forall (e: Integer) in self.Edges.Count.Range :
        forall (k: Integer) : Law_PcurveSurfaceIsAFaceSurface(self, BrepEdgeIndex(e), k);
}

// Cell counts are never negative. Plain data: witnesses state their expected
// counts with the tuple constructor.
spec ShellCounts
{
    invariant self.Vertices >= 0;
    invariant self.Edges >= 0;
    invariant self.Faces >= 0;
    invariant self.Loops >= 0;
}

//==
// # Edge domains

// The derived parameter range of an edge (README, "The edge domain"). Its
// body is the definition; this contract states what consumers may rely on.
// Layer 4's discretization starts and ends at Range.Start and Range.End.
spec EdgeDomain(m: BrepModel, e: BrepEdgeIndex): CurveDomain
{
    requires Law_IndicesInRange(m);
    requires m.IsEdgeInRange(e);
    ensures result.Range.Start == m.VertexParameter(e, m.FirstVertexAlongCurve(e));   // exact by construction
    ensures match (m.Geometry.Domain(m.Edges[e].Curve).Periodicity) {
        Aperiodic => result.Range.End
            == (m.IsClosedEdge(e) ? result.Range.Start : m.VertexParameter(e, m.LastVertexAlongCurve(e)));   // exact by construction
        Periodic(period) => result.Range.End
            == (m.IsClosedEdge(e)
                ? result.Range.Start + period
                : m.VertexParameter(e, m.LastVertexAlongCurve(e)).PeriodicRepresentativeAbove(result.Range.Start, period));   // exact by construction
        Closed(period) => result.Range.End
            == (m.IsClosedEdge(e)
                ? result.Range.Start + period
                : m.VertexParameter(e, m.LastVertexAlongCurve(e)).PeriodicRepresentativeAbove(result.Range.Start, period));   // exact by construction
    };
    ensures result.Periodicity == match (m.Geometry.Domain(m.Edges[e].Curve).Periodicity) {
        Aperiodic => Periodicity.Aperiodic;
        Periodic(period) => Periodicity.Periodic(period);
        Closed(period) => m.IsClosedEdge(e) ? Periodicity.Closed(period) : Periodicity.Aperiodic;
    };
    ensures result.Range.Start.IsFinite && result.Range.End.IsFinite;   // ClosestParameter is finite: no unbounded range (review F4a)
    ensures m.IsOnClosedCurve(e) ? Law_EdgeDomainIsForward(m, e) : true;
    measure 1;
}

// The range of an edge on one of its pcurves. Its body is the definition;
// this contract states what consumers may rely on.
spec PcurveEdgeDomain(m: BrepModel, e: BrepEdgeIndex, p: PcurveIndex): CurveDomain
{
    requires Law_IndicesInRange(m);
    requires m.IsEdgeInRange(e);
    requires m.Geometry.PcurvesOf(m.Edges[e].Curve).Any(q => q == p);
    ensures result.Range.Start.IsFinite && result.Range.End.IsFinite;   // never the pcurve's own unbounded domain (review F4b)
    ensures result.Range.Start <= result.Range.End;
    ensures result.Range.Start == m.Geometry.PcurveRangeOver(p, m.Edges[e].Curve, m.EdgeDomain(e).Range).Start;   // exact by construction
    ensures (m.IsClosedEdge(e) && m.IsOnClosedCurve(e) && m.Geometry.PcurveParameterPeriod(p) > 0.0)
        ? result.Range.End == result.Range.Start + m.Geometry.PcurveParameterPeriod(p)   // exact by construction
        : true;
    measure 1;
}

//==
// # Deferred algorithms

// Same parameterization of a pcurve and its curve over an edge: the route
// choice of review C5, not a validity rule.
spec SharesCurveParameter(m: BrepModel, e: BrepEdgeIndex, k: Integer): Boolean
{
    requires Law_IndicesInRange(m);
    requires m.IsEdgeInRange(e);
    requires m.HasPcurve(e, k);
    ensures result == forall (t: Number) in NumberInterval(0.0, 1.0) :
        m.PcurveParameterDeviationAt(e, k, t) <= m.Tolerances.Length.Value;
    measure m.EdgeDomain(e).Range.Length;
    deferred "PcurveParameterDeviationAt at the curve's breakpoints inside the edge domain and the midpoints between them, bisecting each span whose midpoint deviation exceeds half the tolerance, to a depth bounded by the parameter tolerance";
}

// Degeneracy is a property of the curve over the edge domain, not of the two
// vertex points: a full circle has coincident ends and is not degenerate.
spec IsDegenerateEdge(m: BrepModel, e: BrepEdgeIndex): Boolean
{
    requires Law_IndicesInRange(m);
    requires m.IsEdgeInRange(e);
    ensures result == forall (t: Number) in m.EdgeDomain(e).Range :
        m.IsCoincident(m.Geometry.Eval(m.Edges[e].Curve, t), m.Vertices[m.Edges[e].Start].Point);
    ensures result ? (forall (t: Number) in NumberInterval(0.0, 1.0) : Law_DegenerateEdgeStaysAtStart(m, e, t)) : true;
    measure 1;
    deferred "largest distance from a point to a curve arc: closed form for lines and conics; for splines, subdivision of the span bounding boxes with Newton refinement on the squared distance, cost proportional to the span count";
}

// The reduction of research/VALIDATION-MATH.md 1.4. Faces never change; edges
// lose exactly the degenerate ones; vertices and loops can only decrease. With
// poly loops present, their implicit cells are added, so only Faces is pinned.
spec ReducedCounts(m: BrepModel, s: ShellIndex): ShellCounts
{
    requires Law_IndicesInRange(m);
    requires m.IsShellInRange(s);
    ensures result.Faces == m.RawCounts(s).Faces;
    ensures m.ShellHasPolyLoop(s) ? true : result.Edges == m.RawCounts(s).Edges - m.DegenerateEdgeCount(s);
    ensures m.ShellHasPolyLoop(s) ? true : result.Vertices <= m.RawCounts(s).Vertices;
    ensures m.ShellHasPolyLoop(s) ? true : result.Loops <= m.RawCounts(s).Loops;
    ensures result.Vertices >= 0 && result.Edges >= 0 && result.Loops >= 0;
    measure m.CoedgeSitesOfShell(s).Count + m.RawCounts(s).Loops;
    deferred "union-find over the shell's vertices, joining the two ends of each degenerate edge; drop degenerate edges; keep an edge loop left with no coedge as a vertex loop on its class; per face, drop each vertex loop whose class appears on another bound or on an earlier vertex loop; identify poly-loop points by coincidence through a spatial hash and their implicit edges as unordered point pairs; count classes, edges, faces, bounds";
}

// The boundary cycles of a shell: the free edges of the reduced cells,
// chained at each vertex through the vertex's link path. The reduced cells
// include a faceted bound's implicit edges, as ReducedCounts counts them, so
// a lone poly-loop triangle has one boundary cycle (F-52 item 4).
spec BoundaryCycleCount(m: BrepModel, s: ShellIndex): Integer
{
    requires Law_IndicesInRange(m);
    requires m.IsShellInRange(s);
    requires forall (v: Integer) in m.Vertices.Count.Range : Law_OpenShellVertexLinkIsCycleOrPath(m, s, BrepVertexIndex(v));
    ensures result >= 0;
    ensures result <= m.FreeEdgeCount(s) + m.ImplicitFreeEdgeCount(s);
    ensures (m.FreeEdgeCount(s) + m.ImplicitFreeEdgeCount(s)) == 0 ? result == 0 : result >= 1;
    measure m.FreeEdgeCount(s) + m.ImplicitFreeEdgeCount(s);
    deferred "mark the shell's free edges that are not degenerate, and its implicit edges used once; from each unmarked-visited one, walk forward: at its end vertex take the link path (CornersAroundVertex), at a poly-loop point class the other free implicit edge there, cross to the free edge at the path's other end, and continue until the walk returns to its first edge; the result is the number of walks";
}

// The defects of a faceted shell's implicit edges.
spec PolyEdgeUseDefects(m: BrepModel, s: ShellIndex): Integer
{
    requires Law_IndicesInRange(m);
    requires m.IsShellInRange(s);
    ensures result >= 0;
    ensures m.ShellHasPolyLoop(s) ? true : result == 0;
    measure m.ShellFaces(s).Count + m.RawCounts(s).Loops;
    deferred "hash every poly-loop point of the shell into cells of the length tolerance and unite coinciding points across neighbouring cells; key each implicit edge by its unordered pair of classes and record each use's direction; count the keys whose use count and directions break the rule for the shell's declared closedness";
}

// The number of components of the link of v: the graph on the edge ends at v
// whose links are the corners (ArrivingEnd to LeavingEnd of each).
spec LinkComponentCount(m: BrepModel, s: ShellIndex, v: BrepVertexIndex): Integer
{
    requires Law_IndicesInRange(m);
    requires m.IsShellInRange(s);
    ensures m.CornersAtVertex(s, v).Count == 0 ? result == 0 : result >= 1;
    ensures result <= m.CornersAtVertex(s, v).Count;
    ensures m.CornersAtVertex(s, v).Count == 1 ? result == 1 : true;
    measure m.CornersAtVertex(s, v).Count;
    deferred "union-find over the edge ends ArrivingEnd(c) and LeavingEnd(c) of every corner c at v, uniting the two ends of each corner; the result is the number of classes, which equals the number of classes of corners under the transitive closure of CornersShareEnd";
}

// The number of components of a shell: classes of its faces under the
// transitive closure of FacesTouch.
spec ShellComponentCount(m: BrepModel, s: ShellIndex): Integer
{
    requires Law_IndicesInRange(m);
    requires m.IsShellInRange(s);
    ensures m.ShellFaces(s).Count == 0 ? result == 0 : result >= 1;
    ensures result <= m.ShellFaces(s).Count;
    ensures m.ShellFaces(s).Count == 2
        ? result == (m.FacesTouch(m.ShellFaces(s)[0], m.ShellFaces(s)[1]) ? 1 : 2)
        : true;
    ensures forall (f: BrepFaceIndex) in m.ShellFaces(s) :
        m.ShellFaces(s).All(g => m.FacesTouch(f, g)) ? result <= 1 : true;
    measure m.CoedgeSitesOfShell(s).Count + m.RawCounts(s).Loops;
    deferred "union-find over the shell's faces: one pass over every bound, uniting the faces that reference each vertex; poly-loop points keyed through a spatial hash with cells of the length tolerance, uniting the faces of coinciding points; the result is the number of classes";
}

// The repair a parity search finds: faces of the shell, each once, whose
// reversal makes the shell coherent when any set can.
spec OrientationFlips(m: BrepModel, s: ShellIndex): Array<BrepFaceIndex>
{
    requires Law_IndicesInRange(m);
    requires m.IsShellInRange(s);
    ensures forall (f: BrepFaceIndex) in result : m.ShellFaces(s).Any(g => g == f);
    ensures forall (i: Integer) in result.Count.Range :
        forall (j: Integer) in result.Count.Range : i < j ? result[i] != result[j] : true;
    ensures m.HasCoherentOrientation(s) ? result.Count == 0 : true;
    ensures (exists (flips: Array<BrepFaceIndex>) : m.WithFacesReversed(flips).HasCoherentOrientation(s))
        ? m.WithFacesReversed(result).HasCoherentOrientation(s)
        : true;
    measure m.CoedgeSitesOfShell(s).Count;
    deferred "breadth-first two-colouring of each component of the face graph of the shell: an edge with uses in two different faces joins them, with parity same when its uses run opposite (CoedgeRunsForwardOnCurve differs) and differ otherwise; the first face of a component is coloured keep; the faces coloured flip are the result, in shell order; a conflict (an odd cycle, or a seam whose uses run the same way) is left as found";
}

// The faces around a vertex in order. Exists when the link is one component
// and no edge at the vertex has more than two uses, so that the link is one
// cycle or one path; it closes into a cycle when every edge at the vertex has
// two uses.
spec CornersAroundVertex(m: BrepModel, s: ShellIndex, v: BrepVertexIndex): Array<CoedgeSite>
{
    requires Law_IndicesInRange(m);
    requires m.IsShellInRange(s);
    requires m.LinkComponentCount(s, v) == 1;
    requires forall (c: CoedgeSite) in m.CornersAtVertex(s, v) :
        m.UseCount(s, m.CoedgeAt(c).Edge) <= 2 && m.UseCount(s, m.CoedgeAt(m.NextSite(c)).Edge) <= 2;
    ensures result.Count == m.CornersAtVertex(s, v).Count;
    ensures forall (k: Integer) in result.Count.Range : m.CornersAtVertex(s, v).Any(c => c == result[k]);
    ensures forall (i: Integer) in result.Count.Range :
        forall (j: Integer) in result.Count.Range : i < j ? result[i] != result[j] : true;
    ensures forall (k: Integer) in (result.Count - 1).Range : m.CornersShareEnd(result[k], result[k + 1]);
    ensures (forall (c: CoedgeSite) in m.CornersAtVertex(s, v) :
            m.UseCount(s, m.CoedgeAt(c).Edge) == 2 && m.UseCount(s, m.CoedgeAt(m.NextSite(c)).Edge) == 2)
        ? m.CornersShareEnd(result[result.Count - 1], result[0])
        : true;
    measure m.CornersAtVertex(s, v).Count;
    deferred "walk the link: start at a corner with a free end if there is one, else at any corner; repeatedly cross the current corner's unvisited end to the other corner at that end";
}

// The guard of Law_LoopWindingMatchesSameSense. A face it rejects is not
// wrong; its winding is checked after face meshing inserts seams and poles
// (layer 5's region laws).
spec IsPlainInParameters(m: BrepModel, f: BrepFaceIndex): Boolean
{
    requires Law_IndicesInRange(m);
    requires m.IsFaceInRange(f);
    ensures result ? m.HasOnlyEdgeLoops(f) : true;
    ensures result ? m.HasSeam(f).Not : true;
    ensures result ? m.Faces[f].Bounds.Count >= 1 : true;
    measure m.CoedgeSitesOfFace(f).Count;
    deferred "sample each coedge's curve over its edge domain in its composed direction; map every sample to (u, v) with Project; lift each value next to its predecessor by the period of every direction with a seam, Closed as well as Periodic (NearestUnwrapped on the surface domain); reject when a bound's lifted polygon does not return to its start within the parameter tolerance, or a loop vertex lies on a side DegenerateSides names";
}

// Green's theorem with unit weight over the face's parameter-space region.
spec SignedParameterArea(m: BrepModel, f: BrepFaceIndex): Number
{
    requires Law_IndicesInRange(m);
    requires m.IsFaceInRange(f);
    requires m.IsPlainInParameters(f);
    ensures result.IsFinite;
    measure m.CoedgeSitesOfFace(f).Count;
    deferred "the shoelace sum over the lifted polygons IsPlainInParameters builds, each bound traversed as the face uses it, with samples added until the sign no longer changes";
}

//==
// # Model transforms
//
// The metamorphic inputs layer 8's laws compare runs over. The name review
// of 2026-10-17 moved these contracts here from layer 8's spec.

// A rigid motion of the model: tables and parameters kept, points moved.
// Layer 8's Law_RigidMotionMovesPositions relies on this contract.
spec RigidlyMoved(m: BrepModel, motion: Frame3D): BrepModel
{
    requires motion.IsOrthonormalWithin(m.Tolerances.Angle);
    ensures result.Vertices.Count == m.Vertices.Count;
    ensures result.Edges.Count == m.Edges.Count && result.Loops.Count == m.Loops.Count && result.Faces.Count == m.Faces.Count;
    ensures result.Shells.Count == m.Shells.Count && result.Bodies.Count == m.Bodies.Count;
    ensures result.Tolerances == m.Tolerances;
    ensures forall (v: Integer) in m.Vertices.Count.Range : result.Vertices[v].Point.Coincident(motion.PointInFrame(m.Vertices[v].Point), m.Tolerances.Length);
    ensures forall (s: Integer) in m.Geometry.Surfaces.Count.Range : forall (uv: UvCoordinate) : result.Geometry.Eval(SurfaceIndex(s), uv).Coincident(motion.PointInFrame(m.Geometry.Eval(SurfaceIndex(s), uv)), m.Tolerances.Length);
    ensures forall (c: Integer) in m.Geometry.Curves.Count.Range : forall (t: Number) : result.Geometry.Eval(CurveIndex(c), t).Coincident(motion.PointInFrame(m.Geometry.Eval(CurveIndex(c), t)), m.Tolerances.Length);
    measure m.Vertices.Count + m.Geometry.Curves.Count + m.Geometry.Curves2D.Count + m.Geometry.Surfaces.Count;
}

// The model scaled by factor: tables kept, lengths multiplied. Layer 8's
// scaling laws rely on this contract.
spec ScaledBy(m: BrepModel, factor: Number): BrepModel
{
    requires factor > 0.0 && factor.IsFinite;
    ensures result.Vertices.Count == m.Vertices.Count;
    ensures result.Edges.Count == m.Edges.Count && result.Loops.Count == m.Loops.Count && result.Faces.Count == m.Faces.Count;
    ensures result.Shells.Count == m.Shells.Count && result.Bodies.Count == m.Bodies.Count;
    ensures result.Tolerances.Length.Value == m.Tolerances.Length.Value * factor;   // exact by construction: the same product
    ensures result.Tolerances.Angle == m.Tolerances.Angle;
    ensures result.Tolerances.LengthParameter.Value == m.Tolerances.LengthParameter.Value * factor;   // exact by construction: the same product
    ensures result.Tolerances.AngleParameter == m.Tolerances.AngleParameter;
    ensures forall (v: Integer) in m.Vertices.Count.Range : result.Vertices[v].Point.Coincident(m.Vertices[v].Point.ScaledPoint(factor), result.Tolerances.Length);
    measure m.Vertices.Count + m.Geometry.Curves.Count + m.Geometry.Curves2D.Count + m.Geometry.Surfaces.Count;
}

// Reversal keeps every table but the faces' flags.
spec WithEveryFaceReversed(m: BrepModel): BrepModel
{
    ensures result.Faces.Count == m.Faces.Count;
    ensures forall (f: Integer) in m.Faces.Count.Range : result.Faces[f].SameSense == !m.Faces[f].SameSense;
    ensures forall (f: Integer) in m.Faces.Count.Range : forall (j: Integer) in m.Faces[f].Bounds.Count.Range : result.Faces[f].Bounds[j].Orientation == !m.Faces[f].Bounds[j].Orientation;
    ensures forall (f: Integer) in m.Faces.Count.Range : m.FaceNormalSign(BrepFaceIndex(f)) == -result.FaceNormalSign(BrepFaceIndex(f));
    measure m.Faces.Count;
}

//==
// # Theorems

// When a shell has nothing to reduce, the reduction changes nothing.
theorem ReducedCountsEqualRawOnCleanShell
{
    given m: BrepModel, s: ShellIndex;
    assume Law_IndicesInRange(m);
    assume m.IsShellInRange(s);
    assume m.DegenerateEdgeCount(s) == 0;
    assume m.ShellHasPolyLoop(s).Not;
    assume forall (f: BrepFaceIndex) in m.ShellFaces(s) : Law_FaceBoundsShareNoVertex(m, f);
    assume forall (f: BrepFaceIndex) in m.ShellFaces(s) : Law_NoRedundantVertexLoop(m, f);
    conclude m.ReducedCounts(s) == m.RawCounts(s);
    because "The reduction does three things: contracts degenerate edges, drops vertex loops whose vertex is on another bound of the same face or repeats another vertex loop there, and identifies poly-loop points. With no degenerate edge there is nothing to contract or merge, so vertex classes are single vertices and every edge stays. A dropped vertex loop is exactly a redundant one (IsRedundantVertexLoop), which Law_NoRedundantVertexLoop excludes, so no vertex loop is dropped. With no poly loop nothing is identified. Every count is then the raw one.";
}

// The domain-end law follows from the vertex-on-curve law, on every curve
// whose formula wraps or does not loop. The case the first version excluded,
// a closed edge on an aperiodic curve, now has the range [a, a] and is
// covered (review F4c).
theorem EdgeDomainEndsFollowFromVertexOnCurve
{
    given m: BrepModel, e: BrepEdgeIndex, atStart: Boolean;
    assume Law_IndicesInRange(m);
    assume m.IsEdgeInRange(e);
    assume m.Geometry.Domain(m.Edges[e].Curve).HasSeam ? m.Geometry.Domain(m.Edges[e].Curve).Periodicity.IsPeriodic : true;
    assume Law_VertexCoincidesWithCurveEnd(m, e, atStart);
    conclude Law_EdgeDomainEndsAtVertices(m, e, atStart);
    because "EdgeDomain puts at the end that SameSense assigns to a vertex either that vertex's ClosestParameter value (the first vertex along the curve, at Range.Start; the last vertex on an aperiodic open edge, at Range.End) or a value congruent to it modulo the period (the last vertex on a periodic curve, by PeriodicRepresentativeAbove; a closed edge's single vertex at first + period). Eval is periodic in a periodic parameter, so the curve point at that end is the curve point VertexCurveDeviation measures, and the assumption bounds its distance to the vertex by Tolerances.Length. A closed edge on an aperiodic curve has both ends at the vertex's own parameter. The excluded case, a Closed curve, wraps first + period back into the curve's domain, and Wrap may land at the far end of the range, whose point is the near end's only within the closure gap layer 3 accepted when it decided Closed; the law then holds within Tolerances.Length plus that gap, which is why the third assumption is there.";
    tested by Law_EdgeDomainEndsAtVertices, Law_VertexCoincidesWithCurveEnd;
}

// A coherent shell is orientable: the parity search flips nothing.
theorem CoherentShellIsOrientable
{
    given m: BrepModel, s: ShellIndex;
    assume Law_IndicesInRange(m);
    assume m.IsShellInRange(s);
    assume forall (e: Integer) in m.Edges.Count.Range : Law_EdgeUsesHaveOppositeOrientation(m, s, BrepEdgeIndex(e));
    conclude Law_ShellIsOrientable(m, s);
    because "Every edge with two uses in the shell has them running opposite, which is HasCoherentOrientation(s). OrientationFlips then returns no face (its third ensures), WithFacesReversed of no face is m, and IsOrientable(s) is HasCoherentOrientation(s), true.";
    tested by Law_ShellIsOrientable, Law_EdgeUsesHaveOppositeOrientation;
}

// A closed, orientable, manifold shell has an even Euler characteristic, on
// reduced counts, whatever its faces' own topology.
theorem ClosedOrientableShellHasEvenEuler
{
    given m: BrepModel, s: ShellIndex;
    assume Law_IndicesInRange(m);
    assume m.IsShellInRange(s);
    assume m.Shells[s].DeclaredClosed;
    assume m.ShellHasPolyLoop(s).Not;
    assume forall (e: Integer) in m.Edges.Count.Range : Law_EveryEdgeUsedTwiceInClosedShell(m, s, BrepEdgeIndex(e));
    assume forall (e: Integer) in m.Edges.Count.Range : Law_EdgeUsesHaveOppositeOrientation(m, s, BrepEdgeIndex(e));
    assume forall (v: Integer) in m.Vertices.Count.Range : Law_VertexLinkIsOneCycle(m, s, BrepVertexIndex(v));
    assume forall (v: Integer) in m.Vertices.Count.Range : Law_VertexLoopVertexIsIsolated(m, s, BrepVertexIndex(v));
    conclude m.ShellEulerPoincare(s) % 2 == 0;
    because "After the reduction the counted cells partition the shell's point set: vertices are points, edges are open arcs, and each face is an open surface from which each remaining bound removes a distinct boundary circle or point. Every edge has two uses with opposite composed directions, so the faces' orientations agree across every edge; every vertex has a link of one cycle, and a vertex loop's vertex touches no edge, so every point has a disk neighbourhood. The shell is therefore a closed orientable surface, possibly disconnected, whose Euler characteristic is a sum of terms 2 - 2H, each even. The count V - E + 2F - L assumes each face is a sphere with L_f holes (chi_c = 2 - L_f); a face with h handles in k pieces has chi_c = 2k - 2h - L_f, which differs by the even number 2(k - 1) - 2h, so the parity survives faces that break ISO's no-handle rule. The bound chi <= 2 also needs a connected shell (Law_ShellIsConnected; a sphere and a torus in one shell give 2 + 0) and handle-free faces, which no law of this layer can check (a torus face with no bound counts 2 where its surface has 0); that is why Law_EulerPoincareEvenAndBounded is a law and not a corollary.";
    tested by Law_EulerPoincareEvenAndBounded;
}

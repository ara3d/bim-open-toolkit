//==
// # BrepTopology
//
// Layer 2 of the STEP B-rep to mesh design (README.md beside this file). The
// functions over the topology tables: range and intactness predicates, coedge
// sites and traversal, the composed sense of a coedge, the edge domain derived
// from the vertices, the vertex link, the counts behind Euler-Poincare, and the
// measures that the coupling laws compare with the model's tolerances. A body is
// written where the body is the definition; an algorithm is bodiless with a
// "deferred:" note, and its contract is in topology.spec.plato.
//
// Conventions. A function that indexes a table states its precondition; laws
// and callers establish it with the conditional, never with && (both operands
// of && are evaluated). Typed empty arrays are written 0.MapRange(k => X(k)),
// whose lambda never runs. Coincidence of points is the model's
// Tolerances.Length. A parameter comparison uses the tolerance at the point
// (01-geometry's ParameterToleranceAt), never one model-wide floor. Linear searches
// are the definitions; an implementation replaces them with one pass that
// builds incidence tables (README, "Implementation notes").
//
// Sections, in order:
//  - Orientation and coedges
//  - Range predicates
//  - Intactness
//  - Coedge sites
//  - Traversal
//  - Bounds and seams
//  - Sense and orientation
//  - Edge domains
//  - Degenerate edges
//  - Vertex links
//  - Counts and Euler-Poincare
//  - Faceted bounds
//  - Connectivity
//  - Orientability
//  - Bodies
//  - Coupling measures
//  - Parameter-space winding
//  - Size and extent
//  - Model transforms
//  - Units

library BrepTopology
{
    //==
    // # Orientation and coedges

    // Whether the orientation walks an edge from its Start vertex to its End vertex.
    IsForward(o: EdgeOrientation): Boolean
        => match (o) {
            Forward => true;
            Reversed => false;
        };

    // Whether the coedge, as its loop lists it, walks its edge from Start to End.
    IsForward(c: Coedge): Boolean
        => c.Orientation.IsForward;

    // The vertex a coedge leaves, as its loop lists it: the edge's Start when the
    // coedge is Forward, its End when Reversed. A bound whose Orientation is
    // false runs the loop backwards, so the face reaches this vertex last.
    // Precondition: m.IsEdgeInRange(c.Edge).
    StartVertex(m: BrepModel, c: Coedge): BrepVertexIndex
        => c.IsForward ? m.Edges[c.Edge].Start : m.Edges[c.Edge].End;

    // The vertex a coedge reaches, as its loop lists it. Precondition:
    // m.IsEdgeInRange(c.Edge).
    EndVertex(m: BrepModel, c: Coedge): BrepVertexIndex
        => c.IsForward ? m.Edges[c.Edge].End : m.Edges[c.Edge].Start;

    // The coedges of a loop in order: those of an edge loop; none for a vertex
    // loop or a poly loop, whose edges are implicit.
    CoedgesOf(loop: BrepLoop): Array<Coedge>
        => match (loop) {
            EdgeLoop(coedges) => coedges;
            VertexLoop(vertex) => Coedge.NoCoedges;
            PolyLoop(points) => Coedge.NoCoedges;
        };

    // The other orientation.
    Opposite(o: EdgeOrientation): EdgeOrientation
        => match (o) {
            Forward => EdgeOrientation.Reversed;
            Reversed => EdgeOrientation.Forward;
        };

    // The number of coedges of a loop; 0 for a vertex loop or a poly loop.
    CoedgeCount(l: BrepLoop): Integer
        => l.CoedgesOf.Count;

    // Whether the loop cites edge e: some coedge of an edge loop names it.
    CitesEdge(l: BrepLoop, e: BrepEdgeIndex): Boolean
        => l.CoedgesOf.Any(c => c.Edge == e);

    // An empty coedge array, for the branches that have none.
    NoCoedges(_: Coedge): Array<Coedge>
        => 0.MapRange(k => Coedge(BrepEdgeIndex(k), EdgeOrientation.Forward));

    // The vertex of a vertex loop as a one-element array; empty for other loops.
    VertexLoopVertexOf(loop: BrepLoop): Array<BrepVertexIndex>
        => match (loop) {
            EdgeLoop(coedges) => 0.MapRange(k => BrepVertexIndex(k));
            VertexLoop(vertex) => [vertex];
            PolyLoop(points) => 0.MapRange(k => BrepVertexIndex(k));
        };

    // Whether the loop is an edge loop.
    IsEdgeLoop(loop: BrepLoop): Boolean
        => match (loop) {
            EdgeLoop(coedges) => true;
            VertexLoop(vertex) => false;
            PolyLoop(points) => false;
        };

    // Whether the loop is a vertex loop.
    IsVertexLoop(loop: BrepLoop): Boolean
        => match (loop) {
            EdgeLoop(coedges) => false;
            VertexLoop(vertex) => true;
            PolyLoop(points) => false;
        };

    // Whether the loop is a poly loop.
    IsPolyLoop(loop: BrepLoop): Boolean
        => match (loop) {
            EdgeLoop(coedges) => false;
            VertexLoop(vertex) => false;
            PolyLoop(points) => true;
        };

    //==
    // # Range predicates

    // Whether v names a row of the vertex table.
    IsVertexInRange(m: BrepModel, v: BrepVertexIndex): Boolean
        => m.Vertices.IsValidIndex(v);

    // Whether e names a row of the edge table.
    IsEdgeInRange(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.Edges.IsValidIndex(e);

    // Whether l names a row of the loop table.
    IsLoopInRange(m: BrepModel, l: BrepLoopIndex): Boolean
        => m.Loops.IsValidIndex(l);

    // Whether f names a row of the face table.
    IsFaceInRange(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.Faces.IsValidIndex(f);

    // Whether s names a row of the shell table.
    IsShellInRange(m: BrepModel, s: ShellIndex): Boolean
        => m.Shells.IsValidIndex(s);

    // Whether b names a row of the body table.
    IsBodyInRange(m: BrepModel, b: BodyIndex): Boolean
        => m.Bodies.IsValidIndex(b);

    // Whether c names a curve of the model's geometry arena.
    IsCurveInRange(m: BrepModel, c: CurveIndex): Boolean
        => m.Geometry.Curves.IsValidIndex(c);

    // Whether s names a surface of the model's geometry arena.
    IsSurfaceInRange(m: BrepModel, s: SurfaceIndex): Boolean
        => m.Geometry.Surfaces.IsValidIndex(s);

    //==
    // # Intactness
    //
    // A row is intact when every index it holds is in range. IsEveryIndexInRange
    // is the whole model's form and the body of Law_IndicesInRange.

    // Whether an edge's two vertices and its curve are in range.
    IsIntact(m: BrepModel, edge: BrepEdge): Boolean
        => m.IsVertexInRange(edge.Start) && m.IsVertexInRange(edge.End) && m.IsCurveInRange(edge.Curve);

    // Whether every index a loop holds is in range: each coedge's edge, or a
    // vertex loop's vertex. A poly loop holds none.
    IsIntact(m: BrepModel, loop: BrepLoop): Boolean
        => match (loop) {
            EdgeLoop(coedges) => coedges.All(c => m.IsEdgeInRange(c.Edge));
            VertexLoop(vertex) => m.IsVertexInRange(vertex);
            PolyLoop(points) => true;
        };

    // Whether a face's surface is in range and each bound's loop is in range and
    // intact.
    IsIntact(m: BrepModel, face: BrepFace): Boolean
        => m.IsSurfaceInRange(face.Surface) && face.Bounds.All(b => m.IsLoopIntact(b.Loop));

    // Whether every face a shell lists is in range.
    IsIntact(m: BrepModel, shell: BrepShell): Boolean
        => shell.Faces.All(f => m.IsFaceInRange(f));

    // Whether every shell a body names is in range.
    IsIntact(m: BrepModel, body: BrepBody): Boolean
        => match (body) {
            ManifoldSolid(outer) => m.IsShellInRange(outer);
            SolidWithVoids(outer, voids) => m.IsShellInRange(outer) && voids.All(v => m.IsShellInRange(v));
            ShellSet(shells) => shells.All(s => m.IsShellInRange(s));
        };

    // Whether e is in range and its row is intact.
    IsEdgeIntact(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.IsEdgeInRange(e) ? m.IsIntact(m.Edges[e]) : false;

    // Whether l is in range and its row is intact.
    IsLoopIntact(m: BrepModel, l: BrepLoopIndex): Boolean
        => m.IsLoopInRange(l) ? m.IsIntact(m.Loops[l]) : false;

    // Whether f is in range and its row is intact, loops included.
    IsFaceIntact(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.IsFaceInRange(f) ? m.IsIntact(m.Faces[f]) : false;

    // Whether b is in range and its row is intact.
    IsBodyIntact(m: BrepModel, b: BodyIndex): Boolean
        => m.IsBodyInRange(b) ? m.IsIntact(m.Bodies[b]) : false;

    // Whether every index stored anywhere in the model is in range: the
    // geometry arena's own, and every topology row's.
    IsEveryIndexInRange(m: BrepModel): Boolean
        => m.Geometry.IsEveryIndexInRange
            && m.Edges.All(e => m.IsIntact(e))
            && m.Loops.All(l => m.IsIntact(l))
            && m.Faces.All(f => m.IsIntact(f))
            && m.Shells.All(s => m.IsIntact(s))
            && m.Bodies.All(b => m.IsIntact(b));

    //==
    // # Coedge sites

    // The coedges of the loop l names; none when l is out of range or is not an
    // edge loop.
    LoopCoedges(m: BrepModel, l: BrepLoopIndex): Array<Coedge>
        => m.IsLoopInRange(l) ? m.Loops[l].CoedgesOf : Coedge.NoCoedges;

    // Whether the site names a coedge: its face in range, its bound a position
    // in that face's bounds, its slot a position in that bound's coedges.
    IsCoedgeSiteInRange(m: BrepModel, site: CoedgeSite): Boolean
        => m.IsFaceInRange(site.Face)
            ? (m.Faces[site.Face].Bounds.IsValidIndex(site.Bound)
                ? m.LoopCoedges(m.Faces[site.Face].Bounds[site.Bound].Loop).IsValidIndex(site.Slot)
                : false)
            : false;

    // The face bound a site lies in. Precondition: m.IsCoedgeSiteInRange(site).
    BoundAt(m: BrepModel, site: CoedgeSite): FaceBound
        => m.Faces[site.Face].Bounds[site.Bound];

    // The coedge a site names. Precondition: m.IsCoedgeSiteInRange(site).
    CoedgeAt(m: BrepModel, site: CoedgeSite): Coedge
        => m.LoopCoedges(m.BoundAt(site).Loop)[site.Slot];

    // The site of the coedge after this one in its loop, as the loop lists it,
    // the last wrapping to the first. Precondition: m.IsCoedgeSiteInRange(site).
    NextSite(m: BrepModel, site: CoedgeSite): CoedgeSite
        => CoedgeSite(site.Face, site.Bound, (site.Slot + 1) % m.LoopCoedges(m.BoundAt(site).Loop).Count);

    //==
    // # Traversal
    //
    // Every traversal skips what is out of range, so it is total; Law_IndicesInRange
    // reports what was skipped.

    // The faces of a shell that are in range, in the shell's order.
    ShellFaces(m: BrepModel, s: ShellIndex): Array<BrepFaceIndex>
        => m.IsShellInRange(s)
            ? m.Shells[s].Faces.FlatMap(f => m.IsFaceInRange(f) ? [f] : 0.MapRange(k => BrepFaceIndex(k)))
            : 0.MapRange(k => BrepFaceIndex(k));

    // The loops of a face, one per bound, in the face's bound order.
    LoopsOfFace(m: BrepModel, f: BrepFaceIndex): Array<BrepLoopIndex>
        => m.IsFaceInRange(f)
            ? m.Faces[f].Bounds.Map(b => b.Loop)
            : 0.MapRange(k => BrepLoopIndex(k));

    // Every coedge site of a face, bound by bound, in loop order. Vertex and
    // poly loops contribute none.
    CoedgeSitesOfFace(m: BrepModel, f: BrepFaceIndex): Array<CoedgeSite>
        => m.IsFaceInRange(f)
            ? m.Faces[f].Bounds.Count.Range.FlatMap(b =>
                m.LoopCoedges(m.Faces[f].Bounds[b].Loop).Count.Range.Map(k => CoedgeSite(f, b, k)))
            : 0.MapRange(k => CoedgeSite(f, k, k));

    // Every coedge site of a shell, face by face.
    CoedgeSitesOfShell(m: BrepModel, s: ShellIndex): Array<CoedgeSite>
        => m.ShellFaces(s).FlatMap(f => m.CoedgeSitesOfFace(f));

    // The sites among the given ones whose coedge cites edge e. Precondition:
    // every site is in range.
    SitesCiting(m: BrepModel, sites: Array<CoedgeSite>, e: BrepEdgeIndex): Array<CoedgeSite>
        => sites.FlatMap(x => m.CoedgeAt(x).Edge == e ? [x] : sites.Take(0));

    // The coedge sites in a shell that cite edge e: its uses. Two in a closed
    // shell; both in one face for a seam.
    CoedgeSitesOfEdge(m: BrepModel, s: ShellIndex, e: BrepEdgeIndex): Array<CoedgeSite>
        => m.SitesCiting(m.CoedgeSitesOfShell(s), e);

    // The coedge sites in a face that cite edge e.
    CoedgeSitesOfEdgeInFace(m: BrepModel, f: BrepFaceIndex, e: BrepEdgeIndex): Array<CoedgeSite>
        => m.SitesCiting(m.CoedgeSitesOfFace(f), e);

    // How many coedges of the shell cite edge e; zero when e is not in the shell.
    UseCount(m: BrepModel, s: ShellIndex, e: BrepEdgeIndex): Integer
        => m.CoedgeSitesOfEdge(s, e).Count;

    // The faces of the given sites, each once, in order of first appearance.
    DistinctFaces(sites: Array<CoedgeSite>): Array<BrepFaceIndex>
        => sites.Count.Range.FlatMap(i =>
            i.Range.All(j => sites[j].Face != sites[i].Face)
                ? [sites[i].Face]
                : 0.MapRange(k => BrepFaceIndex(k)));

    // Whether the loop at index l cites edge e; false when l is out of range.
    LoopUsesEdge(m: BrepModel, l: BrepLoopIndex, e: BrepEdgeIndex): Boolean
        => m.IsLoopInRange(l) ? m.Loops[l].CitesEdge(e) : false;

    // Whether a bound of face f cites edge e; false when f is out of range.
    FaceUsesEdge(m: BrepModel, f: BrepFaceIndex, e: BrepEdgeIndex): Boolean
        => m.IsFaceInRange(f) ? m.Faces[f].Bounds.Any(b => m.LoopUsesEdge(b.Loop, e)) : false;

    // The faces of the model whose bounds cite edge e, each once, in face
    // order, whatever shell they belong to: layer 4's question, which faces'
    // parameter planes the edge's discretization must serve. Quadratic as
    // written; an implementation builds an edge-to-face table once.
    FacesOfEdge(m: BrepModel, e: BrepEdgeIndex): Array<BrepFaceIndex>
        => m.Faces.Count.MapRange(i => BrepFaceIndex(i)).FlatMap(f =>
            m.FaceUsesEdge(f, e) ? [f] : 0.MapRange(k => BrepFaceIndex(k)));

    // The faces of a shell that use edge e, each once: two for an edge between
    // faces, one for a seam or a boundary edge.
    FacesOfEdge(m: BrepModel, s: ShellIndex, e: BrepEdgeIndex): Array<BrepFaceIndex>
        => m.CoedgeSitesOfEdge(s, e).DistinctFaces;

    // The distinct edges the shell's coedges cite, in increasing index order.
    // Poly loops' implicit edges are not indexed and not listed.
    EdgesOfShell(m: BrepModel, s: ShellIndex): Array<BrepEdgeIndex>
        => m.Edges.Count.MapRange(i => BrepEdgeIndex(i)).FlatMap(e =>
            m.UseCount(s, e) > 0 ? [e] : 0.MapRange(k => BrepEdgeIndex(k)));

    // Whether a coedge's edge has v as either end. False when the edge is out of
    // range.
    CoedgeTouchesVertex(m: BrepModel, c: Coedge, v: BrepVertexIndex): Boolean
        => m.IsEdgeInRange(c.Edge)
            ? (m.Edges[c.Edge].Start == v || m.Edges[c.Edge].End == v)
            : false;

    // The vertices of the vertex loops that bound face f.
    VertexLoopVertices(m: BrepModel, f: BrepFaceIndex): Array<BrepVertexIndex>
        => m.LoopsOfFace(f).FlatMap(l =>
            m.IsLoopInRange(l) ? m.Loops[l].VertexLoopVertexOf : 0.MapRange(k => BrepVertexIndex(k)));

    // Whether some face of the shell has a vertex loop at v.
    IsVertexLoopVertexIn(m: BrepModel, s: ShellIndex, v: BrepVertexIndex): Boolean
        => m.ShellFaces(s).Any(f => m.VertexLoopVertices(f).Any(w => w == v));

    // Whether the shell's bounds reference vertex v: as an end of a cited edge,
    // or as a vertex loop's vertex.
    ShellTouchesVertex(m: BrepModel, s: ShellIndex, v: BrepVertexIndex): Boolean
        => m.CoedgeSitesOfShell(s).Any(x => m.CoedgeTouchesVertex(m.CoedgeAt(x), v))
            || m.IsVertexLoopVertexIn(s, v);

    // The distinct vertices the shell's bounds reference, in increasing index
    // order. Poly loop points are not indexed and not listed.
    VerticesOfShell(m: BrepModel, s: ShellIndex): Array<BrepVertexIndex>
        => m.Vertices.Count.MapRange(i => BrepVertexIndex(i)).FlatMap(v =>
            m.ShellTouchesVertex(s, v) ? [v] : 0.MapRange(k => BrepVertexIndex(k)));

    // Whether some bound of a face of the shell is a poly loop.
    ShellHasPolyLoop(m: BrepModel, s: ShellIndex): Boolean
        => m.ShellFaces(s).Any(f => m.LoopsOfFace(f).Any(l =>
            m.IsLoopInRange(l) ? m.Loops[l].IsPolyLoop : false));

    //==
    // # Bounds and seams

    // Whether a loop is a non-empty closed chain: each coedge of an edge loop
    // ends at the vertex the next one starts from, the last wrapping to the
    // first. Vertex and poly loops close by definition. Precondition:
    // m.IsIntact(loop).
    ChainsEndToStart(m: BrepModel, loop: BrepLoop): Boolean
        => match (loop) {
            EdgeLoop(coedges) => coedges.Count > 0
                ? coedges.Count.Range.All(i =>
                    m.EndVertex(coedges[i]) == m.StartVertex(coedges[(i + 1) % coedges.Count]))
                : false;
            VertexLoop(vertex) => true;
            PolyLoop(points) => true;
        };

    // How many of a face's bounds the file marked outer.
    OuterBoundCount(face: BrepFace): Integer
        => face.Bounds.Reduce(0, (n, b) => b.IsOuter ? n + 1 : n);

    // The vertices a bound references: both ends of every coedge, or a vertex
    // loop's vertex; none for a poly loop. Precondition: m.IsLoopIntact(b.Loop).
    BoundVertices(m: BrepModel, b: FaceBound): Array<BrepVertexIndex>
        => m.LoopCoedges(b.Loop).FlatMap(c => [m.StartVertex(c), m.EndVertex(c)])
            .Concatenate(m.Loops[b.Loop].VertexLoopVertexOf);

    // Whether two bounds reference no common vertex. Precondition: both loops
    // intact.
    BoundsShareNoVertex(m: BrepModel, a: FaceBound, b: FaceBound): Boolean
        => m.BoundVertices(a).All(v => m.BoundVertices(b).All(w => v != w));

    // Whether every two distinct bounds of face f share no vertex, leaving out
    // the redundant vertex loops, which the reduction drops and
    // Law_NoRedundantVertexLoop reports. Precondition: m.IsFaceIntact(f).
    HasDisjointBounds(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.Faces[f].Bounds.Count.Range.All(i =>
            m.Faces[f].Bounds.Count.Range.All(j =>
                i < j
                    ? (m.IsRedundantVertexLoop(f, i) || m.IsRedundantVertexLoop(f, j)
                        ? true
                        : m.BoundsShareNoVertex(m.Faces[f].Bounds[i], m.Faces[f].Bounds[j]))
                    : true));

    // Whether bound b of face f is a redundant vertex loop, the one kind of
    // bound the reduction drops (README, "Euler-Poincare and the counting
    // rule", step 2): a vertex loop whose vertex lies on a bound of f that is
    // not a vertex loop, or on an earlier vertex loop of f. It removes nothing
    // from the face. Raw vertex indices; ReducedCounts applies the same rule
    // to the classes left after contracting degenerate edges. Precondition:
    // m.IsFaceIntact(f) and b a position in its bounds.
    IsRedundantVertexLoop(m: BrepModel, f: BrepFaceIndex, b: Integer): Boolean
        => m.Loops[m.Faces[f].Bounds[b].Loop].VertexLoopVertexOf.Any(v =>
            m.Faces[f].Bounds.Count.Range.Any(j =>
                j == b
                    ? false
                    : (m.Loops[m.Faces[f].Bounds[j].Loop].IsVertexLoop
                        ? (j < b ? m.BoundVertices(m.Faces[f].Bounds[j]).Any(w => w == v) : false)
                        : m.BoundVertices(m.Faces[f].Bounds[j]).Any(w => w == v))));

    // The positions of face f's bounds that the reduction keeps: every bound
    // but the redundant vertex loops. Face meshing builds its region from
    // these (review C6: a sphere whose seam's pole vertices also carry vertex
    // loops). Precondition: m.IsFaceIntact(f).
    KeptBounds(m: BrepModel, f: BrepFaceIndex): Array<Integer>
        => m.Faces[f].Bounds.Count.Range.FlatMap(b =>
            m.IsRedundantVertexLoop(f, b) ? 0.MapRange(k => k) : [b]);

    // Whether edge e is a seam of face f: cited twice by the face's coedges.
    IsSeamEdgeOf(m: BrepModel, f: BrepFaceIndex, e: BrepEdgeIndex): Boolean
        => m.CoedgeSitesOfEdgeInFace(f, e).Count == 2;

    // Whether face f has a seam edge.
    HasSeam(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.CoedgeSitesOfFace(f).Any(x => m.IsSeamEdgeOf(f, m.CoedgeAt(x).Edge));

    // Whether every bound of face f is an edge loop. Precondition:
    // m.IsFaceIntact(f).
    HasOnlyEdgeLoops(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.Faces[f].Bounds.All(b => m.Loops[b.Loop].IsEdgeLoop);

    //==
    // # Sense and orientation
    //
    // With sigma(x) = +1 for true and -1 for false, a coedge runs along its curve
    // with sign sigma(SameSense) * sigma(Orientation) * sigma(bound.Orientation)
    // (research/STEP-BREP-MODEL.md 4.2). The Boolean form below is the same
    // product: XNOR is multiplication of signs.

    // Whether the face that owns the bound traverses the coedge in the direction
    // of increasing curve parameter: the product of the edge's SameSense, the
    // coedge's Orientation, and the bound's Orientation, as signs. The same holds
    // for the coedge's pcurve, which shares the curve's sense. Precondition:
    // m.IsEdgeInRange(coedge.Edge).
    CoedgeRunsForwardOnCurve(m: BrepModel, bound: FaceBound, coedge: Coedge): Boolean
        => (m.Edges[coedge.Edge].SameSense == coedge.IsForward) == bound.Orientation;

    // The composed sense of the coedge at a site. Precondition: the site is in
    // range and its coedge's edge is in range.
    CoedgeRunsForwardOnCurve(m: BrepModel, site: CoedgeSite): Boolean
        => m.CoedgeRunsForwardOnCurve(m.BoundAt(site), m.CoedgeAt(site));

    // Whether the two given uses of an edge run in opposite directions along its
    // curve; true unless there are exactly two. Precondition: each site is in
    // range and its coedge's edge is in range.
    UsesRunOpposite(m: BrepModel, sites: Array<CoedgeSite>): Boolean
        => sites.Count == 2
            ? m.CoedgeRunsForwardOnCurve(sites[0]) != m.CoedgeRunsForwardOnCurve(sites[1])
            : true;

    // The sign relating face f's topological normal to its surface's parameter
    // orientation: +1 when the normal points along PartialU x PartialV, -1 when
    // against it. It is sigma(SameSense) * epsilon, with epsilon = -1 only on
    // the Lemon part of a degenerate torus (layer 1's
    // NormalAgreesWithParameterization). Layer 1 states N = epsilon <PartialU x
    // PartialV> on placements of either handedness and on a Full torus with
    // major below minor (its decisions 6 and 17), so epsilon is one sign per
    // surface. A mirrored placement is not multiplied in here: layer 3 folds
    // the transform's determinant (layer 1's PlacementHandedness) into
    // SameSense, and multiplying again would count the mirror twice. With +1
    // the face lies to the left of every coedge traversed in its composed
    // direction in the (u, v) plane, and a region that closes in (u, v) has
    // positive signed area. Precondition: m.IsFaceIntact(f).
    FaceNormalSign(m: BrepModel, f: BrepFaceIndex): Integer
        => (m.Faces[f].SameSense == m.Geometry.NormalAgreesWithParameterization(m.Faces[f].Surface)) ? 1 : -1;

    // The sign of N . (PartialU x PartialV) on face f's surface at the
    // projection of the curve point at fraction t of the coedge at site: +1,
    // -1, or 0 where the area element there is below the arithmetic resolution
    // of the partials, so that the sign is not rounding noise. A partial
    // shorter than the resolution at the surface's evaluation magnitude is
    // rounding noise too: at a sphere's pole cos(-pi/2) rounds to -4.4e-8 in
    // 32 bits, a PartialU of that length points the wrong way, and the cross
    // product is not small relative to the product of the partials (found by
    // chunk A's run over Witness_Sphere). Precondition:
    // m.IsEveryIndexInRange and m.IsCoedgeSiteInRange(site).
    ParameterizationSignAt(m: BrepModel, site: CoedgeSite, t: Number): Integer
    {
        var s = m.Faces[site.Face].Surface;
        var uv = m.Geometry.Project(s, m.CurvePointAt(m.CoedgeAt(site).Edge, t));
        var du = m.Geometry.PartialU(s, uv);
        var dv = m.Geometry.PartialV(s, uv);
        var cross = du.Cross(dv);
        var product = m.Geometry.NormalOr(s, uv, Direction3D(Vector3D.UnitZ)).Vector.Dot(cross);
        var scale = ResolutionAt(m.Geometry.EvaluationMagnitude(s, uv));
        var noise = du.Length <= scale || dv.Length <= scale || cross.Length <= ResolutionAt(du.Length * dv.Length);
        return noise ? 0 : (product > 0.0 ? 1 : -1);
    }

    //==
    // # Edge domains
    //
    // The file stores no parameter range for an edge. EdgeDomain derives it: the
    // vertex met first along the curve's direction (Start when SameSense, else
    // End) gives the range's start, the other vertex its end, each by inverse
    // evaluation on the curve. The range always runs forward in the curve's
    // parameter and is always bounded. Closure is decided once, by the curve's
    // periodicity (layer 3 decides Closed at decode): a closed edge spans one
    // period on a curve that wraps (Periodic or Closed) and is degenerate,
    // [a, a], on one that does not. See the README, "The edge domain".

    // Whether the edge starts and ends at the same vertex index: a closed edge.
    // Precondition: m.IsEdgeInRange(e).
    IsClosedEdge(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.Edges[e].Start == m.Edges[e].End;

    // Whether the edge's curve is a loop: its domain has a seam, Periodic (the
    // formula wraps) or Closed (the range's ends are one point). Precondition:
    // m.IsEdgeIntact(e).
    IsOnClosedCurve(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.Geometry.Domain(m.Edges[e].Curve).HasSeam;

    // The edge's Start vertex when atStart, else its End vertex. Precondition:
    // m.IsEdgeInRange(e).
    EdgeVertex(m: BrepModel, e: BrepEdgeIndex, atStart: Boolean): BrepVertexIndex
        => atStart ? m.Edges[e].Start : m.Edges[e].End;

    // The vertex met first when walking the curve in its increasing parameter
    // over the edge. Precondition: m.IsEdgeInRange(e).
    FirstVertexAlongCurve(m: BrepModel, e: BrepEdgeIndex): BrepVertexIndex
        => m.Edges[e].SameSense ? m.Edges[e].Start : m.Edges[e].End;

    // The vertex met last when walking the curve in its increasing parameter
    // over the edge. Precondition: m.IsEdgeInRange(e).
    LastVertexAlongCurve(m: BrepModel, e: BrepEdgeIndex): BrepVertexIndex
        => m.Edges[e].SameSense ? m.Edges[e].End : m.Edges[e].Start;

    // The parameter of vertex v on edge e's curve, by inverse evaluation.
    // Precondition: m.IsEdgeIntact(e) and m.IsVertexInRange(v).
    VertexParameter(m: BrepModel, e: BrepEdgeIndex, v: BrepVertexIndex): Number
        => m.Geometry.ClosestParameter(m.Edges[e].Curve, m.Vertices[v].Point);

    // The range an edge occupies on a curve with domain d, given the parameters
    // of the first and last vertex along the curve. Aperiodic: [first, last],
    // and [first, first] for a closed edge, which on a curve that does not
    // loop can only be degenerate; never the curve's own domain, which is
    // unbounded on a line (review F4a). Periodic or Closed: [first, first + w]
    // with w in (0, period], the full period for a closed edge, so an arc that
    // crosses a closed B-spline's join gets that arc, not its complement
    // (review F4c). Periodicity: Periodic is a property of the formula and is
    // copied; Closed says the range's two ends are one point, so it is kept for
    // a closed edge, whose range is one period, and an open arc is Aperiodic.
    // A parameter of a range that crosses a Closed curve's join is wrapped
    // into the curve's domain before evaluation (EdgeCurvePoint).
    TraversalDomain(d: CurveDomain, first: Number, last: Number, isClosed: Boolean): CurveDomain
        => match (d.Periodicity) {
            Aperiodic => CurveDomain(NumberInterval(first, isClosed ? first : last), d.Periodicity);
            Periodic(period) => CurveDomain(
                NumberInterval(first, isClosed ? first + period : last.PeriodicRepresentativeAbove(first, period)),
                d.Periodicity);
            Closed(period) => isClosed
                ? CurveDomain(NumberInterval(first, first + period), d.Periodicity)
                : CurveDomain(NumberInterval(first, last.PeriodicRepresentativeAbove(first, period)), Periodicity.Aperiodic);
        };

    // The point of edge e's curve at parameter t of its edge domain: t wrapped
    // into the curve's domain first (layer 0's Wrap; t itself on an aperiodic
    // curve), because a Closed curve's formula is evaluated only inside its
    // range. Precondition: m.IsEveryIndexInRange, m.IsEdgeInRange(e), t finite.
    EdgeCurvePoint(m: BrepModel, e: BrepEdgeIndex, t: Number): Point3D
        => m.Geometry.Eval(m.Edges[e].Curve, m.Geometry.Domain(m.Edges[e].Curve).Wrap(t));

    // The parameter range edge e occupies on its curve, in increasing parameter,
    // with the curve's periodicity. Precondition: m.IsEdgeIntact(e).
    EdgeDomain(m: BrepModel, e: BrepEdgeIndex): CurveDomain
        => m.Geometry.Domain(m.Edges[e].Curve).TraversalDomain(
            m.VertexParameter(e, m.FirstVertexAlongCurve(e)),
            m.VertexParameter(e, m.LastVertexAlongCurve(e)),
            m.IsClosedEdge(e));

    // The end of the edge domain that the edge's Start (atStart) or End vertex is
    // assigned to: Range.Start for the vertex met first along the curve,
    // Range.End for the other. Precondition: m.IsEdgeIntact(e).
    DomainEndParameter(m: BrepModel, e: BrepEdgeIndex, atStart: Boolean): Number
        => (atStart == m.Edges[e].SameSense) ? m.EdgeDomain(e).Range.Start : m.EdgeDomain(e).Range.End;

    // The pcurves of edge e's curve that lie on face f's surface: one for an
    // ordinary edge, two for a seam whose curve carries both, none when the file
    // wrote no pcurves. Which seam pcurve belongs to which use is face meshing's
    // decision. Precondition: m.IsEveryIndexInRange, e and f in range.
    PcurvesOnFace(m: BrepModel, e: BrepEdgeIndex, f: BrepFaceIndex): Array<PcurveIndex>
    {
        var all = m.Geometry.PcurvesOf(m.Edges[e].Curve);
        return all.FlatMap(p => m.Geometry.Pcurves[p].Surface == m.Faces[f].Surface ? [p] : all.Take(0));
    }

    // The parameter range edge e occupies on pcurve p: layer 1's
    // PcurveRangeOver, the range of p covering the curve's points over the
    // edge domain, derived from that range and the surface's periods, never
    // from the pcurve's own domain, which is unbounded for the commonest pcurve
    // (the bottom circle of a cylinder has a 2D line; review F4b). A closed
    // edge on a curve that loops spans one parameter period of the pcurve
    // (PcurveParameterPeriod) from its start: closedness is index identity
    // here as in EdgeDomain, not the coincidence test PcurveRangeOver falls
    // back on. Bounded always. Periodic is copied from the 2D curve's domain,
    // which wraps in its formula; anything else is Aperiodic. Precondition:
    // m.IsEveryIndexInRange, e in range, p a pcurve of e's curve.
    PcurveEdgeDomain(m: BrepModel, e: BrepEdgeIndex, p: PcurveIndex): CurveDomain
    {
        var r = m.Geometry.PcurveRangeOver(p, m.Edges[e].Curve, m.EdgeDomain(e).Range);
        var period = m.Geometry.PcurveParameterPeriod(p);
        var spansPeriod = m.IsClosedEdge(e) ? (m.IsOnClosedCurve(e) ? period > 0.0 : false) : false;
        return CurveDomain(
            spansPeriod ? NumberInterval(r.Start, r.Start + period) : r,
            m.Geometry.Domain(p).Periodicity.IsPeriodic ? m.Geometry.Domain(p).Periodicity : Periodicity.Aperiodic);
    }

    // The k-th pcurve of edge e's curve. Precondition: m.IsEveryIndexInRange,
    // e in range, k a position in PcurvesOf(e's curve).
    PcurveOfEdge(m: BrepModel, e: BrepEdgeIndex, k: Integer): PcurveIndex
        => m.Geometry.PcurvesOf(m.Edges[e].Curve)[k];

    // Whether k names a pcurve of edge e's curve. Precondition:
    // m.IsEveryIndexInRange and e in range.
    HasPcurve(m: BrepModel, e: BrepEdgeIndex, k: Integer): Boolean
        => m.Geometry.PcurvesOf(m.Edges[e].Curve).IsValidIndex(k);

    // Whether the k-th pcurve of edge e is parameterized like the curve over
    // the edge: at every parameter t of the edge domain, the pcurve's point at
    // the same t lies within the length tolerance of the curve's
    // (PcurveParameterDeviationAt). Not a law: STEP promises only that the two
    // agree as point sets (layer 1 decision 8). It is the route choice of
    // review C5: where it holds, an edge's parameter-space images may evaluate
    // the pcurve at the curve's own parameters; where it does not, they invert.
    // Precondition: m.IsEveryIndexInRange, e in range, m.HasPcurve(e, k).
    // Sampled at the edge domain's ends, at every copy of a breakpoint of the
    // curve inside it, and at the middle of each span between them; a span
    // whose middle deviates by more than half the length tolerance is
    // bisected, until its parameter length is within the curve's parameter
    // tolerance there or at depth 40 (2^-40 of the span, as layer 4's
    // SplitSpan).
    SharesCurveParameter(m: BrepModel, e: BrepEdgeIndex, k: Integer): Boolean
    {
        var stops = m.EdgeBreakFractions(e);
        var tolerance = m.Tolerances.Length.Value;
        return stops.All(t => m.PcurveParameterDeviationAt(e, k, t) <= tolerance)
            && (stops.Count - 1).Range.All(i => m.SpanSharesCurveParameter(e, k, stops[i], stops[i + 1], 0));
    }

    // The fractions of edge e's domain at its two ends and at every copy of a
    // breakpoint of its curve strictly inside it, increasing. Precondition:
    // the edge is evaluable.
    EdgeBreakFractions(m: BrepModel, e: BrepEdgeIndex): Array<Number>
    {
        var curveDomain = m.Geometry.Domain(m.Edges[e].Curve);
        var range = m.EdgeDomain(e).Range;
        var inside = m.Geometry.Breakpoints(m.Edges[e].Curve)
            .FlatMap(b => curveDomain.CopiesInside(b, range))
            .Map(u => (u - range.Start) / (range.End - range.Start))
            .FlatMap(t => (t > 0.0 && t < 1.0) ? [t] : [0.0].Take(0));
        return [0.0].Concatenate(inside.Sort((a, b) => a <= b)).Concatenate([1.0]);
    }

    // Whether the pcurve shares the curve's parameter over the fractions
    // [a, b] of edge e's domain: the middle within the length tolerance, and
    // either within half of it, or the span no longer than the curve's
    // parameter tolerance, or depth 40 reached, or both halves sharing it.
    SpanSharesCurveParameter(m: BrepModel, e: BrepEdgeIndex, k: Integer, a: Number, b: Number, depth: Integer): Boolean
    {
        var middle = (a + b) * 0.5;
        var deviation = m.PcurveParameterDeviationAt(e, k, middle);
        var tolerance = m.Tolerances.Length.Value;
        var curve = m.Edges[e].Curve;
        var step = (b - a) * (m.EdgeDomain(e).Range.End - m.EdgeDomain(e).Range.Start).Abs;
        var floor = m.Geometry.ParameterToleranceAt(curve, m.Geometry.Domain(curve).Wrap(m.EdgeParameterAt(e, middle)), m.Tolerances).Value;
        return deviation > tolerance
            ? false
            : ((deviation <= 0.5 * tolerance || depth >= 40 || step <= floor)
                ? true
                : (m.SpanSharesCurveParameter(e, k, a, middle, depth + 1) && m.SpanSharesCurveParameter(e, k, middle, b, depth + 1)));
    }

    //==
    // # Degenerate edges

    // Whether two points coincide in the model's own sense: within its length
    // tolerance.
    IsCoincident(m: BrepModel, a: Point3D, b: Point3D): Boolean
        => a.Distance(b) <= m.Tolerances.Length.Value;

    // Whether edge e is degenerate: every point of its curve over EdgeDomain lies
    // within the length tolerance of its Start vertex. STEP forbids such edges;
    // the counts contract them.
    // Chunk A body, from the contract IsDegenerateEdge in topology.spec.plato
    // and Law_DegenerateEdgeStaysAtStart: the largest distance from the Start
    // vertex to the curve over EdgeDomain is within the length tolerance. The
    // fast path of README "Implementation notes": ends more than twice the
    // tolerance apart cannot both lie within it of one point.
    IsDegenerateEdge(m: BrepModel, e: BrepEdgeIndex): Boolean
    {
        var start = m.Vertices[m.Edges[e].Start].Point;
        var apart = start.Distance(m.Vertices[m.Edges[e].End].Point) > 2.0 * m.Tolerances.Length.Value;
        return apart ? false : m.FarthestEdgePointFrom(e, start) <= m.Tolerances.Length.Value;
    }

    // The largest distance from p to edge e's curve over its edge domain.
    // Precondition: m.IsEveryIndexInRange and m.IsEdgeInRange(e).
    FarthestEdgePointFrom(m: BrepModel, e: BrepEdgeIndex, p: Point3D): Number
        => m.Geometry.CurveAt(m.Edges[e].Curve).FarthestPointFrom(m.Geometry, m.EdgeDomain(e).Range, p);

    // The largest distance from p to the curve record over the parameter range
    // r. A line's distance to a point is convex in t, so its largest value is
    // at an end. A circle's squared distance to p is |q|^2 + R^2 - 2 R rho
    // cos(t - phi), q = p - centre and (rho, phi) the polar form of q in the
    // circle's plane, largest at t = phi + pi when the range holds a copy of
    // it, else at an end. Every other case is sampled at 65 points of r, ends
    // included: a lower bound, exact for the cases chunk A meets (lines and
    // circles); ellipses and splines get the subdivision of the contract with
    // their chunks (C, F).
    FarthestPointFrom(curve: BrepCurve, g: GeometrySet, r: NumberInterval, p: Point3D): Number
        => match (curve)
        {
            Line(origin, velocity) => (origin + velocity * r.Start).Distance(p).Max((origin + velocity * r.End).Distance(p));
            Circle(placement, radius) => placement.FarthestArcPointFrom(radius, r, p);
            Ellipse(placement, semiAxis1, semiAxis2) => curve.SampledFarthestPointFrom(g, r, p);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => curve.SampledFarthestPointFrom(g, r, p);
            Parabola(placement, focalDistance) => curve.SampledFarthestPointFrom(g, r, p);
            Polyline(points) => curve.SampledFarthestPointFrom(g, r, p);
            BSpline(data) => curve.SampledFarthestPointFrom(g, r, p);
            Trimmed(basis, range, sameSense) => curve.SampledFarthestPointFrom(g, r, p);
            Composite(segments) => curve.SampledFarthestPointFrom(g, r, p);
            Offset(basis, distance, reference) => curve.SampledFarthestPointFrom(g, r, p);
            OnSurface(spaceCurve, supports, master) => curve.SampledFarthestPointFrom(g, r, p);
        };

    // The largest distance from p to the arc of the circle of the given radius
    // in the placement's XY plane over the angle range r: the two ends, and the
    // antipode of p's polar angle when the range reaches a copy of it.
    FarthestArcPointFrom(placement: Frame3D, radius: Number, r: NumberInterval, p: Point3D): Number
    {
        var q = p - placement.Origin;
        var antipode = q.Dot(placement.YAxis.Vector).Atan2(q.Dot(placement.XAxis.Vector)).Radians + Number.Pi;
        var ends = placement.FramePoint(radius * r.Start.Cos, radius * r.Start.Sin, 0.0).Distance(p)
            .Max(placement.FramePoint(radius * r.End.Cos, radius * r.End.Sin, 0.0).Distance(p));
        var inside = antipode.PeriodicRepresentativeAbove(r.Start, Number.Tau) <= r.End;
        return inside ? ends.Max(placement.FramePoint(radius * antipode.Cos, radius * antipode.Sin, 0.0).Distance(p)) : ends;
    }

    // The largest distance from p to the curve record at 65 equally spaced
    // parameters of r, each wrapped into the curve's domain first.
    SampledFarthestPointFrom(curve: BrepCurve, g: GeometrySet, r: NumberInterval, p: Point3D): Number
        => r.Samples(65).Reduce(0.0, (worst, t) => worst.Max(curve.Eval(g, curve.Domain(g).Wrap(t)).Distance(p)));

    // How many distinct edges of the shell are degenerate. Precondition:
    // m.IsEveryIndexInRange.
    DegenerateEdgeCount(m: BrepModel, s: ShellIndex): Integer
        => m.EdgesOfShell(s).Reduce(0, (n, e) => m.IsDegenerateEdge(e) ? n + 1 : n);

    //==
    // # Vertex links
    //
    // A corner at v is a pair of consecutive coedges of an edge loop where the
    // first ends at v; it is named by the site of that first coedge. Its two
    // nodes are the edge end the first coedge arrives through and the edge end
    // the next coedge leaves through. The link of v is the graph on those edge
    // ends whose links are the corners. A manifold vertex has one link component.

    // Whether the coedge at a site ends at vertex v. False when its edge is out
    // of range. Precondition: m.IsCoedgeSiteInRange(site).
    ArrivesAt(m: BrepModel, site: CoedgeSite, v: BrepVertexIndex): Boolean
        => m.IsEdgeInRange(m.CoedgeAt(site).Edge) ? m.EndVertex(m.CoedgeAt(site)) == v : false;

    // The corners at vertex v in shell s, each named by its arriving coedge's
    // site, in shell order.
    CornersAtVertex(m: BrepModel, s: ShellIndex, v: BrepVertexIndex): Array<CoedgeSite>
    {
        var sites = m.CoedgeSitesOfShell(s);
        return sites.FlatMap(x => m.ArrivesAt(x, v) ? [x] : sites.Take(0));
    }

    // The edge end a corner's arriving coedge comes in through: the edge's End
    // when the coedge is Forward, its Start when Reversed. Precondition:
    // m.IsCoedgeSiteInRange(corner).
    ArrivingEnd(m: BrepModel, corner: CoedgeSite): EdgeEnd
        => EdgeEnd(m.CoedgeAt(corner).Edge, m.CoedgeAt(corner).IsForward.Not);

    // The edge end the next coedge after a corner goes out through: the edge's
    // Start when that coedge is Forward, its End when Reversed. Precondition:
    // m.IsCoedgeSiteInRange(corner).
    LeavingEnd(m: BrepModel, corner: CoedgeSite): EdgeEnd
        => EdgeEnd(m.CoedgeAt(m.NextSite(corner)).Edge, m.CoedgeAt(m.NextSite(corner)).IsForward);

    // Whether two corners share an edge end, so that they are consecutive around
    // the vertex. Precondition: both in range.
    CornersShareEnd(m: BrepModel, a: CoedgeSite, b: CoedgeSite): Boolean
        => m.ArrivingEnd(a) == m.ArrivingEnd(b)
            || m.ArrivingEnd(a) == m.LeavingEnd(b)
            || m.LeavingEnd(a) == m.ArrivingEnd(b)
            || m.LeavingEnd(a) == m.LeavingEnd(b);

    // The number of connected components of the link of vertex v in shell s;
    // zero when v has no corners in s.
    // Chunk A body, from the contract LinkComponentCount: the classes of the
    // corners at v under the transitive closure of CornersShareEnd, by layer
    // 0's ClassRoots over every pair of corners that share an edge end.
    // Edge ends are keyed by (edge, IsStart), never by vertex (README,
    // "Implementation notes"), which CornersShareEnd does.
    LinkComponentCount(m: BrepModel, s: ShellIndex, v: BrepVertexIndex): Integer
    {
        var corners = m.CornersAtVertex(s, v);
        var n = corners.Count;
        var joined = n.Range.FlatMap(i => n.Range.FlatMap(j =>
            (i < j ? m.CornersShareEnd(corners[i], corners[j]) : false) ? [i * n + j] : n.Range.Take(0)));
        return ClassRoots(n, joined.Map(k => k / n), joined.Map(k => k % n)).ClassCount;
    }

    // The corners at v in cyclic order around the vertex when the link is one
    // cycle, or in path order from one free end when it is one path (an open
    // shell's boundary vertex).
    // Chunk A body, from the contract CornersAroundVertex: start at a corner
    // with a free end if one exists (a boundary vertex, whose link is a path),
    // else at the first corner; then repeatedly step to the first unvisited
    // corner that shares an edge end with the current one. Under the
    // contract's requirements (one link component, no edge used more than
    // twice) each corner shares ends with at most two others, so the walk
    // visits the path or the cycle in order and every corner once.
    CornersAroundVertex(m: BrepModel, s: ShellIndex, v: BrepVertexIndex): Array<CoedgeSite>
    {
        var corners = m.CornersAtVertex(s, v);
        var n = corners.Count;
        var withFreeEnd = n.Range.FlatMap(i => m.HasFreeEnd(corners, i) ? [i] : n.Range.Take(0));
        var used = new Buffer<Boolean>(n);
        var k = 0;
        while (k < n)
        {
            used = used.Set(k, false);
            k = k + 1;
        }
        var order = new List<CoedgeSite>();
        var current = withFreeEnd.Count > 0 ? withFreeEnd[0] : (n > 0 ? 0 : -1);
        while (current >= 0)
        {
            order = order.Add(corners[current]);
            used = used.Set(current, true);
            var next = -1;
            var j = 0;
            while (j < n)
            {
                if (next < 0)
                {
                    if (used.At(j).Not)
                    {
                        if (m.CornersShareEnd(corners[current], corners[j]))
                        {
                            next = j;
                        }
                    }
                }
                j = j + 1;
            }
            current = next;
        }
        return order.Freeze();
    }

    // Whether corner i of the given corners has an edge end no other of them
    // has: the end of a link path. Precondition: every corner in range.
    HasFreeEnd(m: BrepModel, corners: Array<CoedgeSite>, i: Integer): Boolean
        => m.IsEndShared(corners, i, m.ArrivingEnd(corners[i])).Not
            || m.IsEndShared(corners, i, m.LeavingEnd(corners[i])).Not;

    // Whether a corner other than corner i arrives or leaves through the edge
    // end. Precondition: every corner in range.
    IsEndShared(m: BrepModel, corners: Array<CoedgeSite>, i: Integer, end: EdgeEnd): Boolean
        => corners.Count.Range.Any(j =>
            j == i ? false : (m.ArrivingEnd(corners[j]) == end || m.LeavingEnd(corners[j]) == end));

    // The faces around vertex v in s, one per corner, in the order of
    // CornersAroundVertex. A face appears once per corner it has at v: the side
    // face of a seamed cylinder twice at each of its vertices.
    FacesAroundVertex(m: BrepModel, s: ShellIndex, v: BrepVertexIndex): Array<BrepFaceIndex>
        => m.CornersAroundVertex(s, v).Map(c => c.Face);

    //==
    // # Counts and Euler-Poincare

    // The shell's indexed cells as the file gives them: distinct vertices and
    // edges its bounds reference, faces in range, and bounds of every kind. Poly
    // loop points and their implicit edges are not indexed and not counted here.
    RawCounts(m: BrepModel, s: ShellIndex): ShellCounts
        => (m.VerticesOfShell(s).Count,
            m.EdgesOfShell(s).Count,
            m.ShellFaces(s).Count,
            m.ShellFaces(s).Reduce(0, (n, f) => n + m.Faces[f].Bounds.Count));

    // The counts after the reduction of research/VALIDATION-MATH.md 1.4: every
    // degenerate edge contracted (deleted when closed, its two vertices merged
    // otherwise), an edge loop left without coedges kept as a vertex loop on
    // their shared vertex, each vertex loop dropped whose vertex lies on another
    // bound of the same face or repeats another vertex loop there, and poly loop
    // points and implicit edges identified by coincidence within the length
    // tolerance.
    // Chunk A body, from the contract ReducedCounts and the counting rule of
    // research/VALIDATION-MATH.md 1.4: the model's vertices joined by layer
    // 0's ClassRoots across the two ends of every degenerate edge of the
    // shell; edges without the degenerate ones; faces as they are; bounds
    // without the dropped vertex-like bounds (a vertex loop, or an edge loop
    // all of whose coedges are degenerate, which collapses to the class of
    // its vertices), a vertex-like bound being dropped when its class lies on
    // another bound of the face that is not vertex-like, or on an earlier
    // vertex-like bound; and the poly loops' points identified by coincidence
    // within the length tolerance, with their implicit edges counted once per
    // unordered pair of distinct classes.
    ReducedCounts(m: BrepModel, s: ShellIndex): ShellCounts
    {
        var shellEdges = m.EdgesOfShell(s);
        var degenerate = shellEdges.FlatMap(e => m.IsDegenerateEdge(e) ? [e] : shellEdges.Take(0));
        var roots = ClassRoots(m.Vertices.Count,
            degenerate.Map(e => m.Edges[e].Start.Value), degenerate.Map(e => m.Edges[e].End.Value));
        var vertexClasses = m.VerticesOfShell(s).Map(v => roots[v.Value]);
        var kept = m.ShellFaces(s).Reduce(0, (n, f) => n + m.KeptReducedBoundCount(f, roots));
        var poly = m.ShellPolyBounds(s);
        var pointRoots = m.ShellPolyPointRoots(s);
        return ShellCounts(
            vertexClasses.DistinctCount + pointRoots.ClassCount,
            shellEdges.Count - degenerate.Count + m.ImplicitEdgeKeys(poly, pointRoots).DistinctCount,
            m.ShellFaces(s).Count,
            kept);
    }

    // The number of distinct values of an integer array.
    DistinctCount(xs: Array<Integer>): Integer
    {
        var sorted = xs.Sort((a, b) => a <= b);
        return sorted.Count.Range.Reduce(0, (n, i) => (i == 0 ? true : sorted[i] != sorted[i - 1]) ? n + 1 : n);
    }

    // Whether the bound is vertex-like after the reduction: a vertex loop, or
    // an edge loop every coedge of which cites an edge whose two ends lie in
    // one class (a contracted, degenerate edge). Precondition: the bound's
    // loop intact; roots indexed by vertex.
    IsVertexLikeBound(m: BrepModel, b: FaceBound, roots: Array<Integer>): Boolean
        => m.Loops[b.Loop].IsVertexLoop
            || (m.Loops[b.Loop].IsEdgeLoop
                ? m.LoopCoedges(b.Loop).All(c => roots[m.Edges[c.Edge].Start.Value] == roots[m.Edges[c.Edge].End.Value])
                : false);

    // The vertex classes a bound touches: both ends of every coedge, or a
    // vertex loop's vertex; none for a poly loop.
    BoundClasses(m: BrepModel, b: FaceBound, roots: Array<Integer>): Array<Integer>
        => m.BoundVertices(b).Map(v => roots[v.Value]);

    // Whether bound i of face f is a vertex-like bound the reduction drops:
    // its class lies on another bound that is not vertex-like, or on an
    // earlier vertex-like bound. Precondition: m.IsFaceIntact(f).
    IsDroppedReducedBound(m: BrepModel, f: BrepFaceIndex, i: Integer, roots: Array<Integer>): Boolean
        => m.IsVertexLikeBound(m.Faces[f].Bounds[i], roots)
            ? m.BoundClasses(m.Faces[f].Bounds[i], roots).Any(c =>
                m.Faces[f].Bounds.Count.Range.Any(j =>
                    j == i
                        ? false
                        : ((m.IsVertexLikeBound(m.Faces[f].Bounds[j], roots) ? j < i : true)
                            ? m.BoundClasses(m.Faces[f].Bounds[j], roots).Any(d => d == c)
                            : false)))
            : false;

    // The number of face f's bounds the reduction keeps. Precondition:
    // m.IsFaceIntact(f).
    KeptReducedBoundCount(m: BrepModel, f: BrepFaceIndex, roots: Array<Integer>): Integer
        => m.Faces[f].Bounds.Count.Range.Reduce(0, (n, i) => m.IsDroppedReducedBound(f, i, roots) ? n : n + 1);

    // The poly-loop bounds of shell s's faces, face by face. Precondition:
    // m.IsEveryIndexInRange.
    ShellPolyBounds(m: BrepModel, s: ShellIndex): Array<FaceBound>
        => m.ShellFaces(s).FlatMap(f => m.Faces[f].Bounds.FlatMap(b =>
            m.Loops[b.Loop].IsPolyLoop ? [b] : m.Faces[f].Bounds.Take(0)));

    // The class roots of the points under coincidence within the length
    // tolerance, closed transitively (layer 0's ClassRoots over every
    // coinciding pair; quadratic, where an implementation hashes).
    CoincidenceRoots(m: BrepModel, points: Array<Point3D>): Array<Integer>
    {
        var n = points.Count;
        var joined = n.Range.FlatMap(i => n.Range.FlatMap(j =>
            (i < j ? m.IsCoincident(points[i], points[j]) : false) ? [i * n + j] : n.Range.Take(0)));
        return ClassRoots(n, joined.Map(k => k / n), joined.Map(k => k % n));
    }

    // The class roots of shell s's poly-loop points under coincidence, the
    // points taken bound by bound in ShellPolyBounds order.
    ShellPolyPointRoots(m: BrepModel, s: ShellIndex): Array<Integer>
        => m.CoincidenceRoots(m.ShellPolyBounds(s).FlatMap(b => m.Loops[b.Loop].PolyLoopPointsOf));

    // The position of the first point of poly bound k among the points of
    // all the bounds, taken in order.
    PolyPointOffset(m: BrepModel, poly: Array<FaceBound>, k: Integer): Integer
        => poly.Take(k).Reduce(0, (n, b) => n + m.Loops[b.Loop].PolyLoopPointsOf.Count);

    // The implicit edges of the poly bounds, one key per use: the unordered
    // pair of point classes (a, b), a < b, of two consecutive points, keyed
    // a * N + b with N the point count; a pair whose points share a class is
    // no edge. Precondition: pointRoots indexes the bounds' points in order.
    ImplicitEdgeKeys(m: BrepModel, poly: Array<FaceBound>, pointRoots: Array<Integer>): Array<Integer>
        => m.ImplicitEdgeUses(poly, pointRoots).Map(u => u / 2);

    // The implicit edge uses of the poly bounds: key * 2 + 1 when the face
    // runs the use from the smaller class to the larger, key * 2 otherwise,
    // the bound's Orientation composed with the loop's order.
    ImplicitEdgeUses(m: BrepModel, poly: Array<FaceBound>, pointRoots: Array<Integer>): Array<Integer>
        => poly.Count.Range.FlatMap(k => m.ImplicitEdgeUsesOf(poly[k], m.PolyPointOffset(poly, k), pointRoots));

    // The implicit edge uses of one poly bound whose first point is at
    // position offset.
    ImplicitEdgeUsesOf(m: BrepModel, b: FaceBound, offset: Integer, pointRoots: Array<Integer>): Array<Integer>
    {
        var c = m.Loops[b.Loop].PolyLoopPointsOf.Count;
        var n = pointRoots.Count;
        return c.Range.FlatMap(i => m.ImplicitEdgeUse(pointRoots[offset + i], pointRoots[offset + (i + 1) % c], b.Orientation, n));
    }

    // The use of the implicit edge from class a to class b, as
    // ImplicitEdgeUses encodes it; none when a == b.
    ImplicitEdgeUse(m: BrepModel, a: Integer, b: Integer, orientation: Boolean, n: Integer): Array<Integer>
        => a == b
            ? [0].Take(0)
            : [(a.Min(b) * n + a.Max(b)) * 2 + ((a < b) == orientation ? 1 : 0)];

    // V - E + 2F - L of the counts: the Euler characteristic of the shell when
    // its cells are open disks with holes, open arcs, and points.
    EulerPoincare(c: ShellCounts): Integer
        => c.Vertices - c.Edges + 2 * c.Faces - c.Loops;

    // The genus (2 - chi) / 2 that the counts imply for a closed, connected,
    // orientable shell. Meaningful only when EulerPoincare is even and at most 2.
    ImpliedGenus(c: ShellCounts): Integer
        => (2 - c.EulerPoincare) / 2;

    // The Euler-Poincare value of shell s on reduced counts. Precondition:
    // m.IsEveryIndexInRange.
    ShellEulerPoincare(m: BrepModel, s: ShellIndex): Integer
        => m.ReducedCounts(s).EulerPoincare;

    // The genus shell s's reduced counts imply. Precondition:
    // m.IsEveryIndexInRange.
    ShellGenus(m: BrepModel, s: ShellIndex): Integer
        => m.ReducedCounts(s).ImpliedGenus;

    // How many distinct edges of the shell have exactly one use and are counted
    // (CountsAsEdge): its free edges. A degenerate edge used once, such as a
    // pole edge of a sphere written [seam+, degN, seam-, degS], is contracted
    // by the reduction and is not free.
    FreeEdgeCount(m: BrepModel, s: ShellIndex): Integer
        => m.EdgesOfShell(s).Reduce(0, (n, e) => (m.UseCount(s, e) == 1 ? m.CountsAsEdge(e) : false) ? n + 1 : n);

    // Whether edge e is a cell of the reduced complex, so that the use-count
    // laws apply to it: true unless it is degenerate, which the reduction
    // contracts and Law_EdgeHasPositiveExtent reports. When some index of the
    // model is out of range, degeneracy cannot be evaluated and every edge
    // counts. Precondition: m.IsEdgeInRange(e).
    CountsAsEdge(m: BrepModel, e: BrepEdgeIndex): Boolean
        => m.IsEveryIndexInRange ? m.IsDegenerateEdge(e).Not : true;

    // The number of boundary cycles of shell s: the closed walks into which
    // its free edges split, on the reduced cells (degenerate edges contracted,
    // as in ReducedCounts; a faceted bound's implicit edges counted as
    // ReducedCounts counts them). At a vertex the walk leaves along the free
    // edge at the other end of the vertex's link path. Zero for a shell with
    // no free edge.
    // Chunk A body, from the contract BoundaryCycleCount: the cycles of the
    // indexed free edges and those of the implicit free edges, added.
    // ReducedCounts identifies poly-loop points among themselves and never
    // with vertices, so no cycle runs through both kinds.
    BoundaryCycleCount(m: BrepModel, s: ShellIndex): Integer
        => m.IndexedBoundaryCycleCount(s) + m.ImplicitBoundaryCycleCount(s);

    // The boundary cycles of shell s's indexed free edges. Under the
    // contract's requirement that every vertex link is one cycle or one path,
    // a boundary vertex has exactly two free edge ends (the path's two ends),
    // so the free edges, joined where they share a vertex class (degenerate
    // edges contracted as in ReducedCounts), form disjoint cycles: the number
    // of classes of free edges is the number of boundary cycles.
    IndexedBoundaryCycleCount(m: BrepModel, s: ShellIndex): Integer
    {
        var shellEdges = m.EdgesOfShell(s);
        var degenerate = shellEdges.FlatMap(e => m.IsDegenerateEdge(e) ? [e] : shellEdges.Take(0));
        var roots = ClassRoots(m.Vertices.Count,
            degenerate.Map(e => m.Edges[e].Start.Value), degenerate.Map(e => m.Edges[e].End.Value));
        var free = shellEdges.FlatMap(e => (m.UseCount(s, e) == 1 ? m.CountsAsEdge(e) : false) ? [e] : shellEdges.Take(0));
        var n = free.Count;
        var joined = n.Range.FlatMap(i => n.Range.FlatMap(j =>
            (i < j ? m.EdgesShareClass(free[i], free[j], roots) : false) ? [i * n + j] : n.Range.Take(0)));
        return ClassRoots(n, joined.Map(k => k / n), joined.Map(k => k % n)).ClassCount;
    }

    // The boundary cycles of shell s's implicit free edges: the components
    // of the graph on the poly-loop point classes whose links are the free
    // implicit edges, counted over the classes those edges touch. The same
    // argument as for indexed edges makes each component one cycle.
    ImplicitBoundaryCycleCount(m: BrepModel, s: ShellIndex): Integer
    {
        var n = m.ShellPolyPointRoots(s).Count;
        var free = m.ImplicitFreeEdgeKeys(s);
        var roots = ClassRoots(n, free.Map(k => k / n), free.Map(k => k % n));
        return free.Map(k => roots[k / n]).DistinctCount;
    }

    // The keys (ImplicitEdgeKeys) of shell s's implicit edges used exactly
    // once: its faceted free edges.
    ImplicitFreeEdgeKeys(m: BrepModel, s: ShellIndex): Array<Integer>
    {
        var keys = m.ImplicitEdgeKeys(m.ShellPolyBounds(s), m.ShellPolyPointRoots(s));
        return keys.FlatMap(k => keys.Reduce(0, (c, j) => j == k ? c + 1 : c) == 1 ? [k] : keys.Take(0));
    }

    // How many implicit edges of shell s's poly loops are used exactly once.
    ImplicitFreeEdgeCount(m: BrepModel, s: ShellIndex): Integer
        => m.ImplicitFreeEdgeKeys(s).Count;

    // Whether two edges have an end in a common vertex class.
    EdgesShareClass(m: BrepModel, a: BrepEdgeIndex, b: BrepEdgeIndex, roots: Array<Integer>): Boolean
    {
        var a0 = roots[m.Edges[a].Start.Value];
        var a1 = roots[m.Edges[a].End.Value];
        var b0 = roots[m.Edges[b].Start.Value];
        var b1 = roots[m.Edges[b].End.Value];
        return a0 == b0 || a0 == b1 || a1 == b0 || a1 == b1;
    }

    // Whether a use count is zero or two.
    IsZeroOrTwo(n: Integer): Boolean
        => n == 0 || n == 2;

    // Whether an Euler characteristic is even and at most 2 (ISO 10303-42 eq. 9).
    IsEvenAndAtMostTwo(chi: Integer): Boolean
        => chi % 2 == 0 && chi <= 2;

    //==
    // # Faceted bounds
    //
    // A poly loop's edges are implicit: consecutive points, the last back to
    // the first, matched across faces by coincidence within the length
    // tolerance, never by index. The edge-use rules apply to them as to
    // indexed edges, through the identification ReducedCounts makes.

    // Whether the loop, if a poly loop, has at least three points (STEP
    // poly_loop, LIST [3:?]); true for other loops.
    HasThreePointsIfPoly(loop: BrepLoop): Boolean
        => match (loop) {
            EdgeLoop(coedges) => true;
            VertexLoop(vertex) => true;
            PolyLoop(points) => points.Count >= 3;
        };

    // The number of implicit edges of shell s's poly loops whose uses break
    // the edge-use rules: in a shell declared closed, an implicit edge not used
    // exactly twice in opposite directions; in an open shell, one used more
    // than twice or twice in the same direction. Implicit edges are the
    // unordered pairs of consecutive poly-loop points after identifying the
    // points by coincidence (the transitive closure, as ReducedCounts takes
    // it), each use directed as its face runs its bound. Zero for a shell with
    // no poly loop.
    // Chunk A body, from the contract PolyEdgeUseDefects: the poly-loop points
    // identified by coincidence (CoincidenceRoots), each implicit edge keyed
    // by its unordered pair of classes with each use's direction
    // (ImplicitEdgeUses), and the keys counted whose uses break the rule:
    // declared closed, not exactly two uses in opposite directions; open,
    // more than two uses, or two in the same direction.
    PolyEdgeUseDefects(m: BrepModel, s: ShellIndex): Integer
    {
        var poly = m.ShellPolyBounds(s);
        var uses = m.ImplicitEdgeUses(poly, m.ShellPolyPointRoots(s));
        var keys = uses.Map(u => u / 2).Sort((a, b) => a <= b);
        var closed = m.Shells[s].DeclaredClosed;
        return keys.Count.Range.Reduce(0, (n, i) =>
            (i == 0 ? true : keys[i] != keys[i - 1])
                ? (m.IsDefectiveImplicitEdge(uses, keys[i], closed) ? n + 1 : n)
                : n);
    }

    // Whether the uses of the implicit edge key break the edge-use rule for a
    // shell declared closed or open.
    IsDefectiveImplicitEdge(m: BrepModel, uses: Array<Integer>, key: Integer, closed: Boolean): Boolean
    {
        var total = uses.Reduce(0, (n, u) => u / 2 == key ? n + 1 : n);
        var forward = uses.Reduce(0, (n, u) => u == key * 2 + 1 ? n + 1 : n);
        var opposite = total == 2 ? forward == 1 : false;
        return closed ? opposite.Not : (total > 2 || (total == 2 ? opposite.Not : false));
    }

    //==
    // # Connectivity
    //
    // ISO 10303-42 requires a shell to be a connected face set: arcwise
    // connected. Two faces touch when their bounds reference a common vertex
    // (an edge both cite has its vertices in both) or, for faceted faces, a
    // poly-loop point of one coincides with one of the other.

    // The vertices the bounds of face f reference, with repeats. Precondition:
    // m.IsFaceIntact(f).
    FaceVertices(m: BrepModel, f: BrepFaceIndex): Array<BrepVertexIndex>
        => m.Faces[f].Bounds.FlatMap(b => m.BoundVertices(b));

    // The points of the poly loops that bound face f. Precondition:
    // m.IsFaceIntact(f).
    FacePolyPoints(m: BrepModel, f: BrepFaceIndex): Array<Point3D>
        => m.Faces[f].Bounds.FlatMap(b => m.Loops[b.Loop].PolyLoopPointsOf);

    // The points of a poly loop; none for other loops.
    PolyLoopPointsOf(loop: BrepLoop): Array<Point3D>
        => match (loop) {
            EdgeLoop(coedges) => 0.MapRange(k => Point3D(0.0, 0.0, 0.0));
            VertexLoop(vertex) => 0.MapRange(k => Point3D(0.0, 0.0, 0.0));
            PolyLoop(points) => points;
        };

    // Whether faces a and b touch: a common vertex, or a coinciding pair of
    // poly-loop points. Precondition: both faces intact.
    FacesTouch(m: BrepModel, a: BrepFaceIndex, b: BrepFaceIndex): Boolean
        => m.FaceVertices(a).Any(v => m.FaceVertices(b).Any(w => v == w))
            || m.FacePolyPoints(a).Any(p => m.FacePolyPoints(b).Any(q => m.IsCoincident(p, q)));

    // The number of connected components of shell s: the classes of its faces
    // under the transitive closure of FacesTouch. Zero when no face of the
    // shell is in range.
    // Chunk A body, from the contract ShellComponentCount: layer 0's
    // ClassRoots over the shell's faces, joining every pair that FacesTouch
    // (quadratic, where an implementation unites the faces at each vertex in
    // one pass).
    ShellComponentCount(m: BrepModel, s: ShellIndex): Integer
    {
        var faces = m.ShellFaces(s);
        var n = faces.Count;
        var joined = n.Range.FlatMap(i => n.Range.FlatMap(j =>
            (i < j ? m.FacesTouch(faces[i], faces[j]) : false) ? [i * n + j] : n.Range.Take(0)));
        return ClassRoots(n, joined.Map(k => k / n), joined.Map(k => k % n)).ClassCount;
    }

    //==
    // # Orientability
    //
    // The local law Law_EdgeUsesHaveOppositeOrientation says which edges
    // disagree; it cannot say whether reversing some faces would repair them.
    // A parity search over the faces answers that: a shell is orientable when
    // some set of faces, once reversed, makes every edge's two uses opposite.
    // A Moebius band or a Klein bottle has no such set; a box with one face
    // stored inside out has the set {that face}.

    // The face with its normal turned over: SameSense and every bound's
    // Orientation flipped. The same point set, traversed the other way
    // (README, "Sense and orientation, composed").
    Reversed(face: BrepFace): BrepFace
        => BrepFace(face.Surface, face.SameSense.Not,
            face.Bounds.Map(b => FaceBound(b.Loop, b.Orientation.Not, b.IsOuter)));

    // The model with every face in faces reversed; other rows unchanged.
    WithFacesReversed(m: BrepModel, faces: Array<BrepFaceIndex>): BrepModel
        => BrepModel(
            m.Geometry,
            m.Vertices,
            m.Edges,
            m.Loops,
            m.Faces.Count.MapRange(i => faces.Any(f => f.Value == i) ? m.Faces[i].Reversed : m.Faces[i]),
            m.Shells,
            m.Bodies,
            m.Tolerances,
            m.Unit);

    // The model with every face reversed: each shell bounds the same region
    // from the other side. Layer 8's metamorphic input.
    WithEveryFaceReversed(m: BrepModel): BrepModel
        => m.WithFacesReversed(m.Faces.Count.MapRange(i => BrepFaceIndex(i)));

    // The same edge traversed the other way: ends swapped and the sense
    // flipped, so it runs over the same curve points in the opposite direction.
    SwappedEnds(edge: BrepEdge): BrepEdge
        => BrepEdge(edge.End, edge.Start, edge.Curve, edge.SameSense.Not);

    // The loop with every citation of edge e flipped.
    WithUsesFlipped(l: BrepLoop, e: BrepEdgeIndex): BrepLoop
        => match (l) {
            EdgeLoop(coedges) => BrepLoop.EdgeLoop(
                coedges.Map(c => c.Edge == e ? Coedge(c.Edge, c.Orientation.Opposite) : c));
            VertexLoop(vertex) => l;
            PolyLoop(points) => l;
        };

    // The model with edge e reversed: its ends swapped, its sense flipped, and
    // every citation of it flipped. The same solid with the same faces: every
    // coedge's composed sense and the edge domain are unchanged
    // (Law_EdgeReversalKeepsCoedgeSense, Law_EdgeReversalKeepsEdgeDomain); the
    // metamorphic input of the edge-reversal laws of layers 4 and 8
    // (research/VALIDATION-MATH.md 6.4).
    WithEdgeReversed(m: BrepModel, e: BrepEdgeIndex): BrepModel
        => BrepModel(
            m.Geometry,
            m.Vertices,
            m.Edges.Count.MapRange(i => i == e.Value ? m.Edges[i].SwappedEnds : m.Edges[i]),
            m.Loops.Map(l => l.WithUsesFlipped(e)),
            m.Faces,
            m.Shells,
            m.Bodies,
            m.Tolerances,
            m.Unit);

    // Whether every edge of shell s with two uses has them running opposite.
    // Precondition: m.IsEveryIndexInRange.
    HasCoherentOrientation(m: BrepModel, s: ShellIndex): Boolean
        => m.EdgesOfShell(s).All(e => m.UsesRunOpposite(m.CoedgeSitesOfEdge(s, e)));

    // The faces of shell s whose reversal makes its orientation coherent: the
    // faces the parity search colours "flip". Empty when the shell is already
    // coherent. When the shell is not orientable, the colouring of the search's
    // spanning forest, which leaves at least one edge incoherent.
    // Chunk A body, from the contract OrientationFlips: breadth-first
    // two-colouring of each component of the shell's face graph. An edge with
    // exactly two uses in two different faces joins them, parity 0 (same
    // colour) when the uses run opposite and 1 otherwise. A component's first
    // face, in shell order, is coloured 0 (keep); a conflict is left as found.
    // The faces coloured 1, in shell order, are the result.
    OrientationFlips(m: BrepModel, s: ShellIndex): Array<BrepFaceIndex>
    {
        var faces = m.ShellFaces(s);
        var n = faces.Count;
        var links = m.EdgesOfShell(s).FlatMap(e => m.FaceParityLink(s, e, faces));
        var colour = new Buffer<Integer>(n);
        var i = 0;
        while (i < n)
        {
            colour = colour.Set(i, -1);
            i = i + 1;
        }
        var root = 0;
        while (root < n)
        {
            if (colour.At(root) < 0)
            {
                colour = colour.Set(root, 0);
                var queue = new List<Integer>().Add(root);
                var head = 0;
                while (head < queue.Count)
                {
                    var face = queue.At(head);
                    var k = 0;
                    while (k < links.Count)
                    {
                        var a = links[k] / (2 * n);
                        var b = (links[k] / 2) % n;
                        var parity = links[k] % 2;
                        if (a == face)
                        {
                            if (colour.At(b) < 0)
                            {
                                colour = colour.Set(b, (colour.At(face) + parity) % 2);
                                queue = queue.Add(b);
                            }
                        }
                        if (b == face)
                        {
                            if (colour.At(a) < 0)
                            {
                                colour = colour.Set(a, (colour.At(face) + parity) % 2);
                                queue = queue.Add(a);
                            }
                        }
                        k = k + 1;
                    }
                    head = head + 1;
                }
            }
            root = root + 1;
        }
        var colours = colour.Freeze();
        return n.Range.FlatMap(j => colours[j] == 1 ? [faces[j]] : faces.Take(0));
    }

    // The face-graph link edge e makes in shell s, encoded (a * n + b) * 2 +
    // parity with a, b the positions of its two faces in faces (n of them):
    // one link when e has exactly two uses in two different faces, none
    // otherwise. Parity 0 when the uses run opposite. Precondition:
    // m.IsEveryIndexInRange.
    FaceParityLink(m: BrepModel, s: ShellIndex, e: BrepEdgeIndex, faces: Array<BrepFaceIndex>): Array<Integer>
    {
        var sites = m.CoedgeSitesOfEdge(s, e);
        var n = faces.Count;
        var twoFaces = sites.Count == 2 ? sites[0].Face != sites[1].Face : false;
        return twoFaces
            ? [(faces.PositionOf(sites[0].Face) * n + faces.PositionOf(sites[1].Face)) * 2 + (m.UsesRunOpposite(sites) ? 0 : 1)]
            : [0].Take(0);
    }

    // The position of face f in faces; -1 when absent.
    PositionOf(faces: Array<BrepFaceIndex>, f: BrepFaceIndex): Integer
        => faces.Count.Range.Reduce(-1, (found, i) => found >= 0 ? found : (faces[i] == f ? i : -1));

    // Whether shell s is orientable: reversing OrientationFlips makes it
    // coherent. A seam whose two uses run the same way can never be repaired,
    // since reversing its face flips both uses. Precondition:
    // m.IsEveryIndexInRange.
    IsOrientable(m: BrepModel, s: ShellIndex): Boolean
        => m.WithFacesReversed(m.OrientationFlips(s)).HasCoherentOrientation(s);

    //==
    // # Bodies

    // Whether every shell a solid body names is declared closed; true for a
    // shell set. Precondition: m.IsIntact(body).
    HasDeclaredClosedShells(m: BrepModel, body: BrepBody): Boolean
        => match (body) {
            ManifoldSolid(outer) => m.Shells[outer].DeclaredClosed;
            SolidWithVoids(outer, voids) => m.Shells[outer].DeclaredClosed && voids.All(v => m.Shells[v].DeclaredClosed);
            ShellSet(shells) => true;
        };

    //==
    // # Coupling measures
    //
    // The distances the coupling laws compare with Tolerances.Length. A layer 7
    // Check_ reports the largest one it samples as its Worst. Pointwise measures
    // take a sample fraction t, clamped into [0, 1] and mapped onto the domain.

    // A sample fraction clamped into [0, 1]; 0 when it is not finite.
    SampleFraction(t: Number): Number
        => t.IsFinite ? t.Clamp(0.0, 1.0) : 0.0;

    // The parameter at fraction t of edge e's domain. Precondition:
    // m.IsEveryIndexInRange and m.IsEdgeInRange(e).
    EdgeParameterAt(m: BrepModel, e: BrepEdgeIndex, t: Number): Number
        => m.EdgeDomain(e).Range.Lerp(t.SampleFraction);

    // The point of edge e's curve at fraction t of its edge domain.
    // Precondition: m.IsEveryIndexInRange and m.IsEdgeInRange(e).
    CurvePointAt(m: BrepModel, e: BrepEdgeIndex, t: Number): Point3D
        => m.EdgeCurvePoint(e, m.EdgeParameterAt(e, t));

    // The derivative of edge e's curve at fraction t of its edge domain, the
    // parameter wrapped as EdgeCurvePoint wraps it. Precondition:
    // m.IsEveryIndexInRange and m.IsEdgeInRange(e).
    CurveTangentAt(m: BrepModel, e: BrepEdgeIndex, t: Number): Vector3D
        => m.Geometry.Derivative(m.Edges[e].Curve, m.Geometry.Domain(m.Edges[e].Curve).Wrap(m.EdgeParameterAt(e, t)));

    // The distance from edge e's Start (atStart) or End vertex to the nearest
    // point of its curve. Precondition: m.IsEveryIndexInRange and
    // m.IsEdgeInRange(e).
    VertexCurveDeviation(m: BrepModel, e: BrepEdgeIndex, atStart: Boolean): Number
        => m.Vertices[m.EdgeVertex(e, atStart)].Point.Distance(
            m.Geometry.Eval(m.Edges[e].Curve, m.VertexParameter(e, m.EdgeVertex(e, atStart))));

    // The distance from edge e's Start (atStart) or End vertex to the curve point
    // at the end of the edge domain assigned to it. Precondition:
    // m.IsEveryIndexInRange and m.IsEdgeInRange(e).
    DomainEndDeviation(m: BrepModel, e: BrepEdgeIndex, atStart: Boolean): Number
        => m.Vertices[m.EdgeVertex(e, atStart)].Point.Distance(m.EdgeCurvePoint(e, m.DomainEndParameter(e, atStart)));

    // The distance from edge e's Start vertex to its curve point at fraction t.
    // Precondition: m.IsEveryIndexInRange and m.IsEdgeInRange(e).
    StartVertexDeviationAt(m: BrepModel, e: BrepEdgeIndex, t: Number): Number
        => m.CurvePointAt(e, t).Distance(m.Vertices[m.Edges[e].Start].Point);

    // The distance from the curve point at fraction t of a coedge's edge to the
    // point the site's face surface gives at that point's projection.
    // Precondition: m.IsEveryIndexInRange and m.IsCoedgeSiteInRange(site).
    SurfaceDeviationAt(m: BrepModel, site: CoedgeSite, t: Number): Number
    {
        var p = m.CurvePointAt(m.CoedgeAt(site).Edge, t);
        var surface = m.Faces[site.Face].Surface;
        return m.Geometry.Eval(surface, m.Geometry.Project(surface, p)).Distance(p);
    }

    // The distance from the point of the k-th pcurve of edge e's curve, at
    // fraction t of its edge range, to the nearest point of the 3D curve.
    // Precondition: m.IsEveryIndexInRange, m.IsEdgeInRange(e), and k a position
    // in PcurvesOf(e's curve).
    PcurveDeviationAt(m: BrepModel, e: BrepEdgeIndex, k: Integer, t: Number): Number
    {
        var p = m.PcurveOfEdge(e, k);
        var q = m.Geometry.Eval(p, m.PcurveEdgeDomain(e, p).Range.Lerp(t.SampleFraction));
        var c = m.Edges[e].Curve;
        return q.Distance(m.Geometry.Eval(c, m.Geometry.ClosestParameter(c, q)));
    }

    // The reverse direction: the distance from the curve point at fraction t
    // of edge e's domain to the nearest point of the k-th pcurve's image in
    // space. Precondition as PcurveDeviationAt.
    CurvePcurveDeviationAt(m: BrepModel, e: BrepEdgeIndex, k: Integer, t: Number): Number
    {
        var p = m.PcurveOfEdge(e, k);
        var c = m.CurvePointAt(e, t);
        return c.Distance(m.Geometry.Eval(p, m.Geometry.ClosestParameter(p, c)));
    }

    // The distance between the curve's and the k-th pcurve's points at the
    // same parameter, the parameter at fraction t of edge e's domain: zero
    // within rounding when the pcurve shares the curve's parameter
    // (SharesCurveParameter). Precondition as PcurveDeviationAt.
    PcurveParameterDeviationAt(m: BrepModel, e: BrepEdgeIndex, k: Integer, t: Number): Number
        => m.Geometry.Eval(m.PcurveOfEdge(e, k), m.EdgeParameterAt(e, t)).Distance(m.CurvePointAt(e, t));

    // Whether the k-th pcurve runs the way the curve does at fraction t of
    // edge e's domain: the curve's tangent there and the pcurve's tangent in
    // space at the nearest pcurve point do not point apart. Where either
    // tangent's length is below the arithmetic resolution the sign is noise
    // and the test passes. Precondition as PcurveDeviationAt.
    PcurveRunsWithCurveAt(m: BrepModel, e: BrepEdgeIndex, k: Integer, t: Number): Boolean
    {
        var p = m.PcurveOfEdge(e, k);
        var curveTangent = m.CurveTangentAt(e, t);
        var pcurveTangent = m.Geometry.Derivative(p, m.Geometry.ClosestParameter(p, m.CurvePointAt(e, t)));
        return curveTangent.Dot(pcurveTangent) >= 0.0 - ResolutionAt(curveTangent.Length * pcurveTangent.Length);
    }

    // Whether the k-th pcurve of edge e lies on the surface of a face whose
    // bounds cite e. Precondition: m.IsEveryIndexInRange, e in range,
    // m.HasPcurve(e, k).
    IsPcurveOnAdjacentFace(m: BrepModel, e: BrepEdgeIndex, k: Integer): Boolean
        => m.FacesOfEdge(e).Any(f => m.Faces[f].Surface == m.Geometry.Pcurves[m.PcurveOfEdge(e, k)].Surface);

    //==
    // # Parameter-space winding

    // Whether face f's image in its surface's parameter plane needs no seam or
    // pole handling: every bound is an edge loop, no edge is a seam of f, no loop
    // vertex lies on a degenerate side (DegenerateSides), and each bound's
    // projected, continuity-unwrapped polygon returns to its start within the
    // parameter tolerance, so that no bound wraps a period. Every direction with
    // a seam is unwrapped, Closed as well as Periodic (layer 0's HasSeam and
    // NearestUnwrapped on the surface domain): a band between two circles of a
    // clamped closed B-spline surface wraps its closed direction and is not
    // plain, though its formula does not wrap (review C1).
    // Chunk A body, from the contract IsPlainInParameters: only edge loops, no
    // seam, at least one bound; then every bound's lifted polygon
    // (LiftedBound) returns to its start within the parameter tolerance there,
    // and no loop vertex lies on a side DegenerateSides names.
    IsPlainInParameters(m: BrepModel, f: BrepFaceIndex): Boolean
        => (m.Faces[f].Bounds.Count >= 1 ? (m.HasOnlyEdgeLoops(f) ? m.HasSeam(f).Not : false) : false)
            ? m.Faces[f].Bounds.All(b => m.LiftedBoundCloses(f, b) && m.BoundAvoidsDegenerateSides(f, b))
            : false;

    // The number of samples per coedge the lifted polygons take, ends
    // included.
    LiftSamples(_: BrepModel): Integer
        => 9;

    // The points of bound b of face f mapped into the surface's parameter
    // plane by Project and unwrapped by continuity (layer 0's NearestUnwrapped
    // on the surface domain, every direction with a seam), each coedge
    // sampled in its composed direction (CoedgeRunsForwardOnCurve) without its
    // last sample, the next coedge's first; the loop's first point is
    // appended again, unwrapped, at the end. Precondition:
    // m.IsEveryIndexInRange, b a bound of f, every coedge's edge in range.
    LiftedBound(m: BrepModel, f: BrepFaceIndex, b: FaceBound): Array<UvCoordinate>
    {
        var s = m.Faces[f].Surface;
        var d = m.Geometry.Domain(s);
        var coedges = m.LoopCoedges(b.Loop);
        var ordered = b.Orientation ? coedges : coedges.Count.MapRange(i => coedges[coedges.Count - 1 - i]);
        var raw = ordered.FlatMap(c => m.CoedgeSamples(b, c)).Map(p => m.Geometry.Project(s, p));
        var n = raw.Count;
        var lifted = new List<UvCoordinate>();
        var i = 0;
        while (i <= n && n > 0)
        {
            var uv = raw[i % n];
            lifted = lifted.Add(i == 0 ? uv : d.NearestUnwrapped(uv, lifted.At(i - 1)));
            i = i + 1;
        }
        return lifted.Freeze();
    }

    // The points of coedge c of bound b, LiftSamples of them less the last,
    // in the coedge's composed direction along its edge domain.
    CoedgeSamples(m: BrepModel, b: FaceBound, c: Coedge): Array<Point3D>
    {
        var ts = m.EdgeDomain(c.Edge).Range.Samples(BrepModel.LiftSamples);
        var forward = m.CoedgeRunsForwardOnCurve(b, c);
        return (ts.Count - 1).MapRange(i => m.EdgeCurvePoint(c.Edge, forward ? ts[i] : ts[ts.Count - 1 - i]));
    }

    // Whether bound b's lifted polygon returns to its start: its last point
    // (the first, unwrapped) is its first within the parameter tolerance
    // there.
    LiftedBoundCloses(m: BrepModel, f: BrepFaceIndex, b: FaceBound): Boolean
    {
        var lifted = m.LiftedBound(f, b);
        var s = m.Faces[f].Surface;
        return lifted.Count == 0 ? false : lifted[0].SameParameter(lifted[lifted.Count - 1], m.Geometry.UvToleranceAt(s, lifted[0], m.Tolerances));
    }

    // Whether no vertex of bound b lies on a degenerate side of face f's
    // surface, within the parameter tolerance at the vertex's projection.
    BoundAvoidsDegenerateSides(m: BrepModel, f: BrepFaceIndex, b: FaceBound): Boolean
    {
        var s = m.Faces[f].Surface;
        var d = m.Geometry.Domain(s);
        var sides = m.Geometry.DegenerateSides(s, m.Tolerances);
        return m.BoundVertices(b).All(v => sides.All(side =>
            m.IsOffSide(d, side, m.Geometry.Project(s, m.Vertices[v].Point), m.Geometry.UvToleranceAt(s, m.Geometry.Project(s, m.Vertices[v].Point), m.Tolerances))));
    }

    // Whether uv is off the side: its constant coordinate differs from the
    // side's value by more than the tolerance in that direction.
    IsOffSide(m: BrepModel, d: SurfaceDomain, side: DomainSide, uv: UvCoordinate, t: UvTolerance): Boolean
        => side.IsUSide
            ? uv.U.SameParameter(d.SideValue(side), t.U).Not
            : uv.V.SameParameter(d.SideValue(side), t.V).Not;

    // The signed area of face f's region in its parameter plane: the sum over
    // the bounds of (1/2) times the closed integral of (u dv - v du), each bound
    // traversed as the face uses it, each coedge in its composed direction, its
    // points mapped to (u, v) by Project. Green's theorem with unit weight: the
    // same integral as layer 7's Oracle_FaceAreaByGreen without the area element.
    // Precondition: m.IsPlainInParameters(f).
    // Chunk A body, from the contract SignedParameterArea: the shoelace sum,
    // (1/2) sum of (u_i v_(i+1) - u_(i+1) v_i), over the lifted polygon of
    // every bound (LiftedBound), each traversed as the face uses it.
    SignedParameterArea(m: BrepModel, f: BrepFaceIndex): Number
        => m.Faces[f].Bounds.Map(b => m.LiftedBound(f, b).ShoelaceSum).SumOf;

    // Half the sum of u_i v_(i+1) - u_(i+1) v_i over consecutive points of a
    // polygon whose last point repeats its first.
    ShoelaceSum(points: Array<UvCoordinate>): Number
        => (points.Count - 1).MapRange(i => points[i].U * points[i + 1].V - points[i + 1].U * points[i].V).SumOf * 0.5;

    // Whether face f's parameter-space area has the sign its normal sign
    // requires: positive when FaceNormalSign is +1, negative when -1.
    // Precondition: m.IsPlainInParameters(f).
    WindingAgreesWithNormal(m: BrepModel, f: BrepFaceIndex): Boolean
        => m.FaceNormalSign(f) == 1 ? m.SignedParameterArea(f) > 0.0 : m.SignedParameterArea(f) < 0.0;

    //==
    // # Size and extent
    //
    // Two magnitudes of a model that layer 0's floors read and layer 3 exports
    // in DecodedModel (layer 0 README, "The rounding floor at the coordinate
    // extent"). The model size, the diagonal of the bounding box, bounds a
    // radius, so it divides the angle parameter floor. The coordinate extent,
    // the largest absolute coordinate, sets the rounding: a building in
    // millimetres at survey coordinates near 5e9 has a size near 1e5 and an
    // extent near 5e9, and ResolutionAt(5e9) = 1.8e-5 mm against
    // ResolutionAt(1e5) = 3.6e-10. Both are taken over the model's defining
    // points: vertices, poly-loop points, and every point, placement origin
    // and control point the arena stores. Every point of a face lies within
    // the box of those points widened by the largest radius, and a radius of
    // a conic or elementary surface that a vertex lies on is at most the size,
    // so the true extent is at most CoordinateExtent + ModelSize.

    // Every defining point of the model: vertex points, poly-loop points, and
    // the defining points of every curve and surface of the arena.
    ModelPoints(m: BrepModel): Array<Point3D>
        => m.Vertices.Map(v => v.Point)
            .Concatenate(m.Loops.FlatMap(l => l.PolyLoopPointsOf))
            .Concatenate(m.Geometry.Curves.FlatMap(c => c.DefiningPoints))
            .Concatenate(m.Geometry.Surfaces.FlatMap(s => s.DefiningPoints));

    // The diagonal of the axis-aligned bounding box of the points; 0 for none.
    BoundingDiagonal(points: Array<Point3D>): Number
        => points.Count == 0
            ? 0.0
            : points.Reduce(points[0], (a, p) => Point3D(a.X.Min(p.X), a.Y.Min(p.Y), a.Z.Min(p.Z)))
                .Distance(points.Reduce(points[0], (a, p) => Point3D(a.X.Max(p.X), a.Y.Max(p.Y), a.Z.Max(p.Z))));

    // The largest absolute coordinate of the points; 0 for none.
    LargestAbsoluteCoordinate(points: Array<Point3D>): Number
        => points.Reduce(0.0, (x, p) => x.Max(p.X.Abs).Max(p.Y.Abs).Max(p.Z.Abs));

    // The model size: the diagonal of the bounding box of the model's defining
    // points, in model units. The bound on a radius, and the divisor of layer
    // 0's angle parameter floor.
    ModelSize(m: BrepModel): Number
        => m.ModelPoints.BoundingDiagonal;

    // The coordinate extent: the largest absolute coordinate of the model's
    // defining points, in model units. Every rounding floor on a coordinate, a
    // length tolerance, or a length parameter is ResolutionAt of it (layer 0
    // README, decision 11).
    CoordinateExtent(m: BrepModel): Number
        => m.ModelPoints.LargestAbsoluteCoordinate;

    //==
    // # Model transforms
    //
    // The metamorphic inputs of research/VALIDATION-MATH.md 6.4 that layers 7
    // and 8 compare runs over: a rigid motion and a uniform scaling of the
    // whole model. Each maps every table and keeps the topology rows as they
    // are, so every index, every coedge sense and every edge domain's
    // structure carry over.

    // The point with every coordinate multiplied by factor: scaling about the
    // origin. Exact when factor is a power of two.
    ScaledPoint(p: Point3D, factor: Number): Point3D
        => Point3D(p.X * factor, p.Y * factor, p.Z * factor);

    // The model carried by a rigid motion: every point of the arena and every
    // vertex goes to motion.PointInFrame(p), every frame, direction and vector
    // turns with motion's axes (layer 1's MovedGeometry), B-spline control
    // points move as points;
    // weights, knots, every parameter (so every 2D curve and pcurve), the
    // topology, the tolerances and the unit are kept. motion is an orthonormal
    // right-handed frame (layer 8 checks it with IsOrthonormalWithin).
    RigidlyMoved(m: BrepModel, motion: Frame3D): BrepModel
        => BrepModel(
            m.Geometry.MovedGeometry(motion),
            m.Vertices.Map(v => BrepVertex(motion.PointInFrame(v.Point))),
            m.Edges,
            m.Loops.Map(l => l.Moved(motion)),
            m.Faces,
            m.Shells,
            m.Bodies,
            m.Tolerances,
            m.Unit);

    // The model scaled about the origin by factor > 0: the arena through
    // layer 1's ScaledGeometry (curves and surfaces scaled with their
    // parameters kept, except a length along a unit frame axis, which scales,
    // and every pcurve's 2D curve rescaled for its surface's directions), every
    // vertex and poly-loop point scaled, the topology rows and the unit kept,
    // and the tolerances scaled as a re-decode of the scaled file would set
    // them (layer 0's ScaledTolerances). Exact when factor is a power of two: then
    // meshing commutes with scaling both up and down, since each parameter
    // floor follows its own kind (layer 8 finding 6).
    ScaledBy(m: BrepModel, factor: Number): BrepModel
        => BrepModel(
            m.Geometry.ScaledGeometry(factor),
            m.Vertices.Map(v => BrepVertex(v.Point.ScaledPoint(factor))),
            m.Edges,
            m.Loops.Map(l => l.Scaled(factor)),
            m.Faces,
            m.Shells,
            m.Bodies,
            m.Tolerances.ScaledTolerances(factor),
            m.Unit);

    // A loop scaled about the origin: a poly loop's points scale; edge and
    // vertex loops hold only indices.
    Scaled(loop: BrepLoop, factor: Number): BrepLoop
        => match (loop) {
            EdgeLoop(coedges) => loop;
            VertexLoop(vertex) => loop;
            PolyLoop(points) => BrepLoop.PolyLoop(points.Map(p => p.ScaledPoint(factor)));
        };

    // A loop carried by the rigid motion: a poly loop's points move; edge and
    // vertex loops hold only indices.
    Moved(loop: BrepLoop, motion: Frame3D): BrepLoop
        => match (loop) {
            EdgeLoop(coedges) => loop;
            VertexLoop(vertex) => loop;
            PolyLoop(points) => BrepLoop.PolyLoop(points.Map(p => motion.PointInFrame(p)));
        };

    //==
    // # Units

    // The length of one model unit in metres.
    ScaleToMetres(u: LengthUnit): Number
        => match (u) {
            Metre => 1.0;
            Millimetre => 0.001;
            Centimetre => 0.01;
            Inch => 0.0254;
            Foot => 0.3048;
            Scaled(metresPerUnit) => metresPerUnit;
        };
}

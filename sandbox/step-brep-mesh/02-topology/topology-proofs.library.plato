//==
// # Proofs about the kernel model, its loops, and its shells (constructors)
//
// One Check* function per proof type of topology-proofs.types.plato, the
// only function that builds it (topology-proofs.spec.plato). Each calls the
// library's own predicate and never restates it; IsDecided reads the
// verdict, and the IToleranced and IHasProvenance obligations follow. A
// property checked and found false is Fails, naming the predicate; an input
// the predicate cannot be asked of is OutOfDomain.
//
// Sections, in order:
//  - The whole model
//  - Loops
//  - Shells
//  - Verdicts
//  - Concept obligations

library BrepTopologyProofs
{
    //==
    // # The whole model

    // The model as an InRangeModel when every stored index is in range;
    // OutOfDomain otherwise.
    CheckInRangeModel(m: BrepModel): DecidedInRangeModel
        => m.IsEveryIndexInRange
            ? DecidedInRangeModel.Decided(InRangeModel(m))
            : DecidedInRangeModel.Undecided(UndecidedReason.OutOfDomain);

    // The model as a ResolvableModel when its length tolerance is resolvable
    // at its coordinate extent; BelowResolution otherwise.
    CheckResolvableModel(m: BrepModel): DecidedResolvableModel
        => m.Tolerances.Length.IsResolvable(m.CoordinateExtent)
            ? DecidedResolvableModel.Decided(ResolvableModel(m, ModelLength(m.CoordinateExtent)))
            : DecidedResolvableModel.Undecided(UndecidedReason.BelowResolution);

    //==
    // # Loops

    // Loop l as a ChainedLoop when it is intact and chains end to start;
    // OutOfDomain when it is not intact, Fails when it breaks.
    CheckChainedLoop(m: BrepModel, l: BrepLoopIndex): DecidedChainedLoop
        => m.IsLoopIntact(l)
            ? (m.ChainsEndToStart(m.Loops[l])
                ? DecidedChainedLoop.Decided(ChainedLoop(l))
                : DecidedChainedLoop.Undecided(UndecidedReason.Fails("ChainsEndToStart")))
            : DecidedChainedLoop.Undecided(UndecidedReason.OutOfDomain);

    //==
    // # Shells

    // True when every index is in range and s names a shell: the
    // precondition of the shell predicates below.
    IsCheckableShell(m: BrepModel, s: ShellIndex): Boolean
        => m.IsEveryIndexInRange ? m.IsShellInRange(s) : false;

    // True when every counted edge of shell s has zero or two uses: the
    // claim of Law_EveryEdgeUsedTwiceInClosedShell without its
    // DeclaredClosed guard. Precondition: IsCheckableShell.
    UsesEveryEdgeTwice(m: BrepModel, s: ShellIndex): Boolean
        => m.EdgesOfShell(s).All(e => m.CountsAsEdge(e) ? m.UseCount(s, e).IsZeroOrTwo : true);

    // Shell s as a ClosedShell, with its reduced counts, when it uses every
    // counted edge twice; Fails when an edge is free or overused,
    // OutOfDomain when it cannot be checked.
    CheckClosedShell(m: BrepModel, s: ShellIndex): DecidedClosedShell
        => m.IsCheckableShell(s)
            ? (m.UsesEveryEdgeTwice(s)
                ? DecidedClosedShell.Decided(ClosedShell(s, m.ReducedCounts(s)))
                : DecidedClosedShell.Undecided(UndecidedReason.Fails("UsesEveryEdgeTwice")))
            : DecidedClosedShell.Undecided(UndecidedReason.OutOfDomain);

    // The closed shell as an OrientedShell when its edge uses run opposite
    // (HasCoherentOrientation); Fails otherwise. OutOfDomain when m is not
    // the kind of model the closed shell can be checked in.
    CheckOrientedShell(m: BrepModel, c: ClosedShell): DecidedOrientedShell
        => m.IsCheckableShell(c.Shell)
            ? (m.HasCoherentOrientation(c.Shell)
                ? DecidedOrientedShell.Decided(OrientedShell(c.Shell, c.Counts))
                : DecidedOrientedShell.Undecided(UndecidedReason.Fails("HasCoherentOrientation")))
            : DecidedOrientedShell.Undecided(UndecidedReason.OutOfDomain);

    // Shell s as a ConnectedShell when its faces form at most one class;
    // Fails when they form several.
    CheckConnectedShell(m: BrepModel, s: ShellIndex): DecidedConnectedShell
        => m.IsCheckableShell(s)
            ? (m.ShellComponentCount(s) <= 1
                ? DecidedConnectedShell.Decided(ConnectedShell(s))
                : DecidedConnectedShell.Undecided(UndecidedReason.Fails("ShellComponentCount <= 1")))
            : DecidedConnectedShell.Undecided(UndecidedReason.OutOfDomain);

    //==
    // # Verdicts

    // True when the check built its proof.
    IsDecided(d: DecidedInRangeModel): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedResolvableModel): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedChainedLoop): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedClosedShell): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedOrientedShell): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedConnectedShell): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    //==
    // # Concept obligations

    // The tolerances whose length part was found resolvable.
    Tolerance(x: ResolvableModel): Tolerances
        => x.Model.Tolerances;

    // The loop the proof is about.
    Where(x: ChainedLoop): Provenance
        => Provenance.KernelLoop(x.Loop);

    // The shell the proof is about.
    Where(x: ClosedShell): Provenance
        => Provenance.KernelShell(x.Shell);

    // The shell the proof is about.
    Where(x: OrientedShell): Provenance
        => Provenance.KernelShell(x.Shell);

    // The shell the proof is about.
    Where(x: ConnectedShell): Provenance
        => Provenance.KernelShell(x.Shell);
}

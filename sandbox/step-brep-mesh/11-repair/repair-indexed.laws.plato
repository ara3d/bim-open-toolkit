//==
// # Repair diagnosis over one index: laws (complexity sweep, chunk L8)
//
// The staged functions agree with their BrepRepairDiagnosis namesakes on the repair sample model
// (Witness_BoxWithPolyLoopSheet: closed box shell 0, open sheet shell 1 with a poly loop), the
// unit box, the cylinder (a seam edge) and the sphere (two vertex loops), at every index in range
// and at indices just outside it; the plan over one index makes no whole-model scan per defect;
// FacesAtVertexByCoedges visits each face and coedge once.
//
// Sections, in order:
//  - Models and defects
//  - Comparisons
//  - Agreement
//  - Work

library BrepRepairPerfLaws
{
    //==
    // # Models and defects

    // The number of models RepairPerfModelAt draws from.
    RepairPerfModelCount(_: RepairIndex): Integer
        => 4;

    // Model w (0 to 3): the repair sample model, the unit box, the cylinder, the sphere.
    RepairPerfModelAt(w: Integer): BrepModel
        => w == 0 ? Defect.RepairSampleModel
            : w == 1 ? BrepModel.Witness_UnitBox
            : w == 2 ? BrepModel.Witness_Cylinder
            : BrepModel.Witness_Sphere;

    // The number of defects ExtraDefect has.
    ExtraDefectCount(_: RepairIndex): Integer
        => 16;

    // Defects at indices the sample defects do not reach: negative ones (the fallback scans) and
    // ones past every table of the four models, one per action that reads a table.
    ExtraDefect(k: Integer): Defect
    {
        var gap = ModelLength(0.01);
        return k == 0 ? Defect.FreeEdge(BrepEdgeIndex(-1))
            : k == 1 ? Defect.FreeEdge(BrepEdgeIndex(40))
            : k == 2 ? Defect.VertexOffCurve(BrepVertexIndex(-1), BrepEdgeIndex(0), gap)
            : k == 3 ? Defect.DuplicateVertex(BrepVertexIndex(0), BrepVertexIndex(40), gap)
            : k == 4 ? Defect.GapAtVertex(BrepEdgeIndex(-1), EdgeEnd(BrepEdgeIndex(-1), true), gap)
            : k == 5 ? Defect.DegenerateEdge(BrepEdgeIndex(40))
            : k == 6 ? Defect.PcurveOffCurve(PcurveIndex(-1), gap)
            : k == 7 ? Defect.LoopNotChained(BrepLoopIndex(-1), CoedgeSlot(0))
            : k == 8 ? Defect.LoopNotChained(BrepLoopIndex(40), CoedgeSlot(0))
            : k == 9 ? Defect.TrimOutsideDomain(SurfaceIndex(-1), 0.1)
            : k == 10 ? Defect.TrimOutsideDomain(SurfaceIndex(40), 0.1)
            : k == 11 ? Defect.KnotsNotNonDecreasing(CurveIndex(-1), 1)
            : k == 12 ? Defect.KnotMultiplicityTooHigh(CurveIndex(40), 1)
            : k == 13 ? Defect.SeamRunsSameWay(BrepFaceIndex(-1), BrepEdgeIndex(0))
            : k == 14 ? Defect.SeamRunsSameWay(BrepFaceIndex(2), BrepEdgeIndex(2))
            : Defect.DeclaredClosedButOpen(ShellIndex(1), CountOf(1));
    }

    // Every sample defect, then every extra one.
    AllPerfDefects(_: RepairIndex): Array<Defect>
        => Defect.SampleDefectCount.MapRange(k => SampleDefect(k))
            .Concatenate(RepairIndex.ExtraDefectCount.MapRange(k => ExtraDefect(k)));

    //==
    // # Comparisons

    // Whether two face lists are equal, element by element.
    SameFaces(a: Array<BrepFaceIndex>, b: Array<BrepFaceIndex>): Boolean
        => a.Corresponds(b, (p, q) => p == q);

    // The rank of a locality's case.
    LocalityRank(l: Locality): Integer
        => match (l) {
            Local => 0;
            NeedsNeighbours(faces) => 1;
            WholeShell => 2;
            WholeModel => 3;
        };

    // The faces a NeedsNeighbours locality names; none for the other cases.
    LocalityFaces(l: Locality): Array<BrepFaceIndex>
        => match (l) {
            Local => BrepFaceIndex.NoFaceIndices;
            NeedsNeighbours(faces) => faces;
            WholeShell => BrepFaceIndex.NoFaceIndices;
            WholeModel => BrepFaceIndex.NoFaceIndices;
        };

    // Whether two costs are equal, field by field.
    SameCost(c: RepairCost, d: RepairCost): Boolean
        => c.TouchedFaces.Value == d.TouchedFaces.Value
            && c.ToleranceGrowth.Value == d.ToleranceGrowth.Value
            && LocalityRank(c.Locality) == LocalityRank(d.Locality)
            && SameFaces(LocalityFaces(c.Locality), LocalityFaces(d.Locality));

    // The cost of a Fixable diagnosis, as an array of zero or one.
    CostsOf(x: Fixability): Array<RepairCost>
        => match (x) {
            Fixable(a, c) => [c];
            FixableWithChoice(options) => [RepairCost(CountOf(0), Ratio(1.0), Locality.Local)].Take(0);
            Unfixable(why) => [RepairCost(CountOf(0), Ratio(1.0), Locality.Local)].Take(0);
        };

    // Why an Unfixable diagnosis is unfixable; empty for the others.
    WhyOf(x: Fixability): String
        => match (x) {
            Fixable(a, c) => "";
            FixableWithChoice(options) => "";
            Unfixable(why) => why;
        };

    // Whether two diagnoses are equal: the same case, actions, costs and reason.
    SameFixability(x: Fixability, y: Fixability): Boolean
        => x.IsUnfixable == y.IsUnfixable
            && ActionsOf(x).Corresponds(ActionsOf(y), (a, b) => a == b)
            && CostsOf(x).Corresponds(CostsOf(y), (c, d) => SameCost(c, d))
            && WhyOf(x) == WhyOf(y);

    // Whether two plans are equal, step by step.
    SamePlan(p: RepairPlan, q: RepairPlan): Boolean
        => p.Steps.Corresponds(q.Steps, (x, y) => x.Defect == y.Defect && x.Action == y.Action && x.Expect == y.Expect);

    // The comparisons tell different values apart, so no agreement law passes vacuously: the seam
    // on the closed face and on the open one, a plan and its reverse, two face lists.
    Law_ComparisonsSeeDifferences(_: Defect): Boolean
    {
        var m = Defect.RepairSampleModel;
        var plan = m.PlanOf(SampleDefects(0));
        return !SameFixability(m.Diagnose(SampleDefect(10)), m.Diagnose(SampleDefect(11)))
            && !SameFixability(m.Diagnose(SampleDefect(2)), m.Diagnose(SampleDefect(3)))
            && !SamePlan(plan, RepairPlan(plan.Steps.Count.MapRange(i => plan.Steps[plan.Steps.Count - 1 - i])))
            && !SameFaces(m.FacesAtVertex(BrepVertexIndex(0)), m.FacesAtVertex(BrepVertexIndex(6)));
    }

    //==
    // # Agreement

    // FacesAtVertexByCoedges is FacesAtVertex at every vertex of the model and at -1, V and V + 5.
    FacesAtVertexAgreesOn(m: BrepModel): Boolean
        => (m.Vertices.Count + 7).Range.All(i =>
            SameFaces(m.FacesAtVertexByCoedges(BrepVertexIndex(i - 1)), m.FacesAtVertexScanned(BrepVertexIndex(i - 1))));

    // The statement above, on every model.
    Law_FacesAtVertexByCoedgesAgrees(_: Defect): Boolean
        => RepairIndex.RepairPerfModelCount.Range.All(w => FacesAtVertexAgreesOn(RepairPerfModelAt(w)));

    // FacesOnCurveByCoedges is FacesOnCurve at every curve of the model and just outside.
    FacesOnCurveAgreesOn(m: BrepModel): Boolean
        => (m.Geometry.Curves.Count + 3).Range.All(i =>
            SameFaces(m.FacesOnCurveByCoedges(CurveIndex(i - 1)), m.FacesOnCurveScanned(CurveIndex(i - 1))));

    // The statement above, on every model.
    Law_FacesOnCurveByCoedgesAgrees(_: Defect): Boolean
        => RepairIndex.RepairPerfModelCount.Range.All(w => FacesOnCurveAgreesOn(RepairPerfModelAt(w)));

    // Every answer the index gives is its namesake's, at every index of its table and at -1 and
    // two past the end: closed-shell membership per face, faces per vertex, edge, curve,
    // surface, loop and pcurve.
    IndexAgreesOn(m: BrepModel): Boolean
    {
        var ix = m.RepairIndexOf;
        return (m.Faces.Count + 3).Range.All(i => ix.IsInClosedShellIn(BrepFaceIndex(i - 1)) == m.IsInClosedShell(BrepFaceIndex(i - 1)))
            && (m.Vertices.Count + 3).Range.All(i =>
                SameFaces(m.FacesAtVertexIndexed(ix, BrepVertexIndex(i - 1)).Value, m.FacesAtVertexScanned(BrepVertexIndex(i - 1))))
            && (m.Edges.Count + 3).Range.All(i =>
                SameFaces(m.FacesOfEdgeIndexed(ix, BrepEdgeIndex(i - 1)).Value, m.FacesOfEdge(BrepEdgeIndex(i - 1))))
            && (m.Geometry.Curves.Count + 3).Range.All(i =>
                SameFaces(m.FacesOnCurveIndexed(ix, CurveIndex(i - 1)).Value, m.FacesOnCurveScanned(CurveIndex(i - 1))))
            && (m.Geometry.Surfaces.Count + 3).Range.All(i =>
                SameFaces(m.FacesOnSurfaceIndexed(ix, SurfaceIndex(i - 1)).Value, m.FacesOnSurface(SurfaceIndex(i - 1))))
            && (m.Loops.Count + 3).Range.All(i =>
                SameFaces(m.FacesOfLoopIndexed(ix, BrepLoopIndex(i - 1)).Value, m.FacesOfLoop(BrepLoopIndex(i - 1))))
            && (m.Geometry.Pcurves.Count + 3).Range.All(i =>
                SameFaces(m.FacesOfPcurveIndexed(ix, PcurveIndex(i - 1)).Value, m.FacesOfPcurve(PcurveIndex(i - 1))));
    }

    // The statement above, on every model.
    Law_RepairIndexAgrees(_: Defect): Boolean
        => RepairIndex.RepairPerfModelCount.Range.All(w => IndexAgreesOn(RepairPerfModelAt(w)));

    // DiagnoseIndexed is Diagnose, and CostOfBound and CostOfIndexed are CostOf for every action
    // Diagnose offers, for every sample and extra defect.
    DiagnosisAgreesOn(m: BrepModel): Boolean
    {
        var ix = m.RepairIndexOf;
        return RepairIndex.AllPerfDefects.All(d =>
            SameFixability(m.DiagnoseIndexed(ix, d), m.Diagnose(d))
                && ActionsOf(m.Diagnose(d)).All(a =>
                    SameCost(m.CostOfBound(a), m.CostOf(a)) && SameCost(m.CostOfIndexed(ix, a), m.CostOf(a))));
    }

    // The statement above, on every model.
    Law_DiagnoseIndexedAgrees(_: Defect): Boolean
        => RepairIndex.RepairPerfModelCount.Range.All(w => DiagnosisAgreesOn(RepairPerfModelAt(w)));

    // PlanOfIndexed is PlanOf on the sample defects in the order SampleDefects(k) gives, and on
    // every sample and extra defect, on every model.
    Law_PlanOfIndexedAgrees(k: Integer): Boolean
    {
        var ds = SampleDefects(k);
        var all = RepairIndex.AllPerfDefects;
        return RepairIndex.RepairPerfModelCount.Range.All(w =>
            SamePlan(RepairPerfModelAt(w).PlanOfIndexed(ds), RepairPerfModelAt(w).PlanOf(ds))
                && SamePlan(RepairPerfModelAt(w).PlanOfIndexed(all), RepairPerfModelAt(w).PlanOf(all)));
    }

    //==
    // # Work

    // PlanOfIndexed makes the index's passes and no other whole-model scan (Flips) on the repair
    // sample model with 1, 8 and all 28 planted sample defects: a constant per plan. PlanOf makes
    // one or more scans per defect.
    Law_PlanOfIndexedScansOnlyToBuildIndex(_: Defect): Boolean
    {
        var m = Defect.RepairSampleModel;
        var once = m.RepairIndexCounted.Work;
        return once == Flips(RepairIndex.RepairIndexPasses)
            && [1, 8, 28].All(n => m.PlanOfIndexedCounted(n.MapRange(i => SampleDefect(i))).Work == once);
    }

    // A negative index falls back to the namesake's scan, and the count shows it: one Flip each.
    Law_FallbackScansAreCounted(_: Defect): Boolean
    {
        var m = Defect.RepairSampleModel;
        var once = m.RepairIndexCounted.Work;
        return m.PlanOfIndexedCounted([ExtraDefect(0), ExtraDefect(2), ExtraDefect(11)]).Work == once.Add(Flips(3));
    }

    // The coedge count of a model: every coedge site of every face.
    CoedgeCount(m: BrepModel): Integer
        => m.Faces.Count.Range.Reduce(0, (n, f) => n + m.CoedgeSitesOfFace(BrepFaceIndex(f)).Count);

    // The member of the coedge family with n coedges: the cylinder (6) or the unit box (24).
    CoedgeFamilyModel(n: Integer): BrepModel
        => n <= 6 ? BrepModel.Witness_Cylinder : BrepModel.Witness_UnitBox;

    // The faces and coedges FacesAtVertexByCoedges visits at vertex 0 of family member n.
    FacesAtVertexWorkAt(n: Integer): WorkBudget
        => n.CoedgeFamilyModel.FacesAtVertexByCoedgesCounted(BrepVertexIndex(0)).Work;

    // FacesAtVertexByCoedges visits each face and each coedge once (Insertions), so at most two
    // per coedge when every face has one: on the cylinder (6 coedges) and the unit box (24).
    // FacesAtVertex tests every edge for every face, each test a scan of the face's coedges:
    // 3 x 3 tests on the cylinder, 6 x 12 on the box.
    Witness_FacesAtVertexByCoedgesWork(_: WorkClaim): WorkClaim
        => WorkClaim("FacesAtVertexByCoedges: faces and coedges visited per coedge", Insertions(2), [6, 24], n => FacesAtVertexWorkAt(n));

    // The family's sizes are its members' coedge counts.
    Law_CoedgeFamilySizes(_: Defect): Boolean
        => [6, 24].All(n => n.CoedgeFamilyModel.CoedgeCount == n);
}

//==
// # Repair diagnosis over one index (complexity sweep, chunk L8)
//
// Ranked candidate 41 of docs/plans/step-mesher-complexity.md, layer 11. FacesAtVertex and
// FacesOnCurve test every edge for every face, O(F E) per call; CostOf computes FacesTouchedBy
// twice; and PlanOf diagnoses each defect against the whole model: IsInClosedShell re-checks
// every shell per seam defect, FreeEdge's UseCount rebuilds a shell's coedge sites per shell per
// defect, and FixedBy's FacesAtVertex, FacesOnCurve, FacesOnSurface and FacesOfLoop scan the
// model per defect. Here the two scans become one pass over the faces' own coedges, CostOfBound
// asks once, and PlanOfIndexed builds one RepairIndex per plan and answers every defect from it.
// Each function returns what its namesake returns, for every input; an index out of a table's
// range that a row cannot answer (a negative one) falls back to the namesake's scan, counted.
//
// Sections, in order:
//  - Faces at a vertex and on a curve
//  - Face rows
//  - The repair index
//  - Faces an action touches
//  - Cost
//  - Diagnosis and plans

library BrepRepairIndexed
{
    //==
    // # Faces at a vertex and on a curve

    // FacesAtVertex with its work counted: one mark per edge with v as an end, then one pass over
    // every face's coedges (FacesCitingCounted). Insertions counts the faces and coedges visited,
    // F + C, where FacesAtVertex visits every edge for every face.
    FacesAtVertexByCoedgesCounted(m: BrepModel, v: BrepVertexIndex): Counted<Array<BrepFaceIndex>>
        => m.FacesCitingCounted(
            m.Edges.Count.MapRange(e => m.Edges[e].Start == v || m.Edges[e].End == v),
            [false].Take(0), [0].Take(0));

    // The faces that use an edge with v as an end: FacesAtVertex in O(E + F + C).
    FacesAtVertexByCoedges(m: BrepModel, v: BrepVertexIndex): Array<BrepFaceIndex>
        => m.FacesAtVertexByCoedgesCounted(v).Value;

    // The faces that use an edge on curve c: FacesOnCurve in O(E + F + C).
    FacesOnCurveByCoedges(m: BrepModel, c: CurveIndex): Array<BrepFaceIndex>
        => m.FacesCitingCounted(m.Edges.Count.MapRange(e => m.Edges[e].Curve == c), [false].Take(0), [0].Take(0)).Value;

    //==
    // # Face rows

    // The face rows of the given (key, face) pairs: a counting sort by key, stable, so each row
    // keeps the order of the pairs. Negative keys are in no row. O(K + P) for largest key K and
    // P pairs.
    FaceRowsOf(keys: Array<Integer>, faces: Array<Integer>): FaceRows
    {
        var rowCount = keys.Reduce(0, (n, k) => k + 1 > n ? k + 1 : n);
        var offsets = new Buffer<Integer>(rowCount + 1);
        var r = 0;
        while (r <= rowCount)
        {
            offsets = offsets.Set(r, 0);
            r = r + 1;
        }
        var p = 0;
        while (p < keys.Count)
        {
            if (keys[p] >= 0)
            {
                offsets = offsets.Set(keys[p] + 1, offsets.At(keys[p] + 1) + 1);
            }
            p = p + 1;
        }
        var s = 0;
        while (s < rowCount)
        {
            offsets = offsets.Set(s + 1, offsets.At(s + 1) + offsets.At(s));
            s = s + 1;
        }
        var starts = offsets.Freeze();
        var cursor = new Buffer<Integer>(rowCount.Max(1));
        var j = 0;
        while (j < rowCount)
        {
            cursor = cursor.Set(j, starts[j]);
            j = j + 1;
        }
        var total = starts[rowCount];
        var items = new Buffer<Integer>(total.Max(1));
        var q = 0;
        while (q < keys.Count)
        {
            if (keys[q] >= 0)
            {
                items = items.Set(cursor.At(keys[q]), faces[q]);
                cursor = cursor.Set(keys[q], cursor.At(keys[q]) + 1);
            }
            q = q + 1;
        }
        var values = items.Freeze();
        return FaceRows(starts, total.MapRange(k => BrepFaceIndex(values[k])));
    }

    // The distinct faces of row k, in increasing order; none when k names no row (a key larger
    // than every key given). Precondition: k >= 0. O(n log n) for a row of n.
    DistinctFacesIn(r: FaceRows, k: Integer): Array<BrepFaceIndex>
    {
        var n = k < r.Offsets.Count - 1 ? r.Offsets[k + 1] - r.Offsets[k] : 0;
        var sorted = n.MapRange(i => r.Faces[r.Offsets[k] + i]).Sort((a, b) => a.Value <= b.Value);
        return sorted.Count.Range.FlatMap(i =>
            (i == 0 ? true : sorted[i - 1].Value != sorted[i].Value) ? [sorted[i]] : sorted.Take(0));
    }

    //==
    // # The repair index

    // The number of whole-model passes RepairIndexCounted makes: IsEveryIndexInRange, the
    // edge-to-face table, the shells' edge-use tables (one pass over all shells' coedges), the
    // closed flags and their face marks, the vertex and curve rows (one pass over the edge-to-face
    // table), the surface and loop rows (one pass over the faces' bounds), and the list of faces.
    RepairIndexPasses(_: RepairIndex): Integer
        => 7;

    // Whether edge e counts as an edge of the reduced complex (layer 2's CountsAsEdge) given
    // ok = m.IsEveryIndexInRange.
    CountsAsEdgeGiven(m: BrepModel, ok: Boolean, e: BrepEdgeIndex): Boolean
        => ok ? m.IsDegenerateEdge(e).Not : true;

    // Layer 8's IsClosedShell(m, s) given ok = m.IsEveryIndexInRange and t = m.EdgeUseTable(s):
    // declared closed, no free counted edge, and every edge the shell cites used zero or two
    // times (when it counts) with its uses running opposite. Precondition: m.IsShellInRange(s).
    IsClosedShellIndexed(m: BrepModel, s: ShellIndex, ok: Boolean, t: EdgeUseTable): Boolean
    {
        var edges = t.EdgesOfShellByUse;
        var free = edges.Reduce(0, (n, e) => (t.UseCountIn(e) == 1 ? m.CountsAsEdgeGiven(ok, e) : false) ? n + 1 : n);
        return m.Shells[s].DeclaredClosed
            ? (free == 0
                ? edges.All(e => (m.CountsAsEdgeGiven(ok, e) ? t.UseCountIn(e).IsZeroOrTwo : true)
                    && m.UsesRunOpposite(t.UsesOfEdgeIn(e)))
                : false)
            : false;
    }

    // The repair index of m, its work counted: Flips is RepairIndexPasses, the whole-model passes
    // that build it. O(V + E + F + C + S) plus one IsDegenerateEdge per edge of each shell.
    RepairIndexCounted(m: BrepModel): Counted<RepairIndex>
    {
        var ok = m.IsEveryIndexInRange;
        var edgeFaces = m.EdgeFaceTable;
        var shellUses = m.Shells.Count.MapRange(s => m.EdgeUseTable(ShellIndex(s)));
        var closed = m.Shells.Count.MapRange(s => m.IsClosedShellIndexed(ShellIndex(s), ok, shellUses[s]));
        var closedFaces = RowMarks(m.Faces.Count,
            m.Shells.Count.Range.FlatMap(s => closed[s] ? m.ShellFaces(ShellIndex(s)).IndexValues : 0.MapRange(k => k)));
        var vertexKeys = new List<Integer>();
        var vertexFaces = new List<Integer>();
        var curveKeys = new List<Integer>();
        var curveFaces = new List<Integer>();
        var e = 0;
        while (e < m.Edges.Count)
        {
            var faces = edgeFaces.FacesOfEdgeIn(BrepEdgeIndex(e));
            var k = 0;
            while (k < faces.Count)
            {
                vertexKeys = vertexKeys.Add(m.Edges[e].Start.Value);
                vertexFaces = vertexFaces.Add(faces[k].Value);
                vertexKeys = vertexKeys.Add(m.Edges[e].End.Value);
                vertexFaces = vertexFaces.Add(faces[k].Value);
                curveKeys = curveKeys.Add(m.Edges[e].Curve.Value);
                curveFaces = curveFaces.Add(faces[k].Value);
                k = k + 1;
            }
            e = e + 1;
        }
        var surfaceKeys = new List<Integer>();
        var surfaceFaces = new List<Integer>();
        var loopKeys = new List<Integer>();
        var loopFaces = new List<Integer>();
        var f = 0;
        while (f < m.Faces.Count)
        {
            surfaceKeys = surfaceKeys.Add(m.Faces[f].Surface.Value);
            surfaceFaces = surfaceFaces.Add(f);
            var bounds = m.Faces[f].Bounds;
            var b = 0;
            while (b < bounds.Count)
            {
                loopKeys = loopKeys.Add(bounds[b].Loop.Value);
                loopFaces = loopFaces.Add(f);
                b = b + 1;
            }
            f = f + 1;
        }
        var index = RepairIndex(
            closedFaces,
            shellUses,
            edgeFaces,
            FaceRowsOf(vertexKeys.Freeze(), vertexFaces.Freeze()),
            FaceRowsOf(curveKeys.Freeze(), curveFaces.Freeze()),
            FaceRowsOf(surfaceKeys.Freeze(), surfaceFaces.Freeze()),
            FaceRowsOf(loopKeys.Freeze(), loopFaces.Freeze()),
            m.Faces.Count.MapRange(i => BrepFaceIndex(i)));
        return Counted(index, Flips(index.RepairIndexPasses));
    }

    // The repair index of m.
    RepairIndexOf(m: BrepModel): RepairIndex
        => m.RepairIndexCounted.Value;

    // IsInClosedShell(m, f) read from the index: false for a face out of range.
    IsInClosedShellIn(ix: RepairIndex, f: BrepFaceIndex): Boolean
        => (f.Value >= 0 && f.Value < ix.ClosedShellFaces.Count) ? ix.ClosedShellFaces[f.Value] : false;

    // UseCount(m, s, e) read from shell s's edge-use table for an edge in range; the scan for an
    // edge out of range, which a coedge may still cite. Precondition: m.IsShellInRange(s).
    UseCountIndexed(m: BrepModel, ix: RepairIndex, s: ShellIndex, e: BrepEdgeIndex): Integer
        => m.IsEdgeInRange(e) ? ix.ShellUses[s.Value].UseCountIn(e) : m.UseCount(s, e);

    //==
    // # Faces an action touches
    //
    // Each is its BrepRepairDiagnosis or BrepEditingClosure namesake read from the index, with
    // Flips(1) when it falls back to the namesake's whole-model scan and Flips(0) otherwise.

    // FacesAtVertex(m, v).
    FacesAtVertexIndexed(m: BrepModel, ix: RepairIndex, v: BrepVertexIndex): Counted<Array<BrepFaceIndex>>
        => v.Value >= 0
            ? Counted(ix.VertexFaces.DistinctFacesIn(v.Value), Flips(0))
            : Counted(m.FacesAtVertexByCoedges(v), Flips(1));

    // FacesOnCurve(m, c).
    FacesOnCurveIndexed(m: BrepModel, ix: RepairIndex, c: CurveIndex): Counted<Array<BrepFaceIndex>>
        => c.Value >= 0
            ? Counted(ix.CurveFaces.DistinctFacesIn(c.Value), Flips(0))
            : Counted(m.FacesOnCurveByCoedges(c), Flips(1));

    // FacesOnSurface(m, s).
    FacesOnSurfaceIndexed(m: BrepModel, ix: RepairIndex, s: SurfaceIndex): Counted<Array<BrepFaceIndex>>
        => s.Value >= 0
            ? Counted(ix.SurfaceFaces.DistinctFacesIn(s.Value), Flips(0))
            : Counted(m.FacesOnSurface(s), Flips(1));

    // FacesOfLoop(m, l).
    FacesOfLoopIndexed(m: BrepModel, ix: RepairIndex, l: BrepLoopIndex): Counted<Array<BrepFaceIndex>>
        => l.Value >= 0
            ? Counted(ix.LoopFaces.DistinctFacesIn(l.Value), Flips(0))
            : Counted(m.FacesOfLoop(l), Flips(1));

    // FacesOfEdge(m, e).
    FacesOfEdgeIndexed(m: BrepModel, ix: RepairIndex, e: BrepEdgeIndex): Counted<Array<BrepFaceIndex>>
        => m.IsEdgeInRange(e)
            ? Counted(ix.EdgeFaces.FacesOfEdgeIn(e), Flips(0))
            : Counted(m.FacesOfEdge(e), Flips(1));

    // FacesOfPcurve(m, p).
    FacesOfPcurveIndexed(m: BrepModel, ix: RepairIndex, p: PcurveIndex): Counted<Array<BrepFaceIndex>>
        => m.Geometry.Pcurves.IsValidIndex(p.Value)
            ? m.FacesOnSurfaceIndexed(ix, m.Geometry.Pcurves[p].Surface)
            : Counted(BrepFaceIndex.NoFaceIndices, Flips(0));

    // Faces that need no table: one face or a shell's.
    Untabled(faces: Array<BrepFaceIndex>): Counted<Array<BrepFaceIndex>>
        => Counted(faces, Flips(0));

    // FacesTouchedBy(m, a), read from the index.
    FacesTouchedByIndexedCounted(m: BrepModel, ix: RepairIndex, a: RepairAction): Counted<Array<BrepFaceIndex>>
        => match (a) {
            MergeVertices(keep, drop) => m.FacesAtVertexIndexed(ix, drop);
            SnapVertexToCurve(v, e) => m.FacesAtVertexIndexed(ix, v);
            ExtendEdgeToVertex(e, end) => m.FacesOfEdgeIndexed(ix, e);
            AddPcurveByProjection(e, f) => Untabled(m.OneFace(f));
            ReplacePcurve(p, with) => m.FacesOfPcurveIndexed(ix, p);
            CloseLoopByBridge(f, b, gap) => Untabled(m.OneFace(f));
            ReverseFace(f) => Untabled(m.OneFace(f));
            ReverseLoop(l) => m.FacesOfLoopIndexed(ix, l);
            FlipShell(s) => Untabled(m.ShellFaces(s));
            DropEdge(e) => m.FacesOfEdgeIndexed(ix, e);
            DropBound(f, b) => Untabled(m.OneFace(f));
            PromoteToOuter(f, b) => Untabled(m.OneFace(f));
            ClampTrim(s) => m.FacesOnSurfaceIndexed(ix, s);
            CutKnotMultiplicity(c, at) => m.FacesOnCurveIndexed(ix, c);
            SortKnots(c) => m.FacesOnCurveIndexed(ix, c);
            RaiseTolerance(t) => Untabled(ix.AllFaces);
            SplitSeamEdge(f, e) => Untabled(m.OneFace(f));
            InsertSeam(f, dir) => Untabled(m.OneFace(f));
            InsertPoleLoop(f, side) => Untabled(m.OneFace(f));
            DeclareOpen(s) => Untabled(m.ShellFaces(s));
            SkipInstance(i) => Untabled(BrepFaceIndex.NoFaceIndices);
        };

    //==
    // # Cost

    // What action a costs on m, given the faces it touches.
    CostOfFaces(m: BrepModel, a: RepairAction, faces: Array<BrepFaceIndex>): RepairCost
        => RepairCost(CountOf(faces.Count), m.ToleranceGrowthOf(a), LocalityOf(a, faces));

    // CostOf(m, a) with FacesTouchedBy computed once.
    CostOfBound(m: BrepModel, a: RepairAction): RepairCost
        => m.CostOfFaces(a, m.FacesTouchedBy(a));

    // CostOf(m, a) read from the index.
    CostOfIndexed(m: BrepModel, ix: RepairIndex, a: RepairAction): RepairCost
        => m.CostOfFaces(a, m.FacesTouchedByIndexedCounted(ix, a).Value);

    //==
    // # Diagnosis and plans

    // FixedBy(m, a) read from the index.
    FixedByIndexedCounted(m: BrepModel, ix: RepairIndex, a: RepairAction): Counted<Fixability>
    {
        var faces = m.FacesTouchedByIndexedCounted(ix, a);
        return Counted(Fixability.Fixable(a, m.CostOfFaces(a, faces.Value)), faces.Work);
    }

    // A diagnosis that reads nothing from the model.
    Unread(x: Fixability): Counted<Fixability>
        => Counted(x, Flips(0));

    // Diagnose(m, FreeEdge(e)) read from the index: declare open each shell that cites e, or
    // drop e. Flips(1) for an edge out of range, whose use counts are scanned per shell.
    FreeEdgeChoiceIndexed(m: BrepModel, ix: RepairIndex, e: BrepEdgeIndex): Counted<Fixability>
        => Counted(Fixability.FixableWithChoice(
                m.Shells.Count.Range
                    .FlatMap(s => [RepairAction.DeclareOpen(ShellIndex(s))].Take(m.UseCountIndexed(ix, ShellIndex(s), e) > 0 ? 1 : 0))
                    .Concatenate([RepairAction.DropEdge(e)])),
            Flips(m.IsEdgeInRange(e) ? 0 : 1));

    // Diagnose(m, d) read from the index, with the whole-model scans it fell back to as Flips.
    DiagnoseIndexedCounted(m: BrepModel, ix: RepairIndex, d: Defect): Counted<Fixability>
        => match (d) {
            FreeEdge(e) => m.FreeEdgeChoiceIndexed(ix, e);
            EdgeUsedThrice(e, n) => m.FixedByIndexedCounted(ix, RepairAction.DropEdge(e));
            GapAtVertex(e, end, gap) => m.FixedByIndexedCounted(ix, RepairAction.ExtendEdgeToVertex(e, end));
            VertexOffCurve(v, e, dist) => m.FixedByIndexedCounted(ix, RepairAction.SnapVertexToCurve(v, e));
            EdgeOffSurface(e, f, dist) => Unread(Fixability.FixableWithChoice([
                RepairAction.AddPcurveByProjection(e, f),
                RepairAction.RaiseTolerance(m.RaisedLength(dist.Value))]));
            MissingPcurve(e, f) => m.FixedByIndexedCounted(ix, RepairAction.AddPcurveByProjection(e, f));
            PcurveOffCurve(p, gap) => m.FixedByIndexedCounted(ix, RepairAction.RaiseTolerance(m.RaisedLength(gap.Value)));
            LoopNotChained(l, s) => m.FixedByIndexedCounted(ix, RepairAction.ReverseLoop(l));
            LoopOpenInUv(f, b, gap) => m.FixedByIndexedCounted(ix, RepairAction.CloseLoopByBridge(f, b, gap));
            LoopSelfIntersects(f, b, i, j) => m.FixedByIndexedCounted(ix, RepairAction.DropBound(f, b));
            SeamRunsSameWay(f, e) => ix.IsInClosedShellIn(f)
                ? Unread(Fixability.Unfixable("A seam whose uses run one way cannot be repaired locally on a closed shell."))
                : m.FixedByIndexedCounted(ix, RepairAction.SplitSeamEdge(f, e));
            MisorientedFace(f) => m.FixedByIndexedCounted(ix, RepairAction.ReverseFace(f));
            NotOrientable(s) => Unread(Fixability.Unfixable("No choice of face senses makes the shell coherently oriented."));
            DegenerateEdge(e) => m.FixedByIndexedCounted(ix, RepairAction.DropEdge(e));
            DuplicateVertex(a, b, dist) => m.FixedByIndexedCounted(ix, RepairAction.MergeVertices(a, b));
            RedundantVertexLoop(f, b) => m.FixedByIndexedCounted(ix, RepairAction.DropBound(f, b));
            NoOuterBound(f) => Unread(PromoteOneOf(f, m.BoundSlotsWhere(f, x => true)));
            TwoOuterBounds(f) => Unread(PromoteOneOf(f, m.BoundSlotsWhere(f, x => x.IsOuter)));
            TrimOutsideDomain(s, x) => m.FixedByIndexedCounted(ix, RepairAction.ClampTrim(s));
            KnotMultiplicityTooHigh(c, at) => m.FixedByIndexedCounted(ix, RepairAction.CutKnotMultiplicity(c, at));
            KnotsNotNonDecreasing(c, at) => m.FixedByIndexedCounted(ix, RepairAction.SortKnots(c));
            ZeroLengthDirection(i) => m.FixedByIndexedCounted(ix, RepairAction.SkipInstance(i));
            NonOrthonormalPlacement(s, dev) => m.FixedByIndexedCounted(ix, RepairAction.RaiseTolerance(m.RaisedAngle(dev)));
            ToleranceBelowResolution(t, r) => m.FixedByIndexedCounted(ix, RepairAction.RaiseTolerance(m.RaisedLength(r.Value)));
            DeclaredClosedButOpen(s, n) => m.FixedByIndexedCounted(ix, RepairAction.DeclareOpen(s));
            ShellDisconnected(s, n) => Unread(Fixability.Unfixable("No repair action splits a shell into its components."));
            Unclassified(law, w) => Unread(Fixability.Unfixable("No defect family is known for this law."));
        };

    // Diagnose(m, d) read from the index.
    DiagnoseIndexed(m: BrepModel, ix: RepairIndex, d: Defect): Fixability
        => m.DiagnoseIndexedCounted(ix, d).Value;

    // PlanOf(m, defects) with one repair index for the plan, its work counted: Flips is the
    // index's passes plus the fallback scans of the defects, so a constant per plan for defects
    // whose indices are not negative, whatever their number.
    PlanOfIndexedCounted(m: BrepModel, defects: Array<Defect>): Counted<RepairPlan>
    {
        var built = m.RepairIndexCounted;
        var ix = built.Value;
        var diagnoses = defects.Map(d => m.DiagnoseIndexedCounted(ix, d));
        var steps = defects.Count.Range.FlatMap(i =>
            FirstActionOf(diagnoses[i].Value).Map(a => RepairStep(defects[i], a, ExpectedLawOf(defects[i]))));
        return Counted(
            RepairPlan(steps.Sort((x, y) => ClassRank(ClassOf(x.Defect)) <= ClassRank(ClassOf(y.Defect)))),
            diagnoses.Reduce(built.Work, (w, c) => w.Add(c.Work)));
    }

    // PlanOf(m, defects) with one repair index for the plan.
    PlanOfIndexed(m: BrepModel, defects: Array<Defect>): RepairPlan
        => m.PlanOfIndexedCounted(defects).Value;
}

//==
// # Tooling: invariants and constructors of the report types
//
// SPEC-DSL.md section 3. Not compiled; each invariant cites the law in
// tooling-reports.laws.plato that checks it.

spec VerdictDelta
{
    constructor VerdictDeltaOf;
}

spec IsChange(d: VerdictDelta): Boolean
{
    ensures result == (d.Before.VerdictOrdinal != d.After.VerdictOrdinal);   // Law_VerdictDeltaChangesOnlyWhenVerdictsDiffer
}

spec Diff(a: BrepModel, b: BrepModel, tol: Tolerances): ModelDiff
{
    ensures a == b ? result == ModelDiff.Same : true;   // Law_SameModelHasNoDifference
}

spec DiffSummaryOf(differences: Array<LocatedDifference<ModelTable>>): DiffSummary
{
    requires differences.Count > 0;
    ensures result.Count == differences.Count;
    ensures result.ByTable.Count == ModelTable.ModelTableCount;
}

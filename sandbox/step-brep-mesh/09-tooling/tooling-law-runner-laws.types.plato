//==
// # Law runner witnesses meshed once: agreement pairs (complexity sweep, chunk L7)
//
// Pairs the agreement laws of ToolingLawRunnerOnceLaws compare, each built once per sweep as a
// Witness_* so the law itself stays under the 2 s compiled budget.

// One model witness checked once (CheckedWitnessOf) and checked the way the runner did before,
// every part computed on its own (CheckedWitnessSeparately).
type CheckedWitnessPair
{
    Once: CheckedWitness;
    Separately: CheckedWitness;
}

// One run dumped by DumpStages and by DumpStagesOnce.
type StageDumpPair
{
    Replayed: StageDump;
    Once: StageDump;
}

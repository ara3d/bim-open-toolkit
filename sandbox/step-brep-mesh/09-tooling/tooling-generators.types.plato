//==
// # Tooling: generator types
//
// Layer 9 of the STEP B-rep to mesh design (README.md beside this file): the
// parameter spaces the generators sample and the perturbations they apply.
// Plato has no generic sums, so there is no Generator<T>: each of layer 7's
// parameterized witness families gets a record of parameter ranges, and a
// sample is a pure function of the family, a seed and an index
// (tooling-generators.library.plato). Ranges are stdlib NumberIntervals
// sampled by lerp; a range with Start == End is a fixed value. Parameters
// that must stay below another (a torus's minor radius, a hole, a void) are
// drawn as a ratio of it, so every sample of a family with ratio ranges
// inside (0, 1) is a valid witness.
//
// Sections, in order:
//  - Witness families
//  - Perturbations

//==
// # Witness families

// Witness_Box(w, d, h): the three side lengths.
type BoxFamily
{
    Width: NumberInterval;
    Depth: NumberInterval;
    Height: NumberInterval;
}

// Witness_Cylinder(r, h, sweep). A sweep of exactly a turn gives the seamed
// cylinder, a smaller one a sector; a range [tau, tau] samples only the
// seamed form. The sampler clamps the sweep to at most a turn.
type CylinderFamily
{
    Radius: NumberInterval;
    Height: NumberInterval;
    Sweep: AngleInterval;
}

// One radius: Witness_Sphere(r), Witness_SphereByPoleLoops(r), and the
// negative Witness_SphereWithRedundantPoleLoops(r), told apart by Form.
type SphereFamily
{
    Radius: NumberInterval;
    Form: SphereForm;
}

// The three sphere witnesses of layer 7.
type SphereForm
    = SeamedSphere
    | PoleLoopSphere
    | RedundantPoleLoopSphere;

// Witness_Torus(major, minor), minor = major * MinorRatio; a ratio in
// (0, 1) keeps the torus a ring.
type TorusFamily
{
    Major: NumberInterval;
    MinorRatio: NumberInterval;
}

// Witness_Cone(r, h).
type ConeFamily
{
    Radius: NumberInterval;
    Height: NumberInterval;
}

// Witness_BlockWithThroughHole(a, c, w), w = a * HoleRatio; a ratio in
// (0, 1) keeps the hole inside the block.
type BlockWithHoleFamily
{
    Side: NumberInterval;
    Thickness: NumberInterval;
    HoleRatio: NumberInterval;
}

// Witness_HollowBox(a, b), b = a * VoidRatio; a ratio in (0, 1) keeps the
// void inside the cube.
type HollowBoxFamily
{
    Side: NumberInterval;
    VoidRatio: NumberInterval;
}

// Witness_BSplinePatchSolid(bump).
type BSplinePatchFamily
{
    Bump: NumberInterval;
}

// The witnesses of layer 7 that take no parameter. Their samples vary
// through a perturbation drawn from the seed and index.
type FixedWitness
    = FlippedFaceBox
    | TwoBoxesSharingCorner
    | PolyLoopSheetBox;

// Any family, so one function samples them all and one Integer selects one.
type WitnessFamily
    = Box(Family: BoxFamily)
    | Cylinder(Family: CylinderFamily)
    | Sphere(Family: SphereFamily)
    | Torus(Family: TorusFamily)
    | Cone(Family: ConeFamily)
    | BlockWithHole(Family: BlockWithHoleFamily)
    | HollowBox(Family: HollowBoxFamily)
    | BSplinePatch(Family: BSplinePatchFamily)
    | Fixed(Witness: FixedWitness);

//==
// # Perturbations

// A change to a model whose effect is known in advance
// (tooling-generators.laws.plato states what each keeps). RigidMotion:
// layer 2's RigidlyMoved by Frame (orthonormal, right-handed). Scale:
// layer 2's ScaledBy by 2^Exponent, exact in IEEE arithmetic. Jitter: every
// vertex moved by at most Fraction times the model's length tolerance, in a
// direction drawn from Seed; curves and surfaces stay, so the vertices sit
// off their curves by up to the tolerance the file allows. FaceReversal:
// one face's SameSense and bounds flipped (an orientation defect, so a
// negative case). EdgeReversal: layer 2's WithEdgeReversed. EveryFaceReversal:
// every face flipped, the solid seen from outside in.
type Perturbation
    = RigidMotion(Frame: Frame3D)
    | Scale(Exponent: Integer)
    | Jitter(Seed: Integer, Fraction: Number)
    | FaceReversal(Face: BrepFaceIndex)
    | EdgeReversal(Edge: BrepEdgeIndex)
    | EveryFaceReversal;

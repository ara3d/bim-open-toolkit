//==
// # Tooling: dump types
//
// Layer 9 of the STEP B-rep to mesh design (README.md beside this file): what
// is handed to the host to write as a file a person looks at. Every value
// here is the result of a pure Plato conversion; the host shims of
// tooling-dumps.library.plato only serialize it. Three targets, all read by
// tools the toolkit already has: glTF binary and OBJ for the 3D pane
// (deps/bim-open-viewer reads GLB with three's GLTFLoader and colours each
// mesh by its material, not by vertex colour, so each model face is its own
// mesh with its own material), SVG for a face's parameter plane, CSV for a
// table the notebook shows.
//
// Sections, in order:
//  - Meshes for the 3D pane
//  - Parameter-plane drawings
//  - Every stage of one run

//==
// # Meshes for the 3D pane

// A mesh vertex's provenance as four numbers, the glTF vertex attribute
// _PROVENANCE (VEC4, float): Kind 0 on a model vertex, 1 on an edge, 2 on a
// face; Index the vertex, edge or face index; First and Second the edge
// parameter (and 0) or the face's (u, v), and 0 and 0 on a vertex.
type ProvenanceCode
{
    Kind: Integer;
    Index: Integer;
    First: Number;
    Second: Number;
}

// The elements of one model face as a triangle soup: corner 3j, 3j + 1,
// 3j + 2 is triangle j (a quad gives two, split A-C as layer 6 realizes
// it). Per corner: Positions; Normals (empty when the mesh has no corner
// normals); Vertices, the mesh vertex the corner is (glTF attribute
// _VERTEX); Provenance (glTF attribute _PROVENANCE). Colour is the face's
// material colour, from the face index alone, so a face keeps its colour
// across runs.
type FacePart
{
    Face: BrepFaceIndex;
    Colour: Color;
    Positions: Array<Point3D>;
    Normals: Array<Vector3D>;
    Vertices: Array<VertexIndex>;
    Provenance: Array<ProvenanceCode>;
}

// A mesh as one part per model face, in face order; faces with no element
// have no part.
type MeshDump
{
    Parts: Array<FacePart>;
}

//==
// # Parameter-plane drawings

// One mark of a drawing, in the drawing's coordinates (u to the right, v
// down, as UvCoordinate and SVG both read them). Trace: a polyline, closed
// or open. Dot: a disc at a point. Label: an integer written at a point
// (Plato cannot compose strings, so the host prints the number).
type SvgMark
    = Trace(Points: Array<Point2D>, Closed: Boolean)
    | Dot(At: Point2D)
    | Label(At: Point2D, Value: Integer);

// Marks drawn with one style: stroke and fill colours (alpha 0 for none),
// the stroke width in drawing units (a dot's radius is three widths, a
// label's height ten). Name becomes the SVG group's id.
type SvgLayer
{
    Name: String;
    Stroke: Color;
    Fill: Color;
    Width: Number;
    Marks: Array<SvgMark>;
}

// A drawing: the region of the plane shown and the layers, drawn in order.
// The host writes an SVG whose viewBox is View, scaled to 800 pixels wide.
type SvgDocument
{
    View: Bounds2D;
    Layers: Array<SvgLayer>;
}

//==
// # Every stage of one run

// Every stage of MeshModel for one model and one set of options, as the
// pipeline itself computes them: the loop's states from round 0 to the
// final round (States[k] is layer 8's StateAfter k), each face's
// parameter-plane region over the final discretizations, and the outcome.
// States and Regions are empty when the run is refused.
type StageDump
{
    Model: BrepModel;
    Options: MeshingOptions;
    States: Array<PipelineState>;
    Regions: Array<UvRegion>;
    Outcome: MeshOutcome;
}

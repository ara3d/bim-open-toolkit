//==
// # Tooling: witness specs, verdicts, benchmarks, and model diffs (functions)
//
// The constructors and predicates of tooling-witness-specs.types.plato and
// tooling-reports.types.plato, and BrepModel's IDiffable and IWitnessed
// functions (moved from catalog-validation at the catalog merge, validation,
// 2026-10-20).
//
// Sections, in order:
//  - Witnesses and perturbations
//  - Verdicts
//  - Benchmarks
//  - Diffing a model

library ToolingReports
{
    //==
    // # Witnesses and perturbations

    // The specs of the default witness families, seed 0, no drawn
    // parameters: what BrepModel names for IWitnessed.
    Witnesses(_: BrepModel): Array<WitnessSpec>
        => WitnessFamily.DefaultFamilies.Map(f => WitnessSpec(f, 0, 0.MapRange(i => 0.0)));

    // The law that states what a perturbation keeps
    // (tooling-generators.laws.plato): a motion, a scale and a jitter each
    // their own, every reversal its involution law.
    InvarianceOf(p: Perturbation): LawName
        => match (p) {
            RigidMotion(frame) => LawName("Law_MotionKeepsTopologyRows");
            Scale(k) => LawName("Law_PerturbedShellVolumeFollowsFactor");
            Jitter(seed, fraction) => LawName("Law_JitterStaysWithinLengthTolerance");
            FaceReversal(f) => LawName("Law_ReversalIsAnInvolution");
            EdgeReversal(e) => LawName("Law_ReversalIsAnInvolution");
            EveryFaceReversal => LawName("Law_ReversalIsAnInvolution");
        };

    //==
    // # Verdicts

    // The case of a verdict as an ordinal, in declaration order: what a
    // verdict delta compares (payloads are evidence, not the verdict).
    VerdictOrdinal(v: LawVerdict): Integer
        => match (v) {
            Held => 0;
            Failed => 1;
            FailedAsExpected => 2;
            HeldUnexpectedly => 3;
            Skipped(reason) => 4;
            Error(message) => 5;
            Obligation => 6;
            OverBudget(elapsed) => 7;
        };

    // True when a verdict is what the witness was built for: Held for
    // ShouldPass and ShouldWarn (a warning is not a failure), Failed or
    // FailedAsExpected for ShouldFail. Every other verdict meets nothing.
    IsMet(x: Expectation, v: LawVerdict): Boolean
        => match (x) {
            ShouldPass => v.VerdictOrdinal == 0;
            ShouldFail(law) => v.VerdictOrdinal == 1 || v.VerdictOrdinal == 2;
            ShouldWarn(code) => v.VerdictOrdinal == 0;
        };

    // One law's verdicts in two sweeps.
    VerdictDeltaOf(law: LawName, before: LawVerdict, after: LawVerdict): VerdictDelta
        => VerdictDelta(law, before, after);

    // True when the verdict changed between the sweeps: a different case.
    IsChange(d: VerdictDelta): Boolean
        => d.Before.VerdictOrdinal != d.After.VerdictOrdinal;

    //==
    // # Benchmarks

    // True when a measured value matches a recorded benchmark of the same
    // kind within the allowance.
    MeetsBenchmark(measured: Measure, b: Benchmark, allowance: Allowance): Boolean
        => measured.Kind == b.Recorded.Kind
            ? IsWithin(Measure((measured.Value - b.Recorded.Value).Abs, measured.Kind), allowance.Value)
            : false;

    //==
    // # Diffing a model

    // Two models compared table by table under the model's length tolerance:
    // BrepModel's IDiffable function.
    Diff(a: BrepModel, b: BrepModel, tol: Tolerances): ModelDiff
        => DiffModelsWithin(a, b, tol.Length.Value);

    // The position of a table in ModelTable's case order.
    ModelTableOrdinal(t: ModelTable): Integer
        => match (t) {
            CurveRows => 0;
            Curve2DRows => 1;
            PcurveRows => 2;
            SurfaceRows => 3;
            ClosureRows => 4;
            VertexRows => 5;
            EdgeRows => 6;
            LoopRows => 7;
            FaceRows => 8;
            ShellRows => 9;
            BodyRows => 10;
            ToleranceRow => 11;
            UnitRow => 12;
        };

    // The number of ModelTable cases.
    ModelTableCount(_: ModelTable): Integer
        => 13;

    // The summary of a non-empty list of differences: the first, the count,
    // and a count per table in ModelTable order.
    DiffSummaryOf(differences: Array<LocatedDifference<ModelTable>>): DiffSummary
        => DiffSummary(ModelDiffOf(differences), differences.Count,
            ModelTable.ModelTableCount.MapRange(k =>
                CountOf(differences.Map(d => d.Table.ModelTableOrdinal == k ? 1 : 0).Reduce(0, (a, x) => a + x))));
}

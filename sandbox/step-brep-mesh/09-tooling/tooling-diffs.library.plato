//==
// # ToolingDiffs
//
// Layer 9 of the STEP B-rep to mesh design (README.md beside this file): one
// diff per compared type. Each XDifferences function returns every
// difference in table, row, slot, field order; each DiffX wraps the array
// into the diff sum (Same, or the first difference and the count). The
// exact forms compare with tolerance 0.0 and are what the laws of
// tooling-diffs.laws.plato tie to the lower layers' Boolean equalities; the
// Within forms take an absolute tolerance for coordinates, parameters and
// normals, for comparing a result with an expected value computed another
// way. Sum-typed fields (curves, surfaces, provenances) are compared with ==
// at every tolerance and printed by their case names.
//
// Sections, in order:
//  - Models
//  - Discretizations
//  - Meshes
//  - Reports
//  - Files
//  - Diff sums

library ToolingDiffs
{
    //==
    // # Models

    // Every difference between two models: the geometry arena (curves,
    // parameter-plane curves, pcurves, surfaces, closures), then vertices,
    // edges, loops, faces, shells, bodies, tolerances, unit. Coordinates of
    // vertices and poly loops and the four tolerances compare within tol.
    ModelDifferences(a: BrepModel, b: BrepModel, tol: Number): Array<LocatedDifference<ModelTable>>
        => Flattened([
            FieldRowDifferences(a.Geometry.Curves, b.Geometry.Curves,
                (x, y) => CompareCase(x == y, x.CurveCaseName, y.CurveCaseName)).InTable(ModelTable.CurveRows),
            FieldRowDifferences(a.Geometry.Curves2D, b.Geometry.Curves2D,
                (x, y) => CompareCase(x == y, x.Curve2DCaseName, y.Curve2DCaseName)).InTable(ModelTable.Curve2DRows),
            FieldRowDifferences(a.Geometry.Pcurves, b.Geometry.Pcurves,
                (x, y) => Flattened([CompareWhole("Surface", x.Surface.Value, y.Surface.Value),
                    CompareWhole("Curve", x.Curve.Value, y.Curve.Value)])).InTable(ModelTable.PcurveRows),
            FieldRowDifferences(a.Geometry.Surfaces, b.Geometry.Surfaces,
                (x, y) => CompareCase(x == y, x.SurfaceCaseName, y.SurfaceCaseName)).InTable(ModelTable.SurfaceRows),
            FieldRowDifferences(a.Geometry.Closures, b.Geometry.Closures,
                (x, y) => CompareCase(x == y, x.ClosureCaseName, y.ClosureCaseName)).InTable(ModelTable.ClosureRows),
            FieldRowDifferences(a.Vertices, b.Vertices,
                (x, y) => ComparePoint(x.Point, y.Point, tol)).InTable(ModelTable.VertexRows),
            FieldRowDifferences(a.Edges, b.Edges, (x, y) => x.EdgeDifferences(y)).InTable(ModelTable.EdgeRows),
            RowDifferences(a.Loops, b.Loops, (x, y) => x.LoopDifferences(y, tol)).InTable(ModelTable.LoopRows),
            RowDifferences(a.Faces, b.Faces, (x, y) => x.FaceDifferences(y)).InTable(ModelTable.FaceRows),
            RowDifferences(a.Shells, b.Shells, (x, y) => x.ShellDifferences(y)).InTable(ModelTable.ShellRows),
            RowDifferences(a.Bodies, b.Bodies, (x, y) => x.BodyDifferences(y)).InTable(ModelTable.BodyRows),
            FieldRowDifferences([a.Tolerances], [b.Tolerances],
                (x, y) => x.ToleranceDifferences(y, tol)).InTable(ModelTable.ToleranceRow),
            FieldRowDifferences([a.Unit], [b.Unit],
                (x, y) => CompareCase(x == y, x.UnitCaseName, y.UnitCaseName)).InTable(ModelTable.UnitRow)]);

    // The fields of two edges.
    EdgeDifferences(x: BrepEdge, y: BrepEdge): Array<Difference>
        => Flattened([
            CompareWhole("Start", x.Start.Value, y.Start.Value),
            CompareWhole("End", x.End.Value, y.End.Value),
            CompareWhole("Curve", x.Curve.Value, y.Curve.Value),
            CompareFlag("SameSense", x.SameSense, y.SameSense)]);

    // Two loops: their cases, then, for one case, its coedges, its vertex,
    // or its points (the other two arrays are empty for that case).
    LoopDifferences(x: BrepLoop, y: BrepLoop, tol: Number): Array<SlotDifference>
        => x.LoopCaseName == y.LoopCaseName
            ? Flattened([
                SlotDifferences("Coedges", x.CoedgesOf, y.CoedgesOf, (p, q) => Flattened([
                    CompareWhole("Edge", p.Edge.Value, q.Edge.Value),
                    CompareFlag("Forward", p.IsForward, q.IsForward)])),
                SlotDifferences("Vertex", x.VertexLoopVertexOf, y.VertexLoopVertexOf,
                    (p, q) => CompareWhole("Vertex", p.Value, q.Value)),
                SlotDifferences("Points", x.PolyLoopPointsOf, y.PolyLoopPointsOf,
                    (p, q) => ComparePoint(p, q, tol))])
            : OnRow(CompareCase(false, x.LoopCaseName, y.LoopCaseName));

    // Two faces: surface and sense, then their bounds slot by slot.
    FaceDifferences(x: BrepFace, y: BrepFace): Array<SlotDifference>
        => OnRow(Flattened([
                CompareWhole("Surface", x.Surface.Value, y.Surface.Value),
                CompareFlag("SameSense", x.SameSense, y.SameSense)]))
            .Concatenate(SlotDifferences("Bounds", x.Bounds, y.Bounds, (p, q) => Flattened([
                CompareWhole("Loop", p.Loop.Value, q.Loop.Value),
                CompareFlag("Orientation", p.Orientation, q.Orientation),
                CompareFlag("IsOuter", p.IsOuter, q.IsOuter)])));

    // Two shells: the declared closure, then their faces slot by slot.
    ShellDifferences(x: BrepShell, y: BrepShell): Array<SlotDifference>
        => OnRow(CompareFlag("DeclaredClosed", x.DeclaredClosed, y.DeclaredClosed))
            .Concatenate(SlotDifferences("Faces", x.Faces, y.Faces, (p, q) => CompareWhole("Face", p.Value, q.Value)));

    // Two bodies: their cases, then their shells slot by slot.
    BodyDifferences(x: BrepBody, y: BrepBody): Array<SlotDifference>
        => x.BodyCaseName == y.BodyCaseName
            ? SlotDifferences("Shells", x.ShellsOfBody, y.ShellsOfBody, (p, q) => CompareWhole("Shell", p.Value, q.Value))
            : OnRow(CompareCase(false, x.BodyCaseName, y.BodyCaseName));

    // The four tolerances, within tol.
    ToleranceDifferences(x: Tolerances, y: Tolerances, tol: Number): Array<Difference>
        => Flattened([
            CompareReal("Length", x.Length.Value, y.Length.Value, tol),
            CompareReal("Angle", x.Angle.Value.Radians, y.Angle.Value.Radians, tol),
            CompareReal("LengthParameter", x.LengthParameter.Value, y.LengthParameter.Value, tol),
            CompareReal("AngleParameter", x.AngleParameter.Value, y.AngleParameter.Value, tol)]);

    // Where a model difference sits, as a layer 0 provenance a diagnostic can
    // carry: the kernel row for the tables that have a typed index, the whole
    // input for the others.
    DifferenceProvenance(d: LocatedDifference<ModelTable>): Provenance
        => d.Table.RowProvenance(d.Row);

    // Row row of model table t as a provenance (DifferenceProvenance).
    RowProvenance(t: ModelTable, row: Integer): Provenance
        => match (t) {
            CurveRows => Provenance.KernelCurve(CurveIndex(row));
            Curve2DRows => Provenance.WholeInput;
            PcurveRows => Provenance.WholeInput;
            SurfaceRows => Provenance.KernelSurface(SurfaceIndex(row));
            ClosureRows => Provenance.WholeInput;
            VertexRows => Provenance.KernelVertex(BrepVertexIndex(row));
            EdgeRows => Provenance.KernelEdge(BrepEdgeIndex(row));
            LoopRows => Provenance.KernelLoop(BrepLoopIndex(row));
            FaceRows => Provenance.KernelFace(BrepFaceIndex(row));
            ShellRows => Provenance.KernelShell(ShellIndex(row));
            BodyRows => Provenance.KernelBody(BodyIndex(row));
            ToleranceRow => Provenance.WholeInput;
            UnitRow => Provenance.WholeInput;
        };

    //==
    // # Discretizations

    // Every difference between two discretizations: the edge, then the
    // parameters, then the points. Row is the sample.
    DiscretizationDifferences(a: EdgeDiscretization, b: EdgeDiscretization, tol: Number): Array<LocatedDifference<DiscretizationTable>>
        => Flattened([
            FieldRowDifferences([a.Edge], [b.Edge], (x, y) => CompareWhole("Edge", x.Value, y.Value))
                .InTable(DiscretizationTable.EdgeField),
            FieldRowDifferences(a.Parameters, b.Parameters, (x, y) => CompareReal("Parameter", x, y, tol))
                .InTable(DiscretizationTable.ParameterRows),
            FieldRowDifferences(a.Points, b.Points, (x, y) => ComparePoint(x, y, tol))
                .InTable(DiscretizationTable.PointRows)]);

    // Every difference between two sets of discretizations, entry by entry:
    // Row is the entry of ByEdge and Slot the sample; then the entry count.
    DiscretizationSetDifferences(a: EdgeDiscretizations, b: EdgeDiscretizations, tol: Number): Array<LocatedDifference<DiscretizationTable>>
        => a.ByEdge.Count.Min(b.ByEdge.Count).Range
            .FlatMap(i => DiscretizationDifferences(a.ByEdge[i], b.ByEdge[i], tol)
                .Map(d => LocatedDifference(d.Table, i, d.Row, d.What)))
            .Concatenate(CountDifference(a.ByEdge.Count, b.ByEdge.Count).InTable(DiscretizationTable.EntryRows));

    //==
    // # Meshes

    // Two position tables within tol.
    PositionDifferences(a: Array<Point3D>, b: Array<Point3D>, tol: Number): Array<LocatedDifference<MeshTable>>
        => FieldRowDifferences(a, b, (x, y) => ComparePoint(x, y, tol)).InTable(MeshTable.PositionRows);

    // Two triangle tables, corner by corner.
    TriangleDifferences(a: Array<TriangleFace>, b: Array<TriangleFace>): Array<LocatedDifference<MeshTable>>
        => FieldRowDifferences(a, b, (x, y) => Flattened([
            CompareWhole("A", x.A.Value, y.A.Value),
            CompareWhole("B", x.B.Value, y.B.Value),
            CompareWhole("C", x.C.Value, y.C.Value)])).InTable(MeshTable.TriangleRows);

    // Two quadrilateral tables, corner by corner.
    QuadDifferences(a: Array<QuadFace>, b: Array<QuadFace>): Array<LocatedDifference<MeshTable>>
        => FieldRowDifferences(a, b, (x, y) => Flattened([
            CompareWhole("A", x.A.Value, y.A.Value),
            CompareWhole("B", x.B.Value, y.B.Value),
            CompareWhole("C", x.C.Value, y.C.Value),
            CompareWhole("D", x.D.Value, y.D.Value)])).InTable(MeshTable.QuadRows);

    // Two element-to-face tables.
    ElementFaceDifferences(a: Array<BrepFaceIndex>, b: Array<BrepFaceIndex>): Array<LocatedDifference<MeshTable>>
        => FieldRowDifferences(a, b, (x, y) => CompareWhole("Face", x.Value, y.Value)).InTable(MeshTable.ElementFaceRows);

    // Two vertex provenance tables, by case and payload.
    ProvenanceDifferences(a: Array<MeshVertexProvenance>, b: Array<MeshVertexProvenance>): Array<LocatedDifference<MeshTable>>
        => FieldRowDifferences(a, b, (x, y) => CompareCase(x == y, x.VertexProvenanceCaseName, y.VertexProvenanceCaseName))
            .InTable(MeshTable.ProvenanceRows);

    // Two numberings: the model vertex count, then both run tables.
    NumberingDifferences(a: MeshVertexNumbering, b: MeshVertexNumbering): Array<LocatedDifference<MeshTable>>
        => Flattened([
            FieldRowDifferences([a.ModelVertexCount], [b.ModelVertexCount],
                (x, y) => CompareWhole("ModelVertexCount", x, y)).InTable(MeshTable.NumberingRow),
            FieldRowDifferences(a.EdgeInteriorStart, b.EdgeInteriorStart,
                (x, y) => CompareWhole("Start", x, y)).InTable(MeshTable.EdgeInteriorStartRows),
            FieldRowDifferences(a.FaceInteriorStart, b.FaceInteriorStart,
                (x, y) => CompareWhole("Start", x, y)).InTable(MeshTable.FaceInteriorStartRows)]);

    // Every difference SameConnectivity sees: the position count (not the
    // positions), triangles, quads, element faces, numbering.
    ConnectivityDifferences(a: ModelMesh, b: ModelMesh): Array<LocatedDifference<MeshTable>>
        => Flattened([
            CountDifference(a.Positions.Count, b.Positions.Count).InTable(MeshTable.PositionRows),
            TriangleDifferences(a.Triangles, b.Triangles),
            QuadDifferences(a.Quads, b.Quads),
            ElementFaceDifferences(a.ElementFace, b.ElementFace),
            NumberingDifferences(a.Numbering, b.Numbering)]);

    // Every difference between two model meshes, in field order; positions,
    // corner normals and corner parameters within tol.
    ModelMeshDifferences(a: ModelMesh, b: ModelMesh, tol: Number): Array<LocatedDifference<MeshTable>>
        => Flattened([
            PositionDifferences(a.Positions, b.Positions, tol),
            TriangleDifferences(a.Triangles, b.Triangles),
            QuadDifferences(a.Quads, b.Quads),
            FieldRowDifferences(a.CornerNormals, b.CornerNormals,
                (x, y) => CompareVector(x.Vector, y.Vector, tol)).InTable(MeshTable.CornerNormalRows),
            FieldRowDifferences(a.CornerUvs, b.CornerUvs,
                (x, y) => CompareUv(x, y, tol)).InTable(MeshTable.CornerUvRows),
            ElementFaceDifferences(a.ElementFace, b.ElementFace),
            ProvenanceDifferences(a.VertexProvenance, b.VertexProvenance),
            NumberingDifferences(a.Numbering, b.Numbering)]);

    // Every difference between two face meshes, in field order; parameter
    // points, positions and normals within tol.
    FaceMeshDifferences(a: FaceMesh, b: FaceMesh, tol: Number): Array<LocatedDifference<MeshTable>>
        => Flattened([
            FieldRowDifferences([a.Face], [b.Face], (x, y) => CompareWhole("Face", x.Value, y.Value))
                .InTable(MeshTable.FaceField),
            FieldRowDifferences(a.UvPoints, b.UvPoints, (x, y) => CompareUv(x, y, tol)).InTable(MeshTable.UvPointRows),
            FieldRowDifferences(a.Sources, b.Sources,
                (x, y) => CompareCase(x == y, x.SourceCaseName, y.SourceCaseName)).InTable(MeshTable.SourceRows),
            FieldRowDifferences(a.LocalVertex, b.LocalVertex,
                (x, y) => CompareWhole("Vertex", x.Value, y.Value)).InTable(MeshTable.LocalVertexRows),
            PositionDifferences(a.Positions, b.Positions, tol),
            FieldRowDifferences(a.Normals, b.Normals,
                (x, y) => CompareVector(x.Vector, y.Vector, tol)).InTable(MeshTable.NormalRows),
            TriangleDifferences(a.Triangles, b.Triangles),
            QuadDifferences(a.Quads, b.Quads),
            ProvenanceDifferences(a.Provenance, b.Provenance)]);

    // Every difference between two face mesh outcomes: the mesh, the
    // requests, the diagnostics (as layer 0's Identical compares them).
    FaceMeshOutcomeDifferences(a: FaceMeshOutcome, b: FaceMeshOutcome, tol: Number): Array<LocatedDifference<MeshTable>>
        => Flattened([
            FaceMeshDifferences(a.Mesh, b.Mesh, tol),
            FieldRowDifferences(a.Requests, b.Requests, (x, y) => Flattened([
                CompareWhole("Edge", x.Edge.Value, y.Edge.Value),
                CompareText("Reason", x.Reason.ReasonName, y.Reason.ReasonName),
                CompareReal("Chordal", x.Chordal, y.Chordal, 0.0),
                CompareWhole("Segments", x.Segments, y.Segments)])).InTable(MeshTable.RequestRows),
            FieldRowDifferences(a.Diagnostics, b.Diagnostics,
                (x, y) => x.DiagnosticDifferences(y)).InTable(MeshTable.OutcomeDiagnosticRows)]);

    //==
    // # Reports

    // The fields of two checks, as layer 0's Identical compares them.
    CheckDifferences(x: Check, y: Check): Array<Difference>
        => Flattened([
            CompareText("Law", x.Law, y.Law),
            CompareFlag("Holds", x.Holds, y.Holds),
            CompareIdentical("Worst", x.Worst, y.Worst),
            CompareIdentical("Bound", x.Bound, y.Bound),
            ComparePlace("Where", x.Where, y.Where)]);

    // The fields of two diagnostics, as layer 0's Identical compares them.
    DiagnosticDifferences(x: Diagnostic, y: Diagnostic): Array<Difference>
        => Flattened([
            CompareText("Severity", x.Severity.SeverityName, y.Severity.SeverityName),
            CompareText("Code", x.Code, y.Code),
            CompareText("Message", x.Message, y.Message),
            ComparePlace("Where", x.Where, y.Where),
            CompareIdentical("Measure", x.Measure, y.Measure)]);

    // Every difference between two reports: checks, then diagnostics.
    ReportDifferences(a: Report, b: Report): Array<LocatedDifference<ReportTable>>
        => Flattened([
            FieldRowDifferences(a.Checks, b.Checks, (x, y) => x.CheckDifferences(y)).InTable(ReportTable.CheckRows),
            FieldRowDifferences(a.Diagnostics, b.Diagnostics,
                (x, y) => x.DiagnosticDifferences(y)).InTable(ReportTable.DiagnosticRows)]);

    //==
    // # Files

    // Every difference between two parsed files, a row at a time through
    // layer 3's own comparisons: the header (printed by its Name), each
    // instance (printed by its id), each attribute (printed by its tag).
    FileDifferences(a: Part21File, b: Part21File): Array<LocatedDifference<FileTable>>
        => Flattened([
            FieldRowDifferences([a.Header], [b.Header], (x, y) => Unless(x.IsSameHeader(y),
                Difference("Header", CellValue.Text(x.Name), CellValue.Text(y.Name), 0.0))).InTable(FileTable.HeaderRow),
            FieldRowDifferences(a.Instances, b.Instances, (x, y) => Unless(x.IsSameInstance(y),
                Difference("Instance", CellValue.Whole(x.Id.Value), CellValue.Whole(y.Id.Value), 0.0))).InTable(FileTable.InstanceRows),
            FieldRowDifferences(a.Attributes, b.Attributes, (x, y) => Unless(x.IsSameAttribute(y),
                Difference("Attribute", CellValue.Whole(x.AttributeTag), CellValue.Whole(y.AttributeTag), 0.0))).InTable(FileTable.AttributeRows)]);

    //==
    // # Diff sums

    // Same when nothing differs, else the first difference and the count.
    ModelDiffOf(found: Array<LocatedDifference<ModelTable>>): ModelDiff
        => found.Count == 0 ? ModelDiff.Same : ModelDiff.Differs(found[0], found.Count);

    // Same when nothing differs, else the first difference and the count.
    DiscretizationDiffOf(found: Array<LocatedDifference<DiscretizationTable>>): DiscretizationDiff
        => found.Count == 0 ? DiscretizationDiff.Same : DiscretizationDiff.Differs(found[0], found.Count);

    // Same when nothing differs, else the first difference and the count.
    MeshDiffOf(found: Array<LocatedDifference<MeshTable>>): MeshDiff
        => found.Count == 0 ? MeshDiff.Same : MeshDiff.Differs(found[0], found.Count);

    // Same when nothing differs, else the first difference and the count.
    ReportDiffOf(found: Array<LocatedDifference<ReportTable>>): ReportDiff
        => found.Count == 0 ? ReportDiff.Same : ReportDiff.Differs(found[0], found.Count);

    // Same when nothing differs, else the first difference and the count.
    FileDiffOf(found: Array<LocatedDifference<FileTable>>): FileDiff
        => found.Count == 0 ? FileDiff.Same : FileDiff.Differs(found[0], found.Count);

    // Two models, exactly.
    DiffModels(a: BrepModel, b: BrepModel): ModelDiff
        => ModelDiffOf(ModelDifferences(a, b, 0.0));

    // Two models, coordinates and tolerances within tol.
    DiffModelsWithin(a: BrepModel, b: BrepModel, tol: Number): ModelDiff
        => ModelDiffOf(ModelDifferences(a, b, tol));

    // Two discretizations, exactly.
    DiffDiscretizations(a: EdgeDiscretization, b: EdgeDiscretization): DiscretizationDiff
        => DiscretizationDiffOf(DiscretizationDifferences(a, b, 0.0));

    // Two discretizations, parameters and points within tol.
    DiffDiscretizationsWithin(a: EdgeDiscretization, b: EdgeDiscretization, tol: Number): DiscretizationDiff
        => DiscretizationDiffOf(DiscretizationDifferences(a, b, tol));

    // Two sets of discretizations, exactly.
    DiffDiscretizationSets(a: EdgeDiscretizations, b: EdgeDiscretizations): DiscretizationDiff
        => DiscretizationDiffOf(DiscretizationSetDifferences(a, b, 0.0));

    // Two sets of discretizations, parameters and points within tol.
    DiffDiscretizationSetsWithin(a: EdgeDiscretizations, b: EdgeDiscretizations, tol: Number): DiscretizationDiff
        => DiscretizationDiffOf(DiscretizationSetDifferences(a, b, tol));

    // Two model meshes, exactly.
    DiffMeshes(a: ModelMesh, b: ModelMesh): MeshDiff
        => MeshDiffOf(ModelMeshDifferences(a, b, 0.0));

    // Two model meshes, positions, normals and parameters within tol.
    DiffMeshesWithin(a: ModelMesh, b: ModelMesh, tol: Number): MeshDiff
        => MeshDiffOf(ModelMeshDifferences(a, b, tol));

    // Two model meshes as SameConnectivity compares them.
    DiffConnectivity(a: ModelMesh, b: ModelMesh): MeshDiff
        => MeshDiffOf(ConnectivityDifferences(a, b));

    // Two face meshes, exactly.
    DiffFaceMeshes(a: FaceMesh, b: FaceMesh): MeshDiff
        => MeshDiffOf(FaceMeshDifferences(a, b, 0.0));

    // Two face meshes, parameters, positions and normals within tol.
    DiffFaceMeshesWithin(a: FaceMesh, b: FaceMesh, tol: Number): MeshDiff
        => MeshDiffOf(FaceMeshDifferences(a, b, tol));

    // Two face mesh outcomes, exactly.
    DiffFaceMeshOutcomes(a: FaceMeshOutcome, b: FaceMeshOutcome): MeshDiff
        => MeshDiffOf(FaceMeshOutcomeDifferences(a, b, 0.0));

    // Two reports, as layer 0's Identical compares them.
    DiffReports(a: Report, b: Report): ReportDiff
        => ReportDiffOf(ReportDifferences(a, b));

    // Two parsed files, as layer 3's IsSameFile compares them.
    DiffFiles(a: Part21File, b: Part21File): FileDiff
        => FileDiffOf(FileDifferences(a, b));

    // True when the diff found nothing.
    IsSame(d: ModelDiff): Boolean
        => match (d) { Same => true; Differs(first, count) => false; };

    // True when the diff found nothing.
    IsSame(d: DiscretizationDiff): Boolean
        => match (d) { Same => true; Differs(first, count) => false; };

    // True when the diff found nothing.
    IsSame(d: MeshDiff): Boolean
        => match (d) { Same => true; Differs(first, count) => false; };

    // True when the diff found nothing.
    IsSame(d: ReportDiff): Boolean
        => match (d) { Same => true; Differs(first, count) => false; };

    // True when the diff found nothing.
    IsSame(d: FileDiff): Boolean
        => match (d) { Same => true; Differs(first, count) => false; };
}

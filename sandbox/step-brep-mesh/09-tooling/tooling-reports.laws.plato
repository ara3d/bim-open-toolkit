//==
// # Tooling: verdict, benchmark and diff laws
//
// The laws of tooling-reports.library.plato (moved from catalog-validation
// at the catalog merge, validation, 2026-10-20). Laws over sums take Integer
// selectors and build the value inside; the diff law runs on
// Witness_UnitBox and Witness_UnitBoxMillimetres.
//
// Sections, in order:
//  - Helpers
//  - Verdicts
//  - Benchmarks
//  - Diffs

library ToolingReportsLaws
{
    //==
    // # Helpers

    // One of the eight verdict cases, chosen by k (any Integer), in
    // VerdictOrdinal's order.
    CatalogVerdictAt(k: Integer): LawVerdict
    {
        var i = (k % 8 + 8) % 8;
        return i == 0 ? LawVerdict.Held
            : (i == 1 ? LawVerdict.Failed
            : (i == 2 ? LawVerdict.FailedAsExpected
            : (i == 3 ? LawVerdict.HeldUnexpectedly
            : (i == 4 ? LawVerdict.Skipped("skipped")
            : (i == 5 ? LawVerdict.Error("error")
            : (i == 6 ? LawVerdict.Obligation
            : LawVerdict.OverBudget(ElapsedOf(2001))))))));
    }

    //==
    // # Verdicts

    // A verdict delta is a change exactly when the two verdicts differ.
    Law_VerdictDeltaChangesOnlyWhenVerdictsDiffer(i: Integer, j: Integer): Boolean
        => VerdictDeltaOf(LawName("Law_Any"), CatalogVerdictAt(i), CatalogVerdictAt(j)).IsChange
            == ((i % 8 + 8) % 8 != (j % 8 + 8) % 8);

    // A positive witness's expectation is met by Held and by nothing else.
    Law_ShouldPassIsMetOnlyByPass(i: Integer): Boolean
        => IsMet(Expectation.ShouldPass, CatalogVerdictAt(i)) == ((i % 8 + 8) % 8 == 0);

    // A negative witness's expectation is never met by Held: a negative
    // witness that started passing is reported.
    Law_ShouldFailIsNotMetByPass(s: String): Boolean
        => !IsMet(Expectation.ShouldFail(LawName(s)), LawVerdict.Held);

    //==
    // # Benchmarks

    // A recorded benchmark is met by its own value under a zero allowance.
    Law_BenchmarkMeetsItself(x: Number, k: Integer, s: String): Boolean
        => MeetsBenchmark(Measure(x, CatalogKindAt(k)),
            Benchmark(LawName(s), Measure(x, CatalogKindAt(k)),
                RunKey("hash", MeshingOptions.WitnessOptions, "commit", "cpu64")),
            AllowanceStated(Measure(0.0, CatalogKindAt(k)), "exact"));

    //==
    // # Diffs

    // A model has no difference from itself.
    Law_SameModelHasNoDifference(k: Integer): Boolean
    {
        var m = (k % 2 + 2) % 2 == 0 ? BrepModel.Witness_UnitBox : BrepModel.Witness_UnitBoxMillimetres;
        return Diff(m, m, m.Tolerances).IsSame;
    }
}

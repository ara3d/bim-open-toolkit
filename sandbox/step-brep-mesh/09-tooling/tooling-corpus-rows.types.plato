// # Tooling: corpus rows
//
// TYPE-CATALOG.md section 16, layer 9 (moved from catalog-validation at the
// catalog merge, validation, 2026-10-20). DefectReport is layer 7's
// (validation-defects.types.plato, catalog merge, repair).

// One row of the corpus report with its failing law typed. Removes: the
// "cause" column as free text.
type CorpusRow
{
    File: String;
    Key: RunKey;
    Outcome: MeshOutcome;
    Defects: DefectReport;
    Elapsed: Elapsed;
    Cause: LawName;
}

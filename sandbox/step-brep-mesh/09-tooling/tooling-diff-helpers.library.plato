//==
// # ToolingDiffHelpers
//
// Layer 9 of the STEP B-rep to mesh design (README.md beside this file): the
// pieces every diff is built from. A field comparison returns an empty array
// when the two values agree and one Difference when they do not; a row
// comparison concatenates its fields' arrays; a table comparison walks the
// common rows in order and then compares the counts. Every diff therefore
// finds all differences in table, row, slot, field order, and the first is
// the head of the array. All folds visit every element (Plato has no early
// exit), so a diff costs what the Boolean equality it replaces costs.
//
// Sections, in order:
//  - Field comparisons
//  - Case names of the sums a diff prints
//  - Rows and tables

library ToolingDiffHelpers
{
    //==
    // # Field comparisons

    // No difference when same holds, else the one difference d.
    Unless(same: Boolean, d: Difference): Array<Difference>
        => [d].Take(same ? 0 : 1);

    // The arrays of xs joined in order.
    Flattened(xs: Array<Array<$T>>): Array<$T>
        => xs.FlatMap(x => x);

    // Two integers under field name field, compared exactly.
    CompareWhole(field: String, a: Integer, b: Integer): Array<Difference>
        => Unless(a == b, Difference(field, CellValue.Whole(a), CellValue.Whole(b), 0.0));

    // Two Booleans, compared exactly.
    CompareFlag(field: String, a: Boolean, b: Boolean): Array<Difference>
        => Unless(a == b, Difference(field, CellValue.Flag(a), CellValue.Flag(b), 0.0));

    // Two strings, compared exactly.
    CompareText(field: String, a: String, b: String): Array<Difference>
        => Unless(a == b, Difference(field, CellValue.Text(a), CellValue.Text(b), 0.0));

    // Two provenances, compared exactly.
    ComparePlace(field: String, a: Provenance, b: Provenance): Array<Difference>
        => Unless(a == b, Difference(field, CellValue.Place(a), CellValue.Place(b), 0.0));

    // Two numbers within an absolute tolerance. Equal values always agree (so
    // equal infinities do, and tol 0.0 is exactly ==); a NaN agrees with
    // nothing, as under ==.
    CompareReal(field: String, a: Number, b: Number, tol: Number): Array<Difference>
        => Unless(a == b || (a - b).Abs <= tol, Difference(field, CellValue.Real(a), CellValue.Real(b), tol));

    // Two numbers under layer 0's Identical: equal, or both NaN. The
    // comparison reports use for copied values.
    CompareIdentical(field: String, a: Number, b: Number): Array<Difference>
        => Unless(a.Identical(b), Difference(field, CellValue.Real(a), CellValue.Real(b), 0.0));

    // Two values of one sum, already compared with == into same, printed by
    // their case names: field "Case" when the cases differ, "Payload" when
    // the case is the same and the payload is not.
    CompareCase(same: Boolean, left: String, right: String): Array<Difference>
        => Unless(same, Difference(left == right ? "Payload" : "Case", CellValue.Text(left), CellValue.Text(right), 0.0));

    // Two points, field by field, within tol.
    ComparePoint(a: Point3D, b: Point3D, tol: Number): Array<Difference>
        => Flattened([CompareReal("X", a.X, b.X, tol), CompareReal("Y", a.Y, b.Y, tol), CompareReal("Z", a.Z, b.Z, tol)]);

    // Two vectors, field by field, within tol.
    CompareVector(a: Vector3D, b: Vector3D, tol: Number): Array<Difference>
        => Flattened([CompareReal("X", a.X, b.X, tol), CompareReal("Y", a.Y, b.Y, tol), CompareReal("Z", a.Z, b.Z, tol)]);

    // Two parameter-plane points, field by field, within tol.
    CompareUv(a: UvCoordinate, b: UvCoordinate, tol: Number): Array<Difference>
        => Flattened([CompareReal("U", a.U, b.U, tol), CompareReal("V", a.V, b.V, tol)]);

    //==
    // # Case names of the sums a diff prints

    // The case name of a space curve.
    CurveCaseName(c: BrepCurve): String
        => match (c) {
            Line(o, v) => "Line";
            Circle(p, r) => "Circle";
            Ellipse(p, a, b) => "Ellipse";
            Hyperbola(p, a, b) => "Hyperbola";
            Parabola(p, f) => "Parabola";
            Polyline(xs) => "Polyline";
            BSpline(d) => "BSpline";
            Trimmed(basis, range, sense) => "Trimmed";
            Composite(segments) => "Composite";
            Offset(basis, distance, reference) => "Offset";
            OnSurface(curve, supports, master) => "OnSurface";
        };

    // The case name of a parameter-plane curve.
    Curve2DCaseName(c: BrepCurve2D): String
        => match (c) {
            Line(o, v) => "Line";
            Circle(p, r) => "Circle";
            Ellipse(p, a, b) => "Ellipse";
            Hyperbola(p, a, b) => "Hyperbola";
            Parabola(p, f) => "Parabola";
            Polyline(xs) => "Polyline";
            BSpline(d) => "BSpline";
            Trimmed(basis, range, sense) => "Trimmed";
            Composite(segments) => "Composite";
            Offset(basis, distance) => "Offset";
        };

    // The case name of a surface.
    SurfaceCaseName(s: BrepSurface): String
        => match (s) {
            Plane(p) => "Plane";
            Cylinder(p, r) => "Cylinder";
            Cone(p, r, a) => "Cone";
            Sphere(p, r) => "Sphere";
            Torus(p, major, minor, part) => "Torus";
            Revolution(profile, axis) => "Revolution";
            LinearExtrusion(profile, extrusion) => "LinearExtrusion";
            BSpline(d) => "BSpline";
            RectangularTrimmed(basis, u, v, us, vs) => "RectangularTrimmed";
            Offset(basis, distance) => "Offset";
        };

    // The case name of a closure mark.
    ClosureCaseName(c: ClosureMark): String
        => match (c) {
            ClosedCurve(curve) => "ClosedCurve";
            ClosedCurve2D(curve) => "ClosedCurve2D";
            ClosedSurface(surface, direction) => "ClosedSurface";
        };

    // The case name of a loop.
    LoopCaseName(l: BrepLoop): String
        => match (l) {
            EdgeLoop(coedges) => "EdgeLoop";
            VertexLoop(vertex) => "VertexLoop";
            PolyLoop(points) => "PolyLoop";
        };

    // The case name of a body.
    BodyCaseName(b: BrepBody): String
        => match (b) {
            ManifoldSolid(outer) => "ManifoldSolid";
            SolidWithVoids(outer, voids) => "SolidWithVoids";
            ShellSet(shells) => "ShellSet";
        };

    // The case name of a length unit.
    UnitCaseName(u: LengthUnit): String
        => match (u) {
            Metre => "Metre";
            Millimetre => "Millimetre";
            Centimetre => "Centimetre";
            Inch => "Inch";
            Foot => "Foot";
            Scaled(metres) => "Scaled";
        };

    // The case name of a parameter-plane point's source.
    SourceCaseName(s: UvPointSource): String
        => match (s) {
            FromVertex(v) => "FromVertex";
            FromEdge(e, i) => "FromEdge";
            SeamCut(side, i) => "SeamCut";
            Pole(side, i) => "Pole";
            Interior => "Interior";
        };

    // The case name of a mesh vertex's provenance.
    VertexProvenanceCaseName(p: MeshVertexProvenance): String
        => match (p) {
            OnVertex(v) => "OnVertex";
            OnEdge(e, t) => "OnEdge";
            OnFace(f, uv) => "OnFace";
        };

    // The name of a severity.
    SeverityName(s: Severity): String
        => match (s) {
            Error => "Error";
            Warning => "Warning";
            Info => "Info";
        };

    // The name of a refinement reason.
    ReasonName(r: RefinementReason): String
        => match (r) {
            LoopSelfIntersects => "LoopSelfIntersects";
            TooCoarseInParameterSpace => "TooCoarseInParameterSpace";
            QuadCountMismatch => "QuadCountMismatch";
        };

    //==
    // # Rows and tables

    // Differences on the row itself (slot -1).
    OnRow(ds: Array<Difference>): Array<SlotDifference>
        => ds.Map(d => SlotDifference(-1, d));

    // The differences between two nested arrays of one row: f on each common
    // position, then the count under field name field at the smaller count.
    SlotDifferences(field: String, xs: Array<$T>, ys: Array<$T>, f: Function2<$T, $T, Array<Difference>>): Array<SlotDifference>
        => xs.Count.Min(ys.Count).Range.FlatMap(i => f(xs[i], ys[i]).Map(d => SlotDifference(i, d)))
            .Concatenate(CompareWhole(field, xs.Count, ys.Count).Map(d => SlotDifference(xs.Count.Min(ys.Count), d)));

    // The differences between two tables: f on each common row, then the
    // count (field "Count") at the smaller count.
    RowDifferences(xs: Array<$T>, ys: Array<$T>, f: Function2<$T, $T, Array<SlotDifference>>): Array<RowDifference>
        => xs.Count.Min(ys.Count).Range.FlatMap(i => f(xs[i], ys[i]).Map(s => RowDifference(i, s.Slot, s.What)))
            .Concatenate(CountDifference(xs.Count, ys.Count));

    // The differences between two tables whose rows have no nested arrays.
    FieldRowDifferences(xs: Array<$T>, ys: Array<$T>, f: Function2<$T, $T, Array<Difference>>): Array<RowDifference>
        => RowDifferences(xs, ys, (x, y) => OnRow(f(x, y)));

    // A count difference between tables of a and b rows, at the smaller count.
    CountDifference(a: Integer, b: Integer): Array<RowDifference>
        => CompareWhole("Count", a, b).Map(d => RowDifference(a.Min(b), -1, d));

    // The rows' differences located in table t.
    InTable(rows: Array<RowDifference>, t: $T): Array<LocatedDifference<$T>>
        => rows.Map(r => LocatedDifference(t, r.Row, r.Slot, r.What));
}

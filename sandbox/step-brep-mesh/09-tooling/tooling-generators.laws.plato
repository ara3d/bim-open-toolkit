//==
// # ToolingGeneratorsLaws
//
// Layer 9 of the STEP B-rep to mesh design (README.md beside this file): what
// the generators promise. A sample of a family has the counts layer 7's
// facts state for it; a perturbation keeps what its kind says it keeps. Every
// law takes Integers (and one Number) only, so the random-instance runner
// reaches all of them: a family by DefaultFamilyAt, a witness by WitnessAt, a
// sample and a perturbation by seed and index. These laws are also the
// generators' first users: a failure names a family, a seed and an index,
// and those three values reproduce the model.
//
// Sections, in order:
//  - Draws and samples
//  - Perturbations
//  - Helpers

library ToolingGeneratorsLaws
{
    //==
    // # Draws and samples

    // Every draw lies in [0, 1), so every drawn parameter lies in its range.
    Law_UnitDrawIsInUnitInterval(seed: Integer, index: Integer, dimension: Integer): Boolean
        => UnitDraw(seed, index, dimension) >= 0.0 && UnitDraw(seed, index, dimension) < 1.0;

    // The raw counts of shell s of a sample are the counts its facts state:
    // layer 7's Law_WitnessHasStatedCounts over the whole parameter space of
    // every default family. Vacuous where the facts state none.
    Law_SampleHasStatedCounts(family: Integer, s: Integer, seed: Integer, index: Integer): Boolean
        => WitnessFamily.DefaultFamilyAt(family).SampleFacts(seed, index).Shells.IsValidIndex(s)
            ? WitnessFamily.DefaultFamilyAt(family).SampleModel(seed, index).RawCounts(ShellIndex(s))
                == WitnessFamily.DefaultFamilyAt(family).SampleFacts(seed, index).Shells[s]
            : true;

    //==
    // # Perturbations
    //
    // Over witness k of layer 7 and perturbation index under seed
    // (DrawPerturbation), which cycles through every kind.

    // Every perturbation keeps the size of every table.
    Law_PerturbationKeepsTableSizes(k: Integer, seed: Integer, index: Integer): Boolean
        => BrepModel.WitnessAt(k).HasSameTableSizes(
            BrepModel.WitnessAt(k).Perturbed(BrepModel.WitnessAt(k).DrawPerturbation(seed, index)));

    // Every perturbation keeps the raw counts of every shell.
    Law_PerturbationKeepsRawCounts(k: Integer, s: Integer, seed: Integer, index: Integer): Boolean
        => BrepModel.WitnessAt(k).Shells.IsValidIndex(s)
            ? BrepModel.WitnessAt(k).Perturbed(BrepModel.WitnessAt(k).DrawPerturbation(seed, index)).RawCounts(ShellIndex(s))
                == BrepModel.WitnessAt(k).RawCounts(ShellIndex(s))
            : true;

    // A rigid motion, a scale or a jitter changes no edge, face, shell or
    // body row: the model diff finds nothing in those tables.
    Law_MotionKeepsTopologyRows(k: Integer, seed: Integer, index: Integer): Boolean
        => BrepModel.WitnessAt(k).DrawPerturbation(seed, index).IsMotion
            ? BrepModel.WitnessAt(k).TopologyDifferenceCount(
                BrepModel.WitnessAt(k).Perturbed(BrepModel.WitnessAt(k).DrawPerturbation(seed, index))) == 0
            : true;

    // A reversal applied twice gives the model back exactly.
    Law_ReversalIsAnInvolution(k: Integer, seed: Integer, index: Integer): Boolean
        => BrepModel.WitnessAt(k).DrawPerturbation(seed, index).IsReversal
            ? BrepModel.WitnessAt(k)
                .Perturbed(BrepModel.WitnessAt(k).DrawPerturbation(seed, index))
                .Perturbed(BrepModel.WitnessAt(k).DrawPerturbation(seed, index))
                .DiffModels(BrepModel.WitnessAt(k)).IsSame
            : true;

    // Jitter of at most half the length tolerance moves vertex v by at most
    // the length tolerance. Half, so the rounding of the addition never
    // carries a move of the full tolerance past it.
    Law_JitterStaysWithinLengthTolerance(k: Integer, seed: Integer, v: Integer, fraction: Number): Boolean
        => (BrepModel.WitnessAt(k).Vertices.IsValidIndex(v) && fraction >= 0.0 && fraction <= 0.5)
            ? BrepModel.WitnessAt(k).Jittered(seed, fraction).Vertices[v].Point
                .Distance(BrepModel.WitnessAt(k).Vertices[v].Point)
                <= BrepModel.WitnessAt(k).Tolerances.Length.Value
            : true;

    // A perturbation with a volume factor multiplies the exact volume of
    // every shell by it: the divergence-theorem volume after is the factor
    // times the volume before, within both runs' allowances.
    Law_PerturbedShellVolumeFollowsFactor(k: Integer, s: Integer, seed: Integer, index: Integer): Boolean
    {
        var m = BrepModel.WitnessAt(k);
        var p = m.DrawPerturbation(seed, index);
        if (!(p.HasVolumeFactor && m.Shells.IsValidIndex(s)))
        {
            return true;
        }
        var q = m.Perturbed(p);
        var factor = p.VolumeFactorOr(1.0);
        var before = m.Oracle_DivergenceVolume(ShellIndex(s));
        var after = q.Oracle_DivergenceVolume(ShellIndex(s));
        return (before.IsFinite && after.IsFinite)
            ? (after - factor * before).Abs
                <= q.DivergenceAllowance(ShellIndex(s)) + factor.Abs * m.DivergenceAllowance(ShellIndex(s))
            : true;
    }

    //==
    // # Helpers

    // True when every table of a and b has the same number of rows.
    HasSameTableSizes(a: BrepModel, b: BrepModel): Boolean
        => a.Geometry.Curves.Count == b.Geometry.Curves.Count
            && a.Geometry.Curves2D.Count == b.Geometry.Curves2D.Count
            && a.Geometry.Pcurves.Count == b.Geometry.Pcurves.Count
            && a.Geometry.Surfaces.Count == b.Geometry.Surfaces.Count
            && a.Geometry.Closures.Count == b.Geometry.Closures.Count
            && a.Vertices.Count == b.Vertices.Count
            && a.Edges.Count == b.Edges.Count
            && a.Loops.Count == b.Loops.Count
            && a.Faces.Count == b.Faces.Count
            && a.Shells.Count == b.Shells.Count
            && a.Bodies.Count == b.Bodies.Count;

    // The number of differences between a and b in the edge, face, shell
    // and body tables.
    TopologyDifferenceCount(a: BrepModel, b: BrepModel): Integer
        => ModelDifferences(a, b, 0.0).Map(d => d.Table.IsTopologyTable ? 1 : 0).IntegerTotal;

    // True for the edge, face, shell and body tables: the rows a motion
    // keeps. Loops are left out because a poly loop's points move.
    IsTopologyTable(t: ModelTable): Boolean
        => match (t) {
            CurveRows => false;
            Curve2DRows => false;
            PcurveRows => false;
            SurfaceRows => false;
            ClosureRows => false;
            VertexRows => false;
            EdgeRows => true;
            LoopRows => false;
            FaceRows => true;
            ShellRows => true;
            BodyRows => true;
            ToleranceRow => false;
            UnitRow => false;
        };
}

//==
// # ToolingLawRunnerOnce
//
// Layer 9 (complexity sweep, chunk L7): the law runner's check runs and layer 8 pipeline-witness
// runs, each model witness meshed once. The runs are the ones ToolingLawRunner makes, row for row
// (the same laws, witnesses, stages, verdicts, measures and counts); only the number of times a
// witness is meshed and validated changes. CheckedWitnessOf meshes and validates a witness once;
// every run over it reads that value through an Of form or a law of
// StepToMeshMeshedWitnessesLaws, and a metamorphic law builds only its perturbed run, without
// validation. Also the names of the model witnesses without building the models, and the stage
// dump with each state built once. At merge each replaces its ToolingLawRunner or ToolingDumps
// counterpart (TRACK.md, "Merge instructions").
//
// Sections, in order:
//  - Witness names
//  - Checked witnesses
//  - Runs from checks
//  - Layer 8: pipeline witnesses
//  - The report
//  - Every stage of one run

library ToolingLawRunnerOnce
{
    //==
    // # Witness names

    // The names of the thirteen model witnesses, in ModelWitnesses' order, without building a
    // model: the ten positive ones, then the three negative ones.
    WitnessNames(_: NamedModel): Array<String>
        => ["UnitBox", "Cylinder", "Sphere", "Torus", "Cone", "BlockWithThroughHole", "HollowBox",
            "BSplinePatchSolid", "CylinderSector", "SphereByPoleLoops",
            "SphereWithRedundantPoleLoops", "BoxWithFlippedFace", "TwoBoxesSharingCorner"];

    // The name of positive witness k (k modulo 10, as WitnessAt reads it). WitnessName built all
    // thirteen witness models to read one name.
    WitnessNameFromNames(k: Integer): String
        => NamedModel.WitnessNames[((k % 10) + 10) % 10];

    // The positive model witnesses, in WitnessAt's order.
    PositiveWitnesses(_: NamedModel): Array<NamedModel>
        => NamedModel.ModelWitnesses.Take(NamedModel.PositiveWitnessCount);

    //==
    // # Checked witnesses

    // Witness w meshed once under the witness options, with the three validation reports the runs
    // read. When the run is defined and the options validate at Oracle, the reports are the parts
    // of the outcome's own validation, computed once; otherwise each is computed beside the
    // outcome, as the runs computed them before.
    CheckedWitnessOf(w: NamedModel): CheckedWitness
        => (w.Model.IsRunnable(MeshingOptions.WitnessOptions) && MeshingOptions.WitnessOptions.Level == ConformanceLevel.Oracle)
            ? w.CheckedWitnessShared
            : w.CheckedWitnessSeparately;

    // MeshModel's run under the witness options with its validation split into its three parts:
    // RunOutcome's steps, with Validated's three reports kept. Requires a runnable model and
    // options at the Oracle level.
    CheckedWitnessShared(w: NamedModel): CheckedWitness
    {
        var m = w.Model;
        var o = MeshingOptions.WitnessOptions;
        var s = m.FinalState(o, m.AllFaces);
        var mesh = m.AssembledMesh(s);
        var model = m.ValidateBrep(o.Level);
        var meshChecks = mesh.ValidateModelMesh(m.Tolerances, o.Quality, o.Level);
        var cross = m.CrossCheck(mesh, o.Level, o.Face);
        var outcome = m.OutcomeOfRun(o, m.AllFaces, s, mesh, model.Merge(meshChecks).Merge(cross));
        return CheckedWitness(MeshedWitness(w.Name, m, outcome), model, meshChecks, cross, w.ExpectedFailures);
    }

    // The outcome and the three reports each computed on its own, as ModelRuns, MeshedRuns and
    // the Integer-indexed outcome laws computed them: MeshModel, then each validation at Oracle.
    CheckedWitnessSeparately(w: NamedModel): CheckedWitness
    {
        var m = w.Model;
        var o = MeshingOptions.WitnessOptions;
        var outcome = m.MeshModel(o);
        return CheckedWitness(MeshedWitness(w.Name, m, outcome),
            m.ValidateBrep(ConformanceLevel.Oracle),
            outcome.Mesh.ValidateModelMesh(m.Tolerances, o.Quality, ConformanceLevel.Oracle),
            m.CrossCheck(outcome.Mesh, ConformanceLevel.Oracle, o.Face),
            w.ExpectedFailures);
    }

    //==
    // # Runs from checks

    // ModelRuns over a checked witness: its model's own laws through ValidateBrep at Oracle.
    ModelRunsOf(c: CheckedWitness): Array<LawRun>
        => c.ModelChecks.Checks.Map(x => RunOfCheck(x, c.Meshed.Name, RunStage.ModelStage, c.ExpectedFailures));

    // MeshedRuns over a checked witness: the checks of the report of meshing it.
    MeshedRunsOf(c: CheckedWitness): Array<LawRun>
        => c.Meshed.Outcome.Report.Checks.Map(x => RunOfCheck(x, c.Meshed.Name, RunStage.MeshedStage, c.ExpectedFailures));

    // CheckRuns over checked witnesses: each one's own laws and its meshed laws, then each mesh
    // witness's.
    CheckRunsFrom(cs: Array<CheckedWitness>): Array<LawRun>
        => cs.FlatMap(c => c.ModelRunsOf.Concatenate(c.MeshedRunsOf))
            .Concatenate(NamedMesh.MeshWitnesses.FlatMap(w => w.MeshRuns));

    //==
    // # Layer 8: pipeline witnesses

    // Law_WitnessMeshesOk on a built outcome.
    WitnessMeshesOkOf(outcome: MeshOutcome): Boolean
        => outcome.Ok;

    // Law_WitnessMeshCrossChecksClean on a checked witness: its cross checks at Oracle are clean.
    WitnessMeshCrossChecksCleanOf(c: CheckedWitness): Boolean
        => c.CrossChecks.IsClean;

    // Law_WitnessMeshValidatesClean on a checked witness: ValidateModelMesh of its mesh at Oracle
    // is clean. The mesh validation alone, as WitnessMeshValidatesCleanAt computed it, not the
    // whole outcome report: a witness whose model findings make the outcome not Ok can still have
    // a clean mesh.
    WitnessMeshValidatesCleanOf(c: CheckedWitness): Boolean
        => c.MeshChecks.IsClean;

    // Law_HollowBoxVoidMeshVolumeNegative on hollow box m and its mesh.
    HollowBoxVoidMeshVolumeNegativeOf(m: BrepModel, mesh: ModelMesh): Boolean
        => m.ShellMeshVolume(mesh, ShellIndex(1)) < 0.0 - mesh.VolumeRoundoff;

    // Law_HollowBoxOuterMeshVolumePositive on hollow box m and its mesh.
    HollowBoxOuterMeshVolumePositiveOf(m: BrepModel, mesh: ModelMesh): Boolean
        => m.ShellMeshVolume(mesh, ShellIndex(0)) > mesh.VolumeRoundoff;

    // Law_HollowBoxMeshVolumeIsDifference on hollow box m of sides a and b and its mesh.
    HollowBoxMeshVolumeIsDifferenceOf(m: BrepModel, mesh: ModelMesh, a: Number, b: Number): Boolean
        => (m.BodyMeshVolume(mesh, BodyIndex(0)) - (a * a * a - b * b * b)).Abs <= 2.0 * mesh.VolumeRoundoff;

    // The three hollow-box laws at sides a and b from one mesh, without its validation (the laws
    // read only the mesh). Each law holds vacuously outside its guard, where no mesh is built.
    HollowBoxVerdictsOf(a: Number, b: Number): HollowBoxVerdicts
        => (b > 0.0 && a > b && a.IsFinite) ? HollowBoxVerdictsMeshed(a, b) : HollowBoxVerdicts(true, true, true);

    // The three hollow-box laws at sides a and b inside their guard.
    HollowBoxVerdictsMeshed(a: Number, b: Number): HollowBoxVerdicts
    {
        var m = BrepModel.Witness_HollowBox(a, b);
        var mesh = m.WitnessMeshUnvalidated;
        return HollowBoxVerdicts(m.HollowBoxVoidMeshVolumeNegativeOf(mesh), m.HollowBoxOuterMeshVolumePositiveOf(mesh),
            m.HollowBoxMeshVolumeIsDifferenceOf(mesh, a, b));
    }

    // The verdicts at drawn sides p (side, void side).
    HollowBoxVerdictsAt(p: Array<Number>): HollowBoxVerdicts
        => HollowBoxVerdictsOf(p[0], p[1]);

    // The verdicts on each of the SampleCount samples of the default hollow-box family: one mesh
    // per sample, where the three laws meshed each sample twice per law.
    HollowBoxSampleVerdicts(_: HollowBoxVerdicts): Array<HollowBoxVerdicts>
        => LawRun.SampleCount.MapRange(i => HollowBoxDraw(i).HollowBoxVerdictsAt);

    // The three hollow-box runs over the verdicts of drawn samples, one run per law.
    HollowBoxRunsOf(vs: Array<HollowBoxVerdicts>): Array<LawRun>
        => [OverRange("Law_HollowBoxVoidMeshVolumeNegative", "HollowBoxFamily", vs.Count, i => vs[i].VoidMeshVolumeNegative),
            OverRange("Law_HollowBoxOuterMeshVolumePositive", "HollowBoxFamily", vs.Count, i => vs[i].OuterMeshVolumePositive),
            OverRange("Law_HollowBoxMeshVolumeIsDifference", "HollowBoxFamily", vs.Count, i => vs[i].MeshVolumeIsDifference)];

    // Finding k of a report's diagnostics is about the planted sheet when it is an Error: one case
    // of PlantedBadFaceErrorsStayInTheSheetAt over diagnostics already built.
    PlantedBadFaceErrorStaysInTheSheetOf(ds: Array<Diagnostic>, k: Integer): Boolean
        => ds.IsValidIndex(k) ? (ds[k].Severity.IsError ? ds[k].Where.IsAboutPlantedSheet : true) : true;

    // The planted bad face's runs over its witness, run once: the five laws in the runner's order.
    PlantedBadFaceRunsOf(w: FailedFaceWitness): Array<LawRun>
    {
        var ds = w.Meshed.Outcome.Report.Diagnostics;
        return [
            Once("Law_PlantedBadFaceFailsSilently", "BoxWithPolyLoopSheet", Law_PlantedBadFaceFailsSilently(w)),
            OverRange("Law_PlantedBadFaceLeavesOthersUnchanged", "BoxWithPolyLoopSheet",
                w.Meshed.Model.Faces.Count, g => Law_PlantedBadFaceLeavesOthersUnchanged(w, g)),
            Once("Law_PlantedBadFaceIsDiagnosed", "BoxWithPolyLoopSheet", Law_PlantedBadFaceIsDiagnosed(w)),
            OverRange("Law_PlantedBadFaceErrorsStayInTheSheet", "BoxWithPolyLoopSheet",
                ds.Count, k => PlantedBadFaceErrorStaysInTheSheetOf(ds, k)),
            Once("Law_PlantedBadFaceHasTwoErrors", "BoxWithPolyLoopSheet", Law_PlantedBadFaceHasTwoErrors(w))];
    }

    // The runs that sit between the outcome laws and the metamorphic laws, over no positive
    // witness: the hollow-box samples and the planted bad face.
    PipelineMiddleRuns(_: LawRun): Array<LawRun>
        => HollowBoxRunsOf(HollowBoxVerdicts.HollowBoxSampleVerdicts)
            .Concatenate(PlantedBadFaceRunsOf(FailedFaceWitness.Witness_PlantedBadFaceRun));

    // PipelineWitnessRuns over checked positive witnesses, with the middle runs given: the three
    // outcome laws, the middle runs, then the metamorphic laws, each over the witness's one
    // outcome and its perturbed runs only.
    PipelineWitnessRunsFrom(cs: Array<CheckedWitness>, middle: Array<LawRun>): Array<LawRun>
        => Flattened([
            cs.Map(c => Once("Law_WitnessMeshesOk", c.Meshed.Name, c.Meshed.Outcome.WitnessMeshesOkOf)),
            cs.Map(c => Once("Law_WitnessMeshCrossChecksClean", c.Meshed.Name, c.WitnessMeshCrossChecksCleanOf)),
            cs.Map(c => Once("Law_WitnessMeshValidatesClean", c.Meshed.Name, c.WitnessMeshValidatesCleanOf)),
            middle,
            [NotRun("Law_WitnessRigidMotionMovesPositions", "needs drawn frames and re-meshes per vertex; run through ToolingGenerators' DrawMotion once meshing has bodies")],
            cs.Map(c => Once("Law_WitnessPowerOfTwoScalingKeepsConnectivity", c.Meshed.Name,
                Law_WitnessPowerOfTwoScalingKeepsConnectivity(c.Meshed, 1))),
            [NotRun("Law_WitnessPowerOfTwoScalingScalesPositions", "re-meshes the witness for every vertex; sweep it when a run is cheap")],
            cs.Map(c => OverRange("Law_WitnessEdgeReversalPreservesMesh", c.Meshed.Name, c.Meshed.Model.Edges.Count,
                e => Law_WitnessEdgeReversalPreservesMesh(c.Meshed, e))),
            cs.Map(c => Once("Law_WitnessShellReversalNegatesVolume", c.Meshed.Name, Law_WitnessShellReversalNegatesVolume(c.Meshed)))]);

    // PipelineWitnessRunsFrom over models, each meshed and validated once by CheckedWitnessOf,
    // with the number of those runs counted as Flips: one per model.
    PipelineWitnessRunsOnceCounted(models: Array<NamedModel>, middle: Array<LawRun>): Counted<Array<LawRun>>
    {
        var cs = models.Map(x => x.CheckedWitnessOf);
        return Counted(PipelineWitnessRunsFrom(cs, middle), Flips(cs.Count));
    }

    // PipelineWitnessRuns with each positive witness meshed once.
    PipelineWitnessRunsOnce(_: LawRun): Array<LawRun>
        => PipelineWitnessRunsOnceCounted(NamedModel.PositiveWitnesses, LawRun.PipelineMiddleRuns).Value;

    //==
    // # The report

    // LawReportOf with each model witness meshed and validated once, shared by the check runs and
    // the pipeline-witness runs.
    LawReportOnce(backend: String): LawReport
    {
        var cs = NamedModel.ModelWitnesses.Map(x => x.CheckedWitnessOf);
        return LawReport(backend, Flattened([
            CheckRunsFrom(cs),
            LawRun.DecodeWitnessRuns,
            LawRun.ValidationWitnessRuns,
            PipelineWitnessRunsFrom(cs.Take(NamedModel.PositiveWitnessCount), LawRun.PipelineMiddleRuns),
            LawRun.ToolingRuns]));
    }

    //==
    // # Every stage of one run

    // DumpStages with each state built once: the states by StatesOf, the regions over the last
    // one's discretizations, and the outcome from the last state without running the loop again.
    DumpStagesOnce(m: BrepModel, o: MeshingOptions): StageDump
        => m.IsRunnable(o) ? m.RunStagesOnce(o) : StageDump(m, o, [], [], m.RefusedOutcome(o));

    // DumpStagesOnce of a runnable model.
    RunStagesOnce(m: BrepModel, o: MeshingOptions): StageDump
    {
        var states = m.StatesOf(o, m.AllFaces);
        var last = states[states.Count - 1];
        var regions = m.Faces.Count.MapRange(f => m.RegionOf(BrepFaceIndex(f), last.Discretizations, o.Face));
        return StageDump(m, o, states, regions, m.RunOutcomeFrom(o, m.AllFaces, last));
    }
}

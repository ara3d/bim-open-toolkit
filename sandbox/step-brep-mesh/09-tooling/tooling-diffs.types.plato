//==
// # Tooling: diff types
//
// Layer 9 of the STEP B-rep to mesh design (README.md beside this file): the
// values a diff returns. A diff compares two values of one lower-layer type
// and names the first difference it finds: which table, which row, which
// slot inside the row, which field, both values, and the tolerance it
// compared with. The Boolean equalities of layers 3 to 7 (SameModel,
// SameDiscretization, SameFaceMesh, SameFaceMeshOutcome, SameConnectivity,
// IsSameFile, Identical on reports) say only "different"; the laws in
// tooling-diffs.laws.plato tie each one to its diff.
//
// Sections, in order:
//  - One difference
//  - Tables, one sum per compared type
//  - Located differences and the diff sums

//==
// # One difference

// One side's value of a differing field, as the host prints it. Whole for
// counts, indices and integer fields; Real for coordinates, parameters and
// measures; Flag for Booleans; Text for strings and for the case name of a
// sum-typed field (Plato cannot compose strings, so a sum's payload is not
// printed: the developer dumps the row); Place for a provenance.
type CellValue
    = Whole(Value: Integer)
    | Real(Value: Number)
    | Flag(Value: Boolean)
    | Text(Value: String)
    | Place(Where: Provenance);

// What differs inside one row: the field's name (a literal: "Point.X",
// "Count", "Case", "Payload"), the left and right values, and the tolerance
// the comparison used (0.0 for an exact comparison). Field "Count" means the
// two arrays have different lengths; "Case" that a sum-typed field holds
// different cases; "Payload" the same case with different payloads.
type Difference
{
    Field: String;
    Left: CellValue;
    Right: CellValue;
    Tolerance: Number;
}

// A difference inside one row: Slot is the position inside the row's own
// nested array (a face's bounds, a shell's faces), -1 when the field sits on
// the row itself.
type SlotDifference
{
    Slot: Integer;
    What: Difference;
}

// A difference at one row of one table, before the table is named. Row is
// the position in the table's array; Slot the position inside the row's own
// nested array (a face's bounds, a shell's faces), -1 when the field sits on
// the row itself. A count difference sits at the first row present on one
// side only (Row = the smaller count, Slot -1 for a table, Slot = the smaller
// count for a nested array).
type RowDifference
{
    Row: Integer;
    Slot: Integer;
    What: Difference;
}

//==
// # Tables, one sum per compared type

// The tables of a BrepModel in declaration order, the order a model diff
// visits them: the geometry arena, then topology, then the scalars.
type ModelTable
    = CurveRows
    | Curve2DRows
    | PcurveRows
    | SurfaceRows
    | ClosureRows
    | VertexRows
    | EdgeRows
    | LoopRows
    | FaceRows
    | ShellRows
    | BodyRows
    | ToleranceRow
    | UnitRow;

// The parts of an EdgeDiscretization: its edge index, its parameters, its
// points. In a set of discretizations the row is the entry of ByEdge and the
// slot the sample; for a single discretization the row is 0.
type DiscretizationTable
    = EdgeField
    | ParameterRows
    | PointRows
    | EntryRows;

// The tables of a ModelMesh, a FaceMesh and a FaceMeshOutcome, in that
// order; Positions, Triangles and Quads are shared by both meshes.
type MeshTable
    = PositionRows
    | TriangleRows
    | QuadRows
    | CornerNormalRows
    | CornerUvRows
    | ElementFaceRows
    | ProvenanceRows
    | NumberingRow
    | EdgeInteriorStartRows
    | FaceInteriorStartRows
    | FaceField
    | UvPointRows
    | SourceRows
    | LocalVertexRows
    | NormalRows
    | RequestRows
    | OutcomeDiagnosticRows;

// The two tables of a Report.
type ReportTable
    = CheckRows
    | DiagnosticRows;

// The three parts of a Part21File.
type FileTable
    = HeaderRow
    | InstanceRows
    | AttributeRows;

//==
// # Located differences and the diff sums

// A difference with its table named: the full typed location.
type LocatedDifference<T>
{
    Table: T;
    Row: Integer;
    Slot: Integer;
    What: Difference;
}

// Two models compared: Same, or the first difference in table, row, slot,
// field order and the number of differences found in all.
type ModelDiff
    = Same
    | Differs(First: LocatedDifference<ModelTable>, Count: Integer);

// Two edge discretizations, or two sets of them, compared.
type DiscretizationDiff
    = Same
    | Differs(First: LocatedDifference<DiscretizationTable>, Count: Integer);

// Two model meshes, two face meshes, or two face mesh outcomes compared.
type MeshDiff
    = Same
    | Differs(First: LocatedDifference<MeshTable>, Count: Integer);

// Two reports compared.
type ReportDiff
    = Same
    | Differs(First: LocatedDifference<ReportTable>, Count: Integer);

// Two parsed Part 21 files compared, a row at a time.
type FileDiff
    = Same
    | Differs(First: LocatedDifference<FileTable>, Count: Integer);

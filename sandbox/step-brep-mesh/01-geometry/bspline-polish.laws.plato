//==
// # Cached polish: laws (complexity sweep, chunk I4, TKT-381)
//
// The count witness for PolishProjectionCachedCounted (Law_WorkIsWithinSlope,
// layer 00, reads it) and the laws that tie the cached forms to the library
// functions they replace, bit for bit, on the B-spline fixtures of
// bspline-witnesses.library.plato, a rectangular trimmed copy of each, and a
// sphere: the first jet is Eval, PartialU and PartialV; the normal and the
// area element from it are NormalOr's and AreaElement's; the steps from it
// are GaussNewtonStep's and ProjectedStep's; the cached polish is
// PolishProjection with the same iterations; and every iteration costs two
// evaluations plus one per halving.
//
// Sections, in order:
//  - Fixtures
//  - Jets
//  - Steps and polish
//  - Count witness

library PolishCachedLaws
{
    //==
    // # Fixtures

    // The arena of the jet laws: 0 surface fixture k, 1 that fixture trimmed
    // to [0.1, 0.7] x [0.2, 0.9] with u reversed, 2 a sphere of radius 2.
    PerfJetSet(k: Integer): GeometrySet
        => GeometrySet([], [], [], [
            BrepSurface.BSpline(k.SurfaceFixture),
            BrepSurface.RectangularTrimmed(SurfaceIndex(0), NumberInterval(0.1, 0.7), NumberInterval(0.2, 0.9), false, true),
            BrepSurface.Sphere(WorldFrameAt(Point3D(0.0, 0.0, 0.0)), 2.0)], []);

    // The point of surface s's domain at fractions u and v of each range,
    // read as UnitFraction.
    PerfUvIn(g: GeometrySet, s: SurfaceIndex, u: Number, v: Number): UvCoordinate
    {
        var d = g.Domain(s);
        return UvCoordinate(
            d.U.Range.Start + (d.U.Range.End - d.U.Range.Start) * u.UnitFraction,
            d.V.Range.Start + (d.V.Range.End - d.V.Range.Start) * v.UnitFraction);
    }

    // The whole domain of surface s as a polish window.
    PerfDomainWindow(g: GeometrySet, s: SurfaceIndex): SurfaceWindow
        => SurfaceWindow(g.Domain(s).U.Range, g.Domain(s).V.Range);

    // A quarter of each side of the window: the polish's trust radius.
    PerfQuarterRadius(w: SurfaceWindow): Vector2D
        => Vector2D(0.25 * (w.U.End - w.U.Start), 0.25 * (w.V.End - w.V.Start));

    //==
    // # Jets

    // A B-spline fixture's first jet is its Eval, PartialU and PartialV,
    // bit for bit, anywhere in the domain.
    Law_BSplineSurfaceFirstJetAgrees(k: Integer, u: Number, v: Number): Boolean
    {
        var g = k.SurfaceFixtureSet;
        var s = SurfaceIndex(0);
        var uv = g.PerfUvIn(s, u, v);
        return k.SurfaceFixture.BSplineSurfaceFirstJet(uv) == SurfaceFirstJet(g.Eval(s, uv), g.PartialU(s, uv), g.PartialV(s, uv));
    }

    // Every surface's first jet is its Eval, PartialU and PartialV, bit for
    // bit: a B-spline, a trimmed B-spline with one sense reversed, a sphere.
    Law_FirstJetAgrees(k: Integer, u: Number, v: Number): Boolean
    {
        var g = k.PerfJetSet;
        return 3.Range.All(i => g.SurfaceAt(SurfaceIndex(i)).FirstJet(g, g.PerfUvIn(SurfaceIndex(i), u, v))
            == g.SurfaceAt(SurfaceIndex(i)).FirstJetByParts(g, g.PerfUvIn(SurfaceIndex(i), u, v)));
    }

    // The B-spline jet reads the (p_u + 1)(p_v + 1) controls of one span
    // once, whatever the size of the net, and its counted form has the
    // plain form's value.
    Law_SurfaceFirstJetReadsLocalNetOnce(k: Integer, u: Number, v: Number): Boolean
    {
        var d = k.SurfaceFixture;
        var uv = k.SurfaceFixtureSet.PerfUvIn(SurfaceIndex(0), u, v);
        var counted = d.BSplineSurfaceFirstJetCounted(uv);
        return counted.Work.Insertions == (d.U.Degree + 1) * (d.V.Degree + 1)
            && counted.Work.Evaluations == 0
            && counted.Value == d.BSplineSurfaceFirstJet(uv);
    }

    //==
    // # Steps and polish

    // The Gauss-Newton and projected steps from the jet are
    // GaussNewtonStep's and ProjectedStep's, bit for bit, for any point and
    // any step, on all three surfaces of the jet arena.
    Law_StepsFromJetAgree(k: Integer, u: Number, v: Number, p: Point3D, du: Number, dv: Number): Boolean
    {
        var g = k.PerfJetSet;
        return 3.Range.All(i => g.PerfStepsAgree(SurfaceIndex(i), g.PerfUvIn(SurfaceIndex(i), u, v), p, Vector2D(du, dv)));
    }

    // PerfStepsAgree for one surface at one uv.
    PerfStepsAgree(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, p: Point3D, step: Vector2D): Boolean
    {
        var surface = g.SurfaceAt(s);
        var j = surface.FirstJet(g, uv);
        var w = g.PerfDomainWindow(s);
        return j.GaussNewtonStepAt(p) == surface.GaussNewtonStep(g, p, uv)
            && j.ProjectedStepAt(p, uv, step, w) == surface.ProjectedStep(g, p, uv, step, w);
    }

    // PerfPolishAgrees for one surface from one start.
    PerfPolishAgrees(g: GeometrySet, s: SurfaceIndex, p: Point3D, start: UvCoordinate): Boolean
    {
        var surface = g.SurfaceAt(s);
        var w = g.PerfDomainWindow(s);
        var radius = w.PerfQuarterRadius;
        return surface.PolishProjectionCached(g, p, start, w, radius) == surface.PolishProjection(g, p, start, w, radius);
    }

    // Every iteration of the cached polish makes two surface evaluations
    // (one first jet, one point) and one more per halving, on any start
    // and point, on all three surfaces of the jet arena.
    Law_PolishEvaluationsAreTwoPlusHalvings(k: Integer, p: Point3D, u: Number, v: Number): Boolean
    {
        var g = k.PerfJetSet;
        return 3.Range.All(i => g.PerfPolishCostsTwoPlusHalvings(SurfaceIndex(i), p, g.PerfUvIn(SurfaceIndex(i), u, v)));
    }

    // PerfPolishCostsTwoPlusHalvings for one surface from one start.
    PerfPolishCostsTwoPlusHalvings(g: GeometrySet, s: SurfaceIndex, p: Point3D, start: UvCoordinate): Boolean
    {
        var w = g.PerfDomainWindow(s);
        var run = g.SurfaceAt(s).PolishRunCached(g, p, start, w, w.PerfQuarterRadius, Integer.PolishIterations);
        return run.Evaluations == 2 * run.Iterations + run.Halvings
            && run.Halvings <= 12 * run.Iterations
            && run.Iterations <= Integer.PolishIterations;
    }

    // The halving path is reached: from the corners of each surface of the
    // jet arena of fixture 2 toward points well off it, with the whole
    // domain as the radius, some iteration halves its step, and the cost
    // there is still two evaluations plus one per halving.
    Law_PolishHalvingsAreReached(_: Integer): Boolean
    {
        var g = 2.PerfJetSet;
        var runs = 3.Range.FlatMap(i => [0.0, 1.0].FlatMap(f => [Point3D(0.0, 0.0, 0.0), Point3D(3.0, -2.0, 5.0), Point3D(0.5, 0.5, -4.0)].Map(p =>
            g.SurfaceAt(SurfaceIndex(i)).PolishRunCached(g, p, g.PerfUvIn(SurfaceIndex(i), f, f), g.PerfDomainWindow(SurfaceIndex(i)),
                Vector2D(g.PerfDomainWindow(SurfaceIndex(i)).U.End - g.PerfDomainWindow(SurfaceIndex(i)).U.Start,
                    g.PerfDomainWindow(SurfaceIndex(i)).V.End - g.PerfDomainWindow(SurfaceIndex(i)).V.Start), Integer.PolishIterations))));
        return runs.Any(r => r.Halvings > 0) && runs.All(r => r.Evaluations == 2 * r.Iterations + r.Halvings);
    }

    //==
    // # Count witness

    // n iterations of the cached polish on the bump patch: from (0.1, 0.1)
    // toward the patch's point at (0.9, 0.85), each step at most 1/1024 per
    // coordinate, so the run is still moving when it reaches its limit n.
    PerfPolishWork(n: Integer): WorkBudget
    {
        var g = 0.SurfaceFixtureSet;
        var s = SurfaceIndex(0);
        var w = g.PerfDomainWindow(s);
        return g.SurfaceAt(s).PolishProjectionCachedCounted(g, g.Eval(s, UvCoordinate(0.9, 0.85)), UvCoordinate(0.1, 0.1), w,
            Vector2D(1.0 / 1024.0, 1.0 / 1024.0), n).Work;
    }

    // The cached polish on a B-spline surface: at most 2 + h surface
    // evaluations (Evaluations: first jets and points) per iteration with h
    // halvings, measured over 8 and 32 iterations of a descent that never
    // halves, so the slope is 2. PolishProjection made 11 + 4h Eval,
    // PartialU and PartialV calls per iteration.
    Witness_PolishProjectionCachedWork(_: WorkClaim): WorkClaim
        => WorkClaim("PolishProjectionCached: surface evaluations per polish iteration", Evaluations(2), [8, 32], n => PerfPolishWork(n));

    // The witness's run takes exactly its limit in iterations, at both
    // sizes, so the claim's size is the iteration count.
    Law_PolishWitnessRunsToItsLimit(_: Integer): Boolean
    {
        var g = 0.SurfaceFixtureSet;
        var s = SurfaceIndex(0);
        var w = g.PerfDomainWindow(s);
        var p = g.Eval(s, UvCoordinate(0.9, 0.85));
        var radius = Vector2D(1.0 / 1024.0, 1.0 / 1024.0);
        var first = g.SurfaceAt(s).PolishRunCached(g, p, UvCoordinate(0.1, 0.1), w, radius, 8);
        var second = g.SurfaceAt(s).PolishRunCached(g, p, UvCoordinate(0.1, 0.1), w, radius, 32);
        return first.Iterations == 8 && second.Iterations == 32 && first.Halvings == 0 && second.Halvings == 0;
    }
}

//==
// # Evaluation guards given well-formedness (complexity sweep, chunk V1)
//
// CanEvaluate runs the whole-arena IsWellFormed (every record, every
// reference, an acyclicity walk) on every call, and layer 7's checks call it
// once per sample. CanEvaluateGiven takes IsWellFormed's answer as ok, so a
// check computes it once and asks the cheap range test per entry. At merge
// CanEvaluate becomes CanEvaluateGiven(g.IsWellFormed, x), one expression.

library BrepGeometryGuards
{
    // CanEvaluate for curve c with ok standing for g.IsWellFormed: c is in
    // range of a well-formed arena.
    CanEvaluateGiven(g: GeometrySet, ok: Boolean, c: CurveIndex): Boolean
        => ok ? g.IsCurveInRange(c) : false;

    // CanEvaluate for parameter-plane curve c with ok given.
    CanEvaluateGiven(g: GeometrySet, ok: Boolean, c: Curve2DIndex): Boolean
        => ok ? g.IsCurve2DInRange(c) : false;

    // CanEvaluate for pcurve p with ok given.
    CanEvaluateGiven(g: GeometrySet, ok: Boolean, p: PcurveIndex): Boolean
        => ok ? g.IsPcurveInRange(p) : false;

    // CanEvaluate for surface s with ok given.
    CanEvaluateGiven(g: GeometrySet, ok: Boolean, s: SurfaceIndex): Boolean
        => ok ? g.IsSurfaceInRange(s) : false;
}

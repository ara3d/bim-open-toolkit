//==
// # The arena views at typed parameters
//
// The finer concepts' obligations (geometry.concepts.plato, "Domains" to
// "Seams and poles") for layer 1's arena views at the foundation's typed
// parameters: ArenaCurve implements IEvaluableCurve3D, IDifferentiable1 and
// IDifferentiable2, ArenaCurve2D IEvaluableCurve2D, ArenaSurface
// IEvaluableSurface and IProjectable3D through these. Domain, SeamsOf and
// DegeneracyOf are the other obligations, in geometry.library.plato and
// geometry-kinds.library.plato.
//
// Sections, in order:
//  - Curves
//  - Surfaces
//  - Decided projection
//==

library BrepGeometryViews
{
    //==
    // # Curves

    // The space curve's point at its typed parameter.
    Eval(x: ArenaCurve, t: CurveParameter): Point3D
        => x.Geometry.Eval(x.Curve, t.Value);

    // The space curve's first derivative at its typed parameter.
    Derivative(x: ArenaCurve, t: CurveParameter): Vector3D
        => x.Geometry.Derivative(x.Curve, t.Value);

    // The space curve's second derivative at its typed parameter.
    SecondDerivative(x: ArenaCurve, t: CurveParameter): Vector3D
        => x.Geometry.SecondDerivative(x.Curve, t.Value);

    // The parameter-plane curve's point at its typed parameter.
    Eval(x: ArenaCurve2D, t: Curve2DParameter): UvPoint
        => x.Geometry.Eval(x.Curve, t.Value).ToUvPoint;

    //==
    // # Surfaces

    // The surface's point at a point of its natural parameters.
    Eval(x: ArenaSurface, uv: UvPoint): Point3D
        => x.Geometry.Eval(x.Surface, uv.ToUvCoordinate);

    //==
    // # Decided projection

    // Project's result as a decided value: OnSurface where the foot is a
    // perpendicular foot or the domain does not hold it back, OffDomain where
    // it lies on a bounded side and the point is beyond that side (moving
    // across the side would bring the surface nearer), Failed where the
    // surface cannot be evaluated. Beside Project, which keeps returning a
    // bare UvCoordinate: its 25 call sites in layers 1 to 7 include the
    // per-sample loops of face meshing and the oracles (TRACK.md request,
    // not applied at the geometry merge, FINDINGS F-58).
    ProjectDecided(x: ArenaSurface, p: Point3D): Projection
        => x.Geometry.CanEvaluate(x.Surface)
            ? x.Geometry.ProjectDecidedAt(x.Surface, p, x.Geometry.Project(x.Surface, p))
            : Projection.Failed(UndecidedReason.NotApplicable("surface cannot be evaluated"));

    // ProjectDecided at Project's result uv.
    ProjectDecidedAt(g: GeometrySet, s: SurfaceIndex, p: Point3D, uv: UvCoordinate): Projection
    {
        var r = p - g.Eval(s, uv);
        var floor = ResolutionAt(g.EvaluationMagnitude(s, uv) + p.PositionVector.Length).Value;
        var held = g.Domain(s).U.HoldsBack(uv.U, r.Dot(g.PartialU(s, uv)), floor * g.PartialU(s, uv).Length)
            || g.Domain(s).V.HoldsBack(uv.V, r.Dot(g.PartialV(s, uv)), floor * g.PartialV(s, uv).Length);
        return held
            ? Projection.OffDomain(uv.ToUvPoint, ModelLength(r.Length))
            : Projection.OnSurface(uv.ToUvPoint, ModelLength(r.Length));
    }

    // True when t is at an end of a bounded aperiodic domain (no seam, finite
    // length) and the descent of the squared distance, r . S_t with r = p -
    // S, points out of the domain there by more than the floor.
    HoldsBack(d: CurveDomain, t: Number, slope: Number, floor: Number): Boolean
        => !d.HasSeam && d.ParameterLength.IsFinite
            ? (t <= d.Range.Start + ResolutionAt(d.Range.Start.Abs).Value && slope < -floor)
                || (t >= d.Range.End - ResolutionAt(d.Range.End.Abs).Value && slope > floor)
            : false;
}

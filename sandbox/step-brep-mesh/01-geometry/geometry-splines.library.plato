//==
// # BrepGeometrySplines
//
// Layer 1 of the STEP B-rep to mesh design (README.md beside this file): the
// B-spline records. Their domains and shape predicates have bodies, since each
// is its own specification; evaluation is de Boor's algorithm and is deferred,
// with its contract in geometry.spec.plato and an independent oracle, the
// stdlib's Cox-de Boor BasisFunction, in geometry.laws.plato.
//
// Sections, in order:
//  - Domains
//  - Shape of a basis
//  - Shape of a record
//  - Breakpoints
//  - Evaluation (deferred)
//  - Collapsed and coincident sides (deferred)

library BrepGeometrySplines
{
    //==
    // # Domains

    // The span on which a basis is a partition of unity: [Knots[Degree],
    // Knots[Count - Degree - 1]], which is [Knots[Degree], Knots[n]] for n
    // control points (ISO 10303-42 4.5.34; research/STEP-BREP-MODEL.md 5.3).
    // Delegates to the stdlib's KnotVector.Domain. Precondition: the knot count
    // fits the degree and the control count.
    SplineDomain(b: SplineBasis): NumberInterval
        => b.Knots.Domain(b.Degree);

    // The basis of the given surface parameter.
    BasisAlong(d: BSplineSurfaceData, which: SurfaceParameter): SplineBasis
        => match (which)
        {
            ParameterU => d.U;
            ParameterV => d.V;
        };

    // The number of control points along the given surface parameter: the
    // columns of the net for u, its rows for v.
    ControlCountAlong(d: BSplineSurfaceData, which: SurfaceParameter): Integer
        => match (which)
        {
            ParameterU => d.ControlPoints.ColumnCount;
            ParameterV => d.ControlPoints.RowCount;
        };

    //==
    // # Shape of a basis
    //
    // ISO 10303-42 constraints_param_b_spline (4.6.11), restated over the
    // expanded knot vector. Each predicate is total: it indexes only after the
    // counts it relies on are checked with a conditional.

    // True when the degree is at least one.
    HasPositiveDegree(b: SplineBasis): Boolean
        => b.Degree >= 1;

    // True when there are control count plus degree plus one knots.
    KnotCountFits(b: SplineBasis, controlCount: Integer): Boolean
        => b.Knots.Count == controlCount + b.Degree + 1;

    // True when the knots never decrease. Knot values are copied from the file,
    // so the comparison is exact by construction.
    KnotsNonDecreasing(b: SplineBasis): Boolean
        => b.Knots.Count < 2
            ? true
            : (b.Knots.Count - 1).Range.All(i => b.Knots.KnotAt(i) <= b.Knots.KnotAt(i + 1));

    // True when no knot value repeats Degree + 1 times away from the first and
    // last positions: every interior multiplicity is at most the degree and
    // every end multiplicity at most the degree plus one. With the knots
    // non-decreasing, a value repeated Degree + 1 times among positions
    // 1 .. Count - 2 fills some window [i, i + Degree] there.
    KnotMultiplicityBounded(b: SplineBasis): Boolean
        => b.Degree < 1 || b.Knots.Count - b.Degree - 2 <= 0
            ? true
            : (b.Knots.Count - b.Degree - 2).Range.All(j => b.Knots.KnotAt(j + 1) < b.Knots.KnotAt(j + 1 + b.Degree));

    // True when the domain [Knots[Degree], Knots[n]] has positive length, which
    // also gives at least Degree + 1 control points and two distinct knots.
    HasNonEmptyDomain(b: SplineBasis, controlCount: Integer): Boolean
        => b.Degree >= 0 && controlCount >= 0 && b.KnotCountFits(controlCount)
            ? b.Knots.KnotAt(b.Degree) < b.Knots.KnotAt(controlCount)
            : false;

    // True when every rule on a basis with this many control points holds.
    IsWellShaped(b: SplineBasis, controlCount: Integer): Boolean
        => b.HasPositiveDegree
            && b.KnotCountFits(controlCount)
            && b.KnotsNonDecreasing
            && b.KnotMultiplicityBounded
            && b.HasNonEmptyDomain(controlCount);

    // True when every weight is positive (ISO 10303-42 4.5.39 WR2).
    WeightsPositive(weights: Array<Number>): Boolean
        => weights.All(w => w > 0.0);

    // True when the weights are all equal, so the rational formula reduces to
    // the polynomial one (ISO 10303-42 4.5.34 NOTE 2). Weights are copied, so
    // the comparison is exact by construction.
    IsPolynomial(weights: Array<Number>): Boolean
        => weights.Count == 0 ? true : weights.All(w => w == weights[0]);

    // True when the grid holds exactly ColumnCount times RowCount elements.
    IsGridConsistent(grid: Array2D<$T>): Boolean
        => grid.Elements.Count == grid.ColumnCount * grid.RowCount;

    //==
    // # Shape of a record

    // True when the curve record satisfies every shape rule: a well-shaped
    // basis for its control points and one positive weight per point.
    IsWellShaped(d: BSplineCurveData): Boolean
        => d.Basis.IsWellShaped(d.ControlPoints.Count)
            && d.Weights.Count == d.ControlPoints.Count
            && d.Weights.WeightsPositive;

    // True when the parameter-plane curve record satisfies every shape rule.
    IsWellShaped(d: BSplineCurve2DData): Boolean
        => d.Basis.IsWellShaped(d.ControlPoints.Count)
            && d.Weights.Count == d.ControlPoints.Count
            && d.Weights.WeightsPositive;

    // True when the surface record satisfies every shape rule: consistent
    // grids of the same shape, a well-shaped basis per parameter, positive
    // weights.
    IsWellShaped(d: BSplineSurfaceData): Boolean
        => d.ControlPoints.IsGridConsistent
            && d.Weights.IsGridConsistent
            && d.Weights.ColumnCount == d.ControlPoints.ColumnCount
            && d.Weights.RowCount == d.ControlPoints.RowCount
            && d.U.IsWellShaped(d.ControlPoints.ColumnCount)
            && d.V.IsWellShaped(d.ControlPoints.RowCount)
            && d.Weights.Elements.WeightsPositive;

    //==
    // # Breakpoints

    // True when position i holds the first copy of a knot strictly inside the
    // domain at which a derivative of order at most `order` may jump: a knot
    // of multiplicity m leaves the spline C^(Degree - m) there, so its
    // derivative of order k may jump exactly when m >= Degree - k + 1. Order
    // 1 gives the knots of multiplicity at least the degree, where the
    // tangent may break; an order at least the degree gives every distinct
    // interior knot. Exact by construction (copied knots).
    IsBreakKnot(b: SplineBasis, i: Integer, order: Integer): Boolean
        => b.Degree < 1 || order < 1 || i <= b.Degree || i >= b.Knots.Count - b.Degree - 1
            ? false
            : b.Knots.KnotAt(i - 1) < b.Knots.KnotAt(i)
                && b.Knots.KnotAt(i + (b.Degree - order).Max(0)) == b.Knots.KnotAt(i);

    // The interior knots at which a derivative of order at most `order` may
    // jump, ascending.
    SplineBreaks(b: SplineBasis, order: Integer): Array<Number>
        => b.Knots.Count.Range.FlatMap(i => b.IsBreakKnot(i, order) ? [b.Knots.KnotAt(i)] : b.Knots.Knots.Take(0));

    // The interior knots of multiplicity at least the degree, where the
    // spline may lose tangent continuity: SplineBreaks of order 1.
    SplineBreakpoints(b: SplineBasis): Array<Number>
        => b.SplineBreaks(1);

    //==
    // # Evaluation (deferred)

    // deferred: de Boor's algorithm on the homogeneous control points (w P, w)
    // over the knot span holding t, then division by the weight
    // (https://en.wikipedia.org/wiki/De_Boor%27s_algorithm).
    BSplinePoint(d: BSplineCurveData, t: Number): Point3D;

    // deferred: the order-th derivative (1 or 2) of the rational curve by the
    // quotient rule over the derivatives of the homogeneous curve (Piegl and
    // Tiller, The NURBS Book, 2nd ed., algorithms A3.2 and A4.2).
    BSplineDerivative(d: BSplineCurveData, t: Number, order: Integer): Vector3D;

    // deferred: de Boor's algorithm in the parameter plane.
    BSplinePoint(d: BSplineCurve2DData, t: Number): UvCoordinate;

    // deferred: the order-th derivative of the parameter-plane curve.
    BSplineDerivative(d: BSplineCurve2DData, t: Number, order: Integer): Vector2D;

    // deferred: tensor-product de Boor, one curve evaluation per control row
    // and one across the results (Piegl and Tiller, algorithm A4.3).
    BSplinePoint(d: BSplineSurfaceData, uv: UvCoordinate): Point3D;

    // deferred: the mixed partial derivative of order (uOrder, vOrder), each 0
    // to 2, of the rational surface (Piegl and Tiller, algorithm A4.4).
    BSplinePartial(d: BSplineSurfaceData, uv: UvCoordinate, uOrder: Integer, vOrder: Integer): Vector3D;

    //==
    // # Collapsed and coincident sides (deferred)

    // deferred: knot insertion at the side's parameter until it has
    // multiplicity Degree (the side's own boundary curve then has the
    // control row next to the side as its control polygon), then a test that
    // every control point of that row is within tol of the first. For a
    // clamped end the row is the net's first or last row and no insertion is
    // needed. By the convex hull property the side's image then lies within
    // tol of one point.
    BSplineSideCollapses(d: BSplineSurfaceData, side: DomainSide, tol: LengthTolerance): Boolean;

    // deferred: the boundary curves at the two ends of the given parameter's
    // domain, each as a control row by knot insertion as above, compared
    // pointwise within tol after aligning their knot vectors; the surface is
    // then closed in that parameter.
    BSplineSidesCoincide(d: BSplineSurfaceData, which: SurfaceParameter, tol: LengthTolerance): Boolean;
}

//==
// # Kinds, degeneracies, seams, and poles
//
// TYPE-CATALOG.md section 6 (layer 1). The coarse class a match on the full
// curve or surface sum collapses to, and the domain's collapsed sides and
// seams as one value per surface.
//
// Sections, in order:
//  - Kinds
//  - Degeneracies
//  - Seams
//  - Poles
//==

//==
// # Kinds

// The coarse class of a curve: a pass that treats all conics alike writes
// one arm. KindOf is the only constructor. Removes: eleven arms with ten
// copies of one body.
type CurveKind
    = LineKind
    | ConicKind
    | PolylineKind
    | SplineKind
    | DerivedKind;

// The coarse class of a surface: Plane, the quadrics (cylinder, cone,
// sphere), the torus, the swept surfaces (revolution, extrusion), B-splines,
// and surfaces built on another (trimmed, offset). Removes: a quadric rule
// written three times.
type SurfaceKind
    = PlaneKind
    | QuadricKind
    | ToroidalKind
    | SweptKind
    | SplineKind
    | DerivedKind;

//==
// # Degeneracies

// What DegenerateSides returns, as one value per surface, plus a collapsed
// line inside the domain (a cone's apex: the whole iso-line v = v0 it names).
// CollapsedSides holds three or four sides, which only a fully collapsed
// spline reaches; the catalog's three cases could not say it. Removes: a
// sphere's two poles handled by two separate code paths with two bugs.
type Degeneracy
    = NoDegeneracy
    | CollapsedSide(Side: DomainSide)
    | CollapsedTwoSides(A: DomainSide, B: DomainSide)
    | CollapsedSides(Sides: Array<DomainSide>)
    | Apex(At: IsoLine);

//==
// # Seams

// One direction's seam: none, or the iso-line where Direction equals At
// (the range's start; its end is the same line one period on). Removes: "has
// a seam" as a Boolean with the position recomputed elsewhere.
type Seam
    = NoSeam
    | SeamAt(Direction: SurfaceParameter, At: Number);

// A surface's seams in U and in V, from its SurfaceDomain's periodicity
// (SeamsOf). Invariant: U names ParameterU when it is a seam, V ParameterV.
type Seams
    implements IValue
{
    U: Seam;
    V: Seam;
}

//==
// # Poles

// A collapsed side with its point and its limit normal, computed once
// (ExpandedPoles fills it; PoleAt is the constructor). Removes: the pole's
// normal recomputed by every caller with a different fallback.
type Pole
{
    Side: DomainSide;
    Point: Point3D;
    Normal: SurfaceNormal;
}

// The synthetic boundary run along a pole's collapsed side, in parameter
// order along the side. Invariant: every point lies on the side.
type PoleSegment
{
    Pole: Pole;
    Points: Array<UvPoint>;
}

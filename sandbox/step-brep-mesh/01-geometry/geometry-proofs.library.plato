//==
// # Proofs about B-spline records and placements (constructors)
//
// One Check* function per proof type of geometry-proofs.types.plato, each
// over this layer's own predicate (IsWellShaped, HasClampedEnds,
// IsOrthonormalEitherHandWithin).
//
// Sections, in order:
//  - B-splines
//  - Frames
//  - Verdicts

library BrepGeometryProofs
{
    //==
    // # B-splines

    // The record as a WellFormedBSpline when it keeps every shape rule;
    // Fails otherwise.
    CheckWellFormedBSpline(d: BSplineCurveData): DecidedWellFormedBSpline
        => d.IsWellShaped
            ? DecidedWellFormedBSpline.Decided(WellFormedBSpline(d))
            : DecidedWellFormedBSpline.Undecided(UndecidedReason.Fails("IsWellShaped"));

    // The well-formed curve as a ClampedBSpline when its knot vector is
    // clamped at both ends; Fails otherwise.
    CheckClampedBSpline(w: WellFormedBSpline): DecidedClampedBSpline
        => w.Data.Basis.HasClampedEnds
            ? DecidedClampedBSpline.Decided(ClampedBSpline(w.Data))
            : DecidedClampedBSpline.Undecided(UndecidedReason.Fails("HasClampedEnds"));

    //==
    // # Frames

    // The frame as an OrthonormalFrame, with the sign of its handedness,
    // when it is orthonormal within tol of either handedness;
    // ToleranceExceeded by the excess angle otherwise.
    CheckOrthonormalFrame(f: Frame3D, tol: AngleTolerance): DecidedOrthonormalFrame
        => f.IsOrthonormalEitherHandWithin(tol)
            ? DecidedOrthonormalFrame.Decided(OrthonormalFrame(f, SignWithin(f.Handedness, Resolution.Exact)))
            : DecidedOrthonormalFrame.Undecided(UndecidedReason.ToleranceExceeded(
                Angle(f.OrthonormalityDeviation - tol.Value.Radians).ToMeasure));

    //==
    // # Verdicts

    // True when the check built its proof.
    IsDecided(d: DecidedWellFormedBSpline): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedClampedBSpline): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedOrthonormalFrame): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };
}

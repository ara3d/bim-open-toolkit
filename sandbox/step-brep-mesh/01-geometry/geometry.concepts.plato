//==
// # Natural-geometry concepts
//
// Layer 1 of the STEP B-rep to mesh design (README.md beside this file). The
// operations meshing asks of a curve or a surface in its natural parameters:
// evaluate, differentiate, invert, and describe the domain. The STEP arena
// implements them through its views (ArenaCurve, ArenaCurve2D, ArenaSurface);
// a geometry from another source can implement them directly. Unlike the
// stdlib's ICurve3D and IParametricSurface, the domain is the curve's own, not
// the unit interval or square.
//
// Sections, in order:
//  - Curves
//  - Surfaces
//  - Finer concepts: Domains, Evaluation, Derivatives, Inversion, Areas, Seams
//    and poles

//==
// # Curves

// A space curve in its natural parameter: a map from Domain into space with
// first and second derivatives and an inverse (the closest parameter). Eval is
// inherited from IProcedural.
interface INaturalCurve3D
    inherits IProcedural<Number, Point3D>
{
    Domain(x: Self): CurveDomain;
    Derivative(x: Self, t: Number): Vector3D;
    SecondDerivative(x: Self, t: Number): Vector3D;
    ClosestParameter(x: Self, p: Point3D): Number;
}

// A curve in a surface's parameter plane in its natural parameter.
interface INaturalCurve2D
    inherits IProcedural<Number, UvCoordinate>
{
    Domain(x: Self): CurveDomain;
    Derivative(x: Self, t: Number): Vector2D;
}

//==
// # Surfaces

// A surface in its natural parameters: a map from Domain into space with its
// partial derivatives, its normal as ISO 10303-42 states it, its area element,
// its inverse (Project), and the sides of its domain it collapses to a point.
interface INaturalSurface
    inherits IProcedural<UvCoordinate, Point3D>
{
    Domain(x: Self): SurfaceDomain;
    PartialU(x: Self, uv: UvCoordinate): Vector3D;
    PartialV(x: Self, uv: UvCoordinate): Vector3D;
    NormalOr(x: Self, uv: UvCoordinate, fallback: Direction3D): Direction3D;
    AreaElement(x: Self, uv: UvCoordinate): Number;
    Project(x: Self, p: Point3D): UvCoordinate;
    DegenerateSides(x: Self, tol: Tolerances): Array<DomainSide>;
}

//==
// # Finer concepts
//
// TYPE-CATALOG.md section 6 and three section 15 concepts (catalog merge,
// 2026-10-20). Finer than INaturalCurve3D and INaturalSurface, so a function
// states the least it needs: a polyline has a first derivative and no second,
// an analytic surface has a closed-form area and a B-spline does not. The
// parameters are the foundation's typed ones (CurveParameter, UvPoint), not
// bare Numbers. The arena views' obligations are in geometry-views.library.plato.

//==
// # Domains

// A value defined over a curve domain. Removes: a function that needs only
// the domain demanding a whole evaluable curve.
interface IHasCurveDomain
{
    Domain(x: Self): CurveDomain;
}

// A value defined over a surface domain.
interface IHasSurfaceDomain
{
    Domain(x: Self): SurfaceDomain;
}

//==
// # Evaluation

// A space curve evaluated at its own typed parameter. Removes: a 3D curve
// evaluated at a pcurve's parameter.
interface IEvaluableCurve3D
{
    Eval(x: Self, t: CurveParameter): Point3D;
}

// A parameter-plane curve evaluated at its own typed parameter, giving a
// point in the surface's natural parameters.
interface IEvaluableCurve2D
{
    Eval(x: Self, t: Curve2DParameter): UvPoint;
}

// A surface evaluated at a point of its natural parameters. Removes: a
// unit-square UvCoordinate fed to a cylinder.
interface IEvaluableSurface
{
    Eval(x: Self, uv: UvPoint): Point3D;
}

//==
// # Derivatives

// A space curve with a first derivative. Separate from IDifferentiable2
// because a polyline has the first and not the second.
interface IDifferentiable1
{
    Derivative(x: Self, t: CurveParameter): Vector3D;
}

// A space curve with a second derivative.
interface IDifferentiable2
{
    SecondDerivative(x: Self, t: CurveParameter): Vector3D;
}

//==
// # Inversion

// A geometry that projects a model point onto itself with a decided result.
// The obligation is ProjectDecided, not the catalog's Project: INaturalSurface's
// Project(x, p): UvCoordinate has the same parameters (FINDINGS F-58).
// Removes: a projection outside the domain used as if inside.
interface IProjectable3D
{
    ProjectDecided(x: Self, p: Point3D): Projection;
}

//==
// # Areas

// A surface whose area over a parameter box has a closed form: the analytic
// surfaces only; the area oracles are its implementations. Removes: an
// oracle written for a B-spline.
interface IHasClosedFormArea
{
    Area(x: Self, window: UvBox): AreaMeasure;
}

//==
// # Seams and poles

// A surface that names its seams once, with their positions. Removes: "has a
// seam" as a Boolean with the position recomputed elsewhere.
interface IHasSeams
{
    SeamsOf(x: Self): Seams;
}

// A surface that names its collapsed sides and apexes as one value.
// Removes: a sphere's two poles handled by two code paths.
interface IHasPoles
{
    DegeneracyOf(x: Self, tol: Tolerances): Degeneracy;
}

// TKT-465, cause A: a surface direction that layer 3 marked closed (GeometrySet.Closures) but whose record is not
// periodic by formula, a B-spline's above all, was evaluated at unwrapped parameters. Face meshing moves a loop's
// coordinates by whole periods (Unwrap, NearestUnwrapped), and CurveDomain's own comment says such a coordinate "is
// wrapped before it is" evaluated, but no caller wrapped it, and a B-spline record evaluated outside its knot span
// extrapolates: on SHO/M2_JODY-W5 and W6 CARD.STEP face 322 (v closed, period 1) the surface at v = -0.5 lies
// 0.054 mm from the surface at v = 0.5, and along the face's circle edge the gap reaches 0.50 mm, so corners sit off
// the surface at their parameters and 8 of the face's 19 elements read as flipped.
//
// The fix sits where the precondition lives: the index-level entry points of layer 1 (Eval, PartialU, PartialV,
// NormalOr, AreaElement in geometry-surfaces.library.plato, LimitNormal in limit-normal.library.plato) evaluate at
// EvaluatedAt, which moves a closed direction's out-of-range coordinate to its copy in the range (IntoClosedRange). A coordinate in the range, and every periodic
// or aperiodic direction, is passed as given, so every evaluation that was right keeps its bits: an analytic
// surface's formula is periodic already, and a closed direction's in-range seam value keeps its one-sided partials.
library V1ReliabilityClosedWrap
{
    // True when the direction is closed: layer 3 marked it, and its record is not periodic by formula.
    IsClosedDirection(d: CurveDomain): Boolean
        => match (d.Periodicity)
        {
            Aperiodic => false;
            Periodic(period) => false;
            Closed(period) => true;
        };

    // The closed direction's period; 0 for any other.
    ClosedPeriod(d: CurveDomain): Number
        => match (d.Periodicity)
        {
            Aperiodic => 0.0;
            Periodic(period) => 0.0;
            Closed(period) => period;
        };

    // t moved by whole periods into the range when the direction is closed and t lies outside the range; t itself
    // otherwise.
    IntoClosedRange(d: CurveDomain, t: Number): Number
        => (d.IsClosedDirection && (t < d.Range.Start || t > d.Range.End) && d.CanWrap(t)) ? d.Wrap(t) : t;

    // uv with each closed direction's out-of-range coordinate moved into its range.
    IntoClosedRange(d: SurfaceDomain, uv: UvCoordinate): UvCoordinate
        => UvCoordinate(d.U.IntoClosedRange(uv.U), d.V.IntoClosedRange(uv.V));

    // The parameters surface s is evaluated at for uv: IntoClosedRange of its domain (DomainOnce, the record's
    // natural domain with layer 3's closure marks).
    EvaluatedAt(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): UvCoordinate
        => g.DomainOnce(s).IntoClosedRange(uv);
}

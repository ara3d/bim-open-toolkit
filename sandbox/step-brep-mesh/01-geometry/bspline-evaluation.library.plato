//==
// # BsplineEvaluation
//
// Track F of docs/plans/step-mesher-v2.md (TKT-327): bodies for layer 1's
// deferred B-spline evaluation (geometry-splines.library.plato, "Evaluation
// (deferred)"), staged as <Name>Body until the supervisor wires them in.
// Every evaluation is de Boor's algorithm over the homogeneous control
// values (w P, w) of the knot span holding the parameter
// (https://en.wikipedia.org/wiki/De_Boor%27s_algorithm); a derivative is de
// Boor over the hodograph's control values, the differences of the local
// ones (Piegl and Tiller, The NURBS Book, 2nd ed., section 3.3), and a
// rational derivative follows from the homogeneous ones by the quotient rule
// (section 4.3, algorithms A4.2 and A4.4). The cost is O(p^2) per curve
// evaluation and O(p_u p_v (p_u + p_v)) per surface evaluation, after a
// binary search for the span.
//
// A parameter outside the domain is evaluated on the polynomial piece of the
// nearest end span: the continuation a Newton step slightly past an end
// needs, never a clamp.
//
// Sections, in order:
//  - Homogeneous arithmetic
//  - Knot spans
//  - De Boor's algorithm, blossoms and the hodograph
//  - Curves
//  - Parameter-plane curves
//  - Surfaces

library BsplineEvaluation
{
    //==
    // # Homogeneous arithmetic
    //
    // The stdlib's HomogeneousPoint3D as a vector space: de Boor's algorithm
    // and the hodograph need sums, differences and scaling of (w x, w y, w z, w).

    // The componentwise sum.
    Add(a: HomogeneousPoint3D, b: HomogeneousPoint3D): HomogeneousPoint3D
        => HomogeneousPoint3D(a.X + b.X, a.Y + b.Y, a.Z + b.Z, a.W + b.W);

    // The componentwise difference.
    Subtract(a: HomogeneousPoint3D, b: HomogeneousPoint3D): HomogeneousPoint3D
        => HomogeneousPoint3D(a.X - b.X, a.Y - b.Y, a.Z - b.Z, a.W - b.W);

    // Every component times s.
    Multiply(a: HomogeneousPoint3D, s: Number): HomogeneousPoint3D
        => HomogeneousPoint3D(a.X * s, a.Y * s, a.Z * s, a.W * s);

    // (1 - t) a + t b.
    Lerp(a: HomogeneousPoint3D, b: HomogeneousPoint3D, t: Number): HomogeneousPoint3D
        => a * (1.0 - t) + b * t;

    // The zero of the space, the value of a derivative of order above the degree.
    HomogeneousZero(_: HomogeneousPoint3D): HomogeneousPoint3D
        => HomogeneousPoint3D(0.0, 0.0, 0.0, 0.0);

    // The weighted control value (w P, w) of a space point.
    Weighted(p: Point3D, w: Number): HomogeneousPoint3D
        => HomogeneousPoint3D(p.X * w, p.Y * w, p.Z * w, w);

    // The weighted control value of a parameter-plane point, in the x and y slots.
    Weighted(p: UvCoordinate, w: Number): HomogeneousPoint3D
        => HomogeneousPoint3D(p.U * w, p.V * w, 0.0, w);

    // The spatial part (x, y, z) of a homogeneous value, as a vector.
    Spatial(a: HomogeneousPoint3D): Vector3D
        => Vector3D(a.X, a.Y, a.Z);

    //==
    // # Knot spans

    // The span k holding t for a basis with n control points: Knots[k] <= t <
    // Knots[k + 1] with Degree <= k < n, found by bisection. A t at or past
    // the domain's end takes the last non-empty span, and one before its
    // start the first, so the piece used is the one the domain ends on.
    // Precondition: the basis is well shaped for n (IsWellShaped).
    SplineSpan(b: SplineBasis, n: Integer, t: Number): Integer
    {
        var p = b.Degree;
        var k = p;
        if (t >= b.Knots.KnotAt(n))
        {
            k = n - 1;
            while (k > p && b.Knots.KnotAt(k) >= b.Knots.KnotAt(n))
            {
                k = k - 1;
            }
        }
        else
        {
            var lo = p;
            var hi = n;
            while (hi - lo > 1)
            {
                var mid = (lo + hi) / 2;
                if (t < b.Knots.KnotAt(mid))
                {
                    hi = mid;
                }
                else
                {
                    lo = mid;
                }
            }
            k = lo;
            while (k < n - 1 && b.Knots.KnotAt(k + 1) <= b.Knots.KnotAt(p))
            {
                k = k + 1;
            }
        }
        return k;
    }

    //==
    // # De Boor's algorithm, blossoms and the hodograph
    //
    // A spline of degree p is read at span k through its p + 1 local control
    // values, local[j] = Q_(k - p + j), and its knots u_x = knots[x + shift]:
    // the hodograph of a spline drops the first knot, so its knots are the
    // same vector read with the shift one higher.

    // The knot u_x of a basis read with the given shift.
    ShiftedKnot(knots: KnotVector, shift: Integer, x: Integer): Number
        => knots.KnotAt(x + shift);

    // The blossom of the spline of degree p at the level parameters ts
    // (one per level, p in all), from its local control values d at span k
    // at level r - 1 of de Boor's triangle: level r replaces d_j by (1 - a)
    // d_(j-1) + a d_j, a = (x - u_(k-p+j)) / (u_(k+1+j-r) - u_(k-p+j)) with
    // x = ts[r - 1], for j = r .. p, stored at position j - r. Starts at r =
    // 1. With every level parameter t it is de Boor's algorithm, the value
    // at t; with p - j copies of a and j of b it is control point j of the
    // Bezier form of the span's piece over [a, b] (the blossom's
    // https://en.wikipedia.org/wiki/Blossom_(functional) property).
    DeBoorLevels(d: Array<HomogeneousPoint3D>, knots: KnotVector, shift: Integer, p: Integer, k: Integer, r: Integer, ts: Array<Number>): HomogeneousPoint3D
        => d.Count <= 1
            ? d[0]
            : DeBoorLevels(
                (d.Count - 1).MapRange(m => d[m].Lerp(d[m + 1], KnotRatio(
                    ts[r - 1] - knots.ShiftedKnot(shift, k - p + m + r),
                    knots.ShiftedKnot(shift, k + 1 + m) - knots.ShiftedKnot(shift, k - p + m + r)))),
                knots, shift, p, k, r + 1, ts);

    // The order-th derivative at t of the spline of degree p with local
    // control values `local` at span k. Order 0 is de Boor's algorithm;
    // order m differentiates once by the hodograph, Q'_i = p (Q_(i+1) - Q_i)
    // / (u_(i+p+1) - u_(i+1)), a spline of degree p - 1 at span k - 1 of the
    // knots shifted by one, whose local values are the p differences of the
    // local ones. Zero once the order passes the degree.
    LocalDerivative(local: Array<HomogeneousPoint3D>, knots: KnotVector, shift: Integer, p: Integer, k: Integer, order: Integer, t: Number): HomogeneousPoint3D
        => order <= 0
            ? DeBoorLevels(local, knots, shift, p, k, 1, p.MapRange(i => t))
            : (p < 1
                ? HomogeneousPoint3D.HomogeneousZero
                : LocalDerivative(
                    p.MapRange(j => (local[j + 1] - local[j]) * KnotRatio(p.ToNumber,
                        knots.ShiftedKnot(shift, k + j + 1) - knots.ShiftedKnot(shift, k - p + j + 1))),
                    knots, shift + 1, p - 1, k - 1, order - 1, t));

    // The homogeneous derivative of the given order at t of the spline with
    // basis b over the control values `values` (one per control point).
    HomogeneousDerivative(b: SplineBasis, values: Array<HomogeneousPoint3D>, order: Integer, t: Number): HomogeneousPoint3D
    {
        var k = b.SplineSpan(values.Count, t);
        return LocalDerivative((b.Degree + 1).MapRange(j => values[k - b.Degree + j]), b.Knots, 0, b.Degree, k, order, t);
    }

    // The p + 1 homogeneous Bezier control values of the piece over [a, b]
    // of the spline with basis b and control values `values`, where [a, b]
    // lies in one knot span: control j is the blossom at p - j copies of a
    // and j copies of b. With positive weights the piece lies in the convex
    // hull of their projections (Piegl and Tiller, section 5.3).
    BezierControls(b: SplineBasis, values: Array<HomogeneousPoint3D>, lo: Number, hi: Number): Array<HomogeneousPoint3D>
    {
        var k = b.SplineSpan(values.Count, 0.5 * (lo + hi));
        var local = (b.Degree + 1).MapRange(j => values[k - b.Degree + j]);
        return (b.Degree + 1).MapRange(j => DeBoorLevels(local, b.Knots, 0, b.Degree, k, 1,
            b.Degree.MapRange(i => i < b.Degree - j ? lo : hi)));
    }

    // The point, first and second derivatives of the rational curve A / w,
    // from the homogeneous derivatives h0, h1, h2 by the quotient rule: C =
    // A / w, C' = (A' - w' C) / w, C'' = (A'' - 2 w' C' - w'' C) / w.
    RationalDerivative(h0: HomogeneousPoint3D, h1: HomogeneousPoint3D, h2: HomogeneousPoint3D, order: Integer): Vector3D
    {
        var c0 = h0.Spatial * (1.0 / h0.W);
        var c1 = (h1.Spatial - c0 * h1.W) * (1.0 / h0.W);
        return order <= 0
            ? c0
            : (order == 1 ? c1 : (h2.Spatial - c1 * (2.0 * h1.W) - c0 * h2.W) * (1.0 / h0.W));
    }

    // The derivative of the given order (0 the point's position vector, 1 or
    // 2) of a rational curve with basis b and homogeneous control values.
    CurveDerivative(b: SplineBasis, values: Array<HomogeneousPoint3D>, order: Integer, t: Number): Vector3D
        => RationalDerivative(
            b.HomogeneousDerivative(values, 0, t),
            order >= 1 ? b.HomogeneousDerivative(values, 1, t) : HomogeneousPoint3D.HomogeneousZero,
            order >= 2 ? b.HomogeneousDerivative(values, 2, t) : HomogeneousPoint3D.HomogeneousZero,
            order);

    //==
    // # Curves

    // The homogeneous control values (w_i P_i, w_i) of a space curve.
    HomogeneousControls(d: BSplineCurveData): Array<HomogeneousPoint3D>
        => d.ControlPoints.Count.MapRange(i => d.ControlPoints[i].Weighted(d.Weights[i]));

    // Body of layer 1's BSplinePoint (space curve): de Boor on the
    // homogeneous control values, divided by the weight.
    BSplinePointBody(d: BSplineCurveData, t: Number): Point3D
        => d.Basis.CurveDerivative(d.HomogeneousControls, 0, t).ToPoint;

    // Body of layer 1's BSplineDerivative (space curve): the order-th
    // derivative, 1 or 2, by the quotient rule over the homogeneous ones.
    BSplineDerivativeBody(d: BSplineCurveData, t: Number, order: Integer): Vector3D
        => d.Basis.CurveDerivative(d.HomogeneousControls, order, t);

    //==
    // # Parameter-plane curves

    // The homogeneous control values (w_i u_i, w_i v_i, 0, w_i) of a
    // parameter-plane curve.
    HomogeneousControls(d: BSplineCurve2DData): Array<HomogeneousPoint3D>
        => d.ControlPoints.Count.MapRange(i => d.ControlPoints[i].Weighted(d.Weights[i]));

    // Body of layer 1's BSplinePoint (parameter-plane curve).
    BSplinePointBody(d: BSplineCurve2DData, t: Number): UvCoordinate
    {
        var c = d.Basis.CurveDerivative(d.HomogeneousControls, 0, t);
        return UvCoordinate(c.X, c.Y);
    }

    // Body of layer 1's BSplineDerivative (parameter-plane curve).
    BSplineDerivativeBody(d: BSplineCurve2DData, t: Number, order: Integer): Vector2D
    {
        var c = d.Basis.CurveDerivative(d.HomogeneousControls, order, t);
        return Vector2D(c.X, c.Y);
    }

    //==
    // # Surfaces
    //
    // The net is read column by column: column i holds P_ij for every j, a
    // curve in v. A mixed homogeneous partial of order (a, b) is the order-b
    // v-derivative of each of the p_u + 1 local columns at v, then the
    // order-a u-derivative of the curve those values control, at u.

    // The homogeneous partial of order (a, b) of the surface at uv.
    HomogeneousPartial(d: BSplineSurfaceData, uv: UvCoordinate, a: Integer, b: Integer): HomogeneousPoint3D
    {
        var nu = d.ControlPoints.ColumnCount;
        var nv = d.ControlPoints.RowCount;
        var ku = d.U.SplineSpan(nu, uv.U);
        var kv = d.V.SplineSpan(nv, uv.V);
        var pu = d.U.Degree;
        var pv = d.V.Degree;
        var columns = (pu + 1).MapRange(i => LocalDerivative(
            (pv + 1).MapRange(j => d.ControlPoints.At(ku - pu + i, kv - pv + j).Weighted(d.Weights.At(ku - pu + i, kv - pv + j))),
            d.V.Knots, 0, pv, kv, b, uv.V));
        return LocalDerivative(columns, d.U.Knots, 0, pu, ku, a, uv.U);
    }

    // The rational partial of order (a, b), a + b at most 2, from the
    // homogeneous ones by the quotient rule (Piegl and Tiller, A4.4): with S
    // = A / w, S_u = (A_u - w_u S) / w, S_uu = (A_uu - 2 w_u S_u - w_uu S) /
    // w, S_uv = (A_uv - w_uv S - w_u S_v - w_v S_u) / w, and the same in v.
    RationalPartial(d: BSplineSurfaceData, uv: UvCoordinate, a: Integer, b: Integer): Vector3D
    {
        var h = d.HomogeneousPartial(uv, 0, 0);
        var s = h.Spatial * (1.0 / h.W);
        var hu = a >= 1 ? d.HomogeneousPartial(uv, 1, 0) : HomogeneousPoint3D.HomogeneousZero;
        var hv = b >= 1 ? d.HomogeneousPartial(uv, 0, 1) : HomogeneousPoint3D.HomogeneousZero;
        var su = (hu.Spatial - s * hu.W) * (1.0 / h.W);
        var sv = (hv.Spatial - s * hv.W) * (1.0 / h.W);
        var hab = a + b >= 2 ? d.HomogeneousPartial(uv, a, b) : HomogeneousPoint3D.HomogeneousZero;
        return a + b <= 0
            ? s
            : (a + b == 1
                ? (a == 1 ? su : sv)
                : (a == 2
                    ? (hab.Spatial - su * (2.0 * hu.W) - s * hab.W) * (1.0 / h.W)
                    : (b == 2
                        ? (hab.Spatial - sv * (2.0 * hv.W) - s * hab.W) * (1.0 / h.W)
                        : (hab.Spatial - s * hab.W - sv * hu.W - su * hv.W) * (1.0 / h.W))));
    }

    // Body of layer 1's BSplinePoint (surface): tensor-product de Boor on
    // the homogeneous net, divided by the weight.
    BSplinePointBody(d: BSplineSurfaceData, uv: UvCoordinate): Point3D
        => d.RationalPartial(uv, 0, 0).ToPoint;

    // Body of layer 1's BSplinePartial: the mixed partial of order (uOrder,
    // vOrder), each 0 to 2 with a sum of 1 or 2, of the rational surface.
    BSplinePartialBody(d: BSplineSurfaceData, uv: UvCoordinate, uOrder: Integer, vOrder: Integer): Vector3D
        => d.RationalPartial(uv, uOrder, vOrder);
}

//==
// # Laws of kinds, degeneracies, seams, and poles
//
// Run on the witness arena (geometry-arena.library.plato). KindOf is
// total by the sum checker (an exhaustive match); the laws below show every
// kind inhabited and the derived values agreeing with layer 1's own
// predicates.
//
// Sections, in order:
//  - Kinds
//  - Degeneracies
//  - Seams
//  - Poles
//==

library BrepGeometryKindsLaws
{
    //==
    // # Kinds

    // A line is LineKind.
    Law_LineKindIsInhabited(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.Curves[0].KindOf == CurveKind.LineKind;

    // Each of the four conics is ConicKind (k chooses among curves 1 to 4).
    Law_ConicKindIsInhabited(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.Curves[1 + k.FixtureIndex(4)].KindOf == CurveKind.ConicKind;

    // A polyline is PolylineKind.
    Law_PolylineKindIsInhabited(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.Curves[5].KindOf == CurveKind.PolylineKind;

    // A B-spline curve is SplineKind.
    Law_SplineCurveKindIsInhabited(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.Curves[6].KindOf == CurveKind.SplineKind;

    // Trimmed, composite, offset and surface curves are DerivedKind (k
    // chooses among curves 7 to 10).
    Law_DerivedCurveKindIsInhabited(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.Curves[7 + k.FixtureIndex(4)].KindOf == CurveKind.DerivedKind;

    // A plane is PlaneKind.
    Law_PlaneKindIsInhabited(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.Surfaces[0].KindOf == SurfaceKind.PlaneKind;

    // Cylinder, cone and sphere are QuadricKind.
    Law_QuadricKindIsInhabited(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.Surfaces[1 + k.FixtureIndex(3)].KindOf == SurfaceKind.QuadricKind;

    // A torus is ToroidalKind.
    Law_ToroidalKindIsInhabited(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.Surfaces[4].KindOf == SurfaceKind.ToroidalKind;

    // Revolution and extrusion are SweptKind.
    Law_SweptKindIsInhabited(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.Surfaces[5 + k.FixtureIndex(2)].KindOf == SurfaceKind.SweptKind;

    // A B-spline surface is SplineKind.
    Law_SplineSurfaceKindIsInhabited(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.Surfaces[7].KindOf == SurfaceKind.SplineKind;

    // Trimmed and offset surfaces are DerivedKind.
    Law_DerivedSurfaceKindIsInhabited(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.Surfaces[8 + k.FixtureIndex(2)].KindOf == SurfaceKind.DerivedKind;

    //==
    // # Degeneracies

    // The sides a surface's Degeneracy names are its DegenerateSides, in
    // order, for every surface of the arena.
    Law_DegeneracyAgreesWithDegenerateSides(k: Integer): Boolean
    {
        var g = GeometrySet.Witness_CatalogArena;
        var s = k.CatalogSurfaceOf(g.Surfaces.Count);
        var tol = Tolerances.Witness_Tolerances;
        var named = g.DegeneracyOf(s, tol).SidesOf;
        var sides = g.DegenerateSides(s, tol);
        return named.Count == sides.Count
            ? named.Count.Range.All(i => named[i] == sides[i])
            : false;
    }

    // A sphere's degeneracy is its two poles.
    Law_SphereHasTwoCollapsedSides(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.DegeneracyOf(SurfaceIndex(3), Tolerances.Witness_Tolerances).IsTwoSides;

    // A cone's degeneracy is its apex, the iso-line v = -R / tan a.
    Law_ConeHasApex(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.DegeneracyOf(SurfaceIndex(2), Tolerances.Witness_Tolerances).IsApexAtV(-1.0 / Angle(0.5).Tan);

    // A cylinder has no degeneracy.
    Law_CylinderHasNoDegeneracy(k: Integer): Boolean
        => GeometrySet.Witness_CatalogArena.DegeneracyOf(SurfaceIndex(1), Tolerances.Witness_Tolerances).IsNoDegeneracy;

    // True for CollapsedTwoSides.
    IsTwoSides(d: Degeneracy): Boolean
        => match (d)
        {
            NoDegeneracy => false;
            CollapsedSide(side) => false;
            CollapsedTwoSides(a, b) => true;
            CollapsedSides(sides) => false;
            Apex(at) => false;
        };

    // True for NoDegeneracy.
    IsNoDegeneracy(d: Degeneracy): Boolean
        => match (d)
        {
            NoDegeneracy => true;
            CollapsedSide(side) => false;
            CollapsedTwoSides(a, b) => false;
            CollapsedSides(sides) => false;
            Apex(at) => false;
        };

    // True for an Apex on an iso-line of constant v whose value agrees with v0
    // to rounding.
    IsApexAtV(d: Degeneracy, v0: Number): Boolean
        => match (d)
        {
            NoDegeneracy => false;
            CollapsedSide(side) => false;
            CollapsedTwoSides(a, b) => false;
            CollapsedSides(sides) => false;
            Apex(at) => at.Constant == SurfaceParameter.ParameterV && CatalogAgreesToRounding(at.Fixed, v0);
        };

    //==
    // # Seams

    // A direction has a Seam exactly when its domain HasSeam, for every
    // surface of the arena and both directions (j chooses).
    Law_SeamsAgreeWithHasSeam(k: Integer, j: Integer): Boolean
    {
        var g = GeometrySet.Witness_CatalogArena;
        var s = k.CatalogSurfaceOf(g.Surfaces.Count);
        var which = j % 2 == 0 ? SurfaceParameter.ParameterU : SurfaceParameter.ParameterV;
        return g.SeamsOf(s).SeamIn(which).IsSeam == g.Domain(s).DomainAlong(which).HasSeam;
    }

    // A seam names its own direction and lies at its range's start.
    Law_SeamIsAtRangeStart(k: Integer, j: Integer): Boolean
    {
        var g = GeometrySet.Witness_CatalogArena;
        var s = k.CatalogSurfaceOf(g.Surfaces.Count);
        var which = j % 2 == 0 ? SurfaceParameter.ParameterU : SurfaceParameter.ParameterV;
        return g.SeamsOf(s).SeamIn(which).IsSeamOf(which, g.Domain(s).DomainAlong(which).Range.Start);
    }

    // True for NoSeam, or for SeamAt(which, start).
    IsSeamOf(s: Seam, which: SurfaceParameter, start: Number): Boolean
        => match (s)
        {
            NoSeam => true;
            SeamAt(direction, at) => direction == which && at == start;   // exact by construction
        };

    //==
    // # Poles

    // The pole of a collapsed side is the side's image: every point of the
    // side evaluates to the pole's point within the length tolerance (the
    // sphere's two sides).
    Law_PolePointIsSideImage(f: Number): Boolean
    {
        var g = GeometrySet.Witness_CatalogArena;
        var tol = Tolerances.Witness_Tolerances;
        var s = SurfaceIndex(3);
        return g.DegenerateSides(s, tol).All(side => g.Eval(s, g.Domain(s).SidePointAt(side, f.UnitFraction).ToUvCoordinate)
            .Distance(g.PoleAt(s, side).Point) <= tol.Length.Value);
    }

    // Every point of a pole segment lies on the pole's side.
    Law_PoleSegmentLiesOnSide(n: Integer): Boolean
    {
        var g = GeometrySet.Witness_CatalogArena;
        var s = SurfaceIndex(3);
        var d = g.Domain(s);
        var segment = g.PoleSegmentOf(s, g.PoleAt(s, DomainSide.VMax), SampleCount(2 + n.FixtureIndex(8)));
        return segment.Points.All(p => p.V == d.SideValue(DomainSide.VMax));   // exact by construction
    }

    // A pole segment has the requested number of points.
    Law_PoleSegmentHasCount(n: Integer): Boolean
    {
        var g = GeometrySet.Witness_CatalogArena;
        var s = SurfaceIndex(3);
        var count = 2 + n.FixtureIndex(8);
        return g.PoleSegmentOf(s, g.PoleAt(s, DomainSide.VMin), SampleCount(count)).Points.Count == count;
    }
}

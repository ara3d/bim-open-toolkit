//==
// # Proofs about placements (laws)
//
// Over the runner's own Frame3D and AngleTolerance values: the constructor
// succeeds exactly when IsOrthonormalEitherHandWithin holds, and records
// the sign of the frame's Handedness. The B-spline proofs' laws mesh layer
// 8's curve fixtures, so they are layer 8's
// (pipeline-proofs-bsplines.laws.plato).
//
// Sections, in order:
//  - Frames

library BrepGeometryProofsLaws
{
    //==
    // # Frames

    // CheckOrthonormalFrame succeeds exactly when the frame's
    // orthonormality deviation is within the tolerance.
    Law_OrthonormalFrameIffWithinTolerance(f: Frame3D, tol: AngleTolerance): Boolean
        => CheckOrthonormalFrame(f, tol).IsDecided == (f.OrthonormalityDeviation <= tol.Value.Radians);

    // Every right-handed orthonormal frame (IsOrthonormalWithin) passes the
    // check.
    Law_RigidFrameIsOrthonormal(f: Frame3D, tol: AngleTolerance): Boolean
        => f.IsOrthonormalWithin(tol) ? CheckOrthonormalFrame(f, tol).IsDecided : true;

    // An OrthonormalFrame records the sign of the frame's Handedness.
    Law_OrthonormalFrameRecordsHandedness(f: Frame3D, tol: AngleTolerance): Boolean
        => CatalogHandednessRecorded(f, CheckOrthonormalFrame(f, tol));

    // The claim of Law_OrthonormalFrameRecordsHandedness for the result d
    // of checking f.
    CatalogHandednessRecorded(f: Frame3D, d: DecidedOrthonormalFrame): Boolean
        => match (d) {
            Decided(p) => p.Handedness == (f.Handedness > 0.0 ? Sign.Positive : Sign.Negative) && p.Frame == f;
            Undecided(r) => true;
        };
}

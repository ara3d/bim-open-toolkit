//==
// # Specs: spline spans, hulls, and placements
//
// Invariants and constructors of the types in geometry-spans.types.plato
// (SPEC-DSL.md section 3). Each invariant names the law that checks it. Not
// compiled.
//==

spec BSplineSpan
{
    invariant self.Range.Start < self.Range.End;   // Law_SpansAreNonEmpty
    constructor SpansOf;
}

spec SpansOf(b: SplineBasis): Array<BSplineSpan>
{
    requires b.KnotsNonDecreasing;
    ensures Law_SpansAreContiguous;   // strictly increasing, each ends where the next starts
    ensures result.First.Range.Start == b.SplineDomain.Start;   // exact by construction: Law_SpansCoverDomain
    ensures result.Last.Range.End == b.SplineDomain.End;        // exact by construction
}

spec ControlPolygon
{
    invariant self.Points.Count >= 1;   // Degree + 1 from ControlPolygonOf: Law_ControlPolygonHasDegreePlusOnePoints
    constructor ControlPolygonOf;
}

spec ConvexHullBound
{
    invariant self.Bound.Value >= 0.0;
    invariant Law_SpanLiesWithinHullBound;
    constructor HullBoundOf;
}

spec Placement
{
    constructor ToPlacement;   // the handedness is the frame's: Law_PlacementHandednessIsFrames
}

//==
// # BrepGeometryLaws
//
// Layer 1 of the STEP B-rep to mesh design (README.md beside this file): the
// laws of the geometry arena, with the helpers that state their claims and two
// oracles. Every Law_ returns Boolean and holds for all values of its
// parameters (SPEC-DSL.md section 2): a leading guard, written with the
// conditional because && evaluates both sides, makes it vacuously true where
// its claim would index out of range or evaluate an ill-formed arena
// (CanEvaluate). A law over a continuous parameter takes the sample and moves
// it into the domain itself. Every approximate comparison names a tolerance
// from Tolerances, or layer 0's ResolutionAt for rounding; exact == appears
// only on integers, tags, and values copied from the file, marked "exact by
// construction". A law over GeometrySet or a B-spline record holds arrays, so
// the law runner cannot build random instances (PLATO-PRIMER.md B.2): these
// laws run on witnesses with the witness model's own tolerances, which are no
// finer than the arithmetic can honour (layer 0's IsResolvable).
//
// Sections, in order:
//  - Sampling
//  - The arena
//  - Placements
//  - B-spline records
//  - Curves: period and closure
//  - Curves: derivatives
//  - Curves: inverse evaluation
//  - Curves, case by case
//  - Parameter-plane curves and pcurves
//  - Surfaces: period
//  - Surfaces: derivatives, normal, area element
//  - Surfaces: closed-form area elements
//  - Surfaces: inverse evaluation
//  - Surfaces: collapsed lines and degenerate sides
//  - Surfaces, case by case
//  - Scaling
//  - Oracles

library BrepGeometryLaws
{
    //==
    // # Sampling

    // t moved into the domain: wrapped into the window when periodic, clamped
    // into the range otherwise (an unbounded range clamps only at the largest
    // finite Numbers).
    SampleIn(d: CurveDomain, t: Number): Number
        => match (d.Periodicity)
        {
            Aperiodic => t.Max(d.Range.Start).Min(d.Range.End);
            Periodic(period) => d.CanWrap(t) ? d.Wrap(t) : d.Range.Start;
            Closed(period) => d.CanWrap(t) ? d.Wrap(t) : d.Range.Start;
        };

    // uv moved into the surface domain, one coordinate at a time.
    SampleIn(d: SurfaceDomain, uv: UvCoordinate): UvCoordinate
        => UvCoordinate(d.U.SampleIn(uv.U), d.V.SampleIn(uv.V));

    // The parameter's natural scale: the period over 2 pi when periodic (1 for
    // an angle), the range's length when bounded, max(|t|, 1) when unbounded.
    ParameterScale(d: CurveDomain, t: Number): Number
        => match (d.Periodicity)
        {
            Aperiodic => d.ParameterLength.IsFinite ? d.ParameterLength : t.Abs.Max(1.0);
            Periodic(period) => period / Number.Tau;
            Closed(period) => period;
        };

    // The step of the central differences: the cube root of the unit roundoff
    // times the given scale, the step that balances truncation against
    // rounding (Press et al., Numerical Recipes, 3rd ed., section 5.7).
    // 4.8e-6 of the scale in 64 bits, 2.5e-3 in 32.
    DifferenceStep(scale: Number): Number
        => Number.RoundingUnit.Pow(1.0 / 3.0) * scale;

    // The smoothness the difference laws ask of what they difference.
    // Richardson's estimate (WithinRichardson) rests on the expansion of a
    // central difference to its h^4 term, which needs five continuous
    // derivatives of the function differenced; the second-derivative laws
    // difference the first derivative, so six of the curve. Breaks of this
    // order are excluded from every difference interval.
    DifferenceOrder(_: Integer): Integer
        => 6;

    // The scale of the difference step at t: the domain's natural scale
    // (ParameterScale), or the shortest piece the breaks and a bounded
    // range's ends cut the parameter into when that is shorter, so the step
    // fits inside every smooth piece of a spline with short knot spans.
    PieceScale(d: CurveDomain, breaks: Array<Number>, t: Number): Number
        => (d.ParameterLength.IsFinite ? breaks.Concatenate([d.Range.Start, d.Range.End]) : breaks)
            .SmallestGap(d.ParameterScale(t));

    // The smallest positive difference between two of the values, at most
    // bound.
    SmallestGap(values: Array<Number>, bound: Number): Number
        => values.Reduce(bound, (m, a) => values.Reduce(m, (n, b) => a < b ? n.Min(b - a) : n));

    // Richardson's estimate of the error of a central difference
    // (https://en.wikipedia.org/wiki/Richardson_extrapolation). With
    // D(h) = f' + a h^2 + b h^4 + ..., D(h) - D(h/2) = (3/4) a h^2, so the
    // error a h^2 / 4 of the finer quotient is a third of the difference of
    // the two. The factor 4/3 keeps four times that, a margin for the h^4
    // term; rounding bounds the rounding of the two quotients. The estimate
    // calibrates itself to the function: no tolerance of the model enters.
    WithinRichardson(coarse: Vector3D, fine: Vector3D, exact: Vector3D, rounding: Number): Boolean
        => (fine - exact).Length <= (coarse - fine).Length * (4.0 / 3.0) + rounding;

    // WithinRichardson in the parameter plane.
    WithinRichardson(coarse: Vector2D, fine: Vector2D, exact: Vector2D, rounding: Number): Boolean
        => (fine - exact).Length <= (coarse - fine).Length * (4.0 / 3.0) + rounding;

    // True when a sample and both its neighbours at distance h fit in the
    // domain.
    HasInterior(d: CurveDomain, h: Number): Boolean
        => d.Periodicity.IsPeriodic ? true : d.Range.End - d.Range.Start > h + h;

    // t moved into the domain shrunk by h at each end, so t - h and t + h
    // stay inside; wrapped when periodic.
    InteriorSample(d: CurveDomain, t: Number, h: Number): Number
        => d.Periodicity.IsPeriodic ? d.SampleIn(t) : t.Max(d.Range.Start + h).Min(d.Range.End - h);

    // True when some breakpoint lies strictly between t - h and t + h, where a
    // central difference would straddle a jump of the derivative.
    StraddlesBreakpoint(breaks: Array<Number>, t: Number, h: Number): Boolean
        => breaks.Any(b => t - h < b && b < t + h);

    //==
    // # The arena

    // Every index curve c holds names an entry of the arena.
    Law_CurveReferencesInRange(g: GeometrySet, c: CurveIndex): Boolean
        => g.IsCurveInRange(c) ? g.ReferencesInRange(g.CurveAt(c)) : true;

    // Every index parameter-plane curve c holds names an entry of the arena.
    Law_Curve2DReferencesInRange(g: GeometrySet, c: Curve2DIndex): Boolean
        => g.IsCurve2DInRange(c) ? g.ReferencesInRange(g.Curve2DAt(c)) : true;

    // Pcurve p's surface and 2D curve are entries of the arena.
    Law_PcurveReferencesInRange(g: GeometrySet, p: PcurveIndex): Boolean
        => g.IsPcurveInRange(p) ? g.ReferencesInRange(g.PcurveAt(p)) : true;

    // Every index surface s holds names an entry of the arena.
    Law_SurfaceReferencesInRange(g: GeometrySet, s: SurfaceIndex): Boolean
        => g.IsSurfaceInRange(s) ? g.ReferencesInRange(g.SurfaceAt(s)) : true;

    // No chain of references from curve c returns to an entry it has passed.
    Law_CurveReferencesAcyclic(g: GeometrySet, c: CurveIndex): Boolean
        => g.IsCurveInRange(c) ? g.IsAcyclicFrom(c) : true;

    // No chain of references from parameter-plane curve c repeats an entry.
    Law_Curve2DReferencesAcyclic(g: GeometrySet, c: Curve2DIndex): Boolean
        => g.IsCurve2DInRange(c) ? g.IsAcyclicFrom(c) : true;

    // No chain of references from surface s repeats an entry.
    Law_SurfaceReferencesAcyclic(g: GeometrySet, s: SurfaceIndex): Boolean
        => g.IsSurfaceInRange(s) ? g.IsAcyclicFrom(s) : true;

    // The k-th closure mark names an entry of the arena.
    Law_ClosureMarkInRange(g: GeometrySet, k: Integer): Boolean
        => g.Closures.IsValidIndex(k) ? g.ReferencesInRange(g.Closures[k]) : true;

    // The k-th closure mark names a record whose natural domain in that
    // direction is bounded and aperiodic, the only kind a mark changes.
    Law_ClosureMarkNamesBoundedAperiodic(g: GeometrySet, k: Integer): Boolean
        => g.Closures.IsValidIndex(k) ? (g.ReferencesInRange(g.Closures[k]) ? g.MarkIsMeaningful(g.Closures[k]) : true) : true;

    // The claim of Law_ClosureMarkNamesBoundedAperiodic for one mark.
    // Precondition: the mark is in range.
    MarkIsMeaningful(g: GeometrySet, mark: ClosureMark): Boolean
        => match (mark)
        {
            ClosedCurve(curve) => g.CurveAt(curve).Domain(g).IsBoundedAperiodic;
            ClosedCurve2D(curve) => g.Curve2DAt(curve).Domain(g).IsBoundedAperiodic;
            ClosedSurface(surface, direction) => g.SurfaceAt(surface).Domain(g).DomainAlong(direction).IsBoundedAperiodic;
        };

    // True when the domain neither wraps nor is unbounded.
    IsBoundedAperiodic(d: CurveDomain): Boolean
        => !d.HasSeam && d.ParameterLength.IsFinite;

    // Curve c's arrays have the sizes its formula reads.
    Law_CurveHasEvaluableShape(g: GeometrySet, c: CurveIndex): Boolean
        => g.IsCurveInRange(c) ? g.CurveAt(c).HasEvaluableShape : true;

    // Parameter-plane curve c's arrays have the sizes its formula reads.
    Law_Curve2DHasEvaluableShape(g: GeometrySet, c: Curve2DIndex): Boolean
        => g.IsCurve2DInRange(c) ? g.Curve2DAt(c).HasEvaluableShape : true;

    // Surface s's arrays have the sizes its formula reads, and a spindle
    // torus part has major below minor (degenerate_toroidal_surface WR1).
    Law_SurfaceHasEvaluableShape(g: GeometrySet, s: SurfaceIndex): Boolean
        => g.IsSurfaceInRange(s) ? g.SurfaceAt(s).HasEvaluableShape : true;

    //==
    // # Placements

    // Curve c's placement is orthonormal, of either handedness, within the
    // angle tolerance, and an offset curve's reference direction is a unit
    // vector: PlacementDeviation is at most the tolerance in radians. A
    // mirrored placement (Handedness -1) is legal STEP: a
    // cartesian_transformation_operator may carry a negative determinant.
    Law_CurvePlacementOrthonormal(g: GeometrySet, c: CurveIndex, tol: Tolerances): Boolean
        => g.IsCurveInRange(c) ? g.PlacementDeviation(c) <= tol.Angle.Value.Radians : true;

    // Parameter-plane curve c's placement is orthonormal and counter-clockwise
    // within the angle tolerance.
    Law_Curve2DPlacementOrthonormal(g: GeometrySet, c: Curve2DIndex, tol: Tolerances): Boolean
        => g.IsCurve2DInRange(c) ? g.PlacementDeviation(c) <= tol.Angle.Value.Radians : true;

    // Surface s's placement is orthonormal, of either handedness, and a
    // surface of revolution's axis is a unit vector, within the angle
    // tolerance.
    Law_SurfacePlacementOrthonormal(g: GeometrySet, s: SurfaceIndex, tol: Tolerances): Boolean
        => g.IsSurfaceInRange(s) ? g.PlacementDeviation(s) <= tol.Angle.Value.Radians : true;

    // The measure of Law_CurvePlacementOrthonormal, in radians, for layer 7
    // to grade against the angle tolerance: OrthonormalityDeviation of a
    // conic's frame, the offset reference's relative length error, 0 for
    // cases without a frame. Precondition: c in range.
    PlacementDeviation(g: GeometrySet, c: CurveIndex): Number
        => g.CurveAt(c).PlacementDeviation;

    // The measure of Law_Curve2DPlacementOrthonormal, in radians.
    PlacementDeviation(g: GeometrySet, c: Curve2DIndex): Number
        => g.Curve2DAt(c).PlacementDeviation;

    // The measure of Law_SurfacePlacementOrthonormal, in radians.
    PlacementDeviation(g: GeometrySet, s: SurfaceIndex): Number
        => g.SurfaceAt(s).PlacementDeviation;

    // PlacementDeviation of each curve case: conics have a frame; the rest
    // have none, except the offset's reference direction.
    PlacementDeviation(curve: BrepCurve): Number
        => match (curve)
        {
            Line(origin, velocity) => 0.0;
            Circle(placement, radius) => placement.OrthonormalityDeviation;
            Ellipse(placement, semiAxis1, semiAxis2) => placement.OrthonormalityDeviation;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => placement.OrthonormalityDeviation;
            Parabola(placement, focalDistance) => placement.OrthonormalityDeviation;
            Polyline(points) => 0.0;
            BSpline(data) => 0.0;
            Trimmed(basis, range, sameSense) => 0.0;
            Composite(segments) => 0.0;
            Offset(basis, distance, reference) => (reference.Vector.Length - 1.0).Abs;
            OnSurface(spaceCurve, supports, master) => 0.0;
        };

    // PlacementDeviation of each parameter-plane curve case.
    PlacementDeviation(curve: BrepCurve2D): Number
        => match (curve)
        {
            Line(origin, velocity) => 0.0;
            Circle(placement, radius) => placement.OrthonormalityDeviation;
            Ellipse(placement, semiAxis1, semiAxis2) => placement.OrthonormalityDeviation;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => placement.OrthonormalityDeviation;
            Parabola(placement, focalDistance) => placement.OrthonormalityDeviation;
            Polyline(points) => 0.0;
            BSpline(data) => 0.0;
            Trimmed(basis, range, sameSense) => 0.0;
            Composite(segments) => 0.0;
            Offset(basis, distance) => 0.0;
        };

    // PlacementDeviation of each surface case.
    PlacementDeviation(surface: BrepSurface): Number
        => match (surface)
        {
            Plane(placement) => placement.OrthonormalityDeviation;
            Cylinder(placement, radius) => placement.OrthonormalityDeviation;
            Cone(placement, radius, semiAngle) => placement.OrthonormalityDeviation;
            Sphere(placement, radius) => placement.OrthonormalityDeviation;
            Torus(placement, major, minor, part) => placement.OrthonormalityDeviation;
            Revolution(profile, axis) => (axis.Direction.Vector.Length - 1.0).Abs;
            LinearExtrusion(profile, extrusion) => 0.0;
            BSpline(data) => 0.0;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => 0.0;
            Offset(basis, distance) => 0.0;
        };

    //==
    // # B-spline records
    //
    // ISO 10303-42 constraints_param_b_spline (4.6.11) and the rational
    // subtypes' WR1 and WR2, one rule per law, over the decoded records.

    // The curve's degree is at least one.
    Law_BSplineCurveDegreePositive(d: BSplineCurveData): Boolean
        => d.Basis.HasPositiveDegree;

    // The curve has control count plus degree plus one knots.
    Law_BSplineCurveKnotCount(d: BSplineCurveData): Boolean
        => d.Basis.KnotCountFits(d.ControlPoints.Count);

    // The curve's knots never decrease.
    Law_BSplineCurveKnotsNonDecreasing(d: BSplineCurveData): Boolean
        => d.Basis.KnotsNonDecreasing;

    // No interior knot of the curve repeats more than the degree, no end knot
    // more than the degree plus one.
    Law_BSplineCurveKnotMultiplicityBounded(d: BSplineCurveData): Boolean
        => d.Basis.KnotMultiplicityBounded;

    // The curve's domain, the knot span from index Degree to index n, has
    // positive length.
    Law_BSplineCurveDomainNonEmpty(d: BSplineCurveData): Boolean
        => d.Basis.HasNonEmptyDomain(d.ControlPoints.Count);

    // The curve has one weight per control point.
    Law_BSplineCurveWeightCount(d: BSplineCurveData): Boolean
        => d.Weights.Count == d.ControlPoints.Count;

    // Every weight of the curve is positive.
    Law_BSplineCurveWeightsPositive(d: BSplineCurveData): Boolean
        => d.Weights.WeightsPositive;

    // The parameter-plane curve's degree is at least one.
    Law_BSplineCurve2DDegreePositive(d: BSplineCurve2DData): Boolean
        => d.Basis.HasPositiveDegree;

    // The parameter-plane curve has control count plus degree plus one knots.
    Law_BSplineCurve2DKnotCount(d: BSplineCurve2DData): Boolean
        => d.Basis.KnotCountFits(d.ControlPoints.Count);

    // The parameter-plane curve's knots never decrease.
    Law_BSplineCurve2DKnotsNonDecreasing(d: BSplineCurve2DData): Boolean
        => d.Basis.KnotsNonDecreasing;

    // The parameter-plane curve's knot multiplicities are bounded.
    Law_BSplineCurve2DKnotMultiplicityBounded(d: BSplineCurve2DData): Boolean
        => d.Basis.KnotMultiplicityBounded;

    // The parameter-plane curve's domain has positive length.
    Law_BSplineCurve2DDomainNonEmpty(d: BSplineCurve2DData): Boolean
        => d.Basis.HasNonEmptyDomain(d.ControlPoints.Count);

    // The parameter-plane curve has one weight per control point.
    Law_BSplineCurve2DWeightCount(d: BSplineCurve2DData): Boolean
        => d.Weights.Count == d.ControlPoints.Count;

    // Every weight of the parameter-plane curve is positive.
    Law_BSplineCurve2DWeightsPositive(d: BSplineCurve2DData): Boolean
        => d.Weights.WeightsPositive;

    // The surface's degree in the given parameter is at least one.
    Law_BSplineSurfaceDegreePositive(d: BSplineSurfaceData, which: SurfaceParameter): Boolean
        => d.BasisAlong(which).HasPositiveDegree;

    // In the given parameter the surface has control count plus degree plus
    // one knots.
    Law_BSplineSurfaceKnotCount(d: BSplineSurfaceData, which: SurfaceParameter): Boolean
        => d.BasisAlong(which).KnotCountFits(d.ControlCountAlong(which));

    // The surface's knots in the given parameter never decrease.
    Law_BSplineSurfaceKnotsNonDecreasing(d: BSplineSurfaceData, which: SurfaceParameter): Boolean
        => d.BasisAlong(which).KnotsNonDecreasing;

    // The surface's knot multiplicities in the given parameter are bounded.
    Law_BSplineSurfaceKnotMultiplicityBounded(d: BSplineSurfaceData, which: SurfaceParameter): Boolean
        => d.BasisAlong(which).KnotMultiplicityBounded;

    // The surface's domain in the given parameter has positive length.
    Law_BSplineSurfaceDomainNonEmpty(d: BSplineSurfaceData, which: SurfaceParameter): Boolean
        => d.BasisAlong(which).HasNonEmptyDomain(d.ControlCountAlong(which));

    // The control net holds exactly columns times rows points.
    Law_BSplineSurfaceNetConsistent(d: BSplineSurfaceData): Boolean
        => d.ControlPoints.IsGridConsistent;

    // The weight grid is consistent and has the control net's shape.
    Law_BSplineSurfaceWeightGridMatchesNet(d: BSplineSurfaceData): Boolean
        => d.Weights.IsGridConsistent
            && d.Weights.ColumnCount == d.ControlPoints.ColumnCount
            && d.Weights.RowCount == d.ControlPoints.RowCount;

    // Every weight of the surface is positive.
    Law_BSplineSurfaceWeightsPositive(d: BSplineSurfaceData): Boolean
        => d.Weights.Elements.WeightsPositive;

    // A spline curve's domain is its knot span [Knots[Degree], Knots[n]],
    // aperiodic. Exact by construction: the ends are copied knots.
    Law_BSplineCurveDomainIsKnotSpan(g: GeometrySet, c: CurveIndex): Boolean
        => g.CanEvaluate(c) ? g.DomainIsKnotSpan(c) : true;

    // A spline parameter-plane curve's domain is its knot span.
    Law_BSplineCurve2DDomainIsKnotSpan(g: GeometrySet, c: Curve2DIndex): Boolean
        => g.CanEvaluate(c) ? g.DomainIsKnotSpan(c) : true;

    // A spline surface's domain in each parameter is that parameter's knot
    // span.
    Law_BSplineSurfaceDomainIsKnotSpan(g: GeometrySet, s: SurfaceIndex, which: SurfaceParameter): Boolean
        => g.CanEvaluate(s) ? g.DomainIsKnotSpan(s, which) : true;

    // The knot-span claim for a curve case.
    DomainIsKnotSpan(g: GeometrySet, c: CurveIndex): Boolean
        => g.CurveAt(c).DomainIsKnotSpan(g);

    // DomainIsKnotSpan for one record of the arena g, which holds the entries it references.
    DomainIsKnotSpan(curve: BrepCurve, g: GeometrySet): Boolean
        => match (curve)
        {
            Line(origin, velocity) => true;
            Circle(placement, radius) => true;
            Ellipse(placement, semiAxis1, semiAxis2) => true;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => true;
            Parabola(placement, focalDistance) => true;
            Polyline(points) => true;
            BSpline(data) => curve.Domain(g).IsKnotSpanOf(data.Basis);
            Trimmed(basis, range, sameSense) => true;
            Composite(segments) => true;
            Offset(basis, distance, reference) => true;
            OnSurface(spaceCurve, supports, master) => true;
        };

    // The knot-span claim for a parameter-plane curve case.
    DomainIsKnotSpan(g: GeometrySet, c: Curve2DIndex): Boolean
        => g.Curve2DAt(c).DomainIsKnotSpan(g);

    // DomainIsKnotSpan for one record of the arena g, which holds the entries it references.
    DomainIsKnotSpan(curve: BrepCurve2D, g: GeometrySet): Boolean
        => match (curve)
        {
            Line(origin, velocity) => true;
            Circle(placement, radius) => true;
            Ellipse(placement, semiAxis1, semiAxis2) => true;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => true;
            Parabola(placement, focalDistance) => true;
            Polyline(points) => true;
            BSpline(data) => curve.Domain(g).IsKnotSpanOf(data.Basis);
            Trimmed(basis, range, sameSense) => true;
            Composite(segments) => true;
            Offset(basis, distance) => true;
        };

    // The knot-span claim for a surface case in one parameter.
    DomainIsKnotSpan(g: GeometrySet, s: SurfaceIndex, which: SurfaceParameter): Boolean
        => g.SurfaceAt(s).DomainIsKnotSpan(g, which);

    // DomainIsKnotSpan for one record of the arena g, which holds the entries it references.
    DomainIsKnotSpan(surface: BrepSurface, g: GeometrySet, which: SurfaceParameter): Boolean
        => match (surface)
        {
            Plane(placement) => true;
            Cylinder(placement, radius) => true;
            Cone(placement, radius, semiAngle) => true;
            Sphere(placement, radius) => true;
            Torus(placement, major, minor, part) => true;
            Revolution(profile, axis) => true;
            LinearExtrusion(profile, extrusion) => true;
            BSpline(data) => surface.Domain(g).DomainAlong(which).IsKnotSpanOf(data.BasisAlong(which));
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => true;
            Offset(basis, distance) => true;
        };

    // True when the domain is aperiodic and runs from knot Degree to knot
    // Count - Degree - 1 of the basis. Exact by construction.
    IsKnotSpanOf(d: CurveDomain, b: SplineBasis): Boolean
        => !d.Periodicity.IsPeriodic
            && d.Range.Start == b.Knots.KnotAt(b.Degree)
            && d.Range.End == b.Knots.KnotAt(b.Knots.Count - b.Degree - 1);

    // A spline curve's point is the basis-weighted sum of its control points,
    // computed independently by Oracle_BSplineCurvePoint, within the length
    // tolerance.
    Law_BSplineCurveMatchesBasisSum(g: GeometrySet, c: CurveIndex, t: Number): Boolean
        => g.CanEvaluate(c) ? g.SplineMatchesOracle(c, g.Domain(c).SampleIn(t)) : true;

    // The oracle claim for a curve case.
    SplineMatchesOracle(g: GeometrySet, c: CurveIndex, t: Number): Boolean
        => g.CurveAt(c).SplineMatchesOracle(g, t);

    // SplineMatchesOracle for one record of the arena g, which holds the entries it references.
    SplineMatchesOracle(curve: BrepCurve, g: GeometrySet, t: Number): Boolean
        => match (curve)
        {
            Line(origin, velocity) => true;
            Circle(placement, radius) => true;
            Ellipse(placement, semiAxis1, semiAxis2) => true;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => true;
            Parabola(placement, focalDistance) => true;
            Polyline(points) => true;
            BSpline(data) => data.BSplinePoint(t).Distance(Oracle_BSplineCurvePoint(data, t)) <= ResolutionAt(curve.EvaluationMagnitude(g, t));
            Trimmed(basis, range, sameSense) => true;
            Composite(segments) => true;
            Offset(basis, distance, reference) => true;
            OnSurface(spaceCurve, supports, master) => true;
        };

    // A spline parameter-plane curve's point is the basis-weighted sum of its
    // control points, computed independently by Oracle_BSplineCurve2DPoint,
    // within the parameter floor.
    Law_BSplineCurve2DMatchesBasisSum(g: GeometrySet, c: Curve2DIndex, t: Number): Boolean
        => g.CanEvaluate(c) ? g.Curve2DAt(c).SplineMatchesOracle(g.Domain(c).SampleIn(t)) : true;

    // The oracle claim for a parameter-plane curve case.
    SplineMatchesOracle(curve: BrepCurve2D, t: Number): Boolean
        => match (curve)
        {
            Line(origin, velocity) => true;
            Circle(placement, radius) => true;
            Ellipse(placement, semiAxis1, semiAxis2) => true;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => true;
            Parabola(placement, focalDistance) => true;
            Polyline(points) => true;
            BSpline(data) => (data.BSplinePoint(t) - Oracle_BSplineCurve2DPoint(data, t)).Length
                <= ResolutionAt(data.ControlPoints.Reduce(0.0, (m, p) => m.Max(p.UvMagnitude)) * data.Weights.WeightRatio);
            Trimmed(basis, range, sameSense) => true;
            Composite(segments) => true;
            Offset(basis, distance) => true;
        };

    // A spline surface's point is the basis-weighted sum of its control net,
    // computed independently by Oracle_BSplineSurfacePoint.
    Law_BSplineSurfaceMatchesBasisSum(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): Boolean
        => g.CanEvaluate(s) ? g.SplineMatchesOracle(s, g.Domain(s).SampleIn(uv)) : true;

    // The oracle claim for a surface case.
    SplineMatchesOracle(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): Boolean
        => g.SurfaceAt(s).SplineMatchesOracle(g, uv);

    // SplineMatchesOracle for one record of the arena g, which holds the entries it references.
    SplineMatchesOracle(surface: BrepSurface, g: GeometrySet, uv: UvCoordinate): Boolean
        => match (surface)
        {
            Plane(placement) => true;
            Cylinder(placement, radius) => true;
            Cone(placement, radius, semiAngle) => true;
            Sphere(placement, radius) => true;
            Torus(placement, major, minor, part) => true;
            Revolution(profile, axis) => true;
            LinearExtrusion(profile, extrusion) => true;
            BSpline(data) => data.BSplinePoint(uv).Distance(Oracle_BSplineSurfacePoint(data, uv)) <= ResolutionAt(surface.EvaluationMagnitude(g, uv));
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => true;
            Offset(basis, distance) => true;
        };

    //==
    // # Curves: period and closure

    // A periodic curve's domain spans exactly one period, within the
    // parameter floor.
    Law_PeriodicCurveSpansOnePeriod(g: GeometrySet, c: CurveIndex, tol: Tolerances): Boolean
        => g.CanEvaluate(c) ? (g.Domain(c).HasSeam ? g.Domain(c).IsFullPeriod(g.ParameterFloorOf(c, tol)) : true) : true;

    // A periodic or closed curve meets itself at the two ends of its domain,
    // within the length tolerance: for a Closed domain this is the decode's
    // decision checked against the geometry.
    Law_PeriodicCurveIsClosed(g: GeometrySet, c: CurveIndex, tol: Tolerances): Boolean
        => g.CanEvaluate(c)
            ? (g.Domain(c).HasSeam
                ? g.Eval(c, g.Domain(c).Range.Start).Coincident(g.Eval(c, g.Domain(c).Range.End), tol.Length)
                : true)
            : true;

    // A periodic curve repeats: Eval(t + period) is Eval(t) within rounding,
    // the evaluation's own and that of the argument t + period carried by the
    // speed. A library law: it takes no tolerance.
    Law_CurveRepeatsWithPeriod(g: GeometrySet, c: CurveIndex, t: Number): Boolean
        => g.CanEvaluate(c)
            ? (g.Domain(c).Periodicity.IsPeriodic
                ? g.Eval(c, g.Domain(c).SampleIn(t)).Distance(g.Eval(c, g.Domain(c).SampleIn(t) + g.Domain(c).Periodicity.PeriodOr(0.0)))
                    <= ResolutionAt(g.EvaluationMagnitude(c, g.Domain(c).SampleIn(t)))
                        + g.Derivative(c, g.Domain(c).SampleIn(t)).Length * ResolutionAt(g.Domain(c).SampleIn(t).Abs + g.Domain(c).Periodicity.PeriodOr(0.0))
                : true)
            : true;

    //==
    // # Curves: derivatives

    // Derivative agrees with the central difference of Eval within
    // Richardson's estimate: with D(h) = (C(x + h) - C(x - h)) / 2h at the
    // step h of DifferenceStep over the PieceScale, |D(h/2) - C'(x)| is at
    // most 4/3 |D(h) - D(h/2)| plus ResolutionAt(EvaluationMagnitude) / h, the
    // rounding of the library's own arithmetic. A sample whose difference
    // interval holds a break of DifferenceOrder (every distinct interior knot
    // of a spline of degree up to six) is excluded. The
    // bound is the library's, never the file's (layer 0's rounding rule), so
    // the law takes no tolerance.
    Law_DerivativeMatchesCentralDifference(g: GeometrySet, c: CurveIndex, t: Number): Boolean
        => g.CanEvaluate(c) ? g.DerivativeAgrees(c, t) : true;

    // The central difference of curve c's Eval at x with step h.
    CentralDifference(g: GeometrySet, c: CurveIndex, x: Number, h: Number): Vector3D
        => (g.Eval(c, x + h) - g.Eval(c, x - h)) * (0.5 / h);

    // The central difference of curve c's Derivative at x with step h.
    CentralDifferenceOfDerivative(g: GeometrySet, c: CurveIndex, x: Number, h: Number): Vector3D
        => (g.Derivative(c, x + h) - g.Derivative(c, x - h)) * (0.5 / h);

    // The claim of Law_DerivativeMatchesCentralDifference.
    DerivativeAgrees(g: GeometrySet, c: CurveIndex, t: Number): Boolean
    {
        var d = g.Domain(c);
        var breaks = g.Breaks(c, Integer.DifferenceOrder);
        var h = DifferenceStep(d.PieceScale(breaks, t));
        var x = d.InteriorSample(t, h);
        return !d.HasInterior(h) || breaks.StraddlesBreakpoint(x, h)
            ? true
            : WithinRichardson(g.CentralDifference(c, x, h), g.CentralDifference(c, x, h * 0.5), g.Derivative(c, x),
                ResolutionAt(g.MagnitudeAround(c, x, h)) / h);
    }

    // The largest evaluation magnitude of curve c at x - h, x and x + h: what
    // the rounding of a central difference over [x - h, x + h] scales with.
    // The magnitude at x alone can be 0 (a line through the origin at its
    // origin), which would allow no rounding at all (F-53 item 2).
    MagnitudeAround(g: GeometrySet, c: CurveIndex, x: Number, h: Number): Number
        => g.EvaluationMagnitude(c, x - h).Max(g.EvaluationMagnitude(c, x)).Max(g.EvaluationMagnitude(c, x + h));

    // SecondDerivative agrees with the central difference of Derivative
    // within Richardson's estimate, as Law_DerivativeMatchesCentralDifference;
    // the rounding of a derivative formula is that of Eval over the
    // parameter's piece scale.
    Law_SecondDerivativeMatchesCentralDifference(g: GeometrySet, c: CurveIndex, t: Number): Boolean
        => g.CanEvaluate(c) ? g.SecondDerivativeAgrees(c, t) : true;

    // The claim of Law_SecondDerivativeMatchesCentralDifference.
    SecondDerivativeAgrees(g: GeometrySet, c: CurveIndex, t: Number): Boolean
    {
        var d = g.Domain(c);
        var breaks = g.Breaks(c, Integer.DifferenceOrder);
        var scale = d.PieceScale(breaks, t);
        var h = DifferenceStep(scale);
        var x = d.InteriorSample(t, h);
        return !d.HasInterior(h) || breaks.StraddlesBreakpoint(x, h)
            ? true
            : WithinRichardson(g.CentralDifferenceOfDerivative(c, x, h), g.CentralDifferenceOfDerivative(c, x, h * 0.5),
                g.SecondDerivative(c, x), ResolutionAt(g.MagnitudeAround(c, x, h) / scale) / h);
    }

    //==
    // # Curves: inverse evaluation

    // ClosestParameter inverts Eval on the curve's own points: the point at
    // the closest parameter of Eval(t) is Eval(t) within the length tolerance,
    // whatever representative or branch it picks.
    Law_ClosestParameterRecoversPoint(g: GeometrySet, c: CurveIndex, t: Number, tol: Tolerances): Boolean
        => g.CanEvaluate(c)
            ? g.Eval(c, g.ClosestParameter(c, g.Eval(c, g.Domain(c).SampleIn(t)))).Coincident(g.Eval(c, g.Domain(c).SampleIn(t)), tol.Length)
            : true;

    // ClosestParameter returns the canonical representative: inside the range
    // of an aperiodic domain, in [Start, Start + period] of a periodic one,
    // within the parameter floor.
    Law_ClosestParameterIsCanonical(g: GeometrySet, c: CurveIndex, t: Number, tol: Tolerances): Boolean
        => g.CanEvaluate(c)
            ? g.Domain(c).IsCanonical(g.ClosestParameter(c, g.Eval(c, g.Domain(c).SampleIn(t))), g.ParameterFloorOf(c, tol))
            : true;

    // ClosestParameter is no worse than any sample, for any point p, on the
    // curve or off it: |C(t*) - p| <= |C(s) - p| plus the rounding of the two
    // evaluations. The recovery laws test only points on the curve, the easy
    // case; vertices and edge samples sit up to the length tolerance off it,
    // which is the path the pipeline takes (review M4). A library law: it takes no
    // tolerance.
    Law_ClosestParameterNoWorseThanSample(g: GeometrySet, c: CurveIndex, p: Point3D, s: Number): Boolean
        => g.CanEvaluate(c) ? g.NoWorseThan(c, p, g.ClosestParameter(c, p), g.Domain(c).SampleIn(s)) : true;

    // The claim of Law_ClosestParameterNoWorseThanSample with the minimizer
    // found as best and the sample as s.
    NoWorseThan(g: GeometrySet, c: CurveIndex, p: Point3D, best: Number, s: Number): Boolean
        => g.Eval(c, best).Distance(p)
            <= g.Eval(c, s).Distance(p)
                + ResolutionAt(g.EvaluationMagnitude(c, best) + g.EvaluationMagnitude(c, s) + p.PositionVector.Length);

    // At a minimizer inside a smooth piece, the offset from p is orthogonal to
    // the tangent: |(C(t*) - p) . <C'(t*)>| is within the rounding of the
    // terms and of t* itself. A minimizer at a domain end or a break need not
    // be stationary and is skipped. A library law: it takes no tolerance.
    Law_ClosestParameterIsStationary(g: GeometrySet, c: CurveIndex, p: Point3D): Boolean
        => g.CanEvaluate(c) ? g.StationaryAt(c, p, g.ClosestParameter(c, p)) : true;

    // The claim of Law_ClosestParameterIsStationary at t.
    StationaryAt(g: GeometrySet, c: CurveIndex, p: Point3D, t: Number): Boolean
        => !g.Domain(c).IsInteriorParameter(g.Breaks(c, 1), t) || g.Derivative(c, t).Length == 0.0
            ? true
            : (g.Eval(c, t) - p).Dot(g.Derivative(c, t) * (1.0 / g.Derivative(c, t).Length)).Abs
                <= ResolutionAt(g.EvaluationMagnitude(c, t) + p.PositionVector.Length)
                    + g.Derivative(c, t).Length * ResolutionAt(t.Abs + g.Domain(c).ParameterScale(t));

    // True when t lies inside the domain and off every break by more than its
    // rounding: always inside when the formula wraps; strictly inside the
    // range otherwise, a closed domain's join included as an end.
    IsInteriorParameter(d: CurveDomain, breaks: Array<Number>, t: Number): Boolean
        => !breaks.Any(b => (b - t).Abs <= ResolutionAt(b.Abs + t.Abs))
            && (d.Periodicity.IsPeriodic
                ? true
                : t - d.Range.Start > ResolutionAt(t.Abs + d.Range.Start.Abs) && d.Range.End - t > ResolutionAt(t.Abs + d.Range.End.Abs));

    // True when r is the canonical representative of a parameter of d within
    // tol: in the window [Start, Start + period] when periodic, in the range
    // otherwise.
    IsCanonical(d: CurveDomain, r: Number, tol: ParameterTolerance): Boolean
        => r >= d.Range.Start - tol.Value
            && r <= d.Range.Start + d.Periodicity.PeriodOr(d.Range.End - d.Range.Start) + tol.Value;

    //==
    // # Curves, case by case

    // A trimmed curve's range lies in its basis's domain within the parameter
    // floor: both ends inside an aperiodic basis's range, at most one period
    // long on a periodic basis (ISO 10303-42 4.5.43 IP5). Measure TrimExcess.
    Law_TrimmedRangeInsideBasis(g: GeometrySet, c: CurveIndex, tol: Tolerances): Boolean
        => g.CanEvaluate(c) ? g.TrimExcess(c) <= g.ParameterFloorOf(c, tol).Value : true;

    // The measure of Law_TrimmedRangeInsideBasis, in the basis's parameter:
    // how far a trimmed curve's range reaches outside its basis's domain; 0
    // for every other case. Precondition: g.CanEvaluate(c).
    TrimExcess(g: GeometrySet, c: CurveIndex): Number
        => g.CurveAt(c).TrimExcess(g);

    // TrimExcess for one record of the arena g, which holds the entries it references.
    TrimExcess(curve: BrepCurve, g: GeometrySet): Number
        => match (curve)
        {
            Line(origin, velocity) => 0.0;
            Circle(placement, radius) => 0.0;
            Ellipse(placement, semiAxis1, semiAxis2) => 0.0;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => 0.0;
            Parabola(placement, focalDistance) => 0.0;
            Polyline(points) => 0.0;
            BSpline(data) => 0.0;
            Trimmed(basis, range, sameSense) => g.Domain(basis).RangeExcess(range);
            Composite(segments) => 0.0;
            Offset(basis, distance, reference) => 0.0;
            OnSurface(spaceCurve, supports, master) => 0.0;
        };

    // How far range r reaches outside domain d: its length beyond one period
    // when d is periodic, the larger overhang of its two ends otherwise; 0
    // when it fits.
    RangeExcess(d: CurveDomain, r: NumberInterval): Number
        => d.HasSeam
            ? (r.End - r.Start - d.Periodicity.PeriodOr(0.0)).Max(0.0)
            : (d.Range.Start - r.Start).Max(r.End - d.Range.End).Max(0.0);

    // A trimmed curve's range runs forward and is longer than the parameter
    // floor: the decoder stores it as [min, max] with the sense apart, after
    // adding a period on a closed basis (ISO 10303-42 4.5.43 IP4, NOTE 1).
    Law_TrimmedRangeIsForward(g: GeometrySet, c: CurveIndex, tol: Tolerances): Boolean
        => g.CanEvaluate(c) ? g.TrimIsForward(c, g.ParameterFloorOf(c, tol)) : true;

    // The claim of Law_TrimmedRangeIsForward for each case.
    TrimIsForward(g: GeometrySet, c: CurveIndex, tol: ParameterTolerance): Boolean
        => g.CurveAt(c).TrimIsForward(g, tol);

    // TrimIsForward for one record of the arena g, which holds the entries it references.
    TrimIsForward(curve: BrepCurve, g: GeometrySet, tol: ParameterTolerance): Boolean
        => match (curve)
        {
            Line(origin, velocity) => true;
            Circle(placement, radius) => true;
            Ellipse(placement, semiAxis1, semiAxis2) => true;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => true;
            Parabola(placement, focalDistance) => true;
            Polyline(points) => true;
            BSpline(data) => true;
            Trimmed(basis, range, sameSense) => range.End - range.Start > tol.Value;
            Composite(segments) => true;
            Offset(basis, distance, reference) => true;
            OnSurface(spaceCurve, supports, master) => true;
        };

    // A trimmed curve honours its sense: it starts at the basis's point at the
    // range's start when SameSense, at the range's end otherwise.
    Law_TrimmedStartsAtSensedEnd(g: GeometrySet, c: CurveIndex, tol: Tolerances): Boolean
        => g.CanEvaluate(c) ? g.TrimStartsAtSensedEnd(c, tol.Length) : true;

    // The claim of Law_TrimmedStartsAtSensedEnd for each case.
    TrimStartsAtSensedEnd(g: GeometrySet, c: CurveIndex, tol: LengthTolerance): Boolean
        => g.CurveAt(c).TrimStartsAtSensedEnd(g, tol);

    // TrimStartsAtSensedEnd for one record of the arena g, which holds the entries it references.
    TrimStartsAtSensedEnd(curve: BrepCurve, g: GeometrySet, tol: LengthTolerance): Boolean
        => match (curve)
        {
            Line(origin, velocity) => true;
            Circle(placement, radius) => true;
            Ellipse(placement, semiAxis1, semiAxis2) => true;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => true;
            Parabola(placement, focalDistance) => true;
            Polyline(points) => true;
            BSpline(data) => true;
            Trimmed(basis, range, sameSense) => curve.Eval(g, 0.0).Coincident(g.Eval(basis, sameSense ? range.Start : range.End), tol);
            Composite(segments) => true;
            Offset(basis, distance, reference) => true;
            OnSurface(spaceCurve, supports, master) => true;
        };

    // Every segment of a composite curve is bounded (ISO 10303-42 4.5.45
    // WR1): its curve's domain has finite length.
    Law_CompositeSegmentsBounded(g: GeometrySet, c: CurveIndex): Boolean
        => g.CanEvaluate(c) ? g.SegmentsBounded(c) : true;

    // The claim of Law_CompositeSegmentsBounded for each case.
    SegmentsBounded(g: GeometrySet, c: CurveIndex): Boolean
        => g.CurveAt(c).SegmentsBounded(g);

    // SegmentsBounded for one record of the arena g, which holds the entries it references.
    SegmentsBounded(curve: BrepCurve, g: GeometrySet): Boolean
        => match (curve)
        {
            Line(origin, velocity) => true;
            Circle(placement, radius) => true;
            Ellipse(placement, semiAxis1, semiAxis2) => true;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => true;
            Parabola(placement, focalDistance) => true;
            Polyline(points) => true;
            BSpline(data) => true;
            Trimmed(basis, range, sameSense) => true;
            Composite(segments) => segments.All(segment => g.Domain(segment.Curve).ParameterLength.IsFinite);
            Offset(basis, distance, reference) => true;
            OnSurface(spaceCurve, supports, master) => true;
        };

    // Consecutive segments of a composite curve chain: segment i ends, in its
    // sense, where segment i + 1 starts, within the length tolerance. Measure
    // SegmentGap.
    Law_CompositeSegmentsChain(g: GeometrySet, c: CurveIndex, i: Integer, tol: Tolerances): Boolean
        => g.CanEvaluate(c) ? g.SegmentGap(c, i) <= tol.Length.Value : true;

    // The measure of Law_CompositeSegmentsChain, a length: the distance from
    // the end of segment i to the start of segment i + 1; 0 for every other
    // case and for i not followed by a segment. Precondition:
    // g.CanEvaluate(c).
    SegmentGap(g: GeometrySet, c: CurveIndex, i: Integer): Number
        => g.CurveAt(c).SegmentGap(g, i);

    // SegmentGap for one record of the arena g, which holds the entries it references.
    SegmentGap(curve: BrepCurve, g: GeometrySet, i: Integer): Number
        => match (curve)
        {
            Line(origin, velocity) => 0.0;
            Circle(placement, radius) => 0.0;
            Ellipse(placement, semiAxis1, semiAxis2) => 0.0;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => 0.0;
            Parabola(placement, focalDistance) => 0.0;
            Polyline(points) => 0.0;
            BSpline(data) => 0.0;
            Trimmed(basis, range, sameSense) => 0.0;
            Composite(segments) => i >= 0 && i + 1 < segments.Count
                ? g.SegmentEnd(segments[i]).Distance(g.SegmentStart(segments[i + 1]))
                : 0.0;
            Offset(basis, distance, reference) => 0.0;
            OnSurface(spaceCurve, supports, master) => 0.0;
        };

    // Where a composite segment starts, in its sense.
    SegmentStart(g: GeometrySet, segment: CompositeSegment): Point3D
        => g.Eval(segment.Curve, g.Domain(segment.Curve).Range.SensedParameter(segment.SameSense, 0.0));

    // Where a composite segment ends, in its sense.
    SegmentEnd(g: GeometrySet, segment: CompositeSegment): Point3D
        => g.Eval(segment.Curve, g.Domain(segment.Curve).Range.SensedParameter(segment.SameSense, g.Domain(segment.Curve).ParameterLength));

    // An offset curve's reference direction is never along the basis's
    // tangent: the angle between them stays at least the angle tolerance from
    // 0 and from pi (ISO 10303-42 4.5.55 IP1). Measure OffsetReferenceAngle,
    // a lower bound: the law holds when the measure is at least the
    // tolerance.
    Law_OffsetReferenceNotTangent(g: GeometrySet, c: CurveIndex, t: Number, tol: Tolerances): Boolean
        => g.CanEvaluate(c) ? g.OffsetReferenceAngle(c, t) >= tol.Angle.Value.Radians : true;

    // The measure of Law_OffsetReferenceNotTangent, in radians: the angle
    // between an offset curve's reference direction and its basis's tangent
    // at t, measured from the nearer of the two parallel directions, so in
    // [0, pi/2]; pi/2 for every other case. Precondition: g.CanEvaluate(c).
    OffsetReferenceAngle(g: GeometrySet, c: CurveIndex, t: Number): Number
        => g.CurveAt(c).OffsetReferenceAngle(g, t);

    // OffsetReferenceAngle for one record of the arena g, which holds the entries it references.
    OffsetReferenceAngle(curve: BrepCurve, g: GeometrySet, t: Number): Number
        => match (curve)
        {
            Line(origin, velocity) => Number.HalfPi;
            Circle(placement, radius) => Number.HalfPi;
            Ellipse(placement, semiAxis1, semiAxis2) => Number.HalfPi;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => Number.HalfPi;
            Parabola(placement, focalDistance) => Number.HalfPi;
            Polyline(points) => Number.HalfPi;
            BSpline(data) => Number.HalfPi;
            Trimmed(basis, range, sameSense) => Number.HalfPi;
            Composite(segments) => Number.HalfPi;
            Offset(basis, distance, reference) => reference.AngleFromParallel(g.Derivative(basis, g.Domain(basis).SampleIn(t)));
            OnSurface(spaceCurve, supports, master) => Number.HalfPi;
        };

    // The angle between direction d and vector v measured from the nearer of
    // v and -v, in [0, pi/2] radians: 0 when they are parallel.
    AngleFromParallel(d: Direction3D, v: Vector3D): Number
        => d.AngleBetweenDirections(Direction3D(v)).Radians.Min(Number.Pi - d.AngleBetweenDirections(Direction3D(v)).Radians);

    // The supports of a surface curve; none for every other case.
    SupportsOf(curve: BrepCurve): Array<CurveSupport>
        => match (curve)
        {
            Line(origin, velocity) => [CurveSupport.SurfaceOnly(SurfaceIndex(-1))].Take(0);
            Circle(placement, radius) => [CurveSupport.SurfaceOnly(SurfaceIndex(-1))].Take(0);
            Ellipse(placement, semiAxis1, semiAxis2) => [CurveSupport.SurfaceOnly(SurfaceIndex(-1))].Take(0);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => [CurveSupport.SurfaceOnly(SurfaceIndex(-1))].Take(0);
            Parabola(placement, focalDistance) => [CurveSupport.SurfaceOnly(SurfaceIndex(-1))].Take(0);
            Polyline(points) => [CurveSupport.SurfaceOnly(SurfaceIndex(-1))].Take(0);
            BSpline(data) => [CurveSupport.SurfaceOnly(SurfaceIndex(-1))].Take(0);
            Trimmed(basis, range, sameSense) => [CurveSupport.SurfaceOnly(SurfaceIndex(-1))].Take(0);
            Composite(segments) => [CurveSupport.SurfaceOnly(SurfaceIndex(-1))].Take(0);
            Offset(basis, distance, reference) => [CurveSupport.SurfaceOnly(SurfaceIndex(-1))].Take(0);
            OnSurface(spaceCurve, supports, master) => supports;
        };

    // The space curve of a surface curve, or none (-1) for every other case.
    SpaceCurveOf(curve: BrepCurve): CurveIndex
        => match (curve)
        {
            Line(origin, velocity) => CurveIndex(-1);
            Circle(placement, radius) => CurveIndex(-1);
            Ellipse(placement, semiAxis1, semiAxis2) => CurveIndex(-1);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => CurveIndex(-1);
            Parabola(placement, focalDistance) => CurveIndex(-1);
            Polyline(points) => CurveIndex(-1);
            BSpline(data) => CurveIndex(-1);
            Trimmed(basis, range, sameSense) => CurveIndex(-1);
            Composite(segments) => CurveIndex(-1);
            Offset(basis, distance, reference) => CurveIndex(-1);
            OnSurface(spaceCurve, supports, master) => spaceCurve;
        };

    // The surface a support lies on.
    SupportSurface(g: GeometrySet, support: CurveSupport): SurfaceIndex
        => match (support)
        {
            Parametric(pcurve) => g.PcurveAt(pcurve).Surface;
            SurfaceOnly(surface) => surface;
        };

    // The distance from p to surface s: from p to the point of s nearest to
    // it.
    GapTo(p: Point3D, g: GeometrySet, s: SurfaceIndex): Number
        => g.Eval(s, g.Project(s, p)).Distance(p);

    // A surface curve lies on the surface of its k-th support within the
    // length tolerance (ISO 10303-42 4.5.49 IP1). Measure SupportGap.
    Law_SurfaceCurveLiesOnSupport(g: GeometrySet, c: CurveIndex, t: Number, k: Integer, tol: Tolerances): Boolean
        => g.CanEvaluate(c) ? g.SupportGap(c, t, k) <= tol.Length.Value : true;

    // The measure of Law_SurfaceCurveLiesOnSupport, a length: the distance
    // from the curve's point at t to the surface of its k-th support; 0 when
    // there is no k-th support. Precondition: g.CanEvaluate(c).
    SupportGap(g: GeometrySet, c: CurveIndex, t: Number, k: Integer): Number
        => g.CurveAt(c).SupportsOf.IsValidIndex(k)
            ? g.Eval(c, g.Domain(c).SampleIn(t)).GapTo(g, g.SupportSurface(g.CurveAt(c).SupportsOf[k]))
            : 0.0;

    // Every point of a surface curve's k-th pcurve lies on its space curve
    // within the length tolerance: the first half of the point-set agreement,
    // compared by point because the two parameterizations may differ.
    // Measure PcurveToCurveGap.
    Law_SurfaceCurvePcurveLiesOnCurve(g: GeometrySet, c: CurveIndex, t: Number, k: Integer, tol: Tolerances): Boolean
        => g.CanEvaluate(c) ? g.PcurveToCurveGap(c, t, k) <= tol.Length.Value : true;

    // The measure of Law_SurfaceCurvePcurveLiesOnCurve, a length: the
    // distance from the k-th pcurve's point at sample t to the space curve; 0
    // when there is no k-th pcurve. The pcurve is sampled over the range that
    // covers the space curve (PcurveSampleFor), not over its own domain: a
    // bounded curve with a line pcurve would otherwise be compared with
    // points of the line beyond the curve's ends, and an unbounded pcurve
    // domain gives no finite samples (review F4). Precondition:
    // g.CanEvaluate(c).
    PcurveToCurveGap(g: GeometrySet, c: CurveIndex, t: Number, k: Integer): Number
        => g.PcurveToCurveGap(g.CurveAt(c).SpaceCurveOf, g.CurveAt(c).SupportsOf, t, k);

    // PcurveToCurveGap over the parts of a surface curve.
    PcurveToCurveGap(g: GeometrySet, spaceCurve: CurveIndex, supports: Array<CurveSupport>, t: Number, k: Integer): Number
        => supports.IsValidIndex(k)
            ? (supports[k].PcurveOrNone.IsNone || spaceCurve.IsNone
                ? 0.0
                : g.Eval(spaceCurve, g.ClosestParameter(spaceCurve, g.Eval(supports[k].PcurveOrNone, g.PcurveSampleFor(supports[k].PcurveOrNone, spaceCurve, t))))
                    .Distance(g.Eval(supports[k].PcurveOrNone, g.PcurveSampleFor(supports[k].PcurveOrNone, spaceCurve, t))))
            : 0.0;

    // The pcurve parameter that sample t of space curve c stands for: when
    // c's domain is bounded, t moved into it and carried by proportion onto
    // PcurveRangeOver(p, c, domain), so a sampling of c's domain samples the
    // matching stretch of the pcurve evenly; when it is unbounded (a line
    // with a line pcurve), t moved into the pcurve's own domain, where every
    // finite parameter's point lies on the line.
    PcurveSampleFor(g: GeometrySet, p: PcurveIndex, c: CurveIndex, t: Number): Number
        => g.Domain(c).ParameterLength.IsFinite && g.Domain(c).ParameterLength > 0.0
            ? g.Domain(p).IntoRange(g.PcurveRangeOver(p, c, g.Domain(c).Range).Lerp((g.Domain(c).SampleIn(t) - g.Domain(c).Range.Start) / g.Domain(c).ParameterLength))
            : g.Domain(p).SampleIn(t);

    // Every point of a surface curve's space curve lies on its k-th pcurve
    // within the length tolerance: the second half of the point-set
    // agreement. Measure CurveToPcurveGap.
    Law_SurfaceCurveLiesOnPcurve(g: GeometrySet, c: CurveIndex, t: Number, k: Integer, tol: Tolerances): Boolean
        => g.CanEvaluate(c) ? g.CurveToPcurveGap(c, t, k) <= tol.Length.Value : true;

    // The measure of Law_SurfaceCurveLiesOnPcurve, a length: the distance from
    // the space curve's point at sample t to the k-th pcurve; 0 when there is
    // no k-th pcurve. Precondition: g.CanEvaluate(c).
    CurveToPcurveGap(g: GeometrySet, c: CurveIndex, t: Number, k: Integer): Number
        => g.CurveToPcurveGap(g.CurveAt(c).SpaceCurveOf, g.CurveAt(c).SupportsOf, t, k);

    // CurveToPcurveGap over the parts of a surface curve.
    CurveToPcurveGap(g: GeometrySet, spaceCurve: CurveIndex, supports: Array<CurveSupport>, t: Number, k: Integer): Number
        => supports.IsValidIndex(k)
            ? (supports[k].PcurveOrNone.IsNone || spaceCurve.IsNone
                ? 0.0
                : g.Eval(supports[k].PcurveOrNone, g.ClosestParameter(supports[k].PcurveOrNone, g.Eval(spaceCurve, g.Domain(spaceCurve).SampleIn(t))))
                    .Distance(g.Eval(spaceCurve, g.Domain(spaceCurve).SampleIn(t))))
            : 0.0;

    // A surface curve's k-th pcurve runs the same way as its space curve
    // (ISO 10303-42 4.5.49 IP2): at matched points their velocities make an
    // angle of at most a quarter turn.
    Law_SurfaceCurvePcurveSameSense(g: GeometrySet, c: CurveIndex, t: Number, k: Integer): Boolean
        => g.CanEvaluate(c) ? g.PcurveSameSense(g.CurveAt(c).SpaceCurveOf, g.CurveAt(c).SupportsOf, t, k) : true;

    // The claim of Law_SurfaceCurvePcurveSameSense: an exact sign test.
    PcurveSameSense(g: GeometrySet, spaceCurve: CurveIndex, supports: Array<CurveSupport>, t: Number, k: Integer): Boolean
        => supports.IsValidIndex(k)
            ? (supports[k].PcurveOrNone.IsNone || spaceCurve.IsNone
                ? true
                : g.Derivative(spaceCurve, g.Domain(spaceCurve).SampleIn(t)).Dot(
                    g.Derivative(supports[k].PcurveOrNone,
                        g.ClosestParameter(supports[k].PcurveOrNone, g.Eval(spaceCurve, g.Domain(spaceCurve).SampleIn(t))))) >= 0.0)
            : true;

    //==
    // # Parameter-plane curves and pcurves

    // A periodic parameter-plane curve repeats within rounding, as
    // Law_CurveRepeatsWithPeriod. It takes no tolerance.
    Law_Curve2DRepeatsWithPeriod(g: GeometrySet, c: Curve2DIndex, t: Number): Boolean
        => g.CanEvaluate(c)
            ? (g.Domain(c).Periodicity.IsPeriodic
                ? (g.Eval(c, g.Domain(c).SampleIn(t)) - g.Eval(c, g.Domain(c).SampleIn(t) + g.Domain(c).Periodicity.PeriodOr(0.0))).Length
                    <= ResolutionAt(g.EvaluationMagnitude(c, g.Domain(c).SampleIn(t)))
                        + g.Derivative(c, g.Domain(c).SampleIn(t)).Length * ResolutionAt(g.Domain(c).SampleIn(t).Abs + g.Domain(c).Periodicity.PeriodOr(0.0))
                : true)
            : true;

    // A parameter-plane curve's Derivative agrees with the central difference
    // of its Eval within Richardson's estimate, as
    // Law_DerivativeMatchesCentralDifference in space. It takes no tolerance.
    Law_Curve2DDerivativeMatchesCentralDifference(g: GeometrySet, c: Curve2DIndex, t: Number): Boolean
        => g.CanEvaluate(c) ? g.DerivativeAgrees(c, t) : true;

    // The central difference of parameter-plane curve c's Eval at x.
    CentralDifference(g: GeometrySet, c: Curve2DIndex, x: Number, h: Number): Vector2D
        => (g.Eval(c, x + h) - g.Eval(c, x - h)) * (0.5 / h);

    // The central difference of parameter-plane curve c's Derivative at x.
    CentralDifferenceOfDerivative(g: GeometrySet, c: Curve2DIndex, x: Number, h: Number): Vector2D
        => (g.Derivative(c, x + h) - g.Derivative(c, x - h)) * (0.5 / h);

    // The claim of Law_Curve2DDerivativeMatchesCentralDifference.
    DerivativeAgrees(g: GeometrySet, c: Curve2DIndex, t: Number): Boolean
    {
        var d = g.Domain(c);
        var breaks = g.Breaks(c, Integer.DifferenceOrder);
        var h = DifferenceStep(d.PieceScale(breaks, t));
        var x = d.InteriorSample(t, h);
        return !d.HasInterior(h) || breaks.StraddlesBreakpoint(x, h)
            ? true
            : WithinRichardson(g.CentralDifference(c, x, h), g.CentralDifference(c, x, h * 0.5), g.Derivative(c, x),
                ResolutionAt(g.MagnitudeAround(c, x, h)) / h);
    }

    // The largest evaluation magnitude of 2D curve c at x - h, x and x + h
    // (MagnitudeAround on a space curve).
    MagnitudeAround(g: GeometrySet, c: Curve2DIndex, x: Number, h: Number): Number
        => g.EvaluationMagnitude(c, x - h).Max(g.EvaluationMagnitude(c, x)).Max(g.EvaluationMagnitude(c, x + h));

    // A parameter-plane curve's SecondDerivative agrees with the central
    // difference of its Derivative within Richardson's estimate, as
    // Law_SecondDerivativeMatchesCentralDifference in space. It takes no tolerance.
    Law_Curve2DSecondDerivativeMatchesCentralDifference(g: GeometrySet, c: Curve2DIndex, t: Number): Boolean
        => g.CanEvaluate(c) ? g.SecondDerivativeAgrees(c, t) : true;

    // The claim of Law_Curve2DSecondDerivativeMatchesCentralDifference.
    SecondDerivativeAgrees(g: GeometrySet, c: Curve2DIndex, t: Number): Boolean
    {
        var d = g.Domain(c);
        var breaks = g.Breaks(c, Integer.DifferenceOrder);
        var scale = d.PieceScale(breaks, t);
        var h = DifferenceStep(scale);
        var x = d.InteriorSample(t, h);
        return !d.HasInterior(h) || breaks.StraddlesBreakpoint(x, h)
            ? true
            : WithinRichardson(g.CentralDifferenceOfDerivative(c, x, h), g.CentralDifferenceOfDerivative(c, x, h * 0.5),
                g.SecondDerivative(c, x), ResolutionAt(g.MagnitudeAround(c, x, h) / scale) / h);
    }

    // A pcurve's space velocity, by the chain rule, agrees with the central
    // difference of its space points within Richardson's estimate, as
    // Law_DerivativeMatchesCentralDifference. Besides the 2D curve's own
    // breaks, a difference interval over which the 2D curve crosses a break
    // line of the surface is excluded. It takes no tolerance.
    Law_PcurveDerivativeMatchesCentralDifference(g: GeometrySet, p: PcurveIndex, t: Number): Boolean
        => g.CanEvaluate(p) ? g.DerivativeAgrees(p, t) : true;

    // The central difference of pcurve p's space points at x.
    CentralDifference(g: GeometrySet, p: PcurveIndex, x: Number, h: Number): Vector3D
        => (g.Eval(p, x + h) - g.Eval(p, x - h)) * (0.5 / h);

    // The central difference of pcurve p's space velocity at x.
    CentralDifferenceOfDerivative(g: GeometrySet, p: PcurveIndex, x: Number, h: Number): Vector3D
        => (g.Derivative(p, x + h) - g.Derivative(p, x - h)) * (0.5 / h);

    // True when the pcurve's 2D curve, between x - h and x + h, reaches an
    // iso-line of its surface along which a partial of DifferenceOrder may
    // jump: a break value of u (or v) lies between the u (or v) coordinates
    // at the interval's ends. Over an interval this short the 2D curve is
    // monotone in each coordinate unless that coordinate's derivative
    // vanishes there, and a curve that touches a line without crossing it
    // stays on one smooth side.
    CrossesSurfaceBreak(g: GeometrySet, p: PcurveIndex, x: Number, h: Number): Boolean
    {
        var s = g.PcurveAt(p).Surface;
        var a = g.Eval(g.PcurveAt(p).Curve, x - h);
        var b = g.Eval(g.PcurveAt(p).Curve, x + h);
        return g.Breaks(s, SurfaceParameter.ParameterU, Integer.DifferenceOrder).Any(k => a.U.Min(b.U) <= k && k <= a.U.Max(b.U))
            || g.Breaks(s, SurfaceParameter.ParameterV, Integer.DifferenceOrder).Any(k => a.V.Min(b.V) <= k && k <= a.V.Max(b.V));
    }

    // The rounding of the pcurve's space point at x: the surface's own, plus
    // the 2D curve's rounding carried through the partials.
    PcurveRounding(g: GeometrySet, p: PcurveIndex, x: Number): Number
        => ResolutionAt(g.EvaluationMagnitude(p, x))
            + (g.PartialU(g.PcurveAt(p).Surface, g.Eval(g.PcurveAt(p).Curve, x)).Length
                + g.PartialV(g.PcurveAt(p).Surface, g.Eval(g.PcurveAt(p).Curve, x)).Length)
                * ResolutionAt(g.EvaluationMagnitude(g.PcurveAt(p).Curve, x));

    // The largest PcurveRounding at x - h, x and x + h (MagnitudeAround on a
    // space curve).
    PcurveRoundingAround(g: GeometrySet, p: PcurveIndex, x: Number, h: Number): Number
        => g.PcurveRounding(p, x - h).Max(g.PcurveRounding(p, x)).Max(g.PcurveRounding(p, x + h));

    // The claim of Law_PcurveDerivativeMatchesCentralDifference.
    DerivativeAgrees(g: GeometrySet, p: PcurveIndex, t: Number): Boolean
    {
        var d = g.Domain(p);
        var breaks = g.Breaks(g.PcurveAt(p).Curve, Integer.DifferenceOrder);
        var h = DifferenceStep(d.PieceScale(breaks, t));
        var x = d.InteriorSample(t, h);
        return !d.HasInterior(h) || breaks.StraddlesBreakpoint(x, h) || g.CrossesSurfaceBreak(p, x, h)
            ? true
            : WithinRichardson(g.CentralDifference(p, x, h), g.CentralDifference(p, x, h * 0.5), g.Derivative(p, x),
                g.PcurveRoundingAround(p, x, h) / h);
    }

    // A pcurve's space acceleration agrees with the central difference of its
    // space velocity within Richardson's estimate, as
    // Law_SecondDerivativeMatchesCentralDifference. It takes no tolerance.
    Law_PcurveSecondDerivativeMatchesCentralDifference(g: GeometrySet, p: PcurveIndex, t: Number): Boolean
        => g.CanEvaluate(p) ? g.SecondDerivativeAgrees(p, t) : true;

    // The claim of Law_PcurveSecondDerivativeMatchesCentralDifference.
    SecondDerivativeAgrees(g: GeometrySet, p: PcurveIndex, t: Number): Boolean
    {
        var d = g.Domain(p);
        var breaks = g.Breaks(g.PcurveAt(p).Curve, Integer.DifferenceOrder);
        var scale = d.PieceScale(breaks, t);
        var h = DifferenceStep(scale);
        var x = d.InteriorSample(t, h);
        return !d.HasInterior(h) || breaks.StraddlesBreakpoint(x, h) || g.CrossesSurfaceBreak(p, x, h)
            ? true
            : WithinRichardson(g.CentralDifferenceOfDerivative(p, x, h), g.CentralDifferenceOfDerivative(p, x, h * 0.5),
                g.SecondDerivative(p, x), g.PcurveRoundingAround(p, x, h) / (scale * h));
    }

    // ClosestParameter on a pcurve returns its bounded representative: on a
    // pcurve whose space point repeats with parameter period T, a value in
    // [0, T] within the parameter floor; on any pcurve, a finite value.
    Law_PcurveClosestParameterIsBounded(g: GeometrySet, p: PcurveIndex, t: Number, tol: Tolerances): Boolean
        => g.CanEvaluate(p)
            ? g.ClosestParameter(p, g.Eval(p, g.Domain(p).SampleIn(t))).IsFinite
                && (g.PcurveParameterPeriod(p) > 0.0
                    ? g.ClosestParameter(p, g.Eval(p, g.Domain(p).SampleIn(t))) >= -g.ParameterFloorOf(p, tol).Value
                        && g.ClosestParameter(p, g.Eval(p, g.Domain(p).SampleIn(t))) <= g.PcurveParameterPeriod(p) + g.ParameterFloorOf(p, tol).Value
                    : true)
            : true;

    // A pcurve stays inside its surface's domain, within the parameter floor
    // (periodic directions contain every value). Measure PcurveDomainExcess,
    // one per parameter.
    Law_PcurveWithinSurfaceDomain(g: GeometrySet, p: PcurveIndex, t: Number, tol: Tolerances): Boolean
        => g.CanEvaluate(p)
            ? g.PcurveDomainExcess(p, t, SurfaceParameter.ParameterU) <= g.ParameterFloorAlong(g.PcurveAt(p).Surface, SurfaceParameter.ParameterU, tol).Value
                && g.PcurveDomainExcess(p, t, SurfaceParameter.ParameterV) <= g.ParameterFloorAlong(g.PcurveAt(p).Surface, SurfaceParameter.ParameterV, tol).Value
            : true;

    // The measure of Law_PcurveWithinSurfaceDomain in the given surface
    // parameter, in that parameter's units: how far the pcurve's point at
    // sample t lies outside the surface's range in it; 0 in a periodic
    // direction. Precondition: g.CanEvaluate(p).
    PcurveDomainExcess(g: GeometrySet, p: PcurveIndex, t: Number, which: SurfaceParameter): Number
        => g.Domain(g.PcurveAt(p).Surface).DomainAlong(which).RangeExcess(
            NumberInterval(g.Eval(g.PcurveAt(p).Curve, g.Domain(p).SampleIn(t)).Coordinate(which),
                g.Eval(g.PcurveAt(p).Curve, g.Domain(p).SampleIn(t)).Coordinate(which)));

    //==
    // # Surfaces: period

    // A surface periodic in the given parameter spans exactly one period in it,
    // within the parameter floor.
    Law_PeriodicSurfaceSpansOnePeriod(g: GeometrySet, s: SurfaceIndex, which: SurfaceParameter, tol: Tolerances): Boolean
        => g.CanEvaluate(s)
            ? (g.Domain(s).DomainAlong(which).HasSeam ? g.Domain(s).DomainAlong(which).IsFullPeriod(g.ParameterFloorAlong(s, which, tol)) : true)
            : true;

    // A surface periodic in the given parameter repeats with its period in
    // it, within rounding, as Law_CurveRepeatsWithPeriod. It takes no tolerance.
    Law_SurfaceRepeatsWithPeriod(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, which: SurfaceParameter): Boolean
        => g.CanEvaluate(s)
            ? (g.Domain(s).DomainAlong(which).Periodicity.IsPeriodic
                ? g.Eval(s, g.Domain(s).SampleIn(uv)).Distance(g.Eval(s, g.Domain(s).SampleIn(uv).WithCoordinate(which,
                    g.Domain(s).SampleIn(uv).Coordinate(which) + g.Domain(s).DomainAlong(which).Periodicity.PeriodOr(0.0))))
                    <= ResolutionAt(g.EvaluationMagnitude(s, g.Domain(s).SampleIn(uv)))
                        + g.Partial(s, g.Domain(s).SampleIn(uv), which).Length
                            * ResolutionAt(g.Domain(s).SampleIn(uv).Coordinate(which).Abs + g.Domain(s).DomainAlong(which).Periodicity.PeriodOr(0.0))
                : true)
            : true;

    //==
    // # Surfaces: derivatives, normal, area element

    // The partial in the given parameter agrees with the central difference
    // of Eval in that parameter within Richardson's estimate, as
    // Law_DerivativeMatchesCentralDifference. It takes no tolerance.
    Law_PartialMatchesCentralDifference(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, which: SurfaceParameter): Boolean
        => g.CanEvaluate(s) ? g.PartialAgrees(s, g.Domain(s).SampleIn(uv), which) : true;

    // The central difference of surface s's Eval at w in the given
    // parameter, with step h.
    CentralDifference(g: GeometrySet, s: SurfaceIndex, w: UvCoordinate, which: SurfaceParameter, h: Number): Vector3D
        => (g.Eval(s, w.WithCoordinate(which, w.Coordinate(which) + h)) - g.Eval(s, w.WithCoordinate(which, w.Coordinate(which) - h))) * (0.5 / h);

    // The claim of Law_PartialMatchesCentralDifference.
    PartialAgrees(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, which: SurfaceParameter): Boolean
    {
        var d = g.Domain(s).DomainAlong(which);
        var breaks = g.Breaks(s, which, Integer.DifferenceOrder);
        var h = DifferenceStep(d.PieceScale(breaks, uv.Coordinate(which)));
        var x = d.InteriorSample(uv.Coordinate(which), h);
        var w = uv.WithCoordinate(which, x);
        return !d.HasInterior(h) || breaks.StraddlesBreakpoint(x, h)
            ? true
            : WithinRichardson(g.CentralDifference(s, w, which, h), g.CentralDifference(s, w, which, h * 0.5), g.Partial(s, w, which),
                ResolutionAt(g.MagnitudeAround(s, w, which, h)) / h);
    }

    // The largest evaluation magnitude of surface s at w moved by -h, 0 and
    // +h along `which` (MagnitudeAround on a space curve).
    MagnitudeAround(g: GeometrySet, s: SurfaceIndex, w: UvCoordinate, which: SurfaceParameter, h: Number): Number
        => g.EvaluationMagnitude(s, w.WithCoordinate(which, w.Coordinate(which) - h))
            .Max(g.EvaluationMagnitude(s, w))
            .Max(g.EvaluationMagnitude(s, w.WithCoordinate(which, w.Coordinate(which) + h)));

    // True when uv lies on a collapsed line of the surface to within the
    // rounding of its coordinate, in either parameter, measured around the
    // loop when the direction has a seam: where the area element may be
    // exactly zero. Not a tolerance zone: next to a collapsed line the metric
    // degenerates, and a zone the size of the parameter floor would excuse
    // the laws exactly where they need a rounding bound instead (review F11).
    IsOnCollapsedLine(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, tol: Tolerances): Boolean
        => g.CollapsedAt(s, SurfaceParameter.ParameterU, tol).Any(c =>
                g.Domain(s).U.SameParameter(uv.U, c, ParameterTolerance(ResolutionAt(c.Abs + g.Domain(s).U.ParameterScale(uv.U)))))
            || g.CollapsedAt(s, SurfaceParameter.ParameterV, tol).Any(c =>
                g.Domain(s).V.SameParameter(uv.V, c, ParameterTolerance(ResolutionAt(c.Abs + g.Domain(s).V.ParameterScale(uv.V)))));

    // The scale of surface s's given parameter at uv: the PieceScale of the
    // direction, over which a partial's rounding is that of Eval divided by
    // it.
    DirectionScale(surface: BrepSurface, g: GeometrySet, uv: UvCoordinate, which: SurfaceParameter): Number
        => surface.Domain(g).DomainAlong(which).PieceScale(surface.Breaks(g, which, Integer.DifferenceOrder), uv.Coordinate(which));

    // A bound, in radians, on the rounding of the direction of NormalOr at uv:
    // the unit-vector rounding plus the relative rounding of the smaller
    // partial, ResolutionAt(M) / (|S_x| s_x) with s_x the direction's scale
    // (review F11). It grows without limit toward a collapsed line, where the
    // smaller partial vanishes; the largest Number when a partial is zero.
    NormalAngleBound(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): Number
    {
        var surface = g.SurfaceAt(s);
        var smaller = (surface.PartialU(g, uv).Length * surface.DirectionScale(g, uv, SurfaceParameter.ParameterU))
            .Min(surface.PartialV(g, uv).Length * surface.DirectionScale(g, uv, SurfaceParameter.ParameterV));
        return smaller > 0.0 ? ResolutionAt(1.0) + ResolutionAt(surface.EvaluationMagnitude(g, uv)) / smaller : Number.MaxValue;
    }

    // NormalOr is a unit vector within the rounding of a normalization,
    // everywhere: the closed forms are unit by construction, the cross
    // products are normalized, and the fallback is unit. A library law: it takes no
    // tolerance.
    Law_NormalIsUnit(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): Boolean
        => g.CanEvaluate(s)
            ? (g.NormalOr(s, g.Domain(s).SampleIn(uv), Direction3D(Vector3D.UnitZ)).Vector.Length - 1.0).Abs <= ResolutionAt(1.0)
            : true;

    // NormalOr is orthogonal to the partial in the given parameter: |N . S_x|
    // is at most |S_x| times NormalAngleBound, which vanishes to rounding away
    // from collapsed lines and grows toward them. A library law: tol is not
    // read.
    Law_NormalOrthogonalToPartial(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, which: SurfaceParameter): Boolean
        => g.CanEvaluate(s)
            ? g.NormalOr(s, g.Domain(s).SampleIn(uv), Direction3D(Vector3D.UnitZ)).Vector.Dot(g.Partial(s, g.Domain(s).SampleIn(uv), which)).Abs
                <= g.Partial(s, g.Domain(s).SampleIn(uv), which).Length * g.NormalAngleBound(s, g.Domain(s).SampleIn(uv))
            : true;

    // NormalOr points along PartialU x PartialV where
    // NormalAgreesWithParameterization says so and against it elsewhere: an
    // exact sign test wherever the rounding of the normal's direction is
    // below a radian, so the sign is determined.
    Law_NormalSenseMatchesParameterization(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): Boolean
        => g.CanEvaluate(s)
            ? (g.NormalAngleBound(s, g.Domain(s).SampleIn(uv)) >= 1.0
                ? true
                : (g.NormalOr(s, g.Domain(s).SampleIn(uv), Direction3D(Vector3D.UnitZ)).Vector
                    .Dot(g.PartialU(s, g.Domain(s).SampleIn(uv)).Cross(g.PartialV(s, g.Domain(s).SampleIn(uv)))) > 0.0)
                    == g.NormalAgreesWithParameterization(s))
            : true;

    // AreaElement equals |PartialU x PartialV|, computed from the partials,
    // within rounding. A library law: it takes no tolerance.
    Law_AreaElementMatchesCrossProduct(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): Boolean
        => g.CanEvaluate(s) ? g.SurfaceAt(s).AreaElementIs(g, g.Domain(s).SampleIn(uv), g.AreaElement(s, g.Domain(s).SampleIn(uv))) : true;

    // True when h is the cross-product area element at uv within rounding:
    // |S_u| |S_v| ResolutionAt(1) for the product, plus each partial's
    // rounding, ResolutionAt(M) over its direction's scale, times the other
    // partial.
    AreaElementIs(surface: BrepSurface, g: GeometrySet, uv: UvCoordinate, h: Number): Boolean
        => (surface.PartialU(g, uv).Cross(surface.PartialV(g, uv)).Length - h).Abs
            <= surface.PartialU(g, uv).Length * surface.PartialV(g, uv).Length * ResolutionAt(1.0)
                + ResolutionAt(surface.EvaluationMagnitude(g, uv))
                    * (surface.PartialU(g, uv).Length / surface.DirectionScale(g, uv, SurfaceParameter.ParameterV)
                        + surface.PartialV(g, uv).Length / surface.DirectionScale(g, uv, SurfaceParameter.ParameterU));

    // AreaElement is positive off collapsed lines: the surface is regular
    // wherever it does not collapse an iso-line.
    Law_AreaElementPositiveAwayFromCollapse(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, tol: Tolerances): Boolean
        => g.CanEvaluate(s)
            ? (g.IsOnCollapsedLine(s, g.Domain(s).SampleIn(uv), tol) ? true : g.AreaElement(s, g.Domain(s).SampleIn(uv)) > 0.0)
            : true;

    //==
    // # Surfaces: closed-form area elements
    //
    // Each law states the formula of research/VALIDATION-MATH.md 5.1 and
    // compares it with the cross product of the partials, an independent
    // route through PartialU and PartialV.

    // On a cone, |PartialU x PartialV| = |R + v tan a| / cos a, v axial.
    Law_ConeAreaElement(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): Boolean
        => g.CanEvaluate(s) ? g.ConeAreaElementHolds(s, g.Domain(s).SampleIn(uv)) : true;

    // The claim of Law_ConeAreaElement for each case.
    ConeAreaElementHolds(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): Boolean
        => g.SurfaceAt(s).ConeAreaElementHolds(g, uv);

    // ConeAreaElementHolds for one record of the arena g, which holds the entries it references.
    ConeAreaElementHolds(surface: BrepSurface, g: GeometrySet, uv: UvCoordinate): Boolean
        => match (surface)
        {
            Plane(placement) => true;
            Cylinder(placement, radius) => true;
            Cone(placement, radius, semiAngle) => surface.AreaElementIs(g, uv, (radius + uv.V * semiAngle.Tan).Abs / semiAngle.Cos);
            Sphere(placement, radius) => true;
            Torus(placement, major, minor, part) => true;
            Revolution(profile, axis) => true;
            LinearExtrusion(profile, extrusion) => true;
            BSpline(data) => true;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => true;
            Offset(basis, distance) => true;
        };

    // On a sphere, |PartialU x PartialV| = R^2 cos v, v the latitude in
    // [-pi/2, pi/2].
    Law_SphereAreaElement(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): Boolean
        => g.CanEvaluate(s) ? g.SphereAreaElementHolds(s, g.Domain(s).SampleIn(uv)) : true;

    // The claim of Law_SphereAreaElement for each case.
    SphereAreaElementHolds(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): Boolean
        => g.SurfaceAt(s).SphereAreaElementHolds(g, uv);

    // SphereAreaElementHolds for one record of the arena g, which holds the entries it references.
    SphereAreaElementHolds(surface: BrepSurface, g: GeometrySet, uv: UvCoordinate): Boolean
        => match (surface)
        {
            Plane(placement) => true;
            Cylinder(placement, radius) => true;
            Cone(placement, radius, semiAngle) => true;
            Sphere(placement, radius) => surface.AreaElementIs(g, uv, radius * radius * uv.V.Cos);
            Torus(placement, major, minor, part) => true;
            Revolution(profile, axis) => true;
            LinearExtrusion(profile, extrusion) => true;
            BSpline(data) => true;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => true;
            Offset(basis, distance) => true;
        };

    // On a torus, |PartialU x PartialV| = r |R + r cos v|, which is
    // r (R + r cos v) on a ring torus.
    Law_TorusAreaElement(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): Boolean
        => g.CanEvaluate(s) ? g.TorusAreaElementHolds(s, g.Domain(s).SampleIn(uv)) : true;

    // The claim of Law_TorusAreaElement for each case.
    TorusAreaElementHolds(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate): Boolean
        => g.SurfaceAt(s).TorusAreaElementHolds(g, uv);

    // TorusAreaElementHolds for one record of the arena g, which holds the entries it references.
    TorusAreaElementHolds(surface: BrepSurface, g: GeometrySet, uv: UvCoordinate): Boolean
        => match (surface)
        {
            Plane(placement) => true;
            Cylinder(placement, radius) => true;
            Cone(placement, radius, semiAngle) => true;
            Sphere(placement, radius) => true;
            Torus(placement, major, minor, part) => surface.AreaElementIs(g, uv, minor * (major + minor * uv.V.Cos).Abs);
            Revolution(profile, axis) => true;
            LinearExtrusion(profile, extrusion) => true;
            BSpline(data) => true;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => true;
            Offset(basis, distance) => true;
        };

    //==
    // # Surfaces: inverse evaluation

    // Project inverts Eval on the surface's own points: the point at
    // Project(Eval(uv)) is Eval(uv) within the length tolerance, whatever
    // representative it picks; this holds on degenerate sides too.
    Law_ProjectRecoversPoint(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, tol: Tolerances): Boolean
        => g.CanEvaluate(s)
            ? g.Eval(s, g.Project(s, g.Eval(s, g.Domain(s).SampleIn(uv)))).Coincident(g.Eval(s, g.Domain(s).SampleIn(uv)), tol.Length)
            : true;

    // On a surface injective by construction, Project recovers the
    // parameters: Project(Eval(uv)) is uv modulo the period within the
    // parameter tolerance at uv. That tolerance reaches its cap on a collapsed
    // line, so the claim says nothing of the free coordinate there.
    Law_ProjectRecoversParameter(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, tol: Tolerances): Boolean
        => g.CanEvaluate(s)
            ? (g.IsInjectiveByConstruction(s)
                ? g.Domain(s).SameParameter(g.Project(s, g.Eval(s, g.Domain(s).SampleIn(uv))), g.Domain(s).SampleIn(uv),
                    g.UvToleranceAt(s, g.Domain(s).SampleIn(uv), tol))
                : true)
            : true;

    // ProjectNear seeded at uv recovers uv from Eval(uv) within the parameter
    // tolerance at uv, on every surface: the inverse function theorem makes
    // the map locally invertible wherever its partials span a plane.
    Law_ProjectNearRecoversParameter(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, tol: Tolerances): Boolean
        => g.CanEvaluate(s)
            ? g.Domain(s).SameParameter(
                g.ProjectNear(s, g.Eval(s, g.Domain(s).SampleIn(uv)), g.Domain(s).SampleIn(uv)), g.Domain(s).SampleIn(uv),
                g.UvToleranceAt(s, g.Domain(s).SampleIn(uv), tol))
            : true;

    // ProjectNear seeded near uv, not at it, recovers uv from Eval(uv) within
    // the parameter tolerance at uv: the seed is uv moved by du and dv (each
    // clamped to [-1, 1]) times NearSeedOffset of each direction's scale, so
    // the local inverse must iterate. Law_ProjectNearRecoversParameter seeds
    // at the answer, where a Newton iteration has nothing to do (review
    // section 5, ProjectNearIsLocalInverse). Holds where the offset is inside
    // the neighbourhood the inverse function theorem gives, which theorem
    // ProjectNearIsLocalInverse states.
    Law_ProjectNearRecoversFromNearbySeed(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, du: Number, dv: Number, tol: Tolerances): Boolean
        => g.CanEvaluate(s)
            ? g.Domain(s).SameParameter(
                g.ProjectNear(s, g.Eval(s, g.Domain(s).SampleIn(uv)), g.NearbySeed(s, g.Domain(s).SampleIn(uv), du, dv)),
                g.Domain(s).SampleIn(uv), g.UvToleranceAt(s, g.Domain(s).SampleIn(uv), tol))
            : true;

    // The offset of a nearby seed, as a fraction of a direction's scale: the
    // sixth root of the unit roundoff, about 1.8e-3 in 64 bits, far enough
    // that an iteration must move and near enough to stay inside the local
    // inverse's neighbourhood on a surface whose curvature radius is above a
    // hundredth of the scale.
    NearSeedOffset(scale: Number): Number
        => Number.RoundingUnit.Pow(1.0 / 6.0) * scale;

    // uv moved by du and dv, each clamped to [-1, 1], times NearSeedOffset of
    // each direction's scale, and kept inside a bounded direction's range.
    NearbySeed(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, du: Number, dv: Number): UvCoordinate
        => g.Domain(s).SampleIn(UvCoordinate(
            uv.U + du.Max(-1.0).Min(1.0) * NearSeedOffset(g.SurfaceAt(s).DirectionScale(g, uv, SurfaceParameter.ParameterU)),
            uv.V + dv.Max(-1.0).Min(1.0) * NearSeedOffset(g.SurfaceAt(s).DirectionScale(g, uv, SurfaceParameter.ParameterV))));

    // Project returns the canonical representative: each coordinate in the
    // window of a periodic direction or the range of an aperiodic one, within
    // the parameter floor.
    Law_ProjectIsCanonical(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, tol: Tolerances): Boolean
        => g.CanEvaluate(s) ? g.Domain(s).IsCanonical(g.Project(s, g.Eval(s, g.Domain(s).SampleIn(uv))), g.UvFloorOf(s, tol)) : true;

    // True when both coordinates of uv are canonical in their directions,
    // each within its own floor.
    IsCanonical(d: SurfaceDomain, uv: UvCoordinate, tol: UvTolerance): Boolean
        => d.U.IsCanonical(uv.U, tol.U) && d.V.IsCanonical(uv.V, tol.V);

    // Project is no worse than any sample, for any point p, as
    // Law_ClosestParameterNoWorseThanSample on curves (review M4). A library
    // law: it takes no tolerance.
    Law_ProjectNoWorseThanSample(g: GeometrySet, s: SurfaceIndex, p: Point3D, uv: UvCoordinate): Boolean
        => g.CanEvaluate(s)
            ? g.Eval(s, g.Project(s, p)).Distance(p)
                <= g.Eval(s, g.Domain(s).SampleIn(uv)).Distance(p)
                    + ResolutionAt(g.EvaluationMagnitude(s, g.Project(s, p)) + g.EvaluationMagnitude(s, g.Domain(s).SampleIn(uv)) + p.PositionVector.Length)
            : true;

    // At a minimizer inside a smooth patch and off collapsed lines, the
    // offset from p is orthogonal to both partials, within rounding, as
    // Law_ClosestParameterIsStationary. A library law: it takes no tolerance.
    Law_ProjectIsStationary(g: GeometrySet, s: SurfaceIndex, p: Point3D, which: SurfaceParameter): Boolean
        => g.CanEvaluate(s) ? g.ProjectStationaryAt(s, p, g.Project(s, p), which) : true;

    // The claim of Law_ProjectIsStationary at uv in the given parameter.
    ProjectStationaryAt(g: GeometrySet, s: SurfaceIndex, p: Point3D, uv: UvCoordinate, which: SurfaceParameter): Boolean
        => !g.Domain(s).U.IsInteriorParameter(g.Breaks(s, SurfaceParameter.ParameterU, 1), uv.U)
                || !g.Domain(s).V.IsInteriorParameter(g.Breaks(s, SurfaceParameter.ParameterV, 1), uv.V)
                || g.NormalAngleBound(s, uv) >= 1.0
            ? true
            : (g.Eval(s, uv) - p).Dot(g.Partial(s, uv, which) * (1.0 / g.Partial(s, uv, which).Length)).Abs
                <= ResolutionAt(g.EvaluationMagnitude(s, uv) + p.PositionVector.Length)
                    + g.Partial(s, uv, which).Length * ResolutionAt(uv.Coordinate(which).Abs + g.Domain(s).DomainAlong(which).ParameterScale(uv.Coordinate(which)));

    //==
    // # Surfaces: collapsed lines and degenerate sides

    // The k-th collapsed line of the given parameter is one point: its points
    // at any two values a and b of the other parameter coincide within the
    // length tolerance. Measure CollapsedLineSpread.
    Law_CollapsedLineIsOnePoint(g: GeometrySet, s: SurfaceIndex, which: SurfaceParameter, k: Integer, a: Number, b: Number, tol: Tolerances): Boolean
        => g.CanEvaluate(s) ? g.CollapsedLineSpread(s, which, k, a, b, tol) <= tol.Length.Value : true;

    // The measure of Law_CollapsedLineIsOnePoint, a length: the distance
    // between the k-th collapsed line's points at a and b; 0 when there is no
    // k-th line. tol decides which lines collapse (CollapsedAt). Precondition:
    // g.CanEvaluate(s).
    CollapsedLineSpread(g: GeometrySet, s: SurfaceIndex, which: SurfaceParameter, k: Integer, a: Number, b: Number, tol: Tolerances): Number
        => g.CollapsedAt(s, which, tol).IsValidIndex(k)
            ? g.Eval(s, g.IsoPoint(s, which, g.CollapsedAt(s, which, tol)[k], a)).Distance(
                g.Eval(s, g.IsoPoint(s, which, g.CollapsedAt(s, which, tol)[k], b)))
            : 0.0;

    // The parameter-plane point with the given parameter at c and the other
    // at the sample `along`, moved into the other parameter's domain.
    IsoPoint(g: GeometrySet, s: SurfaceIndex, which: SurfaceParameter, c: Number, along: Number): UvCoordinate
        => which.Along(
            UvCoordinate(c, g.Domain(s).V.SampleIn(along)),
            UvCoordinate(g.Domain(s).U.SampleIn(along), c));

    // Along the k-th degenerate side of a surface that collapses it by its
    // formula (CollapsesByFormula: the sphere's poles, the axis points of the
    // spindle torus parts), the partial in the side's own direction vanishes:
    // its length times the side's parameter length is within the rounding of
    // the evaluation. The transverse partial does not vanish (on a sphere's
    // pole PartialV is -R e_r). A spline or revolution side that collapses
    // only within the length tolerance is not covered: its speed along the
    // side need not be small (review F10: a degree-1 row of 10 spans
    // alternating between two points the tolerance apart has speed 10 times
    // it), and Law_CollapsedLineIsOnePoint already says what holds there.
    Law_TangentialPartialVanishesOnDegenerateSide(g: GeometrySet, s: SurfaceIndex, k: Integer, a: Number, tol: Tolerances): Boolean
        => g.CanEvaluate(s)
            ? (g.CollapsesByFormula(s) && g.DegenerateSides(s, tol).IsValidIndex(k)
                ? g.SidePartialVanishes(s, g.DegenerateSides(s, tol)[k], a)
                : true)
            : true;

    // The claim of Law_TangentialPartialVanishesOnDegenerateSide on one side.
    SidePartialVanishes(g: GeometrySet, s: SurfaceIndex, side: DomainSide, a: Number): Boolean
        => g.Partial(s, g.Domain(s).SidePoint(side, g.Domain(s).DomainAlong(side.AlongParameter).SampleIn(a)), side.AlongParameter).Length
            * g.Domain(s).DomainAlong(side.AlongParameter).ParameterLength
            <= ResolutionAt(g.EvaluationMagnitude(s, g.Domain(s).SidePoint(side, g.Domain(s).DomainAlong(side.AlongParameter).SampleIn(a))));

    // True when every collapsed line of the surface is one point by its
    // formula, not within a tolerance: the elementary surfaces, and a trim or
    // an offset of one.
    CollapsesByFormula(g: GeometrySet, s: SurfaceIndex): Boolean
        => g.SurfaceAt(s).CollapsesByFormula(g);

    // CollapsesByFormula for one record of the arena g, which holds the entries it references.
    CollapsesByFormula(surface: BrepSurface, g: GeometrySet): Boolean
        => match (surface)
        {
            Plane(placement) => true;
            Cylinder(placement, radius) => true;
            Cone(placement, radius, semiAngle) => true;
            Sphere(placement, radius) => true;
            Torus(placement, major, minor, part) => true;
            Revolution(profile, axis) => false;
            LinearExtrusion(profile, extrusion) => false;
            BSpline(data) => false;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => g.CollapsesByFormula(basis);
            Offset(basis, distance) => g.CollapsesByFormula(basis);
        };

    // The parameter that varies along a side: v on UMin and UMax.
    AlongParameter(side: DomainSide): SurfaceParameter
        => side.IsUSide ? SurfaceParameter.ParameterV : SurfaceParameter.ParameterU;

    //==
    // # Surfaces, case by case

    // A rectangular trimmed surface's range in the given parameter lies in
    // its basis's domain within the parameter floor (ISO 10303-42 4.5.80
    // IP1). Measure TrimBoxExcess.
    Law_RectangularTrimmedInsideBasis(g: GeometrySet, s: SurfaceIndex, which: SurfaceParameter, tol: Tolerances): Boolean
        => g.CanEvaluate(s) ? g.TrimBoxExcess(s, which) <= g.ParameterFloorAlong(s, which, tol).Value : true;

    // The measure of Law_RectangularTrimmedInsideBasis, in the basis's
    // parameter: how far a rectangular trimmed surface's range in the given
    // parameter reaches outside its basis's domain; 0 for every other case.
    // Precondition: g.CanEvaluate(s).
    TrimBoxExcess(g: GeometrySet, s: SurfaceIndex, which: SurfaceParameter): Number
        => g.SurfaceAt(s).TrimBoxExcess(g, which);

    // TrimBoxExcess for one record of the arena g, which holds the entries it references.
    TrimBoxExcess(surface: BrepSurface, g: GeometrySet, which: SurfaceParameter): Number
        => match (surface)
        {
            Plane(placement) => 0.0;
            Cylinder(placement, radius) => 0.0;
            Cone(placement, radius, semiAngle) => 0.0;
            Sphere(placement, radius) => 0.0;
            Torus(placement, major, minor, part) => 0.0;
            Revolution(profile, axis) => 0.0;
            LinearExtrusion(profile, extrusion) => 0.0;
            BSpline(data) => 0.0;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => g.Domain(basis).DomainAlong(which).RangeExcess(which.Along(uRange, vRange));
            Offset(basis, distance) => 0.0;
        };

    // A rectangular trimmed surface's range in the given parameter runs
    // forward and is longer than the parameter floor (ISO 10303-42 4.5.80
    // WR1, WR2).
    Law_RectangularTrimmedRangeIsForward(g: GeometrySet, s: SurfaceIndex, which: SurfaceParameter, tol: Tolerances): Boolean
        => g.CanEvaluate(s) ? g.TrimBoxIsForward(s, which, g.ParameterFloorAlong(s, which, tol)) : true;

    // The claim of Law_RectangularTrimmedRangeIsForward for each case.
    TrimBoxIsForward(g: GeometrySet, s: SurfaceIndex, which: SurfaceParameter, tol: ParameterTolerance): Boolean
        => g.SurfaceAt(s).TrimBoxIsForward(g, which, tol);

    // TrimBoxIsForward for one record of the arena g, which holds the entries it references.
    TrimBoxIsForward(surface: BrepSurface, g: GeometrySet, which: SurfaceParameter, tol: ParameterTolerance): Boolean
        => match (surface)
        {
            Plane(placement) => true;
            Cylinder(placement, radius) => true;
            Cone(placement, radius, semiAngle) => true;
            Sphere(placement, radius) => true;
            Torus(placement, major, minor, part) => true;
            Revolution(profile, axis) => true;
            LinearExtrusion(profile, extrusion) => true;
            BSpline(data) => true;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => which.Along(uRange, vRange).End - which.Along(uRange, vRange).Start > tol.Value;
            Offset(basis, distance) => true;
        };

    // A linear extrusion's profile is never along the extrusion: the angle
    // between the profile's tangent at u and the extrusion vector stays at
    // least the angle tolerance from 0 and pi (ISO 10303-42 4.5.67; where it
    // fails the surface degenerates along a ruling).
    // Measure ExtrusionProfileAngle, a lower bound as for
    // Law_OffsetReferenceNotTangent.
    Law_ExtrusionProfileTransverse(g: GeometrySet, s: SurfaceIndex, u: Number, tol: Tolerances): Boolean
        => g.CanEvaluate(s) ? g.ExtrusionProfileAngle(s, u) >= tol.Angle.Value.Radians : true;

    // The measure of Law_ExtrusionProfileTransverse, in radians: the angle
    // between a linear extrusion's vector and its profile's tangent at u,
    // from the nearer parallel direction, in [0, pi/2]; pi/2 for every other
    // case. Precondition: g.CanEvaluate(s).
    ExtrusionProfileAngle(g: GeometrySet, s: SurfaceIndex, u: Number): Number
        => g.SurfaceAt(s).ExtrusionProfileAngle(g, u);

    // ExtrusionProfileAngle for one record of the arena g, which holds the entries it references.
    ExtrusionProfileAngle(surface: BrepSurface, g: GeometrySet, u: Number): Number
        => match (surface)
        {
            Plane(placement) => Number.HalfPi;
            Cylinder(placement, radius) => Number.HalfPi;
            Cone(placement, radius, semiAngle) => Number.HalfPi;
            Sphere(placement, radius) => Number.HalfPi;
            Torus(placement, major, minor, part) => Number.HalfPi;
            Revolution(profile, axis) => Number.HalfPi;
            LinearExtrusion(profile, extrusion) => Direction3D(extrusion).AngleFromParallel(g.Derivative(profile, g.Domain(profile).SampleIn(u)));
            BSpline(data) => Number.HalfPi;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => Number.HalfPi;
            Offset(basis, distance) => Number.HalfPi;
        };

    //==
    // # Scaling

    // Scaling the arena by k > 0 scales every curve's points and keeps its
    // parameter: Eval of curve c in ScaledGeometry(g, k) at t is k Eval(c, t),
    // within the rounding of the scaled evaluation.
    Law_ScaledCurvePointIsScaled(g: GeometrySet, c: CurveIndex, t: Number, k: Number): Boolean
        => g.CanEvaluate(c) && k > 0.0 && k.IsFinite
            ? g.ScaledGeometry(k).Eval(c, g.Domain(c).SampleIn(t)).Distance((g.Eval(c, g.Domain(c).SampleIn(t)).PositionVector * k).ToPoint)
                <= ResolutionAt(g.EvaluationMagnitude(c, g.Domain(c).SampleIn(t)) * k)
            : true;

    // Scaling the arena by k > 0 scales every surface's points, reached at
    // the parameters multiplied by ParameterScaleFactor.
    Law_ScaledSurfacePointIsScaled(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, k: Number): Boolean
        => g.CanEvaluate(s) && k > 0.0 && k.IsFinite
            ? g.ScaledGeometry(k).Eval(s, UvCoordinate(
                    g.Domain(s).SampleIn(uv).U * g.ParameterScaleFactor(s, SurfaceParameter.ParameterU, k),
                    g.Domain(s).SampleIn(uv).V * g.ParameterScaleFactor(s, SurfaceParameter.ParameterV, k)))
                .Distance((g.Eval(s, g.Domain(s).SampleIn(uv)).PositionVector * k).ToPoint)
                <= ResolutionAt(g.EvaluationMagnitude(s, g.Domain(s).SampleIn(uv)) * k)
            : true;

    // Scaling the arena by k > 0 scales every pcurve's space points and keeps
    // its parameter: the rescaled 2D curve lands on the scaled surface where
    // the old one landed on the old surface.
    Law_ScaledPcurvePointIsScaled(g: GeometrySet, p: PcurveIndex, t: Number, k: Number): Boolean
        => g.CanEvaluate(p) && k > 0.0 && k.IsFinite
            ? g.ScaledGeometry(k).Eval(p, g.Domain(p).SampleIn(t)).Distance((g.Eval(p, g.Domain(p).SampleIn(t)).PositionVector * k).ToPoint)
                <= ResolutionAt(g.EvaluationMagnitude(p, g.Domain(p).SampleIn(t)) * k)
            : true;

    //==
    // # Oracles

    // A spline curve's point by the definition: sum w_i N_i(t) P_i over
    // sum w_i N_i(t), with the stdlib's Cox-de Boor BasisFunction
    // (https://en.wikipedia.org/wiki/Non-uniform_rational_B-spline). Shares no
    // code with BSplinePoint. Exponential in the degree; fine for a check.
    Oracle_BSplineCurvePoint(d: BSplineCurveData, t: Number): Point3D
        => (d.ControlPoints.Count.Range.Reduce(Vector3D(0.0, 0.0, 0.0), (sum, i) =>
                sum + d.ControlPoints[i].PositionVector * (d.Weights[i] * BasisFunction(d.Basis.Knots, d.Basis.SplineDomain.End, i, d.Basis.Degree, t)))
            * (1.0 / d.ControlPoints.Count.MapRange(i =>
                d.Weights[i] * BasisFunction(d.Basis.Knots, d.Basis.SplineDomain.End, i, d.Basis.Degree, t)).SumOf)).ToPoint;

    // A spline parameter-plane curve's point by the definition, as
    // Oracle_BSplineCurvePoint in the plane.
    Oracle_BSplineCurve2DPoint(d: BSplineCurve2DData, t: Number): UvCoordinate
        => UvCoordinate(0.0, 0.0) + d.ControlPoints.Count.Range.Reduce(Vector2D(0.0, 0.0), (sum, i) =>
                sum + (d.ControlPoints[i] - UvCoordinate(0.0, 0.0)) * (d.Weights[i] * BasisFunction(d.Basis.Knots, d.Basis.SplineDomain.End, i, d.Basis.Degree, t)))
            * (1.0 / d.ControlPoints.Count.MapRange(i =>
                d.Weights[i] * BasisFunction(d.Basis.Knots, d.Basis.SplineDomain.End, i, d.Basis.Degree, t)).SumOf);

    // A spline surface's point by the definition, as the tensor product of
    // the two bases over the weighted net.
    Oracle_BSplineSurfacePoint(d: BSplineSurfaceData, uv: UvCoordinate): Point3D
    {
        var nu = d.ControlPoints.ColumnCount;
        var nv = d.ControlPoints.RowCount;
        var basisU = nu.MapRange(i => BasisFunction(d.U.Knots, d.U.SplineDomain.End, i, d.U.Degree, uv.U));
        var basisV = nv.MapRange(j => BasisFunction(d.V.Knots, d.V.SplineDomain.End, j, d.V.Degree, uv.V));
        var weightSum = (nu * nv).MapRange(k => d.Weights.At(k % nu, k / nu) * basisU[k % nu] * basisV[k / nu]).SumOf;
        var sum = (nu * nv).Range.Reduce(Vector3D(0.0, 0.0, 0.0), (acc, k) =>
            acc + d.ControlPoints.At(k % nu, k / nu).PositionVector * (d.Weights.At(k % nu, k / nu) * basisU[k % nu] * basisV[k / nu]));
        return (sum * (1.0 / weightSum)).ToPoint;
    }
}

//==
// # B-spline records
//
// Layer 1 of the STEP B-rep to mesh design (README.md beside this file). The
// data of STEP's b_spline_curve and b_spline_surface families after decoding:
// the expanded knot vector (distinct knots repeated by their multiplicities, or
// the implied knots of uniform, quasi-uniform and Bezier forms), the degree, the
// control points, and the weights. Weights are always present; all equal means
// polynomial (ISO 10303-42 4.5.34 NOTE 2). STEP's curve_form, closed_curve and
// self_intersect are information only (NOTE 10) and are not kept: closure is
// decided from the geometry (IsClosed, IsClosedIn).
//
// Sections, in order:
//  - The basis of one parameter
//  - Curves
//  - Surfaces

//==
// # The basis of one parameter

// The normalized B-spline basis of one parameter: its degree and its expanded,
// non-decreasing knot vector (https://en.wikipedia.org/wiki/B-spline). With n
// control points the knot count is n + Degree + 1 and the domain is
// [Knots[Degree], Knots[n]] (SplineDomain). Knot values are copied from the
// file and are dimensionless.
type SplineBasis
    implements IValue
{
    Degree: Integer;
    Knots: KnotVector;
}

//==
// # Curves

// A B-spline curve in space: Basis, control points P_0..P_{n-1}, and one
// positive weight per control point.
type BSplineCurveData
{
    Basis: SplineBasis;
    ControlPoints: Array<Point3D>;
    Weights: Array<Number>;
}

// A B-spline curve in a surface's parameter plane: as BSplineCurveData with
// UvCoordinate control points holding natural surface parameters.
type BSplineCurve2DData
{
    Basis: SplineBasis;
    ControlPoints: Array<UvCoordinate>;
    Weights: Array<Number>;
}

//==
// # Surfaces

// A B-spline surface: a basis per parameter, the control net, and one weight
// per control point. ControlPoints.At(i, j) is P_ij, i the u index (column) and
// j the v index (row); STEP lists the net u-major (P_00, P_01, ..., P_0m, P_10,
// ...), so the decoder transposes into this row-major Array2D. Weights has the
// same shape.
type BSplineSurfaceData
{
    U: SplineBasis;
    V: SplineBasis;
    ControlPoints: Array2D<Point3D>;
    Weights: Array2D<Number>;
}

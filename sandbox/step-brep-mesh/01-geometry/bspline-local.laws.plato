//==
// # BsplineLocalEvaluation: laws (complexity sweep, chunk I2)
//
// The agreement laws tie BSplineLocalDerivative to the bodies it replaces,
// bit for bit, on the fixtures BsplineEvaluationLaws runs on; the count
// witness and the exact count law show it reads p + 1 control points per
// evaluation, whatever the number of control points.
//
// Sections, in order:
//  - Family
//  - Count witness
//  - Agreement

library BsplineLocalEvaluationLaws
{
    //==
    // # Family

    // A clamped curve of degree p with n control points (n > p), uniform
    // interior knots over [0, 1] and uneven positive weights.
    PerfSplineCurve(p: Integer, n: Integer): BSplineCurveData
        => BSplineCurveData(
            SplineBasis(p, KnotVector((n + p + 1).MapRange(i => i <= p ? 0.0 : (i >= n ? 1.0 : (i - p).ToNumber / (n - p).ToNumber)))),
            n.MapRange(i => Point3D(i.ToNumber, ((i * i) % 5).ToNumber, (i % 3).ToNumber)),
            n.MapRange(i => 1.0 + (i % 3).ToNumber * 0.5));

    // A parameter in [Start - 1/2, End + 1/2] of the basis's domain from
    // any Number, so the end spans' continuations are covered too.
    PerfAroundDomain(b: SplineBasis, f: Number): Number
        => b.SplineDomain.Start - 0.5 + (b.SplineDomain.End - b.SplineDomain.Start + 1.0) * f.UnitFraction;

    //==
    // # Count witness

    // The control points one second-derivative evaluation reads, on a curve
    // of degree s - 1 with 64 control points.
    PerfLocalDerivativeWork(s: Integer): WorkBudget
        => PerfSplineCurve(s - 1, 64).BSplineLocalDerivativeCounted(2, 0.37).Work;

    // Insertions count the control points an evaluation reads. The read is
    // constant in n, so a size of n would let the old O(n) body pass a
    // slope of 1 too; the size is therefore the degree plus one, with n held
    // at 64: at size 8 (degree 7) the old body reads 64 > 8 and fails, the
    // local one reads 8. Size 64 is the largest degree 64 points allow.
    Witness_BSplineLocalDerivativeWork(_: WorkClaim): WorkClaim
        => WorkClaim("BSplineLocalDerivative: control points read per degree plus one", Insertions(1), [8, 64], s => PerfLocalDerivativeWork(s));

    // Every evaluation reads exactly p + 1 control points, for degrees 1 to
    // 6 and 7 to 70 control points, at any parameter and order.
    Law_LocalDerivativeReadsDegreePlusOne(p: Integer, n: Integer, t: Number, order: Integer): Boolean
    {
        var degree = 1 + p.FixtureIndex(6);
        var d = PerfSplineCurve(degree, 7 + n.FixtureIndex(64));
        return d.BSplineLocalDerivativeCounted(order.FixtureIndex(3), d.Basis.PerfAroundDomain(t)).Work.Insertions == degree + 1;
    }

    //==
    // # Agreement

    // True when the two vectors are equal component by component.
    PerfSameVector(a: Vector3D, b: Vector3D): Boolean
        => a.X == b.X && a.Y == b.Y && a.Z == b.Z;

    PerfSameVector(a: Vector2D, b: Vector2D): Boolean
        => a.X == b.X && a.Y == b.Y;

    // On every space-curve fixture, inside its domain and half a unit past
    // either end, the point and both derivatives equal the old bodies' bit
    // for bit, and the counted form returns the same value.
    Law_BSplineLocalDerivativeAgrees(k: Integer, t: Number): Boolean
    {
        var d = k.CurveFixture;
        var x = d.Basis.PerfAroundDomain(t);
        return PerfSameVector(d.BSplineLocalDerivative(0, x), d.BSplinePointBody(x).PositionVector)
            && PerfSameVector(d.BSplineLocalDerivative(1, x), d.BSplineDerivativeBody(x, 1))
            && PerfSameVector(d.BSplineLocalDerivative(2, x), d.BSplineDerivativeBody(x, 2))
            && PerfSameVector(d.BSplineLocalDerivativeCounted(2, x).Value, d.BSplineDerivativeBody(x, 2));
    }

    // The same on the many-point family, where the local controls are a
    // small part of the curve's.
    Law_BSplineLocalDerivativeAgreesOnFamily(p: Integer, n: Integer, t: Number): Boolean
    {
        var d = PerfSplineCurve(1 + p.FixtureIndex(6), 7 + n.FixtureIndex(64));
        var x = d.Basis.PerfAroundDomain(t);
        return PerfSameVector(d.BSplineLocalDerivative(0, x), d.BSplinePointBody(x).PositionVector)
            && PerfSameVector(d.BSplineLocalDerivative(1, x), d.BSplineDerivativeBody(x, 1))
            && PerfSameVector(d.BSplineLocalDerivative(2, x), d.BSplineDerivativeBody(x, 2));
    }

    // On every parameter-plane fixture, the point and both derivatives equal
    // the old bodies' bit for bit.
    Law_BSplineLocalDerivative2DAgrees(k: Integer, t: Number): Boolean
    {
        var d = k.Curve2DFixture;
        var x = d.Basis.PerfAroundDomain(t);
        var p = d.BSplinePointBody(x);
        return PerfSameVector(d.BSplineLocalDerivative(0, x), Vector2D(p.U, p.V))
            && PerfSameVector(d.BSplineLocalDerivative(1, x), d.BSplineDerivativeBody(x, 1))
            && PerfSameVector(d.BSplineLocalDerivative(2, x), d.BSplineDerivativeBody(x, 2));
    }
}

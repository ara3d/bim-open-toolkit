//==
// # Decided geometric results: specification
//
// Invariants and constructors of TYPE-CATALOG.md section 5 (SPEC-DSL.md
// section 3), moved here at the catalog merge (2026-10-20). Not compiled.
// Each ensures that names a law is checked by that Law_ in this layer's
// *-decided.laws.plato.

spec SurfaceNormal
{
    constructor Regular; constructor Limit; constructor Apex; constructor NoNormal;
    ensures self.IsDecided == (self.CaseNumber < 3);   // Law_SurfaceNormalRoundTrips
}

spec Projection
{
    invariant match (self) { OnSurface(uv, d) => d.Value >= 0.0; OffDomain(uv, d) => d.Value >= 0.0; Failed(r) => true; };
    ensures self.IsOnSurface == (self.CaseNumber == 0);   // Law_ProjectionRoundTrips
}

spec ClosestParameterResult
{
    invariant match (self) { Found(t, d) => d.Value >= 0.0; Ambiguous(ts) => ts.Count >= 2; Failed(r) => true; };
    ensures self.IsFound == (self.CaseNumber == 0);   // Law_ClosestParameterResultRoundTrips
}

spec ClosureDecision
{
    invariant match (self) { ClosedByEnds(g) => g.Value >= 0.0; OpenByEnds(g) => g.Value > 0.0; _ => true; };
    ensures self.IsDecided == (self.CaseNumber != 3);   // Law_ClosureDecisionRoundTrips
    ensures self.ClosesCurve == (self.CaseNumber == 0 || self.CaseNumber == 2);
}

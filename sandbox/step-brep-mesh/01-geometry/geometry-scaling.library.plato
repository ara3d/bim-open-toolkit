//==
// # BrepGeometryScaling
//
// Layer 1 of the STEP B-rep to mesh design (README.md beside this file): the
// arena scaled about the origin by a factor k > 0, record by record, pcurves
// included. Layer 2's ScaledBy(m, k) and the metamorphic laws of layer 7 build
// on it (reviews/FIX-WAVE.md, ownership table).
//
// The rule: positions, radii, distances and every vector that sets a speed
// scale by k, so no curve's parameter changes (Line(P, V) becomes
// Line(k P, k V), a point at t stays at t). Only a parameter measured along a
// unit axis of a placement cannot keep its value: the plane's u and v, the v of
// a cylinder and of a cone (axial) are lengths along unit frame axes, and the
// scaled surface reaches the scaled point at k times the parameter
// (ParameterScaleFactor). An angle never changes. A pcurve's 2D curve lives in
// its surface's parameter plane, so its coordinates scale by that surface's
// factors (ScaledPcurve): both directions alike on a plane, only v on a
// cylinder or cone, neither on a sphere or torus.
//
// Sections, in order:
//  - Curves
//  - Surfaces
//  - Pcurves
//  - The arena

library BrepGeometryScaling
{
    //==
    // # Curves

    // The curve scaled about the origin by k > 0, its parameter unchanged:
    // Eval of the result at t is k times Eval of the curve at t.
    ScaledCurve(curve: BrepCurve, k: Number): BrepCurve
        => match (curve)
        {
            Line(origin, velocity) => BrepCurve.Line((origin.PositionVector * k).ToPoint, velocity * k);
            Circle(placement, radius) => BrepCurve.Circle(placement.ScaledFrame(k), radius * k);
            Ellipse(placement, semiAxis1, semiAxis2) => BrepCurve.Ellipse(placement.ScaledFrame(k), semiAxis1 * k, semiAxis2 * k);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => BrepCurve.Hyperbola(placement.ScaledFrame(k), semiAxis * k, semiImaginaryAxis * k);
            Parabola(placement, focalDistance) => BrepCurve.Parabola(placement.ScaledFrame(k), focalDistance * k);
            Polyline(points) => BrepCurve.Polyline(points.Map(p => (p.PositionVector * k).ToPoint));
            BSpline(data) => BrepCurve.BSpline(BSplineCurveData(data.Basis, data.ControlPoints.Map(p => (p.PositionVector * k).ToPoint), data.Weights));
            Trimmed(basis, range, sameSense) => curve;
            Composite(segments) => curve;
            Offset(basis, distance, reference) => BrepCurve.Offset(basis, distance * k, reference);
            OnSurface(spaceCurve, supports, master) => curve;
        };

    // The frame with its origin scaled about the origin by k, its axes kept.
    ScaledFrame(f: Frame3D, k: Number): Frame3D
        => Frame3D((f.Origin.PositionVector * k).ToPoint, f.XAxis, f.YAxis, f.ZAxis);

    //==
    // # Surfaces

    // The surface scaled about the origin by k > 0: Eval of the result at
    // (fu u, fv v) is k times Eval of the surface at (u, v), with fu and fv
    // its ParameterScaleFactor in each direction.
    ScaledSurface(surface: BrepSurface, g: GeometrySet, k: Number): BrepSurface
        => match (surface)
        {
            Plane(placement) => BrepSurface.Plane(placement.ScaledFrame(k));
            Cylinder(placement, radius) => BrepSurface.Cylinder(placement.ScaledFrame(k), radius * k);
            Cone(placement, radius, semiAngle) => BrepSurface.Cone(placement.ScaledFrame(k), radius * k, semiAngle);
            Sphere(placement, radius) => BrepSurface.Sphere(placement.ScaledFrame(k), radius * k);
            Torus(placement, major, minor, part) => BrepSurface.Torus(placement.ScaledFrame(k), major * k, minor * k, part);
            Revolution(profile, axis) => BrepSurface.Revolution(profile, InfiniteLine3D((axis.Origin.PositionVector * k).ToPoint, axis.Direction));
            LinearExtrusion(profile, extrusion) => BrepSurface.LinearExtrusion(profile, extrusion * k);
            BSpline(data) => BrepSurface.BSpline(BSplineSurfaceData(data.U, data.V,
                MakeArray2D(data.ControlPoints.ColumnCount, data.ControlPoints.RowCount, (i, j) => (data.ControlPoints.At(i, j).PositionVector * k).ToPoint),
                data.Weights));
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => BrepSurface.RectangularTrimmed(basis,
                uRange.ScaledRange(g.ParameterScaleFactor(basis, SurfaceParameter.ParameterU, k)),
                vRange.ScaledRange(g.ParameterScaleFactor(basis, SurfaceParameter.ParameterV, k)),
                uSense, vSense);
            Offset(basis, distance) => BrepSurface.Offset(basis, distance * k);
        };

    // The factor by which scaling the model by k scales surface s's given
    // parameter: k for a length along a unit frame axis (the plane's u and v,
    // a cylinder's and a cone's v), the basis's for a trim or an offset, 1
    // otherwise (angles, knots, and profile parameters, which ScaledCurve
    // keeps).
    ParameterScaleFactor(g: GeometrySet, s: SurfaceIndex, which: SurfaceParameter, k: Number): Number
        => g.SurfaceAt(s).ParameterScaleFactor(g, which, k);

    // ParameterScaleFactor for one record of the arena g, which holds the entries it references.
    ParameterScaleFactor(surface: BrepSurface, g: GeometrySet, which: SurfaceParameter, k: Number): Number
        => match (surface)
        {
            Plane(placement) => k;
            Cylinder(placement, radius) => which.Along(1.0, k);
            Cone(placement, radius, semiAngle) => which.Along(1.0, k);
            Sphere(placement, radius) => 1.0;
            Torus(placement, major, minor, part) => 1.0;
            Revolution(profile, axis) => 1.0;
            LinearExtrusion(profile, extrusion) => 1.0;
            BSpline(data) => 1.0;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => g.ParameterScaleFactor(basis, which, k);
            Offset(basis, distance) => g.ParameterScaleFactor(basis, which, k);
        };

    // The range with both ends multiplied by f.
    ScaledRange(r: NumberInterval, f: Number): NumberInterval
        => NumberInterval(r.Start * f, r.End * f);

    //==
    // # Pcurves

    // The 2D curve of a pcurve on surface s, rescaled for the model scaled by
    // k: each coordinate multiplied by s's ParameterScaleFactor in it, its own
    // parameter unchanged. Lines, polylines and splines map exactly. A conic or
    // an offset maps exactly when both factors agree (a plane, a sphere, a
    // torus); under unequal factors (a circle in the parameter plane of a
    // cylinder) the image of a conic is a conic with axes no longer
    // orthonormal, which AnisotropicConic writes as a rational B-spline. An
    // offset 2D curve under unequal factors has no exact image of any case
    // (the image of an offset is not the offset of the image); precondition:
    // no 2D offset curve lies on a surface whose factors differ (README,
    // "Left open").
    ScaledPcurve(curve: BrepCurve2D, g: GeometrySet, s: SurfaceIndex, k: Number): BrepCurve2D
        => g.ScaledCurve2D(curve,
            g.ParameterScaleFactor(s, SurfaceParameter.ParameterU, k),
            g.ParameterScaleFactor(s, SurfaceParameter.ParameterV, k));

    // The 2D curve with its u coordinates multiplied by fu and its v
    // coordinates by fv.
    ScaledCurve2D(g: GeometrySet, curve: BrepCurve2D, fu: Number, fv: Number): BrepCurve2D
        => match (curve)
        {
            Line(origin, velocity) => BrepCurve2D.Line(UvCoordinate(origin.U * fu, origin.V * fv), Vector2D(velocity.X * fu, velocity.Y * fv));
            Circle(placement, radius) => fu == fv
                ? BrepCurve2D.Circle(placement.ScaledFrame(fu), radius * fu)
                : curve.AnisotropicConic(fu, fv);
            Ellipse(placement, semiAxis1, semiAxis2) => fu == fv
                ? BrepCurve2D.Ellipse(placement.ScaledFrame(fu), semiAxis1 * fu, semiAxis2 * fu)
                : curve.AnisotropicConic(fu, fv);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => fu == fv
                ? BrepCurve2D.Hyperbola(placement.ScaledFrame(fu), semiAxis * fu, semiImaginaryAxis * fu)
                : curve.AnisotropicConic(fu, fv);
            Parabola(placement, focalDistance) => fu == fv
                ? BrepCurve2D.Parabola(placement.ScaledFrame(fu), focalDistance * fu)
                : curve.AnisotropicConic(fu, fv);
            Polyline(points) => BrepCurve2D.Polyline(points.Map(p => UvCoordinate(p.U * fu, p.V * fv)));
            BSpline(data) => BrepCurve2D.BSpline(BSplineCurve2DData(data.Basis, data.ControlPoints.Map(p => UvCoordinate(p.U * fu, p.V * fv)), data.Weights));
            Trimmed(basis, range, sameSense) => curve;
            Composite(segments) => curve;
            Offset(basis, distance) => BrepCurve2D.Offset(basis, distance * fu);
        };

    // The plane frame with its origin's coordinates multiplied by f.
    ScaledFrame(f: Frame2D, k: Number): Frame2D
        => Frame2D(Point2D(f.Origin.X * k, f.Origin.Y * k), f.XAxis, f.YAxis);

    // deferred: the image of a 2D conic under the map (u, v) -> (fu u, fv v),
    // as an exact rational quadratic B-spline over the conic's parameter
    // range split into arcs of at most a quarter turn (Piegl and Tiller, The
    // NURBS Book, 7.5), the control points mapped, the weights kept. A circle
    // or ellipse in a cylinder's or cone's parameter plane takes this path.
    AnisotropicConic(curve: BrepCurve2D, fu: Number, fv: Number): BrepCurve2D;

    //==
    // # The arena

    // The arena scaled about the origin by k > 0: every curve and surface
    // scaled, every 2D curve rescaled for the surface whose pcurve uses it
    // (SurfaceOf), the pcurve records and closure marks unchanged (indices).
    // A 2D curve no pcurve reaches is kept.
    ScaledGeometry(g: GeometrySet, k: Number): GeometrySet
        => GeometrySet(
            g.Curves.Map(curve => curve.ScaledCurve(k)),
            g.Curves2D.Count.MapRange(i => g.SurfaceOf(Curve2DIndex(i), g.ReferenceFuel).IsNone
                ? g.Curve2DAt(Curve2DIndex(i))
                : g.Curve2DAt(Curve2DIndex(i)).ScaledPcurve(g, g.SurfaceOf(Curve2DIndex(i), g.ReferenceFuel), k)),
            g.Pcurves,
            g.Surfaces.Map(surface => surface.ScaledSurface(g, k)),
            g.Closures);

    // The surface in whose parameter plane 2D curve c lies: the surface of
    // the first pcurve whose 2D curve is c, or else that of the first 2D curve
    // that uses c as its basis or a segment; none (-1) when no pcurve reaches
    // c within fuel steps. Each decoded 2D curve belongs to one pcurve's
    // definitional representation, so one surface.
    SurfaceOf(g: GeometrySet, c: Curve2DIndex, fuel: Integer): SurfaceIndex
    {
        var direct = g.Pcurves.FlatMap(p => p.Curve == c ? [p.Surface] : [SurfaceIndex(-1)].Take(0));
        var parents = g.Curves2D.Count.Range.FlatMap(i => g.Curve2DAt(Curve2DIndex(i)).Uses(c) ? [Curve2DIndex(i)] : [Curve2DIndex(-1)].Take(0));
        return direct.Count > 0
            ? direct[0]
            : (fuel <= 0 || parents.Count == 0 ? SurfaceIndex(-1) : g.SurfaceOf(parents[0], fuel - 1));
    }

    // True when the 2D curve references c as its basis or one of its segments.
    Uses(curve: BrepCurve2D, c: Curve2DIndex): Boolean
        => match (curve)
        {
            Line(origin, velocity) => false;
            Circle(placement, radius) => false;
            Ellipse(placement, semiAxis1, semiAxis2) => false;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => false;
            Parabola(placement, focalDistance) => false;
            Polyline(points) => false;
            BSpline(data) => false;
            Trimmed(basis, range, sameSense) => basis == c;
            Composite(segments) => segments.Any(segment => segment.Curve == c);
            Offset(basis, distance) => basis == c;
        };
}

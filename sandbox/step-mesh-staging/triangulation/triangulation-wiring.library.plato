//==
// # The library's meshing chain with the new triangulation wired in (TKT-343, staging only)
//
// Copies of layer 5's FaceTriangulation and MeshFace and layer 8's loop, each calling the copy
// below it, so that the staged step A and B laws (triangulation-steps.laws.plato) see what the
// library will compute once TriangulateRegion and RefineToSurface point at TriangulateRegionCdt
// and RefineToSurfaceByInsertion. Nothing here is merged: the merge makes the two wiring edits
// in TRACK.md and deletes this file. Each function names the one it copies.
//
// Sections, in order:
//  - Layer 5
//  - Layer 8

library TriangulationWiring
{
    //==
    // # Layer 5

    // RefinedTriangulation.
    RefinedTriangulationCdt(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, c: FaceMeshingCriteria): UvTriangulation
        => m.RefineToSurfaceByInsertion(f, r, chart, r.TriangulateRegionCdt(chart), c);

    // GridOrTriangles.
    GridOrTrianglesCdt(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, grid: QuadGridOutcome, c: FaceMeshingCriteria): UvTriangulation
        => match (grid) {
            NoGrid => m.RefinedTriangulationCdt(f, r, chart, c);
            CountsDiffer(floors) => m.RefinedTriangulationCdt(f, r, chart, c);
            Grid(mesh) => mesh;
        };

    // FaceTriangulation.
    FaceTriangulationCdt(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): UvTriangulation
    {
        var r = m.RegionOf(f, d, c);
        var chart = m.ChartOf(f, r);
        return m.GridOrTrianglesCdt(f, r, chart, m.FaceQuadGrid(f, d, r, c), c);
    }

    // MeshedOutcome.
    MeshedOutcomeCdt(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, raw: UvRegion, r: UvRegion, chart: FaceChart, c: FaceMeshingCriteria): FaceMeshOutcome
    {
        var grid = m.FaceQuadGrid(f, d, r, c);
        var t = m.GridOrTrianglesCdt(f, r, chart, grid, c);
        var advisory = m.CoarseSegmentRequests(f, d, r, c).Concatenate(m.QuadCountRequests(d, grid, c));
        return FaceMeshOutcome(m.Lift(f, d, t), advisory,
            advisory.Map(q => q.RequestDiagnostic).Concatenate(m.ReversalDiagnostics(f, raw)));
    }

    // MeshRegion.
    MeshRegionCdt(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): FaceMeshOutcome
    {
        var raw = m.UnorientedRegionOf(f, d, c);
        var r = m.OrientRegion(f, raw);
        var chart = m.ChartOf(f, r);
        var blocking = m.SelfIntersectionRequests(f, d, r, m.RegionTolerance(f, chart));
        return r.IsSimpleRegion(m.RegionTolerance(f, chart))
            ? m.MeshedOutcomeCdt(f, d, raw, r, chart, c)
            : (blocking.Count > 0
                ? FaceMeshOutcome(EmptyFaceMesh(f), blocking, blocking.Map(q => q.RequestDiagnostic))
                : f.UnmeshedOutcome("FACE-REGION-NOT-SIMPLE",
                    "Synthetic seam or pole segments of this face collide in parameter space; the face is not meshed."));
    }

    // MeshFace.
    MeshFaceCdt(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): FaceMeshOutcome
        => m.HasPolyLoop(f)
            ? f.UnmeshedOutcome("FACE-POLY-LOOP",
                "This face is bounded by a poly loop, which version 1 does not mesh; the decoder should give it edges.")
            : m.MeshRegionCdt(f, d, c);

    //==
    // # Layer 8

    // FaceOutcome.
    FaceOutcomeCdt(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, o: MeshingOptions, chosen: Array<Boolean>): FaceMeshOutcome
        => !chosen.IsChosen(f)
            ? f.UnmeshedOutcome("PIPELINE-FACE-EXCLUDED",
                "This face was left out of the run; it has no mesh.")
            : (m.IsDiscretizedFace(f, d)
                ? m.MeshFaceCdt(f, d, o.Face)
                : f.UnmeshedOutcome("PIPELINE-FACE-UNDISCRETIZED",
                    "This face is not intact or cites an edge that has no discretization; it is not meshed."));

    // InitialState.
    InitialStateCdt(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>): PipelineState
    {
        var d = m.DiscretizeAll(o.Face.Discretization, SegmentFloors.NoFloors);
        var outcomes = m.Faces.Count.MapRange(k => m.FaceOutcomeCdt(BrepFaceIndex(k), d, o, chosen));
        return PipelineState(0, d, SegmentFloors.NoFloors, outcomes, outcomes.RequestsOf(chosen));
    }

    // Step.
    StepCdt(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>, s: PipelineState): PipelineState
    {
        var d = m.Refine(s.Discretizations, s.Pending, o.Face.Discretization);
        var remeshed = m.FacesTouching(chosen, d.ChangedEdges(s.Discretizations));
        var outcomes = m.Faces.Count.MapRange(k =>
            remeshed[k] ? m.FaceOutcomeCdt(BrepFaceIndex(k), d, o, chosen) : s.Outcomes[k]);
        return PipelineState(s.Round + 1, d, m.RaisedFloors(s.Floors, s.Pending), outcomes, outcomes.RequestsOf(remeshed));
    }

    // FinalState (StateAfter the round limit).
    FinalStateCdt(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>): PipelineState
    {
        var s = m.InitialStateCdt(o, chosen);
        while (s.Round < o.MaxRefinementRounds ? !s.IsTerminal(o) : false)
        {
            s = m.StepCdt(o, chosen, s);
        }
        return s;
    }

    // RunOutcome.
    RunOutcomeCdt(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>): MeshOutcome
    {
        var s = m.FinalStateCdt(o, chosen);
        var mesh = m.AssembledMesh(s);
        var report = m.LoopReport(o, chosen, s).Merge(m.Validated(mesh, o));
        return MeshOutcomeOf(mesh, report.Located(Provenance.WholeInput), s.Round);
    }

    // MeshModel (MeshChosenFaces over every face).
    MeshModelCdt(m: BrepModel, o: MeshingOptions): MeshOutcome
        => m.IsRunnable(o) ? m.RunOutcomeCdt(o, m.AllFaces) : m.RefusedOutcome(o);
}

//==
// # Refinement without whole-triangulation flip passes (TKT-351, staging)
//
// Layer 05-face-meshing. The profile of RefineToSurfaceByInsertion (TRACK.md, "Profile") spent 18
// of 20 s in Delaunayed: every trial of an angle insertion flipped the whole triangulation, and
// each FlipPass rebuilt the neighbour table with a sort. An insertion only changes the triangles
// near the new point, so RefineToSurfaceFast inserts one point at a time and flips locally, as
// Lawson's incremental insertion does (de Berg et al., Computational Geometry, 9.3): after point
// p splits its triangle, only the sides opposite p are tested, and each flip queues the two new
// sides opposite p. Every side tested is a side of the triangulation before the insertion, and the
// triangle across it is one the insertion has not touched, so a neighbour table of that
// triangulation (UvDelaunay's NeighbourTable, built once per pass) answers every lookup; after a
// kept insertion, UpdatedNeighbours rewrites the entries of the triangles around p. From a
// constrained Delaunay triangulation this ends in one (a boundary segment is never flipped). The
// surface pass becomes sequential too, so no pass flips the whole triangulation. The in-circle
// test loses its generic sort (InCircleOfFast).
//
// The rules for a point (strictly inside, at least the minimum length from the corners it joins,
// every new triangle positive) and the angle pass's guard are TriangulationRefine's.
//
// Sections, in order:
//  - The in-circle test
//  - Searches
//  - Local insertion
//  - Flipping a whole triangulation
//  - The surface pass
//  - The angle pass
//  - Refinement

library TriangulationFast
{
    //==
    // # The in-circle test

    // InCircleOf without the generic sort: the rank of each of the four indices (the number of
    // smaller ones, ties broken by position) places it, and the inversions give the sign. The
    // determinant is the same number InCircleOf computes, so every law of it carries over.
    InCircleOfFast(points: Array<Point2D>, a: Integer, b: Integer, c: Integer, d: Integer): Number
    {
        var ids = [a, b, c, d];
        var ranks = 4.MapRange(i => 4.Range.Reduce(0, (n, j) => (ids[j] < ids[i] || (ids[j] == ids[i] && j < i)) ? n + 1 : n));
        var s = 4.MapRange(k => ids[4.Range.Reduce(0, (found, i) => ranks[i] == k ? i : found)]);
        var inversions = 4.Range.Reduce(0, (n, i) => 4.Range.Reduce(n, (m, j) => (i < j && ids[i] > ids[j]) ? m + 1 : m));
        var det = InCircle(points[s[0]], points[s[1]], points[s[2]], points[s[3]]);
        return inversions % 2 == 0 ? det : 0.0 - det;
    }

    // IsFlippableCdt with InCircleOfFast; deleted at merge, when InCircleOf is the fast one.
    IsFlippableFast(r: UvRegion, points: Array<Point2D>, t: TriangleFace, j: Integer, u: TriangleFace): Boolean
    {
        var a = t.Corner(j);
        var b = t.Corner(j + 1);
        var c = t.Corner(j + 2);
        var d = u.OppositeCorner(a, b);
        return (d < 0 || r.IsConstrained(a, b))
            ? false
            : (TwiceSignedArea(points[a], points[d], points[c]) > 0.0
                && TwiceSignedArea(points[d], points[b], points[c]) > 0.0
                && InCircleOfFast(points, a, b, c, d) > 0.0);
    }

    //==
    // # Searches

    // The slot (0, 1 or 2) of the directed side from a to b in triangle x; -1 when x has none.
    SideSlot(x: TriangleFace, a: Integer, b: Integer): Integer
        => (x.A.Value == a && x.B.Value == b) ? 0
            : ((x.B.Value == a && x.C.Value == b) ? 1 : ((x.C.Value == a && x.A.Value == b) ? 2 : -1));

    // Whether point p is a corner of triangle x.
    HasCorner(x: TriangleFace, p: Integer): Boolean
        => x.A.Value == p || x.B.Value == p || x.C.Value == p;

    // The triangle holding chart point p, found by walking from triangle `from` across the side p
    // lies beyond (a side whose twice signed area with p is negative) until no side is; -1 when
    // the walk leaves through a boundary side (p is outside the region where the walk crossed it,
    // so the point is refused, as Ruppert's refinement inserts only points the failing triangle
    // sees) or takes more steps than there are triangles. Off-centres and circumcentres often land
    // a few triangles away; on the bump solid's top face most land outside, and a full search for
    // them (3251 lookups) took 49 s of 236.
    WalkTo(points: Array<Point2D>, tris: Array<TriangleFace>, nb: Array<Integer>, from: Integer, p: Point2D): Integer
    {
        var t = from;
        var steps = 0;
        var found = -1;
        while (found < 0 && t >= 0 && steps <= tris.Count)
        {
            var x = tris[t];
            var j = TwiceSignedArea(points[x.A], points[x.B], p) < 0.0 ? 0
                : (TwiceSignedArea(points[x.B], points[x.C], p) < 0.0 ? 1
                    : (TwiceSignedArea(points[x.C], points[x.A], p) < 0.0 ? 2 : -1));
            if (j < 0)
            {
                found = t;
            }
            else
            {
                t = nb[3 * t + j];
            }
            steps = steps + 1;
        }
        return found;
    }

    // The smallest lifted angle of the triangles of `after` at `changed` (the positions where it
    // differs from `before`) and of the triangles of `before` they replaced; pi for none.
    // TriangulationRefine's ChangedAngles without its scan of every triangle.
    ChangedAnglesAt(m: BrepModel, f: BrepFaceIndex, pts: Array<UvCoordinate>, before: Array<TriangleFace>, after: Array<TriangleFace>, changed: Array<Integer>): Array<Number>
        => [changed.Reduce(Number.Pi, (x, i) => x.Min(m.LiftedAngleOf(f, pts, after[i]))),
            changed.Reduce(Number.Pi, (x, i) => i < before.Count ? x.Min(m.LiftedAngleOf(f, pts, before[i])) : x)];

    //==
    // # Local insertion

    // The triangles after Lawson's flips around point p. `queue` holds quadruples (a, b, t, o):
    // triangle t is (a, b, p), and o is the triangle across the side from a to b before the
    // insertion (-1 for a boundary side), read from nb. A quadruple is tested while t still has
    // that side and o is untouched (it has the side from b to a and no corner p); when the side is
    // flippable, t and o = (b, a, d) become (a, d, p) and (d, b, p) in place, and the sides from a
    // to d and from d to b are queued with the triangles across them in nb. At most four flips per
    // triangle, a guard against rounding.
    FlippedAround(r: UvRegion, points: Array<Point2D>, tris: Array<TriangleFace>, nb: Array<Integer>, p: Integer, sides: Array<Integer>): Array<TriangleFace>
    {
        var result = tris.EmptyList.AddRange(tris);
        var queue = new List<Integer>().AddRange(sides);
        var i = 0;
        var flips = 0;
        while (i + 3 < queue.Count && flips < 4 * tris.Count)
        {
            var a = queue.At(i);
            var b = queue.At(i + 1);
            var t = queue.At(i + 2);
            var o = queue.At(i + 3);
            var live = o < 0 ? false
                : (result.At(t).SideSlot(a, b) >= 0 && result.At(o).SideSlot(b, a) >= 0 && result.At(o).HasCorner(p).Not);
            if (live ? r.IsFlippableFast(points, TriangleOf(a, b, p), 0, result.At(o)) : false)
            {
                var u = result.At(o);
                var d = u.OppositeCorner(a, b);
                var o1 = nb[3 * o + u.SideSlot(a, d)];
                var o2 = nb[3 * o + u.SideSlot(d, b)];
                result = result.Set(t, TriangleOf(a, d, p)).Set(o, TriangleOf(d, b, p));
                queue = queue.Add(a).Add(d).Add(t).Add(o1).Add(d).Add(b).Add(o).Add(o2);
                flips = flips + 1;
            }
            i = i + 4;
        }
        return result.Freeze();
    }

    // The triangles with point pi split in (SplitAt: inside triangle q = (a, b, e), or with
    // d >= 0 on its side from a to b with triangle u = (b, a, d)), then FlippedAround pi from the
    // sides opposite it, each with the triangle across it in nb.
    InsertedLocally(r: UvRegion, points: Array<Point2D>, tris: Array<TriangleFace>, nb: Array<Integer>, q: Integer, u: Integer, a: Integer, b: Integer, e: Integer, d: Integer, pi: Integer): Array<TriangleFace>
    {
        var n0 = tris.Count;
        var sq = tris[q].SideSlot(a, b);
        var split = tris.EmptyList.AddRange(tris).SplitAt(q, u, a, b, e, d, pi).Freeze();
        var sides = d < 0
            ? [a, b, q, nb[3 * q + sq], b, e, n0, nb[3 * q + (sq + 1) % 3], e, a, n0 + 1, nb[3 * q + (sq + 2) % 3]]
            : [e, a, q, nb[3 * q + (sq + 2) % 3], b, e, n0, nb[3 * q + (sq + 1) % 3],
                d, b, u, nb[3 * u + tris[u].SideSlot(d, b)], a, d, n0 + 1, nb[3 * u + tris[u].SideSlot(a, d)]];
        return r.FlippedAround(points, split, nb, pi, sides);
    }

    // Whether list xs holds x.
    Holds(xs: List<Integer>, x: Integer): Boolean
    {
        var i = 0;
        var found = false;
        while (found.Not && i < xs.Count)
        {
            found = xs.At(i) == x;
            i = i + 1;
        }
        return found;
    }

    // The positions where `after` (before with one point inserted at triangle q) differs from
    // `before`: the cavity of old triangles it rewrote, found from q across before's neighbour
    // table nb (the cavity is connected), then every appended triangle. A scan of every triangle
    // per trial took 21 s of 244 on the bump solid's top face.
    ChangedNear(before: Array<TriangleFace>, nb: Array<Integer>, after: Array<TriangleFace>, q: Integer): Array<Integer>
    {
        var seen = new List<Integer>().Add(q);
        var i = 0;
        while (i < seen.Count)
        {
            var t = seen.At(i);
            var s = 0;
            while (s < 3)
            {
                var o = nb[3 * t + s];
                if ((o >= 0 ? after[o] != before[o] : false) ? seen.Holds(o).Not : false)
                {
                    seen = seen.Add(o);
                }
                s = s + 1;
            }
            i = i + 1;
        }
        return seen.Freeze().Concatenate((after.Count - before.Count).MapRange(j => before.Count + j));
    }

    // The neighbour table of `after`, the triangulation `before` with point p inserted at
    // triangle q (the one it split), from before's table nb: the changed triangles are exactly those around p (in place or appended);
    // a side through p borders another of them, and a side opposite p borders the triangle that
    // bordered it before, whose own entry is pointed back.
    UpdatedNeighbours(before: Array<TriangleFace>, nb: Array<Integer>, after: Array<TriangleFace>, p: Integer, q: Integer): Array<Integer>
    {
        var n0 = before.Count;
        var fan = before.ChangedNear(nb, after, q);
        var result = new List<Integer>().AddRange(nb).AddRange((3 * (after.Count - n0)).MapRange(i => -1));
        var w = 0;
        while (w < fan.Count)
        {
            var i = fan[w];
            var s = 0;
            while (s < 3)
            {
                var a = after[i].Corner(s);
                var b = after[i].Corner(s + 1);
                if (a == p || b == p)
                {
                    result = result.Set(3 * i + s, fan.Reduce(-1, (found, g) => found >= 0 ? found : (after[g].SideSlot(b, a) >= 0 ? g : -1)));
                }
                else
                {
                    var owner = fan.Reduce(-1, (found, g) => found >= 0 ? found : ((g < n0 ? before[g].SideSlot(a, b) >= 0 : false) ? g : -1));
                    var o = owner < 0 ? -1 : nb[3 * owner + before[owner].SideSlot(a, b)];
                    result = result.Set(3 * i + s, o);
                    if (o >= 0)
                    {
                        result = result.Set(3 * o + before[o].SideSlot(b, a), i);
                    }
                }
                s = s + 1;
            }
            w = w + 1;
        }
        return result.Freeze();
    }

    // The triangles with parameter point uv inserted for triangle k, located by WalkTo from k; tris
    // unchanged when the point is refused: not reached by the walk, near a corner, on a boundary
    // segment, outside the region by its tolerance, within `least` of a corner it joins, or
    // leaving a non-positive triangle; and, when `guarded`, when the smallest lifted angle of the
    // triangles it changes is not larger than that of the triangles it removes. The point would be
    // pts.Count; points are the chart points of pts.
    TryInsertion(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, pts: Array<UvCoordinate>, points: Array<Point2D>, tris: Array<TriangleFace>, nb: Array<Integer>, k: Integer, uv: UvCoordinate, least: Number, guarded: Boolean): Array<TriangleFace>
    {
        var p = chart.ChartPoint(uv);
        var q = points.WalkTo(tris, nb, k, p);
        var tri = tris[q.Max(0)];
        var j = q < 0 ? 3 : points.PlaceInTriangle(tri, p);
        var a = tri.Corner(j.Max(0));
        var b = tri.Corner(j.Max(0) + 1);
        var e = tri.Corner(j.Max(0) + 2);
        var u = (j >= 0 && j < 3) ? nb[3 * q + j] : -1;
        var d = u < 0 ? -1 : tris[u].OppositeCorner(a, b);
        var ring = d < 0 ? [a, b, e] : [a, d, b, e];
        var free = j == 3 ? false : (j < 0 ? true : (u >= 0 ? r.IsConstrained(a, b).Not : false));
        var good = free
            ? (points.SplitIsPositive(a, b, e, d, p)
                && r.IsStrictlyInside(uv, m.RegionTolerance(f, chart))
                && m.IsFarFromPoints(f, pts, ring, new List<UvCoordinate>(), uv, least))
            : false;
        var inserted = good ? r.InsertedLocally(points.Concatenate([p]), tris, nb, q, u, a, b, e, d, pts.Count) : tris;
        var angles = (good && guarded) ? m.ChangedAnglesAt(f, pts.Concatenate([uv]), tris, inserted, tris.ChangedNear(nb, inserted, q)) : [1.0, 0.0];
        return (good && angles[0] > angles[1]) ? inserted : tris;
    }

    //==
    // # Flipping a whole triangulation

    // nb with the entry of triangle o for its side from y to x pointed at triangle at; nb as it is
    // when o is -1 (a boundary side).
    PointedBack(nb: List<Integer>, tris: List<TriangleFace>, o: Integer, x: Integer, y: Integer, at: Integer): List<Integer>
        => o < 0 ? nb : nb.Set(3 * o + tris.At(o).SideSlot(y, x), at);

    // Delaunayed without passes: one neighbour table, then a queue of side slots (3 t + j), every
    // slot to start with. A slot is tested as its triangle is now; when its side is flippable, t =
    // (a, b, c) and u = (b, a, d) become (a, d, c) and (d, b, c) in place, the table entries of t,
    // u and the four triangles around them are rewritten, and the four outer sides are queued. Ends
    // when the queue is empty (no side is flippable: each flip changes only the sides it queues)
    // or after 3n^2 flips, a guard against rounding. Delaunayed rebuilt the table with a sort on
    // every pass: 102 passes for the 200-point plane face (TRACK.md, "Profile").
    DelaunayedQueue(r: UvRegion, points: Array<Point2D>, tris: Array<TriangleFace>): Array<TriangleFace>
    {
        var result = tris.EmptyList.AddRange(tris);
        var nb = new List<Integer>().AddRange(NeighbourTable(tris, points.Count));
        var queue = new List<Integer>().AddRange((3 * tris.Count).Range);
        var i = 0;
        var flips = 0;
        while (i < queue.Count && flips < 3 * tris.Count * tris.Count)
        {
            var s = queue.At(i);
            var t = s / 3;
            var j = s % 3;
            var u = nb.At(s);
            if (u >= 0 ? r.IsFlippableFast(points, result.At(t), j, result.At(u)) : false)
            {
                var a = result.At(t).Corner(j);
                var b = result.At(t).Corner(j + 1);
                var c = result.At(t).Corner(j + 2);
                var d = result.At(u).OppositeCorner(a, b);
                var tbc = nb.At(3 * t + (j + 1) % 3);
                var tca = nb.At(3 * t + (j + 2) % 3);
                var uad = nb.At(3 * u + result.At(u).SideSlot(a, d));
                var udb = nb.At(3 * u + result.At(u).SideSlot(d, b));
                result = result.Set(t, TriangleOf(a, d, c)).Set(u, TriangleOf(d, b, c));
                nb = nb.Set(3 * t, uad).Set(3 * t + 1, u).Set(3 * t + 2, tca)
                    .Set(3 * u, udb).Set(3 * u + 1, tbc).Set(3 * u + 2, t);
                nb = nb.PointedBack(result, uad, a, d, t).PointedBack(result, tca, c, a, t)
                    .PointedBack(result, udb, d, b, u).PointedBack(result, tbc, b, c, u);
                queue = queue.Add(3 * t).Add(3 * t + 2).Add(3 * u).Add(3 * u + 1);
                flips = flips + 1;
            }
            i = i + 1;
        }
        return result.Freeze();
    }

    // TriangulateRegionCdt with DelaunayedQueue in place of Delaunayed; deleted at merge, when
    // Delaunayed takes DelaunayedQueue's body.
    TriangulateRegionFast(r: UvRegion, chart: FaceChart): UvTriangulation
    {
        var points = r.BoundaryPoints.Map(uv => chart.ChartPoint(uv));
        var outer = r.Outer.Points.Count.Range;
        var holes = r.Holes.Count.Range.FlatMap(h =>
            r.Holes[h].Points.Count >= 3 ? [h] : r.Holes.Count.Range.Take(0));
        var bySide = holes.Sort((a, b) => r.HoleRightmost(points, a) >= r.HoleRightmost(points, b));
        var ring = bySide.Reduce(outer, (current, h) => current.HoleBridged(r.HoleRing(h), points, r.AllRingSegments(points)));
        var clipped = ring.EarClipped(points);
        var pointHoles = r.Holes.Count.Range.FlatMap(h =>
            r.Holes[h].Points.Count < 3 ? r.HoleRing(h) : r.Holes.Count.Range.Take(0));
        var triangles = r.DelaunayedQueue(points, pointHoles.Reduce(clipped, (ts, p) => ts.WithPointInserted(p, points)));
        return UvTriangulation(r.BoundaryPoints, r.BoundarySources, triangles, [QuadFace(VertexIndex(0), VertexIndex(0), VertexIndex(0), VertexIndex(0))].Take(0));
    }

    //==
    // # The surface pass

    // The point a surface criterion asks for in triangle k after its circumcentre was refused:
    // the parameter midpoint of its SplitSide, or its parameter centroid when every side is a
    // boundary segment (TriangulationRefine's SurfaceCandidate on the current triangles).
    SurfaceFallback(r: UvRegion, pts: Array<UvCoordinate>, points: Array<Point2D>, tris: Array<TriangleFace>, nb: Array<Integer>, k: Integer): UvCoordinate
    {
        var tri = tris[k];
        var j = r.SplitSide(points, tri, nb, k);
        return j < 0
            ? UvCoordinate((pts[tri.A].U + pts[tri.B].U + pts[tri.C].U) / 3.0, (pts[tri.A].V + pts[tri.B].V + pts[tri.C].V) / 3.0)
            : pts[tri.Corner(j)].UvMidpoint(pts[tri.Corner(j + 1)]);
    }

    // SurfacePass one point at a time: every triangle of t that exceeds a surface criterion
    // (surface[k]) and is still a triangle when its turn comes (triangles are rewritten in place or
    // appended, so it is still at index k) gets its circumcentre, or failing
    // that SurfaceFallback, through TryInsertion without the guard. The new points are Interior
    // and come after every existing point; quads are kept.
    SurfacePassLocal(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, t: UvTriangulation, surface: Array<Boolean>, c: FaceMeshingCriteria): UvTriangulation
    {
        var failing = t.Triangles.Count.Range.FlatMap(k => surface[k] ? [k] : t.Triangles.Count.Range.Take(0));
        var least = c.Discretization.EffectiveMinLength(m.Tolerances);
        var pts = t.Points;
        var points = pts.Map(x => chart.ChartPoint(x));
        var tris = t.Triangles;
        var nb = NeighbourTable(tris, pts.Count);
        var i = 0;
        while (i < failing.Count)
        {
            var k = failing[i];
            if (tris[k] == t.Triangles[k])
            {
                var centre = chart.Circumcentre(points, tris[k]);
                var first = m.TryInsertion(f, r, chart, pts, points, tris, nb, k, centre, least, false);
                var uv = first.Count > tris.Count ? centre : r.SurfaceFallback(pts, points, tris, nb, k);
                var next = first.Count > tris.Count ? first : m.TryInsertion(f, r, chart, pts, points, tris, nb, k, uv, least, false);
                if (next.Count > tris.Count)
                {
                    nb = UpdatedNeighbours(tris, nb, next, pts.Count, points.WalkTo(tris, nb, k, chart.ChartPoint(uv)));
                    tris = next;
                    pts = pts.Concatenate([uv]);
                    points = points.Concatenate([chart.ChartPoint(uv)]);
                }
            }
            i = i + 1;
        }
        return UvTriangulation(pts, t.Sources.Concatenate((pts.Count - t.Points.Count).MapRange(j => UvPointSource.Interior)), tris, t.Quads);
    }

    //==
    // # The angle pass

    // The indices of the triangles of t below RefinementMinAngle that refused[k] does not mark.
    BelowAngle(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, refused: Array<Boolean>): Array<Integer>
        => t.Triangles.Count.Range.FlatMap(k => ((k < refused.Count ? refused[k] : false) ? false
            : m.SmallestCornerAngle(f, t, t.Triangles[k]) < RefinementMinAngle(0)) ? [k] : t.Triangles.Count.Range.Take(0));

    // AnglePass one point at a time with local flips: every triangle below the angle that refused
    // does not mark, while it is still a triangle (still at its index), gets the first of
    // AngleCandidates that TryInsertion keeps under the guard; each candidate is tried once.
    AnglePassLocal(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, t: UvTriangulation, bad: Array<Integer>, c: FaceMeshingCriteria): UvTriangulation
    {
        var least = c.Discretization.EffectiveMinLength(m.Tolerances);
        var pts = t.Points;
        var points = pts.Map(x => chart.ChartPoint(x));
        var tris = t.Triangles;
        var nb = NeighbourTable(tris, pts.Count);
        var i = 0;
        while (i < bad.Count)
        {
            var k = bad[i];
            if (tris[k] == t.Triangles[k])
            {
                var candidates = chart.AngleCandidates(points, pts, tris[k]);
                var n = 0;
                while (n < candidates.Count)
                {
                    var next = m.TryInsertion(f, r, chart, pts, points, tris, nb, k, candidates[n], least, true);
                    if (next.Count > tris.Count)
                    {
                        nb = UpdatedNeighbours(tris, nb, next, pts.Count, points.WalkTo(tris, nb, k, chart.ChartPoint(candidates[n])));
                        tris = next;
                        pts = pts.Concatenate([candidates[n]]);
                        points = points.Concatenate([chart.ChartPoint(candidates[n])]);
                        n = candidates.Count;
                    }
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        return UvTriangulation(pts, t.Sources.Concatenate((pts.Count - t.Points.Count).MapRange(j => UvPointSource.Interior)), tris, t.Quads);
    }

    // A mark per triangle of `after` (from `before` by rewrites in place and appends): marked[k]
    // or tried[k] carried over where triangle k is unchanged, false elsewhere.
    CarriedMarks(before: Array<TriangleFace>, marked: Array<Boolean>, tried: Array<Integer>, after: Array<TriangleFace>): Array<Boolean>
    {
        var marks = new List<Boolean>().AddRange(before.Count.MapRange(k => k < marked.Count ? marked[k] : false));
        var i = 0;
        while (i < tried.Count)
        {
            marks = marks.Set(tried[i], true);
            i = i + 1;
        }
        var all = marks.Freeze();
        return after.Count.MapRange(k => k < before.Count ? (all[k] && after[k] == before[k]) : false);
    }

    //==
    // # Refinement

    // RefineToSurfaceByInsertion with SurfacePassLocal and AnglePassLocal, and a memory of refused
    // triangles: a triangle the angle pass tried and could not improve (it is still there
    // afterwards, unchanged) is not tried again while it stays unchanged. The profile showed some 65
    // such triangles on the cylinder side face retried, four candidates each, in every one of the
    // last eight rounds. Up to forty rounds while a round adds a point; the surface criteria are
    // not tested on a plane; a triangle known to meet them is not tested again while unchanged.
    RefineToSurfaceFast(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, t: UvTriangulation, c: FaceMeshingCriteria): UvTriangulation
    {
        var planar = m.Geometry.SurfaceAt(m.SurfaceOf(f)).IsPlanarRecord;
        var current = t;
        var known = t.Triangles.Map(x => false);
        var refused = t.Triangles.Map(x => false);
        var pass = 0;
        var changed = true;
        while (pass < 40 && changed)
        {
            var surface = planar ? current.Triangles.Map(x => false) : m.NeedsRefinement(f, r, current, known, c);
            var mid = m.SurfacePassLocal(f, r, chart, current, surface, c);
            var carried = current.Triangles.CarriedMarks(refused, [0].Take(0), mid.Triangles);
            var bad = m.BelowAngle(f, mid, carried);
            var next = m.AnglePassLocal(f, r, chart, mid, bad, c);
            refused = mid.Triangles.CarriedMarks(carried, bad, next.Triangles);
            known = KnownGood(current, surface, next);
            changed = next.Points.Count > current.Points.Count;
            current = next;
            pass = pass + 1;
        }
        return current;
    }
}

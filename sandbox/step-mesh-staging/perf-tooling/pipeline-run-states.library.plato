//==
// # The refinement loop's states and outcome from a finished state (complexity sweep, chunk L7)
//
// Layer 8 functions for the tooling (layer 9) and for MeshModel itself: every state of one run
// built in one pass, and the outcome of a run whose final state is already built, so a caller that
// holds the states (DumpStagesOnce) or the validation parts (CheckedWitnessOf) does not replay the
// loop or validate a second time. At merge both move into 08-pipeline/pipeline.library.plato
// (TRACK.md, "Merge instructions").
//
// Sections, in order:
//  - Every state of one run
//  - The outcome of a finished run

library StepToMeshRunStates
{
    //==
    // # Every state of one run

    // The states of the loop over the chosen faces from InitialState to the terminal state, one per
    // round, each built from the one before by one Step: states[k] is StateAfter(o, chosen, k) for
    // k from 0 to the final round. One pass, where mapping StateAfter over the rounds replays the
    // loop from the start for each round.
    StatesOf(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>): Array<PipelineState>
    {
        var s = m.InitialState(o, chosen);
        var states = new List<PipelineState>();
        states = states.Add(s);
        while (s.Round < o.MaxRefinementRounds ? !s.IsTerminal(o) : false)
        {
            s = m.Step(o, chosen, s);
            states = states.Add(s);
        }
        return states.Freeze();
    }

    //==
    // # The outcome of a finished run

    // The outcome of the run over the chosen faces that ended in state s, given the mesh assembled
    // from s and the validation report of that mesh (Validated's): the loop's findings and the
    // validation merged and located, and the rounds taken. RunOutcome's last two lines.
    OutcomeOfRun(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>, s: PipelineState,
            mesh: ModelMesh, validation: Report): MeshOutcome
        => MeshOutcomeOf(mesh, m.LoopReport(o, chosen, s).Merge(validation).Located(Provenance.WholeInput), s.Round);

    // RunOutcome(m, o, chosen) when s is FinalState(o, chosen), without running the loop again:
    // the mesh assembled from s and validated at o.Level.
    RunOutcomeFrom(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>, s: PipelineState): MeshOutcome
    {
        var mesh = m.AssembledMesh(s);
        return m.OutcomeOfRun(o, chosen, s, mesh, m.Validated(mesh, o));
    }
}

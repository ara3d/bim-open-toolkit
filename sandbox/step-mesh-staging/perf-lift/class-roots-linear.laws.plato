//==
// # Equivalence classes with path halving: laws (complexity sweep, chunk F3)
//
// ClassRootsLinear agrees with ClassRoots on pseudo-random join lists: n items
// for n from -1 to 12, and for each n a list of 2n + 3 joins whose items fall
// in -1 to n, so some joins name an item out of range and are ignored. The
// runner exhausts both Integer parameters (196 cases).
//
// Sections, in order:
//  - Join lists
//  - Agreement

library BrepFoundationClassRootsLinearLaws
{
    //==
    // # Join lists

    // A pseudo-random non-negative Integer from a seed and a position (a
    // multiplicative mix reduced modulo the prime 65537, so it stays well
    // inside 32 bits).
    JoinMix(seed: Integer, k: Integer): Integer
    {
        var a = ((seed + 17) * 7919 + k * 104729 + 13) % 65537;
        return ((a + 65537) % 65537 * 75 + 74) % 65537;
    }

    // Item k of a join list over n items drawn from seed: an item in -1 to n.
    JoinItem(seed: Integer, n: Integer, k: Integer): Integer
        => JoinMix(seed, k) % (n.Max(0) + 2) - 1;

    // The number of joins in the list over n items.
    JoinCount(n: Integer): Integer
        => 2 * n.Max(0) + 3;

    //==
    // # Agreement

    // ClassRootsLinear gives the same root to every item as ClassRoots, on a
    // pseudo-random join list over n items.
    Law_Perf_ClassRootsLinearAgrees(seed: Integer, n: Integer): Boolean
    {
        var first = JoinCount(n).MapRange(k => JoinItem(seed, n, 2 * k));
        var second = JoinCount(n).MapRange(k => JoinItem(seed, n, 2 * k + 1));
        var plain = ClassRoots(n.Max(0), first, second);
        var linear = ClassRootsLinear(n.Max(0), first, second);
        return plain.Count == linear.Count && plain.Count.Range.All(i => plain[i] == linear[i]);
    }
}

//==
// # Equivalence classes with path halving (complexity sweep, chunk F3)
//
// ClassRootsLinear: layer 0's ClassRoots with path halving in both find loops
// and a final pass that reads each root from the root of its parent. Joining
// still hangs the larger root under the smaller, and halving points an item at
// its grandparent, so every parent stays at or below its item (parent[k] <= k);
// the final pass in ascending order therefore finds roots[parent[j]] already
// filled. The roots are the same as ClassRoots': the smallest item of each
// class (Law_Perf_ClassRootsLinearAgrees). At merge ClassRoots takes this body.
//
// Sections, in order:
//  - Roots

library BrepFoundationClassRootsLinear
{
    //==
    // # Roots

    // The root of every item: the smallest item of its class under the
    // equivalence generated by joining first[k] with second[k] for every k.
    // A pair with an item outside 0 to n - 1 is ignored. Precondition:
    // first.Count == second.Count, n >= 0.
    ClassRootsLinear(n: Integer, first: Array<Integer>, second: Array<Integer>): Array<Integer>
    {
        var parent = new Buffer<Integer>(n);
        var i = 0;
        while (i < n)
        {
            parent = parent.Set(i, i);
            i = i + 1;
        }
        var k = 0;
        while (k < first.Count)
        {
            var x = first[k];
            var y = second[k];
            if (x >= 0 && x < n && y >= 0 && y < n)
            {
                while (parent.At(x) != x)
                {
                    parent = parent.Set(x, parent.At(parent.At(x)));
                    x = parent.At(x);
                }
                while (parent.At(y) != y)
                {
                    parent = parent.Set(y, parent.At(parent.At(y)));
                    y = parent.At(y);
                }
                if (x < y)
                {
                    parent = parent.Set(y, x);
                }
                else
                {
                    parent = parent.Set(x, y);
                }
            }
            k = k + 1;
        }
        var roots = new Buffer<Integer>(n);
        var j = 0;
        while (j < n)
        {
            if (parent.At(j) == j)
            {
                roots = roots.Set(j, j);
            }
            else
            {
                roots = roots.Set(j, roots.At(parent.At(j)));
            }
            j = j + 1;
        }
        return roots.Freeze();
    }
}

//==
// # Inverse evaluation along a run: laws (complexity sweep, chunk I3)
//
// The count witness for ProjectAlongCounted (Law_WorkIsWithinSlope, layer 00,
// reads it) and the laws that tie the seeded runs to the per-point global
// searches they replace, on the B-spline fixtures of
// bspline-witnesses.library.plato and on the witness models: on a run of
// surface or pcurve points the seeded answer recovers each point and names
// the global answer's parameters within the parameter tolerance, one global
// search serves the run, and on any run, on the surface or off it, no
// answer's point is farther than the global one's by more than the length
// tolerance.
//
// Sections, in order:
//  - Runs
//  - Count witness
//  - Counted forms
//  - Surfaces
//  - Pcurves
//  - Callers

library ProjectAlongLaws
{
    //==
    // # Runs

    // n surface points of surface fixture k (SurfaceIndex 0 of its arena),
    // at n uv points evenly along the straight line from a to b, both moved
    // into the domain.
    PerfSurfaceRun(k: Integer, a: UvCoordinate, b: UvCoordinate, n: Integer): Array<Point3D>
    {
        var g = k.SurfaceFixtureSet;
        var d = g.Domain(SurfaceIndex(0));
        var from = d.SampleIn(a);
        var to = d.SampleIn(b);
        return n.Fractions.Map(f => g.Eval(SurfaceIndex(0), UvCoordinate(from.U + (to.U - from.U) * f, from.V + (to.V - from.V) * f)));
    }

    // n points evenly along the segment from a to b.
    PerfSegmentRun(a: Point3D, b: Point3D, n: Integer): Array<Point3D>
        => n.Fractions.Map(f => a + (b - a) * f);

    // n points of pcurve fixture k (PcurveIndex 0 of its arena) at parameters
    // evenly from t0 to t1, both moved into the domain.
    PerfPcurveRun(k: Integer, t0: Number, t1: Number, n: Integer): Array<Point3D>
    {
        var g = k.PcurveFixtureSet;
        var d = g.Domain(PcurveIndex(0));
        var from = d.SampleIn(t0);
        var to = d.SampleIn(t1);
        return n.Fractions.Map(f => g.Eval(PcurveIndex(0), from + (to - from) * f));
    }

    // The edge image of the count witness: n points of the bump patch along
    // the curve u = 0.05 + 0.9 t, v = 0.2 + 0.6 t^2, t in [0, 1].
    PerfBumpEdgeRun(n: Integer): Array<Point3D>
        => n.Fractions.Map(t => 0.SurfaceFixtureSet.Eval(SurfaceIndex(0), UvCoordinate(0.05 + 0.9 * t, 0.2 + 0.6 * t * t)));

    //==
    // # Count witness

    // The work of projecting n points along one edge image on the bump patch.
    ProjectAlongWork(n: Integer): WorkBudget
        => 0.SurfaceFixtureSet.ProjectAlongCounted(SurfaceIndex(0), PerfBumpEdgeRun(n), Tolerances.Witness_Tolerances.Length).Work;

    // ProjectAlong on a B-spline surface: at most one global grid search
    // (Flips) and at most 40 seeded polish iterations (Evaluations) per point
    // along one edge image, at 16 and 64 points. Project per point made n grid
    // searches.
    Witness_ProjectAlongWork(_: WorkClaim): WorkClaim
        => WorkClaim("ProjectAlong: grid searches and seeded polish iterations per point", WorkBudgetOf(40, 0, 1, 0), [16, 64], n => ProjectAlongWork(n));

    // On the count witness's edge image the run makes exactly one grid
    // search, at both sizes: the claim's slope allows n, the run needs 1.
    Law_Perf_ProjectAlongSearchesOncePerEdge(_: Integer): Boolean
        => ProjectAlongWork(16).Flips == 1 && ProjectAlongWork(64).Flips == 1;

    //==
    // # Counted forms

    // The counted seeded search returns ProjectNearBySearchBody's answer,
    // bit for bit, from any seed toward any point, on every surface fixture.
    Law_Perf_ProjectNearCountedAgrees(k: Integer, p: Point3D, u: Number, v: Number): Boolean
    {
        var g = k.SurfaceFixtureSet;
        var surface = g.SurfaceAt(SurfaceIndex(0));
        var seed = g.Domain(SurfaceIndex(0)).SampleIn(UvCoordinate(u, v));
        var counted = surface.ProjectNearBySearchCounted(g, p, seed).Value;
        var plain = ProjectNearBySearchBody(surface, g, p, seed);
        return counted.U == plain.U && counted.V == plain.V;
    }

    //==
    // # Surfaces

    // On a run of 8 surface points between any two parameters of a surface
    // fixture, each answer gives its point back within the length tolerance,
    // the seeded answers at points 3 and 7 name Project's parameters within
    // the parameter tolerance there (two references, not eight: each Project
    // is a grid search, and eight per case passed the 2 s budget), and one
    // grid search serves the run.
    Law_Perf_ProjectAlongAgrees(k: Integer, u0: Number, v0: Number, u1: Number, v1: Number): Boolean
    {
        var g = k.SurfaceFixtureSet;
        var s = SurfaceIndex(0);
        var tol = Tolerances.Witness_Tolerances;
        var points = PerfSurfaceRun(k, UvCoordinate(u0, v0), UvCoordinate(u1, v1), 8);
        var along = g.ProjectAlongCounted(s, points, tol.Length);
        return along.Work.Flips == 1
            && points.Count.Range.All(i => g.Eval(s, along.Value[i]).Coincident(points[i], tol.Length))
            && [3, 7].All(i => g.Domain(s).SameParameter(along.Value[i], g.Project(s, points[i]), g.UvToleranceAt(s, along.Value[i], tol)));
    }

    // On a run of 4 points between any two points of space, on the surface
    // or off it, no answer's point is farther from its point than Project's
    // by more than the length tolerance.
    Law_Perf_ProjectAlongIsNearlyMinimal(k: Integer, a: Point3D, b: Point3D): Boolean
    {
        var g = k.SurfaceFixtureSet;
        var s = SurfaceIndex(0);
        var tol = Tolerances.Witness_Tolerances.Length;
        var points = PerfSegmentRun(a, b, 4);
        var along = g.ProjectAlong(s, points, tol);
        return points.Count.Range.All(i =>
            g.Eval(s, along[i]).Distance(points[i]) <= g.Eval(s, g.Project(s, points[i])).Distance(points[i]) + tol.Value);
    }

    //==
    // # Pcurves

    // On a run of 8 points of a pcurve fixture between any two of its
    // parameters, each answer gives its point back within the length
    // tolerance and is ClosestParameter's within the pcurve's parameter
    // floor, and one global search serves the run.
    Law_Perf_ClosestParametersAlongAgrees(k: Integer, t0: Number, t1: Number): Boolean
    {
        var g = k.PcurveFixtureSet;
        var p = PcurveIndex(0);
        var tol = Tolerances.Witness_Tolerances;
        var points = PerfPcurveRun(k, t0, t1, 8);
        var along = g.ClosestParametersAlongCounted(p, points, tol.Length);
        return along.Work.Flips == 1
            && points.Count.Range.All(i => g.Eval(p, along.Value[i]).Coincident(points[i], tol.Length)
                && g.PcurveSearchDomain(p).SameParameter(along.Value[i], g.ClosestParameter(p, points[i]), g.ParameterFloorOf(p, tol)));
    }

    // On a run of 6 points between any two points of space, no answer's
    // point is farther from its point than ClosestParameter's by more than
    // the length tolerance.
    Law_Perf_ClosestParametersAlongIsNearlyMinimal(k: Integer, a: Point3D, b: Point3D): Boolean
    {
        var g = k.PcurveFixtureSet;
        var p = PcurveIndex(0);
        var tol = Tolerances.Witness_Tolerances.Length;
        var points = PerfSegmentRun(a, b, 6);
        var along = g.ClosestParametersAlong(p, points, tol);
        return points.Count.Range.All(i =>
            g.Eval(p, along[i]).Distance(points[i]) <= g.Eval(p, g.ClosestParameter(p, points[i])).Distance(points[i]) + tol.Value);
    }

    //==
    // # Callers

    // On every witness model, every edge sampled at 12 parameters, and every
    // image of it: CanonicalImagePointsAlong names CanonicalImagePoints'
    // parameters within the parameter tolerance at each.
    Law_Perf_CanonicalImagePointsAlongAgrees(m: BrepModel): Boolean
        => m.IsEveryIndexInRange
            ? m.Edges.Count.Range.All(j => m.PerfImagesAgree(m.DiscretizationAt(BrepEdgeIndex(j), m.EdgeDomain(BrepEdgeIndex(j)).Range.Samples(12))))
            : true;

    // CanonicalImagePointsAlong agrees with CanonicalImagePoints on every
    // evaluable image of discretization d.
    PerfImagesAgree(m: BrepModel, d: EdgeDiscretization): Boolean
        => m.IsEvaluable(d)
            ? m.EdgeImages(d.Edge).All(img => m.IsImageEvaluable(img) ? m.PerfImageAgrees(d, img) : true)
            : true;

    // The two image point arrays have one count and agree point by point.
    PerfImageAgrees(m: BrepModel, d: EdgeDiscretization, img: EdgeImage): Boolean
    {
        var s = m.ImageSurface(img);
        var plain = m.CanonicalImagePoints(d, img);
        var along = m.CanonicalImagePointsAlong(d, img);
        return plain.Count == along.Count
            ? plain.Count.Range.All(i => m.Geometry.Domain(s).SameParameter(along[i], plain[i], m.Geometry.UvToleranceAt(s, plain[i], m.Tolerances)))
            : false;
    }

    // On every witness model, every bound of every face with only edge
    // loops: LiftedBoundAlong names LiftedBound's parameters within the
    // parameter tolerance at each point.
    Law_Perf_LiftedBoundAlongAgrees(m: BrepModel): Boolean
        => m.IsEveryIndexInRange
            ? m.Faces.Count.Range.All(j => m.HasOnlyEdgeLoops(BrepFaceIndex(j))
                ? m.Faces[BrepFaceIndex(j)].Bounds.All(b => m.PerfBoundAgrees(BrepFaceIndex(j), b))
                : true)
            : true;

    // The two lifted polygons of bound b have one count and agree point by point.
    PerfBoundAgrees(m: BrepModel, f: BrepFaceIndex, b: FaceBound): Boolean
    {
        var s = m.Faces[f].Surface;
        var plain = m.LiftedBound(f, b);
        var along = m.LiftedBoundAlong(f, b);
        return plain.Count == along.Count
            ? plain.Count.Range.All(i => m.Geometry.Domain(s).SameParameter(along[i], plain[i], m.Geometry.UvToleranceAt(s, plain[i], m.Tolerances)))
            : false;
    }
}

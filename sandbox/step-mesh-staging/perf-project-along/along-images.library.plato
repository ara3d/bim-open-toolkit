//==
// # Edge images and lifted bounds along a run (complexity sweep, chunk I3)
//
// The two callers that projected every sample of an edge on its own:
// layer 4's CanonicalImagePoints (an image's points, from the discretization)
// and layer 2's LiftedBound (a bound's lifted polygon). Each is its library
// body with the per-point Project or pcurve ClosestParameter replaced by
// ProjectAlong or ClosestParametersAlong (along-geometry.library.plato), so
// an edge pays one global search, not one per sample. At merge the library
// bodies take the one changed line and these copies go (TRACK.md).
//
// Sections, in order:
//  - Layer 4: image points
//  - Layer 2: lifted bounds

library EdgeImagesAlong
{
    //==
    // # Layer 4: image points

    // CanonicalImagePoints with the points projected along the run: with a
    // pcurve, the 2D curve at ClosestParametersAlong; without, ProjectAlong
    // onto the face's surface with poles filled; then unwrapped by
    // continuity, as before.
    CanonicalImagePointsAlong(m: BrepModel, d: EdgeDiscretization, img: EdgeImage): Array<UvCoordinate>
    {
        var s = m.ImageSurface(img);
        var raw = img.Pcurve.IsNone
            ? m.PolesFilled(s, m.Geometry.ProjectAlong(s, d.Points, m.Tolerances.Length))
            : m.Geometry.ClosestParametersAlong(img.Pcurve, d.Points, m.Tolerances.Length)
                .Map(t => m.Geometry.Eval(m.Geometry.Pcurves[img.Pcurve].Curve, t));
        return m.Geometry.Domain(s).UnwrappedByContinuity(raw);
    }

    //==
    // # Layer 2: lifted bounds

    // LiftedBound with the bound's samples projected along the run
    // (ProjectAlong); the rest as before.
    LiftedBoundAlong(m: BrepModel, f: BrepFaceIndex, b: FaceBound): Array<UvCoordinate>
    {
        var s = m.Faces[f].Surface;
        var d = m.Geometry.Domain(s);
        var coedges = m.LoopCoedges(b.Loop);
        var ordered = b.Orientation ? coedges : coedges.Count.MapRange(i => coedges[coedges.Count - 1 - i]);
        var raw = m.Geometry.ProjectAlong(s, ordered.FlatMap(c => m.CoedgeSamples(b, c)), m.Tolerances.Length);
        var n = raw.Count;
        var lifted = new List<UvCoordinate>();
        var i = 0;
        while (i <= n && n > 0)
        {
            var uv = raw[i % n];
            lifted = lifted.Add(i == 0 ? uv : d.NearestUnwrapped(uv, lifted.At(i - 1)));
            i = i + 1;
        }
        return lifted.Freeze();
    }
}

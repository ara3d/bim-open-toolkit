//==
// # Model mesh incidence, meshed witnesses: types (complexity sweep, chunk M2)
//
// Layer 08: a witness holds a model meshed by the pipeline.
//
// Sections, in order:
//  - Meshed witnesses

//==
// # Meshed witnesses

// A mesh of a model, built once per law sweep and shared by the laws that read it, until chunk
// L1's MeshedWitness (08-pipeline) merges; Name says which model.
type IncidenceMeshWitness
{
    Name: String;
    Mesh: ModelMesh;
}

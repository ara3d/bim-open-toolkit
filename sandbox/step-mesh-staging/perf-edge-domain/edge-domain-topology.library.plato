//==
// # Degenerate edges over a given edge domain (complexity sweep, chunk E2)
//
// Layer 2's IsDegenerateEdge asks EdgeDomain, two inverse evaluations (ClosestParameter) and,
// on a spline or an ellipse, a 256-sample search each, whenever the edge's ends are close. Layer
// 4 asks it up to three times per edge after it has the domain already. Here the range is a
// parameter; the answers are the plain forms', bit for bit, when the range given is
// m.EdgeDomain(e).Range.

library EdgeRangedTopology
{
    // Layer 2's FarthestEdgePointFrom with the edge domain given:
    // FarthestEdgePointFrom(m, e, p) is m.FarthestEdgePointFromGiven(e, p, m.EdgeDomain(e).Range).
    FarthestEdgePointFromGiven(m: BrepModel, e: BrepEdgeIndex, p: Point3D, range: NumberInterval): Number
        => m.Geometry.CurveAt(m.Edges[e].Curve).FarthestPointFrom(m.Geometry, range, p);

    // Layer 2's IsDegenerateEdge with the edge domain given: IsDegenerateEdge(m, e) is
    // m.IsDegenerateEdgeGiven(e, m.EdgeDomain(e).Range). Precondition: m.IsEdgeIntact(e).
    IsDegenerateEdgeGiven(m: BrepModel, e: BrepEdgeIndex, range: NumberInterval): Boolean
    {
        var start = m.Vertices[m.Edges[e].Start].Point;
        var apart = start.Distance(m.Vertices[m.Edges[e].End].Point) > 2.0 * m.Tolerances.Length.Value;
        return apart ? false : m.FarthestEdgePointFromGiven(e, start, range) <= m.Tolerances.Length.Value;
    }
}

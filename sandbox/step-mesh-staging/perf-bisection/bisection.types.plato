//==
// # The bisection with its ends carried down: types (complexity sweep, chunk R5)
//
// Sections, in order:
//  - Ends of a span

//==
// # Ends of a span

// Where one point of an edge lies in one of the edge's images, as the image test of a piece
// that starts at the point reads it: the parameter-space point of the first point of a run
// (layer 1's Project on the image's surface, or ClosestParameter on its pcurve mapped through the
// pcurve's 2D curve) and, for a pcurve, that pcurve parameter, which seeds the search for the
// piece's other end. Parameter is 0 on an image without a pcurve, whose seed is Uv; Uv is the
// origin on an image that is not evaluable, which the test skips.
// Removes: the two inverse maps per image that every bisection test made for its two ends.
type ImageAnchor
    implements IValue
{
    Uv: UvCoordinate;
    Parameter: Number;
}

// One end of a span the bisection tests: its curve parameter, the curve's point there
// (PointOnEdge), and its anchor in each image the test reads, in the images' order.
// Removes: the five to nine evaluations of each final parameter, and its two projections per
// image, that the bisection made by recomputing a piece's ends at every level.
type BisectionEnd
{
    Parameter: Number;
    Point: Point3D;
    Anchors: Array<ImageAnchor>;
}

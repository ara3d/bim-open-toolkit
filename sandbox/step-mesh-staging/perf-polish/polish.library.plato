//==
// # Cached polish (complexity sweep, chunk I4, TKT-381)
//
// Ranked candidate 25 of docs/plans/step-mesher-complexity.md. Each
// iteration of PolishProjectionCounted (bspline-along.library.plato)
// evaluates the surface at its current uv about 8 times (Eval twice for the
// distance and its slack, Eval, PartialU and PartialV in GaussNewtonStep,
// the same three again in ProjectedStep and on every halving) and at the
// accepted point three times after the halving loop: 11 + 4h calls for h
// halvings. Here one first jet per iteration serves the distance, the slack,
// the Gauss-Newton step and every projected step, and the point reached is
// evaluated once per trial: 2 + h calls. On a B-spline surface each
// PartialU or PartialV is two homogeneous partials (the point's and the
// partial's), each with its own span search and local net; the B-spline
// first jet finds the spans once, weights the (p_u + 1)(p_v + 1) local
// controls once, and shares the order-0 columns between the point and S_u.
// The arithmetic is the old path's value for value, so every result is
// bit-identical (the agreement laws compare with ==).
//
// Sections, in order:
//  - B-spline first jets
//  - First jets of any surface
//  - Steps from a jet
//  - Polish

library BsplinePolishCached
{
    //==
    // # B-spline first jets

    // The (p_u + 1) local columns of homogeneous control values (w P, w) of
    // span (ku, kv): column i holds P_(ku - p_u + i, kv - p_v + j) for j =
    // 0 .. p_v, a curve in v, as in HomogeneousPartial.
    LocalNet(d: BSplineSurfaceData, ku: Integer, kv: Integer): Array<Array<HomogeneousPoint3D>>
        => (d.U.Degree + 1).MapRange(i => (d.V.Degree + 1).MapRange(j =>
            d.ControlPoints.At(ku - d.U.Degree + i, kv - d.V.Degree + j).Weighted(d.Weights.At(ku - d.U.Degree + i, kv - d.V.Degree + j))));

    // The point and first partials at uv from the local net of span (ku,
    // kv): the columns at v serve the homogeneous point and its u-partial,
    // their v-derivatives the v-partial, then the quotient rule as in
    // RationalPartial.
    FirstJetFromNet(d: BSplineSurfaceData, net: Array<Array<HomogeneousPoint3D>>, ku: Integer, kv: Integer, uv: UvCoordinate): SurfaceFirstJet
    {
        var at = net.Map(c => LocalDerivative(c, d.V.Knots, 0, d.V.Degree, kv, 0, uv.V));
        var across = net.Map(c => LocalDerivative(c, d.V.Knots, 0, d.V.Degree, kv, 1, uv.V));
        var h = LocalDerivative(at, d.U.Knots, 0, d.U.Degree, ku, 0, uv.U);
        var hu = LocalDerivative(at, d.U.Knots, 0, d.U.Degree, ku, 1, uv.U);
        var hv = LocalDerivative(across, d.U.Knots, 0, d.U.Degree, ku, 0, uv.U);
        var s = h.Spatial * (1.0 / h.W);
        return SurfaceFirstJet(s.ToPoint, (hu.Spatial - s * hu.W) * (1.0 / h.W), (hv.Spatial - s * hv.W) * (1.0 / h.W));
    }

    // A B-spline surface's point and first partials at uv: BSplinePoint,
    // BSplinePartial(1, 0) and BSplinePartial(0, 1) from one span lookup per
    // direction and one local net.
    BSplineSurfaceFirstJet(d: BSplineSurfaceData, uv: UvCoordinate): SurfaceFirstJet
    {
        var ku = d.U.SplineSpan(d.ControlPoints.ColumnCount, uv.U);
        var kv = d.V.SplineSpan(d.ControlPoints.RowCount, uv.V);
        return d.FirstJetFromNet(d.LocalNet(ku, kv), ku, kv, uv);
    }

    // BSplineSurfaceFirstJet with the control points it read, as Insertions:
    // (p_u + 1)(p_v + 1) for every surface, whatever the size of its net.
    BSplineSurfaceFirstJetCounted(d: BSplineSurfaceData, uv: UvCoordinate): Counted<SurfaceFirstJet>
    {
        var ku = d.U.SplineSpan(d.ControlPoints.ColumnCount, uv.U);
        var kv = d.V.SplineSpan(d.ControlPoints.RowCount, uv.V);
        var net = d.LocalNet(ku, kv);
        return Counted(d.FirstJetFromNet(net, ku, kv, uv), Insertions(net.Reduce(0, (n, c) => n + c.Count)));
    }

    // S_u x S_v of the jet: its length is the area element, its direction
    // the parameterization normal.
    PartialsCross(j: SurfaceFirstJet): Vector3D
        => j.DerivativeU.Cross(j.DerivativeV);

    //==
    // # First jets of any surface

    // The surface's point and first partials at uv: Eval, PartialU and
    // PartialV, from one B-spline evaluation on a B-spline surface or a
    // rectangular trimmed one (whose basis point is found once and whose
    // partials take its senses), else the three calls.
    FirstJet(surface: BrepSurface, g: GeometrySet, uv: UvCoordinate): SurfaceFirstJet
        => match (surface)
        {
            Plane(placement) => surface.FirstJetByParts(g, uv);
            Cylinder(placement, radius) => surface.FirstJetByParts(g, uv);
            Cone(placement, radius, semiAngle) => surface.FirstJetByParts(g, uv);
            Sphere(placement, radius) => surface.FirstJetByParts(g, uv);
            Torus(placement, major, minor, part) => surface.FirstJetByParts(g, uv);
            Revolution(profile, axis) => surface.FirstJetByParts(g, uv);
            LinearExtrusion(profile, extrusion) => surface.FirstJetByParts(g, uv);
            BSpline(data) => data.BSplineSurfaceFirstJet(uv);
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => g.SurfaceAt(basis)
                .FirstJet(g, g.TrimmedToBasis(basis, uRange, vRange, uSense, vSense, uv)).Sensed(uSense, vSense);
            Offset(basis, distance) => surface.FirstJetByParts(g, uv);
        };

    // The jet from Eval, PartialU and PartialV.
    FirstJetByParts(surface: BrepSurface, g: GeometrySet, uv: UvCoordinate): SurfaceFirstJet
        => SurfaceFirstJet(surface.Eval(g, uv), surface.PartialU(g, uv), surface.PartialV(g, uv));

    // The jet with each partial negated where its direction is reversed.
    Sensed(j: SurfaceFirstJet, uSense: Boolean, vSense: Boolean): SurfaceFirstJet
        => SurfaceFirstJet(j.Position, j.DerivativeU * uSense.SenseSign, j.DerivativeV * vSense.SenseSign);

    //==
    // # Steps from a jet

    // GaussNewtonStep from the jet at uv: the solution of [a b; b c] (du,
    // dv) = -(F_u, F_v) with F = (S - p) . S_x, or where the first
    // fundamental form is singular the coordinate whose partial is not zero
    // moved alone.
    GaussNewtonStepAt(j: SurfaceFirstJet, p: Point3D): Vector2D
    {
        var r = j.Position - p;
        var su = j.DerivativeU;
        var sv = j.DerivativeV;
        var a = su.Dot(su);
        var b = su.Dot(sv);
        var c = sv.Dot(sv);
        var fu = r.Dot(su);
        var fv = r.Dot(sv);
        var det = a * c - b * b;
        return det > ResolutionAt(a * c).Value
            ? Vector2D((b * fv - c * fu) / det, (b * fu - a * fv) / det)
            : Vector2D(a > 0.0 ? -fu / a : 0.0, c > 0.0 ? -fv / c : 0.0);
    }

    // ProjectedStep from the jet at uv: the point the step reaches, clamped
    // into w; when one coordinate stops on a side, the other re-solved alone
    // along it.
    ProjectedStepAt(j: SurfaceFirstJet, p: Point3D, uv: UvCoordinate, step: Vector2D, w: SurfaceWindow): UvCoordinate
    {
        var target = UvCoordinate(uv.U + step.X, uv.V + step.Y).ClampInto(w);
        var r = j.Position - p;
        var su = j.DerivativeU;
        var sv = j.DerivativeV;
        var pinnedU = target.U != uv.U + step.X;
        var pinnedV = target.V != uv.V + step.Y;
        return pinnedU && !pinnedV && sv.Dot(sv) > 0.0
            ? UvCoordinate(target.U, uv.V - r.Dot(sv) / sv.Dot(sv)).ClampInto(w)
            : (pinnedV && !pinnedU && su.Dot(su) > 0.0
                ? UvCoordinate(uv.U - r.Dot(su) / su.Dot(su), target.V).ClampInto(w)
                : target);
    }

    //==
    // # Polish

    // PolishProjectionCounted's loop, at most `limit` iterations, with one
    // first jet per iteration and one point evaluation per trial step: the
    // same steps, the same halvings, the same answer.
    PolishRunCached(surface: BrepSurface, g: GeometrySet, p: Point3D, start: UvCoordinate, w: SurfaceWindow, radius: Vector2D, limit: Integer): PolishRun
    {
        var uv = start.ClampInto(w);
        var n = 0;
        var halved = 0;
        var evaluations = 0;
        var moving = true;
        while (moving && n < limit)
        {
            var j = surface.FirstJet(g, uv);
            var here = j.Position.Distance(p);
            var slack = ResolutionAt(j.Position.PositionVector.Length + p.PositionVector.Length).Value;
            var step = j.GaussNewtonStepAt(p).Limited(radius);
            var next = j.ProjectedStepAt(p, uv, step, w);
            var reached = surface.Eval(g, next).Distance(p);
            evaluations = evaluations + 2;
            var halvings = 0;
            while (halvings < 12 && reached > here + slack)
            {
                step = step * 0.5;
                next = j.ProjectedStepAt(p, uv, step, w);
                reached = surface.Eval(g, next).Distance(p);
                evaluations = evaluations + 1;
                halvings = halvings + 1;
            }
            moving = reached <= here + slack
                && ((next.U - uv.U).Abs > ResolutionAt(uv.U.Abs + w.U.End.Abs.Min(w.U.Start.Abs)).Value
                    || (next.V - uv.V).Abs > ResolutionAt(uv.V.Abs + w.V.End.Abs.Min(w.V.Start.Abs)).Value);
            uv = reached <= here + slack ? next : uv;
            halved = halved + halvings;
            n = n + 1;
        }
        return PolishRun(uv, n, halved, evaluations);
    }

    // PolishProjection with one first jet per iteration.
    PolishProjectionCached(surface: BrepSurface, g: GeometrySet, p: Point3D, start: UvCoordinate, w: SurfaceWindow, radius: Vector2D): UvCoordinate
        => surface.PolishRunCached(g, p, start, w, radius, Integer.PolishIterations).Uv;

    // PolishProjectionCached, at most `limit` iterations, with its surface
    // evaluations (first jets and points) counted as Evaluations: 2 + h per
    // iteration with h halvings.
    PolishProjectionCachedCounted(surface: BrepSurface, g: GeometrySet, p: Point3D, start: UvCoordinate, w: SurfaceWindow, radius: Vector2D, limit: Integer): Counted<UvCoordinate>
    {
        var run = surface.PolishRunCached(g, p, start, w, radius, limit);
        return Counted(run.Uv, Evaluations(run.Evaluations));
    }
}

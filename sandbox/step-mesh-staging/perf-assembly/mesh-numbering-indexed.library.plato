//==
// # Mesh vertex numbering in linear time (complexity sweep, chunk M1)
//
// Replacements for two quadratic passes of 06-mesh/mesh-numbering.library.plato
// (docs/plans/step-mesher-complexity.md, candidates 8 and 9):
//  - NumberMeshVertices asks CitesEdge once per model edge, and CitesEdge scans every source of
//    every face mesh: O(E S). CitedEdges marks the cited edges in one pass over the sources, so
//    NumberMeshVerticesMarked is O(E + S).
//  - GlobalVertexOf reaches FaceInteriorRank, which counts the OnFace provenances before a local
//    vertex on every call: O(L) per point. FaceInteriorRanks computes every rank in one prefix
//    pass, and GlobalVerticesOf maps every parameter-space point of a face mesh at once: O(P + L).
// Each result is the original's exactly: the same flags, ranks, sites and indices.
//
// Sections, in order:
//  - Cited edges
//  - The numbering
//  - Face-interior ranks and global vertices

library ModelMeshNumberingIndexed
{
    //==
    // # Cited edges

    // The edge whose discretization a source cites, as an index; -1 when the source cites no edge.
    EdgeCited(s: UvPointSource): Integer
        => match (s) {
               FromVertex(v) => -1;
               FromEdge(edge, k) => edge.Value;
               SeamCut(side, k) => -1;
               Pole(side, k) => -1;
               Interior => -1;
           };

    // One flag per model edge 0 to edgeCount - 1: whether some face mesh has a parameter-space
    // point on that edge's discretization (CitesEdge for every edge at once). A source citing an
    // edge outside that range is ignored.
    CitedEdges(faceMeshes: Array<FaceMesh>, edgeCount: Integer): Array<Boolean>
        => CitedEdgesCounted(faceMeshes, edgeCount).Value;

    // CitedEdges with its work: one Insertion per flag initialized and one per source visited.
    CitedEdgesCounted(faceMeshes: Array<FaceMesh>, edgeCount: Integer): Counted<Array<Boolean>>
    {
        var count = edgeCount.Max(0);
        var cited = new Buffer<Boolean>(count);
        var k = 0;
        while (k < count)
        {
            cited = cited.Set(k, false);
            k = k + 1;
        }
        var visits = 0;
        var f = 0;
        while (f < faceMeshes.Count)
        {
            var sources = faceMeshes[f].Sources;
            var i = 0;
            while (i < sources.Count)
            {
                var e = sources[i].EdgeCited;
                if (e >= 0 && e < count)
                {
                    cited = cited.Set(e, true);
                }
                visits = visits + 1;
                i = i + 1;
            }
            f = f + 1;
        }
        return Counted(cited.Freeze(), Insertions(count + visits));
    }

    //==
    // # The numbering

    // NumberMeshVertices with the cited edges marked in one pass: the same numbering.
    NumberMeshVerticesMarked(m: BrepModel, d: EdgeDiscretizations, faceMeshes: Array<FaceMesh>): MeshVertexNumbering
        => NumberMeshVerticesCounted(m, d, faceMeshes).Value;

    // NumberMeshVerticesMarked with its work, counted as Insertions: the cited-edge flags (one per
    // model edge, one per source visited, CitedEdgesCounted) and the provenance entries read to
    // count each face's interior vertices. At most E + S + L, and L <= S for a face mesh whose
    // points all map to a local vertex, so within 2 (E + S).
    NumberMeshVerticesCounted(m: BrepModel, d: EdgeDiscretizations, faceMeshes: Array<FaceMesh>): Counted<MeshVertexNumbering>
    {
        var cited = CitedEdgesCounted(faceMeshes, m.Edges.Count);
        var flags = cited.Value;
        var edgeCounts = m.Edges.Count.MapRange(k => flags[k] ? d.InteriorPointCount(BrepEdgeIndex(k)) : 0);
        var faceCounts = m.Faces.Count.MapRange(k => faceMeshes.IsValidIndex(k)
            ? faceMeshes[k].FaceInteriorVertexCount
            : 0);
        var provenanceRead = m.Faces.Count.MapRange(k => faceMeshes.IsValidIndex(k)
            ? faceMeshes[k].Provenance.Count
            : 0).IntegerTotal;
        var edgeStarts = RunStarts(m.Vertices.Count, edgeCounts);
        return Counted(
            MeshVertexNumbering(m.Vertices.Count, edgeStarts, RunStarts(edgeStarts.Last, faceCounts)),
            cited.Work.Add(Insertions(provenanceRead)));
    }

    //==
    // # Face-interior ranks and global vertices

    // Entry k, for k in 0 to fm.Provenance.Count, is FaceInteriorRank(fm, VertexIndex(k)): the
    // number of local vertices before k with provenance OnFace. The last entry is the total.
    FaceInteriorRanks(fm: FaceMesh): Array<Integer>
    {
        var ranks = new List<Integer>();
        var seen = 0;
        var k = 0;
        while (k < fm.Provenance.Count)
        {
            ranks = ranks.Add(seen);
            if (fm.Provenance[k].IsInFaceInterior)
            {
                seen = seen + 1;
            }
            k = k + 1;
        }
        ranks = ranks.Add(seen);
        return ranks.Freeze();
    }

    // FaceInteriorRank(fm, lv) read from fm.FaceInteriorRanks: lv clamped to 0 to
    // fm.Provenance.Count, as FaceInteriorRank clamps it.
    RankAt(fm: FaceMesh, ranks: Array<Integer>, lv: VertexIndex): Integer
        => ranks[lv.Value.Max(0).Min(fm.Provenance.Count)];

    // InteriorSiteOf(fm, i) with the ranks given.
    InteriorSiteRanked(fm: FaceMesh, ranks: Array<Integer>, i: VertexIndex): MeshVertexSite
        => MeshVertexSite.FaceInterior(fm.Face,
            InteriorSlot(fm.LocalVertex.IsValidIndex(i) ? fm.RankAt(ranks, fm.LocalVertex[i]) : -1));

    // SiteOfSource(fm, i, s) with the ranks given.
    SiteOfSourceRanked(fm: FaceMesh, ranks: Array<Integer>, i: VertexIndex, s: UvPointSource): MeshVertexSite
        => match (s) {
               FromVertex(v) => MeshVertexSite.ModelVertex(v);
               FromEdge(e, k) => MeshVertexSite.EdgeInterior(e, InteriorSlot(k.Value - 1));
               SeamCut(side, k) => fm.InteriorSiteRanked(ranks, i);
               Pole(side, k) => fm.InteriorSiteRanked(ranks, i);
               Interior => fm.InteriorSiteRanked(ranks, i);
           };

    // Entry i is GlobalVertexOf(n, fm, VertexIndex(i)) for every parameter-space point i of the face
    // mesh, computed with one rank pass: O(P + L) instead of O(P L).
    GlobalVerticesOf(n: MeshVertexNumbering, fm: FaceMesh): Array<VertexIndex>
    {
        var ranks = fm.FaceInteriorRanks;
        return fm.Sources.Count.MapRange(i =>
            n.IndexOfSite(fm.SiteOfSourceRanked(ranks, VertexIndex(i), fm.Sources[i])));
    }

    // Entry i of a GlobalVerticesOf array, or -1 (none) when i names no parameter-space point, as
    // GlobalVertexOf gives for such an i.
    GlobalAt(globals: Array<VertexIndex>, i: VertexIndex): VertexIndex
        => globals.IsValidIndex(i) ? globals[i] : VertexIndex(-1);
}

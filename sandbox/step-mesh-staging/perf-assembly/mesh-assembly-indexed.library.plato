//==
// # Assembling the model mesh with each face's global vertices computed once (chunk M1)
//
// AssembleModelMeshIndexed is AssembleModelMesh (06-mesh/mesh-assembly.library.plato) with
// GlobalVertexOf replaced by one GlobalVerticesOf array per face mesh, read for the positions
// and for every element corner. AssembleModelMesh calls GlobalVertexOf once per point and once
// per corner, and each call counts face-interior provenances from the start (FaceInteriorRank),
// so a face with I interior points costs O(I (P + 3T)); here a face costs O(P + L + T + Q).
// The mesh is the original's exactly: the same writes in the same order.
//
// Sections, in order:
//  - Assembly

library ModelMeshAssemblyIndexed
{
    //==
    // # Assembly

    // The triangles of a face mesh, corners sent through its global vertices.
    AssembledTriangles(fm: FaceMesh, globals: Array<VertexIndex>): Array<TriangleFace>
        => fm.Triangles.Map(t => TriangleFace(globals.GlobalAt(t.A), globals.GlobalAt(t.B), globals.GlobalAt(t.C)));

    // The quads of a face mesh, corners sent through its global vertices.
    AssembledQuads(fm: FaceMesh, globals: Array<VertexIndex>): Array<QuadFace>
        => fm.Quads.Map(q => QuadFace(globals.GlobalAt(q.A), globals.GlobalAt(q.B), globals.GlobalAt(q.C), globals.GlobalAt(q.D)));

    // AssembleModelMesh with GlobalVerticesOf computed once per face mesh.
    AssembleModelMeshIndexed(m: BrepModel, faceMeshes: Array<FaceMesh>, numbering: MeshVertexNumbering): ModelMesh
    {
        var globals = faceMeshes.Map(x => numbering.GlobalVerticesOf(x));
        var count = numbering.NumberedVertexCount;
        var positions = new Buffer<Point3D>(count);
        var provenance = new Buffer<MeshVertexProvenance>(count);
        var written = new Buffer<Boolean>(count);
        var i = 0;
        while (i < count)
        {
            var isModel = i < m.Vertices.Count;
            positions = positions.Set(i, isModel ? m.Vertices[i].Point : Point3D(0.0, 0.0, 0.0));
            provenance = provenance.Set(i, MeshVertexProvenance.OnVertex(BrepVertexIndex(isModel ? i : -1)));
            written = written.Set(i, isModel);
            i = i + 1;
        }
        var f = 0;
        while (f < faceMeshes.Count)
        {
            var fm = faceMeshes[f];
            var g = globals[f];
            var p = 0;
            while (p < fm.Sources.Count)
            {
                var v = g[p].Value;
                if (v >= 0 && v < count)
                {
                    if (written.At(v).Not)
                    {
                        positions = positions.Set(v, fm.Positions[fm.LocalVertex[p]]);
                        provenance = provenance.Set(v, fm.Provenance[fm.LocalVertex[p]]);
                        written = written.Set(v, true);
                    }
                }
                p = p + 1;
            }
            f = f + 1;
        }
        return ModelMesh(
            positions.Freeze(),
            faceMeshes.Count.Range.FlatMap(k => faceMeshes[k].AssembledTriangles(globals[k])),
            faceMeshes.Count.Range.FlatMap(k => faceMeshes[k].AssembledQuads(globals[k])),
            faceMeshes.FlatMap(x => x.Triangles.FlatMap(t => t.Vertices.Map(v => x.Normals[v])))
                .Concatenate(faceMeshes.FlatMap(x => x.Quads.FlatMap(q => q.Vertices.Map(v => x.Normals[v])))),
            faceMeshes.FlatMap(x => x.Triangles.FlatMap(t => t.Vertices.Map(v => x.UvPoints[v])))
                .Concatenate(faceMeshes.FlatMap(x => x.Quads.FlatMap(q => q.Vertices.Map(v => x.UvPoints[v])))),
            faceMeshes.FlatMap(x => x.Triangles.Map(t => x.Face)).Concatenate(faceMeshes.FlatMap(x => x.Quads.Map(q => x.Face))),
            provenance.Freeze(),
            numbering);
    }
}

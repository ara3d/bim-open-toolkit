//==
// # Shell tables: types (complexity sweep, chunk V4)
//
// Sections, in order:
//  - Grouped coedge sites
//  - Edge uses and corners

//==
// # Grouped coedge sites

// Coedge sites grouped by an integer key, in compressed rows: row k is Sites[Offsets[k]] up to
// Sites[Offsets[k + 1]], the sites whose key is k in the order they were given. Offsets has one
// entry per row plus one, starts at 0 and ends at Sites.Count. The stdlib's
// JaggedArray<CoedgeSite> holds the same data, but the C# writer emits no member for a library
// function whose first parameter is an instance of a generic type, so the row accessors need a
// concrete receiver.
type CoedgeSiteRows
    implements IValue
{
    Offsets: Array<Integer>;
    Sites: Array<CoedgeSite>;
}

//==
// # Edge uses and corners

// The uses of every edge of a BrepModel in one shell: row e is layer 2's CoedgeSitesOfEdge(m, s, e),
// the shell's coedge sites citing edge e in shell order, for every edge e in range. One row per
// model edge; a coedge naming an edge out of range is in no row. Removes: UseCount's rebuild of
// the shell's coedge sites per edge, which made EdgesOfShell and its callers O(E C) per shell.
type EdgeUseTable
    implements IValue
{
    Uses: CoedgeSiteRows;
}

// The corners at every vertex of a BrepModel in one shell: row v is layer 2's
// CornersAtVertex(m, s, v), the shell's coedge sites whose coedge ends at v, in shell order, for
// every vertex v in range. One row per model vertex; a coedge whose edge is out of range, or
// whose end vertex is, is in no row. Removes: the scan of every coedge of the shell per vertex.
type VertexCornerTable
    implements IValue
{
    Corners: CoedgeSiteRows;
}

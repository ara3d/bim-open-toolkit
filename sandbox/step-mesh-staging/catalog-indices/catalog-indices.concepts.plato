//==
// # Catalog indices: concepts
//
// TYPE-CATALOG.md section 15, IIndexedTable. No kernel table implements it: the tables are
// Array<T> fields of BrepModel and GeometrySet, Array<T> cannot gain an implements clause, and
// BrepModel cannot implement it once per table because RowCountOf(x: Self) would then have six
// meanings. The one law over ten tables is stated over TableName instead
// (Law_Catalog_RowInRangeAgreesWithTable).
//
// Sections, in order:
//  - Indexed tables

//==
// # Indexed tables

// A table of TRow rows addressed by a TIndex typed index: its row count, the row at an index, and
// whether an index names a row. The obligations are not named Count and At, which the stdlib's
// ICountable and IIndexable already own. Removes: a range check written per table.
interface IIndexedTable<TIndex, TRow>
{
    RowCountOf(x: Self): Integer;
    RowAt(x: Self, i: TIndex): TRow;
    IsRowIndex(x: Self, i: TIndex): Boolean;
}

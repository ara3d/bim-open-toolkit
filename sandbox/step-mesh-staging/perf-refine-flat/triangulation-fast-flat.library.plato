//==
// # Refinement without quadratic empties or repeated angle tests (TKT-363, chunk F4)
//
// Layer 05-face-meshing, staged replacements for triangulation-fast.library.plato. BelowAngle and
// SurfacePassLocal filtered with `t.Triangles.Count.Range.FlatMap(k => keep ? [k] :
// t.Triangles.Count.Range.Take(0))`: the empty branch builds a T-element range per triangle, so a
// filter over T triangles allocated O(T^2) integers, in every one of up to forty passes. The
// filters here allocate O(T): a List builder, or the typed empty `[k].Take(0)`.
//
// The angle test also lifted every triangle (three surface evaluations) in every pass. A
// triangle's smallest lifted angle depends only on its corners, and points are only appended, so
// a triangle tested at or above RefinementMinAngle stays so while it is unchanged at its index.
// RefineToSurfaceByInsertionKnown carries that mark through both passes with CarriedMarks, as
// RefineToSurfaceByInsertion carries `known` for the surface test, so each pass lifts only the
// triangles that changed. The angle test's result is the same list in the same order, so every
// insertion is the same.
//
// Sections, in order:
//  - The surface pass
//  - The angle test
//  - Refinement

library TriangulationFastFlat
{
    //==
    // # The surface pass

    // SurfacePassLocal with the failing triangles filtered into a typed empty: O(T) allocation.
    SurfacePassLocalFlat(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, t: UvTriangulation, surface: Array<Boolean>, c: FaceMeshingCriteria): UvTriangulation
    {
        var failing = t.Triangles.Count.Range.FlatMap(k => surface[k] ? [k] : [k].Take(0));
        var least = c.Discretization.EffectiveMinLength(m.Tolerances);
        var pts = t.Points;
        var points = pts.Map(x => chart.ChartPoint(x));
        var tris = t.Triangles;
        var nb = NeighbourSlots(tris, pts.Count);
        var i = 0;
        while (i < failing.Count)
        {
            var k = failing[i];
            if (tris[k] == t.Triangles[k])
            {
                var centre = chart.Circumcentre(points, tris[k]);
                var first = m.TryInsertion(f, r, chart, pts, points, tris, nb, k, centre, least, false);
                var uv = first.Count > tris.Count ? centre : r.SurfaceFallback(pts, points, tris, nb, k);
                var next = first.Count > tris.Count ? first : m.TryInsertion(f, r, chart, pts, points, tris, nb, k, uv, least, false);
                if (next.Count > tris.Count)
                {
                    nb = UpdatedNeighbours(tris, nb, next, pts.Count, points.WalkTo(tris, nb, k, chart.ChartPoint(uv)));
                    tris = next;
                    pts = pts.Concatenate([uv]);
                    points = points.Concatenate([chart.ChartPoint(uv)]);
                }
            }
            i = i + 1;
        }
        return UvTriangulation(pts, t.Sources.Concatenate((pts.Count - t.Points.Count).MapRange(j => UvPointSource.Interior)), tris, t.Quads);
    }

    //==
    // # The angle test

    // BelowAngleKnown with its work: Evaluations counts the surface evaluations of the triangles
    // it lifts (three each), Insertions the indices it adds to the result. A triangle is lifted
    // unless refused[k] or good[k] marks it (a missing mark is false).
    BelowAngleCounted(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, refused: Array<Boolean>, good: Array<Boolean>): Counted<Array<Integer>>
    {
        var limit = RefinementMinAngle(0);
        var bad = new List<Integer>();
        var lifted = 0;
        var k = 0;
        while (k < t.Triangles.Count)
        {
            var skip = (k < refused.Count ? refused[k] : false) || (k < good.Count ? good[k] : false);
            if (skip.Not)
            {
                lifted = lifted + 1;
                if (m.SmallestCornerAngle(f, t, t.Triangles[k]) < limit)
                {
                    bad = bad.Add(k);
                }
            }
            k = k + 1;
        }
        var value = bad.Freeze();
        return Counted(value, Evaluations(3 * lifted).Add(Insertions(value.Count)));
    }

    // The indices, in order, of the triangles of t below RefinementMinAngle that neither
    // refused[k] nor good[k] (known to be at or above it) marks.
    BelowAngleKnown(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, refused: Array<Boolean>, good: Array<Boolean>): Array<Integer>
        => m.BelowAngleCounted(f, t, refused, good).Value;

    // BelowAngle without its quadratic empties: no triangle is known good.
    BelowAngleFlat(m: BrepModel, f: BrepFaceIndex, t: UvTriangulation, refused: Array<Boolean>): Array<Integer>
        => m.BelowAngleKnown(f, t, refused, [false].Take(0));

    // A mark per triangle of t: true where the angle test that gave `bad` (with `refused`
    // marking the triangles it skipped) found the triangle at or above RefinementMinAngle, or it
    // was skipped as known good.
    AngleGoodMarks(t: UvTriangulation, refused: Array<Boolean>, bad: Array<Integer>): Array<Boolean>
        => t.Triangles.CarriedMarks(refused, bad, t.Triangles).Map(x => x.Not);

    //==
    // # Refinement

    // RefineToSurfaceByInsertion with SurfacePassLocalFlat, and an angle-good mark per triangle
    // carried like `known`: BelowAngleKnown lifts only the triangles that are neither refused nor
    // known to meet the angle. Same insertions in the same order as RefineToSurfaceByInsertion.
    RefineToSurfaceByInsertionKnown(m: BrepModel, f: BrepFaceIndex, r: UvRegion, chart: FaceChart, t: UvTriangulation, c: FaceMeshingCriteria): UvTriangulation
    {
        var planar = m.Geometry.SurfaceAt(m.SurfaceOf(f)).IsPlanarRecord;
        var none = [0].Take(0);
        var current = t;
        var known = t.Triangles.Map(x => false);
        var refused = t.Triangles.Map(x => false);
        var good = t.Triangles.Map(x => false);
        var pass = 0;
        var changed = true;
        while (pass < 40 && changed)
        {
            var surface = planar ? current.Triangles.Map(x => false) : m.NeedsRefinement(f, r, current, known, c);
            var mid = m.SurfacePassLocalFlat(f, r, chart, current, surface, c);
            var carried = current.Triangles.CarriedMarks(refused, none, mid.Triangles);
            var goodMid = current.Triangles.CarriedMarks(good, none, mid.Triangles);
            var bad = m.BelowAngleKnown(f, mid, carried, goodMid);
            var next = m.AnglePassLocal(f, r, chart, mid, bad, c);
            refused = mid.Triangles.CarriedMarks(carried, bad, next.Triangles);
            good = mid.Triangles.CarriedMarks(mid.AngleGoodMarks(carried, bad), none, next.Triangles);
            known = KnownGood(current, surface, next);
            changed = next.Points.Count > current.Points.Count;
            current = next;
            pass = pass + 1;
        }
        return current;
    }
}

//==
// # Typed empties in the region and seed filters (TKT-363, chunk F4)
//
// Layer 05-face-meshing, staged replacements for three filters that wrote their empty branch as
// `n.Range.Take(0)`: a range of n integers allocated per element, so O(n^2) for a filter over n.
// Each replacement writes `[k].Take(0)` instead and is otherwise the original, line for line:
// WindingLoops (uv-regions.library.plato), EnclosedPoleLine (pole-segments.library.plato) and
// TriangulateRegionCdt (triangulation-cdt.library.plato).
//
// Sections, in order:
//  - Regions
//  - The seed triangulation

library FaceMeshingFlat
{
    //==
    // # Regions

    // WindingLoops with a typed empty.
    WindingLoopsFlat(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>): Array<Integer>
        => loops.Count.Range.FlatMap(k => m.IsWindingLoop(f, loops[k]) ? [k] : [k].Take(0));

    // EnclosedPoleLine with a typed empty.
    EnclosedPoleLineFlat(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, w: Integer): Integer
    {
        var lines = m.CollapsedLines(f, SurfaceParameter.ParameterV);
        var l = loops[w];
        var meanV = l.Points.Map(uv => uv.V).SumOf / l.Points.Count.ToNumber;
        var up = m.UWinding(f, l).ToNumber * (m.IsChartMirrored(f) ? -1.0 : 1.0) > 0.0;
        var free = lines.Count.Range.FlatMap(k =>
            ((up ? lines[k] > meanV : lines[k] < meanV)
                && loops.All(x => x.Points.All(uv => m.IsOnLine(f, uv, SurfaceParameter.ParameterV, lines[k]).Not))) ? [k] : [k].Take(0));
        return free.Reduce(-1, (best, k) => best < 0 ? k : ((lines[k] - meanV).Abs < (lines[best] - meanV).Abs ? k : best));
    }

    //==
    // # The seed triangulation

    // TriangulateRegionCdt with typed empties in its two hole filters.
    TriangulateRegionCdtFlat(r: UvRegion, chart: FaceChart): UvTriangulation
    {
        var points = r.BoundaryPoints.Map(uv => chart.ChartPoint(uv));
        var outer = r.Outer.Points.Count.Range;
        var holes = r.Holes.Count.Range.FlatMap(h =>
            r.Holes[h].Points.Count >= 3 ? [h] : [h].Take(0));
        var bySide = holes.Sort((a, b) => r.HoleRightmost(points, a) >= r.HoleRightmost(points, b));
        var ring = bySide.Reduce(outer, (current, h) => current.HoleBridged(r.HoleRing(h), points, r.AllRingSegments(points)));
        var clipped = ring.EarClipped(points);
        var pointHoles = r.Holes.Count.Range.FlatMap(h =>
            r.Holes[h].Points.Count < 3 ? r.HoleRing(h) : [h].Take(0));
        var triangles = r.Delaunayed(points, pointHoles.Reduce(clipped, (ts, p) => ts.WithPointInserted(p, points)));
        return UvTriangulation(r.BoundaryPoints, r.BoundarySources, triangles, [QuadFace(VertexIndex(0), VertexIndex(0), VertexIndex(0), VertexIndex(0))].Take(0));
    }
}

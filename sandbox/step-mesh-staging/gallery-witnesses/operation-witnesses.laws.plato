//==
// # OperationWitnessesLaws
//
// Layer 7 of the STEP B-rep to mesh design (README.md beside this file): the
// laws the operation witnesses (operation-witnesses.library.plato) satisfy.
// A witness is chosen by an Integer through OperationWitnessAt, so a law
// quantifies over all 22 (k modulo 22), and its facts come from
// OperationFactsAt in the same order. The laws that mesh them are layer 8's,
// over MeshedWitness (08-pipeline/pipeline-operation-witnesses.library.plato
// registers each). Every witness is also a BrepModel value, so every law over
// BrepModel in the library draws it too.
//
// Sections, in order:
//  - Counts and genus
//  - Clean reports
//  - Volumes

library OperationWitnessesLaws
{
    //==
    // # Counts and genus

    // Operation witness k has one shell with its stated raw counts (the read
    // of shell 0 is behind the count: Plato evaluates both sides of &&).
    Law_OperationWitnessHasStatedCounts(k: Integer): Boolean
        => BrepModel.OperationWitnessAt(k).Shells.Count == 1
            ? BrepModel.OperationWitnessAt(k).RawCounts(ShellIndex(0)) == WitnessFacts.OperationFactsAt(k).Shells[0]
            : false;

    // The stated counts of operation witness k imply its stated genus.
    Law_OperationWitnessStatedCountsImplyStatedGenus(k: Integer): Boolean
        => WitnessFacts.OperationFactsAt(k).Shells[0].ImpliedGenus == WitnessFacts.OperationFactsAt(k).Genera[0];

    // Operation witness k's shell has the reduced Euler characteristic
    // 2 - 2 g of its stated genus: 2 for the prisms, features and spools, 0
    // for the slot, the counterbore, the countersink, the tube and the cross
    // hole.
    Law_OperationWitnessEulerIsTwoMinusTwiceGenus(k: Integer): Boolean
        => BrepModel.OperationWitnessAt(k).ShellEulerPoincare(ShellIndex(0)) == 2 - 2 * WitnessFacts.OperationFactsAt(k).Genera[0];

    //==
    // # Clean reports

    // Operation witness k passes every structural check.
    Law_OperationWitnessIsStructurallyClean(k: Integer): Boolean
        => BrepModel.OperationWitnessAt(k).ValidateBrep(ConformanceLevel.Structural).IsClean;

    // Operation witness k passes ValidateBrep at its default (Geometric)
    // level: every edge on its surfaces, every vertex on its curves, within
    // Witness_Tolerances; for the cross hole, the spline's 3.5e-7 is inside
    // the 1e-6 length tolerance.
    Law_OperationWitnessValidatesClean(k: Integer): Boolean
        => BrepModel.OperationWitnessAt(k).ValidateBrep.IsClean;

    // Operation witness k passes ValidateBrep at the Oracle level.
    Law_OperationWitnessIsOracleClean(k: Integer): Boolean
        => BrepModel.OperationWitnessAt(k).ValidateBrep(ConformanceLevel.Oracle).IsClean;

    //==
    // # Volumes

    // The divergence oracle's volume of operation witness k's shell is its
    // stated volume, within the oracle's own allowance and a millionth of the
    // volume; the cross hole states none. The oracle returns NaN on a surface
    // of revolution or linear extrusion (TKT-483: the extruded fillet, the
    // barrel, the revolved cone), and those hold vacuously until it is fixed.
    Law_OperationWitnessVolumeMatchesOracle(k: Integer): Boolean
    {
        var m = BrepModel.OperationWitnessAt(k);
        var stated = WitnessFacts.OperationFactsAt(k).ShellVolumes;
        var oracle = m.Oracle_DivergenceVolume(ShellIndex(0));
        return stated.Count == 0 || oracle.IsFinite.Not
            ? true
            : (oracle - stated[0]).Abs <= m.DivergenceAllowance(ShellIndex(0)) + 1e-6 * stated[0];
    }
}

//==
// # Meshed operation witnesses
//
// Layer 8 of the STEP B-rep to mesh design (README.md beside this file). The
// operation witnesses of layer 7 (07-validation/operation-witnesses.library.plato:
// one solid per first-level CAD operation, a hole, a boss, a fillet, a cut, a
// revolve) each meshed once per sweep as a MeshedWitness, so every law over
// MeshedWitness (pipeline-meshed-witness.laws.plato: meshes Ok, cross-checks
// and validates clean at the Oracle level) runs on each of them, as it does on
// the unit box and the sphere.
//
// Sections, in order:
//  - Prisms from profiles
//  - Features on a box
//  - Solids of one curved face

library StepToMeshMeshedOperationWitnesses
{
    //==
    // # Prisms from profiles

    Witness_HexagonMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_Hexagon.MeshedWitnessOf("Hexagon");
    Witness_LBracketMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_LBracket.MeshedWitnessOf("LBracket");
    Witness_ChamferMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_Chamfer.MeshedWitnessOf("Chamfer");
    Witness_FilletMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_Fillet.MeshedWitnessOf("Fillet");
    Witness_ExtrudedFilletMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_ExtrudedFillet.MeshedWitnessOf("ExtrudedFillet");
    Witness_InnerFilletMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_InnerFillet.MeshedWitnessOf("InnerFillet");
    Witness_SlotMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_Slot.MeshedWitnessOf("Slot");
    Witness_DShaftMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_DShaft.MeshedWitnessOf("DShaft");
    Witness_PyramidMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_Pyramid.MeshedWitnessOf("Pyramid");

    //==
    // # Features on a box

    Witness_BlindHoleMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_BlindHole.MeshedWitnessOf("BlindHole");
    Witness_BossMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_Boss.MeshedWitnessOf("Boss");
    Witness_CounterboreMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_Counterbore.MeshedWitnessOf("Counterbore");
    Witness_CountersinkMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_Countersink.MeshedWitnessOf("Countersink");
    Witness_SphereDimpleMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_SphereDimple.MeshedWitnessOf("SphereDimple");
    Witness_SphereDomeMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_SphereDome.MeshedWitnessOf("SphereDome");
    Witness_OpenBoxMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_OpenBox.MeshedWitnessOf("OpenBox");

    //==
    // # Solids of one curved face

    Witness_TubeMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_Tube.MeshedWitnessOf("Tube");
    Witness_ObliqueCutMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_ObliqueCut.MeshedWitnessOf("ObliqueCut");
    Witness_TorusFilletMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_TorusFillet.MeshedWitnessOf("TorusFillet");
    Witness_RevolvedBarrelMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_RevolvedBarrel.MeshedWitnessOf("RevolvedBarrel");
    Witness_RevolvedConeMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_RevolvedCone.MeshedWitnessOf("RevolvedCone");
    Witness_CrossHoleMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_CrossHole.MeshedWitnessOf("CrossHole");
}

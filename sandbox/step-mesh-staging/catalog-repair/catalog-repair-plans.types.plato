//==
// # Catalog repair: plans, policies, outcomes, ledgers
//
// TYPE-CATALOG.md section 13. A repair plan is an ordered list of steps
// (structure before geometry), a policy says what a repair may do, and every
// repair carries its before-and-after evidence and its inverse: a repair is
// an edit.
//
// Sections, in order:
//  - Plans and policies
//  - Outcomes and ledgers
//  - Healed models

//==
// # Plans and policies

// One planned repair: the defect, the action chosen for it, and the law that
// must hold after it. Removes: a repair whose success nobody checks.
type RepairStep
{
    Defect: Defect;
    Action: RepairAction;
    Expect: LawName;
}

// Repairs in the order they run. Built by PlanOf, so every Structural step
// precedes every Geometric one (Law_Catalog_PlanFixesStructureBeforeGeometry).
// Removes: a snap planned before the loop it snaps in was chained.
type RepairPlan
{
    Steps: Array<RepairStep>;
}

// What a repair may do, like OpenCascade's healing flags but typed: the
// largest tolerance growth, whether table sizes or a shell's orientation may
// change, and the work allowed. Removes: a healing pass that flips a shell
// the caller wanted kept.
type RepairPolicy
{
    MaxToleranceGrowth: Ratio;
    AllowTopologyChange: Boolean;
    AllowShellFlip: Boolean;
    Budget: WorkBudget;
}

//==
// # Outcomes and ledgers

// What one repair did. Repaired: the new model, the remap of its tables, the
// expected law's check before and after, and the edit that undoes it.
// Worsened: the check got worse; Reverted says whether the model was put
// back. NotApplied: refused, with why. Removes: a repair whose effect is
// asserted, not measured.
type RepairOutcome
    = Repaired(Model: BrepModel, Remap: KernelRemap, Before: Check, After: Check, Inverse: ModelEdit)
    | Worsened(Before: Check, After: Check, Reverted: Boolean)
    | NotApplied(Why: String);

// One entry of a repair ledger: the STEP source the repair is about, the
// action, and its outcome. Layer 3's RepairRecord is its projection
// (ToStepRepair on Action). Removes: an audit trail that names the instance
// but not what was done to it.
type RepairEntry
{
    Source: StepSource;
    Action: RepairAction;
    Outcome: RepairOutcome;
}

// Every repair made to one model, in the order made: the audit trail
// ProvenanceMap.Repairs starts. Removes: a healed model nobody can explain.
type RepairLedger
{
    Records: Array<RepairEntry>;
}

//==
// # Healed models

// A model after a repair pass, with its ledger and the defects left. The
// mesher takes a PreparedModel; ToPreparedModel gives it, and the ledger
// stays with the HealedModel. Removes: a healed model meshed as if it had
// never been touched.
type HealedModel
    implements IRepairable
{
    Model: PreparedModel;
    Ledger: RepairLedger;
    Remaining: Array<Defect>;
}

//==
// # Repair

// A value that reports its own defects and accepts a repair plan under a
// policy. Removes: a repair pass written once per model type.
interface IRepairable
{
    Defects(x: Self): DefectReport;
    Repair(x: Self, plan: RepairPlan, policy: RepairPolicy): RepairOutcome;
}

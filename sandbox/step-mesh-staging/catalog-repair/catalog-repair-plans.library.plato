//==
// # CatalogRepairPlans
//
// TYPE-CATALOG.md section 13: policies, ledgers, and healed models. The
// repair itself is deferred: it is the algorithm of the new layer 11.
//
// Sections, in order:
//  - Policies
//  - Ledgers
//  - Healed models

library CatalogRepairPlans
{
    //==
    // # Policies

    // The policy that changes nothing a caller could object to: no tolerance
    // growth, no change of table sizes, no shell flip, no work.
    StrictPolicy(_: RepairPolicy): RepairPolicy
        => RepairPolicy(Ratio(1.0), false, false, WorkBudget(0, 0, 0, 0));

    //==
    // # Ledgers

    // The ledger of no repair.
    EmptyLedger(_: RepairLedger): RepairLedger
        => RepairLedger([RepairEntry(
            StepSource(StepOccurrenceIndex(0), StepInstanceId(0)),
            RepairAction.SortKnots(CurveIndex(0)),
            RepairOutcome.NotApplied("none"))].Take(0));

    // The ledger with entry e appended.
    Recorded(l: RepairLedger, e: RepairEntry): RepairLedger
        => RepairLedger(l.Records.Concatenate([e]));

    // Whether an outcome changed the model.
    IsRepaired(o: RepairOutcome): Boolean
        => match (o) {
            Repaired(model, remap, before, after, inverse) => true;
            Worsened(before, after, reverted) => false;
            NotApplied(why) => false;
        };

    //==
    // # Healed models

    // The model the mesher takes; the ledger stays with h.
    ToPreparedModel(h: HealedModel): PreparedModel
        => h.Model;

    // A healed model's report of what is left to repair.
    Defects(h: HealedModel): DefectReport
        => DefectReportOf(h.Remaining);

    // deferred: apply each step of the plan whose action the policy permits,
    // check the step's expected law before and after, and revert a step that
    // makes it worse.
    Repair(h: HealedModel, plan: RepairPlan, policy: RepairPolicy): RepairOutcome;
}

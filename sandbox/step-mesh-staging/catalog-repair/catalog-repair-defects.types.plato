//==
// # Catalog repair: defects as data
//
// TYPE-CATALOG.md section 13 (a new layer 11-repair). A defect is a value
// with its address and its measure, derived from a failed Check, so a repair
// planner matches on cases instead of on diagnostic code strings.
//
// Sections, in order:
//  - Defects
//  - Classes and reach
//  - Decided defects
//  - Defect reports

//==
// # Defects

// One defect a repair can address, one case per law family, each with its
// address and measure. FreeEdge: an edge used once in a closed shell.
// EdgeUsedThrice: used Uses times, more than twice. GapAtVertex: End of Edge
// misses its vertex by Gap. VertexOffCurve, EdgeOffSurface: a coupling
// distance above the length tolerance. MissingPcurve: no pcurve of Edge on
// Face's surface. PcurveOffCurve: a pcurve Gap from its curve. LoopNotChained:
// the coedge at AtSlot does not end where the next starts. LoopOpenInUv: the
// chart image of a bound does not close, by Gap. LoopSelfIntersects: coedges I
// and J of a bound cross in the chart. SeamRunsSameWay: both uses of a seam
// edge on Face run one way. MisorientedFace: Face's sense disagrees with its
// shell. NotOrientable: no choice of face senses makes Shell coherent.
// DegenerateEdge: an edge of zero extent. DuplicateVertex: A and B within
// Distance. RedundantVertexLoop: a vertex loop on a vertex its face already
// has. NoOuterBound, TwoOuterBounds: the outer flags. TrimOutsideDomain: a
// trim past its surface's domain by Excess, in that parameter's unit.
// KnotMultiplicityTooHigh, KnotsNotNonDecreasing: a knot vector fault at
// knot At. ZeroLengthDirection: a STEP direction of zero length.
// NonOrthonormalPlacement: a placement off orthonormal by Deviation.
// ToleranceBelowResolution: a length tolerance under the rounding floor at
// the coordinate extent. DeclaredClosedButOpen: a closed shell with FreeEdges
// free edges. ShellDisconnected: one shell of Components pieces.
// Unclassified: a failed check of any other law, or one whose provenance does
// not give the full address of its family's case (DefectOf). Removes: repairs
// keyed on diagnostic code strings.
type Defect
    = FreeEdge(Edge: BrepEdgeIndex)
    | EdgeUsedThrice(Edge: BrepEdgeIndex, Uses: Count)
    | GapAtVertex(Edge: BrepEdgeIndex, End: EdgeEnd, Gap: ModelLength)
    | VertexOffCurve(Vertex: BrepVertexIndex, Edge: BrepEdgeIndex, Distance: ModelLength)
    | EdgeOffSurface(Edge: BrepEdgeIndex, Face: BrepFaceIndex, Distance: ModelLength)
    | MissingPcurve(Edge: BrepEdgeIndex, Face: BrepFaceIndex)
    | PcurveOffCurve(Pcurve: PcurveIndex, Gap: ModelLength)
    | LoopNotChained(Loop: BrepLoopIndex, AtSlot: CoedgeSlot)
    | LoopOpenInUv(Face: BrepFaceIndex, Bound: BoundSlot, Gap: UvDelta)
    | LoopSelfIntersects(Face: BrepFaceIndex, Bound: BoundSlot, I: CoedgeSlot, J: CoedgeSlot)
    | SeamRunsSameWay(Face: BrepFaceIndex, Edge: BrepEdgeIndex)
    | MisorientedFace(Face: BrepFaceIndex)
    | NotOrientable(Shell: ShellIndex)
    | DegenerateEdge(Edge: BrepEdgeIndex)
    | DuplicateVertex(A: BrepVertexIndex, B: BrepVertexIndex, Distance: ModelLength)
    | RedundantVertexLoop(Face: BrepFaceIndex, Bound: BoundSlot)
    | NoOuterBound(Face: BrepFaceIndex)
    | TwoOuterBounds(Face: BrepFaceIndex)
    | TrimOutsideDomain(Surface: SurfaceIndex, Excess: Number)
    | KnotMultiplicityTooHigh(Curve: CurveIndex, At: Integer)
    | KnotsNotNonDecreasing(Curve: CurveIndex, At: Integer)
    | ZeroLengthDirection(Instance: StepInstanceId)
    | NonOrthonormalPlacement(Surface: SurfaceIndex, Deviation: Angle)
    | ToleranceBelowResolution(Tolerance: LengthTolerance, Resolution: Resolution)
    | DeclaredClosedButOpen(Shell: ShellIndex, FreeEdges: Count)
    | ShellDisconnected(Shell: ShellIndex, Components: Count)
    | Unclassified(Law: String, Where: Provenance);

//==
// # Classes and reach

// The kind of a defect, which orders a repair plan: structure first, then
// tolerances, then geometry, then quality. Aligns with layer 0's
// ConstraintGroup, Tolerance split out. Removes: a geometric snap attempted
// on a loop whose coedges are not yet chained.
type DefectClass
    = Structural
    | Geometric
    | Tolerance
    | Quality;

// How far a repair reaches: its own element and at most two faces, the
// listed faces, its whole shell, or the whole model. Removes: a "local"
// repair that rewrites half a shell unannounced.
type Locality
    = Local
    | NeedsNeighbours(Faces: Array<BrepFaceIndex>)
    | WholeShell
    | WholeModel;

//==
// # Decided defects

// What one check says about defects: the defect it found, or why it found
// none (a check that holds is NotApplicable). Section 5's pattern, declared
// here for the decided track. Removes: a passing check read as a defect.
type DecidedDefect
    = Defect(Value: Defect)
    | Undecided(Reason: UndecidedReason);

//==
// # Defect reports

// The defects of one validation in the form a repair planner reads: the
// defects in report order, their count per DefectClass (Structural,
// Geometric, Tolerance, Quality), and per face index f the positions in
// Defects of the defects that name face f (one row per face up to the
// highest face named). Built only by DefectReportOf and DefectsOf.
type DefectReport
{
    Defects: Array<Defect>;
    ByClass: Array<Count>;
    ByFace: JaggedArray<Integer>;
}

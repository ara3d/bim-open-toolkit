//==
// # Catalog repair: types borrowed from tracks running beside this one
//
// Each is declared here because its owning track had not committed it when
// this track started (CATALOG-BRIEF.md, "Types from another track's
// sections"). The supervisor deletes the duplicates at merge; where a shape
// here is narrower than the catalog's, TRACK.md says so.
//
// Sections, in order:
//  - Section 5: the reason a decision could not be made
//  - Section 10: law names and work budgets
//  - Section 4: the prepared model
//  - Section 12: model edits (minimal)

//==
// # Section 5: the reason a decision could not be made

// Why a Decided* result holds no value: the vocabulary every Decided* sum
// shares. Removes: seven different sentinel conventions (-1, NaN, an empty
// array) for "could not".
type UndecidedReason
    = OutOfDomain
    | DegenerateAt(Side: DomainSide)
    | NoConvergence(Iterations: Integer)
    | Unbounded
    | NotApplicable(Kind: String)
    | BelowResolution
    | ToleranceExceeded(By: Measure);

//==
// # Section 10: law names and work budgets

// The name of a Law_ function, typed. Removes: a check or a repair step that
// names a law no runner knows.
type LawName
    implements IValue
{
    Value: String;
}

// Counted work: the measure the termination laws decrease and a repair
// policy caps. Removes: "slower than the old code" with no number.
type WorkBudget
    implements IValue
{
    Evaluations: Integer;
    Insertions: Integer;
    Flips: Integer;
    Projections: Integer;
}

//==
// # Section 4: the prepared model

// A model PrepareModel finished: tolerances floored, folds applied, closures
// marked. Layers 4 to 8 take it, not BrepModel. Borrowed narrow: the
// catalog's Decoded field is left out. Removes: a raw model meshed with the
// default tolerances.
type PreparedModel
{
    Model: BrepModel;
}

//==
// # Section 12: model edits (minimal)
//
// Only the cases the inverse of a repair in this track needs. The catalog's
// GeometricEdit, TopologicalEdit and ToleranceEdit have more cases.

// An edit that changes no table size. Removes: a vertex move recorded as a
// new model with no statement of what moved.
type GeometricEdit
    = MoveVertex(Vertex: BrepVertexIndex, To: ModelPoint);

// An edit that changes a face's or a loop's orientation. Removes: an
// orientation repair with no inverse.
type TopologicalEdit
    = ReverseFace(Face: BrepFaceIndex)
    | ReverseLoop(Loop: BrepLoopIndex);

// An edit of the model's tolerances. Removes: a tolerance raised in place with
// no record of the value it replaced.
type ToleranceEdit
    = SetTolerances(To: Tolerances)
    | ScaleTolerances(Factor: Number);

// Any edit of a model, as data: what a repair's inverse is. Removes: a repair
// that cannot be undone.
type ModelEdit
    = Geometric(Edit: GeometricEdit)
    | Topological(Edit: TopologicalEdit)
    | Tolerance(Edit: ToleranceEdit);

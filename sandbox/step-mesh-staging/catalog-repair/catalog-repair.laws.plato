//==
// # Catalog repair: laws
//
// The runner cannot build a sum, a Check, or a model, so the laws over
// defects take an Integer selector into SampleDefect, one sample per Defect
// case on Witness_BoxWithPolyLoopSheet (the unit box, closed shell 0 of faces
// 0 to 5, beside a triangle alone in open shell 1, face 6), plus a seam on the
// open face. The laws over reports read layer 7's witnesses through
// ValidateBrep.
//
// Sections, in order:
//  - Samples
//  - Diagnosis
//  - From checks to defects
//  - Plans, costs, policies
//  - Projection onto StepRepair

library CatalogRepairLaws
{
    //==
    // # Samples

    // The model every sample defect is about.
    RepairSampleModel(_: Defect): BrepModel
        => BrepModel.Witness_BoxWithPolyLoopSheet;

    // How many samples SampleDefect has.
    SampleDefectCount(_: Defect): Integer
        => 28;

    // k reduced into 0 to n - 1, for any k. Precondition: n > 0.
    CatalogWrap(k: Integer, n: Integer): Integer
        => ((k % n) + n) % n;

    // Sample defect k (any Integer, wrapped): one per case, in declaration
    // order, with SeamRunsSameWay twice, at closed face 0 (sample 10) and at
    // open face 6 (sample 11).
    SampleDefect(k: Integer): Defect
    {
        var i = CatalogWrap(k, Defect.SampleDefectCount);
        var e = BrepEdgeIndex(0);
        var f = BrepFaceIndex(0);
        var s = ShellIndex(0);
        var gap = ModelLength(0.01);
        var m = Defect.RepairSampleModel;
        return i == 0 ? Defect.FreeEdge(e)
            : i == 1 ? Defect.EdgeUsedThrice(e, CountOf(3))
            : i == 2 ? Defect.GapAtVertex(e, EdgeEnd(e, true), gap)
            : i == 3 ? Defect.VertexOffCurve(BrepVertexIndex(0), e, gap)
            : i == 4 ? Defect.EdgeOffSurface(e, f, gap)
            : i == 5 ? Defect.MissingPcurve(e, f)
            : i == 6 ? Defect.PcurveOffCurve(PcurveIndex(0), gap)
            : i == 7 ? Defect.LoopNotChained(BrepLoopIndex(0), CoedgeSlot(1))
            : i == 8 ? Defect.LoopOpenInUv(f, BoundSlot(0), UvDelta(0.01, 0.0))
            : i == 9 ? Defect.LoopSelfIntersects(f, BoundSlot(0), CoedgeSlot(0), CoedgeSlot(2))
            : i == 10 ? Defect.SeamRunsSameWay(f, e)
            : i == 11 ? Defect.SeamRunsSameWay(BrepFaceIndex(6), e)
            : i == 12 ? Defect.MisorientedFace(f)
            : i == 13 ? Defect.NotOrientable(s)
            : i == 14 ? Defect.DegenerateEdge(e)
            : i == 15 ? Defect.DuplicateVertex(BrepVertexIndex(0), BrepVertexIndex(1), gap)
            : i == 16 ? Defect.RedundantVertexLoop(f, BoundSlot(0))
            : i == 17 ? Defect.NoOuterBound(f)
            : i == 18 ? Defect.TwoOuterBounds(f)
            : i == 19 ? Defect.TrimOutsideDomain(SurfaceIndex(0), 0.1)
            : i == 20 ? Defect.KnotMultiplicityTooHigh(CurveIndex(0), 1)
            : i == 21 ? Defect.KnotsNotNonDecreasing(CurveIndex(0), 1)
            : i == 22 ? Defect.ZeroLengthDirection(StepInstanceId(7))
            : i == 23 ? Defect.NonOrthonormalPlacement(SurfaceIndex(0), Angle(0.01))
            : i == 24 ? Defect.ToleranceBelowResolution(m.Tolerances.Length, Resolution(m.Tolerances.Length.Value * 2.0))
            : i == 25 ? Defect.DeclaredClosedButOpen(s, CountOf(1))
            : i == 26 ? Defect.ShellDisconnected(s, CountOf(2))
            : Defect.Unclassified("Law_EulerPoincareEvenAndBounded", Provenance.KernelShell(s));
    }

    // Every sample, in the order i * 5 + k (5 is prime to 28, so this is a
    // permutation that depends on k).
    SampleDefects(k: Integer): Array<Defect>
        => Defect.SampleDefectCount.MapRange(i => SampleDefect(i * 5 + k));

    //==
    // # Diagnosis

    // The cases Diagnose may call Unfixable, stated apart from Diagnose:
    // NotOrientable, SeamRunsSameWay on a face of a closed shell,
    // ShellDisconnected, Unclassified, and the bound cases on a face with no
    // bound to promote.
    IsNamedUnfixable(m: BrepModel, d: Defect): Boolean
        => match (d) {
            FreeEdge(e) => false;
            EdgeUsedThrice(e, n) => false;
            GapAtVertex(e, end, gap) => false;
            VertexOffCurve(v, e, dist) => false;
            EdgeOffSurface(e, f, dist) => false;
            MissingPcurve(e, f) => false;
            PcurveOffCurve(p, gap) => false;
            LoopNotChained(l, s) => false;
            LoopOpenInUv(f, b, gap) => false;
            LoopSelfIntersects(f, b, i, j) => false;
            SeamRunsSameWay(f, e) => m.IsInClosedShell(f);
            MisorientedFace(f) => false;
            NotOrientable(s) => true;
            DegenerateEdge(e) => false;
            DuplicateVertex(a, b, dist) => false;
            RedundantVertexLoop(f, b) => false;
            NoOuterBound(f) => m.BoundSlotsWhere(f, x => true).Count == 0;
            TwoOuterBounds(f) => m.BoundSlotsWhere(f, x => x.IsOuter).Count == 0;
            TrimOutsideDomain(s, x) => false;
            KnotMultiplicityTooHigh(c, at) => false;
            KnotsNotNonDecreasing(c, at) => false;
            ZeroLengthDirection(i) => false;
            NonOrthonormalPlacement(s, dev) => false;
            ToleranceBelowResolution(t, r) => false;
            DeclaredClosedButOpen(s, n) => false;
            ShellDisconnected(s, n) => true;
            Unclassified(law, w) => true;
        };

    // Diagnose is Unfixable exactly for the named cases.
    Law_Catalog_DiagnoseUnfixableOnlyForNamedCases(_: Defect): Boolean
        => Defect.SampleDefectCount.Range.All(k => Defect.RepairSampleModel.Diagnose(SampleDefect(k)).IsUnfixable
            == Defect.RepairSampleModel.IsNamedUnfixable(SampleDefect(k)));

    // Diagnose never offers an empty choice.
    Law_Catalog_DiagnoseNeverOffersAnEmptyChoice(_: Defect): Boolean
        => Defect.SampleDefectCount.Range.All(k => Defect.RepairSampleModel.Diagnose(SampleDefect(k)).IsUnfixable
            ? true
            : ActionsOf(Defect.RepairSampleModel.Diagnose(SampleDefect(k))).Count > 0);

    // A seam whose uses run one way on a face of a closed shell is Unfixable.
    Law_Catalog_SeamOnClosedShellIsUnfixable(_: Defect): Boolean
        => Defect.RepairSampleModel.Diagnose(SampleDefect(10)).IsUnfixable;

    // The same seam defect on a face of an open shell is fixable.
    Law_Catalog_SeamOnOpenShellIsFixable(_: Defect): Boolean
        => !Defect.RepairSampleModel.Diagnose(SampleDefect(11)).IsUnfixable;

    // A shell that is not orientable is Unfixable.
    Law_Catalog_NotOrientableIsUnfixable(_: Defect): Boolean
        => Defect.RepairSampleModel.Diagnose(SampleDefect(13)).IsUnfixable;

    //==
    // # From checks to defects

    // How many samples MappedSampleDefect has.
    MappedSampleCount(_: Defect): Integer
        => 7;

    // Sample k of the defects DefectOf builds from a check alone.
    MappedSampleDefect(k: Integer): Defect
    {
        var i = CatalogWrap(k, Defect.MappedSampleCount);
        return i == 0 ? SampleDefect(12)
            : i == 1 ? SampleDefect(13)
            : i == 2 ? SampleDefect(18)
            : i == 3 ? SampleDefect(14)
            : i == 4 ? SampleDefect(23)
            : i == 5 ? SampleDefect(22)
            : SampleDefect(24);
    }

    // The failed check MappedSampleDefect(k) stands for: its expected law,
    // at its provenance, with its measure as Worst (and, for the tolerance
    // case, the tolerance as Bound).
    MappedSampleCheck(k: Integer, holds: Boolean): Check
    {
        var i = CatalogWrap(k, Defect.MappedSampleCount);
        var law = ExpectedLawOf(MappedSampleDefect(k)).Value;
        var m = Defect.RepairSampleModel;
        var worst = holds ? 0.0 : 1.0;
        return i == 0 ? Check(law, holds, worst, 0.0, Provenance.KernelFace(BrepFaceIndex(0)))
            : i == 1 ? Check(law, holds, worst, 0.0, Provenance.KernelShell(ShellIndex(0)))
            : i == 2 ? Check(law, holds, worst, 0.0, Provenance.KernelFace(BrepFaceIndex(0)))
            : i == 3 ? Check(law, holds, worst, 0.0, Provenance.KernelEdge(BrepEdgeIndex(0)))
            : i == 4 ? Check(law, holds, 0.01, 0.0, Provenance.KernelSurface(SurfaceIndex(0)))
            : i == 5 ? Check(law, holds, worst, 0.0, Provenance.AtInstance(StepInstanceId(7)))
            : Check(law, holds, m.Tolerances.Length.Value * 2.0, m.Tolerances.Length.Value, Provenance.WholeInput);
    }

    // A failed check of a mapped defect's expected law, at its provenance and
    // with its measure, gives that defect back. The measures are copied, so
    // the comparison is exact.
    Law_Catalog_DefectOfInvertsExpectedLaw(k: Integer): Boolean
        => DefectsIn(DefectOf(MappedSampleCheck(k, false))).Count == 1
            ? DefectsIn(DefectOf(MappedSampleCheck(k, false)))[0] == MappedSampleDefect(k)   // exact by construction
            : false;

    // A check that holds gives no defect.
    Law_Catalog_HeldCheckHasNoDefect(k: Integer): Boolean
        => DefectsIn(DefectOf(MappedSampleCheck(k, true))).Count == 0;

    // A failed check of a law no case covers is Unclassified with its law
    // and provenance.
    Law_Catalog_UnknownLawIsUnclassified(_: Defect): Boolean
        => FailedDefectOf(CheckExact("Law_EulerPoincareEvenAndBounded", false, Provenance.KernelShell(ShellIndex(0))))
            == SampleDefect(27);

    // The empty report has no defects.
    Law_Catalog_DefectsOfEmptyReportIsEmpty(_: Report): Boolean
        => DefectsOf(Report.Empty).Defects.Count == 0;

    // The unit box's validation report has no defects.
    Law_Catalog_DefectsOfCleanReportIsEmpty(_: BrepModel): Boolean
        => DefectsOf(BrepModel.Witness_UnitBox.ValidateBrep).Defects.Count == 0;

    // Whether d is MisorientedFace at face f.
    IsMisorientedFaceAt(d: Defect, f: BrepFaceIndex): Boolean
        => d == Defect.MisorientedFace(f);

    // The box with a flipped face fails Law_LoopWindingMatchesSameSense at
    // face 0, so its defects name face 0 as misoriented.
    Law_Catalog_FlippedFaceReportHasMisorientedFace(_: BrepModel): Boolean
        => DefectsOf(BrepModel.Witness_BoxWithFlippedFace.ValidateBrep).Defects
            .Any(d => IsMisorientedFaceAt(d, BrepFaceIndex(0)));

    // The number of failed checks of a report.
    FailedCheckCount(r: Report): Integer
        => r.Checks.Reduce(0, (n, c) => c.Holds ? n : n + 1);

    // Every failed check of a negative witness's report is one defect: two
    // boxes sharing a corner.
    Law_Catalog_EveryFailedCheckIsADefect(_: BrepModel): Boolean
        => DefectsOf(BrepModel.Witness_TwoBoxesSharingCorner.ValidateBrep).Defects.Count
            == FailedCheckCount(BrepModel.Witness_TwoBoxesSharingCorner.ValidateBrep);

    // The class counts of a defect report add up to its defects.
    Law_Catalog_ByClassCountsEveryDefect(k: Integer): Boolean
        => DefectReportOf(SampleDefects(k)).ByClass.Reduce(0, (n, c) => n + c.Value)
            == SampleDefects(k).Count;

    // Every position in a defect report's face row names a defect that names
    // that face.
    Law_Catalog_ByFaceRowsNameTheirFace(k: Integer, f: Integer): Boolean
        => (f >= 0 ? f < DefectReportOf(SampleDefects(k)).ByFace.RowCount : false)
            ? DefectReportOf(SampleDefects(k)).ByFace.Row(f).All(i =>
                FacesOf(SampleDefects(k)[i]).Any(x => x.Value == f))
            : true;

    //==
    // # Plans, costs, policies

    // Whether step i of a plan is of class c.
    StepIsOfClass(p: RepairPlan, i: Integer, c: DefectClass): Boolean
        => ClassOf(p.Steps[i].Defect) == c;

    // In a plan built by PlanOf, every Structural step precedes every
    // Geometric step.
    Law_Catalog_PlanFixesStructureBeforeGeometry(k: Integer): Boolean
    {
        var p = Defect.RepairSampleModel.PlanOf(SampleDefects(k));
        var n = p.Steps.Count;
        return n.Range.All(i => n.Range.All(j =>
            j > i ? !(p.StepIsOfClass(i, DefectClass.Geometric) && p.StepIsOfClass(j, DefectClass.Structural)) : true));
    }

    // A plan has one step per defect that is not Unfixable.
    Law_Catalog_PlanHasAStepPerFixableDefect(k: Integer): Boolean
        => Defect.RepairSampleModel.PlanOf(SampleDefects(k)).Steps.Count
            == SampleDefects(k).Reduce(0, (n, d) => Defect.RepairSampleModel.Diagnose(d).IsUnfixable ? n : n + 1);

    // Whether a locality is Local.
    IsLocal(l: Locality): Boolean
        => match (l) {
            Local => true;
            NeedsNeighbours(faces) => false;
            WholeShell => false;
            WholeModel => false;
        };

    // A Local repair touches at most two faces: every action Diagnose offers,
    // at its cost.
    Law_Catalog_LocalRepairTouchesAtMostTwoFaces(_: Defect): Boolean
        => Defect.SampleDefectCount.Range.All(k => ActionsOf(Defect.RepairSampleModel.Diagnose(SampleDefect(k))).All(a =>
            IsLocal(Defect.RepairSampleModel.CostOf(a).Locality)
                ? Defect.RepairSampleModel.CostOf(a).TouchedFaces.Value <= 2
                : true));

    // The strict policy refuses every action that changes a table's size.
    Law_Catalog_StrictPolicyRefusesTopologyChange(_: Defect): Boolean
        => Defect.SampleDefectCount.Range.All(k => ActionsOf(Defect.RepairSampleModel.Diagnose(SampleDefect(k))).All(a =>
            ChangesTopology(a)
                ? !Permits(RepairPolicy.StrictPolicy, a, Defect.RepairSampleModel.CostOf(a))
                : true));

    // Raising the tolerance to more than it was grows it by more than 1.
    Law_Catalog_RaisedToleranceGrows(_: Defect): Boolean
        => Defect.RepairSampleModel.CostOf(RepairAction.RaiseTolerance(
                Defect.RepairSampleModel.RaisedLength(Defect.RepairSampleModel.Tolerances.Length.Value * 2.0)))
            .ToleranceGrowth.Value > 1.0;

    //==
    // # Projection onto StepRepair

    // Layer 3 repair k (wrapped): MergedInto vertex v, DroppedZeroLengthEdge,
    // or Skipped.
    SampleStepRepair(k: Integer, v: Integer): StepRepair
    {
        var i = CatalogWrap(k, 3);
        return i == 0 ? StepRepair.MergedInto(BrepVertexIndex(v))
            : i == 1 ? StepRepair.DroppedZeroLengthEdge
            : StepRepair.Skipped;
    }

    // A decoder repair record, read as an action and projected back, is its
    // own StepRepair, for each of the three cases.
    Law_Catalog_StepRepairRoundTrips(k: Integer, v: Integer, dropped: Integer, edge: Integer, instance: Integer): Boolean
        => ToStepRepair(ToRepairAction(
                RepairRecord(StepSource(StepOccurrenceIndex(0), StepInstanceId(instance)), SampleStepRepair(k, v)),
                BrepVertexIndex(dropped),
                BrepEdgeIndex(edge)))
            .ProjectsTo(SampleStepRepair(k, v));

    // Whether a projection found a StepRepair.
    IsProjected(p: StepRepairProjection): Boolean
        => match (p) {
            Projected(r) => true;
            NotProjected(finding) => false;
        };

    // An action the decoder never makes does not project.
    Law_Catalog_ReverseFaceDoesNotProject(f: Integer): Boolean
        => !ToStepRepair(RepairAction.ReverseFace(BrepFaceIndex(f))).IsProjected;
}

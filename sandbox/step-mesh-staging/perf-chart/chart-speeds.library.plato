//==
// # A face's chart from one pass over both sample sets (complexity sweep chunk R7, TKT-389)
//
// Layer 05. ChartOf called MeanSpeed twice, once per parameter, and each call concatenated the
// region's boundary points for its parameter box, tested every one of its 63 samples against
// the collapsed lines (rebuilding the surface domain per test and the point tolerance twice per
// line), and evaluated both partials at every sample through which.Along, of which it kept one:
// 252 partial evaluations per face. MeanSpeedBoth takes the box once without copying the
// boundary, builds the surface domain once and tests a sample only when the surface has a
// collapsed line, and evaluates at each sample only the partial it averages: PartialU on the
// ParameterU sample set, PartialV on the other, 126 partials per face. The two sample sets
// differ (each runs along its own parameter at the other's quarter lines), so each speed keeps
// its own set; every value is computed by the expressions MeanSpeed uses, in the same order,
// so ChartOfBody2 is ChartOf bit for bit. QuadSidesIn is QuadSidesOf with the region tolerance
// given, so MeshRegionOnce's grid test does not build the chart a second time.
//
// Sections, in order:
//  - The parameter box
//  - Mean speeds
//  - The chart
//  - Four-sided regions with the tolerance given

library ChartSpeeds
{
    //==
    // # The parameter box

    // The least u and least v over the region's boundary points (BoundaryPoints' order, the
    // same fold MeanSpeed makes over the concatenation, without the copy).
    BoxLow(r: UvRegion): UvCoordinate
        => r.Holes.Reduce(
            r.Outer.Points.Reduce(UvCoordinate(Number.MaxValue, Number.MaxValue), (a, p) => UvCoordinate(a.U.Min(p.U), a.V.Min(p.V))),
            (acc, h) => h.Points.Reduce(acc, (a, p) => UvCoordinate(a.U.Min(p.U), a.V.Min(p.V))));

    // The greatest u and greatest v over the region's boundary points, as BoxLow.
    BoxHigh(r: UvRegion): UvCoordinate
        => r.Holes.Reduce(
            r.Outer.Points.Reduce(UvCoordinate(0.0 - Number.MaxValue, 0.0 - Number.MaxValue), (a, p) => UvCoordinate(a.U.Max(p.U), a.V.Max(p.V))),
            (acc, h) => h.Points.Reduce(acc, (a, p) => UvCoordinate(a.U.Max(p.U), a.V.Max(p.V))));

    // The number of boundary points, without concatenating them.
    BoundaryPointCount(r: UvRegion): Integer
        => r.Holes.Reduce(r.Outer.Points.Count, (n, h) => n + h.Points.Count);

    //==
    // # Mean speeds

    // Sample k of MeanSpeed's 63 for parameter `which` in the box lo .. hi: point k % 21 of 21
    // along `which`, on the quarter line k / 21 + 1 of the other parameter.
    SpeedSample(which: SurfaceParameter, lo: UvCoordinate, hi: UvCoordinate, k: Integer): UvCoordinate
        => UvCoordinate(
            lo.U + (hi.U - lo.U) * which.Along((k % 21).ToNumber / 20.0, (k / 21 + 1).ToNumber * 0.25),
            lo.V + (hi.V - lo.V) * which.Along((k / 21 + 1).ToNumber * 0.25, (k % 21).ToNumber / 20.0));

    // The number of collapsed lines of face f's surface, along both parameters.
    CollapsedLineCount(m: BrepModel, f: BrepFaceIndex): Integer
        => m.CollapsedLines(f, SurfaceParameter.ParameterU).Count + m.CollapsedLines(f, SurfaceParameter.ParameterV).Count;

    // MeanSpeed's samples for `which` that lie on no collapsed line of face f: all 63 when the
    // surface has none (lines is 0), else each tested with the surface domain given (dom is
    // m.SurfaceDomainOf(f)). Its work: two partial evaluations per sample per collapsed line
    // (layer 01's point tolerance, PointToleranceIn), as Evaluations.
    KeptSamplesCounted(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, lines: Integer, which: SurfaceParameter, lo: UvCoordinate, hi: UvCoordinate): Counted<Array<UvCoordinate>>
    {
        var samples = 63.MapRange(k => SpeedSample(which, lo, hi, k));
        return lines > 0
            ? Counted(samples.FlatMap(uv => m.IsOnCollapsedLineIn(f, dom, uv) ? samples.Take(0) : [uv]), Evaluations(2 * lines * 63))
            : Counted(samples, Evaluations(0));
    }

    // MeanSpeed(f, r, which) given the box, the kept samples and the boundary's point count: the
    // mean of |PartialU| (ParameterU) or |PartialV| over the kept samples, one partial each,
    // never below the length tolerance over the box's extent.
    MeanSpeedOver(m: BrepModel, f: BrepFaceIndex, which: SurfaceParameter, lo: UvCoordinate, hi: UvCoordinate, kept: Array<UvCoordinate>, count: Integer): Number
    {
        var s = m.SurfaceOf(f);
        var speeds = which == SurfaceParameter.ParameterU
            ? kept.Map(uv => m.Geometry.PartialU(s, uv).Length)
            : kept.Map(uv => m.Geometry.PartialV(s, uv).Length);
        var extent = which.Along(hi.U - lo.U, hi.V - lo.V);
        var floor = count == 0 ? 1.0 : (extent > 0.0 ? m.Tolerances.Length.Value / extent : 1.0);
        var mean = speeds.Count == 0 ? 0.0 : speeds.SumOf / speeds.Count.ToNumber;
        return mean.IsFinite ? mean.Max(floor) : floor;
    }

    // Both of face f's mean speeds over region r, MeanSpeed's values bit for bit, with the work:
    // the partial evaluations, one per kept sample and two per sample per collapsed line, as
    // Evaluations. On a surface with no collapsed line, exactly 126.
    MeanSpeedBothCounted(m: BrepModel, f: BrepFaceIndex, r: UvRegion): Counted<MeanSpeeds>
    {
        var lo = r.BoxLow;
        var hi = r.BoxHigh;
        var count = r.BoundaryPointCount;
        var dom = m.SurfaceDomainOf(f);
        var lines = m.CollapsedLineCount(f);
        var keptU = m.KeptSamplesCounted(f, dom, lines, SurfaceParameter.ParameterU, lo, hi);
        var keptV = m.KeptSamplesCounted(f, dom, lines, SurfaceParameter.ParameterV, lo, hi);
        return Counted(
            MeanSpeeds(m.MeanSpeedOver(f, SurfaceParameter.ParameterU, lo, hi, keptU.Value, count),
                m.MeanSpeedOver(f, SurfaceParameter.ParameterV, lo, hi, keptV.Value, count)),
            Evaluations(keptU.Value.Count + keptV.Value.Count).Add(keptU.Work).Add(keptV.Work));
    }

    // Both of face f's mean speeds over region r: MeanSpeed for each parameter.
    MeanSpeedBoth(m: BrepModel, f: BrepFaceIndex, r: UvRegion): MeanSpeeds
        => m.MeanSpeedBothCounted(f, r).Value;

    //==
    // # The chart

    // ChartOf(f, r) with both scales from MeanSpeedBoth: the same chart, bit for bit.
    ChartOfBody2(m: BrepModel, f: BrepFaceIndex, r: UvRegion): FaceChart
    {
        var speeds = m.MeanSpeedBoth(f, r);
        return FaceChart(m.IsChartMirrored(f) ? Parity.Odd : Parity.Even, speeds.SpeedU, speeds.SpeedV);
    }

    //==
    // # Four-sided regions with the tolerance given

    // QuadSidesOf(f, r) with the region's tolerance given (tol is m.RegionTolerance(f,
    // m.ChartOf(f, r))), so the chart is not built again.
    QuadSidesIn(r: UvRegion, tol: UvTolerance): QuadSides
    {
        var n = r.Outer.Points.Count;
        var classes = n.MapRange(i => r.Outer.Points[i].StepClass(r.Outer.Points.AtModulo(i + 1), tol));
        var corners = n.Range.FlatMap(i => classes[i] != classes[(i + n - 1) % n] ? [VertexIndex(i)] : [VertexIndex(i)].Take(0));
        return (r.Holes.IsEmpty && n >= 4 && classes.All(x => x != 0) && corners.Count == 4)
            ? (4.Range.All(k => r.SideIsOneCarrier(corners, k)) ? QuadSides.FourSided(corners) : QuadSides.NotFourSided)
            : QuadSides.NotFourSided;
    }

    // FaceQuadGrid(f, d, r, c) with the region's tolerance given to the four-sided test.
    FaceQuadGridIn(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, tol: UvTolerance, c: FaceMeshingCriteria): QuadGridOutcome
        => c.PreferQuads ? m.QuadGridOnSides(f, d, r, c, r.QuadSidesIn(tol)) : QuadGridOutcome.NoGrid;
}

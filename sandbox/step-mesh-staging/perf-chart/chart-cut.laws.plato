//==
// # CutSegmentCountFast, MeanSpeedBoth, ChartOfBody2, QuadSidesIn: laws (complexity sweep chunk R7, TKT-389)
//
// The staged replacements agree with the library's originals bit for bit: ChartOfBody2 with
// ChartOf's body (both MeanSpeed calls) on every triangulated witness face and on every face of
// the ten positive witness models that can be regioned (spheres, a torus, a cone and a B-spline
// face among them, so the collapsed-line tests are reached), and on an empty region;
// QuadSidesIn with QuadSidesOf on every triangulated witness face; CutSegmentCountFast with
// CutSegmentCount on cuts across whole periods, along rulings and diagonally, on a cylinder, a
// torus, a sphere through its poles, a cone and a B-spline patch, each criterion binding in
// turn. MeanSpeedBoth evaluates exactly 126 partials on a face with no collapsed line; the count
// witness bounds the cut search's surface evaluations by three per grid point it must place.
// Layer 08 (it reads layer 07's witness models and layer 08's witness options).
//
// Sections, in order:
//  - Charts
//  - Four-sided regions
//  - Cut step counts
//  - Count witness

library ChartCutLaws
{
    //==
    // # Charts

    // ChartOf's body before this chunk: mirrored by FaceNormalSign, scaled by MeanSpeed in each
    // parameter, one call per parameter. The reference the agreement laws compare against, so
    // they keep comparing two algorithms once ChartOf is pointed at ChartOfBody2.
    ChartByMeanSpeed(m: BrepModel, f: BrepFaceIndex, r: UvRegion): FaceChart
        => FaceChart(m.IsChartMirrored(f) ? Parity.Odd : Parity.Even,
            m.MeanSpeed(f, r, SurfaceParameter.ParameterU), m.MeanSpeed(f, r, SurfaceParameter.ParameterV));

    // Whether two charts are the same, bit for bit.
    SameChart(a: FaceChart, b: FaceChart): Boolean
        => a.Mirrored == b.Mirrored && a.ScaleU == b.ScaleU && a.ScaleV == b.ScaleV;

    // ChartOfBody2 gives the reference chart for region r of face f.
    ChartAgreesOn(m: BrepModel, f: BrepFaceIndex, r: UvRegion): Boolean
        => SameChart(m.ChartOfBody2(f, r), m.ChartByMeanSpeed(f, r));

    // On every triangulated witness face, ChartOfBody2 is the reference and the witness's chart
    // (built by ChartOf).
    Law_Perf_ChartOfBody2Agrees(w: TriangulatedWitness): Boolean
        => w.Model.ChartAgreesOn(w.Face, w.Region) && SameChart(w.Model.ChartOfBody2(w.Face, w.Region), w.Chart);

    // On every face of every positive witness model that can be regioned under the witness
    // options, ChartOfBody2 is the reference on the face's region and on the empty region (no
    // boundary point: an infinite box, every speed the floor).
    Law_Perf_ChartOfBody2AgreesOnWitnesses(_: Boolean): Boolean
        => BrepModel.WitnessCount.Range.All(k => ChartAgreesOnWitness(k));

    // ChartOfBody2 is the reference on every face of positive witness model k, as above.
    ChartAgreesOnWitness(k: Integer): Boolean
    {
        var m = BrepModel.WitnessAt(k);
        var c = MeshingOptions.WitnessOptions.Face;
        var d = m.DiscretizeAll(c.Discretization, SegmentFloors.NoFloors);
        var empty = UvRegion(UvLoop([], []), []);
        return m.Faces.Count.Range.All(i => m.ChartAgreesOn(BrepFaceIndex(i), empty)
            && (m.CanRegion(BrepFaceIndex(i), d, c) ? m.ChartAgreesOn(BrepFaceIndex(i), m.RegionOf(BrepFaceIndex(i), d, c)) : true));
    }

    // MeanSpeedBoth evaluates one partial per sample, 126 per face, on every triangulated
    // witness face (none of whose surfaces has a collapsed line). MeanSpeed evaluated both
    // partials at each of its 63 samples, twice: 252.
    Law_Perf_MeanSpeedBothEvaluates126(w: TriangulatedWitness): Boolean
    {
        var work = w.Model.MeanSpeedBothCounted(w.Face, w.Region).Work;
        return w.Model.CollapsedLineCount(w.Face) == 0
            && work.Evaluations == 126 && work.Insertions == 0 && work.Flips == 0 && work.Projections == 0;
    }

    // The unit sphere's face has collapsed lines, and MeanSpeedBoth's sample sets lose the
    // samples on them (the ParameterV set runs from pole to pole), so the agreement laws reach
    // the collapsed-line tests: the work is the kept samples' partials and two per sample per
    // line, fewer than 126 + 4 x 126 when a sample is dropped.
    Law_Perf_MeanSpeedBothSkipsPoles(_: Boolean): Boolean
    {
        var m = BrepModel.WitnessAt(2);
        var c = MeshingOptions.WitnessOptions.Face;
        var d = m.DiscretizeAll(c.Discretization, SegmentFloors.NoFloors);
        var f = BrepFaceIndex(0);
        var lines = m.CollapsedLineCount(f);
        var work = m.MeanSpeedBothCounted(f, m.RegionOf(f, d, c)).Work;
        return lines > 0 && work.Evaluations < 126 + 2 * lines * 126 && work.Evaluations > 2 * lines * 126;
    }

    //==
    // # Four-sided regions

    // Whether two corner lists are the same, element by element.
    SameCorners(a: Array<VertexIndex>, b: Array<VertexIndex>): Boolean
        => a.Count == b.Count ? a.Count.Range.All(i => a[i] == b[i]) : false;

    // Whether two four-sided classifications are the same, corners compared element by element.
    SameQuadSides(a: QuadSides, b: QuadSides): Boolean
        => match (a) {
            NotFourSided => match (b) {
                NotFourSided => true;
                FourSided(cb) => false;
            };
            FourSided(ca) => match (b) {
                NotFourSided => false;
                FourSided(cb) => SameCorners(ca, cb);
            };
        };

    // QuadSidesIn with the region tolerance from the witness's chart is QuadSidesOf, on every
    // triangulated witness face.
    Law_Perf_QuadSidesInAgrees(w: TriangulatedWitness): Boolean
        => SameQuadSides(w.Region.QuadSidesIn(w.Model.RegionTolerance(w.Face, w.Chart)), w.Model.QuadSidesOf(w.Face, w.Region));

    // Some triangulated witness face is four-sided, so the agreement law compares corners: the
    // unit box's first face.
    Law_Perf_QuadSidesInFindsFourSides(w: TriangulatedWitness): Boolean
        => (w.Sample == 0 && w.Face.Value == 0)
            ? HasFourCorners(w.Region.QuadSidesIn(w.Model.RegionTolerance(w.Face, w.Chart)))
            : true;

    // Whether the classification is four-sided with four corners.
    HasFourCorners(q: QuadSides): Boolean
        => match (q) {
            NotFourSided => false;
            FourSided(corners) => corners.Count == 4;
        };

    //==
    // # Cut step counts

    // Face criteria for a cut: the given surface chordal and angular bounds, the edge criteria's
    // length limit and minimum length, the witness options' other edge criteria.
    CutCriteria(chordal: Number, angular: Angle, maxLength: Limit, minLength: Number): FaceMeshingCriteria
    {
        var w = MeshingOptions.WitnessOptions.Face.Discretization;
        return FaceMeshingCriteria(DiscretizationCriteria(w.Chordal, w.Angular, maxLength, minLength, w.MinSegments), chordal, angular, false);
    }

    // Face criteria bounded by the surface chordal only: no length limit, no turn limit that a
    // step of at most half a turn can reach, the witness minimum length.
    ChordalOnly(chordal: Number): FaceMeshingCriteria
        => CutCriteria(chordal, 180.0.Degrees, Limit.Unlimited, MeshingOptions.WitnessOptions.Face.Discretization.MinLength);

    // CutSegmentCountFast gives CutSegmentCount's n for the cut from a to b on face f.
    CutAgrees(m: BrepModel, f: Integer, a: UvCoordinate, b: UvCoordinate, c: FaceMeshingCriteria): Boolean
        => m.CutSegmentCountFast(BrepFaceIndex(f), a, b, c) == m.CutSegmentCount(BrepFaceIndex(f), a, b, c);

    // On the unit cylinder's side: a whole period at four chordal bounds (the last one capped at
    // 64), under two turn bounds (30 degrees, which 12 steps meet only up to rounding, and 31), with a chordal bound past the diameter and a length limit (the
    // one-step cut, Findings), with a minimum length that stops the search, under the witness
    // options; along the ruling under two length limits; a helix.
    Law_Perf_CutSegmentCountFastAgreesOnCylinder(_: Boolean): Boolean
    {
        var m = BrepModel.WitnessAt(1);
        var a = UvCoordinate(0.0, 0.5);
        var b = UvCoordinate(Number.Tau, 0.5);
        var least = MeshingOptions.WitnessOptions.Face.Discretization.MinLength;
        return m.CutAgrees(0, a, b, ChordalOnly(0.5))
            && m.CutAgrees(0, a, b, ChordalOnly(0.05))
            && m.CutAgrees(0, a, b, ChordalOnly(0.005))
            && m.CutAgrees(0, a, b, ChordalOnly(0.0001))
            && m.CutAgrees(0, a, b, CutCriteria(1.0, 30.0.Degrees, Limit.Unlimited, least))
            && m.CutAgrees(0, a, b, CutCriteria(1.0, 31.0.Degrees, Limit.Unlimited, least))
            && m.CutAgrees(0, a, b, CutCriteria(3.0, 360.0.Degrees, Limit.AtMost(0.1), least))
            && m.CutAgrees(0, a, b, CutCriteria(0.0001, 180.0.Degrees, Limit.Unlimited, 0.2))
            && m.CutAgrees(0, a, b, MeshingOptions.WitnessOptions.Face)
            && m.CutAgrees(0, UvCoordinate(0.0, 0.0), UvCoordinate(0.0, 1.0), CutCriteria(0.01, 15.0.Degrees, Limit.AtMost(0.3), least))
            && m.CutAgrees(0, UvCoordinate(0.0, 0.0), UvCoordinate(0.0, 1.0), CutCriteria(0.01, 15.0.Degrees, Limit.AtMost(0.01), least))
            && m.CutAgrees(0, UvCoordinate(0.0, 0.0), UvCoordinate(Number.Tau, 1.0), ChordalOnly(0.01));
    }

    // The cylinder cases reach every way the search stops: the turn bound of 31 degrees at 12 steps, the
    // one-step cut, the minimum length before the chordal bound is met, a length limit at 4
    // steps, the cap at 64.
    Law_Perf_CutSegmentCountFastStopsEveryWay(_: Boolean): Boolean
    {
        var m = BrepModel.WitnessAt(1);
        var f = BrepFaceIndex(0);
        var a = UvCoordinate(0.0, 0.5);
        var b = UvCoordinate(Number.Tau, 0.5);
        var least = MeshingOptions.WitnessOptions.Face.Discretization.MinLength;
        var turn = m.CutSegmentCountFast(f, a, b, CutCriteria(1.0, 31.0.Degrees, Limit.Unlimited, least));
        var one = m.CutSegmentCountFast(f, a, b, CutCriteria(3.0, 360.0.Degrees, Limit.AtMost(0.1), least));
        var floor = m.CutSegmentCountFast(f, a, b, CutCriteria(0.0001, 180.0.Degrees, Limit.Unlimited, 0.2));
        var length = m.CutSegmentCountFast(f, UvCoordinate(0.0, 0.0), UvCoordinate(0.0, 1.0), CutCriteria(0.01, 15.0.Degrees, Limit.AtMost(0.3), least));
        var cap = m.CutSegmentCountFast(f, a, b, ChordalOnly(0.0001));
        return turn == 12 && one == 1 && floor > 1 && floor < 64 && length == 4 && cap == 64;
    }

    // On the torus (2, 1/2), the sphere, the cone and the B-spline patch: whole periods in u and
    // v and diagonals on the torus, a meridian through both poles and the equator on the sphere,
    // a parallel and a ruling to the apex on the cone, a diagonal and a mid line on the patch.
    Law_Perf_CutSegmentCountFastAgreesOnCurvedFaces(_: Boolean): Boolean
    {
        var torus = BrepModel.WitnessAt(3);
        var sphere = BrepModel.WitnessAt(2);
        var cone = BrepModel.WitnessAt(4);
        var patch = BrepModel.WitnessAt(7);
        var o = MeshingOptions.WitnessOptions.Face;
        return torus.CutAgrees(0, UvCoordinate(0.0, 0.0), UvCoordinate(Number.Tau, 0.0), o)
            && torus.CutAgrees(0, UvCoordinate(0.0, 0.0), UvCoordinate(0.0, Number.Tau), o)
            && torus.CutAgrees(0, UvCoordinate(0.0, 0.0), UvCoordinate(Number.Tau, Number.Tau), ChordalOnly(0.01))
            && torus.CutAgrees(0, UvCoordinate(0.3, 1.0), UvCoordinate(4.0, 5.0), CutCriteria(0.002, 10.0.Degrees, Limit.AtMost(0.4), 0.001))
            && sphere.CutAgrees(0, UvCoordinate(0.5, 0.0 - Number.HalfPi), UvCoordinate(0.5, Number.HalfPi), o)
            && sphere.CutAgrees(0, UvCoordinate(0.0, 0.0), UvCoordinate(Number.Tau, 0.0), ChordalOnly(0.02))
            && cone.CutAgrees(0, UvCoordinate(0.0, 0.0 - 0.5), UvCoordinate(Number.Tau, 0.0 - 0.5), o)
            && cone.CutAgrees(0, UvCoordinate(1.0, 0.0), UvCoordinate(1.0, 0.0 - 1.0), CutCriteria(0.01, 15.0.Degrees, Limit.AtMost(0.25), 0.001))
            && patch.CutAgrees(0, UvCoordinate(0.0, 0.0), UvCoordinate(1.0, 1.0), ChordalOnly(0.0005))
            && patch.CutAgrees(0, UvCoordinate(0.0, 0.5), UvCoordinate(1.0, 0.5), o);
    }

    //==
    // # Count witness

    // The chordal bound under which a whole period of the unit cylinder takes n steps: halfway
    // between the sagitta of n equal steps of the unit circle, 1 - cos(pi / n), and that of
    // n - 1 steps. Precondition: n >= 2.
    CircleChordalFor(n: Integer): Number
        => ((1.0 - (Number.Pi / n.ToNumber).Cos) + (1.0 - (Number.Pi / (n - 1).ToNumber).Cos)) * 0.5;

    // The step count of a cut whose linear search places g grid points: the n with
    // n (n + 3) / 2 = g, the points of the grids of 1, 2, ..., n steps (the least such n when g
    // is not of that form).
    StepsOfGridSize(g: Integer): Integer
    {
        var n = 1;
        while (n * (n + 3) / 2 < g)
        {
            n = n + 1;
        }
        return n;
    }

    // The counted search over a whole period of the unit cylinder at mid height under the
    // chordal bound for n steps.
    CircleCutCounted(n: Integer): Counted<Integer>
        => BrepModel.WitnessAt(1).CutSegmentCountFastCounted(BrepFaceIndex(0), UvCoordinate(0.0, 0.5),
            UvCoordinate(Number.Tau, 0.5), ChordalOnly(CircleChordalFor(n)));

    // The work of the circle cut whose linear search places g grid points.
    CircleCutWork(g: Integer): WorkBudget
        => CircleCutCounted(StepsOfGridSize(g)).Work;

    // The circle cuts of the count witness take the step counts they are built for, and
    // CutSegmentCount agrees, so the witness measures a search of the size it names.
    Law_Perf_CircleCutsTakeTheirSteps(_: Boolean): Boolean
    {
        var m = BrepModel.WitnessAt(1);
        var a = UvCoordinate(0.0, 0.5);
        var b = UvCoordinate(Number.Tau, 0.5);
        return CircleCutCounted(8).Value == 8 && CircleCutCounted(64).Value == 64
            && m.CutAgrees(0, a, b, ChordalOnly(CircleChordalFor(8)))
            && m.CutAgrees(0, a, b, ChordalOnly(CircleChordalFor(64)));
    }

    // CutSegmentCountFast makes at most three surface evaluations (grid points, step midpoints,
    // face normals, as Evaluations) per grid point its linear search places, n (n + 3) / 2 for
    // n steps: sizes 44 and 2112 are n = 8 and n = 64 on a whole period of the unit cylinder.
    // Each try that goes on evaluates the next grid once and, at most, every step's midpoint and
    // its normals once; CutSegmentCount evaluated about seven per grid point (each point three
    // times, every midpoint and two normals per step, every step of every try). The size grows
    // as n squared because the search must try every n (the stopping test is not monotone in n,
    // TRACK.md); a doubling search would place about 4 n points but could return another n.
    Witness_CutSegmentCountFastWork(_: WorkClaim): WorkClaim
        => WorkClaim("CutSegmentCountFast: surface evaluations per grid point of a whole-period cut", Evaluations(3), [44, 2112], g => CircleCutWork(g));
}

//==
// # Catalog: concepts for validation, diffs, traces, and witnesses
//
// TYPE-CATALOG.md section 15: the four concepts this track owns. One concept
// states a law once over every type that implements it.
//
// Sections, in order:
//  - Comparing and checking
//  - Traces and witnesses

//==
// # Comparing and checking

// A value two of which can be compared table by table. Law: a value has no
// difference from itself (SameModelHasNoDifference, over BrepModel).
interface IDiffable
{
    Diff(a: Self, b: Self, tol: Tolerances): ModelDiff;
}

// A value with a validation at a conformance level.
interface ICheckable
{
    Check(x: Self, level: ConformanceLevel): Report;
}

//==
// # Traces and witnesses

// A value that carries the run that made it: every stage outcome, once
// PipelineState holds a Trace (TRACK.md, Contract requests).
interface ITraced
{
    Trace(x: Self): Trace;
}

// A type that names its own witness families, so the runner draws
// constrained values from witnesses (F-54's rejected Invariant_ form, done as
// a concept).
interface IWitnessed
{
    Witnesses(_: Self): Array<WitnessSpec>;
}

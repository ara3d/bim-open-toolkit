//==
// # Catalog: validation, pipeline, and report laws
//
// One statement per law; a leading `? :` guard makes a law vacuously true
// where its precondition fails. The runner cannot build arrays or sums, so
// laws over them take Numbers or Integer selectors and build the value inside.
// Computed Numbers are compared within a recorded error bound or exactly where
// the value is copied, never within a literal epsilon.
//
// Sections, in order:
//  - Helpers
//  - Budgets
//  - Law names and check records
//  - Allowances and oracle agreement
//  - Compensated sums
//  - Scope
//  - Verdicts and levels
//  - Traces
//  - Incremental rounds
//  - Diffs

library CatalogValidationLaws
{
    //==
    // # Helpers

    // One of the six verdict cases, chosen by k (any Integer).
    CatalogVerdictAt(k: Integer): LawVerdictDetail
    {
        var i = (k % 6 + 6) % 6;
        return i == 0 ? LawVerdictDetail.Pass
            : (i == 1 ? LawVerdictDetail.Fail(Evidence.ExactEvidence(false))
            : (i == 2 ? LawVerdictDetail.Error("error")
            : (i == 3 ? LawVerdictDetail.Obligation
            : (i == 4 ? LawVerdictDetail.Skipped("skipped")
            : LawVerdictDetail.OverBudget(ElapsedOf(2001))))));
    }

    // One of the three conformance levels, chosen by k.
    CatalogLevelAt(k: Integer): ConformanceLevel
    {
        var i = (k % 3 + 3) % 3;
        return i == 0 ? ConformanceLevel.Structural
            : (i == 1 ? ConformanceLevel.Geometric : ConformanceLevel.Oracle);
    }

    // One of the seven measure kinds, chosen by k.
    CatalogKindAt(k: Integer): MeasureKind
    {
        var i = (k % 7 + 7) % 7;
        return i == 0 ? MeasureKind.LengthKind
            : (i == 1 ? MeasureKind.AngleKind
            : (i == 2 ? MeasureKind.ParameterKind
            : (i == 3 ? MeasureKind.AreaKind
            : (i == 4 ? MeasureKind.VolumeKind
            : (i == 5 ? MeasureKind.CountKind : MeasureKind.RatioKind)))));
    }

    // A well-ordered trace, one of three by k: a single round, two rounds
    // with discretization events between, and an empty trace.
    CatalogTraceAt(k: Integer): Trace
    {
        var i = (k % 3 + 3) % 3;
        var e = BrepEdgeIndex(0);
        var f = BrepFaceIndex(0);
        var r0 = Round.First;
        var r1 = r0.NextRound;
        return i == 0
            ? Trace([MeshingEvent.EdgeDiscretized(e, SegmentCountOf(4)),
                     MeshingEvent.FaceMeshed(f, CountOf(2), CountOf(0), r0),
                     MeshingEvent.RoundEnded(r0, CountOf(0)),
                     MeshingEvent.Assembled(CountOf(8))])
            : (i == 1
                ? Trace([MeshingEvent.FaceMeshed(f, CountOf(2), CountOf(0), r0),
                         MeshingEvent.RoundEnded(r0, CountOf(1)),
                         MeshingEvent.EdgeRefined(e, SegmentCountOf(4), SegmentCountOf(8), RefinementReason.TooCoarseInParameterSpace),
                         MeshingEvent.FaceMeshed(f, CountOf(4), CountOf(0), r1),
                         MeshingEvent.RoundEnded(r1, CountOf(0)),
                         MeshingEvent.Validated(ConformanceLevel.Geometric, true)])
                : Trace([MeshingEvent.Assembled(CountOf(0))].Take(0)));
    }

    // The unit box, the edges it changes chosen by two selectors.
    CatalogChangedEdges(m: BrepModel, a: Integer, b: Integer): Array<BrepEdgeIndex>
    {
        var n = m.Edges.Count.Max(1);
        return [BrepEdgeIndex((a % n + n) % n), BrepEdgeIndex((b % n + n) % n)];
    }

    //==
    // # Budgets

    // A time budget is never negative.
    Law_Catalog_TimeBudgetIsNonNegative(ms: Integer): Boolean
        => TimeBudgetOf(ms).Milliseconds >= 0;

    // An elapsed time is never negative.
    Law_Catalog_ElapsedIsNonNegative(ms: Integer): Boolean
        => ElapsedOf(ms).Milliseconds >= 0;

    // A run within its budget is within any larger budget.
    Law_Catalog_WithinBudgetIsMonotone(e: Integer, b: Integer, extra: Integer): Boolean
        => ElapsedOf(e).IsWithin(TimeBudgetOf(b))
            ? ElapsedOf(e).IsWithin(TimeBudgetOf(b + extra.Max(0)))
            : true;

    // Every count of a work budget is at least zero.
    Law_Catalog_WorkBudgetIsNonNegative(a: Integer, b: Integer, c: Integer, d: Integer): Boolean
        => WorkBudgetOf(a, b, c, d).TotalWork >= 0;

    // The total of two steps' work is the sum of their totals.
    Law_Catalog_WorkTotalIsAdditive(a: Integer, b: Integer, c: Integer, d: Integer): Boolean
        => Add(WorkBudgetOf(a, b, c, d), WorkBudgetOf(d, c, b, a)).TotalWork
            == WorkBudgetOf(a, b, c, d).TotalWork + WorkBudgetOf(d, c, b, a).TotalWork;

    // Work is within any budget it was added to.
    Law_Catalog_WorkIsWithinItsSum(a: Integer, b: Integer, c: Integer, d: Integer): Boolean
        => WorkBudgetOf(a, b, c, d).IsWithin(Add(WorkBudgetOf(a, b, c, d), WorkBudgetOf(d, c, b, a)));

    //==
    // # Law names and check records

    // A law name keeps the identity's text.
    Law_Catalog_LawNameKeepsId(s: String): Boolean
        => LawNameOf(LawId(s)).Value == s;

    // A check record holds exactly when the check held, for a sampled check.
    Law_Catalog_ToCheckRecordPreservesHolds(worst: Number, bound: Number, k: Integer): Boolean
        => CheckWithin("Law_Any", worst, bound, Provenance.Nowhere)
                .ToCheckRecord(CatalogKindAt(k), SampleCount(2)).Holds
            == CheckWithin("Law_Any", worst, bound, Provenance.Nowhere).Holds;

    // A check record holds exactly when the check held, for an exact check.
    Law_Catalog_ToCheckRecordPreservesExactHolds(holds: Boolean, k: Integer): Boolean
        => CheckExact("Law_Any", holds, Provenance.Nowhere)
                .ToCheckRecord(CatalogKindAt(k), SampleCount(2)).Holds == holds;

    // A check record names the check's law.
    Law_Catalog_ToCheckRecordKeepsLaw(worst: Number, bound: Number): Boolean
        => CheckWithin("Law_Any", worst, bound, Provenance.Nowhere)
                .ToCheckRecord(MeasureKind.LengthKind, SampleCount(2)).Claim.Law.Value == "Law_Any";

    //==
    // # Allowances and oracle agreement

    // A rounding allowance is the count of operations times the resolution.
    Law_Catalog_RoundingAllowanceIsCountTimesResolution(n: Integer, r: Number, k: Integer): Boolean
        => AllowanceFromRounding(CountOf(n), Resolution(r), CatalogKindAt(k)).Value.Value
            == CountOf(n).Value.ToNumber * r;   // exact by construction: the same product

    // A rounding allowance keeps the kind it was made for.
    Law_Catalog_RoundingAllowanceKeepsKind(n: Integer, r: Number, k: Integer): Boolean
        => AllowanceFromRounding(CountOf(n), Resolution(r), CatalogKindAt(k)).Value.Kind == CatalogKindAt(k);

    // Agreement is exactly |mesh - oracle| within the allowance, for one kind.
    Law_Catalog_OracleAgreesIffWithinAllowance(a: Number, b: Number, bound: Number, k: Integer): Boolean
        => OracleAgreementOf(LawNameOf(LawId("Law_Any")), Measure(a, CatalogKindAt(k)), Measure(b, CatalogKindAt(k)),
                AllowanceStated(Measure(bound, CatalogKindAt(k)), "law")).Agree
            == ((a - b).Abs <= bound);

    // A recorded benchmark is met by its own value under a zero allowance.
    Law_Catalog_BenchmarkMeetsItself(x: Number, k: Integer, s: String): Boolean
        => MeetsBenchmark(Measure(x, CatalogKindAt(k)),
            Benchmark(LawNameOf(LawId(s)), Measure(x, CatalogKindAt(k)),
                RunKey("hash", MeshingOptions.WitnessOptions, "commit", "cpu64")),
            AllowanceStated(Measure(0.0, CatalogKindAt(k)), "exact"));

    // Values of two kinds never agree.
    Law_Catalog_OracleOfOtherKindNeverAgrees(a: Number, b: Number, bound: Number, k: Integer): Boolean
        => !OracleAgreementOf(LawNameOf(LawId("Law_Any")), Measure(a, CatalogKindAt(k)), Measure(b, CatalogKindAt(k + 1)),
                AllowanceStated(Measure(bound, CatalogKindAt(k)), "law")).Agree;

    //==
    // # Compensated sums

    // Kahan's sum agrees with layer 6's Neumaier sum within twice the recorded
    // bound: each is within the bound of the exact sum (Neumaier's own bound,
    // 2u |sum| + 2n u^2 (sum of |x|), is no larger).
    Law_Catalog_CompensatedSumAgreesWithLibrary(a: Number, b: Number, c: Number, d: Number): Boolean
    {
        var xs = [a * 1024.0, b, -a * 1024.0, c, d * 0.001, -b];
        var s = CompensatedSumOf(xs);
        return (s.Value - xs.CompensatedSum).Abs <= 2.0 * s.Error;
    }

    // The recorded error bound is never negative.
    Law_Catalog_CompensatedSumErrorIsNonNegative(a: Number, b: Number, c: Number, d: Number): Boolean
        => CompensatedSumOf([a, b, c, d]).Error >= 0.0;

    // The sum records how many terms it added.
    Law_Catalog_CompensatedSumCountsTerms(a: Number, b: Number, c: Number): Boolean
        => CompensatedSumOf([a, b, c]).Terms == 3;

    //==
    // # Scope

    // An all-pairs check runs exactly when the elements fit the budget.
    Law_Catalog_PairScopeRespectsBudget(n: Integer, max: Integer): Boolean
        => ScopeAllows(CheckScope.PerPair, CountOf(n), PairBudgetOf(max)) == (CountOf(n).Value <= PairBudgetOf(max).MaxElements);

    // A per-element check is never limited by the pair budget.
    Law_Catalog_PerElementScopeIsUnlimited(n: Integer, max: Integer): Boolean
        => ScopeAllows(CheckScope.PerElement, CountOf(n), PairBudgetOf(max));

    //==
    // # Verdicts and levels

    // A verdict delta is a change exactly when the two verdicts differ.
    Law_Catalog_VerdictDeltaChangesOnlyWhenVerdictsDiffer(i: Integer, j: Integer): Boolean
        => VerdictDeltaOf(LawNameOf(LawId("Law_Any")), CatalogVerdictAt(i), CatalogVerdictAt(j)).IsChange
            == ((i % 6 + 6) % 6 != (j % 6 + 6) % 6);

    // A positive witness's expectation is met by a pass and by nothing else.
    Law_Catalog_ShouldPassIsMetOnlyByPass(i: Integer): Boolean
        => IsMet(Expectation.ShouldPass, CatalogVerdictAt(i)) == ((i % 6 + 6) % 6 == 0);

    // A negative witness's expectation is never met by a pass: a negative
    // witness that started passing is reported.
    Law_Catalog_ShouldFailIsNotMetByPass(s: String): Boolean
        => !IsMet(Expectation.ShouldFail(LawNameOf(LawId(s))), LawVerdictDetail.Pass);

    // A level's proof proves that level.
    Law_Catalog_LevelProofProvesItsLevel(k: Integer): Boolean
        => LevelProofOf(CatalogLevelAt(k)).Proves(CatalogLevelAt(k));

    // A structural proof does not prove the oracle level.
    Law_Catalog_StructuralProofIsNotOracle(k: Integer): Boolean
        => !LevelProofOf(ConformanceLevel.Structural).Proves(ConformanceLevel.Oracle);

    //==
    // # Traces

    // The rounds of every well-ordered trace never decrease.
    Law_Catalog_TraceRoundsAreMonotone(k: Integer): Boolean
        => CatalogTraceAt(k).RoundsAreMonotone;

    // A trace whose rounds go back is not monotone: the predicate bites.
    Law_Catalog_TraceWithEarlierRoundIsNotMonotone(k: Integer): Boolean
        => !CatalogTraceAt(1).Recorded(MeshingEvent.RoundEnded(Round.First, CountOf(0))).RoundsAreMonotone;

    //==
    // # Incremental rounds

    // No face a round reused cites an edge the round changed.
    Law_Catalog_ReusedFacesTouchNoChangedEdge(a: Integer, b: Integer): Boolean
    {
        var m = BrepModel.Witness_UnitBox;
        var changed = CatalogChangedEdges(m, a, b);
        return m.ReusedTouchNoChangedEdge(m.IncrementalOf(changed), changed);
    }

    // A round reuses or redoes every face, each once.
    Law_Catalog_IncrementalCoversEveryFace(a: Integer, b: Integer): Boolean
    {
        var m = BrepModel.Witness_UnitBox;
        var inc = m.IncrementalOf(CatalogChangedEdges(m, a, b));
        return inc.Reused.Count + inc.Redone.Count == m.Faces.Count;
    }

    //==
    // # Diffs

    // A model has no difference from itself.
    Law_Catalog_SameModelHasNoDifference(k: Integer): Boolean
    {
        var m = (k % 2 + 2) % 2 == 0 ? BrepModel.Witness_UnitBox : BrepModel.Witness_UnitBoxMillimetres;
        return match (Diff(m, m, m.Tolerances)) {
            Same => true;
            Differs(first, count) => false;
        };
    }
}

//==
// # Catalog: claims, evidence, allowances
//
// TYPE-CATALOG.md section 10, layers 0 and 7: what a check asserts, the
// evidence it found, and where every allowance's number came from.
//
// Sections, in order:
//  - Law names
//  - Claims and evidence
//  - Allowances
//  - Compensated sums
//  - Scope and budgets of a check

//==
// # Law names

// The runner's identity of a law: the name a LawRun records. The catalog
// marks LawId as existing in tooling-law-runner.types.plato; it does not
// (LawRun.Law is a String), so it is declared here and only LawIdOf(LawRun)
// builds it (TRACK.md, Contract requests). Removes: a law identity typed by
// hand.
type LawId
    implements IValue
{
    Name: String;
}

// The public form of a law's identity, built only from a LawId
// (LawNameOf), so a Check's law cannot be a typo. Removes: a check that
// names a law no runner knows.
type LawName
    implements IValue
{
    Value: String;
}

//==
// # Claims and evidence

// What is asserted, about what, within what tolerance. Removes: a check
// whose tolerance is implicit.
type Claim
{
    Law: LawName;
    Subject: Provenance;
    Tolerance: Measure;
}

// What a check found. ExactEvidence: an exact law, held or not.
// SampledEvidence: the worst measure over Samples samples, and where.
// OracleEvidence: an expected and an actual value with the allowance between
// them. Removes: Worst = 0, Bound = 0 meaning "exact and held" by convention.
type Evidence
    = ExactEvidence(Holds: Boolean)
    | SampledEvidence(Worst: Measure, At: Provenance, Samples: SampleCount)
    | OracleEvidence(Expected: Measure, Actual: Measure, Allowance: Allowance);

// The catalog's extended Check (a contract request: Check stays as it is):
// a claim, its evidence, and whether it held. Built from a library Check by
// ToCheckRecord. Removes: a check whose evidence kind is guessed from its
// numbers.
type CheckRecord
{
    Claim: Claim;
    Evidence: Evidence;
    Holds: Boolean;
}

//==
// # Allowances

// Where an allowance's number came from. FromModelTolerance: the model's
// length tolerance. FromRounding: Operations roundings of size Resolution.
// FromCriteria: a meshing criterion. FromOracleBound: an oracle law's own
// bound. Stated: a number given with a reason. Removes: the angle-defect
// allowance that ignored the number of additions (F-57 item 1).
type AllowanceSource
    = FromModelTolerance
    | FromRounding(Operations: Integer, Resolution: Resolution)
    | FromCriteria(Criterion: CriterionName)
    | FromOracleBound(Law: LawName)
    | Stated(Why: String);

// An allowance with its derivation. Removes: an allowance nobody can trace
// to a cause.
type Allowance
{
    Value: Measure;
    Derivation: AllowanceSource;
}

//==
// # Compensated sums

// A Kahan sum with its error bound: Value is the compensated sum of Terms
// numbers and differs from the exact sum by at most Error (Higham 4.3).
// Built only by CompensatedSumOf. Removes: a plain sum of thousands of corner
// angles under 32 bits. Invariant: Terms >= 0, Error >= 0.
type CompensatedSum
{
    Value: Number;
    Terms: Integer;
    Error: Number;
}

// One oracle comparison as a record a report can list: the mesh's value,
// the oracle's, the allowance between them, and whether they agree.
// Invariant: Agree is exactly |MeshValue - OracleValue| <= Allowance.
type OracleAgreement
{
    Oracle: LawName;
    MeshValue: Measure;
    OracleValue: Measure;
    Allowance: Allowance;
    Agree: Boolean;
}

//==
// # Scope and budgets of a check

// How a check's cost grows: per element, per pair of elements, or once per
// model. Removes: a quadratic check hidden inside a linear-looking
// validator.
type CheckScope
    = PerElement
    | PerPair
    | WholeModel;

// The largest element count an all-pairs check runs at; above it the check
// is skipped with a diagnostic (F-57 lesson: 100 minutes on a torus).
// Invariant: MaxElements >= 0.
type PairBudget
    implements IValue
{
    MaxElements: Integer;
}

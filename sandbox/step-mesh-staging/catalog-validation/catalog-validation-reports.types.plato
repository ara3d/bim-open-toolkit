//==
// # Catalog: tooling and reports
//
// TYPE-CATALOG.md section 16, layer 9: row dumps, diff summaries, corpus
// rows, and recorded benchmarks.
//
// Sections, in order:
//  - Diffs
//  - Corpus and benchmarks

//==
// # Diffs

// What IDiffable returns: Same, or the first difference with the number of
// differences. The catalog names it without a shape; this is layer 9's
// ModelDiff over any kernel table. Removes: a diff per type with its own
// result shape.
type DecidedDifference
    = NoDifference
    | Different(First: LocatedDifference<ModelTable>, Count: Integer);

// One row of a kernel table as printable cells, so "the developer dumps the
// row" is a function. Removes: a row printed field by field by hand.
type RowDump
{
    Table: TableName;
    Row: Integer;
    Cells: Array<CellValue>;
}

// The first difference and how many there were, in all and per table (one
// Count per ModelTable case, in case order; ModelTable is layer 9's table
// name for diffs, wider than TableName: it adds closures, tolerances, and
// units). Removes: "first only" hiding a renumbering that moved everything.
type DiffSummary
{
    First: LocatedDifference<ModelTable>;
    Count: Integer;
    ByTable: Array<Count>;
}

//==
// # Corpus and benchmarks

// One row of the corpus report with its failing law typed. Removes: the
// "cause" column as free text.
type CorpusRow
{
    File: String;
    Key: RunKey;
    Outcome: MeshOutcome;
    Defects: DefectReport;
    Elapsed: Elapsed;
    Cause: LawName;
}

// A recorded number a law compares against (F-56 item 2's 4.99 degrees),
// with the run it was recorded at. Removes: a magic constant in a law.
type Benchmark
{
    Law: LawName;
    Recorded: Measure;
    At: RunKey;
}

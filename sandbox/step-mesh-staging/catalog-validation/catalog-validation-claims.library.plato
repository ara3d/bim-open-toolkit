//==
// # Catalog: claims, evidence, allowances, and budgets (functions)
//
// The constructors and predicates of 00-foundation/foundation-budgets.types.plato (moved there at the meshing merge),
// catalog-validation-claims.types.plato and
// catalog-validation-witnesses.types.plato.
//
// Sections, in order:
//  - Budgets
//  - Law names
//  - Check records
//  - Allowances
//  - Compensated sums
//  - Oracle agreement and scope
//  - Witnesses and perturbations
//  - Verdicts
//  - Levels

library CatalogValidationClaims
{
    //==
    // # Budgets

    // A time budget of ms milliseconds, at least zero.
    TimeBudgetOf(ms: Integer): TimeBudget
        => TimeBudget(ms.Max(0));

    // An elapsed time of ms milliseconds, at least zero.
    ElapsedOf(ms: Integer): Elapsed
        => Elapsed(ms.Max(0));

    // Order of time budgets by length.
    LessThanOrEquals(a: TimeBudget, b: TimeBudget): Boolean
        => a.Milliseconds <= b.Milliseconds;

    // Order of elapsed times by length.
    LessThanOrEquals(a: Elapsed, b: Elapsed): Boolean
        => a.Milliseconds <= b.Milliseconds;

    // True when a run took no longer than its budget.
    IsWithin(e: Elapsed, b: TimeBudget): Boolean
        => e.Milliseconds <= b.Milliseconds;

    // A work budget with every count clamped to at least zero.
    WorkBudgetOf(evaluations: Integer, insertions: Integer, flips: Integer, projections: Integer): WorkBudget
        => WorkBudget(evaluations.Max(0), insertions.Max(0), flips.Max(0), projections.Max(0));

    // No work.
    NoWork(_: WorkBudget): WorkBudget
        => WorkBudget(0, 0, 0, 0);

    // The work of two steps together, field by field.
    Add(a: WorkBudget, b: WorkBudget): WorkBudget
        => WorkBudget(a.Evaluations + b.Evaluations, a.Insertions + b.Insertions, a.Flips + b.Flips, a.Projections + b.Projections);

    // All the counted work as one number, the termination measure.
    TotalWork(w: WorkBudget): Integer
        => w.Evaluations + w.Insertions + w.Flips + w.Projections;

    // True when no count of used exceeds the same count of limit.
    IsWithin(used: WorkBudget, limit: WorkBudget): Boolean
        => used.Evaluations <= limit.Evaluations
            && used.Insertions <= limit.Insertions
            && used.Flips <= limit.Flips
            && used.Projections <= limit.Projections;

    //==
    // # Law names

    // The identity of the law a run evaluated.
    LawIdOf(run: LawRun): LawId
        => LawId(run.Law);

    // The identity of the law a check evaluated: every Check_ function names
    // its Law_ (SPEC-DSL.md section 2).
    LawIdOf(c: Check): LawId
        => LawId(c.Law);

    // The public name of a law identity.
    LawNameOf(id: LawId): LawName
        => LawName(id.Name);

    //==
    // # Check records

    // A library Check as a claim, its evidence, and whether it held. Check's
    // numbers carry no kind and no sample count (TRACK.md, Contract requests),
    // so the caller, the Check_ function that knows both, supplies them. A
    // check with Bound 0 is exact by layer 0's convention (CheckExact); any
    // other is sampled, its worst measure at Where.
    ToCheckRecord(c: Check, kind: MeasureKind, samples: SampleCount): CheckRecord
        => CheckRecord(
            Claim(LawNameOf(LawIdOf(c)), c.Where, Measure(c.Bound, kind)),
            c.Bound == 0.0   // exact by construction: CheckExact copies 0.0
                ? Evidence.ExactEvidence(c.Holds)
                : Evidence.SampledEvidence(Measure(c.Worst, kind), c.Where, samples),
            c.Holds);

    //==
    // # Allowances

    // The allowance for operations roundings of size resolution: their
    // product, with the derivation recorded (F-57 item 1's fix as data).
    AllowanceFromRounding(operations: Count, resolution: Resolution, kind: MeasureKind): Allowance
        => Allowance(
            Measure(operations.Value.ToNumber * resolution.Value, kind),
            AllowanceSource.FromRounding(operations.Value, resolution));

    // The model's length tolerance as an allowance.
    AllowanceFromModelTolerance(t: Tolerances): Allowance
        => Allowance(Measure(t.Length.Value, MeasureKind.LengthKind), AllowanceSource.FromModelTolerance);

    // A meshing criterion's bound as an allowance.
    AllowanceFromCriteria(bound: Measure, criterion: CriterionName): Allowance
        => Allowance(bound, AllowanceSource.FromCriteria(criterion));

    // An oracle law's own bound as an allowance.
    AllowanceFromOracleBound(bound: Measure, law: LawName): Allowance
        => Allowance(bound, AllowanceSource.FromOracleBound(law));

    // A number given with a reason.
    AllowanceStated(value: Measure, why: String): Allowance
        => Allowance(value, AllowanceSource.Stated(why));

    //==
    // # Compensated sums

    // Kahan's compensated sum of values with its error bound, written beside
    // layer 6's CompensatedSum (Neumaier) as an independent route, so a law
    // can compare the two. The bound is Higham's (4.3) for Kahan summation,
    // (2u + 4 n u^2) times the sum of |x|, u the unit roundoff: the O(n u^2)
    // term written with constant 4.
    CompensatedSumOf(values: Array<Number>): CompensatedSum
    {
        var acc = values.Reduce(Vector2D(0.0, 0.0), (a, x) => a.KahanStep(x));
        var u = Number.RoundingUnit;
        var n = values.Count.ToNumber;
        var magnitude = values.Map(x => x.Abs).SumOf;
        return CompensatedSum(acc.X, values.Count, (2.0 * u + 4.0 * n * u * u) * magnitude);
    }

    // One step of Kahan's summation: X is the running sum, Y the running
    // compensation, the low part lost by the last addition.
    KahanStep(acc: Vector2D, x: Number): Vector2D
    {
        var y = x - acc.Y;
        var t = acc.X + y;
        return Vector2D(t, (t - acc.X) - y);
    }

    //==
    // # Oracle agreement and scope

    // One oracle comparison: the values agree when both have the allowance's
    // kind and differ by no more than it.
    OracleAgreementOf(oracle: LawName, meshValue: Measure, oracleValue: Measure, allowance: Allowance): OracleAgreement
        => OracleAgreement(oracle, meshValue, oracleValue, allowance,
            meshValue.Kind == oracleValue.Kind
                ? IsWithin(Measure((meshValue.Value - oracleValue.Value).Abs, meshValue.Kind), allowance.Value)
                : false);

    // A pair budget of n elements, at least zero.
    PairBudgetOf(n: Integer): PairBudget
        => PairBudget(n.Max(0));

    // True when a check of this scope may run over elements under budget:
    // only an all-pairs check is limited.
    ScopeAllows(scope: CheckScope, elements: Count, budget: PairBudget): Boolean
        => match (scope) {
            PerElement => true;
            PerPair => elements.Value <= budget.MaxElements;
            WholeModel => true;
        };

    //==
    // # Witnesses and perturbations

    // A sample grid over a domain; Checked records that the plan is well
    // formed (at least two samples per direction).
    SampleGridOf(plan: SamplePlan, domain: SurfaceDomain): SampleGrid
        => SampleGrid(plan, domain, plan.IsWellFormed);

    // The specs of layer 9's default witness families, seed 0, no drawn
    // parameters: what BrepModel names for IWitnessed.
    Witnesses(_: BrepModel): Array<WitnessSpec>
        => WitnessFamily.DefaultFamilies.Map(f => WitnessSpec(f, 0, 0.MapRange(i => 0.0)));

    // The law that states what a perturbation keeps (tooling-generators.laws.plato).
    InvarianceOf(p: PerturbationKind): LawName
        => match (p) {
            RigidMotion(motion) => LawNameOf(LawId("Law_MotionKeepsTopologyRows"));
            PowerOfTwoScale(factor) => LawNameOf(LawId("Law_PerturbedShellVolumeFollowsFactor"));
            VertexJitter(within, seed) => LawNameOf(LawId("Law_JitterStaysWithinLengthTolerance"));
        };

    //==
    // # Verdicts

    // The case of a verdict as an ordinal, in declaration order: what a
    // verdict delta compares (payloads are evidence, not the verdict).
    VerdictOrdinal(v: LawVerdictDetail): Integer
        => match (v) {
            Pass => 0;
            Fail(evidence) => 1;
            Error(message) => 2;
            Obligation => 3;
            Skipped(why) => 4;
            OverBudget(elapsed) => 5;
        };

    // True when a verdict is what the witness was built for: a pass for
    // ShouldPass and ShouldWarn (a warning is not a failure), a failure for
    // ShouldFail. Skipped, Error, Obligation and OverBudget meet nothing.
    IsMet(x: Expectation, v: LawVerdictDetail): Boolean
        => match (x) {
            ShouldPass => v.VerdictOrdinal == 0;
            ShouldFail(law) => v.VerdictOrdinal == 1;
            ShouldWarn(code) => v.VerdictOrdinal == 0;
        };

    // True when a measured value matches a recorded benchmark of the same
    // kind within the allowance.
    MeetsBenchmark(measured: Measure, b: Benchmark, allowance: Allowance): Boolean
        => measured.Kind == b.Recorded.Kind
            ? IsWithin(Measure((measured.Value - b.Recorded.Value).Abs, measured.Kind), allowance.Value)
            : false;

    // One law's verdicts in two sweeps.
    VerdictDeltaOf(law: LawName, before: LawVerdictDetail, after: LawVerdictDetail): VerdictDelta
        => VerdictDelta(law, before, after);

    // True when the verdict changed between the sweeps: a different case.
    IsChange(d: VerdictDelta): Boolean
        => d.Before.VerdictOrdinal != d.After.VerdictOrdinal;

    //==
    // # Levels

    // The proof that a validation at level ran: the families level requires,
    // in CheckFamily order.
    LevelProofOf(level: ConformanceLevel): LevelProof
        => LevelProof(level, CheckFamily.AllFamilies.FlatMap(f => level.Requires(f) ? [f] : CheckFamily.AllFamilies.Take(0)));

    // True when the proof's families cover every family level requires.
    Proves(p: LevelProof, level: ConformanceLevel): Boolean
        => CheckFamily.AllFamilies.All(f => level.Requires(f) ? p.Ran.Any(r => r == f) : true);
}

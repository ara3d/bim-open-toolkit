//==
// # Catalog: invariants and constructors of the validation track's types
//
// SPEC-DSL.md section 3. Not compiled; each invariant cites the
// Law_Catalog_ law in catalog-validation.laws.plato that checks it, or is a
// one-line expression whose law form would be a wrapper.
//
// Sections, in order:
//  - Budgets
//  - Law names and check records
//  - Allowances and sums
//  - Scope, verdicts, levels
//  - Traces and rounds

//==
// # Budgets

spec TimeBudget
{
    invariant self.Milliseconds >= 0;   // Law_Catalog_TimeBudgetIsNonNegative
    constructor TimeBudgetOf;
}

spec Elapsed
{
    invariant self.Milliseconds >= 0;   // Law_Catalog_ElapsedIsNonNegative
    constructor ElapsedOf;
}

spec WorkBudget
{
    invariant self.Evaluations >= 0;
    invariant self.Insertions >= 0;
    invariant self.Flips >= 0;
    invariant self.Projections >= 0;   // Law_Catalog_WorkBudgetIsNonNegative
    constructor WorkBudgetOf;
    constructor NoWork;
    constructor Add;                   // Law_Catalog_WorkTotalIsAdditive
}

spec PairBudget
{
    invariant self.MaxElements >= 0;
    constructor PairBudgetOf;
}

//==
// # Law names and check records

spec LawId
{
    constructor LawIdOf;   // from a LawRun or a Check: names a runner knows
}

spec LawName
{
    constructor LawNameOf;   // Law_Catalog_LawNameKeepsId
}

spec CheckRecord
{
    invariant self.Claim.Law.Value != "";
    constructor ToCheckRecord;   // Law_Catalog_ToCheckRecordPreservesHolds, ...ExactHolds, ...KeepsLaw
}

spec ToCheckRecord(c: Check, kind: MeasureKind, samples: SampleCount): CheckRecord
{
    ensures result.Holds == c.Holds;
    ensures result.Claim.Law.Value == c.Law;
    ensures result.Claim.Tolerance.Kind == kind;
}

//==
// # Allowances and sums

spec Allowance
{
    invariant self.Value.Value >= 0.0;
    constructor AllowanceFromRounding;
    constructor AllowanceFromModelTolerance;
    constructor AllowanceFromCriteria;
    constructor AllowanceFromOracleBound;
    constructor AllowanceStated;
}

spec AllowanceFromRounding(operations: Count, resolution: Resolution, kind: MeasureKind): Allowance
{
    requires resolution.Value >= 0.0;
    ensures result.Value.Value == operations.Value.ToNumber * resolution.Value;   // Law_Catalog_RoundingAllowanceIsCountTimesResolution
    ensures result.Value.Kind == kind;                                            // Law_Catalog_RoundingAllowanceKeepsKind
}

spec CompensatedSum
{
    invariant self.Terms >= 0;
    invariant self.Error >= 0.0;   // Law_Catalog_CompensatedSumErrorIsNonNegative
    constructor CompensatedSumOf;
}

spec CompensatedSumOf(values: Array<Number>): CompensatedSum
{
    ensures result.Terms == values.Count;   // Law_Catalog_CompensatedSumCountsTerms
    ensures (result.Value - values.CompensatedSum).Abs <= 2.0 * result.Error;   // Law_Catalog_CompensatedSumAgreesWithLibrary
    measure values.Count;
}

spec OracleAgreement
{
    invariant self.Agree == (self.MeshValue.Kind == self.OracleValue.Kind
        ? IsWithin(Measure((self.MeshValue.Value - self.OracleValue.Value).Abs, self.MeshValue.Kind), self.Allowance.Value)
        : false);   // Law_Catalog_OracleAgreesIffWithinAllowance, Law_Catalog_OracleOfOtherKindNeverAgrees
    constructor OracleAgreementOf;
}

spec SampleGrid
{
    invariant self.Checked == self.Plan.IsWellFormed;
    constructor SampleGridOf;
}

//==
// # Scope, verdicts, levels

spec ScopeAllows(scope: CheckScope, elements: Count, budget: PairBudget): Boolean
{
    ensures scope == CheckScope.PerPair ? result == (elements.Value <= budget.MaxElements) : result;   // Law_Catalog_PairScopeRespectsBudget, Law_Catalog_PerElementScopeIsUnlimited
}

spec VerdictDelta
{
    constructor VerdictDeltaOf;
}

spec IsChange(d: VerdictDelta): Boolean
{
    ensures result == (d.Before.VerdictOrdinal != d.After.VerdictOrdinal);   // Law_Catalog_VerdictDeltaChangesOnlyWhenVerdictsDiffer
}

spec LevelProof
{
    invariant self.Proves(self.Level);   // Law_Catalog_LevelProofProvesItsLevel
    constructor LevelProofOf;
}

//==
// # Traces and rounds

spec Trace
{
    invariant self.RoundsAreMonotone;   // Law_Catalog_TraceRoundsAreMonotone
}

spec Incremental
{
    constructor IncrementalOf;
}

spec IncrementalOf(m: BrepModel, changed: Array<BrepEdgeIndex>): Incremental
{
    ensures m.ReusedTouchNoChangedEdge(result, changed);   // Law_Catalog_ReusedFacesTouchNoChangedEdge
    ensures result.Reused.Count + result.Redone.Count == m.Faces.Count;   // Law_Catalog_IncrementalCoversEveryFace
    measure m.Faces.Count * changed.Count;
}

spec Pending
{
    constructor PendingOf;
}

spec Diff(a: BrepModel, b: BrepModel, tol: Tolerances): DecidedDifference
{
    ensures a == b ? result == DecidedDifference.NoDifference : true;   // Law_Catalog_SameModelHasNoDifference
}

spec DiffSummaryOf(differences: Array<LocatedDifference<ModelTable>>): DiffSummary
{
    requires differences.Count > 0;
    ensures result.Count == differences.Count;
    ensures result.ByTable.Count == ModelTable.ModelTableCount;
}

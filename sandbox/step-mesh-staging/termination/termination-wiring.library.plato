//==
// # TermWiring
//
// Staging only, track "termination" (TKT-346); not merged. Layer 8's loop
// with the merge's wiring applied, so the whole mesh can be checked before
// the merge: DiscretizeAll is DiscretizeAllBounded, Refine refines with
// RefineEdgeBounded, and LoopReport adds DiscretizationFindings. Every other
// function is layer 8's own. After the merge these copies equal layer 8's
// functions and are deleted (TRACK.md, "Merge instructions").
//
// Sections, in order:
//  - The loop, wired

library TermWiring
{
    //==
    // # The loop, wired

    // Layer 4's Refine with RefineEdgeBounded.
    RefineBounded(m: BrepModel, d: EdgeDiscretizations, requests: Array<EdgeRefinementRequest>, c: DiscretizationCriteria): EdgeDiscretizations
        => EdgeDiscretizations(d.ByEdge.Map(old =>
            requests.IsRequested(old.Edge)
                ? m.RefineEdgeBounded(
                    old,
                    c.WithChordal(requests.RequestedChordal(old.Edge, c.Chordal)),
                    requests.RequestedSegments(old.Edge))
                : old));

    // Layer 8's InitialState with DiscretizeAllBounded.
    InitialStateTerm(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>): PipelineState
    {
        var d = m.DiscretizeAllBounded(o.Face.Discretization, SegmentFloors.NoFloors);
        var outcomes = m.Faces.Count.MapRange(k => m.FaceOutcome(BrepFaceIndex(k), d, o, chosen));
        return PipelineState(0, d, SegmentFloors.NoFloors, outcomes, outcomes.RequestsOf(chosen));
    }

    // Layer 8's Step with RefineBounded.
    StepTerm(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>, s: PipelineState): PipelineState
    {
        var d = m.RefineBounded(s.Discretizations, s.Pending, o.Face.Discretization);
        var remeshed = m.FacesTouching(chosen, d.ChangedEdges(s.Discretizations));
        var outcomes = m.Faces.Count.MapRange(k =>
            remeshed[k] ? m.FaceOutcome(BrepFaceIndex(k), d, o, chosen) : s.Outcomes[k]);
        return PipelineState(s.Round + 1, d, m.RaisedFloors(s.Floors, s.Pending), outcomes, outcomes.RequestsOf(remeshed));
    }

    // Layer 8's FinalState over the wired steps.
    FinalStateTerm(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>): PipelineState
    {
        var s = m.InitialStateTerm(o, chosen);
        while (s.Round < o.MaxRefinementRounds ? !s.IsTerminal(o) : false)
        {
            s = m.StepTerm(o, chosen, s);
        }
        return s;
    }

    // Layer 8's LoopReport with the merge's added line.
    LoopReportTerm(m: BrepModel, o: MeshingOptions, chosen: Array<Boolean>, s: PipelineState): Report
        => m.LoopReport(o, chosen, s)
            .Merge(ReportOf(m.DiscretizationFindings(s.Discretizations, o.Face.Discretization)));

    // Layer 8's MeshModel over the wired loop.
    MeshModelTerm(m: BrepModel, o: MeshingOptions): MeshOutcome
    {
        if (m.IsRunnable(o).Not)
        {
            return m.RefusedOutcome(o);
        }
        var chosen = m.AllFaces;
        var s = m.FinalStateTerm(o, chosen);
        var mesh = m.AssembledMesh(s);
        var report = m.LoopReportTerm(o, chosen, s).Merge(m.Validated(mesh, o));
        return MeshOutcomeOf(mesh, report.Located(Provenance.WholeInput), s.Round);
    }
}

//==
// # Catalog: decided results (functions)
//
// Predicates over the sums of catalog-decided-geometry, -refinement and
// -outcomes, the conversions from the existing outcome records to their sum
// forms, and the termination certificate's constructor. CaseNumber gives each
// case of a multi-case sum its position in declaration order, from zero, so
// a law can check that every case round-trips.
//
// Sections, in order:
//  - Reasons
//  - Normals
//  - Projections and closest points
//  - Closure
//  - Splits, insertions, and flips
//  - Termination
//  - Outcomes

library CatalogDecidedResults
{
    //==
    // # Reasons

    // The position of r's case in UndecidedReason, from 0.
    CaseNumber(r: UndecidedReason): Integer
        => match (r) {
            OutOfDomain => 0;
            DegenerateAt(side) => 1;
            NoConvergence(iterations) => 2;
            Unbounded => 3;
            NotApplicable(kind) => 4;
            BelowResolution => 5;
            ToleranceExceeded(by) => 6;
        };

    //==
    // # Normals

    // True when n holds a direction: a regular, limit, or apex normal.
    IsDecided(n: SurfaceNormal): Boolean
        => match (n) {
            Regular(normal) => true;
            Limit(normal) => true;
            Apex(normal) => true;
            NoNormal(reason) => false;
        };

    // The direction n holds, or fallback when there is none.
    ValueOr(n: SurfaceNormal, fallback: Direction3D): Direction3D
        => match (n) {
            Regular(normal) => normal;
            Limit(normal) => normal;
            Apex(normal) => normal;
            NoNormal(reason) => fallback;
        };

    // The position of n's case in SurfaceNormal, from 0.
    CaseNumber(n: SurfaceNormal): Integer
        => match (n) {
            Regular(normal) => 0;
            Limit(normal) => 1;
            Apex(normal) => 2;
            NoNormal(reason) => 3;
        };

    //==
    // # Projections and closest points

    // True when the projection is a perpendicular foot inside the domain.
    IsOnSurface(p: Projection): Boolean
        => match (p) {
            OnSurface(uv, distance) => true;
            OffDomain(nearest, distance) => false;
            Failed(reason) => false;
        };

    // The position of p's case in Projection, from 0.
    CaseNumber(p: Projection): Integer
        => match (p) {
            OnSurface(uv, distance) => 0;
            OffDomain(nearest, distance) => 1;
            Failed(reason) => 2;
        };

    // True when the search found exactly one closest parameter.
    IsFound(r: ClosestParameterResult): Boolean
        => match (r) {
            Found(t, distance) => true;
            Ambiguous(candidates) => false;
            Failed(reason) => false;
        };

    // The position of r's case in ClosestParameterResult, from 0.
    CaseNumber(r: ClosestParameterResult): Integer
        => match (r) {
            Found(t, distance) => 0;
            Ambiguous(candidates) => 1;
            Failed(reason) => 2;
        };

    //==
    // # Closure

    // True when the decision says the curve closes, by its ends or its period.
    ClosesCurve(c: ClosureDecision): Boolean
        => match (c) {
            ClosedByEnds(gap) => true;
            OpenByEnds(gap) => false;
            ClosedByPeriod => true;
            UndecidableWithoutEvaluation => false;
        };

    // True unless closure needs an evaluation to decide.
    IsDecided(c: ClosureDecision): Boolean
        => match (c) {
            ClosedByEnds(gap) => true;
            OpenByEnds(gap) => true;
            ClosedByPeriod => true;
            UndecidableWithoutEvaluation => false;
        };

    // The position of c's case in ClosureDecision, from 0.
    CaseNumber(c: ClosureDecision): Integer
        => match (c) {
            ClosedByEnds(gap) => 0;
            OpenByEnds(gap) => 1;
            ClosedByPeriod => 2;
            UndecidableWithoutEvaluation => 3;
        };

    //==
    // # Splits, insertions, and flips

    // The position of r's case in KeepReason, from 0.
    CaseNumber(r: KeepReason): Integer
        => match (r) {
            MeetsCriteria => 0;
            BelowMinLength => 1;
            AtMinSegments => 2;
            AtRoundLimit => 3;
        };

    // True when the step split the segment.
    IsSplit(d: SplitDecision): Boolean
        => match (d) {
            Split(at) => true;
            KeepBecause(reason) => false;
        };

    // The position of r's case in InsertionRejection, from 0.
    CaseNumber(r: InsertionRejection): Integer
        => match (r) {
            TooCloseTo(point, distance) => 0;
            OnConstraint(side) => 1;
            OutsideRegion => 2;
            WouldCollapse(element) => 3;
        };

    // True when the point was inserted.
    IsInserted(a: InsertionAttempt): Boolean
        => match (a) {
            Inserted(point, flips) => true;
            Rejected(reason) => false;
        };

    // The position of r's case in FlipRejection, from 0.
    CaseNumber(r: FlipRejection): Integer
        => match (r) {
            Constrained => 0;
            NotConvex => 1;
            AlreadyDelaunay => 2;
            Boundary => 3;
        };

    // True when the side was flipped.
    IsFlipped(a: FlipAttempt): Boolean
        => match (a) {
            Flipped(before, after) => true;
            NotFlippable(reason) => false;
        };

    //==
    // # Termination

    // The work a budget counts: the sum of its four counts, a negative count
    // read as zero.
    WorkTotal(w: WorkBudget): Integer
        => w.Evaluations.Max(0) + w.Insertions.Max(0) + w.Flips.Max(0) + w.Projections.Max(0);

    // The certificate of a round that started with the work before and ended
    // with the work after: Decreased exactly when the total fell strictly.
    // The one constructor a refinement round uses.
    CertifyRound(before: WorkBudget, after: WorkBudget): TerminationCertificate
        => TerminationCertificate(after, after.WorkTotal < before.WorkTotal);

    // True when the loop must stop after this round: the work did not
    // decrease, or none is left.
    IsTerminal(c: TerminationCertificate): Boolean
        => c.Decreased ? c.Work.WorkTotal <= 0 : true;

    //==
    // # Outcomes

    // FaceMeshOutcome as a sum: Blocked exactly when a request is blocking
    // (layer 8's HasBlockingRequest), Meshed with the requests as advisories
    // otherwise. Meshed drops the outcome's diagnostics: the catalog's shape
    // has no field for them.
    ToFaceMeshResult(x: FaceMeshOutcome): FaceMeshResult
        => x.HasBlockingRequest
            ? FaceMeshResult.Blocked(x.Requests, x.Diagnostics)
            : FaceMeshResult.Meshed(x.Mesh, x.Requests);

    // True when the face has no mesh.
    IsBlocked(r: FaceMeshResult): Boolean
        => match (r) {
            Meshed(mesh, advisory) => false;
            Blocked(requests, diagnostics) => true;
        };

    // MeshOutcome as a sum: Succeeded when Ok and the proofs track's
    // CheckCheckedMesh builds the CheckedMesh for the model, Failed
    // otherwise. Incomplete is not reachable from the record, which holds no
    // pending requests; the refinement loop builds it.
    ToMeshResult(m: BrepModel, x: MeshOutcome): MeshResult
    {
        var checked = m.CheckCheckedMesh(x.Mesh);
        return x.Ok ? MeshResultOfChecked(checked, x) : MeshResult.Failed(x.Report);
    }

    // Succeeded when the proof was built, Failed when CheckCheckedMesh refused
    // the mesh (then the outcome's Ok was not the mesh's verdict).
    MeshResultOfChecked(checked: DecidedCheckedMesh, x: MeshOutcome): MeshResult
        => match (checked) {
            Decided(value) => MeshResult.Succeeded(value, x.Report, CountOf(x.Rounds));
            Undecided(reason) => MeshResult.Failed(x.Report);
        };

    // True when the run produced a checked mesh.
    IsSucceeded(r: MeshResult): Boolean
        => match (r) {
            Succeeded(mesh, report, rounds) => true;
            Incomplete(mesh, pending, report) => false;
            Failed(report) => false;
        };

    // The position of r's case in MeshResult, from 0.
    CaseNumber(r: MeshResult): Integer
        => match (r) {
            Succeeded(mesh, report, rounds) => 0;
            Incomplete(mesh, pending, report) => 1;
            Failed(report) => 2;
        };

    // DecodedModel as a sum: Decoded when the model has a face; with no face,
    // Unreadable when a diagnostic is an error, NoShape otherwise.
    ToDecodeResult(x: DecodedModel): DecodeResult
        => x.Model.Faces.Count > 0
            ? DecodeResult.Decoded(x)
            : (x.Diagnostics.Any(d => d.Severity.IsError)
                ? DecodeResult.Unreadable(x.Diagnostics)
                : DecodeResult.NoShape(UndecidedReason.NotApplicable("no shape representation")));

    // The position of r's case in DecodeResult, from 0.
    CaseNumber(r: DecodeResult): Integer
        => match (r) {
            Decoded(model) => 0;
            NoShape(reason) => 1;
            Unreadable(diagnostics) => 2;
        };
}

//==
// # Catalog: types borrowed from tracks running beside catalog-decided
//
// Declared here with the catalog's shape so section 5 compiles before
// sections 4 and 10 merge; the supervisor deletes these at merge.
//
// Sections, in order:
//  - Section 4 (proof-carrying types)
//  - Section 10 (validation budgets)

//==
// # Section 4 (proof-carrying types)

// A model mesh that passed the mesh checks: only the checker builds it, so a
// function that needs a checked mesh asks for this type. Minimal shape for
// MeshResult.Succeeded; section 4's owner gives the full one. Removes: a
// mesh used as checked that nobody checked.
type CheckedMesh
    implements IValue
{
    Mesh: ModelMesh;
}

//==
// # Section 10 (validation budgets)

// Counted work: the measure the termination laws decrease. Removes: "slower
// than the old code" with no number.
type WorkBudget
    implements IValue
{
    Evaluations: Integer;
    Insertions: Integer;
    Flips: Integer;
    Projections: Integer;
}

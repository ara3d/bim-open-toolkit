    }

    // DecidedEdgeIndex.Decided for an even k, Undecided otherwise.
    CatalogDecidedEdgeIndexAt(k: Integer, v: BrepEdgeIndex): DecidedEdgeIndex
        => CatalogPicksDecided(k) ? DecidedEdgeIndex.Decided(v) : DecidedEdgeIndex.Undecided(CatalogReasonAt(k / 2));

    // IsDecided holds exactly for the Decided case; ValueOr gives back an edge index
    // stored, or the fallback.
    Law_Catalog_DecidedEdgeIndexRoundTrips(k: Integer, v: BrepEdgeIndex, fallback: BrepEdgeIndex): Boolean
    {
        var d = CatalogDecidedEdgeIndexAt(k, v);
        var x = d.ValueOr(fallback);
        var expected = CatalogPicksDecided(k) ? v : fallback;
        return d.IsDecided == CatalogPicksDecided(k) && x == expected;
    }

    // DecidedRange.Decided for an even k, Undecided otherwise.
    CatalogDecidedRangeAt(k: Integer, v: ParameterRange): DecidedRange
        => CatalogPicksDecided(k) ? DecidedRange.Decided(v) : DecidedRange.Undecided(CatalogReasonAt(k / 2));

    // IsDecided holds exactly for the Decided case; ValueOr gives back a parameter range
    // stored, or the fallback.
    Law_Catalog_DecidedRangeRoundTrips(k: Integer, v: ParameterRange, fallback: ParameterRange): Boolean
    {
        var d = CatalogDecidedRangeAt(k, v);

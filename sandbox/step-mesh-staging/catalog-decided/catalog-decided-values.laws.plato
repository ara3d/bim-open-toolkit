        return d.IsDecided == CatalogPicksDecided(k) && x == expected;
    }

    // DecidedRound.Decided for an even k, Undecided otherwise.
    CatalogDecidedRoundAt(k: Integer, v: Round): DecidedRound
        => CatalogPicksDecided(k) ? DecidedRound.Decided(v) : DecidedRound.Undecided(CatalogReasonAt(k / 2));

    // IsDecided holds exactly for the Decided case; ValueOr gives back a round
    // stored, or the fallback.
    Law_Catalog_DecidedRoundRoundTrips(k: Integer, v: Round, fallback: Round): Boolean
    {
        var d = CatalogDecidedRoundAt(k, v);
        var x = d.ValueOr(fallback);
        var expected = CatalogPicksDecided(k) ? v : fallback;
        return d.IsDecided == CatalogPicksDecided(k) && x == expected;
    }
}

        var d = CatalogDecidedUvAt(k, v);
        var x = d.ValueOr(fallback);
        var expected = CatalogPicksDecided(k) ? v : fallback;
        return d.IsDecided == CatalogPicksDecided(k) && x == expected;
    }

    // DecidedPoint.Decided for an even k, Undecided otherwise.
    CatalogDecidedPointAt(k: Integer, v: ModelPoint): DecidedPoint
        => CatalogPicksDecided(k) ? DecidedPoint.Decided(v) : DecidedPoint.Undecided(CatalogReasonAt(k / 2));

    // IsDecided holds exactly for the Decided case; ValueOr gives back a model point
    // stored, or the fallback.
    Law_Catalog_DecidedPointRoundTrips(k: Integer, v: ModelPoint, fallback: ModelPoint): Boolean
    {
        var d = CatalogDecidedPointAt(k, v);
        var x = d.ValueOr(fallback);
        var expected = CatalogPicksDecided(k) ? v : fallback;
        return d.IsDecided == CatalogPicksDecided(k) && x == expected;
    }

    // DecidedDirection.Decided for an even k, Undecided otherwise.
    CatalogDecidedDirectionAt(k: Integer, v: Direction3D): DecidedDirection
        => CatalogPicksDecided(k) ? DecidedDirection.Decided(v) : DecidedDirection.Undecided(CatalogReasonAt(k / 2));

    // IsDecided holds exactly for the Decided case; ValueOr gives back a direction
    // stored, or the fallback.
    Law_Catalog_DecidedDirectionRoundTrips(k: Integer, v: Direction3D, fallback: Direction3D): Boolean
    {
        var d = CatalogDecidedDirectionAt(k, v);
        var x = d.ValueOr(fallback);
        var expected = CatalogPicksDecided(k) ? v : fallback;
        return d.IsDecided == CatalogPicksDecided(k) && x == expected;
    }

    //==
    // # Indices, ranges, and rounds

    // DecidedFaceIndex.Decided for an even k, Undecided otherwise.
    CatalogDecidedFaceIndexAt(k: Integer, v: BrepFaceIndex): DecidedFaceIndex
        => CatalogPicksDecided(k) ? DecidedFaceIndex.Decided(v) : DecidedFaceIndex.Undecided(CatalogReasonAt(k / 2));

    // IsDecided holds exactly for the Decided case; ValueOr gives back a face index
    // stored, or the fallback.
    Law_Catalog_DecidedFaceIndexRoundTrips(k: Integer, v: BrepFaceIndex, fallback: BrepFaceIndex): Boolean

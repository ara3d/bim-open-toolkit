//==
// # Layer 4 laws over discretized witnesses (complexity sweep, chunk L3)
//
// Five laws of EdgeDiscretizingLaws (discretization.laws.plato) restated over DiscretizedWitness:
// each reads the table the runner built once per sweep and quantifies over its entries, segments
// and seeds inside the body, where the original ran DiscretizeAll (or Discretize, or the whole
// table's Refine) once per index case. The originals drew the criteria and floors at random; the
// restated laws take them from the witness. At merge each Law_Perf_<X> replaces Law_<X>
// (TRACK.md), except the Refine law, which is added beside the original. Two laws are new: the
// table is DiscretizedEntry's, entry by entry (what lets the restated laws read the table where
// the originals called DiscretizedEntry or Discretize), and the table meets Refine's precondition
// under the witness's requests (so the Refine law is not vacuous).
//
// Sections, in order:
//  - The table
//  - Laws restated

library EdgeDiscretizingWitnessLaws
{
    //==
    // # The table

    // Entry e of the witness's table is DiscretizedEntry(e) under its criteria and floors, bit for
    // bit.
    Law_Perf_DiscretizedWitnessIsDiscretizedEntries(w: DiscretizedWitness): Boolean
        => w.Discretizations.ByEdge.Count == w.Model.Edges.Count
            ? w.Model.Edges.Count.Range.All(e => w.Discretizations.ByEdge[e].SameDiscretization(
                w.Model.DiscretizedEntry(BrepEdgeIndex(e), w.Criteria, w.Floors)))
            : false;

    // Under well-formed criteria the witness's table meets Refine's precondition for its own
    // requests (RefinementRequestsOf).
    Law_Perf_DiscretizedWitnessIsRefinable(w: DiscretizedWitness): Boolean
        => w.Criteria.IsWellFormed
            ? w.Model.IsRefinable(w.Discretizations, w.RefinementRequestsOf, w.Criteria)
            : true;

    //==
    // # Laws restated

    // UndiscretizedExactlyWhenUnusable at every entry of the witness's table.
    Law_Perf_UndiscretizedExactlyWhenUnusable(w: DiscretizedWitness): Boolean
        => w.Discretizations.ByEdge.Count.Range.All(i =>
            w.Model.UndiscretizedExactlyWhenUnusable(w.Discretizations, w.Criteria, i));

    // DiscretizationsIndexedByEdge at every entry of the witness's table.
    Law_Perf_DiscretizationsIndexedByEdge(w: DiscretizedWitness): Boolean
        => w.Discretizations.ByEdge.Count.Range.All(i => w.Discretizations.DiscretizationsIndexedByEdge(i));

    // ParametersStrictlyIncreasing at every position of every entry of the witness's table (entry
    // e is DiscretizedEntry(e), Law_Perf_DiscretizedWitnessIsDiscretizedEntries).
    Law_Perf_ParametersStrictlyIncreasing(w: DiscretizedWitness): Boolean
        => w.Discretizations.ByEdge.All(d => d.Parameters.Count.Range.All(i => d.ParametersStrictlyIncreasing(i)));

    // SeedsAreSampled at every seed of every discretized entry of the witness's table: the entry is
    // Discretize's result exactly when CanDiscretize accepts the edge
    // (Law_Perf_UndiscretizedExactlyWhenUnusable, Law_Perf_DiscretizedWitnessIsDiscretizedEntries).
    Law_Perf_SeedsAreSampled(w: DiscretizedWitness): Boolean
        => w.Discretizations.ByEdge.All(d => d.IsDiscretized
            ? (w.Model.IsEdgeEvaluable(d.Edge)
                ? w.Model.EdgeSeeds(d.Edge).Count.Range.All(k => w.Model.SeedsAreSampled(d, k))
                : true)
            : true);

    // Refine never coarsens the witness's table under its requests: every parameter of every entry
    // is still a parameter of the refined entry. One Refine per witness. A law beside
    // Law_RefineNeverCoarsens, not its replacement: Refine's contract (discretization.spec.plato)
    // calls that law with its pointwise signature.
    Law_Perf_RefineNeverCoarsensOnWitnesses(w: DiscretizedWitness): Boolean
    {
        var m = w.Model;
        var d = w.Discretizations;
        var requests = w.RefinementRequestsOf;
        if ((m.Law_IndicesInRange && w.Criteria.IsWellFormed && m.IsRefinable(d, requests, w.Criteria)).Not)
        {
            return true;
        }
        var refined = m.Refine(d, requests, w.Criteria);
        return refined.ByEdge.Count == d.ByEdge.Count
            ? d.ByEdge.Count.Range.All(e => d.ByEdge[e].Parameters.All(t => refined.ByEdge[e].ContainsParameter(t)))
            : false;
    }
}

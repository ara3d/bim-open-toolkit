//==
// # BsplinePipelineLaws over loop runs (complexity sweep, chunk L2)
//
// The laws of bspline-pipeline.laws.plato restated over the loop runs of
// StepToMeshLoopRunWitnesses: the bump patch solid is a CostlyLoopRunWitness, since its loop takes
// 7.7 s compiled and its validation did not finish in minutes at any level (TRACK.md); the
// crescent sheet is a LoopRunWitness, so every law of StepToMeshLoopRunLaws runs over it directly,
// the original Law_ModelLaws, Law_DiagnosticLaws, Law_EdgeLaws and Law_RoundLaws on it included.
// A law about the crescent runs over every LoopRunWitness and states its claim on the one whose
// model is the crescent (SameModel), as chunk L1's laws do. At merge each Law_Perf_<X> replaces
// Law_<X> of BsplinePipelineLaws (TRACK.md).
//
// Sections, in order:
//  - The models
//  - The bump patch solid
//  - The crescent: self-intersecting loops
//  - State laws on every run

library BsplinePipelineLoopRunLaws
{
    //==
    // # The models

    // True when witness w is the bump patch solid with bump 1/2.
    IsBumpSolidRun(w: LoopRunWitness): Boolean
        => w.Model.SameModel(BrepModel.Witness_BSplinePatchSolid(0.5));

    // True when witness w is the crescent sheet.
    IsCrescentRun(w: LoopRunWitness): Boolean
        => w.Model.SameModel(BrepModel.Witness_BsplineCrescentSheet);

    // The witness options with no refinement round allowed.
    NoRoundOptions(_: MeshingOptions): MeshingOptions
        => MeshingOptions.WitnessOptions.WithRounds(0);

    //==
    // # The bump patch solid
    //
    // The bump solid's run is not validated (its Oracle validation did not finish in 9 minutes
    // compiled), so "meshes Ok" is read as "the loop's findings are clean" (LoopReport): the
    // part of MeshModel's report that comes before validation.

    // The bump patch solid meshes in round 0, with no finding of its loop, to a closed,
    // consistently oriented mesh of Euler characteristic 2, and the mesh of its top is within
    // layer 7's area bound: inside the witness's bracket [1, 1 + 16 b^2 / 45]
    // (Law_BSplineTopAreaInBracket) widened by layer 7's FaceAreaTolerance for the options'
    // criteria.
    Law_Perf_BumpSolidMeshesClosedWithinAreaBound(c: CostlyLoopRunWitness): Boolean
    {
        var w = c.Run;
        if (!w.IsBumpSolidRun)
        {
            return true;
        }
        var mesh = w.Mesh;
        var top = BrepFaceIndex(1);
        var slack = w.Model.FaceAreaTolerance(top, MeshingOptions.WitnessOptions.Face);
        var area = mesh.MeshFaceArea(top);
        return w.LoopReportOf.IsClean && w.FinalOf.Round == 0
            && mesh.IsClosed && mesh.IsConsistentlyOriented && mesh.EulerCharacteristic == 2
            && area >= 1.0 - slack && area <= 1.0 + 16.0 * 0.25 / 45.0 + slack;
    }

    // With no refinement round allowed, the bump patch solid meshes the same, with no finding of
    // its loop: none of its faces asks for refinement (its edges are lines and its top's square
    // loop is simple), so a round limit of 0 has nothing to stop. The run takes no step and its
    // initial state leaves nothing pending, so StateAfter returns that state under any round
    // limit, 0 included (InitialState reads the options only through o.Face, which the limit
    // does not change); under the no-round options its loop's findings are clean.
    Law_Perf_BumpSolidNeedsNoRound(c: CostlyLoopRunWitness): Boolean
    {
        var w = c.Run;
        if (!w.IsBumpSolidRun)
        {
            return true;
        }
        var m = w.Model;
        return w.States.Count == 1 && w.States[0].Pending.Count == 0
            && m.LoopReport(MeshingOptions.NoRoundOptions, m.AllFaces, w.States[0]).IsClean;
    }

    // Layer 8's laws over a loop run on the bump solid, read from its one run, in three groups so
    // each has its own verdict and time. The laws that mesh the model again (determinism, edge
    // and shell reversal, current outcomes) are left out: one run of this model takes 7.7 s
    // compiled, beyond a law's budget. Law_MeshedAssemblyValidatesStructurally is left out too:
    // ValidateAssembly at the Structural level took 366 s compiled on this mesh (TRACK.md).

    // The loop and its states: the round limit, an empty face diagnosed, a terminal loop, the step
    // laws, the floors, refinable requests, empty discretizations, failure isolation, and the
    // state laws.
    Law_Perf_BumpSolidLoopLaws(c: CostlyLoopRunWitness): Boolean
    {
        var w = c.Run;
        return Law_Perf_RoundsWithinLimit(w) && Law_Perf_EmptyFaceIsDiagnosed(w) && Law_Perf_LoopEndsTerminal(w)
            && Law_Perf_StepDecreasesMeasure(w) && Law_Perf_MeasureIsNeverNegative(w)
            && Law_Perf_RefinementNeverCoarsens(w) && Law_Perf_OnlyFacesOfChangedEdgesAreRemeshed(w)
            && Law_Perf_FinalDiscretizationsMeetFloors(w) && Law_Perf_PendingRequestsAreRefinable(w)
            && Law_Perf_EmptyDiscretizationExactlyWhenEdgeUnusable(w) && Law_Perf_FailedFaceLeavesOthersUnchanged(w)
            && Law_Perf_StateLaws(w);
    }

    // Watertightness and the mesh's invariants: closed, oriented, and well formed.
    Law_Perf_BumpSolidWatertightLaws(c: CostlyLoopRunWitness): Boolean
    {
        var w = c.Run;
        return Law_Perf_ClosedWhenEveryShellClosedAndNoFaceEmpty(w) && Law_Perf_OrientedWhenEveryShellClosedAndNoFaceEmpty(w)
            && Law_Perf_MeshedMeshIsWellFormed(w);
    }

    // The mesh is clean under layer 7's structural checks of a model mesh: the part of the
    // original Law_BumpSolidPassesWitnessLaws ("validates clean") that finishes compiled, in 0.3 s.
    // Fails on 2026-10-21: ElementIsNotDegenerate at element 1541 (TRACK.md, "Findings").
    Law_Perf_BumpSolidValidatesStructurally(c: CostlyLoopRunWitness): Boolean
        => Law_Perf_MeshedMeshValidatesStructurally(c.Run);

    // The mesh against its model: layers 6 and 7's predicates at every index.
    Law_Perf_BumpSolidMeshAgainstModelLaws(c: CostlyLoopRunWitness): Boolean
    {
        var w = c.Run;
        return Law_Perf_ElementFaceIsModelFace(w) && Law_Perf_CornerProvenanceIsOnItsElementFace(w)
            && Law_Perf_MeshEulerEqualsBrepEuler(w) && Law_Perf_MeshClosedExactlyWhenShellClosed(w)
            && Law_Perf_ProvenanceNamesModelCell(w) && Law_Perf_SolidShellMeshesShareNoVertex(w)
            && Law_Perf_OuterShellVolumePositive(w) && Law_Perf_VoidShellVolumeNegative(w)
            && Law_Perf_VertexReevaluatesFromProvenance(w) && Law_Perf_CornerNormalIsFaceNormal(w)
            && Law_Perf_AngleDefectMatchesBrepEuler(w);
    }

    //==
    // # The crescent: self-intersecting loops

    // The crescent's first polylines cross in the parameter plane, so face meshing asks, for each
    // of its two edges, a LoopSelfIntersects refinement with a chordal bound below the edge's
    // current largest sagitta.
    Law_Perf_CrossingLoopAsksLoopSelfIntersects(w: LoopRunWitness): Boolean
    {
        if (!w.IsCrescentRun)
        {
            return true;
        }
        var m = w.Model;
        var s = w.States[0];
        var requests = s.Outcomes[BrepFaceIndex(0)].Requests;
        return requests.Count == 2
            && requests.All(r => r.Reason.ReasonName == "LoopSelfIntersects"
                && r.Chordal < m.LargestSagitta(s.Discretizations.ByEdge[r.Edge]))
            && requests.Any(r => r.Edge == BrepEdgeIndex(0)) && requests.Any(r => r.Edge == BrepEdgeIndex(1));
    }

    // With no refinement round allowed, the crescent's face stays unresolved: the run is not Ok
    // and reports PIPELINE-FACE-UNRESOLVED at the face. Both are read from the run's loop
    // findings, without its validation: the finding is the loop's (FailureDiagnostics), an Error,
    // and a merged report with a part that is not clean is not clean, so the run is not Ok.
    Law_Perf_NoRoundsLeaveCrossingFaceUnresolved(w: LoopRunWitness): Boolean
    {
        if (!w.IsCrescentRun)
        {
            return true;
        }
        var m = w.Model;
        var o = MeshingOptions.NoRoundOptions;
        var r = m.LoopReport(o, m.AllFaces, m.FinalState(o, m.AllFaces));
        return !r.IsClean
            && r.Diagnostics.Any(d => d.Code == "PIPELINE-FACE-UNRESOLVED" && d.Where == Provenance.KernelFace(BrepFaceIndex(0)));
    }

    //==
    // # State laws on every run

    // The state laws on every state of the loop: each outcome is of its face, and each pending
    // request is a request of some face's outcome.
    Law_Perf_StateLaws(w: LoopRunWitness): Boolean
        => w.States.All(s =>
            s.Outcomes.Count.Range.All(k => Law_OutcomeIsOfItsFace(s, k))
                && s.Pending.Count.Range.All(q => Law_PendingRequestIsInSomeOutcome(s, q)));
}

//==
// # BsplineLocalEvaluation
//
// Chunk I2 of docs/plans/step-mesher-complexity.md (TKT-379), ranked
// candidate 18: a curve evaluation that reads only the p + 1 control points
// of the knot span holding the parameter. BSplinePointBody and
// BSplineDerivativeBody (bspline-evaluation.library.plato) weight every
// control point on each call (HomogeneousControls, O(n) for n control
// points) and look up the span and copy the local values once per order.
// Here the span is found once, the p + 1 local homogeneous values are built
// once, and the point and both derivatives come from them: O(p^2 + log n)
// per evaluation. The arithmetic is the same as the old path's, value for
// value, so results are bit-identical.
//
// Sections, in order:
//  - Shared core
//  - Space curves
//  - Parameter-plane curves

library BsplineLocalEvaluation
{
    //==
    // # Shared core

    // The derivative of the given order (0 the position vector, 1 or 2) at t
    // of the rational curve with basis b, from its p + 1 local homogeneous
    // control values at span k: de Boor and the hodograph on the local
    // values for each order, then the quotient rule.
    LocalCurveDerivative(b: SplineBasis, local: Array<HomogeneousPoint3D>, k: Integer, order: Integer, t: Number): Vector3D
        => RationalDerivative(
            LocalDerivative(local, b.Knots, 0, b.Degree, k, 0, t),
            order >= 1 ? LocalDerivative(local, b.Knots, 0, b.Degree, k, 1, t) : HomogeneousPoint3D.HomogeneousZero,
            order >= 2 ? LocalDerivative(local, b.Knots, 0, b.Degree, k, 2, t) : HomogeneousPoint3D.HomogeneousZero,
            order);

    //==
    // # Space curves

    // The p + 1 homogeneous control values (w_i P_i, w_i), i = k - p .. k,
    // of span k.
    LocalControls(d: BSplineCurveData, k: Integer): Array<HomogeneousPoint3D>
        => (d.Basis.Degree + 1).MapRange(j => d.ControlPoints[k - d.Basis.Degree + j].Weighted(d.Weights[k - d.Basis.Degree + j]));

    // The derivative of the given order (0 the point's position vector, 1
    // or 2) of a space curve at t, from one span lookup and its p + 1 local
    // control values.
    BSplineLocalDerivative(d: BSplineCurveData, order: Integer, t: Number): Vector3D
    {
        var k = d.Basis.SplineSpan(d.ControlPoints.Count, t);
        return LocalCurveDerivative(d.Basis, d.LocalControls(k), k, order, t);
    }

    // BSplineLocalDerivative with the control points it read, as Insertions:
    // p + 1 for every curve, whatever its number of control points.
    BSplineLocalDerivativeCounted(d: BSplineCurveData, order: Integer, t: Number): Counted<Vector3D>
    {
        var k = d.Basis.SplineSpan(d.ControlPoints.Count, t);
        var local = d.LocalControls(k);
        return Counted(LocalCurveDerivative(d.Basis, local, k, order, t), Insertions(local.Count));
    }

    //==
    // # Parameter-plane curves

    // The p + 1 homogeneous control values (w_i u_i, w_i v_i, 0, w_i) of span k.
    LocalControls(d: BSplineCurve2DData, k: Integer): Array<HomogeneousPoint3D>
        => (d.Basis.Degree + 1).MapRange(j => d.ControlPoints[k - d.Basis.Degree + j].Weighted(d.Weights[k - d.Basis.Degree + j]));

    // The derivative of the given order (0 the point as a vector, 1 or 2) of
    // a parameter-plane curve at t, as BSplineLocalDerivative of a space curve.
    BSplineLocalDerivative(d: BSplineCurve2DData, order: Integer, t: Number): Vector2D
    {
        var k = d.Basis.SplineSpan(d.ControlPoints.Count, t);
        var c = LocalCurveDerivative(d.Basis, d.LocalControls(k), k, order, t);
        return Vector2D(c.X, c.Y);
    }
}

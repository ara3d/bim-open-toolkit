//==
// # Model mesh components given: types (complexity sweep, chunk V6)
//
// Sections, in order:
//  - Root tables

//==
// # Root tables

// Two tables over a MeshComponents and the mesh it describes, built in one pass, that let the root
// laws of 06-mesh/mesh-topology.laws.plato be checked at every element in constant time each.
// LowestElement[x] is the lowest element of the mesh whose component is x, -1 when none is, for x
// from 0 up to the table's count (the component count, clamped to [0, element count]); a component
// value outside that range has no entry and is looked up by a scan. RootsBelow[k] is the number of
// roots among the first k entries of ElementParent, for k from 0 to ElementParent.Count, so
// RootsBelow(comps, e) is RootsBelow[e clamped to that range]. Removes: the scan of every element
// per element in Law_ComponentRootIsItsLowestElement's grid and in RootsBelow.
type ComponentRootTables
    implements IValue
{
    LowestElement: Array<Integer>;
    RootsBelow: Array<Integer>;
}

// The tables the component laws read, each built once per mesh: the vertex-to-element incidence,
// the components built over it, the edge table, the per-component counts, the root tables, and the
// two whole-mesh predicates the per-component laws guard on. A report binds one and passes it to
// every component check, so none rebuilds ComponentsOf, EdgeTableOf or ComponentCountsOf per case.
type MeshComponentTables
    implements IValue
{
    Incidence: VertexIncidence;
    Components: MeshComponents;
    Edges: MeshEdgeTable;
    Counts: Array<MeshComponentCounts>;
    Roots: ComponentRootTables;
    MeshIsWellFormed: Boolean;
    CornersAreValid: Boolean;
}

//==
// # Catalog meshing: mesh assembly types (TYPE-CATALOG.md section 9)
//
// Sections, in order:
//  - Corner attributes
//  - Creases
//  - Elements
//  - Boundaries and defects
//  - Slices and provenance

//==
// # Corner attributes

// A per-corner array that knows it is per corner: one value per element corner, indexed by
// CornerIndex (3t + s for triangle t, 3T + 4q + s for quad q). The stdlib's MeshAttribute<T>
// does not serve: its Domain is a value, so a per-vertex array type-checks where a per-corner one
// is wanted. CornerNormalsOf and CornerUvsOf build the catalog's CornerNormals and CornerUvs.
// Removes: a per-vertex array read with a corner index.
type CornerAttribute<T>
{
    PerCorner: Array<T>;
}

//==
// # Creases

// A mesh edge whose two corner normals differ by more than a threshold, with the angle between
// them. The field is Dihedral, not the catalog's Angle: a field Angle: Angle would derive a
// one-parameter function Angle(Crease): Angle, an implicit conversion. Removes: crease detection
// by position in the glTF writer.
type Crease
    implements IValue
{
    Edge: UndirectedEdgeIndex;
    Dihedral: Angle;
}

// The creases of a mesh, one per edge.
type CreaseSet
{
    Creases: Array<Crease>;
}

//==
// # Elements

// Whether an element is a triangle or a quad.
type ElementKind
    = TriangleKind
    | QuadKind;

// What an ElementIndex resolves to: triangle Index of Triangles, quad Index of Quads, or no
// element (an index out of the mesh; the catalog lists two cases, the third makes
// ResolveElement total without a sentinel). Removes: e - T computed at every quad access.
type ElementRef
    = TriangleRef(Index: Integer)
    | QuadRef(Index: Integer)
    | NotAnElement;

// The corners of any element by one match, or none for an index out of the mesh.
type ElementCorners
    = TriangleCorners(A: VertexIndex, B: VertexIndex, C: VertexIndex)
    | QuadCorners(A: VertexIndex, B: VertexIndex, C: VertexIndex, D: VertexIndex)
    | NoCorners;

//==
// # Boundaries and defects

// One boundary cycle of a mesh: its edges in order round the hole. Removes: a repair that
// cannot name the cycle it closes.
type BoundaryCycle
{
    Edges: Array<UndirectedEdgeIndex>;
}

// The boundary cycles of a mesh as a list, not a count. Named BoundaryCycleList because the
// library's BoundaryCycles is a count.
type BoundaryCycleList
{
    Cycles: Array<BoundaryCycle>;
}

// An edge with three or more element sides, with the sides. Removes: "3 non-manifold edges"
// with no way to find them.
type NonManifoldEdge
{
    Edge: UndirectedEdgeIndex;
    Sides: Array<ElementSide>;
}

// A vertex whose link is not one fan, with the number of fans (two or more).
type PinchedVertex
    implements IValue
{
    Vertex: VertexIndex;
    Links: Integer;
}

// An edge whose two sides run the same direction: the elements disagree on orientation.
type MisorientedEdge
    implements IValue
{
    Edge: UndirectedEdgeIndex;
    Sides: ElementSidePair;
}

//==
// # Slices and provenance

// The restriction of a mesh to some faces: the faces and the elements that approximate them.
// The input of per-face oracles.
type MeshSlice
{
    Faces: Array<BrepFaceIndex>;
    Elements: Array<ElementIndex>;
}

// Each vertex's provenance and, per model face, the mesh vertices on it. Removes: a scan of
// every vertex to find a face's.
type ProvenanceIndex
{
    ByVertex: Array<MeshVertexProvenance>;
    ByFace: JaggedArray<VertexIndex>;
}

// Per element: which face, where on it (the centroid of its corner uvs), and which refinement
// round made it (MadeIn, not the catalog's Round: a field Round: Round would be an
// implicit conversion). Removes: a glTF with per-face colour but no way to say which round produced
// the sliver.
type ElementProvenance
    implements IValue
{
    Face: BrepFaceIndex;
    UvCentroid: UvPoint;
    MadeIn: Round;
}

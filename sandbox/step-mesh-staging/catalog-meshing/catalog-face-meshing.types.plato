//==
// # Catalog meshing: face meshing and triangulation types (TYPE-CATALOG.md section 8)
//
// Sections, in order:
//  - Constraints
//  - Incremental triangulation
//  - Ear clipping
//  - Elements in the chart
//  - Refinement
//  - Seams, poles, and lifting
//  - Four-sided regions

//==
// # Constraints

// Where a constraint comes from: segment Slot of loop Loop (Slot is the position of the
// segment's first point in the loop), a seam cut, or a pole run. Removes: a constraint that
// cannot say why it must stay.
type ConstraintSource
    = LoopSegment(Loop: BoundSlot, Slot: Integer)
    | SeamCut
    | PoleRun;

// A segment the triangulation must contain, between two parameter points. Removes: a flip
// across a boundary segment.
type Constraint
    implements IValue
{
    From: UvPointIndex;
    To: UvPointIndex;
    Source: ConstraintSource;
}

// A triangulation of parameter points with the constraints it must contain listed beside it, so
// Law_ConstraintsAreElementSides has something to read.
type ConstrainedTriangulation
{
    Points: Array<UvPoint>;
    Triangles: Array<TriangleFace>;
    Constraints: Array<Constraint>;
}

//==
// # Incremental triangulation

// The hole an insertion opens: its boundary points in order and the elements removed. The data
// Bowyer-Watson re-triangulates. Removes: the neighbour table rebuilt whole per insertion.
type Cavity
{
    Boundary: Array<UvPointIndex>;
    Removed: Array<ElementIndex>;
}

// For each side of each triangle, at 3e + s, the side across it; the none side (element -1,
// side 0) on the boundary. An involution on the sides that have an opposite. Removes: adjacency
// recomputed by sorting at every flip.
type NeighbourTable
{
    Across: Array<ElementSide>;
}

// The result of the empty-circle test over the interior sides: how many were checked and how
// many failed. Kept with the triangulation it certifies.
type DelaunayCertificate
    implements IValue
{
    Checked: Integer;
    Violations: Integer;
}

//==
// # Ear clipping

// A polygon vertex considered as an ear tip, with the sign of its corner (Positive: convex).
type EarCandidate
    implements IValue
{
    Tip: UvPointIndex;
    IsEar: Sign;
}

// The segment joining a hole to the outer ring in ear clipping, made explicit so
// Law_BridgeIsVisible can test it.
type Bridge
    implements IValue
{
    From: UvPointIndex;
    To: UvPointIndex;
}

//==
// # Elements in the chart

// A triangle as the orientation decisions see it: three chart points, its orientation, and its
// signed area. Removes: TwiceSignedArea called on uv points in one place and chart points in
// another.
type ElementInChart
    implements IValue
{
    A: ChartPoint;
    B: ChartPoint;
    C: ChartPoint;
    Orientation: Sign;
    Area: Number;
}

//==
// # Refinement

// The geometric measures of one element against its surface, computed once: chordal distance,
// the turn of the surface normal over it, the mismatch between the element and surface normals,
// and where the chordal worst was sampled.
type ElementDeviation
    implements IValue
{
    Chordal: ModelLength;
    NormalTurn: Angle;
    NormalMismatch: Angle;
    SamplePoint: UvPoint;
}

// What a refinement step chose: split a side, insert a point, or split at the centroid. Removes:
// a fallback chain of flags; it is a match over this sum.
type RefinementTarget
    = SplitSide(Side: ElementSide)
    | InsertAt(Point: UvPoint)
    | SplitAtCentroid(Element: ElementIndex);

//==
// # Seams, poles, and lifting

// Which copy of a seam point a parameter-space point is: near the periodic direction's minimum or
// its maximum.
type SeamCopy
    = NearMin
    | NearMax;

// The two parameter-space copies of one seam point, which lift to one vertex. Known at cut
// time. Removes: Lift's all-pairs identification.
type SeamPair
    implements IValue
{
    Min: UvPointIndex;
    Max: UvPointIndex;
}

// The parameter points of one pole segment, on domain side Pole, which all lift to one vertex.
type PoleRun
{
    Pole: DomainSide;
    Points: Array<UvPointIndex>;
}

// The parameter-point to local-vertex map, built from seam pairs and pole runs, never from
// distances. Built by LiftTableOf.
type LiftTable
{
    LocalVertexOf: Array<LocalVertexIndex>;
}

//==
// # Four-sided regions

// A four-sided region's sides in cyclic order, each running from its first corner to its last:
// Bottom ends where Right starts, and so on round to Left, which ends where Bottom starts.
type QuadGridSides
{
    Bottom: Array<UvPointIndex>;
    Right: Array<UvPointIndex>;
    Top: Array<UvPointIndex>;
    Left: Array<UvPointIndex>;
}

// The segment counts of a structured grid: across (Bottom and Top) and along (Right and Left).
type GridCounts
    implements IValue
{
    Across: SegmentCount;
    Along: SegmentCount;
}

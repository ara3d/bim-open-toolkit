//==
// # Catalog meshing: specification
//
// Invariants and constructors of TYPE-CATALOG.md sections 7, 8, and 9 (SPEC-DSL.md section 3).
// Not compiled. Each invariant names the Law_Catalog_ that checks it, or says it is an
// obligation of a deferred function.
//
// Sections, in order:
//  - Discretization
//  - Face meshing
//  - Mesh assembly

//==
// # Discretization

spec Chord
{
    invariant self.From.Value >= 0;
    invariant self.To.Value == self.From.Value + 1;   // Law_Catalog_ChordsOfAreConsecutive
    constructor ChordOf;
    constructor ChordsOf;
}

spec ArcOf(d: EdgeDiscretization, c: Chord): Arc
{
    requires IsChordOf(c, d.Parameters.Count);
    ensures result.Range.Start <= result.Range.End;   // RangeOf sorts
}

spec ChordMeasures
{
    invariant self.Sagitta.Value >= 0.0 && self.Length.Value >= 0.0;
}

spec CriterionVerdict
{
    invariant self.Holds == IsWithin(self.Worst, self.Bound);   // Law_Catalog_VerdictHoldsIffWithin, Law_Catalog_VerdictAcrossKindsFails
    constructor VerdictOf;
    constructor ChordalVerdict;
    constructor AngularVerdict;
}

spec Seed { invariant self.At.Value.IsFinite; }

spec SegmentDensity { invariant self.SegmentsPerUnitLength >= 0.0; }

spec SegmentsFor(d: SegmentDensity, length: ModelLength): SegmentCount
{
    ensures result.Value >= 1;                                                     // Law_Catalog_SegmentsForIsAtLeastOne
    ensures result.Value.ToNumber >= d.SegmentsPerUnitLength * length.Value;        // Law_Catalog_SegmentsForCoversLength
}

spec RequestSet
{
    invariant forall i in 1..self.ByEdge.Count: self.ByEdge[i - 1].Edge.Value < self.ByEdge[i].Edge.Value;   // Law_Catalog_MergeRequestsIsOnePerEdge
    constructor MergeRequests;
}

spec MergeRequests(xs: Array<EdgeRefinementRequest>): RequestSet
{
    ensures MergeRequests(result.ByEdge) == result;                                // Law_Catalog_MergeRequestsIsIdempotent
    ensures forall r in xs: RequestFor(result, r.Edge)[0].Chordal <= r.Chordal
        && RequestFor(result, r.Edge)[0].Segments >= r.Segments;                   // Law_Catalog_MergeRequestsKeepsStrongest
    ensures forall m in result.ByEdge: exists r in RequestsOn(xs, m.Edge): r.Chordal == m.Chordal;   // Law_Catalog_MergeRequestsInventsNothing
}

spec DiscretizationDelta
{
    invariant forall i in 1..self.Changed.Count: self.Changed[i - 1].Value < self.Changed[i].Value;
    constructor DeltaOf;   // Law_Catalog_DeltaNamesEveryRequestedEdge
}

//==
// # Face meshing

spec ConstrainedTriangulation
{
    invariant ConstraintsAreSides(self);   // Law_Catalog_LoopConstraintsAreSides; Law_Catalog_OtherDiagonalIsNotASide shows the check can fail
    invariant forall t in self.Triangles: t.A.Value < self.Points.Count && t.B.Value < self.Points.Count && t.C.Value < self.Points.Count;
}

spec Cavity
{
    invariant self.Boundary.Count >= 3 || self.Removed.IsEmpty;   // obligation of the deferred insertion body
}

spec NeighbourTable
{
    invariant forall i in 0..self.Across.Count: self.Across[i].Element.IsPresent
        ? AcrossOf(self, self.Across[i]) == SideAtSlot(i) : true;   // Law_Catalog_NeighbourTableIsInvolution, Law_Catalog_NeighbourTableSeesClosure
    constructor NeighbourTableOf;
}

spec DelaunayCertificate
{
    invariant IsConsistent(self);   // Law_Catalog_DelaunayCertificateIsConsistent
}

spec OrientationOf(a: ChartPoint, b: ChartPoint, c: ChartPoint): Sign
{
    ensures result == Sign.Positive ? TwiceSignedArea(a.ToPoint2D, b.ToPoint2D, c.ToPoint2D) > 0.0 : true;   // Law_Catalog_OrientationOfAgreesWithLibrarySign
    ensures result == Sign.Negative ? TwiceSignedArea(a.ToPoint2D, b.ToPoint2D, c.ToPoint2D) < 0.0 : true;
    ensures OrientationOf(a, c, b) == result.Negative;                                                        // Law_Catalog_OrientationIsAntisymmetric
}

spec ElementInChart
{
    invariant self.Orientation == OrientationOf(self.A, self.B, self.C);
    invariant self.Orientation == Sign.Positive ? self.Area > 0.0 : true;   // Law_Catalog_ElementInChartAreaHasItsOrientation
    constructor ElementInChartOf;
}

spec ElementDeviation
{
    invariant self.Chordal.Value >= 0.0 && self.NormalTurn.Radians >= 0.0 && self.NormalMismatch.Radians >= 0.0;
}

spec Worse(a: ElementDeviation, b: ElementDeviation): ElementDeviation
{
    ensures result.Chordal.Value >= a.Chordal.Value && result.Chordal.Value >= b.Chordal.Value;   // Law_Catalog_WorseBoundsBoth
}

spec SeamPair { invariant self.Min != self.Max; }   // Law_Catalog_CopiesAreTheEnds

spec PoleRun { invariant self.Points.Count >= 1; }

spec LiftTable
{
    invariant forall v in 0..LocalVertexCount(self): exists x in self.LocalVertexOf: x.Value == v;   // Law_Catalog_LiftTableJoinsNothingElse
    constructor LiftTableOf;
}

spec LiftTableOf(pointCount: Integer, pairs: Array<SeamPair>, runs: Array<PoleRun>): LiftTable
{
    requires the pairs and runs are pairwise disjoint;
    ensures forall p in pairs: LocalVertexAt(result, p.Min) == LocalVertexAt(result, p.Max);   // Law_Catalog_LiftTableJoinsSeamPairsAndPoles
    ensures forall r in runs: forall q in r.Points: LocalVertexAt(result, q) == LocalVertexAt(result, r.Points[0]);
    ensures LocalVertexCount(result) == pointCount - pairs.Count - SumOf(runs, r => r.Points.Count - 1);   // Law_Catalog_LiftTableJoinsNothingElse
}

spec QuadGridSides
{
    invariant IsStructured(self);   // Law_Catalog_QuadGridSidesRoundTrip
    constructor QuadGridSidesOf;
}

spec GridCounts { constructor GridCountsOf; }

//==
// # Mesh assembly

spec CornerAttribute<T>
{
    invariant IsPerCornerOf(self, the mesh it was read from);   // Law_Catalog_CornerCountIsThreeTPlusFourQ
    constructor CornerNormalsOf;
    constructor CornerUvsOf;
}

spec Crease { invariant self.Dihedral.Radians > 0.0; }

spec ResolveElement(mesh: ModelMesh, e: ElementIndex): ElementRef
{
    ensures match (result) {
        TriangleRef(i) => mesh.IsTriangle(e) && i == e.Value;
        QuadRef(i) => mesh.IsQuad(e) && i == e.Value - mesh.Triangles.Count;
        NotAnElement => !mesh.IsElementInRange(e);
    };   // Law_Catalog_ResolveElementAgreesWithAccessors
}

spec CornersOf(mesh: ModelMesh, e: ElementIndex): ElementCorners
{
    ensures CornerList(result) == mesh.ElementCorners(e);   // Law_Catalog_CornersOfAgreesWithElementCorners, Law_Catalog_CornersOfHasItsKindsCount
}

spec BoundaryCycleListOf(mesh: ModelMesh): BoundaryCycleList
{
    ensures result.Cycles.Count == the library's BoundaryCycles count;   // obligation: deferred
}

spec NonManifoldEdge { invariant IsNonManifold(self); }   // obligation of the deferred NonManifoldEdgesOf
spec PinchedVertex { invariant IsPinched(self); }          // obligation of the deferred PinchedVerticesOf
spec MisorientedEdge { invariant IsTwoSided(self); }       // obligation of the deferred MisorientedEdgesOf

spec MeshSlice
{
    invariant forall e in self.Elements: IsOneOf(mesh.ElementFaceAt(e.Value), self.Faces);   // Law_Catalog_SliceElementsAreOnItsFaces, Law_Catalog_SliceOfAllFacesIsWholeMesh
    constructor SliceOf;
}

spec ProvenanceIndex
{
    invariant self.ByVertex.Count == mesh.Positions.Count;
    invariant forall f: self.ByFace.Row(f) == VerticesOnFace(mesh, f);   // Law_Catalog_ProvenanceIndexListsElementCorners, Law_Catalog_ProvenanceIndexListsNothingElse
    constructor ProvenanceIndexOf;
}

spec ElementProvenance
{
    invariant self.Face == mesh.ElementFace[e];   // Law_Catalog_ElementProvenanceNamesElementFace
    constructor ElementProvenanceOf;
}

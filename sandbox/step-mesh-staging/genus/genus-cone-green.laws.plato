//==
// # Genus track: laws of the cone's Green area on its nappe
//
// The staged forms of layer 7's Law_GreenEqualsConePatchArea and
// Law_WitnessGreenAreaMatchesFacts over FaceAreaByGreenOnNappe, and the law
// that the change leaves every face not on a cone unchanged. After the merge
// of TRACK.md the library's own two laws state the first two.

library GenusConeGreenLaws
{
    // The side of the cone of base radius r and height h has the closed-form
    // area pi r sqrt(r^2 + h^2) by Green's theorem on its nappe.
    Law_Genus_ConeGreenEqualsPatchArea(r: Number, h: Number): Boolean
        => (r > 0.0 && h > 0.0 && r.IsFinite && h.IsFinite)
            ? (BrepModel.Witness_Cone(r, h).FaceAreaByGreenOnNappe(BrepFaceIndex(0))
                    - Oracle_ConePatchArea(r, (r / h).Atan, Angle(Number.Tau), 0.0 - h, 0.0)).Abs
                <= BrepModel.Witness_Cone(r, h).GreenAllowanceOnNappe(BrepFaceIndex(0))
            : true;

    // The Green area on the nappe of face f of witness k is its stated area
    // within the oracle's allowance; vacuous where the facts give no closed
    // form.
    Law_Genus_WitnessGreenAreaMatchesFacts(k: Integer, f: Integer): Boolean
        => (WitnessFacts.FactsAt(k).FaceAreas.IsValidIndex(f) ? WitnessFacts.FactsAt(k).FaceAreas[f].IsFinite : false)
            ? (BrepModel.WitnessAt(k).FaceAreaByGreenOnNappe(BrepFaceIndex(f)) - WitnessFacts.FactsAt(k).FaceAreas[f]).Abs
                <= BrepModel.WitnessAt(k).GreenAllowanceOnNappe(BrepFaceIndex(f))
            : true;

    // On a face whose surface is not a cone the nappe form is the library's
    // Green integral bit for bit: the change reaches cones only. Over the
    // faces whose facts state an area, as the witness law above.
    Law_Genus_GreenOnNappeIsGreenOffCones(k: Integer, f: Integer): Boolean
        => ((WitnessFacts.FactsAt(k).FaceAreas.IsValidIndex(f) ? WitnessFacts.FactsAt(k).FaceAreas[f].IsFinite : false)
                ? BrepModel.WitnessAt(k).Geometry.SurfaceAt(BrepModel.WitnessAt(k).Faces[f].Surface).IsConeSurface.Not
                : false)
            ? BrepModel.WitnessAt(k).RawGreenAreaOnNappe(BrepFaceIndex(f), Integer.GreenChords)
                == BrepModel.WitnessAt(k).RawGreenArea(BrepFaceIndex(f), Integer.GreenChords)   // exact by construction
            : true;
}

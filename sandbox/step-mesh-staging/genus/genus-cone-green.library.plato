//==
// # Genus track: the cone's Green area on its nappe
//
// Staged for layer 7 (07-validation/validation-oracles.library.plato) by the
// genus track of docs/plans/step-mesher-v2.md (TKT-328). The library's
// AreaSegment multiplies the cone's area potential by the sign of the signed
// radius rho = R + v tan a at each segment's middle. On a cone standing on
// its apex the base edge (v = 0) and the seam passes contribute nothing, so
// the whole area is the pole side's at the apex, where rho is 0 and its sign
// is rounding noise: the unit cone's side came out -4.4429 (finding F-55).
// Here the sign is taken once per face, at the boundary point farthest from
// the apex. Merge instructions are in TRACK.md beside this file.
//
// Sections, in order:
//  - The nappe of a face
//  - Green's integral on the nappe

library GenusConeGreen
{
    //==
    // # The nappe of a face

    // The sign of the cone's signed radius over face f: -1 when the face lies
    // on the nappe where rho = R + v tan a is negative, +1 otherwise and on
    // every surface that is not a cone. Read at the boundary point of f's
    // Green boundary where |rho| is largest, so a segment on the apex, where
    // rho is 0, takes its face's nappe. Precondition: m.CanGreen(f).
    FaceNappeSign(m: BrepModel, f: BrepFaceIndex): Number
        => m.Geometry.SurfaceAt(m.Faces[f].Surface).IsConeSurface
            ? m.Geometry.SurfaceAt(m.Faces[f].Surface).NappeSign(m.GreenBoundary(f, Integer.GreenChords))
            : 1.0;

    // NappeSign for one surface record and the segments of a face's boundary.
    NappeSign(surface: BrepSurface, segs: Array<GreenSegment>): Number
        => match (surface)
        {
            Plane(placement) => 1.0;
            Cylinder(placement, radius) => 1.0;
            Cone(placement, radius, semiAngle) => radius.FarthestSignedRadius(semiAngle, segs) < 0.0 ? -1.0 : 1.0;
            Sphere(placement, radius) => 1.0;
            Torus(placement, major, minor, part) => 1.0;
            Revolution(profile, axis) => 1.0;
            LinearExtrusion(profile, extrusion) => 1.0;
            BSpline(data) => 1.0;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => 1.0;
            Offset(basis, distance) => 1.0;
        };

    // The signed radius R + v tan a of largest magnitude over the start points
    // of the segments; 0 when there are none.
    FarthestSignedRadius(radius: Number, semiAngle: Angle, segs: Array<GreenSegment>): Number
        => segs.Reduce(0.0, (best, s) =>
            (radius + s.From.V * semiAngle.Tan).Abs > best.Abs ? radius + s.From.V * semiAngle.Tan : best);

    //==
    // # Green's integral on the nappe

    // AreaSegment with the cone's nappe sign given for the whole face instead
    // of read at each segment's middle: on a cone the integral of
    // -G(v) du = -du (R vm + tan a <v^2> / 2) / cos a, times nappe; every
    // other surface as AreaSegment.
    AreaSegmentOnNappe(surface: BrepSurface, g: GeometrySet, seg: GreenSegment, nappe: Number): Number
        => match (surface)
        {
            Plane(placement) => surface.AreaSegment(g, seg);
            Cylinder(placement, radius) => surface.AreaSegment(g, seg);
            Cone(placement, radius, semiAngle) => ConeAreaSegment(radius, semiAngle, seg) * nappe;
            Sphere(placement, radius) => surface.AreaSegment(g, seg);
            Torus(placement, major, minor, part) => surface.AreaSegment(g, seg);
            Revolution(profile, axis) => surface.AreaSegment(g, seg);
            LinearExtrusion(profile, extrusion) => surface.AreaSegment(g, seg);
            BSpline(data) => surface.AreaSegment(g, seg);
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => surface.AreaSegment(g, seg);
            Offset(basis, distance) => surface.AreaSegment(g, seg);
        };

    // The cone's integral of -G(v) du along a straight segment, unsigned by
    // the nappe: the library's Cone arm of AreaSegment without its sign.
    ConeAreaSegment(radius: Number, semiAngle: Angle, seg: GreenSegment): Number
    {
        var du = seg.To.U - seg.From.U;
        var vm = (seg.From.V + seg.To.V) * 0.5;
        var meanSquare = (seg.From.V * seg.From.V + seg.From.V * seg.To.V + seg.To.V * seg.To.V) / 3.0;
        return 0.0 - du * (radius * vm + semiAngle.Tan * meanSquare * 0.5) / semiAngle.Cos;
    }

    // RawGreenArea on the face's nappe: the signed Green integral of face f's
    // n-chord boundary times FaceNormalSign, each segment by
    // AreaSegmentOnNappe with the face's FaceNappeSign.
    RawGreenAreaOnNappe(m: BrepModel, f: BrepFaceIndex, n: Integer): Number
    {
        var surface = m.Geometry.SurfaceAt(m.Faces[f].Surface);
        var nappe = m.FaceNappeSign(f);
        return m.GreenBoundary(f, n).Map(seg => surface.AreaSegmentOnNappe(m.Geometry, seg, nappe)).SumOf
            * m.FaceNormalSign(f).ToNumber;
    }

    // GreenArea over RawGreenAreaOnNappe, the closed-surface correction as
    // the library's. Staging copy, deleted at merge (TRACK.md).
    GreenAreaOnNappe(m: BrepModel, f: BrepFaceIndex, n: Integer): Number
    {
        var raw = m.RawGreenAreaOnNappe(f, n);
        var total = m.Geometry.SurfaceAt(m.Faces[f].Surface).ClosedSurfaceArea;
        return raw > 0.0 ? raw : (total.IsFinite ? raw + total : raw);
    }

    // Oracle_FaceAreaByGreen over GreenAreaOnNappe. Staging copy, deleted at
    // merge (TRACK.md).
    FaceAreaByGreenOnNappe(m: BrepModel, f: BrepFaceIndex): Number
        => m.CanGreen(f)
            ? Richardson(m.GreenAreaOnNappe(f, Integer.GreenChords), m.GreenAreaOnNappe(f, 2 * Integer.GreenChords))
            : Number.Unmeasured;

    // GreenAllowance over GreenAreaOnNappe. The library's GreenAllowance
    // reads GreenArea, so on a cone it inherits the sign defect: an area near
    // 0 makes its rounding term near 0 too (3.8e-8 on a cone of area 30.8 in
    // 32 bits). Staging copy, deleted at merge (TRACK.md).
    GreenAllowanceOnNappe(m: BrepModel, f: BrepFaceIndex): Number
        => m.CanGreen(f)
            ? (m.GreenAreaOnNappe(f, 2 * Integer.GreenChords) - m.GreenAreaOnNappe(f, Integer.GreenChords)).Abs / 3.0
                + ResolutionAt(m.GreenAreaOnNappe(f, 2 * Integer.GreenChords) * m.GreenBoundary(f, 2 * Integer.GreenChords).Count.ToNumber)
            : Number.Unmeasured;

    // Whether a surface record is a cone.
    IsConeSurface(surface: BrepSurface): Boolean
        => match (surface)
        {
            Plane(placement) => false;
            Cylinder(placement, radius) => false;
            Cone(placement, radius, semiAngle) => true;
            Sphere(placement, radius) => false;
            Torus(placement, major, minor, part) => false;
            Revolution(profile, axis) => false;
            LinearExtrusion(profile, extrusion) => false;
            BSpline(data) => false;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => false;
            Offset(basis, distance) => false;
        };
}

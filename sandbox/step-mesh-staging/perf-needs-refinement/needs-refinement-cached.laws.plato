//==
// # The surface refinement test from cached values: laws (complexity sweep, chunk R2, TKT-384)
//
// NeedsRefinementCached against UvDelaunay's NeedsRefinement on every TriangulatedWitness (the
// 42 faces of layer 5's six sample models, built once per sweep), and the whole refinement with
// it against the witness's refined triangulation; the count witness of one pass on a strip over
// the cylinder's side.
//
// Sections, in order:
//  - The count witness
//  - Agreement

library RefinementTestCachedLaws
{
    //==
    // # The count witness

    // The work of one NeedsRefinementCached pass, every triangle tested, over the constrained
    // Delaunay triangulation of the n-point strip (InsertionBuiltLaws.StripRegion: u from 0 to 1
    // radian, v from 0 to 0.25) on the cylinder's side, face 0 of Witness_Cylinder.
    NeedsRefinementWork(n: Integer): WorkBudget
    {
        var m = BrepModel.Witness_Cylinder;
        var f = BrepFaceIndex(0);
        var r = StripRegion(n);
        var t = r.TriangulateRegionCdt(m.ChartOf(f, r));
        return m.NeedsRefinementCachedCounted(f, r, m.Positioned(f, t), [false].Take(0), TriCriteria(0)).Work;
    }

    // One pass counts as Evaluations every surface evaluation, normal and projection it makes:
    // a normal per corner of a tested triangle (n points), at most four per tested triangle for
    // its corner and centroid tests (n - 2 triangles), and three per side sampled (n - 3 sides
    // inside the strip, each sampled once for its two triangles), at 32 and 128 boundary points.
    // TriangleNeedsRefinement made about 26 per tested triangle (17 evaluations, 4 projections
    // and 5 normals).
    Witness_NeedsRefinementWork(_: WorkClaim): WorkClaim
        => WorkClaim("NeedsRefinementCached: evaluations, normals and projections per tested triangle", Evaluations(8), [32, 128], n => NeedsRefinementWork(n));

    //==
    // # Agreement

    // Whether two mark arrays are equal entry by entry.
    SameMarks(a: Array<Boolean>, b: Array<Boolean>): Boolean
        => a.Count == b.Count ? a.Count.Range.All(i => a[i] == b[i]) : false;

    // Every other triangle of t marked known.
    AlternateKnown(t: UvTriangulation): Array<Boolean>
        => t.Triangles.Count.MapRange(k => k % 2 == 0);

    // NeedsRefinementCached gives NeedsRefinement's verdict on every triangle of the witness's
    // constrained Delaunay triangulation and of its refined triangulation, nothing known, and on
    // the constrained Delaunay triangulation with every other triangle known.
    Law_Perf_NeedsRefinementCachedAgrees(w: TriangulatedWitness): Boolean
    {
        var m = w.Model;
        var f = w.Face;
        var r = w.Region;
        var c = TriCriteria(0);
        var none = [false].Take(0);
        var cdt = m.Positioned(f, w.Cdt);
        var refined = m.Positioned(f, w.Refined);
        return SameMarks(m.NeedsRefinementCached(f, r, cdt, none, c), m.NeedsRefinement(f, r, w.Cdt, none, c))
            && SameMarks(m.NeedsRefinementCached(f, r, refined, none, c), m.NeedsRefinement(f, r, w.Refined, none, c))
            && SameMarks(m.NeedsRefinementCached(f, r, cdt, AlternateKnown(w.Cdt), c), m.NeedsRefinement(f, r, w.Cdt, AlternateKnown(w.Cdt), c));
    }

    // The refinement with NeedsRefinementCached makes the same insertions in the same order: its
    // triangulation is the witness's refined one, point for point and triangle for triangle.
    Law_Perf_RefineCachedAgrees(w: TriangulatedWitness): Boolean
        => SameUvTriangulation(w.Model.RefineToSurfaceByInsertionCached(w.Face, w.Region, w.Chart, w.Cdt, TriCriteria(0)), w.Refined);
}

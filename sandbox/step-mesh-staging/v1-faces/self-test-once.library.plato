//==
// # The self-test checks over tables built once: layer 6 part (F7, TKT-486)
//
// After F6, Witness_CrossHoleMeshed still ran into the 300 s witness cap in the self-test checks
// of ModelMeshReport: each evaluates a layer 6 law at every element corner or listed edge, and
// the law builds EdgeTableOf, ComponentsOf, Reversed, RestrictedToFaces, ToTriangleMesh3D or
// CoincidentVertexPairs again at every sample. Two laws also scan the whole mesh per sample by
// design: ListsEdge reads every listed edge, and SideCountOf and DirectionSumOf every element
// side. This file builds every such value once (SelfTestTablesOf, a MeshSelfTestTables) and
// states each law's body over it:
//  - membership by binary search in a sorted copy (ContainsSorted), the same answer as a scan
//    for any array, sorted or not;
//  - a side count and direction sum over the elements of the edge's first vertex
//    (SideCountIndexed, DirectionSumIndexed): every side on edge p has an end at p.A, so every
//    such element is in p.A's incidence row, once; still independent of the sort that built the
//    edge table. An edge whose first vertex names no position takes the scan.
//
// Sections, in order:
//  - The tables
//  - Membership
//  - Side counts
//  - Law bodies

library SelfTestTablesOnce
{
    //==
    // # The tables

    // The tables of mesh for the self-test checks, under the coincidence tolerance tol.
    SelfTestTablesOf(mesh: ModelMesh, tol: LengthTolerance): MeshSelfTestTables
    {
        var tables = mesh.MeshComponentTablesOf;
        var reversed = mesh.Reversed;
        var firstFaces = mesh.ElementFace.Take(1);
        var wellFormed = mesh.IsWellFormed;
        var pairs = mesh.CoincidentVertexPairs(tables.Components, tol);
        return MeshSelfTestTables(
            tables,
            reversed,
            reversed.EdgeTableOf,
            tables.Edges.Edges.UndirectedEdges.SortedPairs,
            mesh.ToTriangleMesh3D,
            mesh.ToSplitTriangleMesh3D,
            firstFaces,
            wellFormed ? mesh.RestrictedToFaces(firstFaces) : mesh,
            wellFormed ? mesh.ElementsOfFaces(firstFaces) : ElementIndex.NoElements,
            pairs,
            pairs.SortedPairs);
    }

    // No elements: the kept elements of a mesh that is not well formed.
    NoElements(_: ElementIndex): Array<ElementIndex>
        => 0.MapRange(k => ElementIndex(k));

    //==
    // # Membership

    // The pairs in lexicographic order (IsLexicographicallyBefore), repeats kept.
    SortedPairs(pairs: Array<VertexPair>): Array<VertexPair>
        => pairs.Sort((a, b) => !IsLexicographicallyBefore(b, a));

    // Whether p is in the sorted array: pairs.Any(x => x == p) for the array sorted came from.
    // Lexicographic order on (A, B) is total and agrees with ==, so the first entry not before p
    // is p exactly when p is present.
    ContainsSorted(sorted: Array<VertexPair>, p: VertexPair): Boolean
    {
        var lo = 0;
        var hi = sorted.Count;
        while (lo < hi)
        {
            var mid = (lo + hi) / 2;
            if (IsLexicographicallyBefore(sorted[mid], p))
            {
                lo = mid + 1;
            }
            else
            {
                hi = mid;
            }
        }
        return lo < sorted.Count ? sorted[lo] == p : false;
    }

    //==
    // # Side counts

    // Whether vertex index a has an incidence row.
    HasIncidenceRow(incidence: VertexIncidence, a: Integer): Boolean
        => a >= 0 && a < incidence.Offsets.Count - 1;

    // The proper sides of the elements at vertex a, in row order.
    SidesAtVertex(mesh: ModelMesh, incidence: VertexIncidence, a: Integer): Array<VertexPair>
        => incidence.IncidentCount(a).Range.FlatMap(k => mesh.ElementArity(incidence.IncidentElement(a, k))
            .MapRange(s => mesh.ElementSideVertices(incidence.IncidentElement(a, k), s)));

    // SideCountOf(p) for a canonical p, from p.A's incidence row when it has one.
    SideCountIndexed(mesh: ModelMesh, incidence: VertexIncidence, p: VertexPair): Integer
        => incidence.HasIncidenceRow(p.A.Value)
            ? mesh.SidesAtVertex(incidence, p.A.Value).Map(x => x.IsProper ? x.Canonical == p : false).CountTrue
            : mesh.SideCountOf(p);

    // DirectionSumOf(p) for a canonical p, from p.A's incidence row when it has one.
    DirectionSumIndexed(mesh: ModelMesh, incidence: VertexIncidence, p: VertexPair): Integer
        => incidence.HasIncidenceRow(p.A.Value)
            ? mesh.SidesAtVertex(incidence, p.A.Value)
                .Map(x => x.IsProper ? (x == p ? 1 : (x.Canonical == p ? -1 : 0)) : 0).IntegerTotal
            : mesh.DirectionSumOf(p);

    //==
    // # Law bodies
    //
    // Each is the layer 6 law without "In", reading t for the values the law builds.

    ReversalPermutesCornersIn(mesh: ModelMesh, t: MeshSelfTestTables, e: ElementIndex, slot: Integer): Boolean
        => (mesh.IsElementInRange(e) ? (slot >= 0 && slot < mesh.ElementArity(e)) : false)
            ? t.Reversed.ElementCorner(e, slot).Value
                == mesh.ElementCorner(e, ReversedSlot(mesh.ElementArity(e), slot)).Value
            : true;

    ReversalMovesCornerUvWithCornerIn(mesh: ModelMesh, t: MeshSelfTestTables, e: ElementIndex, slot: Integer): Boolean
        => ((mesh.IsElementInRange(e) ? (slot >= 0 && slot < mesh.ElementArity(e)) : false)
                ? mesh.HasValidCornerAttributes(e)
                : false)
            ? t.Reversed.CornerUvAt(e, slot)
                == mesh.CornerUvAt(e, ReversedSlot(mesh.ElementArity(e), slot))   // exact by construction
            : true;

    EdgeTableListsEveryProperSideIn(mesh: ModelMesh, t: MeshSelfTestTables, e: ElementIndex, slot: Integer): Boolean
        => (mesh.IsElementInRange(e) ? (slot >= 0 && slot < mesh.ElementArity(e)) : false)
            ? (mesh.ElementSideVertices(e, slot).IsProper
                ? t.SortedEdges.ContainsSorted(mesh.ElementSideVertices(e, slot).Canonical)
                : true)
            : true;

    EdgeTableCountMatchesItsSidesIn(mesh: ModelMesh, t: MeshSelfTestTables, k: UndirectedEdgeIndex): Boolean
        => t.Tables.Edges.Edges.UndirectedEdges.IsValidIndex(k)
            ? t.Tables.Edges.SidesOn(k) == mesh.SideCountIndexed(t.Tables.Incidence, t.Tables.Edges.Edges.UndirectedEdges[k])
            : true;

    EdgeTableDirectionSumMatchesItsSidesIn(mesh: ModelMesh, t: MeshSelfTestTables, k: UndirectedEdgeIndex): Boolean
        => t.Tables.Edges.Edges.UndirectedEdges.IsValidIndex(k)
            ? t.Tables.Edges.DirectionSumOn(k) == mesh.DirectionSumIndexed(t.Tables.Incidence, t.Tables.Edges.Edges.UndirectedEdges[k])
            : true;

    ReversalNegatesEveryDirectionSumIn(t: MeshSelfTestTables, k: UndirectedEdgeIndex): Boolean
        => t.ReversedEdges.DirectionSumOn(k) == 0 - t.Tables.Edges.DirectionSumOn(k);

    ElementCornersShareItsComponentIn(mesh: ModelMesh, t: MeshSelfTestTables, e: ElementIndex, slot: Integer): Boolean
        => (mesh.IsElementInRange(e) ? (slot >= 0 && slot < mesh.ElementArity(e)) : false)
            ? t.Tables.Components.VertexComponentOf(mesh.ElementCorner(e, slot)).Value
                == t.Tables.Components.ElementComponentOf(e).Value
            : true;

    VectorAreaVanishesIn(mesh: ModelMesh, t: MeshSelfTestTables, c: MeshComponentIndex): Boolean
        => (t.Tables.CornersAreValid && c.CountsIn(t.Tables.Counts).IsClosed && c.CountsIn(t.Tables.Counts).IsConsistentlyOriented)
            ? mesh.ComponentVectorArea(t.Tables.Components, c).Length
                <= ResolutionAt(mesh.VectorAreaRoundingMagnitude(t.Tables.Components, c)).Value
            : true;

    RestrictionKeepsEachCornerIn(mesh: ModelMesh, t: MeshSelfTestTables, k: Integer, slot: Integer): Boolean
        => (t.Tables.MeshIsWellFormed && t.FirstFacesElements.IsValidIndex(k))
            ? t.Restricted.ElementCorner(ElementIndex(k), slot).Value
                == mesh.ElementCorner(t.FirstFacesElements[k], slot).Value
            : true;

    RestrictionKeepsEachElementFaceIn(mesh: ModelMesh, t: MeshSelfTestTables, k: Integer): Boolean
        => (t.Tables.MeshIsWellFormed && t.FirstFacesElements.IsValidIndex(k))
            ? t.Restricted.ElementFaceIs(ElementIndex(k), mesh.ElementFace[t.FirstFacesElements[k]])
            : true;

    // Law_RestrictionKeepsTheElementsOfTheFaces at the face of every element, the law evaluated
    // once per run of elements of one face (elements sorted by face, then index) instead of once
    // per element: the law reads only the face, so each element's verdict is its face's.
    RestrictionKeepsTheElementsOfEachFace(mesh: ModelMesh): Array<Boolean>
    {
        var n = mesh.ElementCount;
        var order = n.Range.Sort((a, b) => mesh.ElementFace[a].Value < mesh.ElementFace[b].Value
            || (mesh.ElementFace[a].Value == mesh.ElementFace[b].Value && a <= b));
        var holds = new Buffer<Boolean>(n);
        var p = 0;
        var current = true;
        while (p < n)
        {
            if (p == 0)
            {
                current = Law_RestrictionKeepsTheElementsOfTheFaces(mesh, [mesh.ElementFace[order[p]]]);
            }
            else
            {
                if (mesh.ElementFace[order[p]].Value != mesh.ElementFace[order[p - 1]].Value)
                {
                    current = Law_RestrictionKeepsTheElementsOfTheFaces(mesh, [mesh.ElementFace[order[p]]]);
                }
            }
            holds = holds.Set(order[p], current);
            p = p + 1;
        }
        return holds.Freeze();
    }

    CoincidentPairIsReportedIn(mesh: ModelMesh, t: MeshSelfTestTables, a: VertexIndex, b: VertexIndex, tol: LengthTolerance): Boolean
        => mesh.IsCoincidentPair(VertexPair(a, b), tol)
            ? t.SortedCoincidentPairs.ContainsSorted(VertexPair(a, b))
            : true;

    ReportedPairIsCoincidentIn(mesh: ModelMesh, t: MeshSelfTestTables, k: Integer, tol: LengthTolerance): Boolean
        => t.CoincidentPairs.IsValidIndex(k) ? mesh.IsCoincidentPair(t.CoincidentPairs[k], tol) : true;

    TriangulatedCornerNamesTheTriangleCornerIn(mesh: ModelMesh, t: MeshSelfTestTables, k: Integer, s: Integer): Boolean
        => (t.Triangles.Faces.IsValidIndex(k) ? (s >= 0 && s < 3) : false)
            ? t.Triangles.Faces[k].At(s).Value == mesh.CornerVertex(mesh.TriangulatedCorner(k, s)).Value
            : true;
}

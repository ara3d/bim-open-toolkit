//==
// # The self-test checks over tables built once: laws (F7, TKT-486)
//
// SelfTestReportOnce gives ModelMeshReport's SelfTestChecks family check for check and
// diagnostic for diagnostic on the four literal meshes of split-once.laws.plato
// (SplitMeshWitnessAt: the unit tetrahedron, its reversal, a smooth tetrahedron, the same with a
// seam), and the two replaced scans agree with theirs: ContainsSorted with Any on random pair
// arrays, the indexed side counts and direction sums with the scans at every listed edge of the
// four meshes.
//
// Sections, in order:
//  - Laws
//  - Helpers

library SelfTestTablesOnceLaws
{
    //==
    // # Laws

    // The report over tables built once is the per-sample report.
    Law_V1Faces_SelfTestReportOnceAgrees(k: Integer): Boolean
    {
        var mesh = ModelMesh.SplitMeshWitnessAt(k);
        var tol = mesh.ResolutionTolerances;
        return mesh.SelfTestReportOnce(tol).IsSameReport(
            mesh.ModelMeshReport(tol, MeshQualityThresholds.CubitAcceptable, CheckFamily.SelfTestChecks));
    }

    // The report's checks are not all vacuous on the four meshes: each has listed edges, and the
    // edge-table checks read them.
    Law_V1Faces_SelfTestTablesAreReal(k: Integer): Boolean
        => ModelMesh.SplitMeshWitnessAt(k).SelfTestTablesOf(ModelMesh.SplitMeshWitnessAt(k).ResolutionTolerances.Length)
            .Tables.Edges.CountEdges == 6;

    // Binary search in the sorted copy answers as the scan does, for any array.
    Law_V1Faces_ContainsSortedIsAny(pairs: Array<VertexPair>, p: VertexPair): Boolean
        => pairs.SortedPairs.ContainsSorted(p) == pairs.Any(x => x == p);

    // The incidence counts give the scans' counts at every listed edge.
    Law_V1Faces_IndexedSideCountsAgree(k: Integer): Boolean
    {
        var mesh = ModelMesh.SplitMeshWitnessAt(k);
        var tables = mesh.MeshComponentTablesOf;
        return tables.Edges.Edges.UndirectedEdges.All(p =>
            mesh.SideCountIndexed(tables.Incidence, p) == mesh.SideCountOf(p)
                && mesh.DirectionSumIndexed(tables.Incidence, p) == mesh.DirectionSumOf(p));
    }

    //==
    // # Helpers

    // Whether two reports have the same checks and diagnostics, in order.
    IsSameReport(a: Report, b: Report): Boolean
        => (a.Checks.Count == b.Checks.Count ? a.Checks.Count.Range.All(i => a.Checks[i] == b.Checks[i]) : false)
            && (a.Diagnostics.Count == b.Diagnostics.Count ? a.Diagnostics.Count.Range.All(i => a.Diagnostics[i] == b.Diagnostics[i]) : false);
}

//==
// # Take's precondition at three more sites (F8b, TKT-509)
//
// Plato's Take(n) requires 0 <= n <= Count. Two laws of 08-pipeline/pipeline-proofs-mesh-witness
// take o.Take(3) of every knock-out of a FaceOutcomesWitness, safe only while the runner draws the
// unit box's six outcomes; the patch (take-guards.patch) gives both a premise of three outcomes,
// and the laws below run them on a witness with two. WholePoleSegment
// (05-face-meshing/pole-segments.library.plato) takes samples.Take(samples.Count - 1) of
// PoleSegmentSamplesAtLeast(..., 3), which returns n + 1 samples with n at least 3, so the count is
// at least 4 on every input and Take(-1) cannot happen there; the law below states that
// precondition on the extents nearest to failing (zero, tiny, negative, not a number), so a change
// of the least count or of PoleStepCount that breaks it fails a law instead of the meshing path.
//
// Sections, in order:
//  - Cases
//  - Laws

library TakeGuardLaws
{
    //==
    // # Cases

    // The unit box's face outcomes, cut to its first two faces: fewer outcomes than the three
    // faces CheckMeshedFaceSet is asked about. Not a Witness_: the runner would add it to every law
    // over FaceOutcomesWitness.
    TwoFaceOutcomesCase(_: FaceOutcomesWitness): FaceOutcomesWitness
    {
        var box = FaceOutcomesWitness.Witness_UnitBoxFaceOutcomes;
        return FaceOutcomesWitness(box.Discretized, box.Outcomes.Take(2));
    }

    // An extent of a pole segment chosen by k: zero, tiny, negative, one turn, not a number.
    PoleExtentAt(k: Integer): Number
    {
        var i = ((k % 5) + 5) % 5;
        return i == 0 ? 0.0 : (i == 1 ? 1e-300 : (i == 2 ? -1.0 : (i == 3 ? Number.TwoPi : 0.0 / 0.0)));
    }

    //==
    // # Laws

    // The two Take(3) laws hold, vacuously, on a witness with two outcomes (they threw before the
    // premise).
    Law_V1Faces_MeshedFaceSetLawsOnTwoOutcomes(_: Integer): Boolean
        => Law_MeshedFaceSetIffFacesMeshed(FaceOutcomesWitness.TwoFaceOutcomesCase)
            && Law_MeshedFaceSetPairsFaces(FaceOutcomesWitness.TwoFaceOutcomesCase);

    // WholePoleSegment's samples, from PoleSegmentSamplesAtLeast with least 3, number at least 4,
    // so samples.Take(samples.Count - 1) is in range, whatever the extent.
    Law_V1Faces_WholePoleSegmentSamplesHaveALast(k: Integer): Boolean
        => UvCoordinate(0.0, 0.0).PoleSegmentSamplesAtLeast(SurfaceParameter.ParameterU, 0.0, PoleExtentAt(k),
            UvPointSource.Interior, MeshingOptions.WitnessOptions.Face, 3).Count >= 4;
}

//==
// # The split checks with one split mesh (F6, TKT-486): layer 7 part
//
// Each Check_SplitXIn is layer 7's Check_SplitX with the split mesh given: the same law name, the
// same samples, the same provenance, and so the same Check. Where the mesh is not well formed
// every law here is vacuous, so the per-sample fold is NoSampleCheck, which is what these return
// there. SplitSelfTestReport builds the split mesh once for all ten, with the messages of
// ModelMeshReport's SelfTestChecks.
//
// Sections, in order:
//  - Checks
//  - Report

library SplitChecksOnce
{
    //==
    // # Checks

    Check_SplitHasAtLeastAsManyVerticesIn(mesh: ModelMesh, split: SplitTriangleMesh3D): Check
        => CheckOnce("Law_SplitHasAtLeastAsManyVertices", mesh.IsWellFormed ? mesh.SplitHasAtLeastAsManyVerticesIn(split) : true);

    Check_SplitSplitsEachQuadInTwoIn(mesh: ModelMesh, split: SplitTriangleMesh3D): Check
        => CheckOnce("Law_SplitSplitsEachQuadInTwo", mesh.IsWellFormed ? mesh.SplitSplitsEachQuadInTwoIn(split) : true);

    Check_SplitHasOneNormalPerVertexIn(mesh: ModelMesh, split: SplitTriangleMesh3D): Check
        => CheckOnce("Law_SplitHasOneNormalPerVertex", mesh.IsWellFormed ? split.SplitHasOneNormalPerVertexIn : true);

    Check_SplitHasOneUvPerVertexIn(mesh: ModelMesh, split: SplitTriangleMesh3D): Check
        => CheckOnce("Law_SplitHasOneUvPerVertex", mesh.IsWellFormed ? split.SplitHasOneUvPerVertexIn : true);

    Check_SplitHasOneSourcePerVertexIn(mesh: ModelMesh, split: SplitTriangleMesh3D): Check
        => CheckOnce("Law_SplitHasOneSourcePerVertex", mesh.IsWellFormed ? split.SplitHasOneSourcePerVertexIn : true);

    Check_SplitVertexKeepsItsSourcePositionIn(mesh: ModelMesh, split: SplitTriangleMesh3D): Check
        => mesh.IsWellFormed
            ? CheckAll("Law_SplitVertexKeepsItsSourcePosition", split.Mesh.Positions.Count,
                v => mesh.SplitVertexKeepsItsSourcePositionIn(split, VertexIndex(v)), v => Provenance.WholeInput)
            : NoSampleCheck("Law_SplitVertexKeepsItsSourcePosition");

    Check_SplitFollowsTheTriangulationIn(mesh: ModelMesh, split: SplitTriangleMesh3D): Check
        => mesh.IsWellFormed
            ? CheckGrid("Law_SplitFollowsTheTriangulation", split.Mesh.Faces.Count, 3,
                (k, s) => mesh.SplitFollowsTheTriangulationIn(split, k, s), (k, s) => Provenance.WholeInput)
            : NoSampleCheck("Law_SplitFollowsTheTriangulation");

    Check_SplitVertexCarriesItsCornerNormalIn(mesh: ModelMesh, split: SplitTriangleMesh3D): Check
        => mesh.IsWellFormed
            ? CheckGrid("Law_SplitVertexCarriesItsCornerNormal", split.Mesh.Faces.Count, 3,
                (k, s) => mesh.SplitVertexCarriesItsCornerNormalIn(split, k, s), (k, s) => Provenance.WholeInput)
            : NoSampleCheck("Law_SplitVertexCarriesItsCornerNormal");

    Check_SplitVertexCarriesItsCornerUvIn(mesh: ModelMesh, split: SplitTriangleMesh3D): Check
        => mesh.IsWellFormed
            ? CheckGrid("Law_SplitVertexCarriesItsCornerUv", split.Mesh.Faces.Count, 3,
                (k, s) => mesh.SplitVertexCarriesItsCornerUvIn(split, k, s), (k, s) => Provenance.WholeInput)
            : NoSampleCheck("Law_SplitVertexCarriesItsCornerUv");

    // One sample per sorted split vertex (RecordsBySource) instead of one per pair: the fold is
    // NoSampleCheck when every pair holds and the whole input's failing CheckExact otherwise,
    // as the pairwise fold is.
    Check_SplitVerticesDifferIn(mesh: ModelMesh, split: SplitTriangleMesh3D): Check
    {
        var order = split.RecordsBySource;
        return mesh.IsWellFormed
            ? CheckAll("Law_SplitVerticesDiffer", order.Count,
                j => split.DiffersFromLaterOfItsSource(order, j), j => Provenance.WholeInput)
            : NoSampleCheck("Law_SplitVerticesDiffer");
    }

    //==
    // # Report

    // The ten split entries of ModelMeshReport's SelfTestChecks, the split mesh built once.
    SplitSelfTestReport(mesh: ModelMesh): Report
    {
        var split = mesh.ToSplitTriangleMesh3D;
        return MergeAll([
            ExactReport(mesh.Check_SplitHasAtLeastAsManyVerticesIn(split),
                "Split has at least as many vertices does not hold."),
            ExactReport(mesh.Check_SplitSplitsEachQuadInTwoIn(split),
                "Split splits each quad in two does not hold."),
            ExactReport(mesh.Check_SplitHasOneNormalPerVertexIn(split),
                "Split has one normal per vertex does not hold."),
            ExactReport(mesh.Check_SplitHasOneUvPerVertexIn(split),
                "Split has one uv per vertex does not hold."),
            ExactReport(mesh.Check_SplitHasOneSourcePerVertexIn(split),
                "Split has one source per vertex does not hold."),
            ExactReport(mesh.Check_SplitVertexKeepsItsSourcePositionIn(split),
                "Split vertex keeps its source position does not hold."),
            ExactReport(mesh.Check_SplitFollowsTheTriangulationIn(split),
                "Split follows the triangulation does not hold."),
            ExactReport(mesh.Check_SplitVertexCarriesItsCornerNormalIn(split),
                "Split vertex carries its corner normal does not hold."),
            ExactReport(mesh.Check_SplitVertexCarriesItsCornerUvIn(split),
                "Split vertex carries its corner uv does not hold."),
            ExactReport(mesh.Check_SplitVerticesDifferIn(split),
                "Split vertices differ does not hold.")]);
    }
}

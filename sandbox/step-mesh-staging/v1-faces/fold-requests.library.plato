//==
// # A fold against a boundary segment asks for a finer edge (TKT-459 follow-up, P2)
//
// Refinement splits a folded triangle by inserting points inside the face, but a boundary segment
// is locked, and an inserted point must stay the effective minimum length from the corners it
// joins. On a strip narrower than the edge's segments are long, that leaves folds: on
// SHO/c211_case_with_odin_v1.step's B-spline strips (0.2 mm wide, boundary segments about 5 mm
// long under a 1 mm chordal bound) 21 long thin triangles lie across a stretch that bends by more
// than the strip is wide, and wind against the face normal although every corner lies on the
// surface. Only a finer edge helps. FoldRequestsOf asks, for every drawn triangle that folds when
// lifted (LiftsFacingFaceNormal false) and has a side on a model edge's discretization, for that
// edge to be split into twice as many segments (FoldAgainstBoundary). The request does not withhold
// the face's mesh (IsBlocking false), so a fold the rounds cannot resolve is kept rather than lost;
// the host's loop answers it (IsAnsweredByHost) as it answers blocking requests.
//
// Sections, in order:
//  - Requests
//  - The host's loop

library FaceMeshingFoldRequests
{
    //==
    // # Requests

    // The FoldAgainstBoundary requests of triangulation t of face f, its edges discretized as d:
    // one per model edge with a segment that is a side of a drawn triangle (not collapsed at a
    // pole) folding when lifted, asking for twice the edge's segments at the criteria's chordal.
    FoldRequestsOf(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, t: UvTriangulation, c: FaceMeshingCriteria): Array<EdgeRefinementRequest>
    {
        var edges = m.FaceEdges(f);
        var folded = t.Triangles.Count.Range.FlatMap(k =>
            t.IsCollapsedElement(ElementIndex(k)) ? [k].Take(0)
            : (m.LiftsFacingFaceNormal(f, t, ElementIndex(k)) ? [k].Take(0) : [k]));
        var hit = folded.FlatMap(k => 3.MapRange(j => j).FlatMap(j => edges.FlatMap(e =>
            m.IsDiscretizationSegment(d, e, t.Sources[t.Triangles[k].Corner(j)], t.Sources[t.Triangles[k].Corner(j + 1)]) ? [e] : edges.Take(0))));
        return edges.FlatMap(e => hit.Any(h => h == e)
            ? [EdgeRefinementRequest(e, RefinementReason.FoldAgainstBoundary, c.Discretization.Chordal, 2 * (d.ByEdge[e].Points.Count - 1).Max(1))]
            : EdgeRefinementRequest.NoRequests);
    }

    // The diagnostic that accompanies a FoldAgainstBoundary request (RequestDiagnostic's case).
    FoldRequestDiagnostic(q: EdgeRefinementRequest): Diagnostic
        => Diagnostic(Severity.Warning, "FACE-FOLD-AGAINST-BOUNDARY",
            "A triangle of a face folds against a boundary segment of this edge that refinement inside the face cannot split; the face is meshed and the edge is asked for twice as many segments.",
            Provenance.KernelEdge(q.Edge), q.Chordal);

    //==
    // # The host's loop

    // Whether the host's loop answers a request with the reason: a blocking one, or a fold against
    // a boundary segment, which keeps its mesh but needs a finer edge.
    IsAnsweredByHost(reason: RefinementReason): Boolean
        => reason.IsBlocking || reason.ReasonName == "FoldAgainstBoundary";
}

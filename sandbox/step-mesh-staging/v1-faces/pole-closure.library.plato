//==
// # A loop through a pole closes in the plane (TKT-411)
//
// A loop that reaches a collapsed line (a sphere's pole, a cone's apex) arrives along one value of
// the line's free parameter and leaves along another; ExpandedPoles fills the gap with the pole
// segment between them. Unwrap places the leaving point next to the pole point, which carries the
// arriving value, so it picks the copy of the leaving value nearest the arriving one: right for a
// lune narrower than half a period, a coin toss at half a period, and a period off when wider. The
// loop then winds once round the free parameter, a band without its partner, and the region code
// indexes past its loops (CEL/LENA-R8.STEP faces 202 to 205, polar lunes of half a turn: 30 faces
// of the 2026-10-21 corpus run threw ArgumentOutOfRangeException). A loop through a pole cannot
// wind round that pole's free parameter, since the pole segment closes it in the plane, so the
// leaving value is the copy that leaves the loop unwound: every point after the first interior
// pole point moves by the whole periods the loop would wind once its poles are expanded.
//
// The loop that winds then reached IsBandPair, whose `&&` chain indexes winding[1] when only one
// loop winds (the operator does not guard what follows it); IsBandPairGuarded tests the count
// before it reads a second entry, so a single winding loop that is no band reaches
// CutWholePeriods instead of throwing.
//
// ExpandedPoint expands a pole only when the arriving and leaving values differ by more than the
// point tolerance along the free parameter. At a pole that tolerance is its cap, half the period,
// since the parameter there has no length; so a lune of half a turn or less (LENA-R8's) kept its
// pole as one point, and its region ran diagonally from the pole to the second meridian, leaving
// part of the polar wedge uncovered. PoleGapTolerance is the parameter's floor instead: two
// values a pole cannot tell apart are those the parameter itself cannot.
//
// Sections, in order:
//  - Closing at a pole
//  - Band pairs
//  - Expanding a pole

library FaceMeshingPoleClosure
{
    //==
    // # Closing at a pole

    // Unwrapped loop l of face f, in its surface domain dom, with each free parameter of a
    // collapsed line made to close: unchanged when the loop has no interior point on such a line,
    // or already does not wind in that parameter once its poles are expanded (ExpandedWinding).
    ClosedAtPole(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, l: UvLoop): UvLoop
        => m.ClosedAlong(f, dom, m.ClosedAlong(f, dom, l, SurfaceParameter.ParameterU), SurfaceParameter.ParameterV);

    // ClosedAtPole in the one free parameter `which`: the points after the first interior point on
    // a collapsed line whose free parameter is `which` move by minus the expanded winding times
    // the period.
    ClosedAlong(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, l: UvLoop, which: SurfaceParameter): UvLoop
    {
        var n = l.Points.Count;
        var period = dom.DomainAlong(which).Periodicity.PeriodOr(0.0);
        var poles = n < 3 ? [0].Take(0) : (n - 2).MapRange(k => k + 1).FlatMap(i => m.IsFreeAlongAt(f, dom, l.Points[i], which) ? [i] : [i].Take(0));
        var w = (poles.Count == 0 || period <= 0.0) ? 0 : m.ExpandedWinding(f, dom, l, which);
        return w == 0 ? l : l.ShiftedAfter(poles[0], UvCoordinate(0.0, 0.0).WithCoordinate(which, 0.0 - w.ToNumber * period));
    }

    // Whether uv lies on a collapsed line of face f whose free parameter is `which`: a line of
    // constant v when `which` is u, of constant u when it is v.
    IsFreeAlongAt(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, uv: UvCoordinate, which: SurfaceParameter): Boolean
        => m.IsOnCollapsedLineAlongIn(f, dom, uv, which.Along(SurfaceParameter.ParameterV, SurfaceParameter.ParameterU));

    // The winding of loop l in parameter `which` as the loop will have it once ExpandedPoles has
    // replaced its pole points by segments (ExpandedPoint): a first point on a collapsed line
    // starts at its predecessor's value (the last point's), a last point on one ends at its
    // successor's (the first point's).
    ExpandedWinding(m: BrepModel, f: BrepFaceIndex, dom: SurfaceDomain, l: UvLoop, which: SurfaceParameter): Integer
    {
        var n = l.Points.Count;
        var first = m.IsFreeAlongAt(f, dom, l.Points[0], which) ? l.Points[n - 1] : l.Points[0];
        var last = m.IsFreeAlongAt(f, dom, l.Points[n - 1], which) ? l.Points[0] : l.Points[n - 1];
        return dom.DomainAlong(which).Winding(first.Coordinate(which), last.Coordinate(which));
    }

    // Loop l with every point after position p moved by `by`, sources unchanged.
    ShiftedAfter(l: UvLoop, p: Integer, by: UvCoordinate): UvLoop
        => UvLoop(l.Points.Count.MapRange(i => i > p ? l.Points[i].ShiftedBy(by) : l.Points[i]), l.Sources);

    //==
    // # Band pairs

    // IsBandPair with the count tested before any entry is read: exactly two loops wind, once each
    // round one direction and the opposite way.
    IsBandPairGuarded(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, winding: Array<Integer>): Boolean
        => winding.Count != 2
            ? false
            : m.UWinding(f, loops[winding[0]]).Abs + m.VWinding(f, loops[winding[0]]).Abs == 1
                && m.UWinding(f, loops[winding[0]]) + m.UWinding(f, loops[winding[1]]) == 0
                && m.VWinding(f, loops[winding[0]]) + m.VWinding(f, loops[winding[1]]) == 0;

    //==
    // # Expanding a pole

    // The least difference in free parameter `which` between where a loop arrives at a collapsed
    // line of face f and where it leaves that makes ExpandedPoint expand the point: the
    // parameter's floor (layer 1's ParameterFloorAlong), not the point tolerance, which is its
    // cap at a pole.
    PoleGapTolerance(m: BrepModel, f: BrepFaceIndex, which: SurfaceParameter): Number
        => m.Geometry.ParameterFloorAlong(m.SurfaceOf(f), which, m.Tolerances).Value;

    // ExpandedPoint with the gap measured against PoleGapTolerance.
    ExpandedPointAtPole(m: BrepModel, f: BrepFaceIndex, l: UvLoop, i: Integer, c: FaceMeshingCriteria): Array<UvSample>
    {
        var n = l.Points.Count;
        var uv = l.Points[i];
        var which = m.FreeParameterAt(f, uv);
        var arriving = l.Points[(i + n - 1) % n].Coordinate(which);
        var leaving = l.Points[(i + 1) % n].Coordinate(which);
        var expands = (n >= 2 ? m.IsOnCollapsedLine(f, uv) : false)
            ? (leaving - arriving).Abs > m.PoleGapTolerance(f, which)
            : false;
        return expands
            ? uv.PoleSegmentSamples(which, arriving, leaving, l.Sources[i], c)
            : [UvSample(uv, l.Sources[i])];
    }
}

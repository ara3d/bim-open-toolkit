@@ -8,12 +8,10 @@
 // arcs' segment counts, which is where the two refinements differ; at a fine bound they agree.
 // Capped is true when the chordal bound is coarse enough that the cap binds on some arc.
 // Not generatable: it holds a BrepModel, so the runner exhausts the Witness_* list.
-// Invariants: Discretizations is Model.DiscretizeAll(Criteria.Discretization, NoFloors);
-// Regions[f] is Model.RegionOf(f, Discretizations, Criteria) and Charts[f] its chart; Cdt[f] is
-// Regions[f].TriangulateRegionCdt(Charts[f]); Reference[f] and Attainable[f] refine Cdt[f];
-// ReferenceMesh and AttainableMesh are the faces lifted and assembled as MeshModel assembles them;
-// Wired[f] is the lift of the library's RefineToSurfaceByInsertion of Cdt[f], whichever refinement
-// it calls, and Library[f] is Model.MeshFace(f, Discretizations, Criteria).Mesh.
+// Invariants: Discretizations is Model.DiscretizeAll(Criteria.Discretization, NoFloors); Faces[f]
+// is face f (CappedFace); ReferenceMesh and AttainableMesh are the faces' Reference and Attainable
+// lifted and assembled as MeshModel assembles them. Eight fields: the generated TupleN surface caps
+// at ten (STY002), so the per-face values are one record per face.
 type CappedWitness
 {
     Name: String;
@@ -21,13 +19,20 @@
     Capped: Boolean;
     Criteria: FaceMeshingCriteria;
     Discretizations: EdgeDiscretizations;
-    Regions: Array<UvRegion>;

+    Faces: Array<CappedFace>;
     ReferenceMesh: ModelMesh;
     AttainableMesh: ModelMesh;
-    Wired: Array<FaceMesh>;
-    Library: Array<FaceMesh>;
+}
+
+// Face f of a capped witness w. Region is w.Model.RegionOf(f, w.Discretizations, w.Criteria);
+// Reference and Attainable refine the constrained Delaunay triangulation of Region in its chart;
+// Wired is the lift of the library's RefineToSurfaceByInsertion of that triangulation, whichever
+// refinement it calls, and Library is w.Model.MeshFace(f, w.Discretizations, w.Criteria).Mesh.
+type CappedFace
+{
+    Region: UvRegion;
+    Reference: UvTriangulation;
+    Attainable: UvTriangulation;
+    Wired: FaceMesh;
+    Library: FaceMesh;
 }

// Laws of V1SeamCut (V1G-22, TKT-484), over the gallery's Witness_CrossHole (sandbox/step-mesh-staging/
// gallery-witnesses, a cylinder band, face 2, with a hole along x through it) and every model witness.
library V1SeamCutLaws
{
    // Face f of m's loops as the region builder has them before the seam cut, discretized under the witness
    // options: unwrapped into the domain, poles expanded.
    LoopsBeforeCut(m: BrepModel, f: BrepFaceIndex): Array<UvLoop>
    {
        var c = MeshingOptions.WitnessOptions.Face;
        var d = m.DiscretizeAll(c.Discretization, SegmentFloors.NoFloors);
        var dom = m.SurfaceDomainOf(f);
        return m.WithPoleSegments(f, m.MeshedBounds(f).Map(b => m.UnwrapIndexedIn(f, dom, m.LoopToUv(f, b, d))), c);
    }

    // Whether two loops have the same points and sources in the same order.
    SameLoop(a: UvLoop, b: UvLoop): Boolean
        => (a.Points.Count == b.Points.Count && a.Sources.Count == b.Sources.Count)
            ? (a.Points.Count.Range.All(i => a.Points[i] == b.Points[i]) && a.Sources.Count.Range.All(i => a.Sources[i] == b.Sources[i]))
            : false;

    // The cross hole's band, face 2, meshed alone under the witness options (MeshFace; the whole model takes
    // longer than the law runner's cap): it has elements and no diagnostic says its region is not simple.
    Law_V1Gate_CrossHoleBandMeshes(_: Integer): Boolean
    {
        var m = BrepModel.Witness_CrossHole;
        var c = MeshingOptions.WitnessOptions.Face;
        var o = m.MeshFace(BrepFaceIndex(2), m.DiscretizeAll(c.Discretization, SegmentFloors.NoFloors), c);
        return o.Mesh.Triangles.Count + o.Mesh.Quads.Count > 0
            && o.Diagnostics.All(x => x.Code != "FACE-LOOP-NOT-SIMPLE" && x.Code != "FACE-REGION-NOT-SIMPLE");
    }

    // Every hole of the cross hole band's region lies inside the joined outer loop's span of u, the band's
    // periodic direction: no hole straddles the cut.
    Law_V1Gate_CrossHoleHolesInsideTheCut(_: Integer): Boolean
    {
        var m = BrepModel.Witness_CrossHole;
        var f = BrepFaceIndex(2);
        var c = MeshingOptions.WitnessOptions.Face;
        var r = m.RegionOf(f, m.DiscretizeAll(c.Discretization, SegmentFloors.NoFloors), c);
        var outer = r.Outer.LoopSpanAlong(true);
        return r.Holes.Count == 2
            && r.Holes.All(h => h.LoopSpanAlong(true).Start > outer.Start && h.LoopSpanAlong(true).End < outer.End);
    }

    // On every face of model m whose loops are a band pair and whose nearest cut no hole reaches, WithSeamCutV1
    // gives WithSeamCut's loops: no band without a hole in its cut's way changes.
    Law_V1Gate_BandCutUnchangedWhereNoHoleReaches(m: BrepModel): Boolean
        => m.Faces.Count.Range.All(k =>
            (m.IsPlainSurfaceOf(BrepFaceIndex(k)) || m.MeshedBounds(BrepFaceIndex(k)).Count == 0)
                ? true
                : m.SameCutWhereClear(BrepFaceIndex(k), m.LoopsBeforeCut(BrepFaceIndex(k))));

    // SameCutWhereClear's claim on face f's loops.
    SameCutWhereClear(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>): Boolean
    {
        var c = MeshingOptions.WitnessOptions.Face;
        var winding = m.WindingLoops(f, loops);
        var band = m.IsBandPair(f, loops, winding);
        var holes = loops.Count.Range.FlatMap(k => winding.Any(w => w == k) ? loops.Take(0) : [loops[k]]);
        var before = m.WithSeamCut(f, loops, c);
        var after = m.WithSeamCutV1(f, loops, c);
        var nearest = band ? m.NearestPair(f, loops[winding[0]], loops[winding[1]]) : 0;
        var moved = band ? m.CutPairAvoiding(f, loops[winding[0]], loops[winding[1]], holes) != nearest : false;
        return moved
            ? true
            : (before.Count == after.Count ? before.Count.Range.All(i => SameLoop(before[i], after[i])) : false);
    }

    // Spans on the circle of circumference 10: [1, 2] and [3, 4] are 1 apart; [9.5, 10.5] meets [0, 1] one period
    // on; [-0.2, 0.2] meets [9.9, 9.95]; a span of the whole period meets everything.
    Law_V1Gate_SpansOnTheCircle(_: Integer): Boolean
        => SpanClearanceModulo(NumberInterval(1.0, 2.0), NumberInterval(3.0, 4.0), 10.0) == 1.0
            && SpansMeetModulo(NumberInterval(9.5, 10.5), NumberInterval(0.0, 1.0), 10.0)
            && SpansMeetModulo(NumberInterval(-0.2, 0.2), NumberInterval(9.9, 9.95), 10.0)
            && SpansMeetModulo(NumberInterval(0.0, 10.0), NumberInterval(4.0, 4.5), 10.0)
            && SpansMeetModulo(NumberInterval(1.0, 2.0), NumberInterval(3.0, 4.0), 10.0).Not;
}

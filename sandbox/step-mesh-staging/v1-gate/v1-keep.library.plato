//==
// # Version 1: the grid keep rule on the one chordal measure (V1G-11)
//
// T1's grid decision (DecideGridChordal, 05-face-meshing/element-shape.library.plato) kept an
// element when every triangle it may be drawn as faces the face normal and is within the bound,
// each triangle measured against the surface over its own parameter triangle. GridElementKeptV1
// keeps the orientation test and decides the chordal claim with ElementWithinChordal, the measure
// the gate claim uses, each split as a whole; its sampled sides are those that are not boundary
// segments of the region. The merge points T1's GridElementKept here, so DecideGridChordal and
// everything above it decide on the one measure unchanged.
//
// Sections, in order:
//  - The grid decision

library V1Keep
{
    //==
    // # The grid decision

    // Whether element k of grid g on region r of face f is kept: it collapses at a pole, or every
    // triangle it may be drawn as faces the face normal and it is within `bound` under the one
    // chordal measure. An element out of range is not kept.
    GridElementKeptV1(m: BrepModel, f: BrepFaceIndex, r: UvRegion, g: UvTriangulation, k: ElementIndex, bound: Number): Boolean
    {
        var shape = g.ShapeOf(k);
        var s = m.SurfaceOf(f);
        return shape.IsElementShape.Not
            ? false
            : (g.IsCollapsedElement(k)
                ? true
                : (shape.RenderTriangles.All(tri => m.GridTriangleFacesFaceNormal(f, g, tri))
                    ? m.ElementWithinChordal(f, v => g.Points[v], v => m.Geometry.Eval(s, g.Points[v]), shape,
                        (a, b) => r.IsConstrained(a.Value, b.Value).Not, bound)
                    : false));
    }
}

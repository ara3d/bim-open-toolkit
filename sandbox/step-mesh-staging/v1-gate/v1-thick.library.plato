//==
// # Version 1: a triangle on a short segment is thick enough at half its shortest side (TKT-464)
//
// F2 (TKT-401) keeps an inserted point only when every triangle its cavity writes has an altitude
// of at least ThinBound (ten length tolerances), or the cavity's thinnest triangle is thicker than
// the thinnest it replaces. A triangle's altitude (twice its area over its longest side) is never
// more than its shortest side, so a triangle on a boundary segment shorter than ThinBound can never
// reach it, and an insertion whose flips reach such a segment is kept only when it thickens it.
// On u-blox SHO/c211_case_with_odin_v1.step face 339, a quarter cylinder of radius 6 and 28 long,
// one boundary segment is 0.05 mm (two vertices 0.0083 rad apart), and the flips of every
// insertion that would split the long fans t3, t10 and t11 carry the cavity to it: its triangle's
// altitude goes from 0.050 to 0.044, and the insertion is refused. Chordal-only refinement then
// stops with fans 1.3 rad wide, 1.324 from the surface against the bound of 1. ThinBoundOf asks each
// written triangle for ThinBound or half its shortest side, whichever is less, and never less than
// two length tolerances, so a kept triangle is never degenerate (ElementIsNotDegenerate rejects an
// altitude of one tolerance or less), and F2's bump top, whose thin triangles have long sides,
// meets the same bound as before.
//
// Sections, in order:
//  - Thickness

library V1Thick
{
    //==
    // # Thickness

    // The altitude triangle (a, b, c) must reach to count as thick: ThinBound, or half its shortest
    // side when that is less, and at least two length tolerances.
    ThinBoundOf(m: BrepModel, a: Point3D, b: Point3D, c: Point3D): Number
        => m.ThinBound.Min(0.5 * a.Distance(b).Min(b.Distance(c)).Min(c.Distance(a))).Max(2.0 * m.Tolerances.Length.Value);

    // Whether triangle t, its corners placed by `at` for the new point (index pi) and pos for the
    // others, is thick: its AltitudeUnlessCollapsed reaches ThinBoundOf.
    IsThickTriangle(m: BrepModel, t: TriangleFace, pi: Integer, at: Point3D, pos: List<Point3D>): Boolean
    {
        var a = t.A.Value == pi ? at : pos.At(t.A.Value);
        var b = t.B.Value == pi ? at : pos.At(t.B.Value);
        var c = t.C.Value == pi ? at : pos.At(t.C.Value);
        return AltitudeUnlessCollapsed(a, b, c, m.Tolerances.Length.Value) >= m.ThinBoundOf(a, b, c);
    }

    // CavityIsThick with each written triangle held to its own ThinBoundOf: kept when every
    // triangle cavity c writes is thick, or, as before, when its thinnest is thicker than the
    // thinnest of the triangles it replaces.
    CavityIsThickV1(m: BrepModel, c: TriangleWrites, pi: Integer, at: Point3D, pos: List<Point3D>, tris: List<TriangleFace>): Boolean
    {
        var replaced = c.Slots.FlatMap(s => s < tris.Count ? [tris.At(s)] : [tris.At(0)].Take(0));
        return c.Triangles.All(t => m.IsThickTriangle(t, pi, at, pos))
            || m.ThinnestOf(c.Triangles, pi, at, pos) > m.ThinnestOf(replaced, pi, at, pos);
    }

    // ChangedAreThick (TriangulationFast's TryInsertion, the Local reference of the insertion
    // passes) with the same per-triangle bound as CavityIsThickV1: kept when every changed
    // triangle of `after` is thick, or its thinnest is thicker than that of `before` there; corners
    // evaluated on face f's surface at pts (the new point's parameters last).
    ChangedAreThickV1(m: BrepModel, f: BrepFaceIndex, pts: Array<UvCoordinate>, before: Array<TriangleFace>, after: Array<TriangleFace>, changed: Array<Integer>): Boolean
    {
        var pos = new List<Point3D>().AddRange(pts.Map(uv => m.Geometry.Eval(m.SurfaceOf(f), uv)));
        var pi = pts.Count - 1;
        return changed.All(k => m.IsThickTriangle(after[k], pi, pos.At(pi), pos))
            || m.ThinnestOf(changed.Map(k => after[k]), pi, pos.At(pi), pos)
                > m.ThinnestOf(changed.FlatMap(k => k < before.Count ? [before[k]] : [before[0]].Take(0)), pi, pos.At(pi), pos);
    }
}

// Laws of V1ZeroWidth (V1G-19). The two witnesses beside this file were written by
// `step-corpus-harness extract <file> <face> <out> --ring 0` from SHO/ANNA-B4.step face 491 and SHO/ODIN-W260.STEP
// face 2625, each a lens of two edges between one pair of vertices, 0.0007 and 0.001 mm wide at a tolerance of
// 0.001, that the library before V1G-19 leaves unmeshed with FACE-ZERO-WIDTH.
library V1ZeroWidthLaws
{
    // The number of triangles of ts with the directed side from a to b.
    DirectedSideCount(ts: Array<TriangleFace>, a: Integer, b: Integer): Integer
        => ts.Reduce(0, (n, t) => 3.Range.Any(s => t.At(s).Value == a && t.At((s + 1) % 3).Value == b) ? n + 1 : n);

    // n points on a strip 0.0005 wide around a quarter arc of radius 10: the first half out along the outer
    // arc, the rest back along the inner one.
    ThinArcStrip(n: Integer): Array<Point3D>
    {
        var h = n / 2;
        return n.MapRange(i => i < h
            ? Point3D(10.0 * (1.5707963 * i.ToNumber / (h - 1).Max(1).ToNumber).Cos, 10.0 * (1.5707963 * i.ToNumber / (h - 1).Max(1).ToNumber).Sin, 0.0)
            : Point3D(9.9995 * (1.5707963 * (n - 1 - i).ToNumber / (n - h - 1).Max(1).ToNumber).Cos, 9.9995 * (1.5707963 * (n - 1 - i).ToNumber / (n - h - 1).Max(1).ToNumber).Sin, 0.0));
    }

    // ClippedByShortestDiagonal of a ring of n points (3 to 40) gives n - 2 triangles, each side of the ring
    // once in the ring's direction and never backwards, and every other side as often one way as the other:
    // a disc whose boundary is the ring, whatever the points.
    Law_V1Gate_ShortestDiagonalClipIsADisc(k: Integer): Boolean
    {
        var n = 3 + ((k % 38) + 38) % 38;
        var ts = ClippedByShortestDiagonal(ThinArcStrip(n));
        return ts.Count == n - 2
            && n.Range.All(i => DirectedSideCount(ts, i, (i + 1) % n) == 1 && DirectedSideCount(ts, (i + 1) % n, i) == 0)
            && n.Range.All(a => n.Range.All(b => (b == (a + 1) % n || a == (b + 1) % n || a == b)
                ? true
                : DirectedSideCount(ts, a, b) == DirectedSideCount(ts, b, a)));
    }

    // Witness w meshed by the host's options at 1 mm: it has triangles, every edge of its mesh is used once
    // (its boundary, the face's own boundary segments, which the neighbours share in the file) or twice in
    // opposite directions, and FACE-ZERO-WIDTH is reported as a warning, with no error.
    ZeroWidthFaceIsMeshed(w: BrepModel): Boolean
    {
        var o = w.MeshModel(HostMeshingOptions(1.0));
        var t = o.Mesh.EdgeTableOf;
        return o.Mesh.Triangles.Count > 0
            && t.CountNonManifoldEdges == 0 && t.CountMisorientedEdges == 0
            && o.Report.Diagnostics.Any(x => x.Code == "FACE-ZERO-WIDTH" && x.Severity == Severity.Warning)
            && o.Report.Diagnostics.All(x => x.Severity != Severity.Error);
    }

    // ANNA-B4 face 491 is meshed with the triangles its boundary forces.
    Law_V1Gate_AnnaB4Face491IsMeshed(_: Integer): Boolean
        => ZeroWidthFaceIsMeshed(BrepModel.Witness_AnnaB4Face491);

    // ODIN-W260 face 2625 is meshed with the triangles its boundary forces.
    Law_V1Gate_OdinW260Face2625IsMeshed(_: Integer): Boolean
        => ZeroWidthFaceIsMeshed(BrepModel.Witness_OdinW260Face2625);

    Measure_V1Gate_AnnaB4Face491IsMeshed(_: Integer): Integer
        => BrepModel.Witness_AnnaB4Face491.MeshModel(HostMeshingOptions(1.0)).Mesh.Triangles.Count;

    Measure_V1Gate_OdinW260Face2625IsMeshed(_: Integer): Integer
        => BrepModel.Witness_OdinW260Face2625.MeshModel(HostMeshingOptions(1.0)).Mesh.Triangles.Count;
}

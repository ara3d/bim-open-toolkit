//==
// # Version 1: refinement does not chase triangles that collapse at a pole (TKT-428)
//
// On a sphere or cone the pole (apex) is a segment in parameter space whose points are one 3D
// point. A triangle with two corners on it lifts to a segment and Lift drops it, yet the chordal
// round tested it: its zero 3D area reads as a fold, and the surface over it is far from the flat
// "triangle", so every round inserted points beside the pole, which made more such triangles.
// moon_buggy_asm.stp's spheres (radius 254 mm at a 1 mm bound) had most of their triangles within
// 20 degrees of a pole. WithoutCollapsedMarks clears the refinement mark of every triangle that
// collapses at a pole (IsCollapsedElement: two corners with identified sources), so only triangles
// that are drawn drive refinement; the ones beside the pole that are drawn are still tested.
//
// Sections, in order:
//  - Marks

library V1PoleRefine
{
    //==
    // # Marks

    // The refinement marks of triangulation t's triangles with every triangle that collapses at a
    // pole unmarked.
    WithoutCollapsedMarks(t: UvTriangulation, marks: Array<Boolean>): Array<Boolean>
        => marks.Count.MapRange(k => marks[k] ? t.IsCollapsedElement(ElementIndex(k)).Not : false);
}

//==
// # Version 1: a band's seam cut avoids its holes (V1G-22, TKT-484)
//
// A band (two loops winding opposite ways round one periodic direction, such as a cylinder
// between two circles) is joined into one loop by a synthetic cut between the two loops
// (JoinedByCut, uv-regions.library.plato), at the pair of points nearest in space
// (NearestPair). On a cylinder every generator gives the same length, so the first pair wins,
// at the loops' first points. On the gallery's Witness_CrossHole, a band with a hole through it
// along x, that cut runs through the +x hole: the hole's points straddle the cut's parameter
// (from below -0.01 to above +0.01 at u = 0), no whole-period move puts it inside the joined
// loop, its points lie on the outer loop's seam side, and the region is refused. CutPairAvoiding
// keeps NearestPair's pair when no hole reaches its cut, so every other band keeps its cut; when
// a hole does, it takes, among the pairs whose cut no hole reaches and whose length is within
// one percent of the shortest such, the one farthest, modulo the period, from every hole.
//
// Sections, in order:
//  - Spans on the circle
//  - Choosing the cut
//  - Joining and the region

library V1SeamCut
{
    //==
    // # Spans on the circle

    // The parameter s of uv: U when alongU, else V.
    AlongOf(uv: UvCoordinate, alongU: Boolean): Number
        => alongU ? uv.U : uv.V;

    // The span [first, last] of loop l's parameters along U (alongU) or V, as an interval.
    LoopSpanAlong(l: UvLoop, alongU: Boolean): NumberInterval
        => NumberInterval(
            l.Points.Reduce(Number.MaxValue, (lo, p) => lo.Min(p.AlongOf(alongU))),
            l.Points.Reduce(0.0 - Number.MaxValue, (hi, p) => hi.Max(p.AlongOf(alongU))));

    // Whether spans a and b meet on the circle of circumference p: one starts inside the other
    // after whole periods. A span as long as the period meets everything.
    SpansMeetModulo(a: NumberInterval, b: NumberInterval, p: Number): Boolean
        => (a.End - a.Start >= p || b.End - b.Start >= p)
            ? true
            : (Wrap(b.Start - a.Start, p) <= a.End - a.Start || Wrap(a.Start - b.Start, p) <= b.End - b.Start);

    // How far apart spans a and b are on the circle of circumference p: the shorter of the two
    // gaps between them; 0 when they meet.
    SpanClearanceModulo(a: NumberInterval, b: NumberInterval, p: Number): Number
        => SpansMeetModulo(a, b, p) ? 0.0 : Wrap(b.Start - a.End, p).Min(Wrap(a.Start - b.End, p));

    //==
    // # Choosing the cut

    // The span along the band's direction of the cut from point i of a to the copy of point j of b
    // the cut ends at (BandEndCopy).
    CutSpan(m: BrepModel, f: BrepFaceIndex, a: UvLoop, i: Integer, b: UvLoop, j: Integer, alongU: Boolean): NumberInterval
    {
        var s = a.Points[i].AlongOf(alongU);
        var e = m.BandEndCopy(f, a, i, b, j).AlongOf(alongU);
        return NumberInterval(s.Min(e), s.Max(e));
    }

    // The smallest clearance, on the circle of the band's period p, between the cut from i of a to
    // j of b and the holes' spans (Number.MaxValue with no hole).
    CutClearance(m: BrepModel, f: BrepFaceIndex, a: UvLoop, i: Integer, b: UvLoop, j: Integer, holes: Array<UvLoop>, alongU: Boolean, p: Number): Number
    {
        var cut = m.CutSpan(f, a, i, b, j, alongU);
        return holes.Reduce(Number.MaxValue, (least, h) => least.Min(SpanClearanceModulo(cut, h.LoopSpanAlong(alongU), p)));
    }

    // The pair (i of a, j of b, coded i * b.Count + j) the band's cut joins, given the loops that
    // do not wind (holes): NearestPair's when no hole reaches its cut; otherwise, for each point
    // i of a the point j of b nearest it in space, and among those pairs whose cut no hole reaches
    // and whose length is within one percent of the shortest such, the one with the largest
    // clearance from the holes; NearestPair's when every cut meets a hole.
    CutPairAvoiding(m: BrepModel, f: BrepFaceIndex, a: UvLoop, b: UvLoop, holes: Array<UvLoop>): Integer
    {
        var nb = b.Points.Count;
        var nearest = m.NearestPair(f, a, b);
        var d = m.LoopDisplacement(f, a);
        var alongU = d.U != 0.0;
        var p = (alongU ? d.U : d.V).Abs;
        return (holes.Count == 0 || p <= 0.0)
            ? nearest
            : (m.CutClearance(f, a, nearest / nb, b, nearest % nb, holes, alongU, p) > 0.0
                ? nearest
                : m.CutPairClearOfHoles(f, a, b, holes, alongU, p, nearest));
    }

    // CutPairAvoiding's search when the nearest pair's cut meets a hole.
    CutPairClearOfHoles(m: BrepModel, f: BrepFaceIndex, a: UvLoop, b: UvLoop, holes: Array<UvLoop>, alongU: Boolean, p: Number, nearest: Integer): Integer
    {
        var s = m.SurfaceOf(f);
        var pa = a.Points.Map(uv => m.Geometry.Eval(s, uv));
        var pb = b.Points.Map(uv => m.Geometry.Eval(s, uv));
        var nb = b.Points.Count;
        var js = a.Points.Count.MapRange(i => nb.Range.Reduce(0, (best, j) => pa[i].Distance(pb[j]) < pa[i].Distance(pb[best]) ? j : best));
        var length = a.Points.Count.MapRange(i => pa[i].Distance(pb[js[i]]));
        var clear = a.Points.Count.MapRange(i => m.CutClearance(f, a, i, b, js[i], holes, alongU, p));
        var shortest = a.Points.Count.Range.Reduce(Number.MaxValue, (least, i) => clear[i] > 0.0 ? least.Min(length[i]) : least);
        // Conditionals, not || or &&, which evaluate every operand: clear[best] at best = -1 is out of range.
        var chosen = a.Points.Count.Range.Reduce(-1, (best, i) =>
            (clear[i] > 0.0 ? length[i] <= shortest * 1.01 : false)
                ? (best < 0 ? i : (clear[i] > clear[best] ? i : best))
                : best);
        return chosen < 0 ? nearest : chosen * nb + js[chosen];
    }

    //==
    // # Joining and the region

    // JoinedByCut with the pair (i * b.Count + j) given instead of NearestPair's; the same loop
    // otherwise. JoinedByCut is JoinedByCutAt at NearestPair.
    JoinedByCutAt(m: BrepModel, f: BrepFaceIndex, a: UvLoop, b: UvLoop, pair: Integer, c: FaceMeshingCriteria): UvLoop
    {
        var i = pair / b.Points.Count;
        var j = pair % b.Points.Count;
        var d = m.LoopDisplacement(f, a);
        var start = a.Points[i];
        var end = m.BandEndCopy(f, a, i, b, j);
        var n = m.CutSegmentCount(f, start, end, c);
        var far = d.U != 0.0 ? (d.U > 0.0 ? DomainSide.UMax : DomainSide.UMin) : (d.V > 0.0 ? DomainSide.VMax : DomainSide.VMin);
        var cut = (n - 1).MapRange(k => start.CutPoint(end, n, k + 1));
        var ra = a.RotatedFrom(i, d);
        var rb = b.RotatedFrom(j, m.LoopDisplacement(f, b)).ShiftedLoop(UvCoordinate(end.U + d.U - b.Points[j].U, end.V + d.V - b.Points[j].V));
        return UvLoop(
            ra.Points
                .Concatenate([start.ShiftedBy(d)])
                .Concatenate(cut.Map(q => q.ShiftedBy(d)))
                .Concatenate(rb.Points)
                .Concatenate([end])
                .Concatenate((n - 1).MapRange(k => cut[n - 2 - k])),
            ra.Sources
                .Concatenate([a.Sources[i]])
                .Concatenate((n - 1).MapRange(k => UvPointSource.SeamCut(far, k + 1)))
                .Concatenate(rb.Sources)
                .Concatenate([b.Sources[j]])
                .Concatenate((n - 1).MapRange(k => UvPointSource.SeamCut(far.OppositeSide, n - 1 - k))));
    }

    // WithSeamCut with the band pair joined at CutPairAvoiding's pair, the other loops as the holes.
    WithSeamCutV1(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): Array<UvLoop>
    {
        var winding = m.WindingLoops(f, loops);
        var others = loops.Count.Range.FlatMap(k => winding.Any(w => w == k) ? loops.Take(0) : [loops[k]]);
        return winding.Count == 0
            ? (m.IsWholePeriodAtVertex(f, loops) ? m.CutWholePeriods(f, loops, c) : loops)
            : (m.IsBandPair(f, loops, winding)
                ? [m.JoinedByCutAt(f, loops[winding[0]], loops[winding[1]], m.CutPairAvoiding(f, loops[winding[0]], loops[winding[1]], others), c)].Concatenate(others)
                : m.CutWholePeriods(f, loops, c));
    }
}

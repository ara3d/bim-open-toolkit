//==
// # Version 1 gate laws (TKT-418)
//
// The face-level properties of the version 1 mesh contract (sandbox/step-brep-mesh/README.md,
// "Version 1 mesh contract") stated on real face meshes: every face meshed, every element within
// the chordal bound both ways and oriented, and every quad so on both of its diagonal splits.
// Layer 05's own element laws (Law_ElementDeviationWithinSurfaceChordal,
// Law_SurfaceWithinSurfaceChordalOfElement, Law_ElementFacesFaceNormal) take a FaceMesh the
// runner generates, which holds arrays and is never one MeshFace built; these laws read the
// final state of the refinement loop on four witnesses, quads preferred.
//
// Sections, in order:
//  - Coverage
//  - Chordal tolerance
//  - Orientation

library V1GateLaws
{
    //==
    // # Coverage

    // Every face of the witness is meshed: its final outcome holds a non-empty mesh. A face left
    // unmeshed is a hole in the solid, which the contract forbids.
    Law_V1Gate_EveryFaceMeshed(w: V1GateWitness): Boolean
        => w.Model.Faces.Count == w.State.Outcomes.Count
            && w.V1GateMeshes.All(fm => fm.IsEmptyFaceMesh.Not);

    // The quad laws are not vacuous: the unit box and the cylinder mesh with quads.
    Law_V1Gate_QuadsAreReached(w: V1GateWitness): Boolean
        => (w.Name == "UnitBox" || w.Name == "Cylinder")
            ? w.V1GateMeshes.Any(fm => fm.Quads.Count > 0)
            : true;

    //==
    // # Chordal tolerance

    // Both diagonal splits of every quad lie within the chordal bound of the surface, mesh to
    // surface and surface to mesh, so a renderer may split the quad either way.
    Law_V1Gate_QuadSplitsWithinChordal(w: V1GateWitness): Boolean
    {
        var bound = w.V1GateBound;
        var d = w.State.Discretizations;
        return w.V1GateMeshes.All(fm => fm.Quads.Count.Range.All(q => w.Model.QuadSplitsWithin(d, fm, q, bound)));
    }

    // Every triangle lies within the chordal bound of the surface, both ways.
    Law_V1Gate_TrianglesWithinChordal(w: V1GateWitness): Boolean
    {
        var bound = w.V1GateBound;
        var d = w.State.Discretizations;
        return w.V1GateMeshes.All(fm => fm.Triangles.Count.Range.All(k => w.Model.TriangleWithin(d, fm, k, bound)));
    }

    //==
    // # Orientation

    // Both diagonal splits of every quad face the face normal: no split folds.
    Law_V1Gate_QuadSplitsOriented(w: V1GateWitness): Boolean
        => w.V1GateMeshes.All(fm => fm.Quads.Count.Range.All(q => w.Model.QuadSplitsOriented(fm, q)));

    // Every triangle faces the face normal.
    Law_V1Gate_TrianglesOriented(w: V1GateWitness): Boolean
        => w.V1GateMeshes.All(fm => fm.Triangles.Count.Range.All(k => w.Model.TriangleOriented(fm, k)));
}

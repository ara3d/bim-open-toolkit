//==
// # Version 1: a band's side may pass through its own circle's vertex (TKT-430)
//
// A cylinder face bounded by two full circles gets a seam cut (JoinedByCut) between its two
// circles, and the joined loop is four-sided: a circle, the cut, the other circle, the cut back.
// The four-sided test (QuadSidesIn, SideIsOneCarrier) asks every point strictly inside a side to
// lie on one carrier. When the two circles' vertices lie on one generator the cut runs from vertex
// to vertex and every point inside a circle side is a sample of that circle. When they do not (the
// axle of STEP Tools' moon_buggy_asm.stp, face 29, vertices half a turn apart), the cut starts at a
// sample point of a circle, so that circle's side runs through the circle's own vertex, which is no
// carrier's, and the face got no grid: the CDT branch refined it to 51,768 triangles where 24 quads
// meet the chordal bound. SideIsOneCarrierV1 lets a vertex lie inside a side when both its
// neighbours on the loop are samples of the side's carrier edge: a vertex flanked by samples of one
// edge is that closed edge's own vertex, where the edge starts and ends.
//
// Sections, in order:
//  - Sides
//  - Witnesses

library V1Axle
{
    //==
    // # Sides

    // Whether s is a model vertex.
    IsAnyVertexSource(s: UvPointSource): Boolean
        => match (s) {
            FromVertex(v) => true;
            FromEdge(e, k) => false;
            SeamCut(side, k) => false;
            Pole(side, k) => false;
            Interior => false;
        };

    // Whether s is a sample of an edge.
    IsEdgeSampleSource(s: UvPointSource): Boolean
        => match (s) {
            FromVertex(v) => false;
            FromEdge(e, k) => true;
            SeamCut(side, k) => false;
            Pole(side, k) => false;
            Interior => false;
        };

    // Whether the outer loop's point at position p lies on the carrier of `carrier`: on it, or a
    // vertex whose two neighbours on the loop are both samples of carrier's edge.
    IsOnSideCarrier(r: UvRegion, p: Integer, carrier: UvPointSource): Boolean
    {
        var s = r.Outer.Sources.AtModulo(p);
        return s.SameCarrier(carrier)
            ? true
            : ((s.IsAnyVertexSource && carrier.IsEdgeSampleSource)
                ? (r.Outer.Sources.AtModulo(p + r.Outer.Sources.Count - 1).SameCarrier(carrier)
                    ? r.Outer.Sources.AtModulo(p + 1).SameCarrier(carrier)
                    : false)
                : false);
    }

    // SideIsOneCarrier, except that a closed edge's own vertex may lie inside a side of that edge
    // (IsOnSideCarrier). The carrier is the first point inside the side that is not a vertex; a
    // side whose inner points are all vertices is no carrier's, as before.
    SideIsOneCarrierV1(r: UvRegion, corners: Array<VertexIndex>, k: Integer): Boolean
    {
        var start = corners[k % 4].Value;
        var count = r.SideSegmentCount(corners, k);
        var positions = (count - 1).MapRange(i => start + 1 + i);
        var carriers = positions.FlatMap(p => r.Outer.Sources.AtModulo(p).IsAnyVertexSource ? [p].Take(0) : [p]);
        return positions.Count == 0
            ? true
            : (carriers.Count == 0
                ? false
                : positions.All(p => r.IsOnSideCarrier(p, r.Outer.Sources.AtModulo(carriers[0]))));
    }

    //==
    // # Witnesses

    // The side face of the cylinder of radius r and height h bounded by its two rim circles, the
    // top circle closed at (-r, 0, h), half a turn from the bottom circle's vertex (r, 0, 0), as the
    // axle's are: Witness_CylinderBand with the top circle's frame turned by pi. Loops [E0+] and
    // [E1-] bound the side face. Only face meshing reads it (one face, the shell stated closed).
    Witness_CylinderBandTurned(_: BrepModel, r: Number, h: Number): BrepModel
        => BrepModel(
            GeometrySet(
                [BrepCurve.Circle(WorldFrameAt(Point3D(0.0, 0.0, 0.0)), r),
                 BrepCurve.Circle(FrameAt(Point3D(0.0, 0.0, h), Vector3D(-1.0, 0.0, 0.0), Vector3D(0.0, -1.0, 0.0), Vector3D(0.0, 0.0, 1.0)), r)],
                [],
                [],
                [BrepSurface.Cylinder(WorldFrameAt(Point3D(0.0, 0.0, 0.0)), r)], []),
            [BrepVertex(Point3D(r, 0.0, 0.0)), BrepVertex(Point3D(0.0 - r, 0.0, h))],
            [BrepEdge(BrepVertexIndex(0), BrepVertexIndex(0), CurveIndex(0), true),
             BrepEdge(BrepVertexIndex(1), BrepVertexIndex(1), CurveIndex(1), true)],
            [BrepLoop.EdgeLoop([CoedgeOf(0, true)]), BrepLoop.EdgeLoop([CoedgeOf(1, false)])],
            [BrepFace(SurfaceIndex(0), true, [FaceBound(BrepLoopIndex(0), true, false), FaceBound(BrepLoopIndex(1), true, false)])],
            [ClosedShellOf([0])],
            [BrepBody.ManifoldSolid(ShellIndex(0))],
            Tolerances.Witness_Tolerances,
            LengthUnit.Metre);
}

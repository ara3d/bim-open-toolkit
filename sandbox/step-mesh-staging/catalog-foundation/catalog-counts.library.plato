//==
// # Catalog: counts (functions)
//
// Orders, hashes and constructors for catalog-counts.types.plato. The
// constructors clamp to each type's floor; SamplesOf and SegmentsOf are the
// only conversions between a polyline's segments and its points.
//
// Sections, in order:
//  - Orders and hashes
//  - Constructors
//  - Segments and samples
//  - Rounds and depths

library CatalogFoundationCounts
{
    //==
    // # Orders and hashes

    // The order of counts.
    LessThanOrEquals(a: Count, b: Count): Boolean
        => a.Value <= b.Value;

    // The hash of a count.
    Hash(x: Count): Integer
        => x.Value.Hash;

    // The order of non-zero counts.
    LessThanOrEquals(a: NonZeroCount, b: NonZeroCount): Boolean
        => a.Value <= b.Value;

    // The hash of a non-zero count.
    Hash(x: NonZeroCount): Integer
        => x.Value.Hash;

    // The order of segment counts.
    LessThanOrEquals(a: SegmentCount, b: SegmentCount): Boolean
        => a.Value <= b.Value;

    // The hash of a segment count.
    Hash(x: SegmentCount): Integer
        => x.Value.Hash;

    // The order of sample counts.
    LessThanOrEquals(a: SampleCount, b: SampleCount): Boolean
        => a.Value <= b.Value;

    // The hash of a sample count.
    Hash(x: SampleCount): Integer
        => x.Value.Hash;

    // The order of rounds.
    LessThanOrEquals(a: Round, b: Round): Boolean
        => a.Value <= b.Value;

    // The hash of a round.
    Hash(x: Round): Integer
        => x.Value.Hash;

    // The order of depths.
    LessThanOrEquals(a: Depth, b: Depth): Boolean
        => a.Value <= b.Value;

    // The hash of a depth.
    Hash(x: Depth): Integer
        => x.Value.Hash;

    //==
    // # Constructors

    // n as a count, at least zero.
    CountOf(n: Integer): Count
        => Count(n.Max(0));

    // n as a non-zero count, at least one.
    NonZeroCountOf(n: Integer): NonZeroCount
        => NonZeroCount(n.Max(1));

    // n as a segment count, at least one.
    SegmentCountOf(n: Integer): SegmentCount
        => SegmentCount(n.Max(1));

    // The fewest segments a closed edge's polyline may have: three, so the
    // closed polyline bounds a non-degenerate polygon.
    ClosedEdgeMinimum(_: SegmentCount): SegmentCount
        => SegmentCount(3);

    // A segment count as a count.
    ToCount(s: SegmentCount): Count
        => Count(s.Value);

    // A sample count as a count.
    ToCount(s: SampleCount): Count
        => Count(s.Value);

    //==
    // # Segments and samples

    // The number of points of a polyline with s segments.
    SamplesOf(s: SegmentCount): SampleCount
        => SampleCount(s.Value + 1);

    // The number of segments of a polyline with c points: the inverse of
    // SamplesOf. Precondition: c.Value >= 2.
    SegmentsOf(c: SampleCount): SegmentCount
        => SegmentCount(c.Value - 1);

    //==
    // # Rounds and depths

    // The first refinement round.
    First(_: Round): Round
        => Round(0);

    // The round after r.
    NextRound(r: Round): Round
        => Round(r.Value + 1);

    // The depth of the root.
    Root(_: Depth): Depth
        => Depth(0);

    // The depth one level below d.
    Deeper(d: Depth): Depth
        => Depth(d.Value + 1);
}

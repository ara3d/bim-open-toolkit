//==
// # Catalog: signs, senses, parities, and windings
//
// TYPE-CATALOG.md section 1 (layer 0). Every orientation decision and every
// direction agreement is a small closed sum with an algebra, not a Boolean or
// a Number compared with zero.
//
// Sections, in order:
//  - Signs
//  - Senses and parities
//  - Windings

//==
// # Signs

// The result of an orientation decision. SignWithin is the only constructor
// from a Number. Removes: a > 0 test on a number that is rounding noise.
type Sign
    = Positive
    | Zero
    | Negative;

//==
// # Senses and parities

// Whether two directions agree: an edge's or a face's SameSense, a coedge's
// orientation, a bound's orientation. Compose is its algebra, with Same the
// identity. Removes: the composed sense of a face along an edge computed as an
// XOR of three Booleans with one read backwards. EdgeOrientation stays the
// STEP-facing name; ToSense converts.
type Sense
    implements IReversible
    = Same
    | Opposite;

// Whether a count is even or odd: how many times a face was flipped at
// decode, or the orientation class of a shell. Removes: a fold applied an even
// number of times taken as a flip.
type Parity
    = Even
    | Odd;

//==
// # Windings

// The signed number of times a loop winds around a periodic direction.
// Removes: a loop that crosses the seam twice taken as closed in the plane.
type Winding
    implements IValue, IReversible
{
    Turns: Integer;
}

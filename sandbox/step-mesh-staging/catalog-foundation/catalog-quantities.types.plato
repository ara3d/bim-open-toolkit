//==
// # Catalog: lengths, areas, volumes, ratios, and measures
//
// TYPE-CATALOG.md section 1 (layer 0). One type per unit and per dimension, so
// a tolerance in metres is never added to a coordinate in millimetres and an
// area is never graded against a length bound.
//
// Sections, in order:
//  - Lengths and their powers
//  - Dimensionless numbers
//  - Scale factors and rounding
//  - Measures

//==
// # Lengths and their powers

// A length in the model's LengthUnit. Removes: a tolerance in metres added to
// a coordinate in millimetres; the decoder's unit conversion applied twice or
// not at all. ToMetres and ToModel are its only conversions.
type ModelLength
    implements IValue, IOrderable, IScaled
{
    Value: Number;
}

// A length in metres, the only other form of a ModelLength. Removes: a
// metre-valued tolerance read as model units.
type Metres
    implements IValue, IOrderable
{
    Value: Number;
}

// A squared length in model units squared: what the dot product of a
// difference with itself returns. Removes: a distance compared with a
// tolerance without the square root, or with the root taken twice.
// Invariant: Value >= 0.
type SquaredLength
    implements IValue, IOrderable, IScaled
{
    Value: Number;
}

// An area in model units squared. Removes: an oracle's area compared with a
// mesh's volume; an area scaled by k instead of k^2.
type AreaMeasure
    implements IValue, IOrderable, IScaled
{
    Value: Number;
}

// A volume in model units cubed. Removes: a volume scaled by k or k^2 instead
// of k^3; a volume compared with an area.
type VolumeMeasure
    implements IValue, IOrderable, IScaled
{
    Value: Number;
}

//==
// # Dimensionless numbers

// A dimensionless ratio, any real. Removes: a relative chordal default of 1.5
// meant as a percent, passed where a length is expected.
type Ratio
    implements IValue, IOrderable
{
    Value: Number;
}

// A dimensionless number in [0, 1], made by FractionOf, which clamps.
// Removes: a lerp parameter outside its range. Invariant: 0 <= Value <= 1.
type Fraction
    implements IValue, IOrderable
{
    Value: Number;
}

//==
// # Scale factors and rounding

// The scale factor 2^Exponent, the only factor the metamorphic scaling laws
// use: multiplying by it is exact in binary floating point. Removes: a scale
// test that fails on rounding because the factor was 3.
type PowerOfTwoFactor
    implements IValue
{
    Exponent: Integer;
}

// The smallest difference treated as resolvable at some magnitude: what
// ResolutionFor returns, never a bare Number. Removes: a rounding floor
// compared with a tolerance in the wrong direction. Invariant: Value >= 0.
type Resolution
    implements IValue, IOrderable
{
    Value: Number;
}

//==
// # Measures

// The dimension a measured number has. Removes: an angle in radians graded
// against a length bound; a report that prints 0.017 with no unit.
type MeasureKind
    = LengthKind
    | AngleKind
    | ParameterKind
    | AreaKind
    | VolumeKind
    | CountKind
    | RatioKind;

// A number with its dimension: what Check.Worst and Check.Bound are to hold
// (a contract request extends Check; see TRACK.md). Lengths, areas and
// volumes are in model units, angles in radians. Removes: a worst value
// compared with a bound of another dimension.
type Measure
    implements IValue
{
    Value: Number;
    Kind: MeasureKind;
}

//==
// # Catalog: parameters, angles, and parameter ranges (laws)
//
// Laws that compare computed Numbers allow the arithmetic resolution at their
// magnitude (CatalogAgreesToRounding, in catalog-quantities.laws.plato).
//
// Sections, in order:
//  - Helpers
//  - Positions along a range
//  - Angles
//  - Ranges
//  - Periodic ranges
//  - Iso-lines

library CatalogFoundationParametersLaws
{
    //==
    // # Helpers

    // ParameterU for an even k, ParameterV for an odd one.
    CatalogSurfaceParameterAt(k: Integer): SurfaceParameter
        => k % 2 == 0 ? SurfaceParameter.ParameterU : SurfaceParameter.ParameterV;

    //==
    // # Positions along a range

    // The parameter at the fraction where t lies is t, for t in a range of
    // resolvable length.
    Law_Catalog_NormalizedParameterRoundTrips(a: Number, b: Number, t: Number): Boolean
        => RangeOf(a, b).RangeLength > ResolutionAt(a.Abs.Max(b.Abs)) && t >= RangeOf(a, b).Start && t <= RangeOf(a, b).End
            ? CatalogAgreesToRounding(RangeOf(a, b).ParameterAt(RangeOf(a, b).NormalizedIn(t)), t)
            : true;

    //==
    // # Angles

    // A wrapped angle lies in [0, 2 pi).
    Law_Catalog_WrapIsInOneTurn(a: UnwrappedAngle): Boolean
        => a.Value.Radians.CanWrap(Number.Tau)
            ? a.Wrap.Value.Radians >= 0.0 && a.Wrap.Value.Radians < Number.Tau
            : true;

    // Wrapping an angle and lifting it next to itself gives it back.
    Law_Catalog_WrapThenUnwrapNearReferenceIsIdentity(a: UnwrappedAngle): Boolean
        => a.Value.Radians.CanWrap(Number.Tau)
            ? (NearestUnwrapped(a.Wrap, a).Value.Radians - a.Value.Radians).Abs <= ResolutionAt(a.Value.Radians.Abs + Number.Tau)
            : true;

    // The lift lies within half a turn of its reference.
    Law_Catalog_NearestUnwrappedIsWithinHalfTurn(a: UnwrappedAngle, reference: UnwrappedAngle): Boolean
        => a.Value.Radians.CanWrap(Number.Tau) && (a.Value.Radians - reference.Value.Radians).CanWrap(Number.Tau)
            ? (NearestUnwrapped(a.Wrap, reference).Value.Radians - reference.Value.Radians).Abs
                <= Number.Pi + ResolutionAt(reference.Value.Radians.Abs + Number.Tau)
            : true;

    //==
    // # Ranges

    // RangeOf gives Start <= End.
    Law_Catalog_RangeOfIsOrdered(a: Number, b: Number): Boolean
        => RangeOf(a, b).Start <= RangeOf(a, b).End;

    // RangeOf does not depend on the order of its ends.
    Law_Catalog_RangeOfIsSymmetric(a: Number, b: Number): Boolean
        => RangeOf(a, b) == RangeOf(b, a);   // exact by construction

    // RangeOf keeps both ends, in some order.
    Law_Catalog_RangeOfKeepsEnds(a: Number, b: Number): Boolean
        => (RangeOf(a, b).Start == a && RangeOf(a, b).End == b) || (RangeOf(a, b).Start == b && RangeOf(a, b).End == a);   // exact by construction

    // Reversing a traversal twice gives it back.
    Law_Catalog_DirectedRangeReversedTwiceIsIdentity(r: DirectedRange): Boolean
        => r.Reversed.Reversed == r;

    // A traversal and its reverse cover the same parameters.
    Law_Catalog_ReversedRangeCoversSameParameters(r: DirectedRange): Boolean
        => r.Reversed.ToParameterRange == r.ToParameterRange;

    //==
    // # Periodic ranges

    // A periodic range's length lies in [0, Period).
    Law_Catalog_PeriodicRangeLengthIsWithinPeriod(start: Number, end: Number, period: Number): Boolean
        => (end - start).CanWrap(period)
            ? PeriodicRangeOf(start, end, period).Length >= 0.0 && PeriodicRangeOf(start, end, period).Length < period
            : true;

    // A periodic range contains its start.
    Law_Catalog_PeriodicRangeContainsStart(start: Number, end: Number, period: Number): Boolean
        => (end - start).CanWrap(period) ? PeriodicRangeOf(start, end, period).ContainsParameter(start) : true;

    // A periodic range contains the end it was made from.
    Law_Catalog_PeriodicRangeContainsEnd(start: Number, end: Number, period: Number): Boolean
        => (end - start).CanWrap(period) ? PeriodicRangeOf(start, end, period).ContainsParameter(end) : true;

    //==
    // # Iso-lines

    // Every point of an iso-line has the line's fixed value.
    Law_Catalog_IsoLinePointIsOnLine(k: Integer, at: Number, s: Number): Boolean
        => IsoLine(CatalogSurfaceParameterAt(k), at).FixedValueAt(IsoLine(CatalogSurfaceParameterAt(k), at).PointAt(s)) == at;   // exact by construction
}

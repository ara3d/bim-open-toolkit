//==
// # Loops into parameter space with the seam set given: laws (TKT-496)
//
// ImageInFaceGiven and LoopToUvGiven (uv-regions.library.plato) against ImageInFace and LoopToUv
// on every coedge and every bound of every TriangulatedWitness face (the faces of layer 5's six
// sample models, built once per sweep): the seam set SeamEdgesOnce builds once per face answers
// the seam question IsSeamEdgeOf answered per coedge.
//
// Sections, in order:
//  - Agreement

library UvRegionsGivenLaws
{
    //==
    // # Agreement

    // ImageInFaceGiven with the witness face's seam set gives ImageInFace's image for the edge
    // of every coedge of the face.
    Law_ImageInFaceGivenAgrees(w: TriangulatedWitness): Boolean
    {
        var m = w.Model;
        var f = w.Face;
        var seams = m.SeamEdgesOnce(f);
        return m.FaceCoedges(f).All(c => m.ImageInFaceGiven(f, seams, c.Edge) == m.ImageInFace(f, c.Edge));
    }

    // Whether two loops hold the same points and the same sources, in order.
    SameLoop(a: UvLoop, b: UvLoop): Boolean
        => SameUvPoints(a.Points, b.Points)
            && a.Sources.Count == b.Sources.Count && a.Sources.Count.Range.All(i => a.Sources[i] == b.Sources[i]);

    // LoopToUvGiven with the witness face's seam set gives LoopToUv's loop for every bound of
    // the face, under the witness's discretizations.
    Law_LoopToUvGivenAgrees(w: TriangulatedWitness): Boolean
    {
        var m = w.Model;
        var f = w.Face;
        var seams = m.SeamEdgesOnce(f);
        return m.Faces[f].Bounds.All(b => SameLoop(m.LoopToUvGiven(f, seams, b, w.Discretizations), m.LoopToUv(f, b, w.Discretizations)));
    }
}

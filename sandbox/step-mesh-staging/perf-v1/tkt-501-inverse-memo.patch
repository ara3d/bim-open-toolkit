 {
+    //==
+    // # Best candidates
+
+    // The Reduce BestCandidateCounted replaced (TKT-501): the best of the
+    // candidates, each compared by evaluating it and the best again.
+    BestCandidateReference(eval: Function1<Number, Point3D>, p: Point3D, candidates: Array<Number>): Number
+        => candidates.Reduce(candidates[0], (best, t) =>
+            eval(t).Distance(p) < eval(best).Distance(p) - ResolutionAt(eval(best).PositionVector.Length + p.PositionVector.Length).Value ? t : best);
+
+    // The Reduce BestProjectionCounted replaced (TKT-501).
+    BestProjectionReference(surface: BrepSurface, g: GeometrySet, p: Point3D, candidates: Array<UvCoordinate>): UvCoordinate
+        => candidates.Reduce(candidates[0], (b, uv) =>
+            surface.Eval(g, uv).Distance(p) < surface.Eval(g, b).Distance(p) - ResolutionAt(surface.Eval(g, b).PositionVector.Length + p.PositionVector.Length).Value ? uv : b);
+
+    // Five candidates around a parameter of curve fixture k, in order, with
+    // two repeated so a tie is among them.
+    CandidatesAround(k: Integer, t: Number): Array<Number>
+    {
+        var d = k.CurveFixture.Basis;
+        return [d.DomainAt(t.UnitFraction), d.DomainAt((t * 0.37).UnitFraction), d.DomainAt(t.UnitFraction), d.DomainAt((t + 0.5).UnitFraction), d.DomainAt((t * 0.37).UnitFraction)];
+    }
+
+    // BestCandidateCounted picks the candidate the Reduce picked, bit for
+    // bit, for a query point on or beside curve fixture k, and counts one
+    // evaluation per candidate.
+    Law_BestCandidateAgrees(k: Integer, t: Number, h: Number): Boolean
+    {
+        var g = k.CurveFixtureSet;
+        var c = CurveIndex(0);
+        var candidates = k.CandidatesAround(t);
+        var p = g.Eval(c, k.CurveFixture.Basis.DomainAt((t + 0.2).UnitFraction)) + Vector3D(0.0, 0.0, h.UnitFraction);
+        var counted = BestCandidateCounted(x => g.Eval(c, x), p, candidates);
+        return counted.Value == BestCandidateReference(x => g.Eval(c, x), p, candidates)
+            && counted.Work.Evaluations == candidates.Count;
+    }
+
+    // BestProjectionCounted picks the candidate the Reduce picked, bit for
+    // bit, for a point above surface fixture k, and counts one evaluation
+    // per candidate.
+    Law_BestProjectionAgrees(k: Integer, u: Number, v: Number, h: Number): Boolean
+    {
+        var g = k.SurfaceFixtureSet;
+        var s = SurfaceIndex(0);
+        var surface = g.SurfaceAt(s);
+        var d = g.Domain(s);
+        var a = d.SampleIn(UvCoordinate(u.UnitFraction, v.UnitFraction));
+        var b = d.SampleIn(UvCoordinate((u * 0.37).UnitFraction, (v + 0.5).UnitFraction));
+        var candidates = [a, b, a, UvCoordinate(d.U.Range.Start, d.V.Range.Start), b];
+        var p = g.Eval(s, d.SampleIn(UvCoordinate((u + 0.2).UnitFraction, v.UnitFraction))) + Vector3D(0.0, 0.0, h.UnitFraction);
+        var counted = surface.BestProjectionCounted(g, p, candidates);
+        return counted.Value == surface.BestProjectionReference(g, p, candidates)
+            && counted.Work.Evaluations == candidates.Count;
+    }

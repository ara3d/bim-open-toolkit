//==
// # Catalog: the witness arena of catalog-geometry's laws
//
// One GeometrySet holding a record of every BrepCurve and BrepSurface case,
// so a law over an Integer selector reaches every case. Built from literal
// placements (layer 7's WorldFrameAt and FrameAt) and layer 8's B-spline
// fixtures.
//
// Sections, in order:
//  - The arena
//  - Selectors
//==

library CatalogGeometryArena
{
    //==
    // # The arena

    // Curves: 0 line, 1 circle of radius 2, 2 ellipse (3, 1), 3 hyperbola
    // (1, 2), 4 parabola (focal 1/2), 5 polyline, 6 B-spline fixture 0, 7
    // trimmed circle [1/2, 2], 8 composite of 7, 9 offset of 6, 10 surface
    // curve on 0, 11 a unit circle in the xz plane at x = 5 (a profile).
    // Surfaces: 0 plane, 1 cylinder of radius 2, 2 cone (radius 1, semi-angle
    // 1/2 rad), 3 sphere of radius 3, 4 ring torus (4, 1), 5 revolution of
    // curve 11 about z, 6 extrusion of curve 6 by 2 z, 7 B-spline fixture 0,
    // 8 sphere 3 trimmed to [1/2, 5/2] x [-1, 1] with v reversed, 9 plane 0
    // offset by 1.
    Witness_CatalogArena(_: GeometrySet): GeometrySet
    {
        var o = Point3D(0.0, 0.0, 0.0);
        var w = WorldFrameAt(o);
        var profileFrame = FrameAt(Point3D(5.0, 0.0, 0.0), Vector3D(1.0, 0.0, 0.0), Vector3D(0.0, 0.0, 1.0), Vector3D(0.0, -1.0, 0.0));
        return GeometrySet(
            [BrepCurve.Line(o, Vector3D(1.0, 2.0, 0.0)),
                BrepCurve.Circle(w, 2.0),
                BrepCurve.Ellipse(w, 3.0, 1.0),
                BrepCurve.Hyperbola(w, 1.0, 2.0),
                BrepCurve.Parabola(w, 0.5),
                BrepCurve.Polyline([o, Point3D(1.0, 0.0, 0.0), Point3D(1.0, 1.0, 1.0)]),
                BrepCurve.BSpline(0.CurveFixture),
                BrepCurve.Trimmed(CurveIndex(1), NumberInterval(0.5, 2.0), true),
                BrepCurve.Composite([CompositeSegment(CurveIndex(7), true)]),
                BrepCurve.Offset(CurveIndex(6), 0.25, Direction3D(Vector3D(0.0, 0.0, 1.0))),
                BrepCurve.OnSurface(CurveIndex(0), [], PreferredRepresentation.SpaceCurve),
                BrepCurve.Circle(profileFrame, 1.0)],
            [],
            [],
            [BrepSurface.Plane(w),
                BrepSurface.Cylinder(w, 2.0),
                BrepSurface.Cone(w, 1.0, Angle(0.5)),
                BrepSurface.Sphere(w, 3.0),
                BrepSurface.Torus(w, 4.0, 1.0, TorusPart.Full),
                BrepSurface.Revolution(CurveIndex(11), InfiniteLine3D(o, Direction3D(Vector3D(0.0, 0.0, 1.0)))),
                BrepSurface.LinearExtrusion(CurveIndex(6), Vector3D(0.0, 0.0, 2.0)),
                BrepSurface.BSpline(0.SurfaceFixture),
                BrepSurface.RectangularTrimmed(SurfaceIndex(3), NumberInterval(0.5, 2.5), NumberInterval(-1.0, 1.0), true, false),
                BrepSurface.Offset(SurfaceIndex(0), 1.0)],
            []);
    }

    //==
    // # Selectors

    // A surface of the arena chosen by k among the first `count` (any Integer k).
    CatalogSurfaceOf(k: Integer, count: Integer): SurfaceIndex
        => SurfaceIndex(k.FixtureIndex(count));

    // A curve of the arena chosen by k among the first `count`.
    CatalogCurveOf(k: Integer, count: Integer): CurveIndex
        => CurveIndex(k.FixtureIndex(count));

    // A parameter of domain d from any Number x: in [Start + h, End - h] by
    // x's fraction where the range is finite, else in [-1, 1].
    CatalogInside(d: CurveDomain, x: Number, h: Number): Number
        => d.ParameterLength.IsFinite
            ? d.Range.Start + h + (d.Range.End - d.Range.Start - 2.0 * h) * x.UnitFraction
            : 2.0 * x.UnitFraction - 1.0;

    // A parameter in the middle half of domain d from any Number x (in
    // [-1, 1] where the range is not finite): away from poles, where
    // curvature is well conditioned.
    CatalogMiddle(d: CurveDomain, x: Number): Number
        => d.ParameterLength.IsFinite
            ? d.Range.Start + (d.Range.End - d.Range.Start) * (0.25 + 0.5 * x.UnitFraction)
            : 2.0 * x.UnitFraction - 1.0;

    // A point inside surface s's domain from any two Numbers, h from the
    // finite sides.
    CatalogInsideUv(g: GeometrySet, s: SurfaceIndex, u: Number, v: Number, h: Number): UvPoint
        => UvPoint(g.Domain(s).U.CatalogInside(u, h), g.Domain(s).V.CatalogInside(v, h));

    // A point in the middle of surface s's domain from any two Numbers.
    CatalogMiddleUv(g: GeometrySet, s: SurfaceIndex, u: Number, v: Number): UvPoint
        => UvPoint(g.Domain(s).U.CatalogMiddle(u), g.Domain(s).V.CatalogMiddle(v));

    // One of the three signs, chosen by k (any Integer).
    CatalogGeometrySignAt(k: Integer): Sign
    {
        var i = k.FixtureIndex(3);
        return i == 0 ? Sign.Positive : (i == 1 ? Sign.Zero : Sign.Negative);
    }

    // A spline basis chosen by k: the five curve fixtures' bases, then each
    // surface fixture's U and V bases.
    CatalogBasisAt(k: Integer): SplineBasis
    {
        var i = k.FixtureIndex(Integer.CurveFixtureCount + 2 * Integer.SurfaceFixtureCount);
        var j = i - Integer.CurveFixtureCount;
        return i < Integer.CurveFixtureCount
            ? i.CurveFixture.Basis
            : (j % 2 == 0 ? (j / 2).SurfaceFixture.U : (j / 2).SurfaceFixture.V);
    }
}

//==
// # Catalog: spline spans, hulls, and placements
//
// Constructors for catalog-geometry-splines.types.plato.
//
// Sections, in order:
//  - Spans
//  - Hulls
//  - Placements
//==

library CatalogGeometrySplines
{
    //==
    // # Spans

    // The non-empty knot spans of a basis over its domain [Knots[Degree],
    // Knots[Count - Degree - 1]], in increasing order: span i for every knot
    // index i in Degree .. Count - Degree - 2 with Knots[i] < Knots[i + 1].
    // Precondition: KnotsNonDecreasing.
    SpansOf(b: SplineBasis): Array<BSplineSpan>
    {
        var k = b.Knots.Knots;
        var n = k.Count - 2 * b.Degree - 1;
        return (n > 0 ? n : 0).MapRange(j => b.Degree + j)
            .FlatMap(i => k[i] < k[i + 1] ? [BSplineSpan(i, RangeOf(k[i], k[i + 1]))] : BSplineSpan.NoSpans);
    }

    // No spans: the typed empty array.
    NoSpans(_: BSplineSpan): Array<BSplineSpan>
        => [BSplineSpan(0, RangeOf(0.0, 0.0))].Take(0);

    //==
    // # Hulls

    // The control polygon of span sp of a curve: control points
    // sp.Index - Degree .. sp.Index. Precondition: sp is one of
    // SpansOf(d.Basis) and the data IsWellShaped.
    ControlPolygonOf(d: BSplineCurveData, sp: BSplineSpan): ControlPolygon
        => ControlPolygon((d.Basis.Degree + 1).MapRange(j => d.ControlPoints[sp.Index - d.Basis.Degree + j]));

    // The distance from p to the line through a and b; to a where a = b.
    DistanceToLine(a: Point3D, b: Point3D, p: Point3D): Number
        => (b - a).Length > 0.0
            ? (p - a).Cross(b - a).Length / (b - a).Length
            : (p - a).Length;

    // The largest distance of the polygon's points from the line through its
    // first and last points. Precondition: at least one point.
    HullBoundOf(p: ControlPolygon): ConvexHullBound
        => ConvexHullBound(ModelLength(p.Points.Reduce(0.0, (m, q) => m.Max(DistanceToLine(p.Points.First, p.Points.Last, q)))));

    //==
    // # Placements

    // The placement of a checked frame, its handedness copied.
    ToPlacement(f: OrthonormalFrame): Placement
        => Placement(f, f.Handedness);
}

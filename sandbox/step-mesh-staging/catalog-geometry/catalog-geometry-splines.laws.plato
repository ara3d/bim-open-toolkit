//==
// # Catalog: laws of spline spans, hulls, and placements
//
// SpansOf on every basis of layer 8's B-spline fixtures (CatalogBasisAt),
// the hull bound on the curve fixtures, and ToPlacement on every sign.
//
// Sections, in order:
//  - Spans
//  - Hulls
//  - Placements
//==

library CatalogGeometrySplinesLaws
{
    //==
    // # Spans

    // Every span is non-empty: Start < End.
    Law_Catalog_SpansAreNonEmpty(k: Integer): Boolean
        => k.CatalogBasisAt.SpansOf.All(sp => sp.Range.Start < sp.Range.End);

    // A basis with a non-empty domain has at least one span.
    Law_Catalog_SpansExist(k: Integer): Boolean
        => k.CatalogBasisAt.SpansOf.Count >= 1;

    // Spans follow one another: each ends where the next starts, and their
    // knot indices strictly increase.
    Law_Catalog_SpansAreContiguous(k: Integer): Boolean
    {
        var spans = k.CatalogBasisAt.SpansOf;
        return (spans.Count - 1).Max(0).Range.All(i =>
            spans[i].Range.End == spans[i + 1].Range.Start && spans[i].Index < spans[i + 1].Index);   // exact by construction
    }

    // The spans cover the basis's domain: the first starts at its start and
    // the last ends at its end.
    Law_Catalog_SpansCoverDomain(k: Integer): Boolean
    {
        var b = k.CatalogBasisAt;
        var spans = b.SpansOf;
        return spans.Count == 0
            ? false
            : spans.First.Range.Start == b.SplineDomain.Start && spans.Last.Range.End == b.SplineDomain.End;   // exact by construction
    }

    //==
    // # Hulls

    // Every point of a curve fixture's span lies within its control
    // polygon's hull bound of the line through the polygon's ends.
    Law_Catalog_SpanLiesWithinHullBound(k: Integer, j: Integer, f: Number): Boolean
    {
        var d = k.CurveFixture;
        var spans = d.Basis.SpansOf;
        var sp = spans[j.FixtureIndex(spans.Count)];
        var polygon = d.ControlPolygonOf(sp);
        var p = d.BSplinePoint(sp.Range.Start + (sp.Range.End - sp.Range.Start) * f.UnitFraction);
        var scale = 64.0 * d.ControlPoints.Reduce(0.0, (m, q) => m.Max(q.PositionVector.Length));
        return DistanceToLine(polygon.Points.First, polygon.Points.Last, p) <= polygon.HullBoundOf.Bound.Value + ResolutionAt(scale).Value;
    }

    // A control polygon has Degree + 1 points.
    Law_Catalog_ControlPolygonHasDegreePlusOnePoints(k: Integer, j: Integer): Boolean
    {
        var d = k.CurveFixture;
        var spans = d.Basis.SpansOf;
        return d.ControlPolygonOf(spans[j.FixtureIndex(spans.Count)]).Points.Count == d.Basis.Degree + 1;
    }

    // A hull bound read as a sagitta is not attained.
    Law_Catalog_HullSagittaIsBound(k: Integer, j: Integer): Boolean
    {
        var d = k.CurveFixture;
        var spans = d.Basis.SpansOf;
        return !d.ControlPolygonOf(spans[j.FixtureIndex(spans.Count)]).HullBoundOf.ToSagitta.Attained;
    }

    //==
    // # Placements

    // A placement's handedness is its frame's.
    Law_Catalog_PlacementCopiesHandedness(k: Integer): Boolean
        => OrthonormalFrame(WorldFrameAt(Point3D(0.0, 0.0, 0.0)), k.CatalogGeometrySignAt).ToPlacement.Handedness
            == k.CatalogGeometrySignAt;
}

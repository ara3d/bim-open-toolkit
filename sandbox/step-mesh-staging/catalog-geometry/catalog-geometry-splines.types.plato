//==
// # Catalog: spline spans, hulls, and placements
//
// TYPE-CATALOG.md section 6 (layer 1). The non-empty knot span as the unit of
// B-spline work, the control polygon over it, and the hull bound a sagitta
// estimate reads; and the checked placement of placement-based surfaces.
//
// Sections, in order:
//  - Spans
//  - Hulls
//  - Placements
//==

//==
// # Spans

// One non-empty knot span: Index i is the knot index with Range
// [Knots[i], Knots[i + 1]], Start < End. SpansOf is the only constructor.
// Removes: a span index that lands on a repeated knot.
type BSplineSpan
    implements IValue
{
    Index: Integer;
    Range: ParameterRange;
}

//==
// # Hulls

// The control points that shape one span of a curve: Degree + 1 of them, in
// order. Removes: a hull bound read over the whole net.
type ControlPolygon
{
    Points: Array<Point3D>;
}

// The largest distance of a control polygon's points from the line through
// its first and last points. With positive weights the span lies in the
// polygon's convex hull, so no point of it is farther from that line.
// Removes: a sagitta bound read from samples.
type ConvexHullBound
    implements IValue
{
    Bound: ModelLength;
}

//==
// # Placements

// The placement of a placement-based surface: a checked frame and its
// handedness. Handedness repeats Frame.Handedness (TRACK.md, findings);
// ToPlacement copies it. Removes: a bare Frame3D whose determinant sign was
// never read.
type Placement
    implements IValue
{
    Frame: OrthonormalFrame;
    Handedness: Sign;
}

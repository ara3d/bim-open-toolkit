//==
// # Catalog: types borrowed from tracks running beside catalog-geometry
//
// Copied with TYPE-CATALOG.md's shapes exactly, so section 6 compiles before
// the owning tracks merge. The supervisor deletes these at merge in favour of
// the owners' declarations (TRACK.md, "Requests to other tracks").
//
// Sections, in order:
//  - Section 5: decided results
//  - Section 4: checked frames
//==

//==
// # Section 5: decided results

// Why a decided result has no value: the vocabulary every Decided* shares.
// Removes: seven different sentinel conventions.
type UndecidedReason
    = OutOfDomain
    | DegenerateAt(Side: DomainSide)
    | NoConvergence(Iterations: Integer)
    | Unbounded
    | NotApplicable(Kind: String)
    | BelowResolution
    | ToleranceExceeded(By: Measure);

// A surface normal with how it was obtained: an ordinary point, the limit at
// a pole, the limit at a cone's apex, or none. Removes: the +z fallback that
// sent refinement toward the apex.
type SurfaceNormal
    = Regular(Direction: Direction3D)
    | Limit(Direction: Direction3D)
    | Apex(Direction: Direction3D)
    | NoNormal(Reason: UndecidedReason);

// What Project returns. Removes: a projection outside the domain used as if
// inside.
type Projection
    = OnSurface(Uv: UvPoint, Distance: ModelLength)
    | OffDomain(Nearest: UvPoint, Distance: ModelLength)
    | Failed(Reason: UndecidedReason);

//==
// # Section 4: checked frames

// A decoded placement checked orthonormal within AngleTolerance, with its
// determinant's sign. Removes: a mirrored placement whose determinant sign
// was never read.
type OrthonormalFrame
    implements IValue
{
    Frame: Frame3D;
    Handedness: Sign;
}

//==
// # Meshed witnesses: the values (complexity sweep, chunk L1)
//
// The Witness_* values of MeshedWitness and FailedFaceWitness (pipeline-meshed-witness.types.plato),
// each meshed once per sweep, and the mesh of a run without its validation, for laws that read only
// the mesh of a second, perturbed run.
//
// Sections, in order:
//  - Building a witness
//  - Positive witnesses
//  - The planted bad face
//  - Unvalidated meshes

library StepToMeshMeshedWitnesses
{
    //==
    // # Building a witness

    // Model m named name, meshed with MeshModel under the witness options.
    MeshedWitnessOf(m: BrepModel, name: String): MeshedWitness
        => MeshedWitness(name, m, m.MeshModel(MeshingOptions.WitnessOptions));

    //==
    // # Positive witnesses
    //
    // Layer 7's witnesses whose faces are planar and bounded by lines: MeshModel builds each in
    // under 10 s compiled. The curved witnesses of WitnessAt are left out: the unit cylinder's
    // MeshModel did not finish in 10 minutes on the compiled backend (TRACK.md, "Findings"), and a
    // witness the runner cannot build stalls every compiled sweep over the type.

    // The unit box: 8 vertices, 12 triangles, no refinement round.
    Witness_UnitBoxMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_UnitBox.MeshedWitnessOf("UnitBox");

    // The block 3 x 3 x 1 with a 1 x 1 square through hole: genus 1.
    Witness_BlockWithThroughHoleMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_BlockWithThroughHole.MeshedWitnessOf("BlockWithThroughHole");

    // The hollow box 2 x 2 x 2 around a void 1 x 1 x 1: two shells.
    Witness_HollowBoxMeshed(_: MeshedWitness): MeshedWitness
        => BrepModel.Witness_HollowBox.MeshedWitnessOf("HollowBox");

    //==
    // # The planted bad face

    // Witness_BoxWithPolyLoopSheet meshed, with its planted face 6 and the three loop states the
    // failure-isolation law compares.
    Witness_PlantedBadFaceRun(_: FailedFaceWitness): FailedFaceWitness
    {
        var m = BrepModel.Witness_BoxWithPolyLoopSheet;
        var o = MeshingOptions.WitnessOptions;
        var f = BrepFaceIndex.PlantedBadFace;
        return FailedFaceWitness(m.MeshedWitnessOf("BoxWithPolyLoopSheet"), f,
            m.InitialState(o, m.AllFaces), m.FinalState(o, m.AllFaces), m.FinalState(o, m.AllFaces.Excluding(f)));
    }

    //==
    // # Unvalidated meshes

    // The mesh MeshModel(o) gives m, without the validation MeshModel runs on it: the final state
    // assembled when the run is defined, the refused outcome's mesh otherwise. Bit-identical to
    // m.MeshModel(o).Mesh (Law_Perf_UnvalidatedMeshIsMeshModels).
    UnvalidatedMesh(m: BrepModel, o: MeshingOptions): ModelMesh
        => m.IsRunnable(o) ? m.AssembledMesh(m.FinalState(o, m.AllFaces)) : m.RefusedOutcome(o).Mesh;

    // The mesh of m under the witness options, for a law that reads only the mesh: WitnessMesh's
    // mesh without the validation.
    WitnessMeshUnvalidated(m: BrepModel): ModelMesh
        => m.UnvalidatedMesh(MeshingOptions.WitnessOptions);
}

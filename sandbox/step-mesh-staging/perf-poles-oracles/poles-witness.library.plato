//==
// # Curved witnesses meshed once per sweep: the values (complexity sweep, chunk L5)
//
// The Witness_* values of PoleWitness (poles-witness.types.plato): each curved witness of
// 07-validation/poles.laws.plato meshed once, round zero only and without validation, at the
// chordal bound its laws name. A witness whose build exceeds 20 s on the compiled backend is left
// out (TRACK.md, "Findings"): the runner builds every witness before any law, with no time limit.
//
// Sections, in order:
//  - Building a witness
//  - The witnesses

library PolesWitnesses
{
    //==
    // # Building a witness

    // Model m meshed once at PolesOptionsAt(chordal, false); whole when the whole-model claims are
    // stated at that bound.
    PoleWitnessOf(m: BrepModel, name: String, chordal: Number, whole: Boolean, euler: Integer, volumeModel: BrepModel): PoleWitness
        => m.PoleWitnessFrom(name, PolesOptionsAt(chordal, false), whole, euler, volumeModel,
            m.DiscretizeAll(PolesOptionsAt(chordal, false).Face.Discretization, SegmentFloors.NoFloors));

    // The witness from its discretizations: every face meshed once and assembled, as
    // RoundZeroModelMesh does.
    PoleWitnessFrom(m: BrepModel, name: String, o: MeshingOptions, whole: Boolean, euler: Integer, volumeModel: BrepModel, d: EdgeDiscretizations): PoleWitness
    {
        var faceMeshes = m.Faces.Count.MapRange(f => m.MeshFace(BrepFaceIndex(f), d, o.Face).Mesh);
        return PoleWitness(name, m, o, whole, euler, volumeModel, d, faceMeshes,
            m.AssembleModelMesh(faceMeshes, m.NumberMeshVertices(d, faceMeshes)));
    }

    //==
    // # The witnesses

    // The seamed unit sphere at 0.05: Law_SphereMeshIsSound and Law_SphereGaussBonnet.
    Witness_SpherePoles(_: PoleWitness): PoleWitness
        => BrepModel.Witness_Sphere.PoleWitnessOf("Sphere", 0.05, true, 2, BrepModel.Witness_Sphere);

    // The ring torus at 0.05: Law_TorusMeshIsSound, Law_TorusGaussBonnet, Law_TorusFaceChecksHold.
    Witness_TorusPoles(_: PoleWitness): PoleWitness
        => BrepModel.Witness_Torus.PoleWitnessOf("Torus", 0.05, true, 0, BrepModel.Witness_Torus);

    // The unit cone at 0.01: Law_ConeMeshIsSound, Law_ConeGaussBonnet, Law_ConeFaceChecksHold.
    Witness_ConePoles(_: PoleWitness): PoleWitness
        => BrepModel.Witness_Cone.PoleWitnessOf("Cone", 0.01, true, 2, BrepModel.Witness_Cone);

    // The whole torus pinned at a vertex at 0.05: Law_TorusAtVertexMeshIsSound,
    // Law_TorusAtVertexFaceChecksHold.
    Witness_TorusAtVertexPoles(_: PoleWitness): PoleWitness
        => BrepModel.Witness_TorusAtVertex(2.0, 0.5).PoleWitnessOf("TorusAtVertex", 0.05, true, 0, BrepModel.Witness_TorusAtVertex(2.0, 0.5));

    // The sphere bounded by two pole vertex loops at 0.05: Law_SphereByPoleLoopsMeshIsSound.
    Witness_SphereByPoleLoopsPoles(_: PoleWitness): PoleWitness
        => BrepModel.Witness_SphereByPoleLoops(1.0).PoleWitnessOf("SphereByPoleLoops", 0.05, true, 2, BrepModel.Witness_SphereByPoleLoops(1.0));

    // The sphere with redundant pole loops at 0.05, judged against the seamed sphere's volume:
    // Law_RedundantPoleLoopsMeshIsSound.
    Witness_RedundantPoleLoopsPoles(_: PoleWitness): PoleWitness
        => BrepModel.Witness_SphereWithRedundantPoleLoops(1.0).PoleWitnessOf("RedundantPoleLoops", 0.05, true, 2, BrepModel.Witness_Sphere);

    // The seamed unit sphere at 0.01, face checks only: Law_SphereFaceChecksHold.
    Witness_SphereFineFacePoles(_: PoleWitness): PoleWitness
        => BrepModel.Witness_Sphere.PoleWitnessOf("SphereFine", 0.01, false, 2, BrepModel.Witness_Sphere);

    // The pole-loop sphere at 0.01, face checks only: Law_SphereByPoleLoopsFaceChecksHold.
    Witness_SphereByPoleLoopsFineFacePoles(_: PoleWitness): PoleWitness
        => BrepModel.Witness_SphereByPoleLoops(1.0).PoleWitnessOf("SphereByPoleLoopsFine", 0.01, false, 2, BrepModel.Witness_SphereByPoleLoops(1.0));
}

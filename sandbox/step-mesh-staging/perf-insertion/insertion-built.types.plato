//==
// # Insertion into builders: types (complexity sweep, chunk R1, TKT-383)
//
// The two values the builder form of the refinement passes trades in: a triangulation beside
// the surface position of each of its points, so a pass never evaluates a point twice, and the
// result of one trial insertion as the writes it would make, so a refused trial copies nothing.
//
// Sections, in order:
//  - Positions
//  - Trials

//==
// # Positions

// A triangulation and the surface point of each of its parameter points: Positions[i] is the
// face's surface evaluated at Triangulation.Points[i]. Carried through the refinement's passes,
// so each point is evaluated once, when it is inserted.
// Removes: the corner evaluations TryInsertion and LiftedAngleOf repeated per candidate.
type PositionedTriangulation
{
    Triangulation: UvTriangulation;
    Positions: Array<Point3D>;
}

//==
// # Trials

// Triangle writes: triangle Slots[i] becomes Triangles[i]. A slot at or past the triangle count
// is an append; appends come in increasing order.
type TriangleWrites
{
    Slots: Array<Integer>;
    Triangles: Array<TriangleFace>;
}

// Neighbour table writes: slot Slots[i] becomes Values[i], in order (a later write to the same
// slot wins).
type SlotWrites
{
    Slots: Array<Integer>;
    Values: Array<Integer>;
}

// The outcome of one trial insertion of a parameter point into a pass's builders, as the writes
// that keep it. Kept is false for a refused point, and then the writes are empty. Otherwise the
// Triangles writes are made (Appended of them appends), 3 * Appended neighbour slots of -1 are
// added, and the Neighbours writes are made. Point, Chart and Position are the new point's
// parameters, chart point and surface point (the origin when it was not evaluated). Evaluations
// counts the surface evaluations the trial made (0 or 1).
// Removes: the copies of the points and triangles TryInsertion made for every candidate.
type TrialInsertion
{
    Kept: Boolean;
    Point: UvCoordinate;
    Chart: Point2D;
    Position: Point3D;
    Triangles: TriangleWrites;
    Appended: Integer;
    Neighbours: SlotWrites;
    Evaluations: Integer;
}

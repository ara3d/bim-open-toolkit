diff --git a/sandbox/step-brep-mesh/03-step/step-vertex-pairs.library.plato b/sandbox/step-brep-mesh/03-step/step-vertex-pairs.library.plato
new file mode 100644
index 0000000..768ef36
--- /dev/null
+++ b/sandbox/step-brep-mesh/03-step/step-vertex-pairs.library.plato
@@ -0,0 +1,82 @@
+//==
+// # Two touching vertices of one shell are welded (TKT-493, v1-jody J11)
+//
+// In CEL/LENA-R8.STEP face 258 two hole loops touch corner to corner twice: vertices 2516 and
+// 2517 lie 2.5e-6 apart, 2569 and 2570 6.3e-6 apart, under a length tolerance of 0.01, and each
+// also ends a wall edge from one shared vertex, so two pockets meet along a line. Reduced merges
+// only vertices an edge or a loop's head-to-tail joint brings together, so each pair stays two
+// records and face 258's region crosses itself within the tolerance (FACE-LOOP-NOT-SIMPLE).
+// Welding them inside the face instead makes the mesh edge between them belong to two model
+// edges; merging the two model vertices, with every edge kept, does not.
+//
+// PairsWelded merges, in each shell, two vertices that are each other's only vertex within the
+// length tolerance (their coincidence class has exactly two members), when each lies on the arc
+// of an edge that ends at the other. A class of three or more is left as it is: a chain of
+// coincident pairs can join vertices farther apart than the tolerance, and a raised tolerance
+// that merged wider classes joined distinct vertices in TKT-472's MAX and ZOE files. The later
+// vertex merges into the earlier; a vertex two shells would weld differently is welded once, by
+// the first shell. Each weld is a MergedInto repair and a VertexPairWelded diagnostic (Sewn's
+// WithMerges).
+//
+// Sections, in order:
+//  - Pairs
+//  - The raw model
+
+library StepVertexPairs
+{
+    //==
+    // # Pairs
+
+    // The positions, among coincidence roots (each item's class's first item), of the items whose
+    // class has exactly two members and that are not that class's first: the later member of
+    // every isolated pair.
+    IsolatedPairMembers(roots: Array<Integer>): Array<Integer>
+    {
+        var members = roots.Count.Range.FlatMap(k => roots[k] != k ? [k] : Integer.NoIndices);
+        var classOf = members.Map(k => roots[k]).Sort((a, b) => a <= b);
+        return members.FlatMap(k => classOf.Reduce(0, (n, r) => r == roots[k] ? n + 1 : n) == 1 ? [k] : Integer.NoIndices);
+    }
+
+    // Whether vertex a lies within the length tolerance of the arc of an edge of shell s that ends
+    // at vertex b and not at a, the arc's end points included (LiesOnEdgeArc, or within the
+    // tolerance of either end). For a pair within the tolerance of each other this holds as soon
+    // as b ends an edge that does not end at a: the rule's force is in the pair being isolated and
+    // joined by no edge.
+    LiesOnEdgeEndingAt(m: BrepModel, s: ShellIndex, a: Integer, b: Integer): Boolean
+        => m.EdgesOfShell(s).Any(e =>
+            ((m.Edges[e].Start.Value == b || m.Edges[e].End.Value == b) && m.Edges[e].Start.Value != a && m.Edges[e].End.Value != a)
+                ? (m.LiesOnEdgeArc(e, m.Vertices[a].Point)
+                    || m.Vertices[a].Point.Distance(m.Vertices[m.Edges[e].Start.Value].Point) <= m.Tolerances.Length.Value
+                    || m.Vertices[a].Point.Distance(m.Vertices[m.Edges[e].End.Value].Point) <= m.Tolerances.Length.Value)
+                : false);
+
+    // The welds shell s asks for, each [later vertex, earlier vertex]: the isolated coincident
+    // pairs among the vertices its edges reach, each lying on an edge that ends at the other.
+    ShellPairWelds(m: BrepModel, s: ShellIndex): Array<Array<Integer>>
+    {
+        var vs = DistinctSorted(m.EdgesOfShell(s).FlatMap(e => [m.Edges[e].Start.Value, m.Edges[e].End.Value]));
+        var roots = m.CoincidenceRootsByGrid(vs.Map(v => m.Vertices[v].Point));
+        return IsolatedPairMembers(roots).FlatMap(k =>
+            (m.LiesOnEdgeEndingAt(s, vs[k], vs[roots[k]]) && m.LiesOnEdgeEndingAt(s, vs[roots[k]], vs[k]))
+                ? [[vs[k], vs[roots[k]]]]
+                : [[0, 0]].Take(0));
+    }
+
+    // For every vertex, the vertex it is welded into, or itself: every shell's welds in shell
+    // order, the first for a vertex winning, none into a welded vertex.
+    PairWeldRoots(m: BrepModel): Array<Integer>
+        => FirstValidTargets(m.Vertices.Count, m.Shells.Count.Range.FlatMap(s => m.ShellPairWelds(ShellIndex(s))));
+
+    //==
+    // # The raw model
+
+    // The raw model with every isolated pair welded (WithMerges, no edge merged); the raw model as
+    // it is when no shell has such a pair. Precondition: raw.Model.IsEveryIndexInRange.
+    PairsWelded(raw: RawDecodedModel): RawDecodedModel
+    {
+        var roots = raw.Model.PairWeldRoots;
+        return roots.Count.Range.All(v => roots[v] == v)
+            ? raw
+            : raw.WithMerges(roots, raw.Model.Edges.Count.MapRange(e => e), StepDiagnosticCode.VertexPairWelded, StepDiagnosticCode.ShellEdgeSewn);
+    }
+}

diff --git a/sandbox/step-brep-mesh/08-pipeline/pipeline-vertex-pairs.laws.plato b/sandbox/step-brep-mesh/08-pipeline/pipeline-vertex-pairs.laws.plato
new file mode 100644
index 0000000..a60fb18
--- /dev/null
+++ b/sandbox/step-brep-mesh/08-pipeline/pipeline-vertex-pairs.laws.plato
@@ -0,0 +1,94 @@
+//==
+// # Two touching vertices of one shell are welded: laws (TKT-493, v1-jody J11)
+//
+// The witness is CEL/LENA-R8 face 258's touching holes in miniature: a 10 by 10 square plane face
+// with two square holes, [2, 5]^2 and [5 - d, 8]^2, whose nearest corners overlap by d in x and
+// in y, d = 0.2 length tolerances, joined by no edge. The library leaves the two corners apart and
+// the face unmeshed (its loops cross within the tolerance); PairWeldRoots welds exactly that pair,
+// and the welded face, its holes sharing one vertex, meshes. A coincidence class of three is not welded. No positive
+// witness and no raw witness has a pair to weld.
+//
+// Sections, in order:
+//  - The witness
+//  - Laws
+
+library VertexPairLaws
+{
+    //==
+    // # The witness
+
+    // The corners of the face's three loops: the outer square counter-clockwise about +z, each
+    // hole clockwise.
+    TouchingHolesLoops(_: Integer, d: Number): Array<Array<Point3D>>
+        => [[Point3D(0.0, 0.0, 0.0), Point3D(10.0, 0.0, 0.0), Point3D(10.0, 10.0, 0.0), Point3D(0.0, 10.0, 0.0)],
+            [Point3D(2.0, 2.0, 0.0), Point3D(2.0, 5.0, 0.0), Point3D(5.0, 5.0, 0.0), Point3D(5.0, 2.0, 0.0)],
+            [Point3D(5.0 - d, 5.0 - d, 0.0), Point3D(5.0 - d, 8.0, 0.0), Point3D(8.0, 8.0, 0.0), Point3D(8.0, 5.0 - d, 0.0)]];
+
+    // A one-face model of the loops: one vertex per corner, one line edge per side, the face on the
+    // plane z = 0 in one open shell of a shell-set body, under the witness tolerances.
+    PolygonFaceModel(_: BrepModel, loops: Array<Array<Point3D>>): BrepModel
+    {
+        var first = Offsets(loops.Map(l => l.Count));
+        var points = loops.FlatMap(l => l);
+        var n = points.Count;
+        var next = loops.Count.Range.FlatMap(k => loops[k].Count.MapRange(i => first[k] + (i + 1) % loops[k].Count));
+        var curves = n.MapRange(v => BrepCurve.Line(points[v], points[next[v]] - points[v]));
+        var edges = n.MapRange(v => BrepEdge(BrepVertexIndex(v), BrepVertexIndex(next[v]), CurveIndex(v), true));
+        var bloops = loops.Count.MapRange(k => BrepLoop.EdgeLoop(loops[k].Count.MapRange(i => Coedge(BrepEdgeIndex(first[k] + i), EdgeOrientation.Forward))));
+        return BrepModel(
+            GeometrySet(curves, [], [], [BrepSurface.Plane(WorldFrameAt(Point3D(0.0, 0.0, 0.0)))], []),
+            points.Map(p => BrepVertex(p)), edges, bloops,
+            [BrepFace(SurfaceIndex(0), true, loops.Count.MapRange(k => FaceBound(BrepLoopIndex(k), true, k == 0)))],
+            [BrepShell([BrepFaceIndex(0)], false)],
+            [BrepBody.ShellSet([ShellIndex(0)])],
+            Tolerances.Witness_Tolerances, LengthUnit.Metre);
+    }
+
+    // The witness: the holes' nearest corners overlapping by 0.2 tolerances in x and in y.
+    TouchingHoles(_: BrepModel): BrepModel
+        => BrepModel.PolygonFaceModel(0.TouchingHolesLoops(0.2 * Tolerances.Witness_Tolerances.Length.Value));
+
+    // Whether face 0 of m meshes, its edges discretized and the face meshed by the host's options.
+    FaceZeroMeshes(m: BrepModel): Boolean
+    {
+        var o = HostMeshingOptions(0.01);
+        var d = m.DiscretizeAll(o.Face.Discretization, SegmentFloors.NoFloors);
+        return m.MeshFace(BrepFaceIndex(0), d, o.Face).Mesh.IsEmptyFaceMesh.Not;
+    }
+
+    //==
+    // # Laws
+
+    // The touching holes: PairWeldRoots welds exactly the second hole's first corner (vertex 8)
+    // into the first hole's third (vertex 6); the face does not mesh as written and meshes welded.
+    Law_V1Jody_TouchingHolesWelded(_: Integer): Boolean
+    {
+        var m = BrepModel.TouchingHoles;
+        var roots = m.PairWeldRoots;
+        var welded = m.SewnModelWith(roots, m.Edges.Count.MapRange(e => e));
+        return roots.Count.Range.All(v => v == 8 ? roots[v] == 6 : roots[v] == v)
+            && m.FaceZeroMeshes.Not
+            && welded.Vertices.Count == m.Vertices.Count - 1
+            && welded.FaceZeroMeshes;
+    }
+
+    // Only a class of exactly two is a pair: roots [0, 0, 2] give member 1, [0, 0, 0] none, and
+    // [0, 1, 1, 0] members 2 and 3.
+    Law_V1Jody_IsolatedPairsOnly(_: Integer): Boolean
+    {
+        var a = IsolatedPairMembers([0, 0, 2]);
+        var b = IsolatedPairMembers([0, 0, 0]);
+        var c = IsolatedPairMembers([0, 1, 1, 0]);
+        return (a.Count == 1 ? a[0] == 1 : false)
+            && b.Count == 0
+            && (c.Count == 2 ? c[0] == 2 && c[1] == 3 : false);
+    }
+
+    // No positive witness has a pair to weld.
+    Law_V1Jody_NoPairOnWitnesses(_: Integer): Boolean
+        => 10.Range.All(k => BrepModel.WitnessAt(k).PairWeldRoots.Count.Range.All(v => BrepModel.WitnessAt(k).PairWeldRoots[v] == v));
+
+    // No raw witness's preparation welds a pair.
+    Law_V1Jody_NoWeldInRawWitnesses(raw: RawDecodedModel): Boolean
+        => raw.PrepareModel.Diagnostics.All(x => x.Code != "STEP-VERTEX-PAIR-WELDED");
+}

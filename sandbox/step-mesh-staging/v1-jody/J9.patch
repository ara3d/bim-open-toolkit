@@ -814,6 +829,9 @@ library FaceMeshing
             NeighbourDensity => Diagnostic(Severity.Info, "FACE-EDGE-NEIGHBOUR-DENSITY",
                 "A neighbouring edge is denser than this one; the edge is asked to refine to match.",
                 Provenance.KernelEdge(q.Edge), q.Chordal);
+            FoldAgainstBoundary => Diagnostic(Severity.Warning, "FACE-FOLD-AGAINST-BOUNDARY",
+                "A triangle of a face folds against a boundary segment of this edge, and refinement inside the face cannot split that segment; the face is meshed and the edge is asked for twice as many segments.",
+                Provenance.KernelEdge(q.Edge), q.Chordal);
         };
 

+
+    // True when the host's refinement loop answers a request (layer 8's BlockingRequests keeps it
+    // pending): a blocking one, or a fold against a boundary segment, which keeps its face's mesh
+    // but needs a finer edge that only the loop can give (fold-requests.library.plato).
+    IsAnsweredByHost(reason: RefinementReason): Boolean

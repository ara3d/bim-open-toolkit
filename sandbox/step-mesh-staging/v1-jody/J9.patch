diff --git a/sandbox/step-brep-mesh/05-face-meshing/face-meshing-fold-requests.library.plato b/sandbox/step-brep-mesh/05-face-meshing/face-meshing-fold-requests.library.plato
new file mode 100644
index 0000000..5ce1b6a
--- /dev/null
+++ b/sandbox/step-brep-mesh/05-face-meshing/face-meshing-fold-requests.library.plato
@@ -0,0 +1,55 @@
+//==
+// # A fold against a boundary segment asks for a finer edge (v1-jody J9, after v1-faces' P2 draft)
+//
+// Refinement splits a folded triangle by inserting points inside the face, but a boundary segment
+// is locked, and an inserted point must stay the effective minimum length from the corners it
+// joins. On a strip narrower than the edge's segments are long, that leaves folds: on
+// SHO/c211_case_with_odin_v1.step's B-spline strips (about 0.2 mm wide, boundary segments about
+// 5 mm long under a 1 mm chordal bound) 21 long thin triangles lie across a stretch that bends by
+// more than the strip is wide, and wind against the face normal although every corner lies on the
+// surface. Only a finer edge helps. FoldRequestsOf asks, for every drawn triangle that folds when
+// lifted (LiftsFacingFaceNormal false) and has a side on a model edge's discretization longer
+// than twice the effective minimum length, for that edge to be split into twice as many segments
+// (RefinementReason.FoldAgainstBoundary). The request keeps the face's mesh (IsBlocking false), so
+// a fold the rounds cannot resolve is kept rather than lost; the host's loop answers it
+// (IsAnsweredByHost), each round halving the boundary segments a fold sits on until the fold goes,
+// the segments reach twice the minimum length, or the round limit is reached.
+//
+// Sections, in order:
+//  - Requests
+
+library FaceMeshingFoldRequests
+{
+    //==
+    // # Requests
+
+    // Whether side j of triangle k of face f's triangulation t (corners j and j + 1) is a
+    // segment of edge e's discretization longer than twice the effective minimum length: a side
+    // a finer edge would split.
+    IsSplittableBoundarySide(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, t: UvTriangulation, k: Integer, j: Integer, e: BrepEdgeIndex, least: Number): Boolean
+    {
+        var a = t.Triangles[k].Corner(j);
+        var b = t.Triangles[k].Corner(j + 1);
+        return m.IsDiscretizationSegment(d, e, t.Sources[a], t.Sources[b])
+            ? m.Geometry.Eval(m.SurfaceOf(f), t.Points[a]).Distance(m.Geometry.Eval(m.SurfaceOf(f), t.Points[b])) > 2.0 * least
+            : false;
+    }
+
+    // The FoldAgainstBoundary requests of triangulation t of face f, its edges discretized as d:
+    // one per model edge with a splittable segment (IsSplittableBoundarySide) that is a side of a
+    // drawn triangle (not collapsed at a pole) folding when lifted, asking for twice the edge's
+    // segments at the criteria's chordal.
+    FoldRequestsOf(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, t: UvTriangulation, c: FaceMeshingCriteria): Array<EdgeRefinementRequest>
+    {
+        var edges = m.FaceEdges(f);
+        var least = c.Discretization.EffectiveMinLength(m.Tolerances);
+        var folded = t.Triangles.Count.Range.FlatMap(k =>
+            t.IsCollapsedElement(ElementIndex(k)) ? Integer.NoIndices
+            : (m.LiftsFacingFaceNormal(f, t, ElementIndex(k)) ? Integer.NoIndices : [k]));
+        var hit = folded.FlatMap(k => 3.Range.FlatMap(j => edges.FlatMap(e =>
+            m.IsSplittableBoundarySide(f, d, t, k, j, e, least) ? [e] : edges.Take(0))));
+        return edges.FlatMap(e => hit.Any(h => h == e)
+            ? [EdgeRefinementRequest(e, RefinementReason.FoldAgainstBoundary, c.Discretization.Chordal, 2 * (d.ByEdge[e.Value].Points.Count - 1).Max(1))]
+            : EdgeRefinementRequest.NoRequests);
+    }
+}

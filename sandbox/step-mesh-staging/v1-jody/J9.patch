diff --git a/sandbox/step-brep-mesh/08-pipeline/pipeline-fold-requests.laws.plato b/sandbox/step-brep-mesh/08-pipeline/pipeline-fold-requests.laws.plato
new file mode 100644
index 0000000..aebaea6
--- /dev/null
+++ b/sandbox/step-brep-mesh/08-pipeline/pipeline-fold-requests.laws.plato
@@ -0,0 +1,75 @@
+//==
+// # A fold against a boundary segment asks for a finer edge: laws (v1-jody J9)
+//
+// The witness is SHO/c211_case_with_odin_v1.step's face 45 (pipeline-corpus-witness-c211-45,
+// extracted with `step-corpus-harness extract c211_case_with_odin_v1.step 45 <out> --name
+// C211Strip45`): a B-spline strip about 0.2 mm wide whose first mesh, under the host's 1 mm
+// chordal bound, holds a long thin triangle wound against the face normal. Its first outcome asks
+// for a finer edge (FoldAgainstBoundary), the host's loop keeps the request pending and answers it,
+// and the final mesh has no flipped triangle. On the ten positive witnesses no face asks it.
+//
+// Sections, in order:
+//  - Counting
+//  - Laws
+
+library FoldRequestLaws
+{
+    //==
+    // # Counting
+
+    // Whether triangle x of face mesh fm winds against its corners' normals: its lifted vector
+    // area points away from the sum of the normals stored at its corners.
+    IsFlippedTriangle(fm: FaceMesh, x: TriangleFace): Boolean
+    {
+        var a = fm.Positions[fm.LocalVertex[x.A.Value].Value];
+        var b = fm.Positions[fm.LocalVertex[x.B.Value].Value];
+        var c = fm.Positions[fm.LocalVertex[x.C.Value].Value];
+        var n = fm.Normals[x.A.Value].Vector + fm.Normals[x.B.Value].Vector + fm.Normals[x.C.Value].Vector;
+        return (b - a).Cross(c - a).Dot(n) < 0.0;
+    }
+
+    // How many triangles of face mesh fm are flipped.
+    FlippedTriangleCount(fm: FaceMesh): Integer
+        => fm.Triangles.Reduce(0, (k, x) => fm.IsFlippedTriangle(x) ? k + 1 : k);
+
+    // Whether any request asks for a finer edge against a fold.
+    AsksFoldRefinement(rs: Array<EdgeRefinementRequest>): Boolean
+        => rs.Any(q => q.Reason.ReasonName == "FoldAgainstBoundary");
+
+    //==
+    // # Laws
+
+    // c211's strip 45 under the host's options: the first pass has a flipped triangle and asks
+    // for a finer edge against it; the request stays pending in the host's loop; the final state
+    // of that loop has no flipped triangle and nothing pending.
+    Law_V1Jody_C211Strip45FoldResolved(_: Integer): Boolean
+    {
+        var m = BrepModel.Witness_C211Strip45;
+        var o = HostMeshingOptions(1.0);
+        var chosen = m.AllFaces;
+        var first = m.InitialState(o, chosen);
+        var s0 = BlockingStateOf(first.Discretizations, first.Outcomes, chosen);
+        var last = m.FinalStateAnsweringBlocking(o, chosen, s0);
+        return first.Outcomes[0].Mesh.FlippedTriangleCount > 0
+            && first.Outcomes[0].Requests.AsksFoldRefinement
+            && s0.Pending.AsksFoldRefinement
+            && last.Outcomes[0].Mesh.FlippedTriangleCount == 0
+            && last.Pending.Count == 0;
+    }
+
+    Measure_V1Jody_C211Strip45FoldResolved(_: Integer): Number
+    {
+        var m = BrepModel.Witness_C211Strip45;
+        var o = HostMeshingOptions(1.0);
+        var chosen = m.AllFaces;
+        var first = m.InitialState(o, chosen);
+        return m.FinalStateAnsweringBlocking(o, chosen, BlockingStateOf(first.Discretizations, first.Outcomes, chosen))
+            .Outcomes[0].Mesh.FlippedTriangleCount.ToNumber;
+    }
+
+    // No face of the ten positive witnesses, meshed by the host's options at 0.05, asks for a finer
+    // edge against a fold.
+    Law_V1Jody_NoFoldRequestOnWitnesses(_: Integer): Boolean
+        => 10.Range.All(k => BrepModel.WitnessAt(k).InitialState(HostMeshingOptions(0.05), BrepModel.WitnessAt(k).AllFaces)
+            .Outcomes.All(x => x.Requests.AsksFoldRefinement.Not));
+}

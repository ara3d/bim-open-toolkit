//==
// # Surface curves whose master pcurve closes or runs along a period: laws (v1-jody, J5, TKT-414)
//
// Two witnesses, each a model of one edge on a surface curve whose master is pcurve 0:
// - CircleSplineEdge: NINA-B222's 2D B-spline circle (pcurve #1200 of edge 600, radius 0.6
//   about (1.6, 1.75) in the plane z = 0, three rational quadratic arcs, outer knots -2 pi / 3
//   and 8 pi / 3), from the spline's point at parameter a to its point at b; a = b is the closed
//   edge. The library gives the closed edge [a, a] and the arc across the join a backward range;
//   with the fix, one period and the arc's forward range.
// - ResidueLineEdge: v1-edges' surface-curve witness (a circle of radius 0.3 on a cylinder,
//   mastered by the 2D line (0, 0.5) + t (1, w)) with w = 2.83e-16, the v residue NINA-B222's
//   lines carry. The library gives no period and a range IsTractableRange refuses;
//   with the fix, the arc's range [pi / 2, pi].
// - LongLineEdge: a line edge of length 1,000, which the discretizer refuses at the host's
//   criteria while layer 8's guard accepts it: the silent path; with the fix, reported.
// On every positive witness and every edge of v1-edges' witness the fixed edge domain is the
// library's, and the fixed edge diagnostics are the library's.
//
// Sections, in order:
//  - Witnesses
//  - Laws

library V1JodySurfaceCurvePcurveDomainLaws
{
    //==
    // # Witnesses

    // NINA-B222's 2D B-spline circle, pcurve #1200's record as decoded.
    CircleSpline2D(_: Integer): BSplineCurve2DData
        => BSplineCurve2DData(
            SplineBasis(2, KnotVector([-2.094395102393, 0.0, 0.0, 2.094395102393, 2.094395102393,
                4.188790204786, 4.188790204786, 6.28318530718, 6.28318530718, 8.377580409573])),
            [UvCoordinate(2.2, 1.75), UvCoordinate(2.2, 1.057179676972), UvCoordinate(1.6, 1.403589838486),
             UvCoordinate(1.0, 1.75), UvCoordinate(1.6, 2.096410161514), UvCoordinate(2.2, 2.442820323028),
             UvCoordinate(2.2, 1.75)],
            [1.0, 0.5, 1.0, 0.5, 1.0, 0.5, 1.0]);

    // The arena of CircleSplineEdge: curve 0 the space circle, curve 1 the surface curve over it
    // mastered by pcurve 0, the spline on the plane z = 0 (surface 0, world axes).
    CircleSplineArena(_: Integer): GeometrySet
        => GeometrySet(
            [BrepCurve.Circle(WorldFrameAt(Point3D(1.6, 1.75, 0.0)), 0.6),
             BrepCurve.OnSurface(CurveIndex(0), [CurveSupport.Parametric(PcurveIndex(0))], PreferredRepresentation.FirstPcurve)],
            [BrepCurve2D.BSpline(0.CircleSpline2D)],
            [Pcurve(SurfaceIndex(0), Curve2DIndex(0))],
            [BrepSurface.Plane(WorldFrameAt(Point3D(0.0, 0.0, 0.0)))],
            []);

    // One edge on the surface curve from the pcurve's point at a to its point at b; one vertex
    // when a = b, the closed edge.
    CircleSplineEdge(_: BrepModel, a: Number, b: Number): BrepModel
    {
        var g = 0.CircleSplineArena;
        var pa = g.Eval(PcurveIndex(0), a);
        var pb = g.Eval(PcurveIndex(0), b);
        return BrepModel(g,
            a == b ? [BrepVertex(pa)] : [BrepVertex(pa), BrepVertex(pb)],
            [BrepEdge(BrepVertexIndex(0), BrepVertexIndex(a == b ? 0 : 1), CurveIndex(1), true)],
            [], [], [], [],
            Tolerances.Witness_Tolerances,
            LengthUnit.Metre);
    }

    // v1-edges' SurfaceCurveEdge with the line's velocity (speed, w).
    ResidueLineEdge(_: BrepModel, a: Number, b: Number, speed: Number, w: Number): BrepModel
        => BrepModel(
            GeometrySet(
                [BrepCurve.Circle(WorldFrameAt(Point3D(0.0, 0.0, 0.5)), 0.3),
                 BrepCurve.OnSurface(CurveIndex(0), [CurveSupport.Parametric(PcurveIndex(0))], PreferredRepresentation.FirstPcurve)],
                [BrepCurve2D.Line(UvCoordinate(0.0, 0.5), Vector2D(speed, w))],
                [Pcurve(SurfaceIndex(0), Curve2DIndex(0))],
                [BrepSurface.Cylinder(WorldFrameAt(Point3D(0.0, 0.0, 0.0)), 0.3)],
                []),
            [BrepVertex(Point3D(0.3 * a.Cos, 0.3 * a.Sin, 0.5)), BrepVertex(Point3D(0.3 * b.Cos, 0.3 * b.Sin, 0.5))],
            [BrepEdge(BrepVertexIndex(0), BrepVertexIndex(1), CurveIndex(1), true)],
            [], [], [], [],
            Tolerances.Witness_Tolerances,
            LengthUnit.Metre);

    // One line edge from the origin to (length, 0, 0), on no face.
    LongLineEdge(_: BrepModel, length: Number): BrepModel
        => BrepModel(
            GeometrySet([BrepCurve.Line(Point3D(0.0, 0.0, 0.0), Vector3D(1.0, 0.0, 0.0))], [], [], [], []),
            [BrepVertex(Point3D(0.0, 0.0, 0.0)), BrepVertex(Point3D(length, 0.0, 0.0))],
            [BrepEdge(BrepVertexIndex(0), BrepVertexIndex(1), CurveIndex(0), true)],
            [], [], [], [],
            Tolerances.Witness_Tolerances,
            LengthUnit.Metre);

    // The v residue of NINA-B222's lines along u.
    Residue(_: Integer): Number
        => 2.83e-16;

    // Whether r is [start, end] within tol.
    IsRange(r: NumberInterval, start: Number, end: Number, tol: Number): Boolean
        => (r.Start - start).Abs <= tol && (r.End - end).Abs <= tol;

    // Whether every edge of m gets the library's edge range from EdgeDomainV1, exactly.
    SameEdgeDomains(m: BrepModel): Boolean
        => m.Edges.Count.Range.All(i =>
            m.EdgeDomainV1(BrepEdgeIndex(i)).Range.Start == m.EdgeDomain(BrepEdgeIndex(i)).Range.Start
            && m.EdgeDomainV1(BrepEdgeIndex(i)).Range.End == m.EdgeDomain(BrepEdgeIndex(i)).Range.End);

    //==
    // # Laws

    // A line along u whose v velocity is a rounding residue has the period of u over its speed,
    // where the library finds none; an exactly axial line keeps its period, a slanted one keeps
    // none.
    Law_V1Jody_ResidueLineHasPeriod(_: Integer): Boolean
    {
        var d = BrepSurface.Cylinder(WorldFrameAt(Point3D(0.0, 0.0, 0.0)), 0.3).Domain(GeometrySet([], [], [], [], []));
        var residue = BrepCurve2D.Line(UvCoordinate(0.0, 0.5), Vector2D(-1.0, 0.Residue));
        var axial = BrepCurve2D.Line(UvCoordinate(0.0, 0.5), Vector2D(-1.0, 0.0));
        var slanted = BrepCurve2D.Line(UvCoordinate(0.0, 0.5), Vector2D(-1.0, 0.001));
        return residue.ParameterPeriodOn(d) == 0.0
            && (residue.ParameterPeriodOnV1(d) - Number.Tau).Abs <= 1e-12
            && axial.ParameterPeriodOnV1(d) == axial.ParameterPeriodOn(d)
            && slanted.ParameterPeriodOnV1(d) == 0.0;
    }

    // The arc from pi / 2 to pi on the residue line: the library's range is not tractable; the
    // fixed range is [pi / 2, pi] and is.
    Law_V1Jody_ResidueLineEdgeRange(_: Integer): Boolean
    {
        var pi = Number.Pi;
        var m = BrepModel.ResidueLineEdge(pi / 2.0, pi, 1.0, 0.Residue);
        var e = BrepEdgeIndex(0);
        var c = DefaultCriteria(0.001);
        var fixedRange = m.EdgeDomainV1(e).Range;
        return m.IsTractableRange(e, c, m.EdgeDomain(e).Range).Not
            && fixedRange.IsRange(pi / 2.0, pi, 1e-9)
            && m.IsTractableRange(e, c, fixedRange);
    }

    // The 2D B-spline circle closes by its record; the closed edge on it gets [a, a] from the
    // library and one period, 2 pi, from the fix; the arc from 5.5 to 0.8 across the join gets
    // a backward range from the library and [5.5, 0.8 + 2 pi] from the fix.
    Law_V1Jody_ClosedSplineMasterRanges(_: Integer): Boolean
    {
        var tau = Number.Tau;
        var closed = BrepModel.CircleSplineEdge(0.0, 0.0);
        var arc = BrepModel.CircleSplineEdge(5.5, 0.8);
        var e = BrepEdgeIndex(0);
        var closedBefore = closed.EdgeDomain(e).Range;
        var closedAfter = closed.EdgeDomainV1(e).Range;
        var arcBefore = arc.EdgeDomain(e).Range;
        return BrepCurve2D.BSpline(0.CircleSpline2D).IsClosedRecord
            && closedBefore.Start == closedBefore.End
            && ((closedAfter.End - closedAfter.Start) - tau).Abs <= 1e-9
            && arcBefore.Start > arcBefore.End
            && arc.EdgeDomainV1(e).Range.IsRange(5.5, 0.8 + tau, 1e-6);
    }

    // The fixed edge domain is the library's on every edge of the ten positive witnesses and of
    // v1-edges' surface-curve witnesses, whose lines are exactly axial.
    Law_V1Jody_EdgeDomainV1Unchanged(_: Integer): Boolean
    {
        var pi = Number.Pi;
        return 10.Range.All(k => BrepModel.WitnessAt(k).SameEdgeDomains)
            && BrepModel.SurfaceCurveEdge(pi / 2.0, pi, 1.0).SameEdgeDomains
            && BrepModel.SurfaceCurveEdge(0.0 - pi / 4.0, pi / 4.0, 1.0).SameEdgeDomains
            && BrepModel.SurfaceCurveEdge(pi / 2.0, pi, 2.0).SameEdgeDomains;
    }

    // The silent 0, reported. At the host's criteria for a chordal bound of 0.001 the minimum
    // length is 1e-4, so IsTractableRange refuses a range longer than 2^20 of them, about 105:
    // a line edge of length 1,000 is Undiscretized while the library's CanDiscretizeInRange
    // accepts it, and layer 8 reports nothing, the path NINA-B222's long ranges took (edges
    // 1498, 1500, 1507, 1510). The fixed guard refuses it, and the fixed diagnostics hold one
    // PIPELINE-EDGE-UNDISCRETIZED whose measure is the range's span, 1,000. The residue-line
    // arc, whose library range runs backwards, is reported by both. On every positive witness
    // the fixed diagnostics are the library's (none).
    Law_V1Jody_SilentUndiscretizedReported(_: Integer): Boolean
    {
        var o = HostMeshingOptions(0.001);
        var c = o.Face.Discretization;
        var e = BrepEdgeIndex(0);
        var m = BrepModel.LongLineEdge(1000.0);
        var found = m.EdgeDiagnosticsInRangeV1(o);
        var residue = BrepModel.ResidueLineEdge(Number.Pi / 2.0, Number.Pi, 1.0, 0.Residue);
        return m.DiscretizeAllRanged(c, SegmentFloors.NoFloors).ByEdge[0].IsDiscretized.Not
            && m.CanDiscretizeInRange(e, c)
            && m.EdgeDiagnosticsInRange(o).Count == 0
            && m.CanDiscretizeInRangeV1(e, c).Not
            && found.Count == 1
            && (found.Count == 1 ? found[0].Code == "PIPELINE-EDGE-UNDISCRETIZED" && (found[0].Measure - 1000.0).Abs <= 1e-9 : false)
            && residue.EdgeDiagnosticsInRange(o).Count == 1
            && residue.EdgeDiagnosticsInRangeV1(o).Count == 1
            && 10.Range.All(k => BrepModel.WitnessAt(k).EdgeDiagnosticsInRangeV1(o).Count == BrepModel.WitnessAt(k).EdgeDiagnosticsInRange(o).Count);
    }
}

//==
// # The empty array of indices (track v1-jody, chunk J4)
//
// Layer 0's helper for the rejected case of a filter, staged here until the merge applies
// J4.patch, which adds the same function to 00-foundation/foundation.library.plato beside
// Corresponds; delete this file then. The staged J3 copies (reduced-flat.library.plato) call it.

library V1JodyNoIndices
{
    // The empty array of indices, for the rejected case of a filter written as a FlatMap:
    // `n.Range.FlatMap(k => keep(k) ? [k] : Integer.NoIndices)`. It builds one element and keeps
    // none; an empty written `n.Range.Take(0)` builds all n indices first (a Range is built
    // eagerly), once per rejected element, which makes the filter quadratic.
    NoIndices(_: Integer): Array<Integer>
        => [0].Take(0);
}

//==
// # Reduced without a quadratic empty (track v1-jody, chunk J3)
//
// Layer 3's Reduced builds the empty case of three filters as `n.Range.Take(0)` (and
// `m.Edges.Count.Range.Take(0)`). A Range is built eagerly, so each vertex or edge the filter
// rejects allocates an array of all n vertices or all E edges first: O(V^2 + 2E^2) per model.
// On the corpus, prepare time over E^2 is about constant on the large files (SHO/ELLA-W1.STEP
// 9.9 s and RCB-F9T 9.6 s at about 20,000 edges each), and prepare is the largest serial stage.
// Here each empty is `Integer.NoIndices` (layer 0, chunk J4): one element built,
// none kept. The result is Reduced's, element for element. ChangedSensePositions in
// step-loop-chaining.library.plato has the same pattern per loop; its copy is below.
//
// Sections, in order:
//  - Reduced
//  - Loop chaining

library V1JodyReducedFlat
{
    //==
    // # Reduced

    // Layer 3's Reduced with each filter's empty case `Integer.NoIndices`; otherwise line for line.
    ReducedFlat(raw: RawDecodedModel): RawDecodedModel
    {
        var m = raw.Model;
        var g = m.Geometry;
        var tol = m.Tolerances.Length;
        var n = m.Vertices.Count;
        var candidates = m.VertexJoints;
        var joints = candidates.FlatMap(p => p[0] != p[1] && m.Vertices[p[0]].Point.Coincident(m.Vertices[p[1]].Point, tol) ? [p] : candidates.Take(0));
        var roots = ClassRoots(n, joints.Map(p => p[0]), joints.Map(p => p[1]));
        var vertexAt = n.MapRange(v => roots[v] == v).Renumbering;
        var decisions = m.Edges.Map(e => g.RunsBackToStartDecided(e.Curve, tol));
        var closes = decisions.Map(d => d.IsClosed);
        var undecided = decisions.Map(d => !d.IsDecided);
        var dropped = m.Edges.Count.MapRange(e => roots[m.Edges[e].Start.Value] == roots[m.Edges[e].End.Value] && !closes[e] && !undecided[e]);
        var edgeAt = dropped.Map(d => !d).Renumbering;
        var closedJoin = new Buffer<Boolean>(n);
        var i = 0;
        while (i < n)
        {
            closedJoin = closedJoin.Set(i, false);
            i = i + 1;
        }
        var j = 0;
        while (j < m.Edges.Count)
        {
            var start = m.Edges[j].Start.Value;
            var end = m.Edges[j].End.Value;
            if (closes[j] && start != end && roots[start] == roots[end])
            {
                closedJoin = closedJoin.Set(start, true);
                closedJoin = closedJoin.Set(end, true);
            }
            j = j + 1;
        }
        var joinedByClosedEdge = closedJoin.Freeze();
        var merged = n.Range.FlatMap(k => roots[k] == k ? Integer.NoIndices : [k]);
        var drops = m.Edges.Count.Range.FlatMap(k => dropped[k] ? [k] : Integer.NoIndices);
        var unsettled = m.Edges.Count.Range.FlatMap(k => undecided[k] ? [k] : Integer.NoIndices);
        var mergeRepairs = merged.Map(k => RepairRecord(raw.Sources.Vertices[k], StepRepair.MergedInto(BrepVertexIndex(vertexAt[roots[k]]), BrepVertexIndex(k))));
        var dropRepairs = drops.Map(k => RepairRecord(raw.Sources.Edges[k], StepRepair.DroppedZeroLengthEdge(BrepEdgeIndex(k))));
        var mergeFindings = merged.Map(k => Diagnose(
            joinedByClosedEdge[k] ? StepDiagnosticCode.ClosedEdgeVerticesMerged : StepDiagnosticCode.DuplicateVertexMerged,
            Provenance.AtInstance(raw.Sources.Vertices[k].Instance),
            m.Vertices[k].Point.Distance(m.Vertices[roots[k]].Point)));
        var dropFindings = drops.Map(k => Diagnose(
            StepDiagnosticCode.ZeroLengthEdgeDropped,
            Provenance.AtInstance(raw.Sources.Edges[k].Instance),
            m.Vertices[m.Edges[k].Start.Value].Point.Distance(m.Vertices[m.Edges[k].End.Value].Point)));
        var unsettledFindings = unsettled.Map(k => Diagnose(
            StepDiagnosticCode.EdgeClosureUndecided,
            Provenance.AtInstance(raw.Sources.Edges[k].Instance),
            raw.Sources.Curves[m.Edges[k].Curve.Value].Instance.Value.ToNumber));
        var vertices = n.Range.FlatMap(k => roots[k] == k ? [m.Vertices[k]] : m.Vertices.Take(0));
        var edges = drops.Count == 0 && merged.Count == 0 ? m.Edges
            : m.Edges.Count.Range.FlatMap(k => dropped[k] ? m.Edges.Take(0)
                : [BrepEdge(BrepVertexIndex(vertexAt[roots[m.Edges[k].Start.Value]]), BrepVertexIndex(vertexAt[roots[m.Edges[k].End.Value]]), m.Edges[k].Curve, m.Edges[k].SameSense)]);
        var loops = drops.Count == 0 && merged.Count == 0 ? m.Loops
            : m.Loops.Map(l => m.ReducedLoop(l, roots, vertexAt, dropped, edgeAt));
        var s = raw.Sources;
        var sources = KernelSources(
            n.Range.FlatMap(k => roots[k] == k ? [s.Vertices[k]] : s.Vertices.Take(0)),
            m.Edges.Count.Range.FlatMap(k => dropped[k] ? s.Edges.Take(0) : [s.Edges[k]]),
            s.Loops, s.Faces, s.Shells, s.Bodies, s.Curves, s.Curves2D, s.Pcurves, s.Surfaces);
        return RawDecodedModel(
            BrepModel(g, vertices, edges, loops, m.Faces, m.Shells, m.Bodies, m.Tolerances, m.Unit),
            raw.Occurrences,
            sources,
            raw.Folds,
            raw.Repairs.Concatenate(mergeRepairs).Concatenate(dropRepairs),
            raw.Units,
            raw.LengthFactor,
            raw.AngleFactor,
            raw.Diagnostics.Concatenate(mergeFindings).Concatenate(dropFindings).Concatenate(unsettledFindings));
    }

    //==
    // # Loop chaining

    // Layer 3's ChangedSensePositions with each empty `Integer.NoIndices`.
    ChangedSensePositionsFlat(a: BrepLoop, b: BrepLoop): Array<Integer>
    {
        var before = a.CoedgesOf;
        var after = b.CoedgesOf;
        return before.Count == after.Count
            ? before.Count.Range.FlatMap(i => before[i].IsForward == after[i].IsForward ? Integer.NoIndices : [i])
            : Integer.NoIndices;
    }
}

//==
// # Surface curves whose master pcurve closes or runs along a period (track v1-jody, J5, TKT-414)
//
// In SHO/NINA-B222-W1x2.STEP, 16 SURFACE_CURVE edges whose master representation is their first
// pcurve returned 0 segments with no diagnostic. Two causes, eight edges each:
//
// - The master is a 2D B-spline circle on a plane (a rational quadratic of three arcs, its first
//   and last control points the same point, the knots at its domain ends of multiplicity 2, the
//   outer knots -2 pi / 3 and 8 pi / 3). A plane has no period, so MasterPcurveDomain returned
//   the spline's own domain [0, 2 pi], Aperiodic: layer 3 decides no closure for a 2D curve. A
//   closed edge on it got the range [a, a]; an arc across the join got a range that runs
//   backwards ([5.47, 0.81]). Both fail IsTractableRange.
// - The master is a 2D line along u on a cylinder whose velocity's v component is a rounding
//   residue written in the file (7e-17 to 6e-16). ParameterPeriodOn tests that component for
//   exact zero, so the line had no period, its search domain was unbounded, and the closest
//   parameters of its vertices came out near 1e14: a range IsTractableRange refuses.
//
// The fixes: a velocity component counts as zero when it is within the arithmetic resolution of
// the other (ParameterPeriodOnV1); and a master 2D curve that its record shows closed (a B-spline
// whose domain-end knots have multiplicity at least the degree, so its ends are its first and
// last control points, and those two are the same point; a polyline whose first and last points
// are the same) gives the surface curve its domain made Closed (MasterPcurveDomainV1).
//
// Neither cause reported anything: layer 8's EdgeDiagnosticsInRange asks CanDiscretizeInRange,
// which tests only Start < End, while the discretizer refuses every range IsTractableRange
// refuses. CanDiscretizeInRangeV1 asks the discretizer's own test, and UndiscretizedEdgeMeasured
// says which ranges are refused and carries the range's span (End - Start) as its measure:
// 0 for an empty range, negative for a reversed one, huge for an absurd one.
//
// For the laws, the edge-domain path is copied with the two fixes (DomainV1, the pcurve search,
// ClosestParameterV1, EdgeDomainV1); at merge the two bodies change and the copies go.
//
// Sections, in order:
//  - Lines along a period
//  - Closed master pcurves
//  - The edge domain with both fixes
//  - Diagnostics

library V1JodySurfaceCurvePcurveDomain
{
    //==
    // # Lines along a period

    // Whether x is zero beside y: within the arithmetic resolution at y's magnitude, as a
    // velocity component written as a rounding residue of a direction along the other is.
    IsNegligibleBeside(x: Number, y: Number): Boolean
        => x.Abs <= ResolutionAt(y).Value;

    // Layer 1's ParameterPeriodOn with a velocity component negligible beside the other counted
    // as zero: a line along u or v, that direction's period over the speed in it; 0 otherwise.
    ParameterPeriodOnV1(curve: BrepCurve2D, d: SurfaceDomain): Number
        => match (curve)
        {
            Line(origin, velocity) => velocity.X != 0.0 && velocity.Y.IsNegligibleBeside(velocity.X)
                ? d.U.Periodicity.PeriodOr(0.0) / velocity.X.Abs
                : (velocity.Y != 0.0 && velocity.X.IsNegligibleBeside(velocity.Y) ? d.V.Periodicity.PeriodOr(0.0) / velocity.Y.Abs : 0.0);
            Circle(placement, radius) => 0.0;
            Ellipse(placement, semiAxis1, semiAxis2) => 0.0;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => 0.0;
            Parabola(placement, focalDistance) => 0.0;
            Polyline(points) => 0.0;
            BSpline(data) => 0.0;
            Trimmed(basis, range, sameSense) => 0.0;
            Composite(segments) => 0.0;
            Offset(basis, distance) => 0.0;
        };

    // Layer 1's PcurveParameterPeriod with ParameterPeriodOnV1.
    PcurveParameterPeriodV1(g: GeometrySet, p: PcurveIndex): Number
        => g.Domain(p).HasSeam
            ? g.Domain(p).Periodicity.PeriodOr(0.0)
            : g.Curve2DAt(g.PcurveAt(p).Curve).ParameterPeriodOnV1(g.Domain(g.PcurveAt(p).Surface));

    //==
    // # Closed master pcurves

    // Whether the knots at the ends of the domain, u_1 .. u_p and u_n .. u_{n+p-1} for n control
    // points and degree p, are each one value: the curve's ends are then its first and last
    // control points, whatever the outermost knots u_0 and u_{n+p} are (they weight no basis
    // function on the domain). Clamped knots (HasClampedEnds) are the case where those outer
    // knots repeat too. Precondition: the basis is well shaped for n control points.
    HasInterpolatedEnds(b: SplineBasis, n: Integer): Boolean
        => b.Degree.Range.All(i => b.Knots.KnotAt(i + 1) == b.Knots.KnotAt(b.Degree))
            && b.Degree.Range.All(i => b.Knots.KnotAt(n + i) == b.Knots.KnotAt(n));

    // Whether two parameter-plane points are the same, coordinate for coordinate.
    SameUv(a: UvCoordinate, b: UvCoordinate): Boolean
        => a.U == b.U && a.V == b.V;

    // Whether the 2D record closes by its record alone: a B-spline with interpolated ends whose
    // first and last control points are the same point, or a polyline whose first and last
    // points are; false for every other record (a circle or ellipse already has a periodic
    // domain).
    IsClosedRecord(curve: BrepCurve2D): Boolean
        => match (curve)
        {
            Line(origin, velocity) => false;
            Circle(placement, radius) => false;
            Ellipse(placement, semiAxis1, semiAxis2) => false;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => false;
            Parabola(placement, focalDistance) => false;
            Polyline(points) => points.Count > 2 ? points.First.SameUv(points.Last) : false;
            BSpline(data) => data.ControlPoints.Count > data.Basis.Degree
                ? data.Basis.HasInterpolatedEnds(data.ControlPoints.Count) && data.ControlPoints.First.SameUv(data.ControlPoints.Last)
                : false;
            Trimmed(basis, range, sameSense) => false;
            Composite(segments) => false;
            Offset(basis, distance) => false;
        };

    // Layer 1's MasterPcurveDomain with both fixes: [0, T) periodic when p's space point repeats
    // with parameter period T (PcurveParameterPeriodV1) on a domain with no seam; p's bounded
    // domain made Closed when p's 2D record closes (IsClosedRecord); p's own domain otherwise.
    MasterPcurveDomainV1(g: GeometrySet, p: PcurveIndex): CurveDomain
    {
        var own = g.Domain(p);
        var period = g.PcurveParameterPeriodV1(p);
        return (period > 0.0 && own.HasSeam.Not)
            ? CurveDomain(NumberInterval(0.0, period), Periodicity.Periodic(period))
            : ((own.HasSeam.Not && own.ParameterLength.IsFinite && own.ParameterLength > 0.0 && g.Curve2DAt(g.PcurveAt(p).Curve).IsClosedRecord)
                ? CurveDomain(own.Range, Periodicity.Closed(own.ParameterLength))
                : own);
    }

    //==
    // # The edge domain with both fixes

    // Layer 1's Domain(g, c) with MasterPcurveDomainV1 for a surface curve with a pcurve master.
    DomainV1(g: GeometrySet, c: CurveIndex): CurveDomain
        => g.CurveAt(c).IsPcurveMastered
            ? g.MasterPcurveDomainV1(g.CurveAt(c).MasterOf).WithClosure(g.IsMarkedClosed(c))
            : g.Domain(c);

    // Whether the record is a surface curve whose master is a pcurve.
    IsPcurveMastered(curve: BrepCurve): Boolean
        => match (curve)
        {
            Line(origin, velocity) => false;
            Circle(placement, radius) => false;
            Ellipse(placement, semiAxis1, semiAxis2) => false;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => false;
            Parabola(placement, focalDistance) => false;
            Polyline(points) => false;
            BSpline(data) => false;
            Trimmed(basis, range, sameSense) => false;
            Composite(segments) => false;
            Offset(basis, distance, reference) => false;
            OnSurface(spaceCurve, supports, master) => supports.MasterPcurve(master).IsNone.Not;
        };

    // The master pcurve of a surface curve with a pcurve master. Precondition: IsPcurveMastered.
    MasterOf(curve: BrepCurve): PcurveIndex
        => match (curve)
        {
            Line(origin, velocity) => PcurveIndex(-1);
            Circle(placement, radius) => PcurveIndex(-1);
            Ellipse(placement, semiAxis1, semiAxis2) => PcurveIndex(-1);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => PcurveIndex(-1);
            Parabola(placement, focalDistance) => PcurveIndex(-1);
            Polyline(points) => PcurveIndex(-1);
            BSpline(data) => PcurveIndex(-1);
            Trimmed(basis, range, sameSense) => PcurveIndex(-1);
            Composite(segments) => PcurveIndex(-1);
            Offset(basis, distance, reference) => PcurveIndex(-1);
            OnSurface(spaceCurve, supports, master) => supports.MasterPcurve(master);
        };

    // Layer 1's PcurveSearchDomain with PcurveParameterPeriodV1.
    PcurveSearchDomainV1(g: GeometrySet, p: PcurveIndex): CurveDomain
        => g.PcurveParameterPeriodV1(p) > 0.0 && !g.Domain(p).Periodicity.IsPeriodic
            ? CurveDomain(NumberInterval(0.0, g.PcurveParameterPeriodV1(p)), Periodicity.Periodic(g.PcurveParameterPeriodV1(p)))
            : g.Domain(p);

    // Layer 1's ClosestParameter(g, p, q) for a pcurve with PcurveSearchDomainV1.
    PcurveClosestParameterV1(g: GeometrySet, p: PcurveIndex, q: Point3D): Number
        => g.IsStraightPcurve(p)
            ? (q - g.Eval(p, 0.0)).Dot(g.Derivative(p, 0.0)) / g.Derivative(p, 0.0).LengthSquared
            : MinimizeOverDomain(t => g.Eval(p, t), t => g.Derivative(p, t), q, g.PcurveSearchDomainV1(p),
                g.Curve2DAt(g.PcurveAt(p).Curve).Breaks(g, Integer.SearchBreakOrder));

    // Layer 1's ClosestParameter(g, c, q) with PcurveClosestParameterV1 for a pcurve master.
    ClosestParameterV1(g: GeometrySet, c: CurveIndex, q: Point3D): Number
        => g.CurveAt(c).IsPcurveMastered
            ? g.PcurveClosestParameterV1(g.CurveAt(c).MasterOf, q)
            : g.ClosestParameter(c, q);

    // Layer 2's EdgeDomain with DomainV1 and ClosestParameterV1.
    EdgeDomainV1(m: BrepModel, e: BrepEdgeIndex): CurveDomain
        => m.Geometry.DomainV1(m.Edges[e].Curve).TraversalDomain(
            m.Geometry.ClosestParameterV1(m.Edges[e].Curve, m.Vertices[m.FirstVertexAlongCurve(e)].Point),
            m.Geometry.ClosestParameterV1(m.Edges[e].Curve, m.Vertices[m.LastVertexAlongCurve(e)].Point),
            m.IsClosedEdge(e));

    //==
    // # Diagnostics

    // Layer 4's CanDiscretizeInRange with the discretizer's own range test: the criteria are well
    // formed, the edge is evaluable, and IsTractableRange accepts its range, exactly when
    // DiscretizeEdgeRangedCounted discretizes it rather than return Undiscretized.
    CanDiscretizeInRangeV1(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria): Boolean
        => (c.IsWellFormed && m.IsEdgeEvaluable(e)) ? m.IsTractableRange(e, c, m.EdgeDomain(e).Range) : false;

    // Layer 8's UndiscretizedEdge with the refused ranges named and measured: the range's span
    // End - Start when the edge is evaluable (0 for an empty range, negative for a reversed one,
    // huge or not finite for an absurd one), Unmeasured when it is not.
    UndiscretizedEdgeMeasured(m: BrepModel, e: BrepEdgeIndex): Diagnostic
        => Diagnostic(Severity.Error, "PIPELINE-EDGE-UNDISCRETIZED",
            "This edge cannot be discretized: its curve cannot be evaluated, or its parameter range is empty, reversed, not finite, or longer than 2^20 minimum segments; no face that cites it is meshed. Measure is the range's span (End - Start).",
            Provenance.KernelEdge(e),
            m.IsEdgeEvaluable(e) ? m.EdgeDomain(e).Range.End - m.EdgeDomain(e).Range.Start : Number.Unmeasured);

    // Layer 8's EdgeDiagnosticsInRange with CanDiscretizeInRangeV1 and UndiscretizedEdgeMeasured:
    // one error per edge DiscretizeEdgeRangedCounted leaves undiscretized, in edge order.
    EdgeDiagnosticsInRangeV1(m: BrepModel, o: MeshingOptions): Array<Diagnostic>
    {
        var inRange = m.Law_IndicesInRange;
        return m.Edges.Count.Range.FlatMap(i =>
            (inRange ? m.CanDiscretizeInRangeV1(BrepEdgeIndex(i), o.Face.Discretization) : false)
                ? Diagnostic.NoDiagnostics
                : [m.UndiscretizedEdgeMeasured(BrepEdgeIndex(i))]);
    }
}

//==
// # The closure of a B-spline written in wrapped form: laws (track v1-jody, TKT-431)
//
// The witnesses are two curves of SHO/M2-JODY-W377-00C_PCIE-UART.step. #64592 is a cubic
// B-spline with 19 control points (a 16-sided polygon round the origin, its first 3 points
// repeated at the end) and 23 uniform knots from -0.1875 in steps of 0.0625, so its domain is
// [0, 1]; its ends are (0.5, 0, 0), the vertex of the one-edge loop that cites it. #66971 is the
// same form at radius 0.2 with non-uniform knots written to 13 digits; its ends are (0.2, 0, 0). The record test
// decides it closed, its evaluated ends agree, and with the Closed mark a closed edge on it gets
// the domain [0, 1] and is discretized; without the mark, the library today, it gets [0, 0] and
// is Undiscretized. A wrapped record with one end point moved, or one knot spacing changed,
// stays Undecided; a clamped record keeps EndsClosure's answer.
//
// Sections, in order:
//  - Witnesses
//  - Laws

library V1JodyWrappedSplineClosureLaws
{
    //==
    // # Witnesses

    // The 16 points of the control polygon as written in the file, starting at angle -pi / 8
    // and turning counter-clockwise.
    JodyPolygon(_: Integer): Array<Point3D>
        => [Point3D(0.473965935791, -0.196323118707, 0.0), Point3D(0.513017032104, 0.0, 0.0),
            Point3D(0.473965935791, 0.196323118707, 0.0), Point3D(0.362757822265, 0.362757822265, 0.0),
            Point3D(0.196323118707, 0.473965935791, 0.0), Point3D(0.0, 0.513017032104, 0.0),
            Point3D(-0.196323118707, 0.473965935791, 0.0), Point3D(-0.362757822265, 0.362757822265, 0.0),
            Point3D(-0.473965935791, 0.196323118707, 0.0), Point3D(-0.513017032104, 0.0, 0.0),
            Point3D(-0.473965935791, -0.196323118707, 0.0), Point3D(-0.362757822265, -0.362757822265, 0.0),
            Point3D(-0.196323118707, -0.473965935791, 0.0), Point3D(0.0, -0.513017032104, 0.0),
            Point3D(0.196323118707, -0.473965935791, 0.0), Point3D(0.362757822265, -0.362757822265, 0.0)];

    // A cubic record with the given control points and knots and unit weights.
    JodySplineWith(_: Integer, points: Array<Point3D>, knots: Array<Number>): BSplineCurveData
        => BSplineCurveData(SplineBasis(3, KnotVector(knots)), points, points.Count.MapRange(i => 1.0));

    // The 23 uniform knots of the corpus record: -0.1875 + 0.0625 k.
    JodyKnots(_: Integer): Array<Number>
        => 23.MapRange(k => -0.1875 + 0.0625 * k.ToNumber);

    // The corpus record: the polygon with its first 3 points repeated at the end.
    JodySpline(_: Integer): BSplineCurveData
    {
        var polygon = 0.JodyPolygon;
        return 0.JodySplineWith(polygon.Concatenate(polygon.Take(3)), 0.JodyKnots);
    }

    // Curve #66971's record in the same file: radius 0.2, its knots written to 13 digits, so
    // its end spacings differ from its start's by up to 2e-14.
    JodySmallSpline(_: Integer): BSplineCurveData
    {
        var polygon = [
            Point3D(0.18967555348, -0.07858112429181, 0.0), Point3D(0.205010275835, 0.00002371132387864, 0.0),
            Point3D(0.190304056929, 0.07893906388967, 0.0), Point3D(0.144807218227, 0.144700853294, 0.0),
            Point3D(0.07906718750256, 0.19063821079, 0.0), Point3D(0.0001993478632908, 0.204657020882, 0.0),
            Point3D(-0.07888288554866, 0.190733287463, 0.0), Point3D(-0.14457599748, 0.144849255074, 0.0),
            Point3D(-0.19064674792, 0.07909182705437, 0.0), Point3D(-0.204654658136, 0.0001927319595052, 0.0),
            Point3D(-0.190734248319, -0.07888092080296, 0.0), Point3D(-0.144847779952, -0.144577206884, 0.0),
            Point3D(-0.07909674205786, -0.190643880704, 0.0), Point3D(-0.0001744427477158, -0.204664974088, 0.0),
            Point3D(0.0788130707891, -0.190696071565, 0.0), Point3D(0.144878815692, -0.144958435172, 0.0)];
        return 0.JodySplineWith(polygon.Concatenate(polygon.Take(3)), [
            -0.187582275494, -0.124832971948, -0.062416485974, 0.0, 0.06260407284398,
            0.124972954925, 0.1872559969, 0.250005300446, 0.312288342421,
            0.375037645967, 0.437320687942, 0.500069991488, 0.562353033463,
            0.625102337009, 0.687385378985, 0.750134682531, 0.812417724506,
            0.875167028052, 0.937583514026, 1.0, 1.062604072844, 1.124972954925,
            1.1872559969]);
    }

    // The corpus record with its last control point moved 0.01 along z: not in wrapped form.
    JodySplineMovedEnd(_: Integer): BSplineCurveData
    {
        var points = 0.JodySpline.ControlPoints;
        return 0.JodySplineWith(19.MapRange(i => i == 18 ? Point3D(points[i].X, points[i].Y, 0.01) : points[i]), 0.JodyKnots);
    }

    // The corpus record with its last knot moved from 1.1875 to 1.25: the end spacings differ.
    JodySplineMovedKnot(_: Integer): BSplineCurveData
        => 0.JodySplineWith(0.JodySpline.ControlPoints, 23.MapRange(k => k == 22 ? 1.25 : -0.1875 + 0.0625 * k.ToNumber));

    // A model of one closed edge on curve 0, the given record, from vertex v back to it, the
    // curve marked Closed when marked. No loop, face, shell or body.
    JodyEdge(_: BrepModel, d: BSplineCurveData, v: Point3D, marked: Boolean): BrepModel
        => BrepModel(
            GeometrySet([BrepCurve.BSpline(d)], [], [], [], marked ? [ClosureMark.ClosedCurve(CurveIndex(0))] : [ClosureMark.ClosedCurve(CurveIndex(0))].Take(0)),
            [BrepVertex(v)],
            [BrepEdge(BrepVertexIndex(0), BrepVertexIndex(0), CurveIndex(0), true)],
            [], [], [], [],
            Tolerances.Witness_Tolerances,
            LengthUnit.Metre);

    //==
    // # Laws

    // Whether the record is well shaped and in wrapped form, the record test decides it closed,
    // and layer 3's EndsClosure leaves it Undecided.
    IsClosedOnlyWrapped(d: BSplineCurveData): Boolean
    {
        var tol = Tolerances.Witness_Tolerances.Length;
        return d.IsWellShaped
            && d.IsWrappedForm(tol)
            && d.EndsClosureWrapped(tol).IsDecided
            && d.EndsClosureWrapped(tol).IsClosed
            && d.EndsClosure(tol).IsDecided.Not;
    }

    // Both corpus records are closed by the record test and Undecided by EndsClosure.
    Law_V1Jody_CorpusSplinesAreClosed(_: Integer): Boolean
        => 0.JodySpline.IsClosedOnlyWrapped && 0.JodySmallSpline.IsClosedOnlyWrapped;

    // Whether the record's ends, at parameters 0 and 1, lie within the length tolerance of
    // each other and within 1e-9 of v.
    EndsMeetAt(d: BSplineCurveData, v: Point3D): Boolean
    {
        var g = GeometrySet([BrepCurve.BSpline(d)], [], [], [], [ClosureMark.ClosedCurve(CurveIndex(0))].Take(0));
        var start = g.Eval(CurveIndex(0), 0.0);
        var end = g.Eval(CurveIndex(0), 1.0);
        return start.Coincident(end, Tolerances.Witness_Tolerances.Length)
            && start.Coincident(v, LengthTolerance(1e-9));
    }

    // The record test agrees with evaluation: each corpus record's ends are its loop's vertex,
    // (0.5, 0, 0) and (0.2, 0, 0).
    Law_V1Jody_CorpusSplineEndsMeet(_: Integer): Boolean
        => 0.JodySpline.EndsMeetAt(Point3D(0.5, 0.0, 0.0)) && 0.JodySmallSpline.EndsMeetAt(Point3D(0.2, 0.0, 0.0));

    // A record with its last point moved, or its last knot moved, stays Undecided.
    Law_V1Jody_NotWrappedStaysUndecided(_: Integer): Boolean
    {
        var tol = Tolerances.Witness_Tolerances.Length;
        return 0.JodySplineMovedEnd.EndsClosureWrapped(tol).IsDecided.Not
            && 0.JodySplineMovedKnot.EndsClosureWrapped(tol).IsDecided.Not;
    }

    // On every B-spline record of the catalog arena, EndsClosureWrapped gives EndsClosure's
    // decision wherever EndsClosure decides.
    Law_V1Jody_DecidedUnchanged(_: Integer): Boolean
    {
        var g = GeometrySet.Witness_CatalogArena;
        var tol = Tolerances.Witness_Tolerances.Length;
        return g.Curves.All(c => c.WrappedAgreesWhereDecided(tol));
    }

    // For a B-spline record whose closure EndsClosure decides, EndsClosureWrapped's decision is
    // the same; true for every other record.
    WrappedAgreesWhereDecided(c: BrepCurve, tol: LengthTolerance): Boolean
        => match (c)
        {
            Line(origin, velocity) => true;
            Circle(placement, radius) => true;
            Ellipse(placement, semiAxis1, semiAxis2) => true;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => true;
            Parabola(placement, focalDistance) => true;
            Polyline(points) => true;
            BSpline(data) => data.EndsClosure(tol).IsDecided.Not
                || (data.EndsClosureWrapped(tol).IsDecided && data.EndsClosureWrapped(tol).IsClosed == data.EndsClosure(tol).IsClosed);
            Trimmed(basis, range, sameSense) => true;
            Composite(segments) => true;
            Offset(basis, distance, reference) => true;
            OnSurface(spaceCurve, supports, master) => true;
        };

    // The defect and its fix on one edge: without the Closed mark (the library's decision) the
    // closed edge on the record from v back to v has the domain [0, 0] and DiscretizeAllRanged
    // leaves it Undiscretized; with the mark EndsClosureWrapped decides, its domain is [0, 1]
    // and it is discretized with at least the closed-edge minimum of segments.
    FixedOnEdge(spline: BSplineCurveData, v: Point3D): Boolean
    {
        var c = DefaultCriteria(0.001);
        var before = BrepModel.JodyEdge(spline, v, false);
        var after = BrepModel.JodyEdge(spline, v, spline.EndsClosureWrapped(Tolerances.Witness_Tolerances.Length).IsClosed);
        var r0 = before.EdgeDomain(BrepEdgeIndex(0)).Range;
        var r1 = after.EdgeDomain(BrepEdgeIndex(0)).Range;
        var d0 = before.DiscretizeAllRanged(c, SegmentFloors.NoFloors).ByEdge[0];
        var d1 = after.DiscretizeAllRanged(c, SegmentFloors.NoFloors).ByEdge[0];
        return r0.Start == r0.End
            && d0.IsDiscretized.Not
            && r1.Start.Abs <= 1e-9
            && (r1.End - 1.0).Abs <= 1e-9
            && d1.IsDiscretized
            && d1.SegmentCount >= c.ClosedEdgeMinimum;
    }

    // Both corpus records' closed edges: Undiscretized today, discretized with the fix.
    Law_V1Jody_ClosedEdgeDiscretizes(_: Integer): Boolean
        => 0.JodySpline.FixedOnEdge(Point3D(0.5, 0.0, 0.0)) && 0.JodySmallSpline.FixedOnEdge(Point3D(0.2, 0.0, 0.0));
}

//==
// # Implicit edges keyed by rank (track v1-edges, chunk E3, TKT-400)
//
// The rank-keyed forms of ImplicitEdgeUses, ShellPolyEdgesOf and the boundary-cycle count
// (types in faceted-edge-ranks.types.plato). The counts that read only runs of equal keys and the
// direction bit (UseRunEnd, ImplicitEdgeCountSorted, ImplicitFreeEdgeKeysSorted,
// PolyEdgeUseDefectsSorted, ReducedCountsPolyIndexed) take the rank-keyed uses unchanged through
// PolyEdges; only the boundary-cycle count, which decoded a key into its two classes, needs the
// classes kept beside the uses.
//
// Sections, in order:
//  - Uses and ranks
//  - Shell measures

library V1EdgesFacetedRanks
{
    //==
    // # Uses and ranks

    // The implicit edge uses of the poly bounds in use order, bound by bound, each bound's first
    // point at PolyPointOffsets. Precondition: pointRoots indexes the bounds' points in order.
    ImplicitEdgeUseListOf(m: BrepModel, poly: Array<FaceBound>, pointRoots: Array<Integer>): ImplicitEdgeUseList
    {
        var offsets = m.PolyPointOffsets(poly);
        var low = new List<Integer>();
        var high = new List<Integer>();
        var forward = new List<Integer>();
        var k = 0;
        while (k < poly.Count)
        {
            var c = m.Loops[poly[k].Loop].PolyLoopPointsOf.Count;
            var i = 0;
            while (i < c)
            {
                var a = pointRoots[offsets[k] + i];
                var b = pointRoots[offsets[k] + (i + 1) % c];
                if (a != b)
                {
                    low = low.Add(a.Min(b));
                    high = high.Add(a.Max(b));
                    forward = forward.Add((a < b) == poly[k].Orientation ? 1 : 0);
                }
                i = i + 1;
            }
            k = k + 1;
        }
        return ImplicitEdgeUseList(low.Freeze(), high.Freeze(), forward.Freeze());
    }

    // The positions of order stably sorted by keys[position], each key in [0, range): a counting
    // sort, O(order.Count + range), with no comparator.
    CountingSortBy(order: Array<Integer>, keys: Array<Integer>, range: Integer): Array<Integer>
    {
        var starts = new Buffer<Integer>(range + 1);
        var k = 0;
        while (k <= range)
        {
            starts = starts.Set(k, 0);
            k = k + 1;
        }
        var j = 0;
        while (j < order.Count)
        {
            var key = keys[order[j]];
            starts = starts.Set(key + 1, starts.At(key + 1) + 1);
            j = j + 1;
        }
        k = 0;
        while (k < range)
        {
            starts = starts.Set(k + 1, starts.At(k + 1) + starts.At(k));
            k = k + 1;
        }
        var sorted = new Buffer<Integer>(order.Count);
        j = 0;
        while (j < order.Count)
        {
            var key = keys[order[j]];
            sorted = sorted.Set(starts.At(key), order[j]);
            starts = starts.Set(key, starts.At(key) + 1);
            j = j + 1;
        }
        return sorted.Freeze();
    }

    // The uses' positions sorted by (Low, High, Forward), ties in use order: three stable
    // counting sorts, least significant key first, each class below n = pointCount.
    UseOrder(l: ImplicitEdgeUseList, pointCount: Integer): Array<Integer>
    {
        var byForward = l.Low.Count.Range.CountingSortBy(l.Forward, 2);
        return byForward.CountingSortBy(l.High, pointCount).CountingSortBy(l.Low, pointCount);
    }

    // The rank of each use's edge, in use order: the number of distinct (Low, High) pairs that
    // come before its own. Precondition: order is l.UseOrder.
    UseRanks(l: ImplicitEdgeUseList, order: Array<Integer>): Array<Integer>
    {
        var ranks = new Buffer<Integer>(order.Count);
        var r = -1;
        var j = 0;
        while (j < order.Count)
        {
            var u = order[j];
            var fresh = j == 0 ? true : (l.Low[u] != l.Low[order[j - 1]] || l.High[u] != l.High[order[j - 1]]);
            if (fresh)
            {
                r = r + 1;
            }
            ranks = ranks.Set(u, r);
            j = j + 1;
        }
        return ranks.Freeze();
    }

    // The implicit edge uses of the poly bounds in use order, keyed by rank: rank * 2 + 1 when
    // the face runs the use from the smaller class to the larger, rank * 2 otherwise. The
    // rank-keyed ImplicitEdgeUses: two uses share a key exactly when they share both classes and
    // the direction, at any point count, and every key is below twice the use count.
    ImplicitEdgeUsesRanked(m: BrepModel, poly: Array<FaceBound>, pointRoots: Array<Integer>): Array<Integer>
    {
        var l = m.ImplicitEdgeUseListOf(poly, pointRoots);
        var ranks = l.UseRanks(l.UseOrder(pointRoots.Count));
        return ranks.Count.MapRange(u => ranks[u] * 2 + l.Forward[u]);
    }

    // Shell s's poly-loop points identified by coincidence, its implicit edge uses keyed by rank
    // and sorted, and each edge's two classes. Precondition: m.IsEveryIndexInRange.
    ShellImplicitEdgesOf(m: BrepModel, s: ShellIndex): ShellImplicitEdges
    {
        var poly = m.ShellPolyBounds(s);
        return m.ImplicitEdgesWithRoots(poly, m.CoincidenceRootsByGrid(m.PolyBoundPoints(poly)));
    }

    // ShellImplicitEdgesOf with the class roots of the bounds' points given. Precondition: roots
    // indexes the bounds' points in order, each the smallest index of its class.
    ImplicitEdgesWithRoots(m: BrepModel, poly: Array<FaceBound>, roots: Array<Integer>): ShellImplicitEdges
    {
        var l = m.ImplicitEdgeUseListOf(poly, roots);
        var order = l.UseOrder(roots.Count);
        var ranks = l.UseRanks(order);
        var low = new List<Integer>();
        var high = new List<Integer>();
        var j = 0;
        while (j < order.Count)
        {
            var u = order[j];
            if (ranks[u] == low.Count)
            {
                low = low.Add(l.Low[u]);
                high = high.Add(l.High[u]);
            }
            j = j + 1;
        }
        return ShellImplicitEdges(roots, order.Map(u => ranks[u] * 2 + l.Forward[u]), low.Freeze(), high.Freeze());
    }

    // The roots and the rank-keyed sorted uses as ShellPolyEdges, for the counts that read runs
    // of equal keys and the direction bit.
    PolyEdges(p: ShellImplicitEdges): ShellPolyEdges
        => ShellPolyEdges(p.PointRoots, p.SortedUses);

    //==
    // # Shell measures

    // ImplicitBoundaryCycleCount: the classes of the free implicit edges joined at shared point
    // classes, each free edge's classes read from EdgeLow and EdgeHigh.
    ImplicitBoundaryCycleCountRanked(p: ShellImplicitEdges): Integer
        => p.BoundaryCyclesOfFreeEdges(p.PolyEdges.ImplicitFreeEdgeKeysSorted);

    // The classes of the given free implicit edges (rank keys) joined at shared point classes:
    // the distinct roots of their low ends, counted by marking each root once (linear, where
    // DistinctCount sorts).
    BoundaryCyclesOfFreeEdges(p: ShellImplicitEdges, free: Array<Integer>): Integer
    {
        var n = p.PointRoots.Count;
        var roots = ClassRoots(n, free.Map(k => p.EdgeLow[k]), free.Map(k => p.EdgeHigh[k]));
        var seen = new Buffer<Boolean>(n);
        var i = 0;
        while (i < n)
        {
            seen = seen.Set(i, false);
            i = i + 1;
        }
        var count = 0;
        var j = 0;
        while (j < free.Count)
        {
            var r = roots[p.EdgeLow[free[j]]];
            if (seen.At(r).Not)
            {
                seen = seen.Set(r, true);
                count = count + 1;
            }
            j = j + 1;
        }
        return count;
    }

    // BoundaryCycleCount(m, s), given t = m.EdgeUseTable(s) and p = m.ShellImplicitEdgesOf(s).
    BoundaryCycleCountRanked(m: BrepModel, t: EdgeUseTable, p: ShellImplicitEdges): Integer
        => m.IndexedBoundaryCycleCountIndexed(t) + p.ImplicitBoundaryCycleCountRanked;

    // ShellEulerPoincare(m, s) + BoundaryCycleCount(m, s) with rank keys: ShellEulerPlusBoundaryCycles
    // at any poly-point count. Precondition: m.IsEveryIndexInRange.
    ShellEulerPlusBoundaryCyclesRanked(m: BrepModel, s: ShellIndex): Integer
    {
        var t = m.EdgeUseTable(s);
        var p = m.ShellImplicitEdgesOf(s);
        return m.ReducedCountsPolyIndexed(s, t, p.PolyEdges).EulerPoincare + m.BoundaryCycleCountRanked(t, p);
    }
}

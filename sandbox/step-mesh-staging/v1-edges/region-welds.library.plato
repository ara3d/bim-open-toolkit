//==
// # Welded samples in regions and face meshes (track v1-edges, chunk E5d-1, TKT-468)
//
// Layer 05-face-meshing. A weld (EdgeDiscretizations.Welds, V1EdgesWelds) says that a sample of an
// edge's polyline is another boundary point, a model vertex or another edge's sample. Two readers:
// the region builders put a welded sample at the parameters of its target wherever the face's
// region holds the target (SnappedToWelds, applied by UnorientedRegionOf and UnorientedRegionOfIn),
// so the two are one repeated point and the sliver between them is a side run both ways, which
// CdtSeedOverCopies cancels; and Lift gives a welded sample its target's source
// (WithWeldedSources), so it lifts to the target's point with its provenance, and the assembly
// numbers it as the target in every face citing the edge. No face asks for a weld in E5d-1: welds
// from touches made a notch's overlapping edges one edge of four uses on ELLA-W1 (TKT-488), and
// the supervisor kept E5d-1 to the machinery; E5d-2's crossings (c211's cusps) are the first users.
//
// Sections, in order:
//  - Welds in regions and triangulations

library V1EdgesRegionWelds
{
    //==
    // # Welds in regions and triangulations

    // The source a source is welded to: FromEdge(e, k) welded in d (V1EdgesWelds.WeldedTarget), as
    // a one-element array, the target's source; empty for every other source.
    WeldedTargetSource(d: EdgeDiscretizations, s: UvPointSource): Array<UvPointSource>
        => match (s) {
            FromVertex(v) => [s].Take(0);
            FromEdge(e, k) => d.WeldedTarget(e, k).Map(w => w.TargetSource);
            SeamCut(side, i) => [s].Take(0);
            Pole(side, i) => [s].Take(0);
            Interior => [s].Take(0);
        };

    // The source a weld target is: the vertex's, or the edge sample's.
    TargetSource(w: WeldTarget): UvPointSource
        => match (w) {
            ToVertex(v) => UvPointSource.FromVertex(v);
            ToSample(e, k) => UvPointSource.FromEdge(e, k);
        };

    // Source s, or the source it is welded to.
    WeldedSource(d: EdgeDiscretizations, s: UvPointSource): UvPointSource
        => d.WeldedTargetSource(s).Count == 1 ? d.WeldedTargetSource(s)[0] : s;

    // Loop l with each welded sample at the parameters of the nearest point of region r whose
    // source is its target; a welded sample whose target r does not hold keeps its parameters.
    SnappedLoop(l: UvLoop, r: UvRegion, d: EdgeDiscretizations): UvLoop
    {
        var all = r.BoundaryPoints;
        var sources = r.BoundarySources;
        return UvLoop(l.Points.Count.MapRange(i => d.WeldedTargetSource(l.Sources[i]).Count == 0 ? l.Points[i]
            : all.Count.Range.Reduce(l.Points[i], (best, j) =>
                (sources[j] == d.WeldedTargetSource(l.Sources[i])[0]
                    && (best == l.Points[i] || all[j].UvDistance(l.Points[i]) < best.UvDistance(l.Points[i])))
                    ? all[j] : best)), l.Sources);
    }

    // Region r with its welded samples snapped (SnappedLoop); r itself when d welds nothing.
    SnappedToWelds(r: UvRegion, d: EdgeDiscretizations): UvRegion
        => d.Welds.Count == 0 ? r : UvRegion(r.Outer.SnappedLoop(r, d), r.Holes.Map(h => h.SnappedLoop(r, d)));

    // Triangulation t with each welded sample's source its vertex (WeldedSource), so Lift gives it
    // the vertex's point and provenance; t itself when d welds nothing.
    WithWeldedSources(t: UvTriangulation, d: EdgeDiscretizations): UvTriangulation
        => d.Welds.Count == 0 ? t : UvTriangulation(t.Points, t.Sources.Map(s => d.WeldedSource(s)), t.Triangles, t.Quads);
}

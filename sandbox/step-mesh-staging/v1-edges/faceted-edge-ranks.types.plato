//==
// # Implicit edges keyed by rank: types (track v1-edges, chunk E3, TKT-400)
//
// ImplicitEdgeUse (02-topology/topology.library.plato) keys the implicit edge between point
// classes a < b as (a * N + b) * 2 + direction, N the shell's poly-point count. Above about
// 32,768 points that product passes 2^31 and two edges can share a key. Here an edge is keyed by
// its rank among the shell's distinct (a, b) pairs in ascending order instead: the rank is below
// the use count, so key * 2 + 1 fits whenever the uses do, and rank order is the order the packed
// keys had where they did not overflow. The two classes of each edge, which the packed key held
// and a rank does not, are kept beside the uses.

// The implicit edge uses of some poly bounds, in use order, as three parallel arrays: use k runs
// between point classes Low[k] < High[k], and Forward[k] is 1 when the face runs it from Low to
// High (the bound's Orientation composed with the loop's order), 0 otherwise. A pair of
// consecutive points in one class is no edge and has no use.
type ImplicitEdgeUseList
    implements IValue
{
    Low: Array<Integer>;
    High: Array<Integer>;
    Forward: Array<Integer>;
}

// ShellPolyEdges with rank keys: PointRoots and SortedUses as ShellPolyEdges states, except that
// a use's key (u / 2) is the rank of its edge's pair of classes; EdgeLow[r] < EdgeHigh[r] are
// the two classes of the edge of rank r.
type ShellImplicitEdges
    implements IValue
{
    PointRoots: Array<Integer>;
    SortedUses: Array<Integer>;
    EdgeLow: Array<Integer>;
    EdgeHigh: Array<Integer>;
}

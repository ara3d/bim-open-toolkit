//==
// # Law_AttainableRefinementNoLarger restated (track v1-edges, chunk E4b, TKT-468)
//
// The law said the attainable refinement never has more triangles than the library's on a capped
// witness, and as many where nothing is capped. That held for one start triangulation: with the
// constrained Delaunay seed (E4b) the seamed sphere at chordal 3 starts from 66 triangles with
// other diagonals, and the library's refinement makes 224 (238 before) and the attainable one 226
// (222 before). The supervisor's restatement (2026-10-22): from the same start, both refinements
// meet the chordal bound, every element of every face within SurfaceChordal of the surface both
// ways, widened by the length tolerance; the two triangle counts are a measure, recorded in
// TRACK.md, not a law.
//
// Sections, in order:
//  - Laws

library V1EdgesAttainableRestatedLaws
{
    //==
    // # Laws

    // Whether every element of face mesh fm of witness w is within SurfaceChordal of the
    // surface, both ways, widened by the length tolerance.
    CappedFaceWithinChordal(w: CappedWitness, fm: FaceMesh): Boolean
    {
        var bound = w.Criteria.SurfaceChordal + w.Model.Tolerances.Length.Value;
        return fm.ElementCount.Range.All(k =>
            w.Model.ElementCoverageGap(w.Discretizations, fm, ElementIndex(k)) <= bound
                && w.Model.ElementChordalDeviation(w.Discretizations, fm, ElementIndex(k)) <= bound);
    }

    // From the same start triangulation, the library's refinement and the attainable one both
    // meet the chordal bound on every face of every capped witness.
    Law_V1Edges_RefinementsMeetChordalFromOneStart(w: CappedWitness): Boolean
        => w.Model.Faces.Count.Range.All(f =>
            w.CappedFaceWithinChordal(w.Model.Lift(BrepFaceIndex(f), w.Discretizations, w.Reference[f]))
                && w.CappedFaceWithinChordal(w.Model.Lift(BrepFaceIndex(f), w.Discretizations, w.Attainable[f])));
}

//==
// # Welds: laws (track v1-edges, chunk E5d, TKT-468)
//
// EdgeDiscretizations.Welds (V1EdgesWelds) and their readers (V1EdgesRegionWelds). On the unit box:
// a weld survives a refinement round, its sample re-indexed to its parameter; a SplitAtVertex whose
// vertex is farther than the length tolerance from the edge inserts the point and welds nothing;
// a welded sample is its vertex in every face citing the edge (its source when lifted, its
// parameters in the region). Welds made directly: no face asks for one in E5d-1.
//
// Sections, in order:
//  - Laws

library V1EdgesWeldsLaws
{
    //==
    // # Laws

    // A weld of the unit box's edge 0 at sample 1 to vertex 0 (made directly: no vertex lies near an
    // interior point of the box's edges) survives Refine raising that edge's segment count by
    // three: one weld, at the sample whose parameter is the old sample's.
    Law_V1Edges_WeldSurvivesRefinement(_: Integer): Boolean
    {
        var m = BrepModel.Witness_UnitBox;
        var c = DefaultMeshingOptions(0.1).Face.Discretization;
        var d0 = m.Refine(SplitBoxDiscretizations(0), [EdgeRefinementRequest(BrepEdgeIndex(0), RefinementReason.SplitAt(SplitBoxParameter(0)), c.Chordal, 0)], c);
        var d = EdgeDiscretizations(d0.ByEdge, [SampleWeld(BrepEdgeIndex(0), EdgeSampleIndex(1), WeldTarget.ToVertex(BrepVertexIndex(0)))]);
        var r = m.Refine(d, [EdgeRefinementRequest(BrepEdgeIndex(0), RefinementReason.QuadCountMismatch, c.Chordal, d.ByEdge[0].SegmentCount + 3)], c);
        return r.Welds.Count == 1 && r.Welds[0].Edge == BrepEdgeIndex(0) && r.Welds[0].Target.TargetVertex.Any(v => v == BrepVertexIndex(0))
            && r.ByEdge[0].Parameters[r.Welds[0].Sample.Value] == d.ByEdge[0].Parameters[1]
            && r.ByEdge[0].Parameters.Count > d.ByEdge[0].Parameters.Count;
    }

    // A SplitAtVertex on the unit box's edge 0 whose vertex (vertex 6, a far corner) lies farther
    // than the length tolerance from the split point inserts the point and makes no weld.
    Law_V1Edges_WeldOnlyWithinTolerance(_: Integer): Boolean
    {
        var m = BrepModel.Witness_UnitBox;
        var c = DefaultMeshingOptions(0.1).Face.Discretization;
        var t = SplitBoxParameter(0);
        var r = m.Refine(SplitBoxDiscretizations(0), [EdgeRefinementRequest(BrepEdgeIndex(0), RefinementReason.SplitAtVertex(t, BrepVertexIndex(6)), c.Chordal, 0)], c);
        return r.ByEdge[0].HasParameter(t) && r.Welds.Count == 0;
    }

    // A weld of the unit box's edge 0 at its split sample to vertex 1 (made directly): every face
    // citing edge 0 lifts that sample with vertex 1 as its source, none with the sample's own, so
    // the assembly numbers it as vertex 1; and the region of each puts the sample at vertex 1's
    // parameters.
    Law_V1Edges_WeldedSampleIsItsVertex(_: Integer): Boolean
    {
        var m = BrepModel.Witness_UnitBox;
        var c = DefaultMeshingOptions(0.1).Face;
        var d0 = m.Refine(SplitBoxDiscretizations(0), [EdgeRefinementRequest(BrepEdgeIndex(0), RefinementReason.SplitAt(SplitBoxParameter(0)), c.Discretization.Chordal, 0)], c.Discretization);
        var k = d0.ByEdge[0].Parameters.Count.Range.FlatMap(i => d0.ByEdge[0].Parameters[i] == SplitBoxParameter(0) ? [i] : [0].Take(0))[0];
        var d = EdgeDiscretizations(d0.ByEdge, [SampleWeld(BrepEdgeIndex(0), EdgeSampleIndex(k), WeldTarget.ToVertex(BrepVertexIndex(1)))]);
        var welded = UvPointSource.FromEdge(BrepEdgeIndex(0), EdgeSampleIndex(k));
        var vertex = UvPointSource.FromVertex(BrepVertexIndex(1));
        return m.Faces.Count.Range.All(g => m.FaceEdges(BrepFaceIndex(g)).Any(x => x == BrepEdgeIndex(0)).Not ? true
            : m.WeldedFaceHolds(BrepFaceIndex(g), d, c, welded, vertex));
    }

    // Whether face f, meshed by MeshFace with d, lifts no point from source welded and some from
    // vertex, and its region puts the welded sample at the parameters of its point from vertex.
    WeldedFaceHolds(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria, welded: UvPointSource, vertex: UvPointSource): Boolean
    {
        var mesh = m.MeshFace(f, d, c).Mesh;
        var r = m.UnorientedRegionOf(f, d, c);
        var at = r.BoundaryPoints.Count.Range.FlatMap(i => r.BoundarySources[i] == welded ? [r.BoundaryPoints[i]] : [UvCoordinate(0.0, 0.0)].Take(0));
        var v = r.BoundaryPoints.Count.Range.FlatMap(i => r.BoundarySources[i] == vertex ? [r.BoundaryPoints[i]] : [UvCoordinate(0.0, 0.0)].Take(0));
        return mesh.Sources.Any(x => x == welded).Not && mesh.Sources.Any(x => x == vertex)
            && at.Count == 1 && v.Any(p => p == at[0]);
    }
}

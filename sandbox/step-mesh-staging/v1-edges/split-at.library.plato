//==
// # Split points: an edge split where a face's vertex touches it (track v1-edges, chunk E5c, TKT-468)
//
// Layer 04-discretization. A face whose loop has a vertex lying inside another of its boundary
// segments (a T-touch: ELLA-W1 304's comb spikes touch the next spike's side 1e-18 off, ODIN-W260
// 2613's tail runs back through a vertex) cannot be meshed alone: the touched segment lies on a
// model edge another face shares, and only a point on that edge, in both faces, keeps the shell
// closed. Face meshing asks for it with a blocking request, RefinementReason.SplitAt(Parameter),
// the parameter of the touching point on the edge's curve; Refine inserts every requested
// parameter after refining the edge. Refinement subdivides an edge's own parameters and never
// drops one, so a split point stays through later rounds.
//
// Sections, in order:
//  - Split parameters

library V1EdgesSplitAt
{
    //==
    // # Split parameters

    // The parameter a SplitAt reason asks for, as a one-element array; empty for every other
    // reason.
    SplitParameterOf(r: RefinementReason): Array<Number>
        => match (r) {
            LoopSelfIntersects => [0.0].Take(0);
            TooCoarseInParameterSpace => [0.0].Take(0);
            QuadCountMismatch => [0.0].Take(0);
            NoInteriorPointMeetsChordal(c) => [0.0].Take(0);
            PoleAdjacency => [0.0].Take(0);
            NeighbourDensity => [0.0].Take(0);
            SplitAt(t) => [t];
        };

    // The split parameters the requests ask for on edge e, in request order.
    SplitParametersOn(requests: Array<EdgeRefinementRequest>, e: BrepEdgeIndex): Array<Number>
        => requests.FlatMap(q => q.Edge == e ? q.Reason.SplitParameterOf : [0.0].Take(0));

    // Discretization d with every parameter of ts strictly between its first and last parameters,
    // and farther than 1e-12 of that span from each of its own, inserted in order (repeats kept
    // once), its points recomputed (DiscretizationAt); d itself when none is. The parameters run
    // either way along the curve; the order is kept.
    WithSplitPoints(m: BrepModel, d: EdgeDiscretization, ts: Array<Number>): EdgeDiscretization
    {
        if (ts.Count == 0 || d.Parameters.Count < 2)
        {
            return d;
        }
        var first = d.Parameters[0];
        var last = d.Parameters[d.Parameters.Count - 1];
        var eps = 1e-12 * (last - first).Abs;
        var inside = ts.FlatMap(t => ((t - first) * (t - last) < 0.0 && d.Parameters.All(p => (p - t).Abs > eps)) ? [t] : [0.0].Take(0));
        if (inside.Count == 0)
        {
            return d;
        }
        var rising = last > first;
        var sorted = d.Parameters.Concatenate(inside).Sort((a, b) => rising ? a <= b : a >= b);
        var kept = sorted.Count.Range.FlatMap(i => (i == 0 ? true : (sorted[i] - sorted[i - 1]).Abs > eps) ? [sorted[i]] : [0.0].Take(0));
        return m.DiscretizationAt(d.Edge, kept);
    }
}

//==
// # Weakly simple regions: the simplicity test and FACE-CUSP (track v1-edges, chunk E5b, TKT-468)
//
// Layer 05-face-meshing. MeshRegionOnceV1 refuses a region when two of its boundary segments come
// within one tolerance unit of each other anywhere but at a shared end (SegmentsSeparatedV1), so a
// loop whose vertex touches another side (ELLA-W1 304 and 305's comb spikes, 1e-18 off), whose
// last side runs back over its first (ODIN-W260 2613's tail), or that narrows to a needle thinner
// than the tolerance (ODIN-W260 2615 and 2616) gets FACE-LOOP-NOT-SIMPLE and no mesh, although
// the seed over repeated points (V1EdgesCdtSeedCopies, E5a) covers all of them. Here a region is
// refused when two of its segments properly cross (each one's ends strictly on opposite sides of
// the other's line, by more than rounding: 1e-12 of the product of the lengths, in tolerance
// units), or when an end of one lies inside the other within rounding (a T-touch). Exact pinches,
// slits whose sides share their points, overlaps and needles at the tolerance pass. A T-touch is
// refused until track v1-edges' chunk E5c answers it: the touched side's model edge is shared
// with a neighbouring face, which must get the touching point too, or the shell opens there
// (meshing ELLA-W1 304 and 305 alone left 42 gap edges and 21 inside-face edges). c211 81/84/88
// (point 12 0.00095 on the wrong side of side 10-11) and LENA-R8 258 (4 crossings) are refused
// until chunk E5d resolves a crossing within the tolerance by splitting the crossed side.
//
// A pinch (a loop through one point twice) cuts the loop into two lobes. V1G-6 accepted only a
// keyhole, the smaller lobe wound the other way and inside the larger (a hole joined to the
// boundary at a point), because the bridged ear-clipped seed could cover nothing else; the seed
// over repeated points covers every lobe of winding 0 or 1. So the smaller lobe may also be wound
// the same way and lie outside the larger (two pieces of face touching at a point, SHO/MAYA-W260
// _REVC face 1599), and two loops may touch (a hole on the outer loop). A lobe wound the same way
// inside the larger (winding 2) or the other way outside it (winding -1) is still malformed.
//
// A meshed face with a triangle thinner than one tolerance unit (twice its area over its longest
// side, in tolerance units, below 1) is a cusp: the needle's sides are model edges the
// neighbouring faces share, so the triangle is kept for watertightness, and the face carries one
// FACE-CUSP warning whose measure counts them.
//
// Sections, in order:
//  - Crossing segments
//  - Pinches
//  - Cusps
//  - Meshing a region

library V1EdgesWeaklySimple
{
    //==
    // # Crossing segments

    // Whether segments a and b of r do not properly cross: in tolerance units, some end of one
    // lies on the other's line or on the same side of it as the other end, within 1e-12 of the
    // product of the segment's length and the distance to the end.
    SegmentsDoNotCross(r: UvRegion, tol: UvTolerance, a: RegionSegment, b: RegionSegment): Boolean
    {
        var p = r.SegmentStart(a.Loop, a.Index).InToleranceUnits(tol);
        var q = r.SegmentEnd(a.Loop, a.Index).InToleranceUnits(tol);
        var u = r.SegmentStart(b.Loop, b.Index).InToleranceUnits(tol);
        var v = r.SegmentEnd(b.Loop, b.Index).InToleranceUnits(tol);
        return (StrictSide(p, q, u) * StrictSide(p, q, v) < 0 && StrictSide(u, v, p) * StrictSide(u, v, q) < 0).Not;
    }

    // The side of point x relative to the line from a to b: 1 on the left, -1 on the right, 0
    // within 1e-12 |ab| |ax| of the line.
    StrictSide(a: Point2D, b: Point2D, x: Point2D): Integer
    {
        var area = TwiceSignedArea(a, b, x);
        var margin = 1e-12 * a.Distance(b) * a.Distance(x);
        return area > margin ? 1 : (area < 0.0 - margin ? -1 : 0);
    }

    // Whether no end of segment b lies inside segment a within rounding: on a's line (StrictSide
    // 0) and strictly between a's ends, not at one of them.
    NoEndInside(r: UvRegion, tol: UvTolerance, a: RegionSegment, b: RegionSegment): Boolean
    {
        var p = r.SegmentStart(a.Loop, a.Index).InToleranceUnits(tol);
        var q = r.SegmentEnd(a.Loop, a.Index).InToleranceUnits(tol);
        return IsInsideSegment(p, q, r.SegmentStart(b.Loop, b.Index).InToleranceUnits(tol)).Not
            && IsInsideSegment(p, q, r.SegmentEnd(b.Loop, b.Index).InToleranceUnits(tol)).Not;
    }

    // Whether point x lies on the segment from p to q within rounding, strictly between its ends.
    IsInsideSegment(p: Point2D, q: Point2D, x: Point2D): Boolean
    {
        var along = (x.X - p.X) * (q.X - p.X) + (x.Y - p.Y) * (q.Y - p.Y);
        var length2 = (q.X - p.X) * (q.X - p.X) + (q.Y - p.Y) * (q.Y - p.Y);
        return StrictSide(p, q, x) == 0 && along > 0.0 && along < length2 && x.Distance(p) > 0.0 && x.Distance(q) > 0.0;
    }

    // Whether segments a and b meet as a weakly simple region allows until E5c: they do not cross
    // and neither has an end inside the other.
    SegmentsMeetCleanly(r: UvRegion, tol: UvTolerance, a: RegionSegment, b: RegionSegment): Boolean
        => r.SegmentsDoNotCross(tol, a, b) && r.NoEndInside(tol, a, b) && r.NoEndInside(tol, b, a);

    // One flag per boundary segment, in RegionSegments order: true when the segment properly
    // crosses another, on CollidingSegments' grid (a crossing pair's boxes overlap).
    CrossingSegments(r: UvRegion, tol: UvTolerance): Array<Boolean>
        => r.FlaggedBy(tol, (a, b) => r.SegmentsDoNotCross(tol, a, b));

    // One flag per boundary segment: true when the segment crosses another or a T-touch joins
    // them (SegmentsMeetCleanly fails): the segments MeshRegionWeaklySimple refuses a region for.
    ConflictingSegments(r: UvRegion, tol: UvTolerance): Array<Boolean>
        => r.FlaggedBy(tol, (a, b) => r.SegmentsMeetCleanly(tol, a, b));

    // One flag per boundary segment: true when separated fails for it and another, on the grid
    // (separated may fail only for segments whose boxes overlap).
    FlaggedBy(r: UvRegion, tol: UvTolerance, separated: Function2<RegionSegment, RegionSegment, Boolean>): Array<Boolean>
    {
        var boxes = r.SegmentBoxes(tol);
        return boxes.Count == 0 ? [false].Take(0)
            : (boxes.All(b => b.Finite) ? boxes.FlaggedSegmentsOnGrid(separated).Value : boxes.FlaggedSegmentsAllPairs(separated).Value);
    }

    //==
    // # Pinches

    // Whether the pinch of loop l at positions a < b (the same point twice) leaves every point of
    // the face at winding 0 or 1: the smaller lobe (by area) is wound the same way as the larger
    // and lies outside it, or is wound the other way and lies inside it (a keyhole). Inside is
    // read at the midpoint of the smaller lobe's second segment, as IsKeyholePinch reads it.
    IsWindingOnePinch(l: UvLoop, a: Integer, b: Integer): Boolean
    {
        var span = l.LoopSpan(a, b);
        var rest = l.LoopRest(a, b);
        var spanArea = span.PolygonArea;
        var restArea = rest.PolygonArea;
        var small = spanArea.Abs <= restArea.Abs ? span : rest;
        var large = spanArea.Abs <= restArea.Abs ? rest : span;
        var probe = small.Count >= 3 ? small[1].UvMidpoint(small[2]) : small[0];
        var inside = UvLoop(large, large.Map(x => UvPointSource.Interior)).LoopContains(probe);
        return (spanArea * restArea > 0.0) != inside;
    }

    // Whether every pinch of every loop of r (two positions, not neighbours, holding the same
    // point exactly) leaves winding 0 or 1. n^2 in each loop's points, as PinchesAreKeyholes.
    RegionPinchesHaveWindingOne(r: UvRegion): Boolean
        => r.NumberOfLoops.Range.All(k => r.LoopAt(k).Points.Count.Range.All(a => r.LoopAt(k).Points.Count.Range.All(b =>
            (b > a + 1 && (a > 0 || b < r.LoopAt(k).Points.Count - 1) && r.LoopAt(k).Points[a].IsSameUv(r.LoopAt(k).Points[b]))
                ? r.LoopAt(k).IsWindingOnePinch(a, b) : true)));

    //==
    // # Cusps

    // The triangles of face mesh fm thinner than one tolerance unit: twice the area over the
    // longest side, with the parameter points in tolerance units, below 1.
    CuspTriangleCount(fm: FaceMesh, tol: UvTolerance): Integer
        => fm.Triangles.Reduce(0, (n, t) => n + (IsThinnerThanUnit(fm.UvPoints[t.A.Value].InToleranceUnits(tol),
            fm.UvPoints[t.B.Value].InToleranceUnits(tol), fm.UvPoints[t.C.Value].InToleranceUnits(tol)) ? 1 : 0));

    // Whether the triangle (a, b, c) has its height over its longest side below 1.
    IsThinnerThanUnit(a: Point2D, b: Point2D, c: Point2D): Boolean
    {
        var longest = a.Distance(b).Max(b.Distance(c)).Max(c.Distance(a));
        return TwiceSignedArea(a, b, c).Abs < longest;
    }

    // Outcome o with a FACE-CUSP warning, measure the count, when its mesh has triangles thinner
    // than the tolerance.
    WithCuspDiagnostic(o: FaceMeshOutcome, f: BrepFaceIndex, tol: UvTolerance): FaceMeshOutcome
    {
        var n = o.Mesh.CuspTriangleCount(tol);
        return n == 0 ? o
            : FaceMeshOutcome(o.Mesh, o.Requests, o.Diagnostics.Concatenate([Diagnostic(Severity.Warning, "FACE-CUSP",
                "This face narrows to a needle thinner than the model's tolerance; its thinnest triangles (the measure counts them) are kept so the faces beside the needle stay joined.",
                Provenance.KernelFace(f), n.ToNumber)]));
    }

    //==
    // # Meshing a region

    // MeshRegionOnceV1 with the simplicity test ConflictingSegments: a region with a crossing or a
    // T-touch is refused as before (FACE-ZERO-WIDTH when it has no width, else
    // FACE-LOOP-NOT-SIMPLE with the self-intersection requests); one with no width whose segments collide under
    // SegmentsSeparatedV1 gets FACE-ZERO-WIDTH; one with a pinch that leaves winding 2 or -1 gets
    // MalformedPinchOutcome; the rest is meshed, with FACE-CUSP when it has a cusp.
    MeshRegionWeaklySimple(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): FaceMeshOutcome
    {
        var dom = m.SurfaceDomainOf(f);
        var raw = m.UnorientedRegionOfIn(f, dom, d, c);
        var r = m.OrientRegion(f, raw);
        var chart = m.ChartOf(f, r);
        var tol = m.RegionToleranceIn(f, dom, chart);
        var crossing = r.ConflictingSegments(tol);
        return crossing.Any(x => x)
            ? (r.IsZeroWidthRegion(tol) ? f.ZeroWidthOutcome : f.NotSimpleOutcome(m.SelfIntersectionRequestsFrom(f, d, r, crossing)))
            : (r.IsZeroWidthRegion(tol)
                ? (r.CollidingSegments(tol).Any(x => x) ? f.ZeroWidthOutcome : m.MeshedOutcomeIn(f, d, raw, r, chart, tol, c).WithCuspDiagnostic(f, tol))
                : (r.RegionPinchesHaveWindingOne ? m.MeshedOutcomeIn(f, d, raw, r, chart, tol, c).WithCuspDiagnostic(f, tol) : f.MalformedPinchOutcome));
    }
}

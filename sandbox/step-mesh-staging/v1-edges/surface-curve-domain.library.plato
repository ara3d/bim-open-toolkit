//==
// # Surface curves parameterized by a pcurve, and a bound on an edge's work (track v1-edges, chunk E2, TKT-414)
//
// SHO/NINA-B222-W1x2.STEP has four SURFACE_CURVE edges (680, 683, 1502, 1513 of the prepared
// model, quarter circles of radius 0.3 and 0.4 where a cylinder meets a plane) whose master
// representation is their first pcurve, a 2D line along u on the cylinder. Layer 1 gives such a
// curve the pcurve's domain, unbounded, and finds a point's parameter with the generic search
// over that domain (ClosestParameterBySearch), not with the pcurve's own ClosestParameter, which
// knows that the line's space point repeats every 2 pi / |velocity.X| (PcurveParameterPeriod,
// review F4). The search returns -5.3e29 and 1.1e30 for the two vertices, so the edge domain spans
// 1.6e30; ConicCount does not see a conic through the surface curve, and bisection over that
// range, whose chords never fall below the minimum length on a curve winding round a cylinder,
// does not return.
//
// Here a surface curve with a pcurve master takes its parameter from the pcurve's own
// ClosestParameter, and its domain is [0, T) with period T when the pcurve repeats with
// parameter period T on a domain that does not say so; otherwise the pcurve's domain, as before.
// The edge's range is then the arc's (pi / 2 and pi on E680's circle), and an arc that crosses
// the parameter 0 is given its arc, not an inverted range.
//
// Separately, an edge whose range bounds its length above SegmentCap minimum lengths (the range's
// span times the curve's largest speed at five samples) is not discretized: it gets the
// undiscretized entry, which layer 8 reports (PIPELINE-EDGE-UNDISCRETIZED), instead of a
// bisection that does not finish. No corpus edge comes near the cap: 2^20 segments of 0.1 mm is
// 105 m.
//
// Sections, in order:
//  - Surface curves
//  - Edges
//  - The bound on an edge's work

library V1EdgesSurfaceCurves
{
    //==
    // # Surface curves

    // The domain of a surface curve whose master is pcurve p: [0, T) with period T when p's space
    // point repeats with parameter period T (PcurveParameterPeriod) on a domain that has no seam,
    // as a 2D line along a periodic direction does; p's own domain otherwise.
    MasterPcurveDomain(g: GeometrySet, p: PcurveIndex): CurveDomain
    {
        var own = g.Domain(p);
        var period = g.PcurveParameterPeriod(p);
        return (period > 0.0 && own.HasSeam.Not)
            ? CurveDomain(NumberInterval(0.0, period), Periodicity.Periodic(period))
            : own;
    }

    // Layer 1's Domain for one record, with a surface curve's pcurve master given
    // MasterPcurveDomain; every other record's as layer 1 states.
    DomainV1(curve: BrepCurve, g: GeometrySet): CurveDomain
        => match (curve)
        {
            Line(origin, velocity) => curve.Domain(g);
            Circle(placement, radius) => curve.Domain(g);
            Ellipse(placement, semiAxis1, semiAxis2) => curve.Domain(g);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => curve.Domain(g);
            Parabola(placement, focalDistance) => curve.Domain(g);
            Polyline(points) => curve.Domain(g);
            BSpline(data) => curve.Domain(g);
            Trimmed(basis, range, sameSense) => curve.Domain(g);
            Composite(segments) => curve.Domain(g);
            Offset(basis, distance, reference) => curve.Domain(g);
            OnSurface(spaceCurve, supports, master) => supports.MasterPcurve(master).IsNone
                ? g.Domain(spaceCurve)
                : g.MasterPcurveDomain(supports.MasterPcurve(master));
        };

    // Layer 1's Domain(g, c) with DomainV1.
    DomainV1(g: GeometrySet, c: CurveIndex): CurveDomain
        => g.CurveAt(c).DomainV1(g).WithClosure(g.IsMarkedClosed(c));

    // Layer 1's ClosestParameter for one record, with a surface curve whose master is a pcurve
    // answered by that pcurve's ClosestParameter (its straight-line closed form, or the search
    // that covers one period of a repeating 2D line); every other record's as layer 1 states.
    ClosestParameterV1(curve: BrepCurve, g: GeometrySet, p: Point3D): Number
        => match (curve)
        {
            Line(origin, velocity) => curve.ClosestParameter(g, p);
            Circle(placement, radius) => curve.ClosestParameter(g, p);
            Ellipse(placement, semiAxis1, semiAxis2) => curve.ClosestParameter(g, p);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => curve.ClosestParameter(g, p);
            Parabola(placement, focalDistance) => curve.ClosestParameter(g, p);
            Polyline(points) => curve.ClosestParameter(g, p);
            BSpline(data) => curve.ClosestParameter(g, p);
            Trimmed(basis, range, sameSense) => curve.ClosestParameter(g, p);
            Composite(segments) => curve.ClosestParameter(g, p);
            Offset(basis, distance, reference) => curve.ClosestParameter(g, p);
            OnSurface(spaceCurve, supports, master) => supports.MasterPcurve(master).IsNone
                ? g.ClosestParameter(spaceCurve, p)
                : g.ClosestParameter(supports.MasterPcurve(master), p);
        };

    // Layer 1's ClosestParameter(g, c, p) with ClosestParameterV1.
    ClosestParameterV1(g: GeometrySet, c: CurveIndex, p: Point3D): Number
        => g.CurveAt(c).ClosestParameterV1(g, p);

    //==
    // # Edges

    // Layer 2's EdgeDomain with DomainV1 and ClosestParameterV1. Precondition: m.IsEdgeIntact(e).
    EdgeDomainV1(m: BrepModel, e: BrepEdgeIndex): CurveDomain
        => m.Geometry.DomainV1(m.Edges[e].Curve).TraversalDomain(
            m.Geometry.ClosestParameterV1(m.Edges[e].Curve, m.Vertices[m.FirstVertexAlongCurve(e)].Point),
            m.Geometry.ClosestParameterV1(m.Edges[e].Curve, m.Vertices[m.LastVertexAlongCurve(e)].Point),
            m.IsClosedEdge(e));

    //==
    // # The bound on an edge's work

    // The most segments an edge's range may imply before its discretization is refused:
    // 2^20.
    SegmentCap(_: Integer): Integer
        => 1048576;

    // An upper estimate of the length of edge e's curve over range: the span times the largest
    // speed at five evenly spaced parameters (each wrapped into the curve's domain, as
    // EdgeCurvePoint evaluates). Infinite or NaN when the range or a speed is not finite.
    RangeLengthBound(m: BrepModel, e: BrepEdgeIndex, range: NumberInterval): Number
    {
        var curve = m.Edges[e].Curve;
        var d = m.Geometry.Domain(curve);
        var span = range.End - range.Start;
        var fastest = 5.Range.Reduce(0.0, (s, k) =>
            s.Max(m.Geometry.Derivative(curve, d.Wrap(range.Start + span * k.ToNumber / 4.0)).Length));
        return span * fastest;
    }

    // Whether edge e's range is one its discretization can finish on: finite, increasing, and
    // with RangeLengthBound at most SegmentCap effective minimum lengths.
    IsTractableRange(m: BrepModel, e: BrepEdgeIndex, c: DiscretizationCriteria, range: NumberInterval): Boolean
    {
        var bound = m.RangeLengthBound(e, range);
        return range.Start.IsFinite && range.End.IsFinite && range.Start < range.End
            && bound.IsFinite && bound <= 0.SegmentCap.ToNumber * c.EffectiveMinLength(m.Tolerances);
    }

    // Layer 4's DiscretizeEdgeRangedCounted with an intractable range refused: the undiscretized
    // entry when IsTractableRange fails, the same entry and work otherwise.
    DiscretizeEdgeRangedGuardedCounted(m: BrepModel, t: EdgeFaceTable, twoEdgeLoop: Array<Boolean>, inRange: Boolean, e: BrepEdgeIndex, c: DiscretizationCriteria, floors: SegmentFloors): Counted<EdgeDiscretization>
    {
        if ((inRange ? (c.IsWellFormed && m.IsEdgeEvaluable(e)) : false).Not)
        {
            return Counted(Undiscretized(e), Projections(0));
        }
        var range = m.EdgeDomain(e).Range;
        return Counted(m.IsTractableRange(e, c, range) ? m.DiscretizeRanged(t, twoEdgeLoop, e, c, floors, range) : Undiscretized(e), Projections(1));
    }
}

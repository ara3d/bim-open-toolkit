//==
// # Colliding boundary segments: laws (complexity sweep, chunk F2)
//
// The count witness for CollidingSegmentsCounted (Law_WorkIsWithinSlope, layer 00, reads it),
// and the laws that tie the grid to the all-pairs functions it replaces: the flags equal
// SegmentCollides's answers segment by segment, IsSimpleRegionIndexed equals IsSimpleRegion,
// SelfIntersectionRequestsFrom equals SelfIntersectionRequests, and MeshRegionBody equals
// MeshRegion. The shapes are built here, not as UvRegion witnesses, so the library's laws over
// a UvRegion do not run on regions that are not simple on purpose.
//
// Sections, in order:
//  - Shapes
//  - Count witness
//  - Agreement on shapes
//  - Agreement on models

library UvRegionCollisionLaws
{
    //==
    // # Shapes

    // The same tolerance t in u and in v.
    PerfCollideTolerance(t: Number): UvTolerance
        => UvTolerance(ParameterTolerance(t), ParameterTolerance(t));

    // A loop through the points, every point an interior point.
    PerfCollideLoop(points: Array<UvCoordinate>): UvLoop
        => UvLoop(points, points.Map(p => UvPointSource.Interior));

    // A region of one loop and the holes.
    PerfCollideRegion(outer: Array<UvCoordinate>, holes: Array<Array<UvCoordinate>>): UvRegion
        => UvRegion(PerfCollideLoop(outer), holes.Map(h => PerfCollideLoop(h)));

    // A region of one loop.
    PerfCollideRegionOf(outer: Array<UvCoordinate>): UvRegion
        => UvRegion(PerfCollideLoop(outer), [PerfCollideLoop(outer)].Take(0));

    // n points evenly around a circle of the radius about (cu, cv), counter-clockwise.
    PerfCirclePoints(n: Integer, radius: Number, cu: Number, cv: Number): Array<UvCoordinate>
        => n.MapRange(i => UvCoordinate(cu + radius * (i.ToNumber / n.ToNumber).Turns.Cos,
            cv + radius * (i.ToNumber / n.ToNumber).Turns.Sin));

    // The square [0, 4] x [0, 4], counter-clockwise.
    PerfSquarePoints(_: UvRegion): Array<UvCoordinate>
        => [UvCoordinate(0.0, 0.0), UvCoordinate(4.0, 0.0), UvCoordinate(4.0, 4.0), UvCoordinate(0.0, 4.0)];

    // The rectangle [0, 100] x [0, 1] with its bottom side in 64 segments and its top side one:
    // the top segment is too long for the grid, so it is tested against every segment.
    PerfLongRectanglePoints(_: UvRegion): Array<UvCoordinate>
        => 65.MapRange(i => UvCoordinate(100.0 * i.ToNumber / 64.0, 0.0)).Concatenate([UvCoordinate(100.0, 1.0), UvCoordinate(0.0, 1.0)]);

    // A regular polygon of n segments and radius 1: the count witness's family.
    PerfPolygonRegion(n: Integer): UvRegion
        => PerfCollideRegionOf(PerfCirclePoints(n, 1.0, 0.0, 0.0));

    // The shapes, in order: simple polygons, a bow tie, holes inside, crossing and touching,
    // point holes off and on the boundary, a two-point loop, a spike that folds back, a NaN point
    // and a zero tolerance (the all-pairs fallback), a long segment beside short ones (the wide
    // path) with and without a point hole near it, and the 128-segment polygon.
    PerfCollideShapes(_: UvRegion): Array<UvRegion>
        => [PerfCollideRegionOf(PerfCirclePoints(12, 1.0, 0.0, 0.0)),
            PerfCollideRegionOf([UvCoordinate(0.0, 0.0), UvCoordinate(1.0, 1.0), UvCoordinate(1.0, 0.0), UvCoordinate(0.0, 1.0)]),
            PerfCollideRegion(UvRegion.PerfSquarePoints, [PerfCirclePoints(8, 1.0, 2.0, 2.0)]),
            PerfCollideRegion(UvRegion.PerfSquarePoints, [PerfCirclePoints(8, 1.0, 3.5, 2.0)]),
            PerfCollideRegion(UvRegion.PerfSquarePoints, [[UvCoordinate(2.0, 2.0)]]),
            PerfCollideRegion(UvRegion.PerfSquarePoints, [[UvCoordinate(2.0, 0.0005)]]),
            PerfCollideRegionOf([UvCoordinate(0.0, 0.0), UvCoordinate(1.0, 0.0)]),
            PerfCollideRegionOf([UvCoordinate(0.0, 0.0), UvCoordinate(4.0, 0.0), UvCoordinate(4.0, 4.0),
                UvCoordinate(2.0, 4.0), UvCoordinate(2.0, 2.0), UvCoordinate(1.9999, 4.0), UvCoordinate(0.0, 4.0)]),
            PerfCollideRegionOf(PerfCirclePoints(12, 1.0, 0.0, 0.0).Take(5)
                .Concatenate([UvCoordinate(0.0 / 0.0, 0.0)]).Concatenate(PerfCirclePoints(12, 1.0, 0.0, 0.0).Skip(6))),
            PerfCollideRegionOf(UvRegion.PerfSquarePoints),
            PerfCollideRegion(UvRegion.PerfLongRectanglePoints, [[UvCoordinate(50.0, 0.9995)]]),
            PerfCollideRegion(UvRegion.PerfLongRectanglePoints, [[UvCoordinate(50.0, 0.5)]]),
            PerfCollideRegion(UvRegion.PerfSquarePoints, [PerfCirclePoints(8, 0.5, 1.5, 2.0), PerfCirclePoints(8, 0.5, 2.5, 2.0)]),
            PerfPolygonRegion(128)];

    // The tolerance shape i is tested under: zero for shape 9, else a thousandth.
    PerfCollideShapeTolerance(i: Integer): UvTolerance
        => PerfCollideTolerance(i == 9 ? 0.0 : 0.001);

    // Whether each shape is simple: 1 yes, 0 no, -1 not pinned (the NaN point and the zero
    // tolerance, where only agreement with IsSimpleRegion is claimed).
    PerfCollideShapesSimple(_: UvRegion): Array<Integer>
        => [1, 0, 1, 0, 1, 0, 0, 0, -1, -1, 0, 1, 0, 1];

    //==
    // # Count witness

    // The segment pairs CollidingSegmentsCounted visits on a regular polygon of n segments.
    CollidingWork(n: Integer): WorkBudget
        => PerfPolygonRegion(n).CollidingSegmentsCounted(PerfCollideTolerance(0.001)).Work;

    // CollidingSegments visits at most 8 segment pairs (Insertions) per boundary segment of a
    // regular polygon, at 32 and at 128 segments; the all-pairs form visits n per segment.
    Witness_CollidingSegmentsWork(_: WorkClaim): WorkClaim
        => WorkClaim("CollidingSegments: segment pairs visited per boundary segment", Insertions(8), [32, 128], n => CollidingWork(n));

    //==
    // # Agreement on shapes

    // True when flags hold exactly SegmentCollides's answer for every segment of r.
    FlagsAgree(r: UvRegion, tol: UvTolerance, flags: Array<Boolean>): Boolean
    {
        var all = r.RegionSegments;
        return flags.Count == all.Count
            ? all.Count.Range.All(s => flags[s] == r.SegmentCollides(tol, all[s].Loop, all[s].Index))
            : false;
    }

    // On every shape, CollidingSegments gives SegmentCollides's flags, IsSimpleRegionIndexed gives
    // IsSimpleRegion's answer, and the answer is the one the shape was built to have.
    Law_Perf_CollidingSegmentsAgrees(n: Integer): Boolean
    {
        var shapes = UvRegion.PerfCollideShapes;
        var i = ((n % shapes.Count) + shapes.Count) % shapes.Count;
        var r = shapes[i];
        var tol = PerfCollideShapeTolerance(i);
        var simple = r.IsSimpleRegion(tol);
        var expected = UvRegion.PerfCollideShapesSimple[i];
        return r.FlagsAgree(tol, r.CollidingSegments(tol))
            && r.IsSimpleRegionIndexed(tol) == simple
            && (expected < 0 ? true : simple == (expected == 1));
    }

    // On layer 07's catalog loops (the inputs of Law_SimpleUvLoopIffSimpleRegion) and catalog
    // region, at generated positions and tolerances, CollidingSegments gives SegmentCollides's
    // flags and IsSimpleRegionIndexed gives IsSimpleRegion's answer.
    Law_Perf_CollidingSegmentsAgreesOnCatalog(k: Integer, x: Number, y: Number, tol: UvTolerance): Boolean
    {
        var loop = UvRegion(CatalogLoopAt(k, x, y), [CatalogLoopAt(k, x, y)].Take(0));
        var region = CatalogRegionAt(x, y, 1.0);
        return (tol.U.Value > 0.0 && tol.V.Value > 0.0)
            ? (loop.FlagsAgree(tol, loop.CollidingSegments(tol)) && loop.IsSimpleRegionIndexed(tol) == loop.IsSimpleRegion(tol)
                && region.FlagsAgree(tol, region.CollidingSegments(tol)) && region.IsSimpleRegionIndexed(tol) == region.IsSimpleRegion(tol))
            : true;
    }

    // The grid visits fewer pairs than the all-pairs form on the 128-segment polygon, and visits
    // no pair at all on a region of one point (a single segment from the point to itself).
    Law_Perf_CollidingSegmentsVisitsFewerPairs(_: Boolean): Boolean
        => CollidingWork(128).Insertions < 128 * 128
            && PerfCollideRegionOf([UvCoordinate(1.0, 1.0)]).CollidingSegmentsCounted(PerfCollideTolerance(0.001)).Work.Insertions == 0;

    //==
    // # Agreement on models

    // True when two request lists are equal, element by element.
    SameRequests(a: Array<EdgeRefinementRequest>, b: Array<EdgeRefinementRequest>): Boolean
        => a.Count == b.Count ? a.Count.Range.All(i => a[i] == b[i]) : false;

    // On face f's region: the flags equal SegmentCollides's, the simplicity test agrees, and the
    // requests from the flags equal SelfIntersectionRequests's; when the region is not simple,
    // MeshRegionBody gives MeshRegion's outcome (a simple region reaches the same MeshedOutcome
    // call in both, so it is not meshed twice here).
    FaceCollisionsAgree(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): Boolean
    {
        var r = m.RegionOf(f, d, c);
        var tol = m.RegionTolerance(f, m.ChartOf(f, r));
        var flags = r.CollidingSegments(tol);
        var simple = r.IsSimpleRegion(tol);
        return r.FlagsAgree(tol, flags)
            && r.IsSimpleRegionIndexed(tol) == simple
            && SameRequests(m.SelfIntersectionRequestsFrom(f, d, r, flags), m.SelfIntersectionRequests(f, d, r, tol))
            && (simple ? true : m.MeshRegionBody(f, d, c).SameFaceMeshOutcome(m.MeshRegion(f, d, c)));
    }

    // On every face of every model witness that has a region, discretized at a hundredth of the
    // model's size, the grid agrees with the all-pairs functions (FaceCollisionsAgree).
    Law_Perf_CollidingSegmentsAgreesOnModel(m: BrepModel): Boolean
    {
        var o = m.RelativeMeshingOptions(0.01);
        var d = m.DiscretizeAll(o.Face.Discretization, SegmentFloors.NoFloors);
        return m.Faces.Count.Range.All(k =>
            m.CanRegion(BrepFaceIndex(k), d, o.Face) ? m.FaceCollisionsAgree(BrepFaceIndex(k), d, o.Face) : true);
    }

    // On face n of the unit box (out-of-range n holds vacuously), MeshRegionBody gives
    // MeshRegion's outcome, meshed.
    Law_Perf_MeshRegionBodyAgrees(n: Integer): Boolean
    {
        var m = BrepModel.Witness_UnitBox;
        var o = m.RelativeMeshingOptions(0.01);
        var d = m.DiscretizeAll(o.Face.Discretization, SegmentFloors.NoFloors);
        return (n >= 0 && n < m.Faces.Count)
            ? (m.CanRegion(BrepFaceIndex(n), d, o.Face)
                ? m.MeshRegionBody(BrepFaceIndex(n), d, o.Face).SameFaceMeshOutcome(m.MeshRegion(BrepFaceIndex(n), d, o.Face))
                : true)
            : true;
    }
}

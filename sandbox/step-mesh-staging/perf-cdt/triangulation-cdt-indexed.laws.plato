//==
// # TriangulateRegionCdtIndexed: laws (chunk R4, TKT-386)
//
// The staged triangulation agrees with TriangulateRegionCdt field for field, its bridged ring
// and ear-clipped seed too: on every triangulated witness (the faces of the triangulation laws'
// sample models, built once per sweep), on plane stars with up to three holes and a point hole,
// on jagged star-shaped loops, and on a polygon whose ear order needs the watch lists. Its
// bridge tests and ear tests grow linearly on a star with one hole of 32 and of 128 points,
// where the old seed asked BridgeIsClear of every ring position (B segments each) and restarted
// IsEar at position 0 every round. Law_WorkIsWithinSlope (layer 00) reads the claim.
//
// Sections, in order:
//  - Comparisons
//  - Plane stars
//  - Agreement
//  - Count witness

library TriangulationCdtIndexedLaws
{
    //==
    // # Comparisons

    // Whether two triangle lists are equal, triangle for triangle and corner for corner.
    SameTriangles(a: Array<TriangleFace>, b: Array<TriangleFace>): Boolean
        => a.Count == b.Count
            ? a.Count.Range.All(i => a[i].A.Value == b[i].A.Value && a[i].B.Value == b[i].B.Value && a[i].C.Value == b[i].C.Value)
            : false;

    // Whether two index lists are equal, element by element.
    SameIndices(a: Array<Integer>, b: Array<Integer>): Boolean
        => a.Count == b.Count ? a.Count.Range.All(i => a[i] == b[i]) : false;

    // TriangulateRegionCdt's bridged ring, as its body builds it: the reference for
    // CdtRingIndexedCounted.
    CdtRingOriginal(r: UvRegion, points: Array<Point2D>): Array<Integer>
    {
        var outer = r.Outer.Points.Count.Range;
        var holes = r.Holes.Count.Range.FlatMap(h => r.Holes[h].Points.Count >= 3 ? [h] : [h].Take(0));
        var bySide = holes.Sort((a, b) => r.HoleRightmost(points, a) >= r.HoleRightmost(points, b));
        return bySide.Reduce(outer, (current, h) => current.HoleBridged(r.HoleRing(h), points, r.AllRingSegments(points)));
    }

    // The staged ring and ear-clipped seed of region r in chart are TriangulateRegionCdt's.
    CdtSeedAgreesOn(r: UvRegion, chart: FaceChart): Boolean
    {
        var points = r.BoundaryPoints.Map(uv => chart.ChartPoint(uv));
        var ring = r.CdtRingOriginal(points);
        return SameIndices(ring, r.CdtRingIndexedCounted(points).Value)
            && SameTriangles(ring.EarClipped(points), ring.EarClippedIndexedCounted(points, points.PointGridOf).Value);
    }

    // The staged triangulation of r in chart is TriangulateRegionCdt's, field for field, and so
    // are its ring and its seed.
    CdtIndexedAgreesOn(r: UvRegion, chart: FaceChart): Boolean
        => r.CdtSeedAgreesOn(chart) && SameTriangulation(r.TriangulateRegionCdt(chart), r.TriangulateRegionCdtIndexed(chart));

    //==
    // # Plane stars

    // The chart of a plane face with unit scales.
    PlaneChart(_: Integer): FaceChart
        => FaceChart(Parity.Even, 1.0, 1.0);

    // A loop of n points around (cx, cy), counter-clockwise when turn is 1 and clockwise when it
    // is -1, at radius outer for even k and inner for odd k, rotated by phase turns of a point.
    StarLoop(n: Integer, cx: Number, cy: Number, outer: Number, inner: Number, turn: Integer, phase: Number): UvLoop
        => UvLoop(n.MapRange(k => UvCoordinate(
                cx + (k % 2 == 0 ? outer : inner) * (turn.ToNumber * Number.Tau * (k.ToNumber + phase) / n.ToNumber).Cos,
                cy + (k % 2 == 0 ? outer : inner) * (turn.ToNumber * Number.Tau * (k.ToNumber + phase) / n.ToNumber).Sin)),
            n.MapRange(k => UvPointSource.Interior));

    // A star of n points between radii 2 and 1.6 with one circular hole of n / 4 points and
    // radius 0.8 at its centre: the count witness's family, n boundary points in all.
    StarWithHole(n: Integer): UvRegion
        => UvRegion(StarLoop(n - n / 4, 0.0, 0.0, 2.0, 1.6, 1, 0.0), [StarLoop(n / 4, 0.0, 0.0, 0.8, 0.8, -1, 0.0)]);

    // Star case k (any Integer, read as |k|): a star of 12 + 6 |k| points between radii 2 and
    // 1.4 (deep notches: reflex corners and blocked ears), rotated by |k| / 7 of a point, with
    // 1 + |k| % 3 holes of radius 0.3 (one of radius 0.8 at the centre when alone) and, for odd
    // k, a point hole at (0, 1.3).
    StarCase(k: Integer): UvRegion
    {
        var j = k.Abs;
        var count = 1 + j % 3;
        var holes = count.MapRange(i => count == 1
            ? StarLoop(6 + j, 0.0, 0.0, 0.8, 0.75, -1, 0.0)
            : StarLoop(4 + j % 4, 0.9 * (Number.Tau * i.ToNumber / count.ToNumber).Cos, 0.9 * (Number.Tau * i.ToNumber / count.ToNumber).Sin, 0.3, 0.3, -1, 0.5));
        var point = UvLoop([UvCoordinate(0.0, 1.3)], [UvPointSource.Interior]);
        return UvRegion(StarLoop(12 + 6 * j, 0.0, 0.0, 2.0, 1.4, 1, j.ToNumber / 7.0), j % 2 == 1 ? holes.Concatenate([point]) : holes);
    }

    // A pseudo-random fraction in [0, 1) for k and seed: the fractional part of a scaled sine.
    JitterAt(k: Integer, seed: Integer): Number
    {
        var x = ((k.ToNumber * 12.9898 + seed.ToNumber * 78.233).Sin * 43758.5453).Abs;
        return x - x.Floor;
    }

    // Jagged case k (any Integer, read as |k|): a counter-clockwise loop of 16 + 4 |k| points
    // around the origin at pseudo-random radii between 1.2 and 2, star-shaped so simple, with
    // |k| % 3 square holes of side 0.3 at pseudo-random places within radius 0.7.
    JaggedCase(k: Integer): UvRegion
    {
        var j = k.Abs;
        var n = 16 + 4 * j;
        var outer = UvLoop(n.MapRange(i => UvCoordinate(
                (1.2 + 0.8 * JitterAt(i, j)) * (Number.Tau * i.ToNumber / n.ToNumber).Cos,
                (1.2 + 0.8 * JitterAt(i, j)) * (Number.Tau * i.ToNumber / n.ToNumber).Sin)),
            n.MapRange(i => UvPointSource.Interior));
        var holes = (j % 3).MapRange(h => StarLoop(4, (h.ToNumber - 1.0) * 0.6, 0.6 * JitterAt(h, j + 1) - 0.3, 0.2, 0.2, -1, 0.5));
        return UvRegion(outer, holes);
    }

    // A ten-point polygon where a slot's only remaining blocker leaves the ring while the slot's
    // triangle stays as it was: ear clipping without the watch lists clips (4, 8, 2) last where
    // EarClipped clips (3, 4, 8). Found by simulating both orders on random star polygons.
    WatchedCase(_: Integer): UvRegion
        => UvRegion(UvLoop([UvCoordinate(0.59, 0.38), UvCoordinate(1.02, 1.69), UvCoordinate(0.34, 0.68), UvCoordinate(0.49, 1.84), UvCoordinate(0.33, -1.44), UvCoordinate(0.97, -1.22), UvCoordinate(1.28, -1.26), UvCoordinate(0.91, -0.46), UvCoordinate(0.66, -0.32), UvCoordinate(1.59, -0.11)], 10.MapRange(i => UvPointSource.Interior)), [UvLoop([UvCoordinate(0.0, 0.0)], [UvPointSource.Interior])].Take(0));

    //==
    // # Agreement

    // On every triangulated witness (each face of the triangulation laws' six sample models),
    // the staged triangulation is the witness's Cdt, field for field, with its ring and seed.
    Law_Perf_TriangulateRegionCdtIndexedAgrees(w: TriangulatedWitness): Boolean
        => w.Region.CdtSeedAgreesOn(w.Chart) && SameTriangulation(w.Cdt, w.Region.TriangulateRegionCdtIndexed(w.Chart));

    // On star case k, the staged triangulation, ring and seed are TriangulateRegionCdt's.
    Law_Perf_TriangulateRegionCdtIndexedAgreesOnStars(k: Integer): Boolean
        => StarCase(k).CdtIndexedAgreesOn(PlaneChart(0));

    // On jagged case k, the staged triangulation, ring and seed are TriangulateRegionCdt's.
    Law_Perf_TriangulateRegionCdtIndexedAgreesOnJagged(k: Integer): Boolean
        => JaggedCase(k).CdtIndexedAgreesOn(PlaneChart(0));

    // On the polygon whose ear order needs the watch lists, the staged triangulation, ring and
    // seed are TriangulateRegionCdt's.
    Law_Perf_TriangulateRegionCdtIndexedAgreesWhenWoken(_: Integer): Boolean
        => WatchedCase(0).CdtIndexedAgreesOn(PlaneChart(0));

    // The star cases reach the heap: on star case 4 there are more ear tests than ring slots,
    // so some slot behind the frontier is tested again, and the agreement laws exercise more
    // than one pass of the frontier.
    Law_Perf_StarCasesRetestSlots(_: Integer): Boolean
    {
        var r = StarCase(4);
        var points = r.BoundaryPoints.Map(uv => PlaneChart(0).ChartPoint(uv));
        var ring = r.CdtRingIndexedCounted(points).Value;
        return ring.EarClippedIndexedCounted(points, points.PointGridOf).Work.Insertions > ring.Count;
    }

    //==
    // # Count witness

    // The work of the staged triangulation of the star with one hole, n boundary points.
    StarCdtWork(n: Integer): WorkBudget
        => StarWithHole(n).TriangulateRegionCdtIndexedCounted(PlaneChart(0)).Work;

    // TriangulateRegionCdtIndexed's bridge tests and ear tests (Insertions) are at most 12 per
    // boundary point on a star with one hole, at 32 and 128 points. The old seed tested every
    // ring position for the bridge, each against all B segments, and ear tests restarted at
    // position 0 every round.
    Witness_TriangulateRegionCdtWork(_: WorkClaim): WorkClaim
        => WorkClaim("TriangulateRegionCdtIndexed: bridge and ear tests per boundary point of a star with one hole", Insertions(12), [32, 128], n => StarCdtWork(n));
}

//==
// # Test mirrors (step C, staged; delete at merge)
//
// The interpreter calls a bodiless library function even when a staging folder declares a bodied
// one beside it (checked 2026-10-18), so the staged bodies cannot be reached through the library's
// own call chain until the supervisor wires them. These mirrors copy the chain from RegionOf and
// MeshFace down to the three staged bodies, line for line, with the bodiless call replaced by the
// staged body. After wiring, each mirror equals the library function its name ends without
// "Poles"; at merge, delete this file and rename the calls in poles.laws.plato (TRACK.md, "Merge
// instructions").
//
// Sections, in order:
//  - The region
//  - The face mesh
//  - The model mesh

library PolesMirrors
{
    //==
    // # The region

    // Mirror of UnorientedRegionOf.
    UnorientedRegionOfPoles(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): UvRegion
        => m.AddMissingSeamsAndPolesPoles(f, m.MeshedBounds(f).Map(b => m.Unwrap(f, m.LoopToUv(f, b, d))), c);

    // Mirror of RegionOf.
    RegionOfPoles(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): UvRegion
        => m.OrientRegion(f, m.UnorientedRegionOfPoles(f, d, c));

    // Mirror of AddMissingSeamsAndPoles.
    AddMissingSeamsAndPolesPoles(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): UvRegion
        => m.IsPlainSurfaceOf(f)
            ? loops.OuterByContainment
            : m.CompletePeriodicRegionPoles(f, loops, c);

    // Mirror of CompletePeriodicRegion, through the replacement WithSeamCutAll.
    CompletePeriodicRegionPoles(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): UvRegion
        => m.OuterByArea(f, m.WithSeamCutAll(f, m.WithPoleSegmentsPoles(f, loops, c), c));

    // Mirror of WithPoleSegments, calling ExpandedPolesBody.
    WithPoleSegmentsPoles(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): Array<UvLoop>
        => m.HasCollapsedLine(f) ? m.ExpandedPolesBody(f, loops, c) : loops;

    //==
    // # The face mesh

    // Mirror of MeshFace.
    MeshFacePoles(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): FaceMeshOutcome
        => m.HasPolyLoop(f)
            ? f.UnmeshedOutcome("FACE-POLY-LOOP",
                "This face is bounded by a poly loop, which version 1 does not mesh; the decoder should give it edges.")
            : m.MeshRegionPoles(f, d, c);

    // Mirror of MeshRegion.
    MeshRegionPoles(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, c: FaceMeshingCriteria): FaceMeshOutcome
    {
        var raw = m.UnorientedRegionOfPoles(f, d, c);
        var r = m.OrientRegion(f, raw);
        var chart = m.ChartOf(f, r);
        var blocking = m.SelfIntersectionRequests(f, d, r, m.RegionTolerance(f, chart));
        return r.IsSimpleRegion(m.RegionTolerance(f, chart))
            ? m.MeshedOutcomePoles(f, d, raw, r, chart, c)
            : (blocking.Count > 0
                ? FaceMeshOutcome(EmptyFaceMesh(f), blocking, blocking.Map(q => q.RequestDiagnostic))
                : f.UnmeshedOutcome("FACE-REGION-NOT-SIMPLE",
                    "Synthetic seam or pole segments of this face collide in parameter space; the face is not meshed."));
    }

    // Mirror of MeshedOutcome.
    MeshedOutcomePoles(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, raw: UvRegion, r: UvRegion, chart: FaceChart, c: FaceMeshingCriteria): FaceMeshOutcome
    {
        var grid = m.FaceQuadGrid(f, d, r, c);
        var t = m.GridOrTriangles(f, r, chart, grid, c);
        var advisory = m.CoarseSegmentRequests(f, d, r, c).Concatenate(m.QuadCountRequests(d, grid, c));
        return FaceMeshOutcome(m.LiftPoles(f, d, t), advisory,
            advisory.Map(q => q.RequestDiagnostic).Concatenate(m.ReversalDiagnostics(f, raw)));
    }

    // Mirror of Lift.
    LiftPoles(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, t: UvTriangulation): FaceMesh
    {
        var n = t.Points.Count;
        var joined = n.Range.FlatMap(i => n.Range.FlatMap(j =>
            (i < j ? IdentifiedSources(t.Sources[i], t.Sources[j]) : false) ? [i * n + j] : n.Range.Take(0)));
        var roots = ClassRoots(n, joined.Map(k => k / n), joined.Map(k => k % n));
        var firsts = n.Range.FlatMap(i => roots[i] == i ? [i] : n.Range.Take(0));
        var local = n.MapRange(i => VertexIndex(firsts.PositionOfItem(roots[i])));
        var s = m.SurfaceOf(f);
        return FaceMesh(
            f,
            t.Points,
            t.Sources,
            local,
            firsts.Map(i => m.SharedPosition(d, t.Sources[i], m.Geometry.Eval(s, t.Points[i]))),
            t.Points.Map(uv => m.LiftNormalPoles(f, uv)),
            t.Triangles.FlatMap(x => x.DistinctlyLifted(local) ? [x] : t.Triangles.Take(0))
                .Concatenate(t.Quads.FlatMap(q => q.CollapsedToTriangle(local))),
            t.Quads.FlatMap(q => q.DistinctlyLifted(local) ? [q] : t.Quads.Take(0)),
            firsts.Map(i => d.ProvenanceOfSource(f, t.Sources[i], t.Points[i])));
    }

    // Mirror of LiftNormal, calling LimitNormalBody.
    LiftNormalPoles(m: BrepModel, f: BrepFaceIndex, uv: UvCoordinate): Direction3D
        => m.IsOnCollapsedLine(f, uv)
            ? Direction3D(m.Geometry.LimitNormalBody(m.SurfaceOf(f), uv).Vector * m.FaceSenseSign(f))
            : Direction3D(m.FaceNormalAt(f, uv, Vector3D.UnitZ).NormalizeOr(Vector3D.UnitZ));

    //==
    // # The model mesh

    // Every face of model m meshed once (no refinement round) under options o, with the
    // canonical discretizations, and assembled (layer 06): the round-0 mesh of layer 08's loop,
    // which is its final mesh when no face asks for refinement.
    ModelMeshPoles(m: BrepModel, o: MeshingOptions): ModelMesh
    {
        var d = m.DiscretizeAll(o.Face.Discretization, SegmentFloors.NoFloors);
        var faceMeshes = m.Faces.Count.MapRange(f => m.MeshFacePoles(BrepFaceIndex(f), d, o.Face).Mesh);
        return m.AssembleModelMesh(faceMeshes, m.NumberMeshVertices(d, faceMeshes));
    }

    // The requests every face of model m makes in round 0 under options o.
    RoundZeroRequestsPoles(m: BrepModel, o: MeshingOptions): Array<EdgeRefinementRequest>
    {
        var d = m.DiscretizeAll(o.Face.Discretization, SegmentFloors.NoFloors);
        return m.Faces.Count.Range.FlatMap(f => m.MeshFacePoles(BrepFaceIndex(f), d, o.Face).Requests);
    }
}

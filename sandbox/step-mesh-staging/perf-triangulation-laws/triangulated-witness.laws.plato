//==
// # Laws over triangulated witnesses (complexity sweep, chunk L4)
//
// The laws of triangulation.laws.plato, the face laws of face-meshing.laws.plato that rebuilt a
// triangulation or MeshFace per case, and Law_UpdatedNeighboursAreTheTable
// (triangulation-fast.laws.plato), restated over TriangulatedWitness: one witness per face of
// TriangulationLaws' six sample models, built once per sweep (42 faces, every one triangulable).
// Each law reads the witness's region, chart, triangulations and outcome and states the original
// claim on them; none calls RegionOf, TriangulateRegionCdt, RefineToSurfaceByInsertion or
// MeshFace except Law_Perf_RefinedIsFaceTriangulation and Law_Perf_MinAngleNoWorseThanLibrary,
// whose claims compare the witness with one fresh build. A law about some samples only (the
// boxes, the cylinder and sector) is vacuous on the others' faces. The original laws over an
// Integer quantified over the faces of the sample it drew; the witnesses list every face of
// every sample, so each law here states the conjunction of the original's cases. At merge each
// Law_Perf_<X> replaces Law_<X> (TRACK.md).
//
// Sections, in order:
//  - The witness list
//  - The constrained triangulation
//  - Refinement by insertion
//  - Element quality
//  - Triangulations, lifting and the face mesh

library TriangulatedWitnessLaws
{
    //==
    // # The witness list

    // Every face of sample model k is triangulable and the model has TriSampleFaceCount(k)
    // faces, so the witness list below, one witness per face, covers every face the original
    // laws quantified over.
    Law_Perf_TriangulatedWitnessesCoverTheSamples(k: Integer): Boolean
    {
        var m = TriSampleModel(k);
        var d = m.TriDiscretizations;
        var c = TriCriteria(0);
        return m.Faces.Count == TriSampleFaceCount(k)
            && m.Faces.Count.Range.All(i => m.CanTriangulateFaceRegionOnce(BrepFaceIndex(i), d, c));
    }

    // CanTriangulateFaceRegionOnce agrees with CanTriangulateFace on every witness face.
    Law_Perf_CanTriangulateFaceRegionOnceAgrees(w: TriangulatedWitness): Boolean
        => w.Model.CanTriangulateFaceRegionOnce(w.Face, w.Discretizations, TriCriteria(0))
            == w.Model.CanTriangulateFace(w.Face, w.Discretizations, TriCriteria(0));

    // True when two triangulations are identical in every field.
    SameTriangulation(a: UvTriangulation, b: UvTriangulation): Boolean
        => SameUvPoints(a.Points, b.Points)
            && a.Sources.Count == b.Sources.Count && a.Sources.Count.Range.All(i => a.Sources[i] == b.Sources[i])
            && a.Triangles.Count == b.Triangles.Count && a.Triangles.Count.Range.All(i => a.Triangles[i] == b.Triangles[i])
            && a.Quads.Count == b.Quads.Count && a.Quads.Count.Range.All(i => a.Quads[i] == b.Quads[i]);

    // The witness's refined triangulation is FaceTriangulation's, field for field: the sample
    // criteria do not prefer quads, so the laws of face-meshing.laws.plato over FaceTriangulation
    // are stated on Refined.
    Law_Perf_RefinedIsFaceTriangulation(w: TriangulatedWitness): Boolean
        => SameTriangulation(w.Refined, w.Model.FaceTriangulation(w.Face, w.Discretizations, TriCriteria(0)));

    // The witness's MeshFace outcome holds Refined lifted: the laws over MeshFace's mesh and over
    // Lift read one face mesh.
    Law_Perf_OutcomeLiftsRefined(w: TriangulatedWitness): Boolean
        => SameFaceMesh(w.Outcome.Mesh, w.Model.Lift(w.Face, w.Discretizations, w.Refined));

    // One witness per face of each sample model, in TriSampleModel's order.
    Witness_UnitBoxFace0Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(0, "UnitBox face 0", 0);
    Witness_UnitBoxFace1Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(0, "UnitBox face 1", 1);
    Witness_UnitBoxFace2Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(0, "UnitBox face 2", 2);
    Witness_UnitBoxFace3Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(0, "UnitBox face 3", 3);
    Witness_UnitBoxFace4Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(0, "UnitBox face 4", 4);
    Witness_UnitBoxFace5Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(0, "UnitBox face 5", 5);
    Witness_CylinderFace0Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(1, "Cylinder face 0", 0);
    Witness_CylinderFace1Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(1, "Cylinder face 1", 1);
    Witness_CylinderFace2Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(1, "Cylinder face 2", 2);
    Witness_BlockWithThroughHoleFace0Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(2, "BlockWithThroughHole face 0", 0);
    Witness_BlockWithThroughHoleFace1Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(2, "BlockWithThroughHole face 1", 1);
    Witness_BlockWithThroughHoleFace2Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(2, "BlockWithThroughHole face 2", 2);
    Witness_BlockWithThroughHoleFace3Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(2, "BlockWithThroughHole face 3", 3);
    Witness_BlockWithThroughHoleFace4Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(2, "BlockWithThroughHole face 4", 4);
    Witness_BlockWithThroughHoleFace5Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(2, "BlockWithThroughHole face 5", 5);
    Witness_BlockWithThroughHoleFace6Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(2, "BlockWithThroughHole face 6", 6);
    Witness_BlockWithThroughHoleFace7Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(2, "BlockWithThroughHole face 7", 7);
    Witness_BlockWithThroughHoleFace8Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(2, "BlockWithThroughHole face 8", 8);
    Witness_BlockWithThroughHoleFace9Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(2, "BlockWithThroughHole face 9", 9);
    Witness_HollowBoxFace0Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(3, "HollowBox face 0", 0);
    Witness_HollowBoxFace1Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(3, "HollowBox face 1", 1);
    Witness_HollowBoxFace2Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(3, "HollowBox face 2", 2);
    Witness_HollowBoxFace3Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(3, "HollowBox face 3", 3);
    Witness_HollowBoxFace4Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(3, "HollowBox face 4", 4);
    Witness_HollowBoxFace5Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(3, "HollowBox face 5", 5);
    Witness_HollowBoxFace6Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(3, "HollowBox face 6", 6);
    Witness_HollowBoxFace7Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(3, "HollowBox face 7", 7);
    Witness_HollowBoxFace8Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(3, "HollowBox face 8", 8);
    Witness_HollowBoxFace9Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(3, "HollowBox face 9", 9);
    Witness_HollowBoxFace10Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(3, "HollowBox face 10", 10);
    Witness_HollowBoxFace11Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(3, "HollowBox face 11", 11);
    Witness_QuarterSectorFace0Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(4, "QuarterSector face 0", 0);
    Witness_QuarterSectorFace1Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(4, "QuarterSector face 1", 1);
    Witness_QuarterSectorFace2Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(4, "QuarterSector face 2", 2);
    Witness_QuarterSectorFace3Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(4, "QuarterSector face 3", 3);
    Witness_QuarterSectorFace4Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(4, "QuarterSector face 4", 4);
    Witness_Box234Face0Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(5, "Box234 face 0", 0);
    Witness_Box234Face1Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(5, "Box234 face 1", 1);
    Witness_Box234Face2Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(5, "Box234 face 2", 2);
    Witness_Box234Face3Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(5, "Box234 face 3", 3);
    Witness_Box234Face4Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(5, "Box234 face 4", 4);
    Witness_Box234Face5Triangulated(_: TriangulatedWitness): TriangulatedWitness
        => TriangulatedAt(5, "Box234 face 5", 5);

    //==
    // # The constrained triangulation

    // Law_CdtKeepsBoundary: TriangulateRegionCdt keeps the boundary points with their sources, in
    // order, and adds no point.
    Law_Perf_CdtKeepsBoundary(w: TriangulatedWitness): Boolean
        => w.Region.CdtKeepsBoundaryOn(w.Cdt);

    // Law_CdtKeepsEverySegment: every boundary segment is a side of exactly one triangle, in the
    // boundary's direction.
    Law_Perf_CdtKeepsEverySegment(w: TriangulatedWitness): Boolean
        => w.Region.KeepsEverySegmentOn(w.Cdt);

    // Law_CdtIsConforming: every side that is not a boundary segment is shared by exactly two
    // triangles run opposite ways, every point is a corner, and there are no quads.
    Law_Perf_CdtIsConforming(w: TriangulatedWitness): Boolean
        => w.Region.CdtIsConformingOn(w.Cdt);

    // Law_CdtPositiveOrientation: every triangle is positive in the chart.
    Law_Perf_CdtPositiveOrientation(w: TriangulatedWitness): Boolean
        => w.Region.CdtPositiveOn(w.Chart, w.Cdt);

    // Law_CdtNoFlippableEdge: no edge is flippable by the in-circle determinant.
    Law_Perf_CdtNoFlippableEdge(w: TriangulatedWitness): Boolean
        => w.Region.FlippableEdgeCount(w.Cdt, w.Chart) == 0;

    // Law_CdtAreaIsRegionArea: the triangles' chart areas sum to the region's.
    Law_Perf_CdtAreaIsRegionArea(w: TriangulatedWitness): Boolean
        => w.Model.AreasSumOn(w.Face, w.Region, w.Cdt, w.Model.RegionTolerance(w.Face, w.Chart));

    // Law_UpdatedNeighboursAreTheTable: after one insertion into the constrained triangulation,
    // UpdatedNeighbours gives the table NeighbourSlots builds from scratch.
    Law_Perf_UpdatedNeighboursAreTheTable(w: TriangulatedWitness): Boolean
        => w.Model.UpdatedTableIsTable(w.Face, w.Region, w.Chart);

    //==
    // # Refinement by insertion

    // Law_RefineMeetsContract: the refinement meets every postcondition of RefineToSurface.
    Law_Perf_RefineMeetsContract(w: TriangulatedWitness): Boolean
        => w.Model.MeetsRefineContractOn(w.Face, w.Region, w.Chart, w.Refined);

    // Law_RefinedNoFlippableEdge: the refined triangulation is still constrained Delaunay.
    Law_Perf_RefinedNoFlippableEdge(w: TriangulatedWitness): Boolean
        => w.Region.FlippableEdgeCount(w.Refined, w.Chart) == 0;

    //==
    // # Element quality

    // Law_RefinedInteriorMeetsMinAngle: every refined triangle that touches no boundary point has
    // its smallest lifted angle at least 30 degrees. Fails on the cylinder, as before
    // (reviews/verdicts-cpu64.tsv: k = 1).
    Law_Perf_RefinedInteriorMeetsMinAngle(w: TriangulatedWitness): Boolean
        => w.Model.RefinedMinAngleOn(w.Face, w.Region, w.Refined);

    // Law_MinAngleNoWorseThanLibrary: the refinement's smallest lifted angle is no smaller than
    // RefinedTriangulation's, within 1e-5 rad; one fresh RefinedTriangulation per face.
    Law_Perf_MinAngleNoWorseThanLibrary(w: TriangulatedWitness): Boolean
    {
        var library = w.Model.RefinedTriangulation(w.Face, w.Region, w.Chart, TriCriteria(0));
        return w.Model.SmallestLiftedAngle(w.Face, w.Refined) >= w.Model.SmallestLiftedAngle(w.Face, library) - 1e-5;
    }

    // Law_MinAngleBetterOnCylinders: on every face of the cylinder (sample 1) and the quarter
    // sector (4), the smallest lifted angle is larger than the library's before the merge, 4.99
    // and 8.50 degrees. The original compared the least over the faces, which is the same claim.
    Law_Perf_MinAngleBetterOnCylinders(w: TriangulatedWitness): Boolean
        => (w.Sample == 1 || w.Sample == 4)
            ? w.Model.SmallestLiftedAngle(w.Face, w.Refined) > (w.Sample == 4 ? 8.50 : 4.99) * Number.Pi / 180.0
            : true;

    // Law_BoxFacesStayTwoTriangles: every face of the unit box (sample 0) and of the 2 x 3 x 4
    // box (5) is refined to its four corners and two triangles.
    Law_Perf_BoxFacesStayTwoTriangles(w: TriangulatedWitness): Boolean
        => (w.Sample == 0 || w.Sample == 5)
            ? w.Refined.Points.Count == 4 && w.Refined.Triangles.Count == 2
            : true;

    // The quality requests at 30 degrees for the witness's face, on its refined triangulation.
    QualityRequestsOn(w: TriangulatedWitness): Array<EdgeRefinementRequest>
        => w.Model.QualitySegmentRequestsCdt(w.Face, w.Discretizations, w.Region, w.Refined, TriCriteria(0), 30.0.Degrees);

    // The sum of the extents of the face mesh's positions along x, y and z: for a face of the
    // 2 x 3 x 4 box, 6 exactly on its 2 x 4 faces (5 on the 2 x 3 and 7 on the 3 x 4).
    ExtentSum(fm: FaceMesh): Number
    {
        var p = fm.Positions;
        var lo = p.Reduce(Point3D(Number.MaxValue, Number.MaxValue, Number.MaxValue), (a, x) => Point3D(a.X.Min(x.X), a.Y.Min(x.Y), a.Z.Min(x.Z)));
        var hi = p.Reduce(Point3D(0.0 - Number.MaxValue, 0.0 - Number.MaxValue, 0.0 - Number.MaxValue), (a, x) => Point3D(a.X.Max(x.X), a.Y.Max(x.Y), a.Z.Max(x.Z)));
        return (hi.X - lo.X) + (hi.Y - lo.Y) + (hi.Z - lo.Z);
    }

    // Law_QualityRequestsOnBoxes: the quality requests at 30 degrees ask for nothing on the unit
    // box (sample 0), and on the 2 x 3 x 4 box (5) every request names an edge of its face. The
    // original's "some face of the 2 x 3 x 4 box asks" is stated per face, and more sharply: a
    // face asks exactly when it is a 2 x 4 face, the one shape whose two triangles stay below 30
    // degrees (atan(1/2) = 26.6; atan(2/3) = 33.7 and atan(3/4) = 36.9 pass).
    Law_Perf_QualityRequestsOnBoxes(w: TriangulatedWitness): Boolean
    {
        var requests = (w.Sample == 0 || w.Sample == 5) ? QualityRequestsOn(w) : EdgeRefinementRequest.NoRequests;
        return w.Sample == 0
            ? requests.Count == 0
            : (w.Sample == 5
                ? (requests.Count > 0) == ((ExtentSum(w.Outcome.Mesh) - 6.0).Abs < 1e-9)
                    && requests.All(q => w.Model.FaceEdges(w.Face).Any(e => e == q.Edge))
                : true);
    }

    //==
    // # Triangulations, lifting and the face mesh

    // Law_TriangulationCornersInRange at every element of the face's triangulation.
    Law_Perf_TriangulationCornersInRange(w: TriangulatedWitness): Boolean
        => w.Refined.CornersInRangeOn;

    // Law_EveryPointIsACorner at every point of the face's triangulation.
    Law_Perf_EveryPointIsACorner(w: TriangulatedWitness): Boolean
        => w.Refined.EveryPointIsACornerOn;

    // Law_LiftKeepsPoints at every point of the face's triangulation and its lift.
    Law_Perf_LiftKeepsPoints(w: TriangulatedWitness): Boolean
        => w.Refined.LiftKeepsPointsOn(w.Outcome.Mesh);

    // Law_LocalVertexInRange at every point of MeshFace's mesh.
    Law_Perf_LocalVertexInRange(w: TriangulatedWitness): Boolean
        => w.Outcome.Mesh.LocalVertexInRangeOn;

    // Law_LocalVertexSurjective at every local vertex of MeshFace's mesh.
    Law_Perf_LocalVertexSurjective(w: TriangulatedWitness): Boolean
        => w.Outcome.Mesh.LocalVertexSurjectiveOn;

    // Law_ProvenanceMatchesSource at every point of MeshFace's mesh.
    Law_Perf_ProvenanceMatchesSource(w: TriangulatedWitness): Boolean
        => w.Discretizations.ProvenanceMatchesSourceOn(w.Outcome.Mesh);

    // Law_RequestsNameFaceEdges at every request of MeshFace's outcome.
    Law_Perf_RequestsNameFaceEdges(w: TriangulatedWitness): Boolean
        => w.Model.RequestsNameFaceEdgesOn(w.Face, w.Outcome);
}

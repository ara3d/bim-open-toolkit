//==
// # Triangulated witnesses (complexity sweep, chunk L4)
//
// One face of a sample model, triangulated and meshed once per sweep under the witness options,
// so a law over it reads the built values instead of rebuilding the region, the constrained
// triangulation, the refinement or MeshFace per case (testing strategy, part a; TKT-356). The law
// runner builds every Witness_* of this type once, before any law runs, and exhausts the finite
// list for a law parameter of the type: the type is not generatable, since it holds a BrepModel.

// Face Face of sample model Sample (TriangulationLaws.TriSampleModel), with everything layer 05
// builds for it under the sample criteria (TriangulationLaws.TriCriteria).
// Invariants: Model is TriSampleModel(Sample); Discretizations is Model.TriDiscretizations;
// Region is Model.RegionOf(Face, Discretizations, criteria) and Chart is Model.ChartOf(Face,
// Region); Cdt is Region.TriangulateRegionCdt(Chart); Refined is RefineToSurfaceByInsertion on
// Cdt (TriangulationLaws.RefinedCdt), which is also FaceTriangulation, since the criteria do not
// prefer quads (Law_Perf_RefinedIsFaceTriangulation); Outcome is Model.MeshFace(Face,
// Discretizations, criteria), whose mesh is Lift of Refined.
type TriangulatedWitness
{
    Name: String;
    Sample: Integer;
    Model: BrepModel;
    Face: BrepFaceIndex;
    Discretizations: EdgeDiscretizations;
    Region: UvRegion;
    Chart: FaceChart;
    Cdt: UvTriangulation;
    Refined: UvTriangulation;
    Outcome: FaceMeshOutcome;
}

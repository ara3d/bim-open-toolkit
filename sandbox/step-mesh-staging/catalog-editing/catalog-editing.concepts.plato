//==
// # Editing

// A value an edit applies to. Law: applying the outcome's Inverse to the
// outcome's model gives the value back (Law_Catalog_InverseUndoes). BrepModel
// has the obligation in CatalogEditingOutcome's Apply but is declared in the
// library, so naming the concept in its implements clause waits for the merge
// (TRACK.md, Contract requests).
interface IEditable
{
    Apply(x: Self, edit: ModelEdit): EditOutcome;
}

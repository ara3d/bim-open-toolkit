// TKT-465 cause B over the extracted corpus face (corpus-nina-b222-face-678.library.plato). CornersOnSurface is
// closed-wrap.laws.plato's.
library V1ReliabilityCorpusWitnessNinaLaws
{
    // SHO/NINA-B222-W1x2.STEP face 678, a cylinder bounded by four surface-curve edges mastered by 2D lines along u
    // whose v velocity is a rounding residue. Before J5 (3cc7edb4) the closest-parameter search on those
    // near-periodic lines landed whole turns away, so the edge samples' parameters sat up to 0.55 mm from their
    // points and 1 of the face's 8 elements flipped; with J5 every corner lies on the cylinder. Witness face 3 is the
    // corpus face; its four neighbours are the ring that discretizes its edges as in the file.
    Law_V1Reliability_NinaB222Face678CornersOnSurface(_: Integer): Boolean
    {
        var m = BrepModel.Witness_NinaB222W1x2Face678;
        return m.CornersOnSurface(m.FinalState(HostMeshingOptions(1.0), m.AllFaces), 3, 1e-4);
    }
}

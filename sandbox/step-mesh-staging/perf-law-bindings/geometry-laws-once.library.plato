//==
// # Layer 1 law claims with each value bound once (complexity sweep, chunk L6)
//
// The claims of BrepGeometryLaws and BsplineInverseLaws that computed one
// value twice or more per case (a projection, a closest parameter, a
// pcurve sample, a basis function), restated so that each value is computed
// once and passed on. Each returns exactly what the original returns: the
// same calls on the same arguments, with the repeats removed.
//
// Sections, in order:
//  - Surfaces: inverse evaluation
//  - Curves: inverse evaluation
//  - Pcurves against their space curves
//  - Oracles

library GeometryLawsOnce
{
    //==
    // # Surfaces: inverse evaluation

    // The claim of Law_ProjectNoWorseThanSample with the minimizer found as
    // best and the sample as sample: |S(best) - p| <= |S(sample) - p| plus
    // the rounding of the two evaluations.
    ProjectNoWorseThan(g: GeometrySet, s: SurfaceIndex, p: Point3D, best: UvCoordinate, sample: UvCoordinate): Boolean
        => g.Eval(s, best).Distance(p)
            <= g.Eval(s, sample).Distance(p)
                + ResolutionAt(g.EvaluationMagnitude(s, best) + g.EvaluationMagnitude(s, sample) + p.PositionVector.Length).Value;

    // Law_ProjectRecoversPoint and Law_ProjectIsCanonical of layer 1 on one
    // sample uv, the sample's point and its projection computed once.
    // Precondition: g.CanEvaluate(s).
    ProjectRecoversCanonicallyAt(g: GeometrySet, s: SurfaceIndex, uv: UvCoordinate, tol: Tolerances): Boolean
    {
        var d = g.Domain(s);
        var q = g.Eval(s, d.SampleIn(uv));
        var best = g.Project(s, q);
        return g.Eval(s, best).Coincident(q, tol.Length)
            && d.IsCanonical(best, g.UvFloorOf(s, tol));
    }

    // Law_ProjectNoWorseThanSample and Law_ProjectIsStationary in both
    // parameters, one projection of p shared by the three claims.
    // Precondition: g.CanEvaluate(s).
    ProjectIsMinimalAt(g: GeometrySet, s: SurfaceIndex, p: Point3D, uv: UvCoordinate): Boolean
    {
        var best = g.Project(s, p);
        return g.ProjectNoWorseThan(s, p, best, g.Domain(s).SampleIn(uv))
            && g.ProjectStationaryAt(s, p, best, SurfaceParameter.ParameterU)
            && g.ProjectStationaryAt(s, p, best, SurfaceParameter.ParameterV);
    }

    //==
    // # Curves: inverse evaluation

    // Law_ClosestParameterNoWorseThanSample and
    // Law_ClosestParameterIsStationary on curve c, one closest parameter of p
    // shared by both. True where c cannot be evaluated, as both originals.
    ClosestParameterIsMinimalAt(g: GeometrySet, c: CurveIndex, p: Point3D, s: Number): Boolean
    {
        if (!g.CanEvaluate(c))
        {
            return true;
        }
        var best = g.ClosestParameter(c, p);
        return g.NoWorseThan(c, p, best, g.Domain(c).SampleIn(s)) && g.StationaryAt(c, p, best);
    }

    // True when t lies in [-floor, period + floor]: the bounded window of a
    // pcurve's closest parameter.
    IsInPeriodWindow(t: Number, period: Number, floor: Number): Boolean
        => t >= -floor && t <= period + floor;

    //==
    // # Pcurves against their space curves

    // True when a curve domain has a finite, positive parameter length, so
    // a sample of it maps by proportion onto a pcurve range.
    HasBoundedRun(d: CurveDomain): Boolean
        => d.ParameterLength.IsFinite && d.ParameterLength > 0.0;

    // PcurveSampleFor's bounded case: sample t of the space curve's domain
    // d, carried by proportion onto range, the pcurve range covering it
    // (PcurveRangeOver), and moved into the pcurve's domain.
    // Precondition: d.HasBoundedRun.
    PcurveSampleAlong(g: GeometrySet, p: PcurveIndex, d: CurveDomain, range: NumberInterval, t: Number): Number
        => g.Domain(p).IntoRange(range.Lerp((d.SampleIn(t) - d.Range.Start) / d.ParameterLength));

    // PcurveSampleFor with the space curve's domain read once.
    PcurveSampleForOnce(g: GeometrySet, p: PcurveIndex, c: CurveIndex, t: Number): Number
    {
        var d = g.Domain(c);
        return d.HasBoundedRun
            ? g.PcurveSampleAlong(p, d, g.PcurveRangeOver(p, c, d.Range), t)
            : g.Domain(p).SampleIn(t);
    }

    // The distance from point q to space curve c: q against the curve's
    // point at its closest parameter.
    CurveGapAt(g: GeometrySet, c: CurveIndex, q: Point3D): Number
        => g.Eval(c, g.ClosestParameter(c, q)).Distance(q);

    // PcurveToCurveGap with the pcurve's sample and its point computed once
    // (the original evaluated PcurveSampleFor, and with it PcurveRangeOver's
    // two searches, twice). Precondition: g.CanEvaluate(c).
    PcurveToCurveGapOnce(g: GeometrySet, c: CurveIndex, t: Number, k: Integer): Number
        => g.PcurveToCurveGapOnce(g.CurveAt(c).SpaceCurveOf, g.CurveAt(c).SupportsOf, t, k);

    // PcurveToCurveGapOnce over the parts of a surface curve.
    PcurveToCurveGapOnce(g: GeometrySet, spaceCurve: CurveIndex, supports: Array<CurveSupport>, t: Number, k: Integer): Number
        => supports.IsValidIndex(k)
            ? (supports[k].PcurveOrNone.IsNone || spaceCurve.IsNone
                ? 0.0
                : g.CurveGapAt(spaceCurve, g.Eval(supports[k].PcurveOrNone, g.PcurveSampleForOnce(supports[k].PcurveOrNone, spaceCurve, t))))
            : 0.0;

    // The pcurve range PcurveSampleFor reads for one support of a surface
    // curve, computed once per support instead of once per sample; an empty
    // interval where PcurveSampleFor reads none (no pcurve, no space curve,
    // or an unbounded space curve domain).
    PcurveRangeFor(g: GeometrySet, spaceCurve: CurveIndex, support: CurveSupport): NumberInterval
        => support.PcurveOrNone.IsNone || spaceCurve.IsNone
            ? NumberInterval(0.0, 0.0)
            : (g.Domain(spaceCurve).HasBoundedRun
                ? g.PcurveRangeOver(support.PcurveOrNone, spaceCurve, g.Domain(spaceCurve).Range)
                : NumberInterval(0.0, 0.0));

    // PcurveRangeFor of every support of surface curve c; empty for any
    // other curve. Precondition: g.CanEvaluate(c).
    PcurveRangesOf(g: GeometrySet, c: CurveIndex): Array<NumberInterval>
    {
        var spaceCurve = g.CurveAt(c).SpaceCurveOf;
        return g.CurveAt(c).SupportsOf.Map(x => g.PcurveRangeFor(spaceCurve, x));
    }

    // PcurveToCurveGap at sample t of support k of surface curve c, with the
    // supports' ranges given (ranges is PcurveRangesOf(c)): the same value,
    // with no search but the closest parameter on the space curve.
    // Precondition: g.CanEvaluate(c).
    PcurveToCurveGapGiven(g: GeometrySet, c: CurveIndex, ranges: Array<NumberInterval>, t: Number, k: Integer): Number
    {
        var spaceCurve = g.CurveAt(c).SpaceCurveOf;
        var supports = g.CurveAt(c).SupportsOf;
        return supports.IsValidIndex(k)
            ? (supports[k].PcurveOrNone.IsNone || spaceCurve.IsNone
                ? 0.0
                : g.CurveGapAt(spaceCurve, g.Eval(supports[k].PcurveOrNone,
                    g.PcurveSampleGiven(supports[k].PcurveOrNone, g.Domain(spaceCurve), ranges[k], t))))
            : 0.0;
    }

    // PcurveSampleFor of pcurve p against a space curve of domain d, with
    // the pcurve range covering it given.
    PcurveSampleGiven(g: GeometrySet, p: PcurveIndex, d: CurveDomain, range: NumberInterval, t: Number): Number
        => d.HasBoundedRun ? g.PcurveSampleAlong(p, d, range, t) : g.Domain(p).SampleIn(t);

    //==
    // # Oracles

    // Oracle_BSplineCurvePoint with each weighted basis function w_i N_i(t)
    // computed once and shared by the numerator and the denominator: the same
    // products, summed in the same order, so the same point bit for bit.
    Oracle_BSplineCurvePointOnce(d: BSplineCurveData, t: Number): Point3D
    {
        var wn = d.ControlPoints.Count.MapRange(i =>
            d.Weights[i] * BasisFunction(d.Basis.Knots, d.Basis.SplineDomain.End, i, d.Basis.Degree, t));
        return (d.ControlPoints.Count.Range.Reduce(Vector3D(0.0, 0.0, 0.0), (sum, i) => sum + d.ControlPoints[i].PositionVector * wn[i])
            * (1.0 / wn.SumOf)).ToPoint;
    }

    // Oracle_BSplineCurve2DPoint with each weighted basis function computed
    // once, as Oracle_BSplineCurvePointOnce.
    Oracle_BSplineCurve2DPointOnce(d: BSplineCurve2DData, t: Number): UvCoordinate
    {
        var wn = d.ControlPoints.Count.MapRange(i =>
            d.Weights[i] * BasisFunction(d.Basis.Knots, d.Basis.SplineDomain.End, i, d.Basis.Degree, t));
        return UvCoordinate(0.0, 0.0) + d.ControlPoints.Count.Range.Reduce(Vector2D(0.0, 0.0), (sum, i) =>
                sum + (d.ControlPoints[i] - UvCoordinate(0.0, 0.0)) * wn[i])
            * (1.0 / wn.SumOf);
    }
}

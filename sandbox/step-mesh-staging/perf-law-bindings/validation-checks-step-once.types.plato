//==
// # One decode of a Part 21 file, shared by its self-tests (complexity sweep, chunk L6)

// A file's raw model and its prepared decode, each built once: Raw is
// file.DecodeRaw(DecodePolicy.StandardPolicy) and Decoded is
// Raw.PrepareModel, which is file.DecodeBrep (DecodeBrepWith composes the
// same two calls).
type RawAndDecoded
{
    Raw: RawDecodedModel;
    Decoded: DecodedModel;
}

//==
// # Assembled witnesses (complexity sweep, chunk L6)
//
// An AssemblyWitness (chunk M1: a model, its discretizations, one face mesh
// per face) with its numbering and assembled model mesh built once per
// sweep, so the laws of ModelMeshAssemblyLaws and Law_AreaIsSumOfFaceMeshAreas
// read the assembled mesh instead of numbering and assembling per case. The
// law runner builds every Witness_* of this type once, before any law runs.

// Inputs and what layer 06 makes of them.
// Invariants: Numbering is NumberMeshVertices(Inputs.Model,
// Inputs.Discretizations, Inputs.FaceMeshes); Accepted is
// Inputs.Model.CanAssemble(Inputs.FaceMeshes, Numbering); Mesh is
// AssembleModelMesh of the inputs and Numbering (built only for an accepted
// witness: every witness of this type is accepted, by
// Law_Perf_AssembledWitnessesAreAccepted).
type AssembledWitness
{
    Inputs: AssemblyWitness;
    Numbering: MeshVertexNumbering;
    Accepted: Boolean;
    Mesh: ModelMesh;
}

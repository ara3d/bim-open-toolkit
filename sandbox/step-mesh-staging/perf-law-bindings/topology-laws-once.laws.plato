//==
// # Layer 2 laws with each value bound once: laws (complexity sweep, chunk L6)
//
// Law_Perf_<Name> is BrepTopologyLaws' Law_<Name> with its repeated model
// rebuild or projection computed once; at merge it replaces the original
// under the original name. Law_Perf_RigidMotionKeepsCoedgeSense moves the
// model once and quantifies over every coedge site inside the body, where
// the original moved it once per (model, motion, site) case.
//
// Sections, in order:
//  - Restated laws
//  - Agreement

library TopologyLawsOnceLaws
{
    //==
    // # Restated laws

    // Law_ParameterizationSignIsConstantOnFace over the Once body.
    Law_Perf_ParameterizationSignIsConstantOnFace(m: BrepModel, site: CoedgeSite, t: Number): Boolean
        => m.ParameterizationSignIsConstantOnFaceGivenOnce(m.IsEveryIndexInRange, site, t);

    // Law_EdgeReversalKeepsEdgeDomain with the reversed model built once and
    // each of the two edge domains computed once (the original built the
    // reversed model twice and computed four edge domains).
    Law_Perf_EdgeReversalKeepsEdgeDomain(m: BrepModel, e: BrepEdgeIndex): Boolean
    {
        if (!m.IsEveryIndexInRange)
        {
            return true;
        }
        if (!m.IsEdgeInRange(e))
        {
            return true;
        }
        var before = m.EdgeDomain(e).Range;
        var after = m.WithEdgeReversed(e).EdgeDomain(e).Range;
        return after.Start == before.Start && after.End == before.End;   // exact by construction
    }

    // Law_RigidMotionKeepsCoedgeSense at every coedge site of m, the moved
    // model built once: every site the original's guard admits is a site of
    // CoedgeSitesOfFace, and the claim at each is the original's.
    Law_Perf_RigidMotionKeepsCoedgeSense(m: BrepModel, motion: Frame3D): Boolean
    {
        var moved = m.RigidlyMoved(motion);
        return m.Faces.Count.Range.All(f => m.CoedgeSitesOfFace(BrepFaceIndex(f)).All(site =>
            m.IsEdgeInRange(m.CoedgeAt(site).Edge)
                ? moved.CoedgeRunsForwardOnCurve(site) == m.CoedgeRunsForwardOnCurve(site)
                : true));
    }

    //==
    // # Agreement

    // The Once body gives the original's Boolean at every coedge site of m
    // and three samples of each.
    Law_Perf_ParameterizationSignOnceAgrees(m: BrepModel): Boolean
    {
        var ok = m.IsEveryIndexInRange;
        return m.Faces.Count.Range.All(f => m.CoedgeSitesOfFace(BrepFaceIndex(f)).All(site =>
            [0.0, 0.37, 1.0].All(t =>
                m.ParameterizationSignIsConstantOnFaceGivenOnce(ok, site, t) == m.ParameterizationSignIsConstantOnFaceGiven(ok, site, t))));
    }
}

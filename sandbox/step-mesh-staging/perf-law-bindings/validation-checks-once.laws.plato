//==
// # Layer 7 checks over values built once: agreement laws (complexity sweep, chunk L6)
//
// Each *Once check gives the Check its original gives (SameCheckResult: the
// same verdict, worst measure and bound): the face-meshing self-tests on the
// faces of chunk L4's triangulated witnesses that the original checks finish
// inside the budget on (IsAgreementSample), the pcurve-to-curve check on
// every model witness, and the STEP claims over a raw model on layer 3's two
// raw witnesses.
//
// Sections, in order:
//  - Face-meshing self-tests
//  - The pcurve-to-curve check
//  - STEP claims over a raw model

library BrepCheckingOnceLaws
{
    //==
    // # Face-meshing self-tests

    // The witness faces an agreement law compares on: the unit box's
    // (sample 0), and the cylinder's (sample 1) where withCylinder holds.
    // The originals rebuild the loops, the region or the triangulation per
    // sample, which is the cost this chunk removes; on the other faces, and
    // for the quadratic checks on the cylinder, they run past the 2 s budget.
    IsAgreementSample(w: TriangulatedWitness, withCylinder: Boolean): Boolean
        => w.Sample == 0 || (withCylinder && w.Sample == 1);

    // The loop lifting and pcurve checks agree on the witness face.
    Law_Perf_LoopChecksOnceAgree(w: TriangulatedWitness): Boolean
    {
        if (!w.IsAgreementSample(true))
        {
            return true;
        }
        var m = w.Model;
        var f = w.Face;
        var d = w.Discretizations;
        return SameCheckResult(m.Check_LoopPointLiftsToSharedPointOnce(f, d), m.Check_LoopPointLiftsToSharedPoint(f, d))
            && SameCheckResult(m.Check_PcurveAgreesWithProjectionOnce(f, d), m.Check_PcurveAgreesWithProjection(f, d));
    }

    // The seam-use check agrees on the cylinder's faces, the witnesses with
    // a seam (the original maps the face's loops once per pair of loop
    // steps; on the box and the cylinder together it takes 1.8 s).
    Law_Perf_SeamUsesOnOppositeCopiesOnceAgrees(w: TriangulatedWitness): Boolean
        => w.Sample == 1
            ? SameCheckResult(w.Model.Check_SeamUsesOnOppositeCopiesOnce(w.Face, w.Discretizations),
                w.Model.Check_SeamUsesOnOppositeCopies(w.Face, w.Discretizations))
            : true;

    // The three unwrap checks agree on the witness face.
    Law_Perf_UnwrapChecksOnceAgree(w: TriangulatedWitness): Boolean
    {
        if (!w.IsAgreementSample(true))
        {
            return true;
        }
        var m = w.Model;
        var f = w.Face;
        var d = w.Discretizations;
        return SameCheckResult(m.Check_UnwrapKeepsSourcesOnce(f, d), m.Check_UnwrapKeepsSources(f, d))
            && SameCheckResult(m.Check_UnwrapMovesByWholePeriodsOnce(f, d), m.Check_UnwrapMovesByWholePeriods(f, d))
            && SameCheckResult(m.Check_UnwrappedStepBelowHalfPeriodOnce(f, d), m.Check_UnwrappedStepBelowHalfPeriod(f, d));
    }

    // The per-loop and per-hole region checks agree on the witness face.
    Law_Perf_RegionChecksOnceAgree(w: TriangulatedWitness): Boolean
    {
        if (!w.IsAgreementSample(true))
        {
            return true;
        }
        var m = w.Model;
        var f = w.Face;
        var d = w.Discretizations;
        var c = TriCriteria(0);
        return SameCheckResult(m.Check_RegionLoopClosesInPlaneOnce(f, d, c), m.Check_RegionLoopClosesInPlane(f, d, c))
            && SameCheckResult(m.Check_UvHoleWindingNegativeOnce(f, d, c), m.Check_UvHoleWindingNegative(f, d, c))
            && SameCheckResult(m.Check_HoleInsideOuterOnce(f, d, c), m.Check_HoleInsideOuter(f, d, c))
            && SameCheckResult(m.Check_SeamCutCopiesRunOppositeOnce(f, d, c), m.Check_SeamCutCopiesRunOpposite(f, d, c));
    }

    // The segment-pair check agrees on the witness face (the original builds
    // the region five times per pair of boundary points).
    Law_Perf_RegionSegmentsSeparatedOnceAgrees(w: TriangulatedWitness): Boolean
    {
        if (!w.IsAgreementSample(false))
        {
            return true;
        }
        var c = TriCriteria(0);
        return SameCheckResult(w.Model.Check_RegionSegmentsSeparatedOnce(w.Face, w.Discretizations, c),
            w.Model.Check_RegionSegmentsSeparated(w.Face, w.Discretizations, c));
    }

    // The triangulation and outcome checks agree on the witness face.
    Law_Perf_TriangulationChecksOnceAgree(w: TriangulatedWitness): Boolean
    {
        if (!w.IsAgreementSample(false))
        {
            return true;
        }
        var m = w.Model;
        var f = w.Face;
        var d = w.Discretizations;
        var c = TriCriteria(0);
        var fm = w.Outcome.Mesh;
        return SameCheckResult(m.Check_TriangulationKeepsBoundaryOnce(f, d, c), m.Check_TriangulationKeepsBoundary(f, d, c))
            && SameCheckResult(m.Check_BoundarySegmentIsElementSideOnce(f, d, c), m.Check_BoundarySegmentIsElementSide(f, d, c))
            && SameCheckResult(m.Check_InteriorSideIsSharedOnce(f, d, c), m.Check_InteriorSideIsShared(f, d, c))
            && SameCheckResult(m.Check_ElementLiftsFacingFaceNormalOnce(f, d, c), m.Check_ElementLiftsFacingFaceNormal(f, d, c))
            && SameCheckResult(m.Check_RequestsNameFaceEdgesOnce(f, d, c), m.Check_RequestsNameFaceEdges(f, d, c))
            && SameCheckResult(m.Check_TriangulationAddsOnlyInteriorPointsOnce(f, d, c), m.Check_TriangulationAddsOnlyInteriorPoints(f, d, c))
            && SameCheckResult(m.Check_EveryPointIsACornerOnce(f, d, c), m.Check_EveryPointIsACorner(f, d, c))
            && SameCheckResult(m.Check_LiftKeepsPointsOnce(d, fm, c), m.Check_LiftKeepsPoints(d, fm, c));
    }

    //==
    // # The pcurve-to-curve check

    // Check_SurfaceCurvePcurveLiesOnCurveOnce gives the hoisted check's
    // result on the model under the check plan.
    Law_Perf_PcurveGapCheckOnceAgrees(m: BrepModel): Boolean
        => SameCheckResult(m.Check_SurfaceCurvePcurveLiesOnCurveOnce(SamplePlan.CheckPlan),
            m.Check_SurfaceCurvePcurveLiesOnCurveHoisted(SamplePlan.CheckPlan));

    //==
    // # STEP claims over a raw model

    // Every claim over a prepared decode equals its law over the raw model,
    // at every index from -1 to one past the end and both parameters, on the
    // raw witnesses.
    Law_Perf_RawStepClaimsAgree(raw: RawDecodedModel): Boolean
    {
        var d = raw.PrepareModel;
        var curves = d.Model.Geometry.Curves.Count;
        var surfaces = d.Model.Geometry.Surfaces.Count;
        var faces = d.Model.Faces.Count;
        var bounds = d.Model.MostBounds;
        return (curves + 2).Range.All(k => d.CurveClosureDecidedByEndsGiven(k - 1) == Law_CurveClosureDecidedByEnds(raw, k - 1))
            && (surfaces + 2).Range.All(k =>
                d.SurfaceClosureDecidedBySidesGiven(k - 1, SurfaceParameter.ParameterU) == Law_SurfaceClosureDecidedBySides(raw, k - 1, SurfaceParameter.ParameterU)
                && d.SurfaceClosureDecidedBySidesGiven(k - 1, SurfaceParameter.ParameterV) == Law_SurfaceClosureDecidedBySides(raw, k - 1, SurfaceParameter.ParameterV))
            && (faces + 2).Range.All(k =>
                d.MirrorFoldRecordedOnceGiven(k - 1) == Law_MirrorFoldRecordedOnce(raw, k - 1)
                && d.LeftHandedSurfacesAreFoldedGiven(k - 1) == Law_LeftHandedSurfacesAreFolded(raw, k - 1)
                && raw.FoldFlipsExactlyRecordedGiven(d, k - 1) == Law_FoldFlipsExactlyRecorded(raw, k - 1)
                && (bounds + 2).Range.All(j => raw.FoldPreservesInteriorSideGiven(d, k - 1, j - 1) == Law_FoldPreservesInteriorSide(raw, k - 1, j - 1)));
    }
}

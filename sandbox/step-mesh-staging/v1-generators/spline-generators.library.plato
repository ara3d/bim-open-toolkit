//==
// # B-spline record generators
//
// Generators for the law runner (Plato TKT-446; see
// tolerance-generators.library.plato beside this file). The decoder makes a
// BSplineCurveData or BSplineCurve2DData from a b_spline_curve_with_knots
// whose arguments pass constraints_param_b_spline (ConstraintsParamBSpline,
// layer 3), by repeating each distinct knot by its multiplicity
// (geometry-splines.types.plato), and copies positive weights (ISO 10303-42
// 4.5.39 WR2). These draw every record that way: a knot spec that passes the
// seven conditions, expanded. Before, the runner built the records field by
// field, with negative degrees, unsorted knots, and counts that disagree
// (TKT-423).

library V1GeneratorsSplines
{
    // A space curve over the seed's knot spec: one control point per
    // expanded knot beyond degree + 1, and its weights.
    Generate_BSplineCurveData(seed: Integer): BSplineCurveData
    {
        var spec = seed.V1GeneratorsKnotSpec;
        var n = spec.UpperIndexOnControlPoints + 1;
        return BSplineCurveData(
            spec.V1GeneratorsBasis,
            n.MapRange(i => Point3D(i.ToNumber * 0.5, ((i * i + seed) % 5).ToNumber, (i % 3).ToNumber - 1.0)),
            V1GeneratorsWeights(seed, n));
    }

    // A parameter-plane curve over the seed's knot spec.
    Generate_BSplineCurve2DData(seed: Integer): BSplineCurve2DData
    {
        var spec = (seed + 1).V1GeneratorsKnotSpec;
        var n = spec.UpperIndexOnControlPoints + 1;
        return BSplineCurve2DData(
            spec.V1GeneratorsBasis,
            n.MapRange(i => UvCoordinate(i.ToNumber * 0.25, ((i + seed) % 4).ToNumber * 0.5)),
            V1GeneratorsWeights(seed + 1, n));
    }

    // A knot spec that passes constraints_param_b_spline: degree 1 to 5;
    // clamped (end multiplicities degree + 1, zero to four interior knots of
    // multiplicity 1 to the degree) except for seeds 3, 7, 11 and 15, which
    // are unclamped uniform (2 degree + 3 distinct knots of multiplicity 1).
    // Distinct knots strictly increase from 0 or -2.5 by steps of 0.5 or more
    // times a scale of 0.125 to 3.
    V1GeneratorsKnotSpec(seed: Integer): StepKnotSpec
    {
        var p = 1 + seed % 5;
        var clamped = seed % 4 != 3;
        var interior = clamped ? seed % 3 + (seed < 8 ? 0 : 2) : 2 * p + 1;
        var scales = [1.0, 0.5, 0.125, 3.0];
        var base = seed < 8 ? 0.0 : -2.5;
        var multiplicities = (interior + 2).MapRange(j => j == 0 || j == interior + 1
            ? (clamped ? p + 1 : 1)
            : (clamped ? 1 + (j + seed) % p : 1));
        var knots = (interior + 2).MapRange(j => base + scales[seed % 4] * (j.ToNumber + 0.25 * ((j * j) % 3).ToNumber));
        return StepKnotSpec(p, multiplicities.IntegerTotal - p - 2, multiplicities, knots);
    }

    // The spec's basis: each distinct knot repeated by its multiplicity.
    V1GeneratorsBasis(k: StepKnotSpec): SplineBasis
        => SplineBasis(k.Degree, KnotVector(k.Knots.Count.MapRange(j => j).FlatMap(j => k.Multiplicities[j].Repeat(k.Knots[j]))));

    // Polynomial weights (all 1) for even seeds; positive rational weights,
    // a conic's 1/sqrt 2 among them, for odd seeds.
    V1GeneratorsWeights(seed: Integer, n: Integer): Array<Number>
        => seed % 2 == 0
            ? n.Repeat(1.0)
            : n.MapRange(i => i % 3 == 1 ? 0.7071067811865476 : 1.0 + (i % 3).ToNumber * 0.5);

    // Every generated knot spec is one the decoder accepts: the generator
    // above draws only decodable records.
    Law_V1Generators_KnotSpecsDecodable(): Boolean
        => 16.MapRange(s => s.V1GeneratorsKnotSpec.ConstraintsParamBSpline && (s + 1).V1GeneratorsKnotSpec.ConstraintsParamBSpline).All(b => b);
}

//==
// # Catalog: laws of the kernel proofs
//
// Two laws per proof type: its constructor succeeds exactly when the
// library's predicate holds, stated again from the library's own functions,
// and the facts the proof records equal what the library computes. The
// runner cannot build a BrepModel, so the laws take an Integer selector
// over layer 7's witnesses (CatalogProofModelAt), the negative ones
// included.
//
// A law that reads a proof's facts passes the Decided* result to a helper
// as a typed parameter and matches there: a match on a local initialised
// by a call into a library file that sorts later (this folder's
// .library.plato files sort after its .laws.plato files) is not typed
// (PLATO-PRIMER.md F).
//
// Sections, in order:
//  - Witnesses
//  - The whole model
//  - Loops
//  - Shells

library CatalogProofsKernelLaws
{
    //==
    // # Witnesses

    // Model k modulo 13: 0 to 9 layer 7's positive witnesses (WitnessAt),
    // 10 the box with one face stored inside out, 11 two boxes sharing a
    // corner, 12 the box with a poly-loop sheet. The runner's Integers,
    // -8 to 8, reach every one.
    CatalogProofModelAt(k: Integer): BrepModel
    {
        var i = ((k % 13) + 13) % 13;
        return i < 10 ? BrepModel.WitnessAt(i)
            : (i == 10 ? BrepModel.Witness_BoxWithFlippedFace
            : (i == 11 ? BrepModel.Witness_TwoBoxesSharingCorner
            : BrepModel.Witness_BoxWithPolyLoopSheet));
    }

    // Raw model k modulo 2: the unit cube, or two unit cubes in
    // millimetres.
    CatalogRawModelAt(k: Integer): RawDecodedModel
        => ((k % 2) + 2) % 2 == 0 ? RawDecodedModel.Witness_RawUnitCube : RawDecodedModel.Witness_RawTwoCubes;

    // Model m with its length tolerance replaced by x, the other
    // tolerances kept.
    CatalogWithLengthTolerance(m: BrepModel, x: Number): BrepModel
        => m.WithTolerances(Tolerances(LengthTolerance(x), m.Tolerances.Angle, m.Tolerances.LengthParameter, m.Tolerances.AngleParameter));

    //==
    // # The whole model

    // CheckInRangeModel succeeds exactly when every index is in range.
    Law_Catalog_InRangeModelIffIndicesInRange(k: Integer): Boolean
        => CheckInRangeModel(CatalogProofModelAt(k)).IsDecided == CatalogProofModelAt(k).IsEveryIndexInRange;

    // An InRangeModel holds the model it checked: the same table sizes.
    Law_Catalog_InRangeModelKeepsModel(k: Integer): Boolean
        => CatalogInRangeModelKeeps(CatalogProofModelAt(k), CheckInRangeModel(CatalogProofModelAt(k)));

    // The claim of Law_Catalog_InRangeModelKeepsModel for the result d of
    // checking m.
    CatalogInRangeModelKeeps(m: BrepModel, d: DecidedInRangeModel): Boolean
        => match (d) {
            Decided(p) => p.Model.Edges.Count == m.Edges.Count && p.Model.Faces.Count == m.Faces.Count;
            Undecided(r) => true;
        };

    // CheckPreparedModel succeeds exactly when PrepareModel's tolerances
    // are well formed.
    Law_Catalog_PreparedModelIffTolerancesWellFormed(k: Integer): Boolean
        => CheckPreparedModel(CatalogRawModelAt(k)).IsDecided == CatalogRawModelAt(k).PrepareModel.Model.Tolerances.IsWellFormed;

    // A PreparedModel's tolerances are those PrepareModel chose, its Model
    // is its decoded model, and it keeps PrepareModel's diagnostics.
    Law_Catalog_PreparedModelRecordsPreparation(k: Integer): Boolean
        => CatalogPreparedModelRecords(CatalogRawModelAt(k).PrepareModel, CheckPreparedModel(CatalogRawModelAt(k)));

    // The claim of Law_Catalog_PreparedModelRecordsPreparation, given
    // PrepareModel's own result e. Exact by construction: the tolerances
    // are copies from one deterministic computation.
    CatalogPreparedModelRecords(e: DecodedModel, d: DecidedPreparedModel): Boolean
        => match (d) {
            Decided(p) => p.Tolerance == e.Model.Tolerances
                && p.Model.Faces.Count == p.Decoded.Model.Faces.Count
                && p.Decoded.Diagnostics.Count == e.Diagnostics.Count;
            Undecided(r) => true;
        };

    // CheckResolvableModel succeeds exactly when the length tolerance is
    // resolvable at the coordinate extent, over every witness with the
    // runner's tolerance x (zero and negative ones included).
    Law_Catalog_ResolvableModelIffResolvable(k: Integer, x: Number): Boolean
        => CheckResolvableModel(CatalogWithLengthTolerance(CatalogProofModelAt(k), x)).IsDecided
            == LengthTolerance(x).IsResolvable(CatalogWithLengthTolerance(CatalogProofModelAt(k), x).CoordinateExtent);

    // A ResolvableModel records the coordinate extent the check read.
    Law_Catalog_ResolvableModelRecordsExtent(k: Integer): Boolean
        => CatalogResolvableModelRecords(CatalogProofModelAt(k), CheckResolvableModel(CatalogProofModelAt(k)));

    // The claim of Law_Catalog_ResolvableModelRecordsExtent for the result
    // d of checking m.
    CatalogResolvableModelRecords(m: BrepModel, d: DecidedResolvableModel): Boolean
        => match (d) {
            Decided(p) => p.Extent.Value == m.CoordinateExtent;   // exact by construction
            Undecided(r) => true;
        };

    //==
    // # Loops

    // CheckChainedLoop succeeds exactly when the loop is intact and chains
    // end to start.
    Law_Catalog_ChainedLoopIffChains(k: Integer, l: Integer): Boolean
    {
        var m = CatalogProofModelAt(k);
        var i = BrepLoopIndex(l);
        return CheckChainedLoop(m, i).IsDecided == (m.IsLoopIntact(i) ? m.ChainsEndToStart(m.Loops[i]) : false);
    }

    // A ChainedLoop names the loop it checked, and points at it.
    Law_Catalog_ChainedLoopRecordsLoop(k: Integer, l: Integer): Boolean
        => CatalogChainedLoopRecords(BrepLoopIndex(l), CheckChainedLoop(CatalogProofModelAt(k), BrepLoopIndex(l)));

    // The claim of Law_Catalog_ChainedLoopRecordsLoop for the result d of
    // checking loop l.
    CatalogChainedLoopRecords(l: BrepLoopIndex, d: DecidedChainedLoop): Boolean
        => match (d) {
            Decided(p) => p.Loop == l && p.Where == Provenance.KernelLoop(l);
            Undecided(r) => true;
        };

    //==
    // # Shells

    // CheckClosedShell succeeds exactly when every index is in range, the
    // shell exists, and each of its counted edges has zero or two uses.
    Law_Catalog_ClosedShellIffEdgesUsedTwice(k: Integer, s: Integer): Boolean
    {
        var m = CatalogProofModelAt(k);
        var i = ShellIndex(s);
        return CheckClosedShell(m, i).IsDecided
            == (m.IsEveryIndexInRange
                ? (m.IsShellInRange(i) ? m.EdgesOfShell(i).All(e => m.CountsAsEdge(e) ? m.UseCount(i, e).IsZeroOrTwo : true) : false)
                : false);
    }

    // A ClosedShell records the shell's reduced counts.
    Law_Catalog_ClosedShellRecordsCounts(k: Integer, s: Integer): Boolean
        => CatalogClosedShellRecords(CatalogProofModelAt(k), ShellIndex(s), CheckClosedShell(CatalogProofModelAt(k), ShellIndex(s)));

    // The claim of Law_Catalog_ClosedShellRecordsCounts for the result d of
    // checking shell s of m.
    CatalogClosedShellRecords(m: BrepModel, s: ShellIndex, d: DecidedClosedShell): Boolean
        => match (d) {
            Decided(p) => p.Shell == s && p.Counts == m.ReducedCounts(s) && p.Where == Provenance.KernelShell(s);
            Undecided(r) => true;
        };

    // Every shell of every positive witness is a ClosedShell: the fact the
    // witnesses' own laws assert as DeclaredClosed.
    Law_Catalog_PositiveWitnessShellsAreClosed(k: Integer, s: Integer): Boolean
        => BrepModel.WitnessAt(k).IsShellInRange(ShellIndex(s))
            ? CheckClosedShell(BrepModel.WitnessAt(k), ShellIndex(s)).IsDecided
            : true;

    // CheckOrientedShell succeeds on a closed shell exactly when its edge
    // uses run opposite.
    Law_Catalog_OrientedShellIffCoherent(k: Integer, s: Integer): Boolean
        => CatalogOrientedShellIffCoherent(CatalogProofModelAt(k), CheckClosedShell(CatalogProofModelAt(k), ShellIndex(s)));

    // The claim of Law_Catalog_OrientedShellIffCoherent for the result d of
    // checking a shell of m for closure.
    CatalogOrientedShellIffCoherent(m: BrepModel, d: DecidedClosedShell): Boolean
        => match (d) {
            Decided(c) => CheckOrientedShell(m, c).IsDecided == m.HasCoherentOrientation(c.Shell);
            Undecided(r) => true;
        };

    // An OrientedShell keeps the closed shell's index and counts.
    Law_Catalog_OrientedShellKeepsCounts(k: Integer, s: Integer): Boolean
        => CatalogOrientedShellKeeps(CatalogProofModelAt(k), CheckClosedShell(CatalogProofModelAt(k), ShellIndex(s)));

    // The claim of Law_Catalog_OrientedShellKeepsCounts for the result d of
    // checking a shell of m for closure.
    CatalogOrientedShellKeeps(m: BrepModel, d: DecidedClosedShell): Boolean
        => match (d) {
            Decided(c) => CatalogOrientedShellKeepsCountsOf(c, CheckOrientedShell(m, c));
            Undecided(r) => true;
        };

    // The claim of Law_Catalog_OrientedShellKeepsCounts for the result o of
    // checking closed shell c for orientation.
    CatalogOrientedShellKeepsCountsOf(c: ClosedShell, o: DecidedOrientedShell): Boolean
        => match (o) {
            Decided(p) => p.Shell == c.Shell && p.Counts == c.Counts && p.Where == Provenance.KernelShell(c.Shell);
            Undecided(r) => true;
        };

    // CheckConnectedShell succeeds exactly when the shell's faces form at
    // most one class.
    Law_Catalog_ConnectedShellIffOneComponent(k: Integer, s: Integer): Boolean
    {
        var m = CatalogProofModelAt(k);
        var i = ShellIndex(s);
        return CheckConnectedShell(m, i).IsDecided
            == (m.IsEveryIndexInRange ? (m.IsShellInRange(i) ? m.ShellComponentCount(i) <= 1 : false) : false);
    }

    // A ConnectedShell names the shell it checked.
    Law_Catalog_ConnectedShellRecordsShell(k: Integer, s: Integer): Boolean
        => CatalogConnectedShellRecords(ShellIndex(s), CheckConnectedShell(CatalogProofModelAt(k), ShellIndex(s)));

    // The claim of Law_Catalog_ConnectedShellRecordsShell for the result d
    // of checking shell s.
    CatalogConnectedShellRecords(s: ShellIndex, d: DecidedConnectedShell): Boolean
        => match (d) {
            Decided(p) => p.Shell == s && p.Where == Provenance.KernelShell(s);
            Undecided(r) => true;
        };
}

//==
// # Catalog: proofs about edge discretizations
//
// TYPE-CATALOG.md section 4, layer 4. Built only by the constructors of
// catalog-proofs-discretization.library.plato.
//
// Sections, in order:
//  - Whole tables
//  - One edge

//==
// # Whole tables

// A discretization table with one entry per edge of the model and no
// Undiscretized entry (IsDiscretized on every one): the input MeshFace
// wants. Removes: IsDiscretized checked per edge inside face meshing, or not.
type CompleteDiscretization
{
    ByEdge: Array<EdgeDiscretization>;
}

// A table with one entry per edge in which some edges failed: Failed lists
// them in edge order and is never empty. What DiscretizeAll gives when the
// table is not complete. Removes: a partial table passed on as complete.
type PartialDiscretization
{
    ByEdge: Array<EdgeDiscretization>;
    Failed: Array<BrepEdgeIndex>;
}

//==
// # One edge

// An edge's polyline in canonical form: parameters strictly increasing from
// the domain's start to its end, the two end points the vertex points
// exactly. Discretize's output is one. Removes: a reversed polyline stored
// back into EdgeDiscretizations.
type CanonicalDiscretization
    implements IHasProvenance
{
    Discretization: EdgeDiscretization;
}

// A canonical polyline as one coedge consumes it: Discretization is the
// canonical one when Sense is Same and its reversal when Opposite. Not
// canonical, so no function that wants a CanonicalDiscretization accepts
// it. Removes: a reversed polyline stored back into EdgeDiscretizations.
type DirectedDiscretization
{
    Discretization: EdgeDiscretization;
    Sense: Sense;
}

// The discretization of Edge met Criteria (MeetsCriteria), and Worst is
// the largest sagitta of its segments, a length in model units. Removes: a
// refinement loop that cannot tell whether the last round changed anything.
type MeetsCriteriaProof
    implements IHasProvenance
{
    Edge: BrepEdgeIndex;
    Criteria: DiscretizationCriteria;
    Worst: Measure;
}

//==
// # Catalog: the constructors of the discretization proofs
//
// One constructor per proof type of catalog-proofs-discretization.types.plato,
// each over layer 4's own predicates. DirectedDiscretization is the one
// total constructor: every canonical polyline has both directions.
//
// Sections, in order:
//  - Whole tables
//  - One edge
//  - Verdicts
//  - Concept obligations

library CatalogProofsDiscretization
{
    //==
    // # Whole tables

    // True when the table has one entry per edge of m.
    HasEntryPerEdge(m: BrepModel, d: EdgeDiscretizations): Boolean
        => d.ByEdge.Count == m.Edges.Count;

    // The edges whose entry holds no polyline (IsDiscretized false), in
    // edge order. Precondition: HasEntryPerEdge.
    FailedEdges(m: BrepModel, d: EdgeDiscretizations): Array<BrepEdgeIndex>
        => m.Edges.Count.Range.FlatMap(i =>
            d.ByEdge[i].IsDiscretized ? [BrepEdgeIndex(i)].Take(0) : [BrepEdgeIndex(i)]);

    // The table as a CompleteDiscretization when it has one entry per edge
    // and every entry is discretized; OutOfDomain when the counts differ.
    CheckCompleteDiscretization(m: BrepModel, d: EdgeDiscretizations): DecidedCompleteDiscretization
        => m.HasEntryPerEdge(d)
            ? (d.ByEdge.All(x => x.IsDiscretized)
                ? DecidedCompleteDiscretization.Decided(CompleteDiscretization(d.ByEdge))
                : DecidedCompleteDiscretization.Undecided(UndecidedReason.NotApplicable("some edge is undiscretized")))
            : DecidedCompleteDiscretization.Undecided(UndecidedReason.OutOfDomain);

    // The table as a PartialDiscretization, with its failed edges, when it
    // has one entry per edge and some entry is undiscretized; NotApplicable
    // when it is complete, OutOfDomain when the counts differ.
    CheckPartialDiscretization(m: BrepModel, d: EdgeDiscretizations): DecidedPartialDiscretization
        => m.HasEntryPerEdge(d)
            ? (m.FailedEdges(d).Count > 0
                ? DecidedPartialDiscretization.Decided(PartialDiscretization(d.ByEdge, m.FailedEdges(d)))
                : DecidedPartialDiscretization.Undecided(UndecidedReason.NotApplicable("every edge is discretized")))
            : DecidedPartialDiscretization.Undecided(UndecidedReason.OutOfDomain);

    //==
    // # One edge

    // True when an evaluable polyline is canonical: it runs along the curve,
    // its parameters strictly increase, its lowest and highest parameters
    // are the domain's ends, and its end points are the vertex points
    // (layer 4's claims of Law_ParametersStrictlyIncreasing,
    // Law_LowestParameterIsDomainStart, Law_HighestParameterIsDomainEnd,
    // Law_DomainStartPointIsVertex, Law_DomainEndPointIsVertex).
    // Precondition: m.IsEvaluable(d).
    IsCanonical(m: BrepModel, d: EdgeDiscretization): Boolean
        => d.RunsAlongCurve
            && d.Parameters.Count.Range.All(i => d.ParametersStrictlyIncreasing(i))
            && m.LowestParameterIsDomainStart(d)
            && m.HighestParameterIsDomainEnd(d)
            && Law_DomainStartPointIsVertex(m, d)
            && Law_DomainEndPointIsVertex(m, d);

    // The polyline as a CanonicalDiscretization when it is evaluable and
    // canonical; OutOfDomain when it cannot be evaluated.
    CheckCanonicalDiscretization(m: BrepModel, d: EdgeDiscretization): DecidedCanonicalDiscretization
        => m.IsEvaluable(d)
            ? (m.IsCanonical(d)
                ? DecidedCanonicalDiscretization.Decided(CanonicalDiscretization(d))
                : DecidedCanonicalDiscretization.Undecided(UndecidedReason.NotApplicable("polyline is not canonical")))
            : DecidedCanonicalDiscretization.Undecided(UndecidedReason.OutOfDomain);

    // The canonical polyline directed by s: itself when Same, reversed when
    // Opposite.
    DirectedAlong(c: CanonicalDiscretization, s: Sense): DirectedDiscretization
        => match (s) {
            Same => DirectedDiscretization(c.Discretization, s);
            Opposite => DirectedDiscretization(c.Discretization.Reversed, s);
        };

    // The largest sagitta of the polyline's segments, in model units.
    // Precondition: m.IsEvaluable(d).
    WorstSagitta(m: BrepModel, d: EdgeDiscretization): Number
        => d.SegmentCount.Range.Reduce(0.0, (worst, i) =>
            worst.Max(m.Sagitta(d.Edge, d.Parameters[i], d.Parameters[i + 1])));

    // The polyline's MeetsCriteriaProof under c, with its worst sagitta,
    // when it meets c; NotApplicable otherwise (MeetsCriteria is false on a
    // polyline that cannot be evaluated).
    CheckMeetsCriteriaProof(m: BrepModel, d: EdgeDiscretization, c: DiscretizationCriteria): DecidedMeetsCriteriaProof
        => m.MeetsCriteria(d, c)
            ? DecidedMeetsCriteriaProof.Decided(MeetsCriteriaProof(d.Edge, c, ModelLength(m.WorstSagitta(d)).ToMeasure))
            : DecidedMeetsCriteriaProof.Undecided(UndecidedReason.NotApplicable("criteria not met"));

    //==
    // # Verdicts

    // True when the check built its proof.
    IsDecided(d: DecidedCompleteDiscretization): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedPartialDiscretization): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedCanonicalDiscretization): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    // True when the check built its proof.
    IsDecided(d: DecidedMeetsCriteriaProof): Boolean
        => match (d) { Decided(v) => true; Undecided(r) => false; };

    //==
    // # Concept obligations

    // The edge the polyline belongs to.
    Where(x: CanonicalDiscretization): Provenance
        => Provenance.KernelEdge(x.Discretization.Edge);

    // The edge whose polyline met its criteria.
    Where(x: MeetsCriteriaProof): Provenance
        => Provenance.KernelEdge(x.Edge);
}

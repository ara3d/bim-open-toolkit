//==
// # Pole segments sampled at the formula's count (TKT-502, chunk QF4)
//
// Layer 05-face-meshing. A pole segment (pole-segments.library.plato) is a side of the face's
// region with no model edge, so no count request reaches it: ExpandedPoles samples it every
// PoleStep, the surface angular bound, which version 1 sets to half a turn. On a sphere a grid then
// has two or three cells around, which the keep gate refuses, and the face takes the refined
// triangulation; on a cone the apex segment and the base circle have different counts. Here the
// criteria handed to ExpandedPoles carry an angular bound no larger than the step of the formula's
// u count (AnalyticGridFormula) over the loops' parameter box: on a sphere the count of its widest
// parallel at half the chordal bound, on a cone the count of its widest parallel at the whole bound,
// which is the count layer 04 gives a base circle of that radius. Only the pole sampling reads the
// angular bound in ExpandedPoles, so nothing else of the face changes.
//
// Sections, in order:
//  - The loops' parameter box
//  - The pole step
//  - Expanded poles

library PoleFormula
{
    //==
    // # The loops' parameter box

    // The least v of the loops' points.
    LoopsVMin(loops: Array<UvLoop>): Number
        => loops.Reduce(Number.MaxValue, (lo, l) => l.Points.Reduce(lo, (x, p) => x.Min(p.V)));

    // The largest v of the loops' points.
    LoopsVMax(loops: Array<UvLoop>): Number
        => loops.Reduce(0.0 - Number.MaxValue, (hi, l) => l.Points.Reduce(hi, (x, p) => x.Max(p.V)));

    //==
    // # The pole step

    // Whether surface s collapses lines of constant v whose free parameter is the formula's u, an
    // angle: a sphere's poles and a cone's apex. A degenerate torus is left as it is.
    HasFormulaPoles(s: BrepSurface): Boolean
        => match (s) {
            Plane(placement) => false;
            Cylinder(placement, radius) => false;
            Cone(placement, radius, semiAngle) => true;
            Sphere(placement, radius) => true;
            Torus(placement, major, minor, part) => false;
            Revolution(profile, axis) => false;
            LinearExtrusion(profile, extrusion) => false;
            BSpline(data) => false;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => false;
            Offset(basis, distance) => false;
        };

    // The step in u that gives a whole turn the formula's u count n over the loops' parameter box:
    // a turn over n, widened by one part in 10^12 so that PoleStepCount's ceiling of a turn over
    // the step is n and not n + 1. Half a turn (the largest pole step) where the formula has no
    // circular u direction.
    FormulaPoleStep(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): Number
    {
        var g = m.Geometry.SurfaceAt(m.SurfaceOf(f)).FormulaOf(0.0, Number.Tau, loops.LoopsVMin, loops.LoopsVMax, c.SurfaceChordal);
        var n = g.U.DirectionCount(Number.Tau, g, c, m.Tolerances);
        return n > 0 ? Number.Tau / n.ToNumber * (1.0 + 1e-12) : Number.Pi;
    }

    // Criteria c with the surface angular bound no larger than the formula's pole step, on a
    // surface with formula poles; c itself otherwise.
    PoleFormulaCriteria(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): FaceMeshingCriteria
        => m.Geometry.SurfaceAt(m.SurfaceOf(f)).HasFormulaPoles
            ? FaceMeshingCriteria(c.Discretization, c.SurfaceChordal,
                Angle(c.SurfaceAngular.Radians.Min(m.FormulaPoleStep(f, loops, c))), c.PreferQuads)
            : c;

    //==
    // # Expanded poles

    // ExpandedPoles with the pole segments sampled at the formula's count.
    ExpandedPolesFormula(m: BrepModel, f: BrepFaceIndex, loops: Array<UvLoop>, c: FaceMeshingCriteria): Array<UvLoop>
        => m.ExpandedPoles(f, loops, m.PoleFormulaCriteria(f, loops, c));
}

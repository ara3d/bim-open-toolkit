//==
// # The closed-form grid counts of an analytic face (TKT-502, chunk QF1)
//
// Layer 05-face-meshing. QuadGrid sizes a structured grid by its boundary's segment counts alone, so
// a four-sided face keeps a grid only where those counts happen to be fine enough for the surface
// (the keep gate, GridUnlessFoldedOrCoarse). On a cylinder or a cone the circles are already sized
// by the chordal formula, so the grid is kept; on a sphere or a torus a cell deviates by about the
// sum of two sagittas, so the gate refuses it and the face takes the refined triangulation. This
// library states what each direction of an analytic face needs in closed form, with layer 04's arc
// count (ArcSegmentCount: the chordal, angular and length criteria, capped by the minimum length,
// so a face asks an edge for exactly the count the discretizer would give a circle of that radius),
// and turns a shortfall on a model edge into the segment floors the count-request mechanism
// already carries (QuadGridOutcome.CountsDiffer, QuadCountRequests). A side that is a seam cut or a
// pole segment has no edge to ask (chunk QF4 sizes those).
//
// Sections, in order:
//  - The region's parameter box
//  - The formula per surface kind
//  - Counts
//  - Sides and floors

library AnalyticGridFormula
{
    //==
    // # The region's parameter box

    // The least u of the region's outer loop.
    RegionUMin(r: UvRegion): Number
        => r.Outer.Points.Reduce(Number.MaxValue, (lo, p) => lo.Min(p.U));

    // The largest u of the region's outer loop.
    RegionUMax(r: UvRegion): Number
        => r.Outer.Points.Reduce(0.0 - Number.MaxValue, (hi, p) => hi.Max(p.U));

    // The least v of the region's outer loop.
    RegionVMin(r: UvRegion): Number
        => r.Outer.Points.Reduce(Number.MaxValue, (lo, p) => lo.Min(p.V));

    // The largest v of the region's outer loop.
    RegionVMax(r: UvRegion): Number
        => r.Outer.Points.Reduce(0.0 - Number.MaxValue, (hi, p) => hi.Max(p.V));

    //==
    // # The formula per surface kind

    // The largest value of cos v over [v0, v1]: 1 when the range holds a multiple of a full turn,
    // else the larger of the two ends (cos has no other local maximum).
    LargestCos(v0: Number, v1: Number): Number
        => (v0 / Number.Tau).Ceiling <= (v1 / Number.Tau).Floor ? 1.0 : v0.Cos.Max(v1.Cos);

    // The radius of a cone's widest parallel over the axial range [v0, v1]: abs(R + v tan a) is
    // convex in v, so the largest value is at an end.
    ConeParallelRadius(radius: Number, semiAngle: Angle, v0: Number, v1: Number): Number
        => (radius + v0 * semiAngle.Tan).Abs.Max((radius + v1 * semiAngle.Tan).Abs);

    // What the formula sees of surface s over the parameter box [u0, u1] x [v0, v1] at the face's
    // chordal bound: a cylinder's u is a circle of its radius and v a ruling; a cone's u is its
    // widest parallel; a sphere's u is its parallel nearest the equator (R cos v) and v a meridian
    // of radius R; a torus's u is its widest parallel (R + r cos v) and v its tube circle; each
    // of the last two spends half the bound per direction. Every other surface is unknown.
    FormulaOf(s: BrepSurface, u0: Number, u1: Number, v0: Number, v1: Number, chordal: Number): GridFormula
        => match (s) {
            Plane(placement) => GridFormula(GridDirection.Straight, GridDirection.Straight, chordal);
            Cylinder(placement, radius) => GridFormula(GridDirection.Circular(radius), GridDirection.Straight, chordal);
            Cone(placement, radius, semiAngle) => GridFormula(GridDirection.Circular(ConeParallelRadius(radius, semiAngle, v0, v1)), GridDirection.Straight, chordal);
            Sphere(placement, radius) => GridFormula(GridDirection.Circular(radius * LargestCos(v0, v1)), GridDirection.Circular(radius), chordal * 0.5);
            Torus(placement, major, minor, part) => GridFormula(GridDirection.Circular(major + minor * LargestCos(v0, v1)), GridDirection.Circular(minor), chordal * 0.5);
            Revolution(profile, axis) => GridFormula(GridDirection.Unknown, GridDirection.Unknown, chordal);
            LinearExtrusion(profile, extrusion) => GridFormula(GridDirection.Unknown, GridDirection.Unknown, chordal);
            BSpline(data) => GridFormula(GridDirection.Unknown, GridDirection.Unknown, chordal);
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => GridFormula(GridDirection.Unknown, GridDirection.Unknown, chordal);
            Offset(basis, distance) => GridFormula(GridDirection.Unknown, GridDirection.Unknown, chordal);
        };

    // The formula for face f over region r under c.
    FormulaOf(m: BrepModel, f: BrepFaceIndex, r: UvRegion, c: FaceMeshingCriteria): GridFormula
        => m.Geometry.SurfaceAt(m.SurfaceOf(f)).FormulaOf(r.RegionUMin, r.RegionUMax, r.RegionVMin, r.RegionVMax, c.SurfaceChordal);

    //==
    // # Counts

    // The segment count direction d needs over a sweep (radians for a circular direction): for a
    // circular one, layer 04's count of a circle of its radius under the edge criteria at the
    // formula's budget (the chordal, angular and length criteria, capped by the minimum length), at
    // least one; one for a straight one; none (0) for an unknown one.
    DirectionCount(d: GridDirection, sweep: Number, g: GridFormula, c: FaceMeshingCriteria, t: Tolerances): Integer
        => match (d) {
            Circular(radius) => radius.ArcSegmentCount(Angle(sweep), c.Discretization.WithChordal(g.Budget), t, 1);
            Straight => 1;
            Unknown => 0;
        };

    // The formula's counts for face f's region r under c: the u direction over the box's u extent,
    // the v direction over its v extent.
    FormulaCountsOf(m: BrepModel, f: BrepFaceIndex, r: UvRegion, c: FaceMeshingCriteria): FormulaCounts
    {
        var g = m.FormulaOf(f, r, c);
        return FormulaCounts(
            g.U.DirectionCount(r.RegionUMax - r.RegionUMin, g, c, m.Tolerances),
            g.V.DirectionCount(r.RegionVMax - r.RegionVMin, g, c, m.Tolerances));
    }

    //==
    // # Sides and floors

    // Whether side k of the four-sided outer loop runs along u: its corners differ more in u than
    // in v. The sides QuadSidesIn finds are iso-lines, so one difference is zero; a side found by
    // turning (TKT-409) takes its dominant direction.
    SideAlongU(r: UvRegion, corners: Array<VertexIndex>, k: Integer): Boolean
    {
        var a = r.Outer.Points[corners[k % 4].Value];
        var b = r.Outer.Points[corners[(k + 1) % 4].Value];
        return (b.U - a.U).Abs >= (b.V - a.V).Abs;
    }

    // The count the formula asks of side k: its direction's count.
    SideFormulaCount(r: UvRegion, corners: Array<VertexIndex>, counts: FormulaCounts, k: Integer): Integer
        => r.SideAlongU(corners, k) ? counts.U : counts.V;

    // Whether every side of the four-sided outer loop carries at least its direction's formula
    // count: then the grid sized by the boundary meets the formula, and the face asks for nothing.
    BoundaryReachesFormula(m: BrepModel, f: BrepFaceIndex, r: UvRegion, corners: Array<VertexIndex>, c: FaceMeshingCriteria): Boolean
    {
        var counts = m.FormulaCountsOf(f, r, c);
        return 4.Range.All(k => r.SideSegmentCount(corners, k) >= r.SideFormulaCount(corners, counts, k));
    }

    // The model edge side k of the four-sided outer loop runs along, seams included: the face edge
    // whose discretization segment joins the side's first two points; -1 for a seam cut, a pole
    // segment, or no edge. SideEdge leaves out a face's seam because raising a seam raises both of
    // its uses, so it cannot match two opposite counts; the formula asks the same count of both
    // uses (they run along one direction), so a seam can take the formula's floor.
    FormulaSideEdge(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, corners: Array<VertexIndex>, k: Integer): Integer
    {
        var start = corners[k % 4].Value;
        var a = r.Outer.Sources.AtModulo(start);
        var b = r.Outer.Sources.AtModulo(start + 1);
        var carriers = m.FaceEdges(f).FlatMap(e => m.IsDiscretizationSegment(d, e, a, b) ? [e.Value] : [e.Value].Take(0));
        return carriers.Count == 0 ? -1 : carriers[0];
    }

    // The floors a four-sided region asks for: for each side, the larger of the count across
    // (MatchingFloors's rule: the opposite side's count, when the side is a model edge that is not
    // a seam) and its direction's formula count, when the side carries fewer; the side's model edge
    // (FormulaSideEdge, seams included) gets the floor, and a side with no edge (a seam cut, a pole
    // segment) asks nothing. One entry per model edge, built in one pass, so a face that asks pays
    // the dense table once.
    GridFloors(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, corners: Array<VertexIndex>, c: FaceMeshingCriteria): SegmentFloors
    {
        var formula = m.FormulaCountsOf(f, r, c);
        var have = 4.MapRange(k => r.SideSegmentCount(corners, k));
        var across = 4.MapRange(k => m.SideEdge(f, d, r, corners, k) >= 0 ? have[(k + 2) % 4] : 0);
        var wanted = 4.MapRange(k => across[k].Max(r.SideFormulaCount(corners, formula, k)));
        var edges = 4.MapRange(k => m.FormulaSideEdge(f, d, r, corners, k));
        return SegmentFloors(m.Edges.Count.MapRange(e => 4.Range.Reduce(0, (floor, k) =>
            (edges[k] == e && have[k] < wanted[k]) ? floor.Max(wanted[k]) : floor)));
    }

    // Whether floors ask anything: some edge's floor is above zero.
    AsksAnything(floors: SegmentFloors): Boolean
        => floors.ByEdge.Any(x => x > 0);

    // The outcome of a refused grid with floors to ask: CountsDiffer with them when some side can be
    // raised, NoGrid otherwise.
    FloorsOutcome(floors: SegmentFloors): QuadGridOutcome
        => floors.AsksAnything ? QuadGridOutcome.CountsDiffer(floors) : QuadGridOutcome.NoGrid;

    // The grid outcome with the formula's floors asked where the gate refused the grid: a kept grid
    // is kept; a refused one becomes CountsDiffer with the floors when some side can be raised, and
    // stays NoGrid otherwise. No face that has a grid today changes.
    OrFormulaFloors(g: QuadGridOutcome, m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, corners: Array<VertexIndex>, c: FaceMeshingCriteria): QuadGridOutcome
        => match (g) {
            NoGrid => m.GridFloors(f, d, r, corners, c).FloorsOutcome;
            CountsDiffer(floors) => g;
            Grid(mesh) => g;
        };

    // QuadGridOnSides with the formula: a four-sided region whose opposite counts match takes the
    // grid the gate keeps, and asks the formula's floors when the gate refuses it; one whose counts
    // differ asks the floors that match its sides and meet the formula in one round.
    QuadGridOnSidesFormula(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, c: FaceMeshingCriteria, sides: QuadSides): QuadGridOutcome
        => match (sides) {
            NotFourSided => QuadGridOutcome.NoGrid;
            FourSided(corners) => r.OppositeCountsMatch(corners)
                ? m.GridUnlessFoldedOrCoarse(f, r, m.QuadGrid(f, r, corners, c), c).OrFormulaFloors(m, f, d, r, corners, c)
                : QuadGridOutcome.CountsDiffer(m.GridFloors(f, d, r, corners, c));
        };
}

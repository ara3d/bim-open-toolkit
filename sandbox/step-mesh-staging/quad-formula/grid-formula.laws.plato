//==
// # The closed-form grid counts of an analytic face: laws (TKT-502, chunk QF1)
//
// Three claims. The count: an arc cut into the formula's count has chords within the budget, and
// one segment fewer does not (where the chordal criterion is the binding one and the minimum
// length does not cap it). No change: on the grid cases curved at most one way (the unit box, the
// flat patch solid, the cylinders, the cone) every four-sided face's boundary already carries the
// formula's counts, and on every grid case a face that keeps its grid today keeps the same grid.
// The gain: on the torus, whose grid the gate refuses at the boundary's counts, the formula's
// floors are asked, and with the edges raised to them the grid is kept and within the chordal
// bound. The sphere witness is bounded by pole segments, which no floor reaches; chunk QF4 sizes
// those.
//
// Sections, in order:
//  - Arc cases
//  - The count
//  - No change on the grid cases
//  - The torus takes the grid with the formula's floors

library AnalyticGridFormulaLaws
{
    //==
    // # Arc cases

    // Arc case k of sixty: five radii, four sweeps, three budgets.
    ArcCaseAt(k: Integer): ArcCase
    {
        var i = ((k % 60) + 60) % 60;
        var radii = [0.5, 1.0, 2.0, 10.0, 100.0];
        var sweeps = [Number.Tau, Number.Pi, Number.HalfPi, 0.3];
        var budgets = [0.01, 0.1, 1.0];
        return ArcCase(radii[i % 5], sweeps[(i / 5) % 4], budgets[(i / 20) % 3]);
    }

    Witness_ArcCaseAt(_: ArcCase, k: Integer): ArcCase
        => ArcCaseAt(k);
    Witness_ArcUnitFull(_: ArcCase): ArcCase
        => ArcCase(1.0, Number.Tau, 0.01);
    Witness_ArcWideQuarter(_: ArcCase): ArcCase
        => ArcCase(100.0, Number.HalfPi, 0.1);
    Witness_ArcTightShort(_: ArcCase): ArcCase
        => ArcCase(0.5, 0.3, 0.01);

    // Whether the arc is one the formula is for: a positive radius, sweep and budget (the runner
    // also draws cases with negative fields).
    IsArc(w: ArcCase): Boolean
        => w.Radius > 0.0 && w.Sweep > 0.0 && w.Budget > 0.0;

    // The edge criteria the count is taken under: the witness options' at the arc's budget.
    ArcCriteria(w: ArcCase): DiscretizationCriteria
        => MeshingOptions.WitnessOptions.Face.Discretization.WithChordal(w.Budget);

    // The formula's count for the arc.
    ArcCount(w: ArcCase): Integer
        => w.Radius.ArcSegmentCount(Angle(w.Sweep), w.ArcCriteria, Tolerances.Witness_Tolerances, 1);

    // Whether the minimum-length cap leaves the criteria's count alone.
    ArcUncapped(w: ArcCase): Boolean
        => w.ArcCount == w.Radius.ArcCriteriaCount(Angle(w.Sweep), w.ArcCriteria, Tolerances.Witness_Tolerances);

    // Whether the chordal criterion is the binding one: its step is no larger than the angular
    // step and the length limit's.
    ChordalBinds(w: ArcCase): Boolean
    {
        var step = w.Radius.ChordalArcAngle(w.ArcCriteria.EffectiveChordal(Tolerances.Witness_Tolerances)).Radians;
        return step <= w.ArcCriteria.EffectiveAngular.Radians
            && step <= w.Radius.LimitArcAngle(w.ArcCriteria.MaxLength).Radians;
    }

    //==
    // # The count

    // Where the cap does not bind, the chord of a segment at the formula's count has sagitta within
    // the budget (a rounding slack of one part in a billion).
    Law_QuadFormula_CountChordMeetsBudget(w: ArcCase): Boolean
        => (w.IsArc && w.ArcUncapped)
            ? w.Radius.ArcSagitta(Angle(w.Sweep / w.ArcCount.ToNumber)) <= w.Budget * (1.0 + 1e-9)
            : true;

    // Where the chordal criterion binds and the cap does not, one segment fewer would exceed the
    // budget: the count is the least that meets it.
    Law_QuadFormula_CountIsLeast(w: ArcCase): Boolean
        => (w.IsArc && w.ArcUncapped && w.ChordalBinds && w.ArcCount > 1)
            ? w.Radius.ArcSagitta(Angle(w.Sweep / (w.ArcCount - 1).ToNumber)) > w.Budget
            : true;

    //==
    // # No change on the grid cases

    // On a case curved at most one way, every four-sided face's boundary already carries the
    // formula's counts, so the formula asks nothing of it.
    Law_QuadFormula_BoundaryReachesFormulaWhereCurvedOneWay(w: GridCase): Boolean
        => w.IsCurvedAtMostOneWay
            ? w.FourSidedFaces.All(f => w.BoundaryReachesFormulaOn(f, w.Model.RegionOf(f, w.Discretizations, w.Criteria)))
            : true;

    // Law_QuadFormula_BoundaryReachesFormulaWhereCurvedOneWay on face f of case w, its region r.
    BoundaryReachesFormulaOn(w: GridCase, f: BrepFaceIndex, r: UvRegion): Boolean
        => match (w.Model.QuadSidesOf(f, r)) {
            NotFourSided => true;
            FourSided(corners) => w.Model.BoundaryReachesFormula(f, r, corners, w.Criteria);
        };

    // On every grid case, a four-sided face keeps its grid under the formula exactly when it keeps
    // it today, and then the same grid: QuadGridOnSidesFormula's outcome is QuadGridOnSides's where
    // the latter is a grid, and no grid where it is none.
    Law_QuadFormula_KeptGridsUnchanged(w: GridCase): Boolean
        => w.FourSidedFaces.All(f => w.KeptGridUnchangedOn(f, w.Model.RegionOf(f, w.Discretizations, w.Criteria)));

    // Law_QuadFormula_KeptGridsUnchanged on face f of case w, its region r.
    KeptGridUnchangedOn(w: GridCase, f: BrepFaceIndex, r: UvRegion): Boolean
    {
        var m = w.Model;
        var sides = m.QuadSidesOf(f, r);
        var before = m.QuadGridOnSides(f, w.Discretizations, r, w.Criteria, sides);
        var after = m.QuadGridOnSidesFormula(f, w.Discretizations, r, w.Criteria, sides);
        return before.IsGridOutcome ? after == before : after.IsGridOutcome.Not;
    }

    //==
    // # The torus takes the grid with the formula's floors

    // On the torus, whose grid the gate refuses at the boundary's counts, the formula asks floors
    // of the face's two circles, and with the edges discretized at those floors the face's grid is
    // kept and its lifted mesh is within the chordal bound.
    Law_QuadFormula_TorusGridKeptAtFormulaFloors(w: GridCase): Boolean
        => w.Name == "Torus"
            ? w.FourSidedFaces.All(f => w.GridKeptAtFloorsOn(f, w.Model.RegionOf(f, w.Discretizations, w.Criteria)))
            : true;

    // Law_QuadFormula_TorusGridKeptAtFormulaFloors on face f of case w, its region r: the outcome
    // at the boundary's counts asks floors; the outcome at those floors is a kept grid within the
    // bound.
    GridKeptAtFloorsOn(w: GridCase, f: BrepFaceIndex, r: UvRegion): Boolean
        => match (w.Model.QuadGridOnSidesFormula(f, w.Discretizations, r, w.Criteria, w.Model.QuadSidesOf(f, r))) {
            NoGrid => false;
            CountsDiffer(floors) => w.GridKeptWithFloors(f, floors);
            Grid(mesh) => false;
        };

    // Whether face f of case w, its edges discretized at the floors, gets a grid within the bound.
    GridKeptWithFloors(w: GridCase, f: BrepFaceIndex, floors: SegmentFloors): Boolean
    {
        var m = w.Model;
        var d = m.DiscretizeAll(w.Criteria.Discretization, floors);
        var r = m.RegionOf(f, d, w.Criteria);
        return w.KeptGridWithinAt(f, d, m.QuadGridOnSidesFormula(f, d, r, w.Criteria, m.QuadSidesOf(f, r)));
    }

    // Whether g is a grid whose mesh, lifted with discretizations d, is within the chordal bound.
    KeptGridWithinAt(w: GridCase, f: BrepFaceIndex, d: EdgeDiscretizations, g: QuadGridOutcome): Boolean
        => match (g) {
            NoGrid => false;
            CountsDiffer(floors) => false;
            Grid(mesh) => w.FaceMeshWithinChordalAt(d, w.Model.Lift(f, d, mesh));
        };

    // FaceMeshWithinChordal with the discretizations the mesh was lifted with.
    FaceMeshWithinChordalAt(w: GridCase, d: EdgeDiscretizations, fm: FaceMesh): Boolean
    {
        var bound = w.Criteria.SurfaceChordal + w.Model.Tolerances.Length.Value;
        return fm.ElementCount.Range.All(k =>
            w.Model.ElementCoverageGap(d, fm, ElementIndex(k)) <= bound
                && w.Model.ElementChordalDeviation(d, fm, ElementIndex(k)) <= bound);
    }
}

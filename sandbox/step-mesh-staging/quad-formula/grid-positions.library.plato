//==
// # A grid with its nodes evaluated once (TKT-502, chunk QF3; finding 3 of the algorithmic review)
//
// Layer 05-face-meshing. QuadGrid (face-meshing.library.plato) evaluates each cell's four corners,
// so a node shared by four cells is evaluated four times; it tests IsKeptQuad twice per cell and
// builds CellTriangles for a kept cell only to drop them. The keep gate (GridElementKeptV1,
// face-meshing-v1-keep.library.plato) then evaluates every corner again for each of the four
// triangles a quad may be drawn as, and GridTriangleFacesFaceNormal once more. QuadGridPositioned
// evaluates each parameter point once into a positions array that the cell rule and the gate read.
// Every number compared is the same Eval at the same parameters, so the grid and the decision are
// the current ones bit for bit (Law_QuadFormula_PositionedGridAgrees). Lift still evaluates the
// nodes when it lifts the grid (face-meshing-lift, another track's file).
//
// Sections, in order:
//  - The grid
//  - The gate on positions
//  - The outcome

library GridPositions
{
    //==
    // # The grid

    // No triangles: the empty array a cell kept as a quad contributes.
    NoCellTriangles(_: Integer): Array<TriangleFace>
        => [TriangleFace(VertexIndex(0), VertexIndex(0), VertexIndex(0))].Take(0);

    // No quads: the empty array a cell split into triangles contributes.
    NoCellQuads(_: Integer): Array<QuadFace>
        => [QuadFace(VertexIndex(0), VertexIndex(0), VertexIndex(0), VertexIndex(0))].Take(0);

    // QuadGrid(f, r, corners, c) with each node evaluated once: the same points, sources, triangles
    // and quads, and the surface position of every point.
    QuadGridPositioned(m: BrepModel, f: BrepFaceIndex, r: UvRegion, corners: Array<VertexIndex>, c: FaceMeshingCriteria): PositionedGrid
    {
        var n0 = r.SideSegmentCount(corners, 0);
        var n1 = r.SideSegmentCount(corners, 1);
        var interior = ((n0 - 1) * (n1 - 1)).MapRange(k => r.GridNodePoint(corners, n0, n1, k % (n0 - 1) + 1, k / (n0 - 1) + 1));
        var points = r.Outer.Points.Concatenate(interior);
        var s = m.SurfaceOf(f);
        var positions = points.Map(uv => m.Geometry.Eval(s, uv));
        var cells = (n0 * n1).MapRange(k => 4.MapRange(q => VertexIndex(r.GridNodeIndex(corners, n0, n1,
            k % n0 + ((q == 1 || q == 2) ? 1 : 0), k / n0 + (q >= 2 ? 1 : 0)))));
        var keep = cells.Map(cell => cell.Map(v => positions[v]).IsKeptQuad(c));
        var triangles = (n0 * n1).Range.FlatMap(k => keep[k] ? NoCellTriangles(0) : CellTriangles(cells[k], cells[k].Map(v => positions[v])));
        var quads = (n0 * n1).Range.FlatMap(k => keep[k] ? [QuadFace(cells[k][0], cells[k][1], cells[k][2], cells[k][3])] : NoCellQuads(0));
        return PositionedGrid(
            UvTriangulation(points, r.Outer.Sources.Concatenate(interior.Map(uv => UvPointSource.Interior)), triangles, quads),
            positions);
    }

    //==
    // # The gate on positions

    // GridTriangleFacesFaceNormal with the corners read from the positions.
    GridTriangleFacesFaceNormalAt(m: BrepModel, f: BrepFaceIndex, g: PositionedGrid, tri: TriangleFace): Boolean
    {
        var uvs = tri.Vertices.Map(v => g.Grid.Points[v]);
        var area = tri.Vertices.Map(v => g.Positions[v]).VectorArea;
        var mean = uvs.Map(uv => uv.ToPoint2D).AverageOfPoints;
        return area.Dot(m.FaceNormalAt(f, UvCoordinate(mean.X, mean.Y), area)) > 0.0;
    }

    // GridElementKeptV1 with the corners read from the positions: element k is kept when it
    // collapses at a pole, or every triangle it may be drawn as faces the face normal and it is
    // within `bound` under the one chordal measure.
    GridElementKeptAt(m: BrepModel, f: BrepFaceIndex, r: UvRegion, g: PositionedGrid, k: ElementIndex, bound: Number): Boolean
    {
        var shape = g.Grid.ShapeOf(k);
        return shape.IsElementShape.Not
            ? false
            : (g.Grid.IsCollapsedElement(k)
                ? true
                : (shape.RenderTriangles.All(tri => m.GridTriangleFacesFaceNormalAt(f, g, tri))
                    ? m.ElementWithinChordal(f, v => g.Grid.Points[v], v => g.Positions[v], shape,
                        (a, b) => r.IsConstrained(a.Value, b.Value).Not, bound)
                    : false));
    }

    // DecideGridChordal on a positioned grid: the first element not kept, or the grid with its
    // bound (SurfaceChordal widened by the length tolerance).
    DecideGridChordalAt(m: BrepModel, f: BrepFaceIndex, r: UvRegion, g: PositionedGrid, c: FaceMeshingCriteria): GridChordalDecision
    {
        var bound = c.SurfaceChordal + m.Tolerances.Length.Value;
        var n = g.Grid.Triangles.Count + g.Grid.Quads.Count;
        var k = 0;
        var first = n;
        while (k < n)
        {
            if (m.GridElementKeptAt(f, r, g, ElementIndex(k), bound))
            {
                k = k + 1;
            }
            else
            {
                first = k;
                k = n;
            }
        }
        return first < n
            ? GridChordalDecision.GridExceedsAt(ElementIndex(first))
            : GridChordalDecision.GridWithinChordal(g.Grid, bound);
    }

    // GridUnlessFoldedOrCoarse on a positioned grid.
    GridUnlessFoldedOrCoarseAt(m: BrepModel, f: BrepFaceIndex, r: UvRegion, g: PositionedGrid, c: FaceMeshingCriteria): QuadGridOutcome
        => m.DecideGridChordalAt(f, r, g, c).GridOutcomeOf;

    //==
    // # The outcome

    // QuadGridOnSidesFormula with the grid built and gated on positions: the same outcome.
    QuadGridOnSidesPositioned(m: BrepModel, f: BrepFaceIndex, d: EdgeDiscretizations, r: UvRegion, c: FaceMeshingCriteria, sides: QuadSides): QuadGridOutcome
        => match (sides) {
            NotFourSided => QuadGridOutcome.NoGrid;
            FourSided(corners) => r.OppositeCountsMatch(corners)
                ? m.GridUnlessFoldedOrCoarseAt(f, r, m.QuadGridPositioned(f, r, corners, c), c).OrFormulaFloors(m, f, d, r, corners, c)
                : QuadGridOutcome.CountsDiffer(m.GridFloors(f, d, r, corners, c));
        };
}

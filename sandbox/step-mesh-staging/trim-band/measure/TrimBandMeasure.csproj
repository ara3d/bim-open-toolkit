<Project Sdk="Microsoft.NET.Sdk">

  <!-- TKT-490: a throwaway measurement of the trim-band grid on corpus faces. Build against a private export of
       bim-open-data (docs/plans/step-mesher-corpus-2026-10-19.md, "How to rerun"):
       dotnet build -c Release -p:BimOpenData=<export>/deps/bim-open-data -artifacts-path <out> -m:1
       It compiles the corpus harness's sources (all but its Program.cs) for the timed host path and the contract check. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>trim-band-measure</AssemblyName>
    <RootNamespace>Ara3D.Step.TrimBand</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <BimOpenData Condition="'$(BimOpenData)' == ''">$(MSBuildThisFileDirectory)../../../../deps/bim-open-data</BimOpenData>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(BimOpenData)/src/data/Ara3D.Step.Mesher/Ara3D.Step.Mesher.csproj" />
    <Compile Include="$(BimOpenData)/tools/step-corpus-harness/*.cs" Exclude="$(BimOpenData)/tools/step-corpus-harness/Program.cs" />
  </ItemGroup>

</Project>

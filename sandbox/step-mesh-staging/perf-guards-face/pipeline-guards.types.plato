//==
// # A state built two ways (complexity sweep, chunk G2)
//
// The agreement laws of pipeline-guards.laws.plato compare a refinement state the library
// builds with the one the staged arena-once forms build. Each pair is a Witness_* value, so a
// sweep meshes it once, not once per law case.

// One state built by the library's InitialState or Step (Plain) and by InitialStateInRange or
// StepInRange (Staged) from the same model, options and choice.
// Removes: meshing a witness inside every case of an agreement law.
type StatePair
{
    Plain: PipelineState;
    Staged: PipelineState;
}

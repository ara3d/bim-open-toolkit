//==
// # Sparse topology checks (complexity sweep, chunk V5)
//
// Layer 07. Ranked candidate 14 (the checks half) of docs/plans/step-mesher-complexity.md: seven
// checks of validation-checks-topology.library.plato fold a layer 2 law over a dense grid,
// shells by edges, shells by vertices or faces by edges (CheckShellEdges, CheckShellVertices,
// CheckFaceEdges), and each cell rebuilds the shell's or the face's coedge sites (UseCount,
// CoedgeSitesOfEdge, CornersAtVertex, IsVertexLoopVertexIn) and, through CountsAsEdge or the
// law's guard, rescans the whole model (IsEveryIndexInRange): O(S E C) and O(S V C) per check.
//
// Each *Sparse check here visits only the cells some coedge cites, the cited keys of each shell
// or face in increasing order, so in the dense grid's row-major order, and folds the same
// CheckExact as the dense check with the same WorseOf from the same seed. A cell no coedge cites
// holds by the law's own guard (a use count of 0 is zero-or-two and at most two, UsesRunOpposite
// holds on no sites, a vertex with no corners or touched by no coedge passes): it adds a holding
// check, which never displaces the seed or an earlier failure, so skipping it leaves the fold
// unchanged (SparseGridsLaws, Law_Perf_UncitedCellsHold and Law_Perf_SparseChecksAgree). A shell
// whose law is vacuous at every cell (a closedness or whole-model guard) is skipped whole. Rows
// come from BrepKeyedSiteRows, sorted by key per shell or face: O(C log C) for the model's C
// coedges, with no term in the model's edge or vertex count per shell.
//
// Sections, in order:
//  - Folding keyed rows
//  - Edge uses
//  - Vertex links
//  - Seams

library BrepCheckingTopologySparse
{
    //==
    // # Folding keyed rows

    // An exact law at the cells (i, key) for i from 0 to n - 1 and each key of rows(i) in
    // increasing order: holds(i, key, sites) is the law at the cell given the row's sites, where(i,
    // key) the cell it is about. Folded as CheckGrid folds, from NoSampleCheck by WorseOf, so it is
    // the dense CheckGrid whenever every cell rows(i) leaves out holds. Work: Insertions is the
    // grouping's (one per site placed) plus one per cell visited.
    CheckKeyedRowsCounted(law: String, n: Integer, rows: Function1<Integer, Counted<KeyedSiteRows>>, holds: Function3<Integer, Integer, Array<CoedgeSite>, Boolean>, where: Function2<Integer, Integer, Provenance>): Counted<Check>
    {
        var worst = NoSampleCheck(law);
        var work = 0;
        var i = 0;
        while (i < n)
        {
            var g = rows(i);
            var keyed = g.Value;
            var k = 0;
            while (k < keyed.Keys.Count)
            {
                worst = WorseOf(worst, CheckExact(law, holds(i, keyed.Keys[k], keyed.Rows.RowSites(k)), where(i, keyed.Keys[k])));
                k = k + 1;
            }
            work = work + g.Work.Insertions + keyed.Keys.Count;
            i = i + 1;
        }
        return Counted(worst, Insertions(work));
    }

    // CheckShellEdges at the (shell, edge) cells some coedge of the shell cites, in shells where
    // inShell holds: holds(s, e, uses) is the law at the cell given the shell's uses of e
    // (CoedgeSitesOfEdge(m, s, e)), reported at the edge.
    CheckShellEdgesSparseCounted(m: BrepModel, law: String, inShell: Function1<ShellIndex, Boolean>, holds: Function3<ShellIndex, BrepEdgeIndex, Array<CoedgeSite>, Boolean>): Counted<Check>
        => CheckKeyedRowsCounted(law, m.Shells.Count,
            s => inShell(ShellIndex(s)) ? m.SitesByEdge(m.CoedgeSitesOfShell(ShellIndex(s))) : KeyedSiteRows.NoKeyedSiteRows,
            (s, e, uses) => holds(ShellIndex(s), BrepEdgeIndex(e), uses),
            (s, e) => AtEdge(e));

    // CheckShellVertices at the (shell, vertex) cells where some coedge of the shell arrives, in
    // shells where inShell holds: holds(s, v, corners) is the law at the cell given the corners at
    // v (CornersAtVertex(m, s, v)), reported at the vertex.
    CheckShellVerticesSparseCounted(m: BrepModel, law: String, inShell: Function1<ShellIndex, Boolean>, holds: Function3<ShellIndex, BrepVertexIndex, Array<CoedgeSite>, Boolean>): Counted<Check>
        => CheckKeyedRowsCounted(law, m.Shells.Count,
            s => inShell(ShellIndex(s)) ? m.SitesByEndVertex(m.CoedgeSitesOfShell(ShellIndex(s))) : KeyedSiteRows.NoKeyedSiteRows,
            (s, v, corners) => holds(ShellIndex(s), BrepVertexIndex(v), corners),
            (s, v) => AtVertex(v));

    // CheckFaceEdges at the (face, edge) cells some coedge of the face cites: holds(f, e, uses) is
    // the law at the cell given the face's uses of e (CoedgeSitesOfEdgeInFace(m, f, e)), reported
    // at the face.
    CheckFaceEdgesSparseCounted(m: BrepModel, law: String, holds: Function3<BrepFaceIndex, BrepEdgeIndex, Array<CoedgeSite>, Boolean>): Counted<Check>
        => CheckKeyedRowsCounted(law, m.Faces.Count,
            f => m.SitesByEdge(m.CoedgeSitesOfFace(BrepFaceIndex(f))),
            (f, e, uses) => holds(BrepFaceIndex(f), BrepEdgeIndex(e), uses),
            (f, e) => AtFace(f));

    //==
    // # Edge uses

    // Layer 2's CountsAsEdge with its whole-model guard IsEveryIndexInRange given as ok.
    // Precondition: m.IsEdgeInRange(e).
    CountsAsEdgeGiven(m: BrepModel, ok: Boolean, e: BrepEdgeIndex): Boolean
        => ok ? m.IsDegenerateEdge(e).Not : true;

    // Check_EveryEdgeUsedTwiceInClosedShell over the cited cells of the closed shells, with its
    // work: Insertions is one per coedge of a closed shell grouped plus one per cell visited, at
    // most 2 C. The dense check visits S x E cells and rebuilds the shell's C_s sites at each.
    Check_EveryEdgeUsedTwiceInClosedShellSparseCounted(m: BrepModel): Counted<Check>
    {
        var ok = m.IsEveryIndexInRange;
        return m.CheckShellEdgesSparseCounted("Law_EveryEdgeUsedTwiceInClosedShell",
            s => m.Shells[s].DeclaredClosed,
            (s, e, uses) => m.CountsAsEdgeGiven(ok, e) ? uses.Count.IsZeroOrTwo : true);
    }

    // Check_EveryEdgeUsedTwiceInClosedShell over the cited cells.
    Check_EveryEdgeUsedTwiceInClosedShellSparse(m: BrepModel): Check
        => m.Check_EveryEdgeUsedTwiceInClosedShellSparseCounted.Value;

    // Check_OpenShellEdgesUsedAtMostTwice over the cited cells of the open shells.
    Check_OpenShellEdgesUsedAtMostTwiceSparse(m: BrepModel): Check
    {
        var ok = m.IsEveryIndexInRange;
        return m.CheckShellEdgesSparseCounted("Law_OpenShellEdgesUsedAtMostTwice",
            s => m.Shells[s].DeclaredClosed.Not,
            (s, e, uses) => m.CountsAsEdgeGiven(ok, e) ? uses.Count <= 2 : true).Value;
    }

    // Check_EdgeUsesHaveOppositeOrientation over the cited cells.
    Check_EdgeUsesHaveOppositeOrientationSparse(m: BrepModel): Check
        => m.CheckShellEdgesSparseCounted("Law_EdgeUsesHaveOppositeOrientation",
            s => true,
            (s, e, uses) => m.UsesRunOpposite(uses)).Value;

    //==
    // # Vertex links

    // Layer 2's LinkComponentCount(m, s, v) with the corners at v given: the classes of the
    // corners under the transitive closure of CornersShareEnd. O(k^2) for k corners. Precondition:
    // every corner is in range.
    LinkComponentCountOf(m: BrepModel, corners: Array<CoedgeSite>): Integer
    {
        var n = corners.Count;
        var joined = n.Range.FlatMap(i => n.Range.FlatMap(j =>
            (i < j ? m.CornersShareEnd(corners[i], corners[j]) : false) ? [i * n + j] : n.Range.Take(0)));
        return ClassRoots(n, joined.Map(k => k / n), joined.Map(k => k % n)).ClassCount;
    }

    // Whether the link at a vertex with the given corners has one component, or the vertex has no
    // corners: the shared conclusion of Law_VertexLinkIsOneCycle and
    // Law_OpenShellVertexLinkIsCycleOrPath.
    LinkIsOneComponent(m: BrepModel, corners: Array<CoedgeSite>): Boolean
        => corners.Count == 0 ? true : m.LinkComponentCountOf(corners) == 1;

    // Check_VertexLinkIsOneCycle over the cells with corners of the closed shells, when every
    // index is in range (else the law holds everywhere).
    Check_VertexLinkIsOneCycleSparse(m: BrepModel): Check
    {
        var ok = m.IsEveryIndexInRange;
        return m.CheckShellVerticesSparseCounted("Law_VertexLinkIsOneCycle",
            s => ok ? m.Shells[s].DeclaredClosed : false,
            (s, v, corners) => m.LinkIsOneComponent(corners)).Value;
    }

    // Check_OpenShellVertexLinkIsCycleOrPath over the cells with corners of the open shells,
    // when every index is in range.
    Check_OpenShellVertexLinkIsCycleOrPathSparse(m: BrepModel): Check
    {
        var ok = m.IsEveryIndexInRange;
        return m.CheckShellVerticesSparseCounted("Law_OpenShellVertexLinkIsCycleOrPath",
            s => ok ? m.Shells[s].DeclaredClosed.Not : false,
            (s, v, corners) => m.LinkIsOneComponent(corners)).Value;
    }

    // The vertices of the vertex loops bounding faces of shell s, as indices in increasing order,
    // repeats kept: what IsVertexLoopVertexIn(m, s, v) searches.
    SortedVertexLoopVertices(m: BrepModel, s: ShellIndex): Array<Integer>
        => m.ShellFaces(s).FlatMap(f => m.VertexLoopVertices(f)).Map(v => v.Value).Sort((a, b) => a <= b);

    // Whether x is among xs, sorted increasing: a binary search.
    IsInSorted(x: Integer, xs: Array<Integer>): Boolean
    {
        var lo = 0;
        var hi = xs.Count;
        while (lo < hi)
        {
            var mid = (lo + hi) / 2;
            if (xs[mid] < x)
            {
                lo = mid + 1;
            }
            else
            {
                hi = mid;
            }
        }
        return lo < xs.Count ? xs[lo] == x : false;
    }

    // Check_VertexLoopVertexIsIsolated over the (shell, vertex) cells where a coedge of the shell
    // touches the vertex, in shells with a vertex loop: such a cell fails exactly when the vertex
    // is a vertex loop's, and every other cell holds.
    Check_VertexLoopVertexIsIsolatedSparse(m: BrepModel): Check
    {
        var loops = m.Shells.Count.MapRange(s => m.SortedVertexLoopVertices(ShellIndex(s)));
        return CheckKeyedRowsCounted("Law_VertexLoopVertexIsIsolated", m.Shells.Count,
            s => loops[s].Count > 0 ? m.SitesByTouchedVertex(m.CoedgeSitesOfShell(ShellIndex(s))) : KeyedSiteRows.NoKeyedSiteRows,
            (s, v, touching) => IsInSorted(v, loops[s]).Not,
            (s, v) => AtVertex(v)).Value;
    }

    //==
    // # Seams

    // Check_SeamUsesRunOpposite over the (face, edge) cells some coedge of the face cites.
    Check_SeamUsesRunOppositeSparse(m: BrepModel): Check
        => m.CheckFaceEdgesSparseCounted("Law_SeamUsesRunOpposite",
            (f, e, uses) => m.UsesRunOpposite(uses)).Value;
}

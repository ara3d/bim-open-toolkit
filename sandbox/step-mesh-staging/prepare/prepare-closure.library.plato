//==
// # PrepareClosure
//
// Track D1 (TKT-348), staged for layer 3: closure decided from a curve's
// record, never by evaluating a B-spline. DecidesClosed (layer 3) evaluates
// both ends of every closable curve, which reaches BSplinePoint for a
// B-spline; a host whose BSplinePoint has no body then throws out of Reduced
// and the whole file meshes nothing. Here a clamped B-spline's ends are its
// first and last control points (ISO 10303-42 4.5.34: the curve
// interpolates them when the knots are clamped), so its closure needs no
// evaluation; a curve that would reach a B-spline any other way is
// Undecided, and Reduced keeps the edge and records a located diagnostic.
//
// Merge: DecidesClosed(g, c, tol) => DecidesClosedWithoutEvaluation(g, c, tol);
// Reduced's body becomes ReducedDecided's (TRACK.md, "Merge instructions").
//
// Sections, in order:
//  - Decided closure
//  - Reaching a B-spline
//  - The decision
//  - The reduction

library PrepareClosure
{
    //==
    // # Decided closure

    // True when d holds Closed.
    IsClosed(d: DecidedClosure): Boolean
        => match (d) {
            Decided(value) => value;
            Undecided(reason) => false;
        };

    // True when d holds a decision.
    IsDecided(d: DecidedClosure): Boolean
        => match (d) {
            Decided(value) => true;
            Undecided(reason) => false;
        };

    // The reason a B-spline's closure stays undecided: its ends are not its
    // control points, so settling it would evaluate the spline.
    SplineEndsNeedEvaluation(_: UndecidedReason): UndecidedReason
        => UndecidedReason.NotApplicable("B-spline ends need evaluation");

    // The undecided closure of a curve that reaches a B-spline.
    UndecidedSplineClosure(_: DecidedClosure): DecidedClosure
        => DecidedClosure.Undecided(UndecidedReason.SplineEndsNeedEvaluation);

    //==
    // # Reaching a B-spline

    // True when evaluating curve c reaches a B-spline curve or surface: the
    // record is a B-spline, or it refers to one through a trim, a composite
    // segment, an offset basis, or a surface curve's master pcurve (its 2D
    // curve or its surface).
    ReachesSpline(g: GeometrySet, c: CurveIndex): Boolean
        => match (g.CurveAt(c))
        {
            Line(origin, velocity) => false;
            Circle(placement, radius) => false;
            Ellipse(placement, semiAxis1, semiAxis2) => false;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => false;
            Parabola(placement, focalDistance) => false;
            Polyline(points) => false;
            BSpline(data) => true;
            Trimmed(basis, range, sameSense) => g.ReachesSpline(basis);
            Composite(segments) => segments.Any(s => g.ReachesSpline(s.Curve));
            Offset(basis, distance, reference) => g.ReachesSpline(basis);
            OnSurface(spaceCurve, supports, master) => supports.MasterPcurve(master).IsNone
                ? g.ReachesSpline(spaceCurve)
                : g.ReachesSpline(supports.MasterPcurve(master));
        };

    // True when evaluating pcurve p reaches a B-spline: its 2D curve or its
    // surface does.
    ReachesSpline(g: GeometrySet, p: PcurveIndex): Boolean
        => g.ReachesSpline(g.PcurveAt(p).Curve) || g.ReachesSpline(g.PcurveAt(p).Surface);

    // True when evaluating parameter-plane curve c reaches a B-spline.
    ReachesSpline(g: GeometrySet, c: Curve2DIndex): Boolean
        => match (g.Curve2DAt(c))
        {
            Line(origin, velocity) => false;
            Circle(placement, radius) => false;
            Ellipse(placement, semiAxis1, semiAxis2) => false;
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => false;
            Parabola(placement, focalDistance) => false;
            Polyline(points) => false;
            BSpline(data) => true;
            Trimmed(basis, range, sameSense) => g.ReachesSpline(basis);
            Composite(segments) => segments.Any(s => g.ReachesSpline(s.Curve));
            Offset(basis, distance) => g.ReachesSpline(basis);
        };

    // True when evaluating surface s reaches a B-spline: the record is one,
    // or its profile, basis, or trimmed basis reaches one.
    ReachesSpline(g: GeometrySet, s: SurfaceIndex): Boolean
        => match (g.SurfaceAt(s))
        {
            Plane(placement) => false;
            Cylinder(placement, radius) => false;
            Cone(placement, radius, semiAngle) => false;
            Sphere(placement, radius) => false;
            Torus(placement, majorRadius, minorRadius, part) => false;
            Revolution(profile, axis) => g.ReachesSpline(profile);
            LinearExtrusion(profile, extrusion) => g.ReachesSpline(profile);
            BSpline(data) => true;
            RectangularTrimmed(basis, uRange, vRange, uSense, vSense) => g.ReachesSpline(basis);
            Offset(basis, distance) => g.ReachesSpline(basis);
        };

    //==
    // # The decision

    // A B-spline's closure from its record alone: with clamped knots its
    // ends are its first and last control points, so it is closed exactly
    // when they coincide within tol (weights do not move a clamped end);
    // otherwise its ends are interior to the control polygon and the
    // decision is Undecided. Precondition: at least one control point.
    EndsClosure(d: BSplineCurveData, tol: LengthTolerance): DecidedClosure
        => d.Basis.HasClampedEnds
            ? DecidedClosure.Decided(d.ControlPoints.First.Coincident(d.ControlPoints.Last, tol))
            : DecidedClosure.UndecidedSplineClosure;

    // Closure by evaluating both ends of c's natural domain, as DecidesClosed
    // does. Precondition: the domain is closable and c reaches no B-spline.
    EvaluatedEndsClosure(g: GeometrySet, c: CurveIndex, tol: LengthTolerance): DecidedClosure
    {
        var d = g.CurveAt(c).Domain(g);
        return DecidedClosure.Decided(g.Eval(c, d.Range.Start).Coincident(g.Eval(c, d.Range.End), tol));
    }

    // Closure for a kind whose ends are only known by evaluation: Undecided
    // when evaluating c would reach a B-spline, else the evaluated ends.
    GuardedEndsClosure(g: GeometrySet, c: CurveIndex, tol: LengthTolerance): DecidedClosure
        => g.ReachesSpline(c)
            ? DecidedClosure.UndecidedSplineClosure
            : g.EvaluatedEndsClosure(c, tol);

    // A trimmed curve's closure from its record: a trim of a clamped
    // B-spline over exactly its whole domain has the spline's ends (the
    // parameters are copied from the file, so the comparison is exact); any
    // other trim that reaches a spline is Undecided; a trim of anything else
    // compares its evaluated ends. Precondition: the trim's domain is closable.
    TrimmedEndsClosure(g: GeometrySet, c: CurveIndex, basis: CurveIndex, range: NumberInterval, tol: LengthTolerance): DecidedClosure
        => match (g.CurveAt(basis))
        {
            Line(origin, velocity) => g.EvaluatedEndsClosure(c, tol);
            Circle(placement, radius) => g.EvaluatedEndsClosure(c, tol);
            Ellipse(placement, semiAxis1, semiAxis2) => g.EvaluatedEndsClosure(c, tol);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => g.EvaluatedEndsClosure(c, tol);
            Parabola(placement, focalDistance) => g.EvaluatedEndsClosure(c, tol);
            Polyline(points) => g.EvaluatedEndsClosure(c, tol);
            BSpline(data) => range.Start == data.Basis.SplineDomain.Start && range.End == data.Basis.SplineDomain.End
                ? data.EndsClosure(tol)
                : DecidedClosure.UndecidedSplineClosure;
            Trimmed(innerBasis, innerRange, sameSense) => g.GuardedEndsClosure(c, tol);
            Composite(segments) => g.GuardedEndsClosure(c, tol);
            Offset(innerBasis, distance, reference) => g.GuardedEndsClosure(c, tol);
            OnSurface(spaceCurve, supports, master) => g.GuardedEndsClosure(c, tol);
        };

    // The decode's decision for curve c without evaluating a B-spline: not
    // closed when its natural domain is not closable (a line, a circle);
    // otherwise by its record: a polyline's first and last points, a clamped
    // B-spline's end control points, a trim of such a spline over its whole
    // domain, and evaluated ends for every other kind that reaches no
    // B-spline. Undecided only when settling it would evaluate a B-spline.
    DecidesClosedByEnds(g: GeometrySet, c: CurveIndex, tol: LengthTolerance): DecidedClosure
        => g.CurveAt(c).Domain(g).IsClosable
            ? g.CurveAt(c).ClosableEndsClosure(g, c, tol)
            : DecidedClosure.Decided(false);

    // DecidesClosedByEnds for a record whose domain is closable (the
    // interpreter matches only on a parameter or a call, not a local).
    ClosableEndsClosure(curve: BrepCurve, g: GeometrySet, c: CurveIndex, tol: LengthTolerance): DecidedClosure
        => match (curve)
        {
            Line(origin, velocity) => DecidedClosure.Decided(false);
            Circle(placement, radius) => DecidedClosure.Decided(false);
            Ellipse(placement, semiAxis1, semiAxis2) => DecidedClosure.Decided(false);
            Hyperbola(placement, semiAxis, semiImaginaryAxis) => DecidedClosure.Decided(false);
            Parabola(placement, focalDistance) => DecidedClosure.Decided(false);
            Polyline(points) => DecidedClosure.Decided(points.First.Coincident(points.Last, tol));
            BSpline(data) => data.EndsClosure(tol);
            Trimmed(basis, range, sameSense) => g.TrimmedEndsClosure(c, basis, range, tol);
            Composite(segments) => g.GuardedEndsClosure(c, tol);
            Offset(basis, distance, reference) => g.GuardedEndsClosure(c, tol);
            OnSurface(spaceCurve, supports, master) => g.GuardedEndsClosure(c, tol);
        };

    // DecidesClosed without evaluating a B-spline: the decision when there is
    // one, not closed when there is none (no mark is written for a curve
    // whose closure could not be settled; Reduced reports it).
    DecidesClosedWithoutEvaluation(g: GeometrySet, c: CurveIndex, tol: LengthTolerance): Boolean
        => g.DecidesClosedByEnds(c, tol).IsClosed;

    // RunsBackToStart as a decision: closed when the family wraps (a circle,
    // an ellipse), else DecidesClosedByEnds.
    RunsBackToStartDecided(g: GeometrySet, c: CurveIndex, tol: LengthTolerance): DecidedClosure
        => g.CurveAt(c).Domain(g).Periodicity.HasSeam
            ? DecidedClosure.Decided(true)
            : g.DecidesClosedByEnds(c, tol);

    //==
    // # The reduction

    // The diagnostic Reduced records for an edge whose curve's closure could
    // not be settled: at the edge's instance, Measure the curve's instance
    // id (strings cannot be composed, step-diagnostics.library.plato). The
    // edge is kept, whatever its vertices. Contract request: a
    // StepDiagnosticCode case EdgeClosureUndecided with this text.
    UndecidedClosureDiagnostic(edge: StepInstanceId, curve: StepInstanceId): Diagnostic
        => Diagnostic(Severity.Warning, "STEP-EDGE-CLOSURE-UNDECIDED",
            "The closure of this edge's curve could not be decided from its record (a B-spline whose ends are not its control points); the edge was kept. Measure is the curve's instance id.",
            Provenance.AtInstance(edge), curve.Value.ToNumber);

    // Reduced (step.library.plato) with the closure test replaced by
    // RunsBackToStartDecided: an edge is dropped only when its ends fall in
    // one class and its curve is decided not to run back to its start; an
    // edge whose closure is Undecided is kept and gets an
    // UndecidedClosureDiagnostic after the merge and drop findings. Every
    // other step is Reduced's. Merge: this body replaces Reduced's.
    ReducedDecided(raw: RawDecodedModel): RawDecodedModel
    {
        var m = raw.Model;
        var g = m.Geometry;
        var tol = m.Tolerances.Length;
        var n = m.Vertices.Count;
        var candidates = m.VertexJoints;
        var joints = candidates.FlatMap(p => p[0] != p[1] && m.Vertices[p[0]].Point.Coincident(m.Vertices[p[1]].Point, tol) ? [p] : candidates.Take(0));
        var roots = ClassRoots(n, joints.Map(p => p[0]), joints.Map(p => p[1]));
        var vertexAt = n.MapRange(v => roots[v] == v).Renumbering;
        var decisions = m.Edges.Map(e => g.RunsBackToStartDecided(e.Curve, tol));
        var closes = decisions.Map(d => d.IsClosed);
        var undecided = decisions.Map(d => !d.IsDecided);
        var dropped = m.Edges.Count.MapRange(e => roots[m.Edges[e].Start.Value] == roots[m.Edges[e].End.Value] && !closes[e] && !undecided[e]);
        var edgeAt = dropped.Map(d => !d).Renumbering;
        var closedJoin = new Buffer<Boolean>(n);
        var i = 0;
        while (i < n)
        {
            closedJoin = closedJoin.Set(i, false);
            i = i + 1;
        }
        var j = 0;
        while (j < m.Edges.Count)
        {
            var start = m.Edges[j].Start.Value;
            var end = m.Edges[j].End.Value;
            if (closes[j] && start != end && roots[start] == roots[end])
            {
                closedJoin = closedJoin.Set(start, true);
                closedJoin = closedJoin.Set(end, true);
            }
            j = j + 1;
        }
        var joinedByClosedEdge = closedJoin.Freeze();
        var merged = n.Range.FlatMap(k => roots[k] == k ? n.Range.Take(0) : [k]);
        var drops = m.Edges.Count.Range.FlatMap(k => dropped[k] ? [k] : m.Edges.Count.Range.Take(0));
        var unsettled = m.Edges.Count.Range.FlatMap(k => undecided[k] ? [k] : m.Edges.Count.Range.Take(0));
        var mergeRepairs = merged.Map(k => RepairRecord(raw.Sources.Vertices[k], StepRepair.MergedInto(BrepVertexIndex(vertexAt[roots[k]]), BrepVertexIndex(k))));
        var dropRepairs = drops.Map(k => RepairRecord(raw.Sources.Edges[k], StepRepair.DroppedZeroLengthEdge(BrepEdgeIndex(k))));
        var mergeFindings = merged.Map(k => Diagnose(
            joinedByClosedEdge[k] ? StepDiagnosticCode.ClosedEdgeVerticesMerged : StepDiagnosticCode.DuplicateVertexMerged,
            Provenance.AtInstance(raw.Sources.Vertices[k].Instance),
            m.Vertices[k].Point.Distance(m.Vertices[roots[k]].Point)));
        var dropFindings = drops.Map(k => Diagnose(
            StepDiagnosticCode.ZeroLengthEdgeDropped,
            Provenance.AtInstance(raw.Sources.Edges[k].Instance),
            m.Vertices[m.Edges[k].Start.Value].Point.Distance(m.Vertices[m.Edges[k].End.Value].Point)));
        var unsettledFindings = unsettled.Map(k => UndecidedClosureDiagnostic(
            raw.Sources.Edges[k].Instance,
            raw.Sources.Curves[m.Edges[k].Curve.Value].Instance));
        var vertices = n.Range.FlatMap(k => roots[k] == k ? [m.Vertices[k]] : m.Vertices.Take(0));
        var edges = drops.Count == 0 && merged.Count == 0 ? m.Edges
            : m.Edges.Count.Range.FlatMap(k => dropped[k] ? m.Edges.Take(0)
                : [BrepEdge(BrepVertexIndex(vertexAt[roots[m.Edges[k].Start.Value]]), BrepVertexIndex(vertexAt[roots[m.Edges[k].End.Value]]), m.Edges[k].Curve, m.Edges[k].SameSense)]);
        var loops = drops.Count == 0 && merged.Count == 0 ? m.Loops
            : m.Loops.Map(l => m.ReducedLoop(l, roots, vertexAt, dropped, edgeAt));
        var s = raw.Sources;
        var sources = KernelSources(
            n.Range.FlatMap(k => roots[k] == k ? [s.Vertices[k]] : s.Vertices.Take(0)),
            m.Edges.Count.Range.FlatMap(k => dropped[k] ? s.Edges.Take(0) : [s.Edges[k]]),
            s.Loops, s.Faces, s.Shells, s.Bodies, s.Curves, s.Curves2D, s.Pcurves, s.Surfaces);
        return RawDecodedModel(
            BrepModel(g, vertices, edges, loops, m.Faces, m.Shells, m.Bodies, m.Tolerances, m.Unit),
            raw.Occurrences,
            sources,
            raw.Folds,
            raw.Repairs.Concatenate(mergeRepairs).Concatenate(dropRepairs),
            raw.Units,
            raw.LengthFactor,
            raw.AngleFactor,
            raw.Diagnostics.Concatenate(mergeFindings).Concatenate(dropFindings).Concatenate(unsettledFindings));
    }

    // ClosureMarks (step.library.plato) with the curve decision taken by
    // DecidesClosedWithoutEvaluation; the surface decisions are unchanged.
    // After the merge ClosureMarks itself is this, through DecidesClosed.
    ClosureMarksDecided(g: GeometrySet, tol: Tolerances): Array<ClosureMark>
        => g.Curves.Count.Range
                .FlatMap(k => g.DecidesClosedWithoutEvaluation(CurveIndex(k), tol.Length) ? [ClosureMark.ClosedCurve(CurveIndex(k))] : ClosureMark.NoMarks)
            .Concatenate(g.Surfaces.Count.Range
                .FlatMap(k => g.DecidesClosed(SurfaceIndex(k), SurfaceParameter.ParameterU, tol) ? [ClosureMark.ClosedSurface(SurfaceIndex(k), SurfaceParameter.ParameterU)] : ClosureMark.NoMarks))
            .Concatenate(g.Surfaces.Count.Range
                .FlatMap(k => g.DecidesClosed(SurfaceIndex(k), SurfaceParameter.ParameterV, tol) ? [ClosureMark.ClosedSurface(SurfaceIndex(k), SurfaceParameter.ParameterV)] : ClosureMark.NoMarks));

    // PrepareModelWith (step.library.plato) with ReducedDecided in place of
    // Reduced and ClosureMarksDecided in place of ClosureMarks; every other
    // step is PrepareModelWith's. Staged so the laws can run the whole
    // preparation; after the merge PrepareModelWith itself is this.
    PrepareModelDecided(raw: RawDecodedModel, policy: DecodePolicy): DecodedModel
    {
        var size = raw.Model.ModelSize;
        var extent = raw.Model.CoordinateExtent;
        var tolerances = ModelTolerances(raw.Units.UsedContextsOf(raw.Occurrences), raw.Model.Unit, size, extent, policy);
        var reduced = raw.WithModel(raw.Model.WithTolerances(tolerances)).ReducedDecided;
        var folds = reduced.Folds.Concatenate(reduced.MirrorFolds);
        var folded = reduced.Model.WithFacesReversed(folds.FoldedFaces(reduced.Model.Faces.Count));
        var model = folded.WithGeometry(folded.Geometry.WithClosures(folded.Geometry.ClosureMarksDecided(tolerances)));
        var map = ProvenanceMap(reduced.Occurrences, reduced.Sources, reduced.Sources.ByInstanceOrder, folds, reduced.Repairs);
        return DecodedModel(model, map, reduced.Diagnostics.Concatenate(raw.ToleranceDiagnostics(tolerances, size, extent, policy)), size, extent);
    }

    // PrepareModel with the standard policy, through PrepareModelDecided.
    PrepareModelDecided(raw: RawDecodedModel): DecodedModel
        => raw.PrepareModelDecided(DecodePolicy.StandardPolicy);
}

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local copies of the Ara3D.SDK packages (see vendor/README.md) let this
         repo build without waiting on a nuget.org publish. -->
    <add key="vendor" value="vendor" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>

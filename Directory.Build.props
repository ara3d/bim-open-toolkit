<Project>
  <PropertyGroup>
    <Ara3DVersion>1.6.1</Ara3DVersion>
    <Version Condition="'$(Version)' == ''">$(Ara3DVersion)</Version>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">$(Ara3DVersion)</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">$(Ara3DVersion)</FileVersion>
    <AssemblyFileVersion Condition="'$(AssemblyFileVersion)' == ''">$(Ara3DVersion)</AssemblyFileVersion>

    <Authors Condition="'$(Authors)' == ''">Ara 3D Inc.</Authors>
    <Company Condition="'$(Company)' == ''">Ara 3D Inc.</Company>
    <PackageLicenseExpression Condition="'$(PackageLicenseExpression)' == ''">MIT</PackageLicenseExpression>
    <PackageProjectUrl Condition="'$(PackageProjectUrl)' == ''">https://github.com/ara3d/bim-open-toolkit</PackageProjectUrl>
    <RepositoryUrl Condition="'$(RepositoryUrl)' == ''">https://github.com/ara3d/bim-open-toolkit</RepositoryUrl>
    <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
    <PackageOutputPath Condition="'$(PackageOutputPath)' == ''">$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>
    <PublishRepositoryUrl Condition="'$(PublishRepositoryUrl)' == ''">true</PublishRepositoryUrl>
  </PropertyGroup>

  <!--
    Every dependency is built from deps\<name>, which deps.mjs fills with every
    repository the build reaches, cloned or linked to a sibling checkout. The
    solution names the same paths, and MSBuild never resolves a link, so each
    project has one path and is built once; bim-open-flow's and bim-open-data's
    Directory.Build.props resolve DepsRoot to this same folder when they are
    built from it. ara3d-dataflow and bim-open-schema find this file and
    Directory.Build.targets by looking in the folders above deps\<name>.
  -->
  <PropertyGroup>
    <DepsRoot Condition="'$(DepsRoot)' == ''">$(MSBuildThisFileDirectory)deps\</DepsRoot>
  </PropertyGroup>

  <!--
    Platonic.Core and Platonic.Analyzers 0.1.0 are not on nuget.org yet (TKT-293).
    deps/bim-open-data/Platonic.props restores them from a sibling Platonic.CSharp
    clone's packed artifacts, but only for the projects that import it; every
    project here that references a bim-open-data project needs the same source
    for the transitive package, or a machine with an empty NuGet cache fails
    restore with NU1101 (TKT-290). Same resolution: the clone beside this
    checkout, or -p:PlatonicRoot=<clone>.
  -->
  <PropertyGroup>
    <PlatonicRoot Condition="'$(PlatonicRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Platonic.CSharp'))</PlatonicRoot>
    <RestoreAdditionalProjectSources Condition="Exists('$(PlatonicRoot)/artifacts')">$(RestoreAdditionalProjectSources);$(PlatonicRoot)/artifacts</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <PropertyGroup Label="Central NuGet dependency versions">
    <Ara3DSdkVersion>1.6.1</Ara3DSdkVersion>
    <Ara3DClosedXmlVersion>0.105.0</Ara3DClosedXmlVersion>
    <Ara3DCoverletCollectorVersion>6.0.0</Ara3DCoverletCollectorVersion>
    <Ara3DGoogleFlatBuffersVersion>25.2.10</Ara3DGoogleFlatBuffersVersion>
    <Ara3DDuckDbNetDataFullVersion>1.3.2</Ara3DDuckDbNetDataFullVersion>
    <Ara3DMicrosoftCodeAnalysisCSharpVersion>4.8.0</Ara3DMicrosoftCodeAnalysisCSharpVersion>
    <Ara3DMicrosoftDataSqliteVersion>8.0.6</Ara3DMicrosoftDataSqliteVersion>
    <Ara3DMicrosoftDiaSymReaderNativeVersion>1.7.0</Ara3DMicrosoftDiaSymReaderNativeVersion>
    <Ara3DMicrosoftExtensionsConfigurationVersion>8.0.0</Ara3DMicrosoftExtensionsConfigurationVersion>
    <Ara3DMicrosoftNetTestSdkVersion>17.8.0</Ara3DMicrosoftNetTestSdkVersion>
    <Ara3DNewtonsoftJsonVersion>13.0.3</Ara3DNewtonsoftJsonVersion>
    <Ara3DNUnitAnalyzersVersion>3.9.0</Ara3DNUnitAnalyzersVersion>
    <Ara3DNUnitVersion>3.14.0</Ara3DNUnitVersion>
    <Ara3DNUnit3TestAdapterVersion>4.5.0</Ara3DNUnit3TestAdapterVersion>
    <Ara3DParquetNetVersion>5.2.0</Ara3DParquetNetVersion>
    <Ara3DRevitAllMainVersionsApiX64Version>2025.0.0</Ara3DRevitAllMainVersionsApiX64Version>
    <Ara3DSystemComponentModelAnnotationsVersion>5.0.0</Ara3DSystemComponentModelAnnotationsVersion>
    <Ara3DSystemDrawingCommonVersion>8.0.6</Ara3DSystemDrawingCommonVersion>
    <Ara3DSystemIoPipesVersion>4.3.0</Ara3DSystemIoPipesVersion>
    <Ara3DSystemMemoryVersion>4.6.0</Ara3DSystemMemoryVersion>
    <Ara3DSystemResourcesExtensionsVersion>8.0.0</Ara3DSystemResourcesExtensionsVersion>
    <Ara3DSystemRuntimeLoaderVersion>4.3.0</Ara3DSystemRuntimeLoaderVersion>
  </PropertyGroup>
</Project>

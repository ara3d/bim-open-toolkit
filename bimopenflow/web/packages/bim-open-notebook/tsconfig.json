{
  "extends": "../../viewer.tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    // Same source aliases as packages/app: the graph and panes packages this
    // one imports reach gratify and the viewer packages.
    "paths": {
      "gratify": ["../../../../deps/gratify/src/gratify/index.ts"],
      "@bim-open-viewer/*": ["../../../../deps/bim-open-viewer/packages/*/src/index.ts"]
    }
  },
  "include": ["src", "test", "scripts"]
}

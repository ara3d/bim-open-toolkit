{
  "name": "@bimopenflow/bim-open-notebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BIM Open Notebook: the transcript of a session with the agent, with live embeds (value, table, chart, graph, 3D, picture, file) rendered by the existing panes and re-evaluated against the host.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./page": "./src/page/entry.ts",
    "./vite": "./vite/samples.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bimopenflow/api-client": "0.1.0",
    "@bimopenflow/client": "0.1.0",
    "@bimopenflow/contracts": "0.1.0",
    "@bimopenflow/graph": "0.1.0",
    "@bimopenflow/pane-3d": "0.1.0",
    "@bimopenflow/panes": "0.1.0",
    "@bimopenflow/state": "0.1.0",
    "@bimopenflow/viz": "0.1.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}

{
  "name": "@bimopenflow/studio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The toolkit's editor pages: the studio, the Snowdon 3D graph demo, the 3D showcase, and the DuckDB demo, with the 3D pane registered, the sample flow templates, and the Snowdon fixture for the dev server.",
  "scripts": {
    "dev": "vite",
    "duckdb": "vite --config vite.duckdb.config.ts",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bimopenflow/api-client": "0.1.0",
    "@bimopenflow/app": "0.1.0",
    "@bimopenflow/client": "0.1.0",
    "@bimopenflow/contracts": "0.1.0",
    "@bimopenflow/pane-3d": "0.1.0",
    "@bimopenflow/panes": "0.1.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^3.0.0"
  }
}

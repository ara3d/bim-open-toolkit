{
  "name": "bimopenflow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@bim-open-viewer/controls": "file:../../deps/bim-open-viewer/packages/controls",
    "@bim-open-viewer/core": "file:../../deps/bim-open-viewer/packages/core",
    "@bim-open-viewer/features": "file:../../deps/bim-open-viewer/packages/features",
    "@bim-open-viewer/formats": "file:../../deps/bim-open-viewer/packages/formats",
    "@bim-open-viewer/interact": "file:../../deps/bim-open-viewer/packages/interact",
    "@bim-open-viewer/loaders": "file:../../deps/bim-open-viewer/packages/loaders",
    "@bim-open-viewer/model": "file:../../deps/bim-open-viewer/packages/model",
    "@bim-open-viewer/render": "file:../../deps/bim-open-viewer/packages/render",
    "@bim-open-viewer/viewer": "file:../../deps/bim-open-viewer/packages/viewer",
    "@bimopenflow/api-client": "file:../../deps/bim-open-flow/bimopenflow/web/packages/api-client",
    "@bimopenflow/app": "file:../../deps/bim-open-flow/bimopenflow/web/packages/app",
    "@bimopenflow/bim-open-notebook": "file:../../deps/bim-open-notebook/bimopenflow/web/packages/bim-open-notebook",
    "@bimopenflow/client": "file:../../deps/bim-open-flow/bimopenflow/web/packages/client",
    "@bimopenflow/contracts": "file:../../deps/bim-open-flow/bimopenflow/web/packages/contracts",
    "@bimopenflow/graph": "file:../../deps/bim-open-flow/bimopenflow/web/packages/graph",
    "@bimopenflow/pane-3d": "file:../../deps/bim-open-notebook/bimopenflow/web/packages/pane-3d",
    "@bimopenflow/panes": "file:../../deps/bim-open-flow/bimopenflow/web/packages/panes",
    "@bimopenflow/state": "file:../../deps/bim-open-flow/bimopenflow/web/packages/state",
    "@bimopenflow/viz": "file:../../deps/bim-open-flow/bimopenflow/web/packages/viz",
    "@types/three": "^0.180.0"
  },
  "overrides": {
    "@bimopenflow/api-client": "$@bimopenflow/api-client",
    "@bimopenflow/app": "$@bimopenflow/app",
    "@bimopenflow/bim-open-notebook": "$@bimopenflow/bim-open-notebook",
    "@bimopenflow/client": "$@bimopenflow/client",
    "@bimopenflow/contracts": "$@bimopenflow/contracts",
    "@bimopenflow/graph": "$@bimopenflow/graph",
    "@bimopenflow/pane-3d": "$@bimopenflow/pane-3d",
    "@bimopenflow/panes": "$@bimopenflow/panes",
    "@bimopenflow/state": "$@bimopenflow/state",
    "@bimopenflow/viz": "$@bimopenflow/viz"
  },
  "scripts": {
    "host": "dotnet run --project ../../src/studio/BimOpenFlow.Studio -- --profile bim --port 5214 --store ../../artifacts/bim-flow/store --cache ../../artifacts/bim-flow/cache",
    "web": "npm run dev -w @bimopenflow/studio-web",
    "web:generic": "npm run web --prefix ../../deps/bim-open-flow/bimopenflow/web",
    "notebook": "npm run dev -w @bimopenflow/nrc-web",
    "duckdb:prepare": "node ../../scripts/prepare-bim-flow-duckdb.mjs",
    "duckdb:build": "dotnet build ../../src/studio/BimOpenFlow.Studio -o ../../artifacts/bim-flow-duckdb/studio --verbosity quiet",
    "duckdb:host": "dotnet ../../artifacts/bim-flow-duckdb/studio/bimopenflow-studio.dll --profile tables --port 5218 --store ../../artifacts/bim-flow-duckdb/store --cache ../../artifacts/bim-flow-duckdb/cache --models ../../artifacts/building-model-workflows",
    "duckdb:web": "npm run duckdb -w @bimopenflow/studio-web",
    "mcp:build": "node ../../scripts/build-mcp.mjs",
    "mcp:check": "node ../../scripts/build-mcp.mjs --check",
    "duckdb:mcp-build": "dotnet build ../../deps/bim-open-flow/src/mcp/BimOpenMcp.Flow -o ../../artifacts/bim-flow-duckdb/mcp --verbosity quiet",
    "duckdb:mcp-demo": "node ../../scripts/demo-bim-flow-mcp.mjs",
    "ifc:mcp-build": "dotnet build ../../deps/bim-open-data/src/mcp/BimOpenMcp.Ifc -o ../../artifacts/bim-flow-ifc/mcp --verbosity quiet",
    "ifc:mcp-demo": "node ../../scripts/demo-ifc-mcp.mjs",
    "ifc:ask-build": "dotnet build ../../src/studio/BimOpenMcp.Ifc.Ask -o ../../artifacts/bim-flow-ifc/ask --verbosity quiet",
    "nrc:walkthrough": "node ../../scripts/nrc-walkthrough.mjs",
    "nrc:walkthrough:duplex": "node ../../scripts/nrc-walkthrough.mjs --skip-snowdon"
  }
}

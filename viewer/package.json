{
  "name": "ara3d-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:gratify && npm run build -w @ara3d/viewer-core && npm run build -w @ara3d/viewer-controls && npm run build -w @ara3d/viewer-loaders && npm run build -w @bim-open-toolkit/visualization",
    "test": "npm test --workspaces --if-present",
    "demo": "vite packages/visualization/examples --config packages/visualization/examples/vite.config.mjs --host 127.0.0.1 --port 5173 --strictPort",
    "demo:check": "tsc -p packages/visualization/tsconfig.examples.json",
    "demo:snowdon": "node packages/visualization/scripts/check-snowdon.mjs",
    "demo:build": "vite build packages/visualization/examples --config packages/visualization/examples/vite.config.mjs --outDir ../dist-demo",
    "build:gratify": "tsc -p ../submodules/gratify/tsconfig.build.json",
    "docs:api": "node packages/visualization/scripts/generate-api.mjs",
    "demo:browser": "node packages/visualization/scripts/browser-smoke.mjs",
    "demo:normalized": "node packages/visualization/scripts/check-normalized-snowdon.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test:v2": "vitest run --config vitest.v2.config.ts",
    "lint:typed": "eslint --config eslint.typed.config.js ."
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.13",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.0",
    "eslint": "^10.9.0",
    "gratify": "file:../submodules/gratify",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.0"
  }
}

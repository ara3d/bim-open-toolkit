<Project>
  <PropertyGroup>
    <PlatonicVersion Condition="'$(PlatonicVersion)' == ''">0.1.0</PlatonicVersion>
    <PlatonicRoot Condition="'$(PlatonicRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\Platonic.CSharp'))</PlatonicRoot>
    <RestoreAdditionalProjectSources Condition="Exists('$(PlatonicRoot)/artifacts')">$(RestoreAdditionalProjectSources);$(PlatonicRoot)/artifacts</RestoreAdditionalProjectSources>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Platonic.Core" Version="$(PlatonicVersion)" />
    <PackageReference Include="Platonic.Analyzers" Version="$(PlatonicVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.ara3d.com/dataflow-graph/runs/0.1.0/run.schema.json",
  "title": "DataFlow Graph run record",
  "type": "object",
  "properties": {
    "runVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "graphHash": { "$ref": "#/$defs/hash" },
    "engineVersion": { "type": "string", "minLength": 1 },
    "timestampUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "param": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "contentHash": { "$ref": "#/$defs/hash" },
          "source": { "type": "string" }
        },
        "required": ["node", "param", "contentHash"],
        "additionalProperties": false
      }
    },
    "nodeOutputs": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9_-]+\\.[A-Za-z][A-Za-z0-9]*$": { "$ref": "#/$defs/hash" }
      },
      "additionalProperties": false
    },
    "recordedOutputs": {
      "type": "object",
      "patternProperties": {
        "^[A-Za-z0-9_-]+\\.[A-Za-z][A-Za-z0-9]*$": { "$ref": "#/$defs/value" }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "status": { "enum": ["ok", "failed"] },
          "error": { "type": "string" }
        },
        "required": ["node", "status"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "runVersion",
    "graphHash",
    "engineVersion",
    "timestampUtc",
    "inputs",
    "nodeOutputs",
    "recordedOutputs",
    "effects"
  ],
  "additionalProperties": false,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "enum": ["Boolean", "Integer", "Number", "Text"] },
            "value": { "type": ["boolean", "number", "string", "null"] }
          },
          "required": ["kind", "value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "Table" },
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "kind": { "enum": ["Boolean", "Integer", "Number", "Text"] },
                  "cells": {
                    "type": "array",
                    "items": { "type": ["boolean", "number", "string", "null"] }
                  }
                },
                "required": ["name", "kind", "cells"],
                "additionalProperties": false
              }
            }
          },
          "required": ["kind", "columns"],
          "additionalProperties": false
        }
      ]
    }
  }
}

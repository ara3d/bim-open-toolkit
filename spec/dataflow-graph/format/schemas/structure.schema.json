{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.ara3d.com/dataflow-graph/format/0.1.0/structure.schema.json",
  "title": "DataFlow Graph structure layer",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "$ref": "#/$defs/nodeId" },
          "kind": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)+$"
          },
          "version": { "type": "integer", "minimum": 1 }
        },
        "required": ["id", "kind", "version"],
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": { "$ref": "#/$defs/endpoint" },
          "to": { "$ref": "#/$defs/endpoint" }
        },
        "required": ["from", "to"],
        "additionalProperties": false
      }
    }
  },
  "required": ["nodes", "edges"],
  "additionalProperties": false,
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "endpoint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z][A-Za-z0-9]*$"
    }
  }
}

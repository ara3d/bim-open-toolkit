{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.ara3d.com/dataflow-graph/format/0.1.0/dfg.schema.json",
  "title": "DataFlow Graph document",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "structure": { "$ref": "structure.schema.json" },
    "values": { "$ref": "values.schema.json" },
    "layout": { "$ref": "layout.schema.json" },
    "session": { "$ref": "session.schema.json" }
  },
  "required": ["formatVersion", "structure", "values"],
  "additionalProperties": false
}

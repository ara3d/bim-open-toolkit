{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bof-host",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/BimOpenFlow.Host",
        "--no-build",
        "--",
        "--port",
        "5214",
        "--profile",
        "bim",
        "--models",
        "C:/Users/cdigg/git/bim-open-toolkit/data",
        "--store",
        "C:/Users/cdigg/AppData/Local/Temp/claude/bof-demo/store",
        "--cache",
        "C:/Users/cdigg/AppData/Local/Temp/claude/bof-demo/cache"
      ],
      "port": 5214
    },
    {
      "name": "bof-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "bimopenflow/web",
        "run",
        "dev",
        "--workspace",
        "packages/app"
      ],
      "port": 5300
    },
    {
      "name": "gallery",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "viewer",
        "run",
        "gallery"
      ],
      "port": 5190
    },
    {
      "name": "bof-duckdb-host",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "bimopenflow/web",
        "run",
        "duckdb:host"
      ],
      "port": 5218
    },
    {
      "name": "bof-duckdb-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "bimopenflow/web",
        "run",
        "duckdb:web"
      ],
      "port": 5308
    }
  ]
}
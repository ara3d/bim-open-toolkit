{
  "$schema": "./catalog.schema.json",
  "version": "0.1.0-review.1",
  "status": "proposed",
  "modelSchema": "model.schema.json",
  "workflowCatalog": "workflows.json",
  "purpose": "Review human-facing BIM semantics through questions, explicit record grain and evidence; physical storage remains undecided.",
  "performanceContract": {
    "preparedOpenSeconds": 10,
    "processMemoryCeilingGiB": 16,
    "baselineWorkstationGiB": 32,
    "includes": [
      "first-useful-query",
      "native-allocations",
      "resident-mapped-pages",
      "workers"
    ],
    "preparationExcludedFromOpenDeadline": true
  },
  "sourceEvidence": [
    {
      "id": "revit-corpus",
      "status": "user-reported",
      "statement": "Documents/BIM Open Schema is generally Revit-derived and more reliable, not assumed perfect."
    },
    {
      "id": "ifc-corpus",
      "status": "user-reported",
      "statement": "IFC-to-BOS converter is incomplete. Unknown omission causes remain unknown."
    },
    {
      "id": "stress-footers",
      "status": "observed",
      "statement": "all-medium.bos has 224 document rows, 1,237,191 entities and zero explicit Relations rows. This does not establish number of physical objects or absent topology."
    },
    {
      "id": "nearby-bfast-samples",
      "status": "unverified-correspondence",
      "statement": "Nearby cache property/name samples are hypotheses; source correspondence has not been proved."
    }
  ],
  "identityContract": "objects.id identifies a proposed semantic identity; all snapshot-scoped joins include snapshotId. Cross-import stability depends on reconciliation, not a generated row key.",
  "missingDataContract": "Required observations use explicit availability states. JSON null is reserved for optional display/locator values and does not encode a measurement or audit result.",
  "policies": [
    {
      "id": "quantity-selection",
      "status": "unresolved",
      "statement": "Choose measurement alternatives using declared kind, basis, source authority and method; no silent first-row-wins."
    },
    {
      "id": "identity-reconciliation",
      "status": "unresolved",
      "statement": "Reconcile candidate source identities only with evidence; preserve unmatched and contested records."
    },
    {
      "id": "property-selection",
      "status": "unresolved",
      "statement": "Choose specifications with explicit precedence; duplicates and missing exporter coverage remain visible."
    },
    {
      "id": "topology-evidence",
      "status": "unresolved",
      "statement": "Choose accepted topology of the requested meaning and report unknown coverage."
    },
    {
      "id": "spatial-candidate",
      "status": "unresolved",
      "statement": "Use geometric bounds as candidate evidence only; exact methods and tolerances are explicit."
    },
    {
      "id": "assessment-completeness",
      "status": "unresolved",
      "statement": "Specify required evidence and applicable rules before deciding pass/fail/unknown."
    },
    {
      "id": "factor-match",
      "status": "unresolved",
      "statement": "Match material quantity to a versioned factor, unit, geography and lifecycle boundary."
    },
    {
      "id": "rate-match",
      "status": "unresolved",
      "statement": "Match work scope and quantity to a rate edition, currency and regional/date assumptions."
    },
    {
      "id": "scope-no-double-count",
      "status": "unresolved",
      "statement": "Select nonoverlapping additive scope at the declared grain."
    },
    {
      "id": "coordinate-resolution",
      "status": "unresolved",
      "statement": "Resolve declared frames and dimensions without assuming federated source alignment."
    }
  ],
  "invariants": [
    {
      "id": "snapshot-selection",
      "statement": "A query selects explicit snapshots; comparisons do not aggregate alternative revisions together.",
      "enforcement": "partially-checked"
    },
    {
      "id": "identity-no-guess",
      "statement": "Only confirmed, evidenced correspondences authorize treating source records as the same object. Names, coordinates and local IDs alone are insufficient.",
      "enforcement": "policy-required"
    },
    {
      "id": "source-not-truth",
      "statement": "Source presence is evidence, not certification. Empty relation/diagnostic tables do not prove absent topology or correctness; not-exported needs documented capability evidence.",
      "enforcement": "policy-required"
    },
    {
      "id": "location-not-origin",
      "statement": "Unknown location remains unknown. Available place references target spatial objects in the same snapshot; nonspatial objects may have associations without coordinates.",
      "enforcement": "companion-validator"
    },
    {
      "id": "frame-consistency",
      "statement": "Frames are acyclic; poses match frame dimension. Known transforms use declared conventions; cross-source alignment needs evidence.",
      "enforcement": "partially-checked"
    },
    {
      "id": "representation-not-object",
      "statement": "Counts use object identity and declared occurrence scope, not number of representations or source records.",
      "enforcement": "policy-required"
    },
    {
      "id": "bounds-not-quantity",
      "statement": "Bounds/projection are not substituted for surface area, volume or exact geometry results.",
      "enforcement": "policy-required"
    },
    {
      "id": "topology-not-proximity",
      "statement": "Traversal selects accepted relation kinds. Touches/possible_overlap cannot establish connects_to or feeds. Incomplete source topology prevents a completeness claim.",
      "enforcement": "policy-required"
    },
    {
      "id": "observation-selection",
      "statement": "Alternatives remain separately addressable. Selected observations require a named policy and declared quantity/property context.",
      "enforcement": "partially-checked"
    },
    {
      "id": "quantity-unit-basis",
      "statement": "Measurement kind, unit and basis agree; surface_area and projected_area differ. Nonnegative physical takeoff quantities are not mixed across units.",
      "enforcement": "companion-validator"
    },
    {
      "id": "scope-no-double-count",
      "statement": "Aggregate only compatible leaf contributions/scopes; do not sum assembly totals with their constituents, duplicate representations, overlapping scopes or alternative revisions.",
      "enforcement": "partially-checked"
    },
    {
      "id": "reference-version",
      "statement": "Rates, factors and requirements reference an explicit versioned set of the correct kind.",
      "enforcement": "companion-validator"
    },
    {
      "id": "assessment-no-false-pass",
      "statement": "Pass requires complete applicable inputs and rule evidence. An incomplete model cannot establish complete safety or regulatory compliance.",
      "enforcement": "partially-checked"
    },
    {
      "id": "countable-occurrences",
      "statement": "Component schedules include physical occurrence kinds, excluding spaces, systems, definitions and metadata.",
      "enforcement": "companion-validator"
    },
    {
      "id": "surface-accounting",
      "statement": "One face/surface has explicit identity. Shared objects can have two different finish faces; duplicate space associations do not multiply a surface quantity.",
      "enforcement": "partially-checked"
    },
    {
      "id": "rate-compatibility",
      "statement": "Unit rate and selected quantity are compatible, currencies agree, and waste assumptions are explicit. Unpriced scope is not zero cost.",
      "enforcement": "companion-validator"
    },
    {
      "id": "factor-compatibility",
      "statement": "Selected material quantity matches factor denominator unit; lifecycle module, factor edition and scenario remain explicit. Missing factors are not zero impact.",
      "enforcement": "partially-checked"
    }
  ],

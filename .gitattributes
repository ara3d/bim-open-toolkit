# Spec conformance vectors and canonical graph documents are byte-sensitive.
spec/** text eol=lf
*.dfg.json text eol=lf

# IFC files are byte-exact: the NRC write-back is verified by hash and entity diff.
samples/nrc/*.ifc -text

# Golden graph text is compared byte for byte with the printer's LF output (TKT-85).
tests/flow/BimOpenFlow.SampleFlows.Tests/golden/** text eol=lf

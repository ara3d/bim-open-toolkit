    <ProjectReference Include="..\..\data\Ara3D.BimOpenSchema.DuckDb\Ara3D.BimOpenSchema.DuckDb.csproj" />
    <ProjectReference Include="..\..\data\Ara3D.Ifc.Bos\Ara3D.Ifc.Bos.csproj" />
    <ProjectReference Include="..\..\data\Ara3D.Ifc.Mesher\Ara3D.Ifc.Mesher.csproj" />
    <PackageReference Include="Ara3D.Models" Version="$(Ara3DSdkVersion)" />
    <PackageReference Include="Ara3D.IO.GltfExporter" Version="$(Ara3DSdkVersion)" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Ara3D.Ifc.Bos</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Converts IFC files into the BIM Open Schema, keeping the schema projects free of any IFC dependency.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ara3D.BimOpenSchema.IO\Ara3D.BimOpenSchema.IO.csproj" />
    <ProjectReference Include="..\Ara3D.IfcLoader\Ara3D.IfcLoader.csproj" />
    <PackageReference Include="Parquet.Net" Version="$(Ara3DParquetNetVersion)" />
  </ItemGroup>

</Project>

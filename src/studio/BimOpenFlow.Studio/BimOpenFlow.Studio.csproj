<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>bimopenflow-studio</AssemblyName>
    <RootNamespace>BimOpenFlow.Studio</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The Ask system prompt is the same text the Claude Code skill reads. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\.claude\skills\bim-flow\schema-guide.md" LogicalName="skills/bim-flow/schema-guide.md" />
    <EmbeddedResource Include="..\..\..\.claude\skills\bim-flow\node-guide.md" LogicalName="skills/bim-flow/node-guide.md" />
    <EmbeddedResource Include="..\..\..\.claude\skills\bim-flow\working-rules.md" LogicalName="skills/bim-flow/working-rules.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BimOpenFlow.Ask\BimOpenFlow.Ask.csproj" />
    <ProjectReference Include="..\..\flow\BimOpenFlow.Host\BimOpenFlow.Host.csproj" />
    <ProjectReference Include="..\..\mcp\BimOpenMcp.Flow\BimOpenMcp.Flow.csproj" />
    <ProjectReference Include="..\..\flow\BimOpenFlow.NodeDocs\BimOpenFlow.NodeDocs.csproj" />
    <ProjectReference Include="..\..\flow\BimOpenFlow.Nodes.Bos\BimOpenFlow.Nodes.Bos.csproj" />
    <ProjectReference Include="..\..\flow\BimOpenFlow.Nodes.BimAnalysis\BimOpenFlow.Nodes.BimAnalysis.csproj" />
    <ProjectReference Include="..\..\flow\BimOpenFlow.Nodes.Geometry\BimOpenFlow.Nodes.Geometry.csproj" />
    <ProjectReference Include="..\..\flow\BimOpenFlow.Nodes.Compliance\BimOpenFlow.Nodes.Compliance.csproj" />
    <ProjectReference Include="$(DepsRoot)bim-open-data\src\data\Ara3D.Ifc.DuckDb\Ara3D.Ifc.DuckDb.csproj" />
  </ItemGroup>

</Project>
